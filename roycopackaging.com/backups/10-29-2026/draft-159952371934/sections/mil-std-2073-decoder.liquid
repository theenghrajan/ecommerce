  }};

  /* == HELPERS ============================================================= */

  var ESC = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return ESC[c]; }); }

  // Longest-first so "MIL-PRF-121" never shadows "MIL-PRF-1218"-style keys.
  var SPEC_KEYS = Object.keys(MS2073.specLinks).sort(function (a, b) { return b.length - a.length; });
  var SPEC_RE = new RegExp(
    "(" + SPEC_KEYS.map(function (k) {
      return k.replace(/[.*+?^${}()|[\]\\]/g, "\\$&").replace(/[\s-]/g, "[\\s\\u2010-\\u2015-]");
    }).join("|") + ")",
    "gi"
  );

  /* A handle prefixed "product:" resolves against the product root;
     everything else against the collection root. An empty handle means
     Royco has no page for that spec yet \u2014 render plain text, never a
     link that 404s.                                                      */
  function resolveUrl(roots, handle) {
    if (!handle) return "";
    if (handle.indexOf("product:") === 0) {
      return roots.product.replace(/\/+$/, "") + "/" + handle.slice(8);
    }
    return roots.collection.replace(/\/+$/, "") + "/" + handle;
  }

  /* Escape the text, then hyperlink any specification designator Royco
     stocks. Operates on escaped output so no markup can be injected.       */
  function linkify(text, roots) {
    var out = esc(text);
    return out.replace(SPEC_RE, function (match) {
      var norm = match.replace(/[\u2010-\u2015]/g, "-").replace(/\s+/g, " ").toUpperCase();
      var handle = null;
      for (var i = 0; i < SPEC_KEYS.length; i++) {
        if (SPEC_KEYS[i].toUpperCase() === norm) { handle = MS2073.specLinks[SPEC_KEYS[i]]; break; }
      }
      var url = resolveUrl(roots, handle);
      if (!url) return match;
      return '<a href="' + esc(url) + '" data-royco-spec="' + esc(norm) + '">' + match + "</a>";
    });
  }

  function linkLabel(handle) {
    if (MS2073.linkLabels && MS2073.linkLabels[handle]) return MS2073.linkLabels[handle];
    return handle.replace(/^product:/, "").split("-").map(function (w) {
      if (/^(mil|astm|ppp|std|dtl|prf|esd|vci|aa)$/i.test(w)) return w.toUpperCase();
      return w.charAt(0).toUpperCase() + w.slice(1);
    }).join(" ");
  }

  /* Extra Royco links for codes whose text names no stocked specification,
     or where a specific Royco product matches the code exactly.           */
  function stockLine(tableKey, code, roots) {
    var byTable = MS2073.extraLinks[tableKey];
    if (!byTable || !byTable[code]) return "";
    var links = byTable[code].map(function (h) {
      var url = resolveUrl(roots, h);
      return url ? '<a href="' + esc(url) + '">' + esc(linkLabel(h)) + "</a>" : "";
    }).filter(Boolean).join("");
    if (!links) return "";
    return '<span class="royco-2073__stock"><strong>Royco supplies:</strong> ' + links + "</span>";
  }

  /* Threshold sits in the gap between the two kinds of entry. The numbered
     methods of preservation run 185-600 characters and always show in full,
     because the Type/Class/Style detail is the whole point of looking one
     up. The specialized J-Ia procedures and J-IXb code U run 875-1250 and
     collapse. The text is never truncated — it is clamped in CSS, so links
     inside stay intact and Ctrl+F still finds everything.                 */
  var LONG_AT = 650;

  function collapsible(innerHtml, plainLength) {
    if (plainLength <= LONG_AT) return innerHtml;
    return '<div class="royco-2073__long">' +
             '<div class="royco-2073__longinner">' + innerHtml + "</div>" +
             '<button type="button" class="royco-2073__more" aria-expanded="false">Read full text</button>' +
           "</div>";
  }

  /* == CODE NORMALISATION ==================================================
     The printed standard writes numeric zero as "0/" and double zero as
     "0/0/" to distinguish them from the letters O and OO. Customers type
     plain 0. Accept both, plus spaces, dashes and lower case.              */
  function normalize(raw) {
    return String(raw || "")
      .toUpperCase()
      .replace(/0\/0\//g, "00")
      .replace(/0\//g, "0")
      .replace(/[^A-Z0-9]/g, "");
  }

  function lookup(tableKey, code) {
    var table = MS2073.tables[tableKey];
    if (!table) return null;
    var want = normalize(code);
    if (!want) return null;
    var rows = table.rows, i;
    for (i = 0; i < rows.length; i++) if (rows[i][0] === want) return rows[i];
    // "0" typed into a two-character field, and vice versa.
    for (i = 0; i < rows.length; i++) {
      var have = rows[i][0];
      if (have.replace(/^0+/, "") === want.replace(/^0+/, "") && /^[0Z]+$/.test(have)) return rows[i];
    }
    for (i = 0; i < rows.length; i++) if (rows[i][0] === want.padStart(2, "0")) return rows[i];
    return null;
  }

  /* Method of preservation draws on two tables. */
  function lookupField(field, code) {
    var hit = lookup(field.table, code);
    if (hit) return { row: hit, table: field.table };
    if (field.also) {
      hit = lookup(field.also, code);
      if (hit) return { row: hit, table: field.also };
    }
    return null;
  }

  function renderResult(field, code, roots) {
    var found = lookupField(field, code);
    if (!found) {
      return '<span class="royco-2073__cardres--err">No <b>' + esc(normalize(code)) +
             "</b> in " + esc(field.table) + ". Check the code, or browse the table below.</span>";
    }
    var lead   = found.row[1];
    var detail = found.row[2] || "";
    var plain  = lead + (detail ? " " + detail : "");

    var html = '<span class="royco-2073__lead">' + linkify(lead, roots) + "</span>";
    if (detail) {
      html += '<span class="royco-2073__detail">' + linkify(detail, roots) + "</span>";
    }
    return collapsible(html, plain.length) +
           stockLine(found.table, found.row[0], roots);
  }

  /* == FIELD CARDS ========================================================= */

  function buildCard(field, roots) {
    var card = document.createElement("div");
    card.className = "royco-2073__card";
    card.setAttribute("data-field", field.key);
    var uid = "rc-" + field.key.toLowerCase().replace(/[^a-z0-9]/g, "") + "-" + Math.random().toString(36).slice(2, 7);
    var tableLabel = field.table + (field.also ? " / " + field.also : "");

    card.innerHTML =
      '<div class="royco-2073__cardhead">' +
        '<label class="royco-2073__cardtitle" for="' + uid + '">' + field.label + "</label>" +
        '<span class="royco-2073__tablabel">' + esc(tableLabel) + "</span>" +
      "</div>" +
      '<input class="royco-2073__input" id="' + uid + '" type="text" autocomplete="off" spellcheck="false" ' +
        'maxlength="4" placeholder="' + (field.len === 1 ? "1 character" : "2 characters") + '">' +
      '<div class="royco-2073__cardres royco-2073__cardres--idle">Enter a code to decode it.</div>' +
      '<button type="button" class="royco-2073__browse">Browse all ' + esc(tableLabel) + " codes</button>" +
      '<div class="royco-2073__list" hidden></div>';

    var input  = card.querySelector("input");
    var result = card.querySelector(".royco-2073__cardres");
    var browse = card.querySelector(".royco-2073__browse");
    var list   = card.querySelector(".royco-2073__list");

    function decode() {
      var v = input.value.trim();
      if (!v) {
        result.className = "royco-2073__cardres royco-2073__cardres--idle";
        result.textContent = "Enter a code to decode it.";
        return;
      }
      result.className = "royco-2073__cardres";
      result.innerHTML = renderResult(field, v, roots);
    }
    input.addEventListener("input", decode);

    var built = false;
    browse.addEventListener("click", function () {
      if (!built) {
        var keys = [field.table].concat(field.also ? [field.also] : []);
        var html = "";
        keys.forEach(function (k) {
          MS2073.tables[k].rows.forEach(function (r) {
            var short = r[1].length > 140 ? r[1].slice(0, 140).replace(/\s+\S*$/, "") + "…" : r[1];
            html += '<button type="button" class="royco-2073__listitem" data-code="' + esc(r[0]) + '">' +
                      "<code>" + esc(r[0]) + "</code><span>" + esc(short) + "</span></button>";
          });
        });
        list.innerHTML = html;
        list.addEventListener("click", function (e) {
          var b = e.target.closest(".royco-2073__listitem");
          if (!b) return;
          input.value = b.getAttribute("data-code");
          decode();
          list.hidden = true;
          browse.textContent = "Browse all " + tableLabel + " codes";
          input.focus();
        });
        built = true;
      }
      list.hidden = !list.hidden;
      browse.textContent = (list.hidden ? "Browse all " : "Hide ") + tableLabel + " codes";
    });

    return card;
  }

  /* == BOOT ================================================================ */

  function init(rootEl) {
    if (rootEl.dataset.roycoReady === "1") return;
    rootEl.dataset.roycoReady = "1";

    var roots = {
      collection: rootEl.getAttribute("data-collection-root") || "/collections",
      product:    rootEl.getAttribute("data-product-root") || "/products"
    };

    // One delegated listener covers every expander, including ones that do
    // not exist yet because the customer has not typed that code.
    rootEl.addEventListener("click", function (e) {
      var btn = e.target.closest(".royco-2073__more");
      if (!btn || !rootEl.contains(btn)) return;
      var wrap = btn.parentNode;
      var open = wrap.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      btn.textContent = open ? "Show less" : "Read full text";
    });

    var grid = rootEl.querySelector('[data-role="field-grid"]');
    if (!grid) return;
    var frag = document.createDocumentFragment();
    MS2073.fields.concat(MS2073.extraFields).forEach(function (f) {
      frag.appendChild(buildCard(f, roots));
    });
    grid.appendChild(frag);
  }

  function boot() {
    document.querySelectorAll(".royco-2073").forEach(init);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
  // Theme Editor re-renders the section without a page reload.
  document.addEventListener("shopify:section:load", function (e) {
    var el = e.target.querySelector(".royco-2073");
    if (el) init(el);
  });
})();
</script>
