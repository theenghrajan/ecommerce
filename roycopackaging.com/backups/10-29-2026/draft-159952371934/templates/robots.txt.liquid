# we use Shopify as our ecommerce platform
{%- comment -%}
# Caution! Please read https://help.shopify.com/en/manual/promoting-marketing/seo/editing-robots-txt before proceeding to make changes to this file.
{% endcomment %}
{% for group in robots.default_groups %}
  {{- group.user_agent -}}

  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}

  {% comment %}
  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: *?page=*' }}
  {%- endif -%}
  {% endcomment %}

  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /wpm@*' }}
  {%- endif -%}

  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /*.atom' }}
  {%- endif -%}

  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /*?_pos=*' }}
  {%- endif -%}

    {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /*?pr_prod_strat=*' }}
  {%- endif -%}

    {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /services/login_with_shop/authorize?*' }}
  {%- endif -%}

  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /agents.md' }}
  {%- endif -%}

  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /llms-full.txt' }}
  {%- endif -%}

  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /llms.txt' }}
  {%- endif -%}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}
