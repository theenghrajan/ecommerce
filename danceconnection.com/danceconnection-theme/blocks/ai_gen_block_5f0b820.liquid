{% doc %}
  @prompt
    put the products from collection: ultimate dance sneakers on this page. they are unlisted currently
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-products-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; color: {{ block.settings.text_color }}; }
  .ai-collection-products-{{ ai_gen_id }}__header { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .ai-collection-products-{{ ai_gen_id }}__heading { margin: 0; font-family: {{ block.settings.heading_font.family }}; font-size: {{ block.settings.heading_size }}px; line-height: 1.15; color: {{ block.settings.text_color }}; }
  .ai-collection-products-{{ ai_gen_id }}__link { color: {{ block.settings.text_color }}; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  .ai-collection-products-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr)); gap: {{ block.settings.grid_gap }}px; }
  .ai-collection-products-{{ ai_gen_id }}__card { min-width: 0; }
  .ai-collection-products-{{ ai_gen_id }}__image-link, .ai-collection-products-{{ ai_gen_id }}__image-wrap { display: block; overflow: hidden; background: {{ block.settings.image_background }}; aspect-ratio: 1 / 1; }
  .ai-collection-products-{{ ai_gen_id }}__image-wrap img, .ai-collection-products-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-collection-products-{{ ai_gen_id }}__placeholder svg { color: {{ block.settings.text_color }}; opacity: 0.35; }
  .ai-collection-products-{{ ai_gen_id }}__info { padding-top: 12px; }
  .ai-collection-products-{{ ai_gen_id }}__title { display: block; margin: 0 0 6px; color: {{ block.settings.text_color }}; font-size: 16px; line-height: 1.3; text-decoration: none; }
  .ai-collection-products-{{ ai_gen_id }}__price { color: {{ block.settings.price_color }}; font-size: 15px; }
  .ai-collection-products-{{ ai_gen_id }}__empty { padding: 36px 20px; border: 1px solid {{ block.settings.border_color }}; color: {{ block.settings.text_color }}; text-align: center; }
  @media screen and (max-width: 749px) { .ai-collection-products-{{ ai_gen_id }}__header { align-items: start; flex-direction: column; gap: 10px; margin-bottom: 20px; } .ai-collection-products-{{ ai_gen_id }}__grid { grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr)); gap: {{ block.settings.mobile_gap }}px; } }
{% endstyle %}

<div class="ai-collection-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collection != blank %}
    <div class="ai-collection-products-{{ ai_gen_id }}__header">
      <h2 class="ai-collection-products-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.show_collection_link %}<a class="ai-collection-products-{{ ai_gen_id }}__link" href="{{ block.settings.collection.url }}">{{ block.settings.link_label | escape }}</a>{% endif %}
    </div>
    {% if block.settings.collection.products_count > 0 %}
      <div class="ai-collection-products-{{ ai_gen_id }}__grid">
        {% for product in block.settings.collection.products limit: block.settings.product_limit %}
          <article class="ai-collection-products-{{ ai_gen_id }}__card">
            <a class="ai-collection-products-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="View {{ product.title | escape }}"><div class="ai-collection-products-{{ ai_gen_id }}__image-wrap">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="900">{% else %}<div class="ai-collection-products-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div></a>
            <div class="ai-collection-products-{{ ai_gen_id }}__info"><a class="ai-collection-products-{{ ai_gen_id }}__title" href="{{ product.url }}">{{ product.title | escape }}</a><div class="ai-collection-products-{{ ai_gen_id }}__price">{{ product.price | money }}</div></div>
          </article>
        {% endfor %}
      </div>
    {% else %}<div class="ai-collection-products-{{ ai_gen_id }}__empty">No products are available in this collection yet.</div>{% endif %}
  {% else %}<div class="ai-collection-products-{{ ai_gen_id }}__empty">Select the Ultimate dance sneakers collection in this block's settings.</div>{% endif %}
</div>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ultimate dance sneakers" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 1, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "checkbox", "id": "show_collection_link", "label": "Show collection link", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "cabin_n7" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 8, "max": 28, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#000000" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#f7f7f7" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#d6d6d6" }
  ],
  "presets": [{ "name": "Collection products" }],
  "tag": null,
  "class": "collection-products-block"
}
{% endschema %}