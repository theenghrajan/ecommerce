            "highlight_text_color": "",
            "heading_size": "h1"
          }
        },
        "text_3LxtYL": {
          "type": "text",
          "settings": {
            "text": "<p><a href=\"https://new.usgbc.org/\" target=\"_blank\">The U.S. Green Building Council (USGBC)</a> implemented the international Leadership in Energy and Environmental Design (LEED) system to evaluate buildings’ environmental efficiency. LEED certifications can apply to any new building, and companies around the world are increasingly starting to remodel their existing structures to meet LEED standards.</p><p>By implementing optimized environmental efficiency and innovative operational practices, we’re proud to be <a href=\"https://www.usgbc.org/projects/NADCO-tapes-labels\" target=\"_blank\">Florida’s first manufacturer</a> to receive the USGBC’s LEED-Silver Certification!</p>",
            "subtext_color": true
          }
        }
      },
      "block_order": [
        "subheading_CfXipU",
        "heading_n9DVM7",
        "text_3LxtYL"
      ],
