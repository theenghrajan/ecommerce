        },
        "heading_n9DVM7": {
          "type": "heading",
          "settings": {
            "heading": "What it Means to be Florida’s First USGBC LEED Silver–Certified Manufacturer",
            "highlight_style": "none",
            "highlight_font_style": "italic",
