        "text_RHYmUy": {
          "type": "text",
          "settings": {
            "text": "<p>NADCO Tapes & Labels provides a wide range of die cutting and material converting services for manufacturing and industry. Operating from our 35,000-square-foot facility in Sarasota, FL, we supply a full spectrum of tape and labeling solutions as well as a host of other valuable services.</p><p>As part of our mission to provide industry-leading service, we offer a broad spectrum of die cutting and custom material converting amenities. We understand that each individual business and application requires its own attention and care, and we’re ready to do what it takes to create the perfect solution for your needs.</p>",
            "text_size": "text-base"
          }
        }
