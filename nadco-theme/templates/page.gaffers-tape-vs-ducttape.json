        "collapsible_item_mnnxGN": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Ideal Uses",
            "content": "<p><strong>Household Repairs:</strong> Ideal for quick fixes and maintenance tasks, from sealing leaks to bundling materials.</p><p><strong>Packaging and Seaming:</strong> Effective for waterproof packaging and creating durable seams in various materials.</p><p><strong>Color Coding and Protection:</strong> Useful for organizing and protecting surfaces from abrasion and wear.</p>",
