        "collapsible_item_7dEk6j": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Why It Shines",
            "content": "<p>Gaffers tape, a staple in the entertainment and production industries, is celebrated for its exceptional performance in high-demand environments. This heavy-duty, vinyl-coated cloth tape offers a blend of durability and finesse that makes it indispensable for professionals who demand both functionality and aesthetics.</p>",
            "custom_liquid": "",
            "page": "",
            "open": true,
            "use_subtext_color": false
          }
        },
        "collapsible_item_QTJ4Ct": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Key Attributes",
            "content": "<p><strong>Non-Reflective Finish:</strong> The matte surface ensures that gaffers tape won’t catch unwanted light, keeping the focus where it belongs—on your project. Perfect for stage and film settings where visual clarity is essential.</p><p><strong>Residue-Free Removal:</strong> Clean removal without leaving sticky residue is a standout feature, making it ideal for delicate surfaces or temporary setups.</p><p><strong>Heat Resistance:</strong> Withstanding high temperatures, gaffers tape is reliable for use in environments exposed to heat, such as lighting rigs and electrical equipment.</p><p><strong>Durability:</strong> Tough enough to handle heavy foot traffic and rough handling, it’s an excellent choice for marking stage positions and managing cables.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        },
        "collapsible_item_MrEwp9": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Ideal Uses",
            "content": "<p><strong>Entertainment and Production:</strong> Essential for marking positions, managing cables, and ensuring safety on stage and film sets.</p><p><strong>Event Management:</strong> Ideal for creating clear, visible markers and managing temporary setups without leaving behind any residue.</p><p><strong>Specialized Repairs:</strong> Excellent for bookbinding and repairing sensitive items due to its gentle adhesive.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        }
      },
