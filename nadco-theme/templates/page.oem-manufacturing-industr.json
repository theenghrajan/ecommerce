    "custom_content_RJxq6c": {
      "type": "custom-content",
      "blocks": {
        "video_WHdrMc": {
          "type": "video",
          "settings": {
            "video_url": "https://youtu.be/Za7gTDFkWsk",
            "cover_image": "shopify://shop_images/manufacturing.png",
            "video_ratio": "9/16",
            "description": "",
            "enable_video_autoplay": false,
            "enable_video_looping": false,
            "width": "50%",
            "alignment": "center",
