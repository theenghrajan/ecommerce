{% comment %}
  Section: Media Hero + Two Promo Cards (like screenshot)
  - Uses page-width and optional page-width--fixed (no max-width setting)
  - Left big card: Image OR Video (whichever is set). If none, card hides.
  - Right side: up to 2 promo cards (blocks). Each block supports image OR video (optional).
  - If any content missing, that part hides automatically.
{% endcomment %}

{%- liquid
  assign container_class = 'page-width'
  if section.settings.use_fixed_width
    assign container_class = 'page-width page-width--fixed'
  endif

  assign left_has_media = false
  if section.settings.left_image != blank or section.settings.left_video != blank or section.settings.left_video_url != blank
    assign left_has_media = true
  endif
-%}

<section class="mhtwo-{{ section.id }}">
  <div class="{{ container_class }}">
    <div class="mhtwo__grid">

      {%- if left_has_media -%}
        <!-- LEFT BIG CARD -->
        <div class="mhtwo__left">
          <div class="mhtwo__card mhtwo__card--left">
            <div class="mhtwo__media mhtwo__media--left">
              {%- if section.settings.left_video != blank -%}
                {{
                  section.settings.left_video
                  | video_tag:
                    image_size: '1600x',
                    autoplay: section.settings.left_video_autoplay,
                    loop: section.settings.left_video_loop,
                    muted: section.settings.left_video_muted,
                    controls: section.settings.left_video_controls,
                    playsinline: true
                }}
              {%- elsif section.settings.left_video_url != blank -%}
                <div class="mhtwo__embed">
                  {%- if section.settings.left_video_url.type == 'youtube' -%}
                    <iframe
                      src="https://www.youtube.com/embed/{{ section.settings.left_video_url.id }}?autoplay={% if section.settings.left_video_autoplay %}1{% else %}0{% endif %}&mute={% if section.settings.left_video_muted %}1{% else %}0{% endif %}&loop={% if section.settings.left_video_loop %}1{% else %}0{% endif %}&playlist={{ section.settings.left_video_url.id }}&controls={% if section.settings.left_video_controls %}1{% else %}0{% endif %}&playsinline=1"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      title="Video"
                    ></iframe>
                  {%- else -%}
                    <iframe
                      src="https://player.vimeo.com/video/{{ section.settings.left_video_url.id }}?autoplay={% if section.settings.left_video_autoplay %}1{% else %}0{% endif %}&muted={% if section.settings.left_video_muted %}1{% else %}0{% endif %}&loop={% if section.settings.left_video_loop %}1{% else %}0{% endif %}&title=0&byline=0&portrait=0"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      title="Video"
                    ></iframe>
                  {%- endif -%}
                </div>
              {%- elsif section.settings.left_image != blank -%}
                <img
                  src="{{ section.settings.left_image | image_url: width: 2200 }}"
                  alt="{{ section.settings.left_image.alt | escape }}"
                  loading="eager" fetchpriority="high"
                  width="{{ section.settings.left_image.width }}"
                  height="{{ section.settings.left_image.height }}"
                >
              {%- endif -%}

              {%- if section.settings.left_overlay_enable -%}
                <div class="mhtwo__overlay" style="opacity: {{ section.settings.left_overlay_opacity | divided_by: 100.0 }};">&nbsp;</div>
              {%- endif -%}
            </div>

            <div class="mhtwo__content mhtwo__content--left">
              {%- if section.settings.left_heading != blank -%}
                <h1 class="mhtwo__heading mhtwo__heading--left">{{ section.settings.left_heading }}</h1>
              {%- endif -%}

              {%- if section.settings.left_text != blank -%}
                <div class="mhtwo__text mhtwo__text--left">{{ section.settings.left_text }}</div>
              {%- endif -%}

              {%- if section.settings.left_btn_label != blank -%}
                <div class="mhtwo__actions">
                  <a
                    class="mhtwo__btn mhtwo__btn--left"
                    href="{{ section.settings.left_btn_link | default: '#' }}"
                    {% if section.settings.left_btn_new_tab %}target="_blank" rel="noopener"{% endif %}
                  >
                    {{ section.settings.left_btn_label }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}

      <!-- RIGHT PROMO CARDS -->
      <div class="mhtwo__right">
        <div class="mhtwo__right-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'promo_card' -%}
              {%- liquid
                assign has_any = false
                if block.settings.heading != blank or block.settings.text != blank or block.settings.btn_label != blank or block.settings.image != blank or block.settings.video != blank or block.settings.video_url != blank
                  assign has_any = true
                endif
              -%}

              {%- if has_any -%}
                <div class="mhtwo__card mhtwo__card--promo" style="background: {{ block.settings.bg }};" {{ block.shopify_attributes }}>
                  <div class="mhtwo__promo-inner">
                    <div class="mhtwo__promo-top">
                      {%- if block.settings.heading != blank -%}
                        <h2 class="mhtwo__heading mhtwo__heading--promo" style="color: {{ block.settings.heading_color }};">
                          {{ block.settings.heading }}
                        </h2>
                      {%- endif -%}

                      {%- if block.settings.text != blank -%}
                        <div class="mhtwo__text mhtwo__text--promo" style="color: {{ block.settings.text_color }};">
                          {{ block.settings.text }}
                        </div>
                      {%- endif -%}
                    </div>

                    {%- if block.settings.video != blank or block.settings.video_url != blank or block.settings.image != blank -%}
                      <div class="mhtwo__promo-media">
                        {%- if block.settings.video != blank -%}
                          {{
                            block.settings.video
                            | video_tag:
                              image_size: '900x',
                              autoplay: block.settings.video_autoplay,
                              loop: block.settings.video_loop,
                              muted: block.settings.video_muted,
                              controls: block.settings.video_controls,
                              playsinline: true
                          }}
                        {%- elsif block.settings.video_url != blank -%}
                          <div class="mhtwo__embed">
                            {%- if block.settings.video_url.type == 'youtube' -%}
                              <iframe
                                src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay={% if block.settings.video_autoplay %}1{% else %}0{% endif %}&mute={% if block.settings.video_muted %}1{% else %}0{% endif %}&loop={% if block.settings.video_loop %}1{% else %}0{% endif %}&playlist={{ block.settings.video_url.id }}&controls={% if block.settings.video_controls %}1{% else %}0{% endif %}&playsinline=1"
                                allow="autoplay; encrypted-media"
                                allowfullscreen
                                title="Video"
                              ></iframe>
                            {%- else -%}
                              <iframe
                                src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay={% if block.settings.video_autoplay %}1{% else %}0{% endif %}&muted={% if block.settings.video_muted %}1{% else %}0{% endif %}&loop={% if block.settings.video_loop %}1{% else %}0{% endif %}&title=0&byline=0&portrait=0"
                                allow="autoplay; encrypted-media"
                                allowfullscreen
                                title="Video"
                              ></iframe>
                            {%- endif -%}
                          </div>
                        {%- elsif block.settings.image != blank -%}
                          <img
                            src="{{ block.settings.image | image_url: width: 1200 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="eager" fetchpriority="high"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                            style="object-fit: {{ block.settings.media_fit }};"
                          >
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.btn_label != blank -%}
                      <div class="mhtwo__promo-actions">
                        <a
                          class="mhtwo__btn mhtwo__btn--promo"
                          href="{{ block.settings.btn_link | default: '#' }}"
                          {% if block.settings.btn_new_tab %}target="_blank" rel="noopener"{% endif %}
                          style="background: {{ block.settings.btn_bg }}; color: {{ block.settings.btn_text }};"
                        >
                          {{ block.settings.btn_label }}
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>

  <style>
    .mhtwo-{{ section.id }}{
      --gap: {{ section.settings.gap }}px;
      --radius: {{ section.settings.radius }}px;
      --left-min-h: {{ section.settings.left_min_height }}px;
      --promo-min-h: {{ section.settings.promo_min_height }}px;

      --left_heading_color: {{ section.settings.left_heading_color }};
      --left_text_color: {{ section.settings.left_text_color }};
      --left_btn_bg: {{ section.settings.left_btn_bg }};
      --left_btn_text: {{ section.settings.left_btn_text }};
      --left_btn_border: {{ section.settings.left_btn_border }};

      padding: {{ section.settings.pad_y }}px 0;
    }

    .mhtwo-{{ section.id }} .mhtwo__grid{
      display:grid;
      grid-template-columns: 1.45fr 1fr;
      gap: var(--gap);
      align-items: stretch;
    }

    .mhtwo-{{ section.id }} .mhtwo__card{
      border-radius: var(--radius);
      overflow:hidden;
      position:relative;
      height: 100%;
    }

    /* LEFT */
    .mhtwo-{{ section.id }} .mhtwo__card--left{
      min-height: var(--left-min-h);
      background: #111;
    }

    .mhtwo-{{ section.id }} .mhtwo__media{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
    }

    .mhtwo-{{ section.id }} .mhtwo__media img,
    .mhtwo-{{ section.id }} .mhtwo__media video{
      width:100%;
      height:100%;
      object-fit: {{ section.settings.left_media_fit }};
      display:block;
    }

    .mhtwo-{{ section.id }} .mhtwo__embed{
      position:relative;
      width:100%;
      height:100%;
    }
    .mhtwo-{{ section.id }} .mhtwo__embed iframe{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      border:0;
    }

    .mhtwo-{{ section.id }} .mhtwo__overlay{
      position:absolute;
      inset:0;
      background: {{ section.settings.left_overlay_color }};
      pointer-events:none;
    }

    .mhtwo-{{ section.id }} .mhtwo__content--left{
      position:relative;
      z-index:2;
      height:100%;
      display:flex;
      flex-direction:column;
      justify-content:flex-end;
      padding: {{ section.settings.left_content_pad }}px;
    }

    .mhtwo-{{ section.id }} .mhtwo__heading--left{
      margin:0 0 10px;
      font-size: {{ section.settings.left_heading_size }}px;
      line-height: 1.12;
      font-weight: 900;
      color: var(--left_heading_color);
      max-width: {{ section.settings.left_text_max_width }}px;
    }

    .mhtwo-{{ section.id }} .mhtwo__text--left{
      color: var(--left_text_color);
      font-size: {{ section.settings.left_text_size }}px;
      line-height: 1.45;
      max-width: {{ section.settings.left_text_max_width }}px;
      margin-bottom: 16px;
    }

    .mhtwo-{{ section.id }} .mhtwo__btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 14px 22px;
      border-radius: {{ section.settings.btn_radius }}px;
      font-weight: 800;
      text-decoration:none;
      transition: transform .18s ease, opacity .18s ease;
      border: 2px solid transparent;
      min-width: 180px;
    }
    .mhtwo-{{ section.id }} .mhtwo__btn:hover{ transform: translateY(-1px); opacity: .95; }

    .mhtwo-{{ section.id }} .mhtwo__btn--left{
      background: var(--left_btn_bg);
      color: var(--left_btn_text);
      border-color: var(--left_btn_border);
    }

    /* RIGHT */
    .mhtwo-{{ section.id }} .mhtwo__right-grid{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--gap);
      height: 100%;
    }

    .mhtwo-{{ section.id }} .mhtwo__card--promo{
      min-height: var(--promo-min-h);
      border: 1px solid rgba(0,0,0,.06);
    }

    .mhtwo-{{ section.id }} .mhtwo__promo-inner{
      height:100%;
      display:flex;
      flex-direction:column;
      padding: {{ section.settings.promo_pad }}px;
      text-align:center;
    }

    .mhtwo-{{ section.id }} .mhtwo__promo-top{
      padding-top: 6px;
    }

    .mhtwo-{{ section.id }} .mhtwo__heading--promo{
      margin: 0 0 10px;
      font-size: {{ section.settings.promo_heading_size }}px;
      line-height: 1.12;
      font-weight: 900;
    }

    .mhtwo-{{ section.id }} .mhtwo__text--promo{
      margin: 0 0 10px;
      font-size: {{ section.settings.promo_text_size }}px;
      line-height: 1.4;
      font-weight: 500;
    }

    .mhtwo-{{ section.id }} .mhtwo__promo-media{
      flex: 1 1 auto;
      display:flex;
      align-items:center;
      justify-content:center;
      padding: 10px 0 6px;
    }

    .mhtwo-{{ section.id }} .mhtwo__promo-media img,
    .mhtwo-{{ section.id }} .mhtwo__promo-media video{
      width: 100%;
      max-width: {{ section.settings.promo_media_max_width }}px;
      height: auto;
      max-height: {{ section.settings.promo_media_max_height }}px;
      display:block;
    }

    .mhtwo-{{ section.id }} .mhtwo__promo-media video{
      border-radius: 10px;
    }

    .mhtwo-{{ section.id }} .mhtwo__promo-actions{
      padding-top: 10px;
      display:flex;
      justify-content:center;
    }

    .mhtwo-{{ section.id }} .mhtwo__btn--promo{
      background: #0b0b0b;
      color: #fff;
      min-width: 100%;
      border-color: rgba(0,0,0,.12);
    }

    /* Responsive */
    @media (max-width: 990px){
      .mhtwo-{{ section.id }} .mhtwo__grid{
        grid-template-columns: 1fr;
      }
      .mhtwo-{{ section.id }} .mhtwo__right-grid{
        grid-template-columns: 1fr;
      }
      .mhtwo-{{ section.id }} .mhtwo__heading--left{
        font-size: {{ section.settings.left_heading_size_mobile }}px;
      }
      .mhtwo-{{ section.id }} .mhtwo__content--left{
        padding: {{ section.settings.left_content_pad_mobile }}px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Media Hero + 2 Cards",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_fixed_width",
      "label": "Use fixed page width (adds page-width--fixed)",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Section padding (top/bottom)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 18
    },

    { "type": "header", "content": "Left Big Card (media)" },
    { "type": "image_picker", "id": "left_image", "label": "Left image" },
    { "type": "video", "id": "left_video", "label": "Left video (Shopify hosted)" },
    { "type": "video_url", "id": "left_video_url", "label": "Left video URL (YouTube/Vimeo)", "accept": ["youtube", "vimeo"] },

    {
      "type": "select",
      "id": "left_media_fit",
      "label": "Left media fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    { "type": "checkbox", "id": "left_video_autoplay", "label": "Left video autoplay", "default": true },
    { "type": "checkbox", "id": "left_video_loop", "label": "Left video loop", "default": true },
    { "type": "checkbox", "id": "left_video_muted", "label": "Left video muted", "default": true },
    { "type": "checkbox", "id": "left_video_controls", "label": "Left video controls", "default": false },

    { "type": "range", "id": "left_min_height", "label": "Left card min height", "min": 240, "max": 700, "step": 10, "default": 430 },

    { "type": "checkbox", "id": "left_overlay_enable", "label": "Enable overlay", "default": true },
    { "type": "color", "id": "left_overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "left_overlay_opacity", "label": "Overlay opacity (%)", "min": 0, "max": 90, "step": 5, "default": 40 },

    { "type": "header", "content": "Left Big Card (content)" },
    { "type": "text", "id": "left_heading", "label": "Heading", "default": "If you can imagine it, NADCO® will make it stick!" },
    { "type": "richtext", "id": "left_text", "label": "Text", "default": "<p>We're both a custom label company AND a custom tape company that always finds a way to get the job done.</p>" },
    { "type": "text", "id": "left_btn_label", "label": "Button label", "default": "Request a Quote" },
    { "type": "url", "id": "left_btn_link", "label": "Button link" },
    { "type": "checkbox", "id": "left_btn_new_tab", "label": "Open button in new tab", "default": false },

    { "type": "color", "id": "left_heading_color", "label": "Left heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "left_text_color", "label": "Left text color", "default": "#FFFFFF" },

    { "type": "color", "id": "left_btn_bg", "label": "Left button background", "default": "#FFFFFF" },
    { "type": "color", "id": "left_btn_text", "label": "Left button text", "default": "#0B75B9" },
    { "type": "color", "id": "left_btn_border", "label": "Left button border", "default": "#FFFFFF" },

    { "type": "range", "id": "left_heading_size", "label": "Left heading size (desktop)", "min": 20, "max": 64, "step": 1, "default": 40 },
    { "type": "range", "id": "left_heading_size_mobile", "label": "Left heading size (mobile)", "min": 18, "max": 44, "step": 1, "default": 28 },
    { "type": "range", "id": "left_text_size", "label": "Left text size", "min": 12, "max": 20, "step": 1, "default": 14 },

    { "type": "range", "id": "left_content_pad", "label": "Left content padding (desktop)", "min": 16, "max": 70, "step": 2, "default": 34 },
    { "type": "range", "id": "left_content_pad_mobile", "label": "Left content padding (mobile)", "min": 14, "max": 40, "step": 2, "default": 22 },
    { "type": "range", "id": "left_text_max_width", "label": "Left content max width (px)", "min": 280, "max": 760, "step": 10, "default": 520 },

    { "type": "header", "content": "Buttons (global)" },
    { "type": "range", "id": "btn_radius", "label": "Button radius", "min": 0, "max": 30, "step": 1, "default": 10 },

    { "type": "header", "content": "Promo Cards (right) layout" },
    { "type": "range", "id": "promo_min_height", "label": "Promo card min height", "min": 220, "max": 650, "step": 10, "default": 430 },
    { "type": "range", "id": "promo_pad", "label": "Promo card padding", "min": 14, "max": 50, "step": 2, "default": 26 },
    { "type": "range", "id": "promo_heading_size", "label": "Promo heading size", "min": 16, "max": 42, "step": 1, "default": 28 },
    { "type": "range", "id": "promo_text_size", "label": "Promo text size", "min": 12, "max": 18, "step": 1, "default": 13 },
    { "type": "range", "id": "promo_media_max_width", "label": "Promo media max width (px)", "min": 160, "max": 520, "step": 10, "default": 360 },
    { "type": "range", "id": "promo_media_max_height", "label": "Promo media max height (px)", "min": 120, "max": 420, "step": 10, "default": 260 }
  ],
  "blocks": [
    {
      "type": "promo_card",
      "name": "Promo card",
      "limit": 2,
      "settings": [
        { "type": "color", "id": "bg", "label": "Background", "default": "#EFE5C8" },

        { "type": "text", "id": "heading", "label": "Heading", "default": "Custom Printed Tapes" },
        { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },

        { "type": "text", "id": "text", "label": "Text", "default": "Perfect for adding a pop of personality to your little one's wardrobe!" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },

        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video (Shopify hosted)" },
        { "type": "video_url", "id": "video_url", "label": "Video URL (YouTube/Vimeo)", "accept": ["youtube", "vimeo"] },

        {
          "type": "select",
          "id": "media_fit",
          "label": "Image fit",
          "default": "contain",
          "options": [
            { "value": "contain", "label": "Contain" },
            { "value": "cover", "label": "Cover" }
          ]
        },

        { "type": "checkbox", "id": "video_autoplay", "label": "Video autoplay", "default": false },
        { "type": "checkbox", "id": "video_loop", "label": "Video loop", "default": true },
        { "type": "checkbox", "id": "video_muted", "label": "Video muted", "default": true },
        { "type": "checkbox", "id": "video_controls", "label": "Video controls", "default": true },

        { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop Now" },
        { "type": "url", "id": "btn_link", "label": "Button link" },
        { "type": "checkbox", "id": "btn_new_tab", "label": "Open in new tab", "default": false },
        { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#0B0B0B" },
        { "type": "color", "id": "btn_text", "label": "Button text", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Hero",
      "blocks": [
        { "type": "promo_card" },
        { "type": "promo_card", "settings": { "bg": "#CFE0EF", "heading": "Custom Printed Labels", "text": "We know custom!" } }
      ]
    }
  ]
}
{% endschema %}
