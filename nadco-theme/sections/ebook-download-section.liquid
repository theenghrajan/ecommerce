{% style %}
.ebook-hero {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg_color }};
}
.ebook-hero-inner {
  /* max-width: {{ section.settings.container_width }}px; */
  margin: 0 auto;
  border-radius: {{ section.settings.radius }}px;
  /* overflow: hidden; */
  position: relative;
  background-color: {{ section.settings.card_bg }};
    background-image: {% if section.settings.bg_image != blank %}url({{ section.settings.bg_image | image_url: width: 2000 }}){% else %}none{% endif %};
  background-size: cover;
  background-position: center;
  opacity: {{ section.settings.bg_image_opacity | divided_by: 100.0 }};
}

.ebook-hero-content {
  /* position: relative;
  z-index: 2; */
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 40px;
  padding:0  50px;
  align-items: center;
}
.ebook-left h2 {
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  margin-bottom: 25px;
}
.ebook-form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.ebook-form input {
  width: 100%;
  padding: 14px 16px;
  border-radius: {{ section.settings.input_radius }}px;
  border: 1px solid {{ section.settings.input_border }};
  font-size: {{ section.settings.input_text_size }}px;
}
.ebook-form button {
  grid-column: span 2;
  margin-top: 10px;
  padding: 16px;
  border-radius: {{ section.settings.btn_radius }}px;
  background: {{ section.settings.btn_bg }};
  color: {{ section.settings.btn_color }};
  border: none;
  font-size: {{ section.settings.btn_text_size }}px;
  font-weight: 600;
  cursor: pointer;
}

.ebook-form-btn {
  grid-column: span 2;
  margin-top: 10px;
  padding: 16px;
  border-radius: {{ section.settings.btn_radius }}px;
  background: {{ section.settings.btn_bg }};
  color: {{ section.settings.btn_color }};
  border: none;
  font-size: {{ section.settings.btn_text_size }}px;
  font-weight: 600;
  cursor: pointer;
}
.ebook-right {
  position: relative;
  min-height: 340px;
}
.ebook-book.book-1,.ebook-book.book-2{
        /* position: relative; */
    overflow: hidden;
        height: 209px;
        width: 100%;
}
.ebook-book.book-3 {
    /* position: relative; */
    overflow: hidden;
    height: 258px;
    /* width: 100%; */
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    top: 94px;
    right: 158px;
    width: 194px;
    transform: rotate(16deg);
}
.ebook-book.book-1 img {

    margin: -169px 0 0 41px;
    transform: rotate(16deg);
    width: 220px;
}
.ebook-book.book-1 img {
    margin: -139px 0 0 60px;
    transform: rotate(16deg);
    width: 190px;
}
.ebook-book.book-3 img {
    /* margin: -139px 0 0 60px; */
    /* transform: rotate(16deg); */
    width: 100%;
    object-fit: cover;
}
.ebook-book {
  position: absolute;
  max-width: {{ section.settings.book_width }}px;
  /* box-shadow: 0 20px 40px rgba(0,0,0,0.25); */
}
.ebook-book.book-1{
    top: 0;
    right: 0px;
    /* transform: rotate(18deg); */
}
.ebook-book.book-2 img {
 width: 170px;
       margin: 19px 0 0 61px;
    transform: rotate(16deg);
}
.ebook-book.book-2{
     top: 131px;
    right: -50px;
    transform: rotate(0deg);
}
.ebook-left {
      max-width: 540px;
}
@media(max-width: 900px) {
  .ebook-hero-content {
    grid-template-columns: 1fr;
padding: 30px 20px;
  }
  .ebook-right {
    display: none;
  }
  .ebook-left {
    margin: auto;
        max-width: 700px;
    width: 100%;
}
}
.richtext-ebook h6{
  color: white;
}
{% endstyle %}

<section class="ebook-hero page-width page-width--fixed">
  <div class="ebook-hero-inner">
    {% comment %} <div class="ebook-hero-bg">&nbsp;</div> {% endcomment %}

    <div class="ebook-hero-content">
      <div class="ebook-left">
        <h2>{{ section.settings.heading }}</h2>

      {%- assign has_inputs = false -%}

      {%- if section.settings.first_name_placeholder != blank 
          or section.settings.last_name_placeholder != blank 
          or section.settings.email_placeholder != blank 
          or section.settings.phone_placeholder != blank -%}
        {%- assign has_inputs = true -%}
      {%- endif -%}

      {%- if has_inputs -%}
        {%- form 'contact', class: 'ebook-form' -%}
          {% if section.settings.first_name_placeholder != blank %}
            <input type="text" name="contact[first_name]" placeholder="{{ section.settings.first_name_placeholder }}" required>
          {% endif %}

          {% if section.settings.last_name_placeholder != blank %}
            <input type="text" name="contact[last_name]" placeholder="{{ section.settings.last_name_placeholder }}" required>
          {% endif %}

          {% if section.settings.email_placeholder != blank %}
            <input type="email" name="contact[email]" placeholder="{{ section.settings.email_placeholder }}" required>
          {% endif %}

          {% if section.settings.phone_placeholder != blank %}
            <input type="tel" name="contact[phone]" placeholder="{{ section.settings.phone_placeholder }}">
          {% endif %}

          {% if section.settings.rich_text != blank %}
            <div style="color: {{ section.settings.heading_color }}">
              {{ section.settings.rich_text }}
            </div>
          {% endif %}

          <button type="submit">{{ section.settings.btn_text }}</button>
        {%- endform -%}

      {%- else -%}
        {% if section.settings.rich_text != blank %}
          <div  style="margin-bottom: 35px;" class="richtext">
            <p style="color: {{ section.settings.heading_color }};">{{ section.settings.rich_text }}</p>
          </div>
        {% endif %}
        
        <a href="{{ section.settings.btn_url }}" class="button ebook-form-btn">
          {{ section.settings.btn_text }}
        </a>
      {%- endif -%}

      </div>

      <div class="ebook-right">
        {% if section.settings.book_1 != blank %}
            <div  class="ebook-book book-1">
              <img src="{{ section.settings.book_1 | image_url: width: 600 }}" alt="">
            </div>
        {% endif %}
        {% if section.settings.book_2 != blank %}
            <div class="ebook-book book-2">
              <img  src="{{ section.settings.book_2 | image_url: width: 600 }}" alt="">
            </div>
        {% endif %}
        {% if section.settings.book_3 != blank %}
            <div class="ebook-book book-3">
              <img  src="{{ section.settings.book_3 | image_url: width: 600 }}" alt="">
            </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ebook Hero Exact",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Outer background color", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card base color", "default": "#2b2948" },

    { "type": "image_picker", "id": "bg_image", "label": "Background image pattern" },
    { "type": "range", "id": "bg_image_opacity", "label": "Background image opacity", "min": 5, "max": 100, "step": 5, "default": 100 },
    { "type": "range", "id": "radius", "label": "Section radius", "min": 0, "max": 40, "step": 2, "default": 24 },

    { "type": "text", "id": "heading", "label": "Heading", "default": "Browse Our Ebook Library" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 60, "step": 2, "default": 38 },

    { "type": "text", "id": "rich_text", "label": "Section Text"},
    { "type": "url", "id": "btn_url", "label": "Button Link (Fallback)"},

    { "type": "text", "id": "form_action", "label": "Form action URL" },
    { "type": "text", "id": "first_name_placeholder", "label": "First name placeholder", "default": "First Name" },
    { "type": "text", "id": "last_name_placeholder", "label": "Last name placeholder", "default": "Last Name" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Email Address" },
    { "type": "text", "id": "phone_placeholder", "label": "Phone placeholder", "default": "Phone No." },

    { "type": "color", "id": "input_border", "label": "Input border color", "default": "#d9d9d9" },
    { "type": "range", "id": "input_radius", "label": "Input radius", "min": 0, "max": 30, "step": 2, "default": 6 },
    { "type": "range", "id": "input_text_size", "label": "Input text size", "min": 12, "max": 22, "step": 1, "default": 14 },

    { "type": "text", "id": "btn_text", "label": "Button text", "default": "Download Ebook" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#2a73c5" },
    { "type": "color", "id": "btn_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "btn_radius", "label": "Button radius", "min": 0, "max": 30, "step": 2, "default": 8 },
    { "type": "range", "id": "btn_text_size", "label": "Button text size", "min": 12, "max": 24, "step": 1, "default": 16 },

    { "type": "image_picker", "id": "book_1", "label": "Book image left" },
    { "type": "image_picker", "id": "book_2", "label": "Book image right" },
    { "type": "image_picker", "id": "book_3", "label": "Book image Third" },
    { "type": "range", "id": "book_width", "label": "Book image width", "min": 180, "max": 420, "step": 10, "default": 280 },

    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 20, "max": 150, "step": 5, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 20, "max": 150, "step": 5, "default": 80 }
  ],
  "presets": [
    { "name": "Ebook Hero Exact" }
  ]
}
{% endschema %}
