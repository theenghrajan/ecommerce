<style>
  .sub-collections-grid {
    display: grid;
    grid-template-columns: repeat({{ settings.grid_columns | default: 4 }}, 1fr);
    gap: {{ settings.grid_gap | default: 24 }}px;
    padding: 40px 0;
  }

  .sub-collection-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid {{ settings.card_border_color | default: '#e5e5e5' }};
    border-radius: {{ settings.border_radius | default: 8 }}px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sub-collection-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    border-color: transparent;
  }

  .sub-collection-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1; 
    overflow: hidden;
    background: #f5f5f5;
  }

  .sub-collection-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .sub-collection-card:hover .sub-collection-image img {
    transform: scale(1.05);
  }

  .sub-collection-content {
    padding: {{ settings.content_padding | default: 16 }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .sub-collection-title {
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
    font-size: {{ settings.title_font_size | default: 16 }}px;
    color: #121212;
  }

  .sub-collection-card:hover .sub-collection-title {
    color: #000;
  }

  @media screen and (max-width: 1000px) {
    .sub-collections-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }

  @media screen and (max-width: 480px) {
    .sub-collections-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% if collection.metafields.custom.sub_collection != blank %}
  <div class="section__container page-width">
    <div class="sub-collections-grid">
      {% for sub_collection in collection.metafields.custom.sub_collection.value %}
        <a href="{{ sub_collection.url }}" class="sub-collection-card">
          <div class="sub-collection-image">
            {% if sub_collection.featured_image %}
              <img
                src="{{ sub_collection.featured_image | image_url: width: 800 }}"
                alt="{{ sub_collection.title | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>

          <div class="sub-collection-content">
            <h3 class="sub-collection-title">
              {{ sub_collection.title }}
            </h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Sub Collections",
  "settings": [
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Grid Columns",
      "min": 1,
      "max": 6,
      "default": 4,
      "step": 1
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 25
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 10
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (px)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Description Font Size (px)",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content Padding (px)",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Sub Collections",
      "settings": {
        "grid_columns": 4,
        "grid_gap": 25,
        "card_border_color": "#e5e5e5",
        "border_radius": 10,
        "title_font_size": 20,
        "description_font_size": 15,
        "content_padding": 20
      }
    }
  ]
}
{% endschema %}