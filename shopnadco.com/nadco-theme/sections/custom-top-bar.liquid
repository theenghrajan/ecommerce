
<!-- Add Swiper.js Script -->
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

<style>
  .custom-topbar-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-size: {{ section.settings.font_size }}px;
    overflow: hidden;
  }

  .custom-topbar-{{ section.id }} .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .custom-topbar-{{ section.id }} a {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    white-space: nowrap;
  }

  .custom-topbar-{{ section.id }} a:hover {
    color: {{ section.settings.link_hover_color }};
    text-decoration: underline;
  }

  .custom-topbar-{{ section.id }} .left,
  .custom-topbar-{{ section.id }} .right {
    display: flex;
    align-items: center;
  }

  .custom-topbar-{{ section.id }} .item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .custom-topbar-{{ section.id }} .item img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .custom-topbar-{{ section.id }} .divider {
    margin: 0 10px;
  }

  .custom-topbar-{{ section.id }} .center {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: {{ section.settings.center_font_weight }};
    text-transform: uppercase;
  }

  .custom-topbar-{{ section.id }} .shop-now {
    text-decoration: underline;
    font-weight: {{ section.settings.shop_now_weight }};
  }

  .custom-topbar-{{ section.id }} .se-swiper-container {
    width: 100%;
    height: 100%;
  }

  .custom-topbar-{{ section.id }} .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .custom-topbar-{{ section.id }} .mobile-sh {
    display: none;
  }

  @media (max-width: 768px) {
    .custom-topbar-{{ section.id }} {
      padding-top: 4px;
      padding-bottom: 4px;
    }

    .custom-topbar-{{ section.id }} .deskt-sh {
      display: none !important;
    }

    .custom-topbar-{{ section.id }} .mobile-sh {
      display: block;
    }

    .custom-topbar-{{ section.id }} .topbar-inner {
      justify-content: center;
    }

    .custom-topbar-{{ section.id }} .left,
    .custom-topbar-{{ section.id }} .right {
      display: none;
    }

    .custom-topbar-{{ section.id }} .center {
      {% comment %} flex-direction: column; {% endcomment %}
      gap: 2px;
      font-size: 11px;
    }

    .custom-topbar-{{ section.id }} .swiper-wrapper {
      align-items: center;
    }
  }
</style>

<div class="custom-topbar custom-topbar-{{ section.id }}" data-interval="{{ section.settings.mobile_slide_time }}">
  <div class="topbar-inner deskt-sh">
    <div class="left">
      {% assign left_blocks = section.blocks | where: 'type', 'left_item' %}
      {% for block in left_blocks %}
        <div class="item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | image_url: width: 20 }}" alt="">
          {% endif %}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        </div>
        {% unless forloop.last %}
          <span class="divider">•</span>
        {% endunless %}
      {% endfor %}
    </div>

    <div class="center cs-di">
      <span>{{ section.settings.promo_text }}</span>
      <svg width="10" height="2" viewBox="0 0 10 2" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 0.75H10" stroke="white" stroke-width="1.5"/>
      </svg>
      <a class="shop-now" href="{{ section.settings.promo_link }}">
        {{ section.settings.promo_link_text }}
      </a>
    </div>

    <div class="right">
      {% assign right_blocks = section.blocks | where: 'type', 'right_item' %}
      {% for block in right_blocks %}
        <div class="item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | image_url: width: 20 }}" alt="">
          {% endif %}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        </div>
        {% unless forloop.last %}
          <span class="divider">•</span>
        {% endunless %}
      {% endfor %}
    </div>
  </div>

  <div class="se-swiper-container mobile-sh">
    <div class="swiper-wrapper">
      <div class="center swiper-slide cs-di">
        <span>{{ section.settings.promo_text }}</span>
        <svg width="10" height="2" viewBox="0 0 10 2" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 0.75H10" stroke="white" stroke-width="1.5"/>
        </svg>
        <a class="shop-now" href="{{ section.settings.promo_link }}">
          {{ section.settings.promo_link_text }}
        </a>
      </div>

      {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="item" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | image_url: width: 20 }}" alt="">
            {% endif %}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  // Initialize Swiper for mobile
  var swiper = new Swiper('.se-swiper-container', {
    slidesPerView: 1,
    spaceBetween: 10,
    {% comment %} autoplay: {
      delay: {{ section.settings.mobile_slide_time }},
      disableOnInteraction: false,
    }, {% endcomment %}
    loop: true,
    draggable: true,
    {% comment %} pagination: {
      el: '.swiper-pagination',
      clickable: true,
    }, {% endcomment %}
  });
</script>


{% schema %}
{
  "name": "Top Bar Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link Hover Color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content Max Width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "default": 1600
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo Text",
      "default": "Save up to 10% on orders over $200"
    },
    {
      "type": "text",
      "id": "promo_link_text",
      "label": "Promo Link Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Promo Link"
    },
    {
      "type": "range",
      "id": "center_font_weight",
      "label": "Promo Font Weight",
      "min": 300,
      "max": 800,
      "step": 100,
      "default": 600
    },
    {
      "type": "range",
      "id": "shop_now_weight",
      "label": "Shop Now Font Weight",
      "min": 300,
      "max": 800,
      "step": 100,
      "default": 700
    },
    {
      "type": "range",
      "id": "mobile_slide_time",
      "label": "Mobile Slide Change Time ms",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "left_item",
      "name": "Left Link",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "right_item",
      "name": "Right Link",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top Bar Header"
    }
  ]
}
{% endschema %}
