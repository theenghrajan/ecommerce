{% style %}
.environment-cert {
  width: 100%;
  background: {{ section.settings.main_bg }};
  padding: 40px 20px;
}

.environment-cert__wrapper {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 30px;
  align-items: stretch;
}

.environment-cert__content {
  background: {{ section.settings.content_bg }};
  padding: 30px;
  color: {{ section.settings.text_color }};
}

.environment-cert__heading {
  font-size: 28px;
  font-weight: 600;
  margin-bottom: 20px;
}

.environment-cert__list {
  margin: 0;
  padding-left: 20px;
}

.environment-cert__list li {
  margin-bottom: 14px;
  line-height: 1.6;
}

.environment-cert__footer {
  margin-top: 20px;
  font-size: 14px;
}

.environment-cert__footer a {
  color: {{ section.settings.link_color }};
  text-decoration: underline;
}

.environment-cert__cert {
  background: {{ section.settings.main_bg }};
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px;
}

.environment-cert__cert img {
  max-width: 220px;
  width: 100%;
}

.environment-cert__cert-number {
  margin-top: 20px;
  font-size: 14px;
  color: {{ section.settings.text_color }};
}

@media (max-width: 768px) {
  .environment-cert__wrapper {
    grid-template-columns: 1fr;
  }
}
{% endstyle %}

<section class="environment-cert">
  <div class="environment-cert__wrapper">
    
    <!-- LEFT CONTENT -->
    <div class="environment-cert__content">
      <h2 class="environment-cert__heading">
        {{ section.settings.heading }}
      </h2>

      <ul class="environment-cert__list">
        {% for block in section.blocks %}
          <li>{{ block.settings.point }}</li>
        {% endfor %}
      </ul>

      <div class="environment-cert__footer">
        {{ section.settings.footer_text }}
        {% if section.settings.link_url != blank %}
          <br>
          <a href="{{ section.settings.link_url }}" target="_blank">
            {{ section.settings.link_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- RIGHT CERTIFICATION -->
    <div class="environment-cert__cert">
      <div>
        {% if section.settings.cert_image %}
          <img
            src="{{ section.settings.cert_image | image_url: width: 400 }}"
            alt="Certification Logo"
          >
        {% endif %}

        {% if section.settings.cert_number != blank %}
          <div class="environment-cert__cert-number">
            {{ section.settings.cert_number }}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Environmental Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HP Indigo 6K Digital Press – Independently Verified for Environmental Credentials"
    },
    {
      "type": "color",
      "id": "main_bg",
      "label": "Main Background Color",
      "default": "#0a9f5a"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Content Box Background",
      "default": "#d9efe2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0a6f3c"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#0a6f3c"
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "Learn more about this product, environmental verification, and applicable exemptions by visiting:"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "www.intertek.com/marks/green-leaf"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "image_picker",
      "id": "cert_image",
      "label": "Certification Logo"
    },
    {
      "type": "text",
      "id": "cert_number",
      "label": "Certification Number",
      "default": "Certification No: 2001604 / 2001603 / 2001601 / 2001599 / 2001602"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "textarea",
          "id": "point",
          "label": "Bullet Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Environmental Certification",
      "blocks": [
        { "type": "point" },
        { "type": "point" },
        { "type": "point" }
      ]
    }
  ]
}
{% endschema %}
