        "heading_3ic4cA": {
          "type": "heading",
          "settings": {
            "sub_heading": "",
            "heading": "X2 Chemical Tape",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h1",
            "rich_text_cstm": "<p>This self-wound 1.5″-wide white vinyl tape is printed with “X2 CHEMICALS,” laminated for durability, and supplied in 36-yard rolls. Custom printing and optional perforation features are available to support specific application needs and easy hand-torn use.</p><p>Please <a href=\"https://12f924241c.nxcli.io/contact\" target=\"_blank\" title=\"Contact\">contact</a> your NADCO® sales representative for pricing and availability at <a href=\"tel:18008399018\">1.800.839.9018</a>.</p>"
          }
