    "image_with_text_8TqMdx": {
      "type": "image-with-text",
      "blocks": {
        "text_6FpJkX": {
          "type": "text",
          "settings": {
            "text": "<p>Adhesive foil tapes play a critical role in aerospace manufacturing, maintenance, and storage. Designed to perform in demanding environments, these materials provide reliable sealing and protection while resisting corrosion caused by chemicals, moisture, heat, and environmental exposure.</p><p>Available in multiple foil constructions, aerospace foil tapes support a wide range of applications where durability, consistency, and performance are essential. Selecting the appropriate foil tape material ensures optimal efficiency, protection, and long-term reliability.</p>",
            "subtext_color": true
          }
        }
      },
      "block_order": [
        "text_6FpJkX"
      ],
      "name": "t:sections.image-with-text.name",
      "settings": {
