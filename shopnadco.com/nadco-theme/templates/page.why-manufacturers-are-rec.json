        "mobile_content_alignment": "inherit",
        "show_section_divider": false,
        "divider_width": "fixed",
        "padding_top": 0,
        "padding_bottom": 80
      }
    },
    "image_with_text_H6aJBX": {
      "type": "image-with-text",
      "blocks": {
        "heading_aPcRGY": {
          "type": "heading",
          "settings": {
            "heading": "What Are We Seeing With Reshoring Today?",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h1"
          }
        },
        "text_mGbirx": {
          "type": "text",
          "settings": {
            "text": "<p>The Reshoring Initiative’s Data Report indicates continued growth in reshoring activity, a trend expected to persist in the coming years. A significant percentage of manufacturers in North America now report being “likely” or “extremely likely” to reshore production, highlighting a shift toward domestic supply chain investment.</p><p>Expanding domestic manufacturing has the potential to boost economic output, strengthen supplier networks, and support job creation across local communities, while reducing dependence on overseas production.</p>",
            "subtext_color": true
          }
        }
      },
      "block_order": [
        "heading_aPcRGY",
        "text_mGbirx"
      ],
      "name": "t:sections.image-with-text.name",
      "settings": {
        "container": "fixed",
        "color_scheme": "",
        "image": "shopify://shop_images/20260127_1916_Image_Generation_remix_01kfzwy1vce04vt46jy6dtaa8j_59bdc726-1286-4531-adb2-e5db6cced260.png",
        "image_position": "left",
