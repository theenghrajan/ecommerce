    "image_with_text_VbdYKm": {
      "type": "image-with-text",
      "blocks": {
        "heading_FcEFCx": {
          "type": "heading",
          "settings": {
            "heading": "Contact NADCO to Help You Reduce Lead Times!",
            "highlight_style": "none",
            "highlight_font_style": "italic",
