    "image_with_text_pjnzLB": {
      "type": "image-with-text",
      "blocks": {
        "text_fbcCVM": {
          "type": "text",
          "settings": {
            "text": "<p>Rena’ and Neil Doniger, accompanied by their daughter, celebrate the 100th anniversary of the Aruba Trading Company. Aruba has been their cherished destination since 1992.</p><p>“While we immediately liked Neil and Rena’ upon meeting them,” said Sacher, “we still conducted a thorough comparison with competitors and found that NADCO met those needs and stood out as our top choice.”</p>",
            "subtext_color": true
          }
        }
      },
      "block_order": [
        "text_fbcCVM"
      ],
