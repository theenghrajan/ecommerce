    "rich_text_NnBEnm": {
      "type": "rich-text",
      "blocks": {
        "heading_zBCeML": {
          "type": "heading",
          "settings": {
            "heading": "Learn More About NADCO’s Paper Tapes",
            "highlight_style": "none",
