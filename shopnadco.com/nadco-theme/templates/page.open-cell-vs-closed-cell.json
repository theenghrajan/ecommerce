    "rich_text_7hLpHY": {
      "type": "rich-text",
      "blocks": {
        "heading_DgzEPq": {
          "type": "heading",
          "settings": {
            "heading": "Foam Tapes from NADCO",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2"
          }
        },
        "text_DbymrK": {
          "type": "text",
          "settings": {
            "text": "<p>NADCO Tapes & Labels, LLC, designs and manufactures open and closed cell foam tapes. We supply <a href=\"https://shopnadco.com/collections/double-coated-foam-tape\" title=\"https://shopnadco.com/collections/double-coated-foam-tape\">double-sided</a> and single-sided foam tapes for a variety of critical industries, such as the aerospace and medical sectors. NADCO can<a href=\"https://shopnadco.com/pages/custom-printed-tapes\" target=\"_blank\" title=\"https://shopnadco.com/pages/custom-printed-tapes\"> customize the design</a> and properties of these tapes to suit different applications.</p><p>Our <a href=\"/pages/ebook-library\" target=\"_blank\" title=\"eBook Library\">downloadable eBook</a> offers guidance for selecting the right foam tapes for specific use cases. Our subject matter experts are also available to our customers for consultations. <a href=\"/pages/contact-us\" target=\"_blank\" title=\"Contact us\">Contact us</a> today to learn about NADCO’s products and services, and how we can help you in selecting the right foam tape for your project.</p>",
            "text_size": "text-base",
            "text_line_limit": "none",
            "button_style": "btn--underline",
            "button_icon": "none"
          }
        }
      },
