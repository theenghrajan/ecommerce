    "custom_liquid_JNb3yB": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "<style>\n.collection-description-wrapper {\n  max-width: 800px;\n  margin: 0 auto;\n}\n\n.collection-description-text {\n  font-size: 16px;\n  line-height: 1.6;\n}\n\n.collection-description-text.is-collapsed {\n  display: -webkit-box;\n  -webkit-line-clamp: 4;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.collection-read-more {\n  margin-top: 10px;\n  background: none;\n  border: none;\n  color: #000000;\n  cursor: pointer;\n  font-size: 14px;\n  padding: 0;\n}\n\n.collection-read-more:hover {\n  text-decoration: underline;\n}\n</style>\n\n{% if collection.description != blank %}\n  <div class=\"page-width collection-description-wrapper\">\n    <div class=\"collection-description-text is-collapsed\">\n      {{ collection.description }}\n    </div>\n\n    <button type=\"button\" class=\"collection-read-more\">\n      Read more\n    </button>\n  </div>\n{% endif %}\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  var wrapper = document.querySelector(\".collection-description-wrapper\");\n  if (!wrapper) return;\n\n  var textEl = wrapper.querySelector(\".collection-description-text\");\n  var btn = wrapper.querySelector(\".collection-read-more\");\n\n  btn.addEventListener(\"click\", function () {\n    if (textEl.classList.contains(\"is-collapsed\")) {\n      textEl.classList.remove(\"is-collapsed\");\n      btn.textContent = \"Read less\";\n    } else {\n      textEl.classList.add(\"is-collapsed\");\n      btn.textContent = \"Read more\";\n    }\n  });\n});\n</script>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 26
      }
    },
