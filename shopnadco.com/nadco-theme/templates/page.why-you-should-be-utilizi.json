    "custom_content_hzRNTw": {
      "type": "custom-content",
      "blocks": {
        "video_dwxaPB": {
          "type": "video",
          "settings": {
            "video_url": "https://youtu.be/yhWNdihJrIU",
            "cover_image": "shopify://shop_images/thumbnail.jpg",
            "video_ratio": "adapt",
            "description": "",
            "enable_video_autoplay": false,
