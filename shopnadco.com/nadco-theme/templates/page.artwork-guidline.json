    "collapsible_tabs_XQVQW3": {
      "type": "collapsible-tabs",
      "blocks": {
        "heading_Dqrd9W": {
          "type": "heading",
          "settings": {
            "sub_heading": "FAQ",
            "heading": "General Information",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2",
            "rich_text_cstm": "<p><strong>Submitting art via e-mail, disks or CDs:</strong> Be certain to include all fonts unless outlined, all linked or embedded high resolution images. Please make certain all elements are contained in the file provided. Low resolution images (less than 150dpi) are not acceptable for output. Please provide images with resolution no less than 150dpi, preferably 300dpi. Do Not submit images downloaded from the web! Do Not submit art that is copyrighted unless you have permission from the creator. Files requiring bleeds should be prepared with at least 1/8” bleed on all sides. If your files are large, we can have you upload them, call or email us for instructions.</p><p><strong>*Additional fees may be added for file re-creation, manipulation, revision and modifications, etc.</strong></p>"
          }
        },
        "collapsible_item_6jc8iL": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Acceptable Colors",
            "content": "<p>Files should be saved with PMS Spot Color(s), or as 4 color process (CMYK). RGB, iRGB and Index colors are not acceptable for output. RGB colors produce unexpected changes when converted to CMYK. If your art is submitted as RGB or CMYK and a specific PMS color is called out, you may be asked to submit a new file using spot colors. Keep in mind that digital printing cannot reproduce exact PMS colors. The nearest color values will be substituted. Please request Press Proof for approval if color is crucial on any Digital Output.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        },
        "collapsible_item_6NeQhE": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Graphics Files With Text",
            "content": "<p>All files submitted that contain text should be converted to outlines, unless you send along the font files.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        },
        "collapsible_item_zKwLMi": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Preferred File Format",
            "content": "<p>Vector files (.EPS .AI or .PDF) are preferred for press printing.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        },
        "collapsible_item_JhNNeh": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Copyrighted Material",
            "content": "<p>Do Not submit art that is copyrighted unless you have permission from the creator.</p><p>NADCO® Tapes & Labels is not responsible for collecting copyrighted material permission.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        },
        "collapsible_item_d8efGm": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Large File Size Artwork",
            "content": "<p>For large file sizes we recommend you submit your artwork using popular cloud-based services including:</p><ul><li><a href=\"https://workspace.google.com/products/drive/\" target=\"_blank\">Google Drive</a></li><li><a href=\"https://www.microsoft.com/en-us/microsoft-365/onedrive/online-cloud-storage\" target=\"_blank\">OneDrive</a></li><li><a href=\"https://www.dropbox.com/\" target=\"_blank\">Dropbox</a></li><li>Or similar.</li></ul><p>If you need additional guidance, feel free to give us a call at (800) 839-9018 or email us at sales@nadcoinc.com.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        },
        "collapsible_item_GFFDx8": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Support",
            "content": "<p>We are here to help. If you are unsure of what you have or what file format works best for your project, give us a call at (800) 839-9018 or email us at sales@nadcoinc.com and one of our team members would be happy to assist.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        }
      },
