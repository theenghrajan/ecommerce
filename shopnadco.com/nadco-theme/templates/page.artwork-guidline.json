        },
        "text_6WDxKK": {
          "type": "text",
          "settings": {
            "text": "<p>We do not directly support many low-end, shareware, or freeware programs that come pre-installed on personal computers, such as Multi-Ad Creator, Print Shop Deluxe, or Greeting Card Factory Deluxe. We also do not support programs like Microsoft Publisher, Word, Excel, PowerPoint, Corel, or FreeHand. Because these applications are not designed for commercial printing, we cannot guarantee color accuracy or output quality when they are used.</p>",
            "subtext_color": false
          }
