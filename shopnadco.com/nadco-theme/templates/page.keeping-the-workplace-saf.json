        "heading_EDPHPq": {
          "type": "heading",
          "settings": {
            "heading": "Keeping the Workplace Safe with Vinyl Tape",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2"
          }
