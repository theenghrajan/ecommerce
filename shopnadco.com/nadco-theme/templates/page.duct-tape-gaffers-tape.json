        "text_tNNyqd": {
          "type": "text",
          "settings": {
            "text": "<p>Gaffer’s tape and duct tape are multi-purpose, pressure-sensitive adhesive materials with many similarities but a few key distinctions. Both offer a strong, watertight hold, for example, but perform differently in extreme temperatures or high-humidity environments. Understanding these properties and more will help you make the right choice about which tape to use for your next project.</p>",
            "text_size": "text-base"
          }
        }
      },
      "block_order": [
