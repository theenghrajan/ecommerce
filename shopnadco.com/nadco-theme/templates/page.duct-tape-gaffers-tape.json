    "image_with_text_U3PqXL": {
      "type": "image-with-text",
      "blocks": {
        "heading_V3GEfT": {
          "type": "heading",
          "settings": {
            "heading": "Industrial Applications for Duct Tape",
            "highlight_style": "none",
            "highlight_font_style": "italic",
