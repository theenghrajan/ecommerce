    "custom_process_section_C3wGfr": {
      "type": "custom-process-section",
      "blocks": {
        "step_bC4EKJ": {
          "type": "step",
          "settings": {
            "icon_image": "shopify://shop_images/fi_17435852.png",
            "step_label": "Step 1",
            "title": "Conceptual Design",
            "text": "Through effective communication with our clients, we’ll gain a better understanding of their ideas and intended applications. During this stage, we may ask for technical drawings, mock-ups, or material samples."
          }
        },
        "step_EmVUEp": {
          "type": "step",
          "settings": {
            "icon_image": "shopify://shop_images/fi_16435962.png",
            "step_label": "Step 2",
            "title": "Material Specs Recommendations",
            "text": "With info from the first step, we will recommend certain adhesives, materials, manufacturing steps, etc. required to achieve the client’s goal. If needed, NADCO can send material samples for the client’s review and approval before proceeding."
          }
        },
        "step_hE6Xrk": {
          "type": "step",
          "settings": {
            "icon_image": "shopify://shop_images/fi_4338294_07c81b9e-cf2d-4be6-be65-8a36fdc629c2.png",
            "step_label": "Step 3",
            "title": "Receive a Quote",
            "text": "After finalizing all specs and materials, we present formal quotes for tooling, plates, etc."
          }
        },
        "step_VTL8rJ": {
          "type": "step",
          "settings": {
            "icon_image": "shopify://shop_images/fi_5161662.png",
            "step_label": "Step 4",
            "title": "Proofing",
            "text": "Customers receive an electronic proof showing all colors, graphics, text, dimensions, and other applicable parameters for approval. NADCO doesn’t order any materials, tooling or plates until the proof is approved."
          }
        },
        "step_AiH7BD": {
          "type": "step",
          "settings": {
            "icon_image": "shopify://shop_images/Vector_10.png",
            "step_label": "Step 5",
            "title": "First Article Inspection",
            "text": "If required, FAI is performed. This allows engineers to inspect, test, and approve finished product samples before larger production runs"
          }
        },
        "step_xR3Cij": {
          "type": "step",
          "settings": {
            "icon_image": "shopify://shop_images/Group.png",
            "step_label": "Step 6",
            "title": "Production Run",
            "text": "After FAI (if applicable) approval, we’ll complete the full production run."
          }
        }
      },
