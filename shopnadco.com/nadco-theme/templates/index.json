    "faq_with_block_agDPXY": {
      "type": "faq-with-block",
      "blocks": {
        "faq_g3p4xC": {
          "type": "faq",
          "settings": {
            "question": "Can you print UL Labels?",
            "answer": "<p>Yes, we are an approved UL label printer. (Customer is required to provide a UL Marks letter)</p>"
          }
        },
        "faq_pfj8kU": {
          "type": "faq",
          "settings": {
            "question": "Can you help with label design?",
            "answer": "<p>Yes, we have a full-service art department to help with design and layout creation.</p>"
          }
        },
        "faq_8fictb": {
          "type": "faq",
          "settings": {
            "question": "Can you add barcodes/QR codes to my label?",
            "answer": "<p>Yes, we can generate a wide assortment of 1D and 2D barcodes.</p>"
          }
        },
        "faq_NeXTti": {
          "type": "faq",
          "settings": {
            "question": "Can you print sequential number on the same roll?",
            "answer": "<p>Yes, we can print VDP (Variable Data Printing) on the same roll.</p>"
          }
        },
        "faq_BdQnFR": {
          "type": "faq",
          "settings": {
            "question": "Can you print on duct tape?",
            "answer": "<p>Yes, we can print your design on duct tape (some limitations may apply).</p>"
          }
        },
        "faq_QMtPPb": {
          "type": "faq",
          "settings": {
            "question": "Are there different grades of masking tape?",
            "answer": "<p>Yes, masking tape is typically categorized as low, medium, and high, based on the level of heat it can withstand.</p>"
          }
        },
        "faq_dFfdjm": {
          "type": "faq",
          "settings": {
            "question": "Do you have a local delivery option?",
            "answer": "<p>Yes, we offer a local delivery option for some orders. Call us at 800.839.9018 to see if local delivery is available for your shipment.</p>"
          }
        },
        "faq_eWdUxU": {
          "type": "faq",
          "settings": {
            "question": "Do I need a special adhesive for labels that will be exposed to cold temperatures? ",
            "answer": "<p>Yes, there are various materials and adhesives rated for cold temperatures, including use in a freezer. Our experts can advise which products are right for your application.</p>"
          }
        },
        "faq_JWznDV": {
          "type": "faq",
          "settings": {
            "question": "Can I pay with my credit card? ",
            "answer": "<p>Yes, you can make secure credit card payments over the phone.</p>"
          }
        }
      },
