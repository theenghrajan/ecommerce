    "collapsible_tabs_CFGRQr": {
      "type": "collapsible-tabs",
      "blocks": {
        "image_card_hTngeQ": {
          "type": "image_card",
          "settings": {
            "color_scheme": "scheme-1",
            "desktop_image_position": "left",
            "image_width": 50,
            "alignment": "center",
            "image": "shopify://shop_images/Rectangle_338.png",
            "image_ratio": "adapt",
            "image_overlay_opacity": 0,
            "content_position": "top-center",
            "content_alignment": "center",
            "content_spacing": "medium",
            "content_gap": "fitted",
            "card_link": "",
            "subheading": "",
            "subheading_style": "",
            "heading": "",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h1",
            "heading_size_mobile": "inherit",
            "heading_size_custom": 18,
            "description": "",
            "button_label": "",
