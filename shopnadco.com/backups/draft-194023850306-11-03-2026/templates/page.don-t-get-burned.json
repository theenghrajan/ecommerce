          "settings": {
            "heading": "Don’t Get Burned: Choosing the Right High-Temperature Tape or Label for Your Needs",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
