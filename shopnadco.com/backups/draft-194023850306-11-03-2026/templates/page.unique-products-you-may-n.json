        "text_Ndzije": {
          "type": "text",
          "settings": {
            "text": "<p>Our foam products offer premium <strong>conformability, adhesion, and cushioning</strong>, making them ideal for irregular or textured surfaces. Foam tapes are available in multiple densities and thicknesses to support a wide range of functional applications.</p><p><strong>Common uses:</strong></p><ul><li>Insulation</li><li>Appliance assembly</li><li>Humidity and moisture protection</li><li>Vibration and impact damping</li></ul>",
            "subtext_color": true
          }
        }
