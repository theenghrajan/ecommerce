            "highlight_text_color": "",
            "heading_size": "h1"
          }
        },
        "text_gWRgzR": {
          "type": "text",
          "settings": {
            "text": "<p>NADCO offers two banner formats to support promotional and informational displays:</p><ul><li><strong>Hanging banners</strong>, available in virtually any size</li><li><strong>Retractable banners</strong>, featuring a durable aluminum cassette and ground-level stand</li></ul><p>Both options are fully customizable and produced using durable, waterproof vinyl suitable for indoor and outdoor use. The smooth surface ensures high-quality imagery and crisp graphics.</p><p><strong>Common uses:</strong> trade shows, retail displays, events, promotions, and facilities signage.</p>",
            "subtext_color": true
          }
        }
      },
      "block_order": [
        "heading_AWbqzq",
        "text_gWRgzR"
      ],
