    "rich_text_EDpCBr": {
      "type": "rich-text",
      "blocks": {
        "heading_BRdibe": {
          "type": "heading",
          "settings": {
            "heading": "More Than Just Tapes & Labels",
            "highlight_style": "none",
            "highlight_font_style": "italic",
