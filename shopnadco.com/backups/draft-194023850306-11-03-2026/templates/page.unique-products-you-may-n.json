        "text_JhKpH7": {
          "type": "text",
          "settings": {
            "text": "<h2><strong>Unique Products You May Not Know NADCO® Offers</strong></h2><p>NADCO is known for pressure-sensitive adhesive tapes and labels, but our capabilities extend far beyond traditional offerings. We manufacture a wide range of specialty materials—both adhesive and non-adhesive—designed to support diverse industrial, commercial, and promotional applications.</p><p>Below are a few examples of unique products we produce in-house.</p>",
            "text_size": "text-base",
            "text_line_limit": "none",
            "button_style": "btn--underline",
            "button_icon": "none"
          }
        }
