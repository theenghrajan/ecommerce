            "highlight_text_color": "",
            "heading_size": "h1"
          }
        },
        "text_brefmq": {
          "type": "text",
          "settings": {
            "text": "<p>Barricade tape is a high-strength vinyl tape engineered for durability and visibility in demanding environments. It resists most common solvents, water, oils, sunlight, acids, alkalis, and corrosive chemicals.</p><p>With excellent abrasion resistance and moisture-vapor barrier properties, barricade tape performs reliably in outdoor conditions.</p><p><strong>Common uses:</strong> construction zones, hazard marking, crowd control, and restricted-area identification.</p>",
            "subtext_color": true
          }
        }
      },
      "block_order": [
