    { "type": "text", "id": "blog_title", "label": "Blog title", "default": "Latest from the Blog" },
    { "type": "range", "id": "heading_size", "label": "Heading size desktop", "min": 18, "max": 40, "step": 2, "default": 24 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 16, "max": 32, "step": 2, "default": 20 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "range", "id": "question_size", "label": "Question size desktop", "min": 12, "max": 20, "step": 1, "default": 14 },
    { "type": "range", "id": "question_size_mobile", "label": "Question size mobile", "min": 12, "max": 18, "step": 1, "default": 13 },
    { "type": "color", "id": "question_color", "label": "Question color", "default": "#000000" },
    { "type": "range", "id": "answer_size", "label": "Answer size desktop", "min": 12, "max": 20, "step": 1, "default": 14 },
    { "type": "range", "id": "answer_size_mobile", "label": "Answer size mobile", "min": 12, "max": 18, "step": 1, "default": 13 },
    { "type": "color", "id": "answer_color", "label": "Answer color", "default": "#555555" },
    { "type": "color", "id": "item_bg", "label": "Item background", "default": "#ffffff" },
    { "type": "range", "id": "item_radius", "label": "Item radius", "min": 0, "max": 20, "step": 2, "default": 10 },
    { "type": "color", "id": "meta_color", "label": "Meta text color", "default": "#888888" },
    { "type": "color", "id": "blog_title_color", "label": "Blog title color", "default": "#000000" },
    { "type": "color", "id": "link_color", "label": "Read more color", "default": "#1f6fd2" },
    { "type": "blog", "id": "blog", "label": "Select blog" },
    { "type": "range", "id": "post_limit", "label": "Posts limit", "min": 1, "max": 6, "step": 1, "default": 2 },
    { "type": "text", "id": "read_more_text", "label": "Read more text", "default": "Learn More ›" },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "View All Products" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#1f6fd2" },
    { "type": "color", "id": "btn_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "btn_radius", "label": "Button radius", "min": 0, "max": 30, "step": 2, "default": 8 },
    { "type": "range", "id": "btn_text_size", "label": "Button text size desktop", "min": 12, "max": 22, "step": 1, "default": 14 },
    { "type": "range", "id": "btn_text_size_mobile", "label": "Button text size mobile", "min": 12, "max": 20, "step": 1, "default": 13 },
    { "type": "range", "id": "padding_top", "label": "Padding top desktop", "min": 20, "max": 150, "step": 5, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom desktop", "min": 20, "max": 150, "step": 5, "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top mobile", "min": 10, "max": 120, "step": 5, "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "min": 10, "max": 120, "step": 5, "default": 40 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ with Blog" }
  ]
}
{% endschema %}
