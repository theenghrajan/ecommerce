</svg>
</span></div><span class='xb-product-quantity xb-product-quantity--bottom-right'></span></xb-wishlist-header>
         {% comment %} xb wishlist end {% endcomment %}
        <div class="cst-svg show-mobbi">
                    <svg width="22" height="20" viewBox="0 0 18 17" fill="none" xmlns="http://www.w3.org/2000/svg">
