<nav class="header__menu flex" role="navigation" aria-label="Primary">
  <ul class="flex flex-wrap">
    <li
        class="inline-flex items-center"
      >
    <div class="cst-svg">
                    <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="44" height="44" rx="22" fill="#F5F5F5"/>
          <path d="M29.9507 29.0663L26.0389 25.1554C27.1727 23.7942 27.7381 22.0483 27.6174 20.2809C27.4967 18.5135 26.6993 16.8607 25.3911 15.6663C24.0828 14.4718 22.3645 13.8277 20.5934 13.868C18.8224 13.9082 17.135 14.6297 15.8824 15.8824C14.6297 17.135 13.9082 18.8224 13.868 20.5934C13.8277 22.3645 14.4718 24.0828 15.6663 25.3911C16.8607 26.6993 18.5135 27.4967 20.2809 27.6174C22.0483 27.7381 23.7942 27.1727 25.1554 26.0389L29.0663 29.9507C29.1244 30.0087 29.1933 30.0548 29.2692 30.0862C29.345 30.1177 29.4264 30.1338 29.5085 30.1338C29.5906 30.1338 29.6719 30.1177 29.7478 30.0862C29.8237 30.0548 29.8926 30.0087 29.9507 29.9507C30.0087 29.8926 30.0548 29.8237 30.0862 29.7478C30.1177 29.6719 30.1338 29.5906 30.1338 29.5085C30.1338 29.4264 30.1177 29.345 30.0862 29.2692C30.0548 29.1933 30.0087 29.1244 29.9507 29.0663ZM15.1335 20.7585C15.1335 19.646 15.4634 18.5584 16.0815 17.6334C16.6995 16.7084 17.5781 15.9874 18.6059 15.5617C19.6337 15.1359 20.7647 15.0245 21.8559 15.2416C22.947 15.4586 23.9493 15.9943 24.736 16.781C25.5226 17.5677 26.0584 18.57 26.2754 19.6611C26.4924 20.7522 26.381 21.8832 25.9553 22.9111C25.5296 23.9389 24.8086 24.8174 23.8836 25.4355C22.9585 26.0536 21.871 26.3835 20.7585 26.3835C19.2671 26.3818 17.8374 25.7887 16.7828 24.7341C15.7283 23.6796 15.1351 22.2498 15.1335 20.7585Z" fill="#040707"/>
          </svg>

        </div>
      </li>
    {%- for link in menu.links -%}
      {%- liquid
        assign enable_mega_menu = false
        assign is_hl_item = false
        assign link_title_handle = link.title | handle
        for block in blocks
          assign menu_title_handle = block.settings.menu_title | handle
          if menu_title_handle == link_title_handle
            assign enable_mega_menu = true
            assign mega_menu_block = block
            if block.settings.enable_hl_link
              assign is_hl_item = true
              assign hl_link_style = block.settings.hl_link_style
              assign hl_link_color = block.settings.hl_link_color
            endif
            break
          endif

          assign hl_title_handle = block.settings.hl_link_title | handle
          if link_title_handle == hl_title_handle
            assign hl_link_style = block.settings.hl_link_style
            assign hl_link_color = block.settings.hl_link_color
            assign is_hl_item = true
            assign hl_menu_block = block
          endif
        endfor
      -%}
      <li
        class="inline-flex items-center"
        {% if is_hl_item and hl_link_color != blank and hl_link_color != 'rgba(0,0,0,0)' %}
          style="--hl-link-color: {{ hl_link_color }};"
        {% endif %}
      >
        {%- if link.links != blank -%}
          {%- if enable_mega_menu -%}
            {% render 'mega-menu',
              link: link,
              block: mega_menu_block,
              is_hl_item: is_hl_item,
              hl_menu_block: hl_menu_block,
              hl_link_style: hl_link_style
            %}
          {%- else -%}
            <details
              is="details-dropdown"
              level="top"
              trigger="{{ section.settings.menu_trigger }}"
              {{ block.shopify_attributes }}
            >
              <summary data-link="{{ link.url }}" class="z-2">
                <span class="menu__item flex items-center relative{% if is_hl_item %} hightlight-link hightlight-link--{{ hl_link_style }}{% endif %}">
                  {%- liquid
                    assign link_class = 'menu__item-text reversed-link'
                    if is_hl_item
                      case hl_link_style
                        when 'button'
                          assign link_class = 'btn btn--primary'
                        when 'wave_underline'
                          assign link_class = 'menu__item-text relative wave-underline'
                      endcase
                    endif
                  -%}
                  <span class="flex items-center font-navigation {{ link_class }}">
                    {%- capture link_title_html -%}
                      {{- link.title | escape -}}
                      {%- render 'icon-caret-down', size: '2xs' -%}
                    {%- endcapture -%}
                    {%- if is_hl_item -%}
                      {%- case hl_link_style -%}
                        {%- when 'button' -%}
                          <span class="btn__text flex items-center menu__item-text">{{ link_title_html }}</span>
                        {%- else -%}
                          {{ link_title_html }}
                      {%- endcase -%}
                    {%- else -%}
                      {{ link_title_html }}
                    {%- endif -%}
                  </span>
                  {%- if is_hl_item -%}
                    {%- case hl_link_style -%}
                      {%- when 'star_twinkle' -%}
                        <svg class="star star-1" width="12" height="12" viewBox="0 0 12 12">
                          <path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/>
                        </svg>
                        <svg class="star star-2" width="12" height="12" viewBox="0 0 12 12">
                          <path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/>
                        </svg>
                        <svg class="star star-3" width="12" height="12" viewBox="0 0 12 12">
                          <path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/>
                        </svg>
                    {%- endcase -%}
                  {%- endif -%}
                </span>
              </summary>
              <div class="dropdown">
                <div class="dropdown__container color-{{ settings.overlay_color_scheme }}">
                  <ul class="dropdown__nav" role="list">
                    {%- for childlink in link.links -%}
                      {%- if childlink.links != blank -%}
                        <li class="relative text-subtext">
                          <details level="child" trigger="hover" is="details-dropdown">
                            <summary data-link="{{ childlink.url }}" class="">
                              <a
                                href="{{ childlink.url }}"
                                class="reversed-link flex items-center justify-between gap-x-1 no-js-hidden"
                                tabindex="-1"
                              >
                                <span class="reversed-link__text">{{- childlink.title | escape -}}</span>
                                {%- render 'icon-caret-right', size: '2xs' -%}
                              </a>
                              <noscript>
                                <span
                                  class="link-no-script reversed-link flex items-center justify-between gap-x-1"
                                  tabindex="-1"
                                >
                                  <span class="reversed-link__text">{{- childlink.title | escape -}}</span>
                                  {%- render 'icon-caret-right', size: '2xs' -%}
                                </span>
                              </noscript>
                            </summary>
                            <div class="dropdown">
                              <div class="dropdown__container">
                                <ul class="dropdown__nav" role="list">
                                  {%- for grandchildlink in childlink.links -%}
                                    <li class="reversed-link text-subtext">
                                      <a class="block" href="{{ grandchildlink.url }}">
                                        <span class="reversed-link__text">{{- grandchildlink.title | escape -}}</span>
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            </div>
                          </details>
                        </li>
                      {%- else -%}
                        <li class="reversed-link text-subtext">
                          <a href="{{ childlink.url }}" class="block">
                            <span class="reversed-link__text">{{ childlink.title | escape }}</span>
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </details>
          {%- endif -%}
        {%- else -%}
          {%- if enable_mega_menu -%}
            {% render 'mega-menu',
              link: link,
              block: mega_menu_block,
              is_hl_item: is_hl_item,
              hl_menu_block: hl_menu_block,
              hl_link_style: hl_link_style
            %}
          {%- else -%}
            <a
              href="{{ link.url }}"
              class="menu__item flex relative z-2 font-navigation{% if is_hl_item %} hightlight-link hightlight-link--{{ hl_link_style }}{% endif %}"
            >
              {% comment %} reversed-link {% endcomment %}
              {%- liquid
                assign link_class = ''
                if is_hl_item
                  case hl_link_style
                    when 'button'
                      assign link_class = 'btn btn--primary'
                    when 'wave_underline'
                      assign link_class = 'relative wave-underline'
                  endcase
                endif
              -%}
              <span class="{{ link_class }}">
                {%- unless is_hl_item -%}
                  {{- link.title | escape -}}
                {%- else -%}
                  {%- case hl_link_style -%}
                    {%- when 'button' -%}
                      <span class="btn__text">{{- link.title | escape -}}</span>
                    {%- else -%}
                      {{- link.title | escape -}}
                  {%- endcase -%}
                {%- endunless -%}
              </span>
              {%- if is_hl_item -%}
                {%- case hl_link_style -%}
                  {%- when 'star_twinkle' -%}
                    <svg class="star star-1" width="12" height="12" viewBox="0 0 12 12">
                      <path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/>
                    </svg>
                    <svg class="star star-2" width="12" height="12" viewBox="0 0 12 12">
                      <path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/>
                    </svg>
                    <svg class="star star-3" width="12" height="12" viewBox="0 0 12 12">
                      <path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
