    "rich_text_BBr47R": {
      "type": "rich-text",
      "blocks": {
        "heading_dpmmMR": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Reclosable Fastener Solutions at NADCO</strong>",
            "highlight_style": "none",
            "highlight_font_style": "italic",
