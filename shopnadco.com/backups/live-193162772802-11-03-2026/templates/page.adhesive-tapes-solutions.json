    "rich_text_NdQVEb": {
      "type": "rich-text",
      "blocks": {
        "heading_VB9tDK": {
          "type": "heading",
          "settings": {
            "heading": "Custom Adhesive Tape Solutions From NADCO",
            "highlight_style": "none",
            "highlight_font_style": "italic",
