          "settings": {
            "icon": "none",
            "heading": "We can work with the following labeling and packaging substrates",
            "content": "<ul><li>Various paper label stock</li><li>Vinyl</li><li>BOPP</li><li>Transparent BOPP</li><li>Clear polypropylene or polyester</li><li>Silver BOPP</li><li>Tag stock</li><li>Holographic film</li><li>Flexible packaging films</li><li>PET</li><li>Estate papers (premium label stock)</li></ul>",
            "custom_liquid": "",
