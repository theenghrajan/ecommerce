        },
        "collapsible_item_jLnfXf": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "We also offer the following ink types and finishes",
            "content": "<ul><li>Faux foil with digital silver ink</li><li>Digital opaque white ink</li><li>Invisible inks (for added customer experience or security – i.e. print a secret message only visible when exposed to a black/UV light)</li><li>Matte or glossy protective lamination and/or varnishes (including UV varnish)</li></ul>",
