        "highlight_style_color": "",
        "highlight_text_color": "",
        "heading_size": "h2",
        "description": "<p>With the help of our HP Indigo’s exclusive software & digital print technology, NADCO Tapes & Labels, Inc. ELEVATES VDP to VIP. Our variable label printing services include:</p>",
        "text_size": "text-base",
        "button_label": "",
