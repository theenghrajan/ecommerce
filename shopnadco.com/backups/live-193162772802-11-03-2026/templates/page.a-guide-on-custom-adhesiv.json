        "text_afahJk": {
          "type": "text",
          "settings": {
            "text": "<p>Within these categories, NADCO offers further customization options regarding material and finish. Our knowledgeable staff can walk you through these options to ensure your product is exactly right for you.</p>",
            "text_size": "text-base",
            "text_line_limit": "none",
