    "image_with_text_R8kTYD": {
      "type": "image-with-text",
      "blocks": {
        "heading_Yjmaap": {
          "type": "heading",
          "settings": {
            "heading": "Adhesive Industry Trends",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2"
          }
