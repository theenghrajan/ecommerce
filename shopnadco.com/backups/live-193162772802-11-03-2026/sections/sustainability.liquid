{% style %}
.women-owned-section {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.bg_color }};
}
@media (max-width: 767px) {
  .women-owned-section {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
}
.women-owned-inner {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
  text-align: center;
  padding: 0 20px;
}
.women-owned-logo img {
  max-width: {{ section.settings.logo_width }}px;
  margin-bottom: 20px;
}
.women-owned-heading {
  font-size: {{ section.settings.heading_size }}px;
  color: {{ section.settings.heading_color }};
  margin-bottom: 10px;
}
.women-owned-text {
  font-size: {{ section.settings.text_size }}px;
  color: {{ section.settings.text_color }};
  max-width: 1074px;
  margin: 0 auto 40px;
}
.women-owned-badges {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 20px;
  margin-bottom: 40px;
}
.women-owned-badge {
  background: {{ section.settings.badge_bg }};
  border-radius: {{ section.settings.badge_radius }}px;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
}
.women-owned-badge img {
  max-width: 100%;
  height: auto;
}
.women-owned-btn {
  display: inline-block;
  padding: 14px 30px;
  background: {{ section.settings.btn_bg }};
  color: {{ section.settings.btn_color }};
  border-radius: {{ section.settings.btn_radius }}px;
  text-decoration: none;
  font-size: {{ section.settings.btn_text_size }}px;
}
.women-owned-btn:hover {
  opacity: 0.85;
}
{% endstyle %}

<div class="page-width page-width--fixed">
<section class="women-owned-section blocks-radius">
  <div class="women-owned-inner">
    {% if section.settings.main_logo != blank %}
      <div class="women-owned-logo">
        <img src="{{ section.settings.main_logo | image_url: width: 600 }}" alt="">
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="women-owned-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="women-owned-text">{{ section.settings.text }}</div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="women-owned-badges">
        {% for block in section.blocks %}
          <div class="women-owned-badge" style="background: {{ block.settings.block_bg }};">
            {% if block.settings.badge_image != blank %}
              <img src="{{ block.settings.badge_image | image_url: width: 300 }}" alt="">
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="women-owned-btn">
        {{ section.settings.btn_text }}
      </a>
    {% endif %}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Sustainability",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f5f5f5" },
    { "type": "range", "id": "container_width", "label": "Container width", "min": 900, "max": 1600, "step": 50, "default": 1200 },
    { "type": "image_picker", "id": "main_logo", "label": "Top logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 100, "max": 500, "step": 10, "default": 220 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Woman-owned and committed to sustainability" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 60, "step": 2, "default": 36 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "richtext", "id": "text", "label": "Description text" },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 24, "step": 1, "default": 16 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#555555" },
    { "type": "color", "id": "badge_bg", "label": "Default badge background", "default": "#ffffff" },
    { "type": "range", "id": "badge_radius", "label": "Badge border radius", "min": 0, "max": 30, "step": 2, "default": 12 },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "Quote Request" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#1f6fd2" },
    { "type": "color", "id": "btn_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "btn_radius", "label": "Button radius", "min": 0, "max": 40, "step": 2, "default": 8 },
    { "type": "range", "id": "btn_text_size", "label": "Button text size", "min": 12, "max": 24, "step": 1, "default": 16 },
    { "type": "range", "id": "padding_top", "label": "Padding top desktop", "min": 20, "max": 150, "step": 5, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom desktop", "min": 20, "max": 150, "step": 5, "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top mobile", "min": 10, "max": 120, "step": 5, "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "min": 10, "max": 120, "step": 5, "default": 40 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "badge_image", "label": "Badge image" },
        { "type": "color", "id": "block_bg", "label": "Badge background", "default": "#ffffff" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sustainability"
    }
  ]
}
{% endschema %}
