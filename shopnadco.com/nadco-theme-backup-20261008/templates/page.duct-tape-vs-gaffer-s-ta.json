        "heading_gUa6ip": {
          "type": "heading",
          "settings": {
            "heading": "Duct Tape vs. Gaffer’s Tape; What’s the Difference?",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2"
          }
        },
        "text_in6WbB": {
          "type": "text",
          "settings": {
            "text": "<p>Gaffer’s tape and duct tape are multi-purpose, <a href=\"/pages/pressure-sensitive-labels-for-food-processing-applications\" title=\"Pressure-Sensitive Labels for Food Processing Applications\">pressure-sensitive</a> adhesive materials, each with their own distinctions. Both gaffer’s tape and duct tape offer strong holding capabilities due to their fabric reinforcement design, but the best choice tape will depend on the intended application. Below is a guide to help you decide which one will work best for your specific project.</p>",
            "text_size": "text-base"
          }
        }
      },
      "block_order": [
        "heading_gUa6ip",
        "text_in6WbB"
