    "rich_text_DAryJn": {
      "type": "rich-text",
      "blocks": {
        "heading_T3hVzM": {
          "type": "heading",
          "settings": {
            "heading": "NADCO Offers Both Gaffer’s Tape and Duct Tape",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
