    "image_with_text_i8kEHc": {
      "type": "image-with-text",
      "blocks": {
        "heading_QMyqbH": {
          "type": "heading",
          "settings": {
            "heading": "Tamper-Evident Labels From NADCO",
            "highlight_style": "none",
            "highlight_font_style": "italic",
