    "custom_liquid_mpg4bC": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "<style>\n.sub-collections-grid {\n  display: grid;\n  grid-template-columns: repeat(4,1fr);\n  gap: 24px;\n}\n\n.sub-collection-card {\n  display: block;\n  border: 1px solid #e5e5e5;\n  border-radius: 8px;\n  overflow: hidden;\n  text-decoration: none;\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n\n.sub-collection-image img {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n\n.sub-collection-content {\n  padding: 16px;\n}\n\n.sub-collection-title {\n  margin: 0 0 8px;\n  font-size: 16px;\n  color: #000;\n}\n\n.sub-collection-description {\n  font-size: 15px;\n  color: #555;\n}\n@media screen and (max-width:1000px){\n.sub-collections-grid {\n  grid-template-columns: repeat(2,1fr);\n}\n}\n@media screen and (max-width:768px){\n.sub-collections-grid {\n  grid-template-columns: repeat(1,1fr);\n}\n}\n</style>\n{% if collection.metafields.custom.sub_collection != blank %}\n  <div class=\"section__container page-width page-width--fixed\">\n    <div class=\"sub-collections-grid\">\n      {% for sub_collection in collection.metafields.custom.sub_collection.value %}\n        <a href=\"{{ sub_collection.url }}\" class=\"sub-collection-card\">\n\n          <div class=\"sub-collection-image\">\n            {% if sub_collection.featured_image %}\n              <img\n                src=\"{{ sub_collection.featured_image | image_url: width: 600 }}\"\n                alt=\"{{ sub_collection.title | escape }}\"\n                loading=\"lazy\"\n              >\n            {% else %}\n              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}\n            {% endif %}\n          </div>\n\n          <div class=\"sub-collection-content\">\n            <h3 class=\"sub-collection-title\">\n              {{ sub_collection.title }}\n            </h3>\n\n            {% if sub_collection.description != blank %}\n              <p class=\"sub-collection-description\">\n                {{ sub_collection.description | strip_html | truncate: 100 }}\n              </p>\n            {% endif %}\n          </div>\n\n        </a>\n      {% endfor %}\n    </div>\n  </div>\n{% endif %}",
        "color_scheme": "",
        "padding_top": 50,
        "padding_bottom": 50
      }
    },
