    "custom_liquid_CkQgHM": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "{% if collection.metafields.custom.top_content.value != blank %}\n<div class=\"page-width\">\n  <div class=\"collection-content-wrapper\">\n\n    <div class=\"rte\">\n      {{ collection.metafields.custom.top_content | metafield_tag }}\n    </div>\n\n    {% if collection.metafields.custom.content.value != blank %}\n      <div id=\"read-more-content\" class=\"rte\" style=\"display:none;\">\n        {{ collection.metafields.custom.content | metafield_tag }}\n      </div>\n\n      <button type=\"button\" id=\"read-more-btn\" class=\"read-more-btn\">\n        Read More\n      </button>\n    {% endif %}\n\n  </div>\n</div>\n\n<style>\n.read-more-btn{\n  margin-top:20px;\n  background:none;\n  border:none;\n  color:#007acc;\n  cursor:pointer;\n  font-weight:600;\n  padding:0;\n}\n</style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  const btn = document.getElementById('read-more-btn');\n  const content = document.getElementById('read-more-content');\n\n  if (!btn || !content) return;\n\n  btn.addEventListener('click', function () {\n\n    if (content.style.display === 'none') {\n      content.style.display = 'block';\n      btn.textContent = 'Read Less';\n    } else {\n      content.style.display = 'none';\n      btn.textContent = 'Read More';\n    }\n\n  });\n\n});\n</script>\n{% endif %}",
        "color_scheme": "",
        "padding_top": 50,
        "padding_bottom": 50
      }
    }
