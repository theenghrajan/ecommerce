            "use_subtext_color": false
          }
        },
        "collapsible_item_GWjARj": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Customized Storytelling",
            "content": "<p>We offer complete personalization of labels to fit brands’ unique needs. Our customized storytelling capabilities include mass customization,<a href=\"/pages/variable-label-printing\" title=\"Variable Image Label Printing | Variable Data Label Printing\">variable data printing</a>,<a href=\"/pages/variable-label-printing\" title=\"Variable Image Label Printing | Variable Data Label Printing\">variable image printing</a>, special edition packaging, seasonal variations, one-off production, personalization, versioning, and multiple SKUs.</p>",
