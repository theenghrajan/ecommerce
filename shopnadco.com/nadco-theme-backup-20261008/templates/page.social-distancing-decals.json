    "custom_content_naBLaa": {
      "type": "custom-content",
      "blocks": {
        "image_8wihi7": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/image_30_e92b0392-3cd4-4ce6-8bab-5bf3a84f8d00.png",
