    "image_with_text_HY9DWJ": {
      "type": "image-with-text",
      "blocks": {
        "heading_UjqkqD": {
          "type": "heading",
          "settings": {
            "heading": "Quality Foam Tapes From NADCO",
            "highlight_style": "none",
            "highlight_font_style": "italic",
