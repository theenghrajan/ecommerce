        "collapsible_item_667M8e": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Do I have to buy special tooling to die-cut my labels?",
            "content": "<p>Not necessarily. We are able to offer dozens of stock sizes by utilizing existing die-cutting tools. If you require a custom shape or size, then a new tool purchase will be required.</p>",
            "custom_liquid": "",
            "page": "",
            "open": false,
