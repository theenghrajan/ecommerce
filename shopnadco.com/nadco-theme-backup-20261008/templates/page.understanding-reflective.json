        "heading_ncciNp": {
          "type": "heading",
          "settings": {
            "sub_heading": "",
            "heading": "Reflective Tapes from NADCO",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2",
            "rich_text_cstm": "<p><strong>At NADCO®, our reflective tapes are engineered for durability, long-lasting performance, and strong adhesion across a wide range of surfaces. We offer three grades of reflective sheeting, each designed for specific applications:</strong></p>"
          }
        },
        "collapsible_item_MbDG6j": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Regular Grade",
            "content": "<p>An acrylic prismatic reflective film designed for use on metal and painted metal surfaces.</p><ul><li>Lifespan: Up to 7 years</li><li>Temperature range: -10°F to +160°F</li><li>Colors: White or red/white stripes</li><li>Common applications: Vehicle markings and general visibility enhancement</li></ul>",
            "custom_liquid": "",
            "page": "",
            "open": true,
            "use_subtext_color": false
          }
        },
        "collapsible_item_gbaJDX": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "Engineer Grade",
            "content": "<p>A high-gloss, pressure-sensitive tape ideal for flat, smooth surfaces.</p><ul><li>Not recommended for unpainted stainless steel</li><li>Available in a variety of colors</li><li>Best suited for permanent traffic and information signs</li></ul>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        },
        "collapsible_item_qMyrxW": {
          "type": "collapsible_item",
          "settings": {
            "icon": "none",
            "heading": "High-Intensity Grade",
            "content": "<p>A high-gloss, pressure-sensitive tape offering superior brightness and durability.</p><ul><li>Lifespan: Up to 10 years when properly applied</li><li>Temperature range: -40°F to 180°F</li><li>Available in multiple colors</li><li>Ideal for environments requiring exceptional visibility and performance</li></ul>",
            "custom_liquid": "",
            "page": "",
            "open": false,
            "use_subtext_color": false
          }
        }
