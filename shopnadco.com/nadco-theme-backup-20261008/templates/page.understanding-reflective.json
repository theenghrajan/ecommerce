          "type": "text",
          "settings": {
            "text": "<p><strong>All three grades provide reliable nighttime visibility and are suitable for vehicle recognition, traffic signage, and other demanding traffic-control applications. NADCO® reflective tapes are manufactured to meet or exceed brightness and performance requirements for safety-critical use.</strong></p>",
            "text_size": "text-base",
            "text_line_limit": "none",
