{% comment %}
  Section: Key Benefits (Foam Tape style) — matches provided layout

  Features / customization:
  - Main title + intro text
  - Background colors (page bg, header bar bg, header inner bg)
  - Benefit rows as blocks:
      * number (01/02/03…)
      * title
      * description
      * right icon (image upload) + icon box color
      * row bar colors (dark bar + red accents)
      * optional divider
  - Footer area:
      * left logo image
      * CTA button text + link
      * footer bar colors
  - Container width, padding, radius, shadows
  - Mobile responsive (icon moves inline, spacing adjusts)
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

<section
  id="benefits-{{ section.id }}"
  class="benefits-{{ section.id }}"
  style="
    --kb-bg: {{ s.section_bg }};
    --kb-card-bg: {{ s.card_bg }};
    --kb-border: {{ s.card_border }};
    --kb-titlebar-bg: {{ s.titlebar_bg }};
    --kb-titlebar-inner-bg: {{ s.titlebar_inner_bg }};
    --kb-title: {{ s.title_color }};
    --kb-intro: {{ s.intro_color }};
    --kb-rowbar: {{ s.row_bar_color }};
    --kb-accent: {{ s.accent_color }};
    --kb-text: {{ s.text_color }};
    --kb-muted: {{ s.muted_text_color }};
    --kb-iconbox: {{ s.icon_box_color }};
    --kb-footerbar: {{ s.footer_bar_color }};
    --kb-footerbg: {{ s.footer_bg }};
    --kb-button-bg: {{ s.button_bg }};
    --kb-button-text: {{ s.button_text }};
    --kb-radius: {{ s.radius }}px;
    --kb-pad-y: {{ s.padding_y }}px;
    --kb-pad-x: {{ s.padding_x }}px;
    --kb-shadow: {% if s.enable_shadow %}0 14px 40px rgba(0,0,0,.10){% else %}none{% endif %};
  "
>
  <div class="kb-wrap page-width page-width-fixed">
    <div class="kb-card" role="region" aria-label="{{ s.heading | escape }}">
      <!-- Top title bar -->
      <div class="kb-titlebar">
        <div class="kb-titlebar-inner">
          {%- if s.heading != blank -%}
            <h2 class="kb-heading">{{ s.heading }}</h2>
          {%- endif -%}
        </div>
      </div>

      {%- if s.intro_text != blank -%}
        <div class="kb-intro">
          <div class="kb-intro-text rte">{{ s.intro_text }}</div>
        </div>
      {%- endif -%}

      <!-- Benefit rows -->
      <div class="kb-rows">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign hide_block = false
            if b.title == blank and b.description == blank and b.icon == blank
              assign hide_block = true
            endif
          -%}
          {%- unless hide_block -%}
            <div class="kb-row" {{ block.shopify_attributes }}>
              <div class="kb-rowbar">
                <div class="kb-rowbar-left">
                  {%- if b.number != blank -%}
                    <span class="kb-num">{{ b.number }}</span>
                  {%- endif -%}
                  {%- if b.title != blank -%}
                    <h3 class="kb-rowtitle">{{ b.title }}</h3>
                  {%- endif -%}
                </div>

                <div class="kb-rowbar-accent" aria-hidden="true"></div>
              </div>

              <div class="kb-rowcontent">
                <div class="kb-textcol">
                  {%- if b.description != blank -%}
                    <div class="kb-desc rte">{{ b.description }}</div>
                  {%- endif -%}
                </div>

                {%- if b.icon != blank -%}
                  <div class="kb-iconcol" style="--kb-iconbox: {{ b.icon_box_color | default: s.icon_box_color }};">
                    <div class="kb-iconbox" aria-hidden="true">
                      <img
                        src="{{ b.icon | image_url: width: 240 }}"
                        alt="{{ b.icon_alt | escape }}"
                        loading="lazy"
                        width="120"
                        height="120"
                      >
                    </div>
                  </div>
                {%- endif -%}
              </div>

              {%- if s.show_row_dividers and forloop.last == false -%}
                <div class="kb-divider" aria-hidden="true"></div>
              {%- endif -%}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <!-- Footer -->
      <div class="kb-footer" style="background: var(--kb-footerbg);">
                  <div class="kb-footer-mid">
            {%- if s.footer_text != blank -%}
              <div class="kb-footer-text">{{ s.footer_text }}</div>
            {%- endif -%}
          </div>
        <div class="kb-footer-inner">
          <div class="kb-footer-left">
            {%- if s.footer_logo != blank -%}
              <img
                class="kb-footer-logo"
                src="{{ s.footer_logo | image_url: width: 240 }}"
                alt="{{ s.footer_logo_alt | escape }}"
                loading="lazy"
                width="120"
                height="60"
              >
            {%- endif -%}
          </div>



          <div class="kb-footer-right">
            {%- if s.button_text_label != blank and s.button_link != blank -%}
              <a class="kb-btn" href="{{ s.button_link }}">
                {{ s.button_text_label }}
              </a>
            {%- endif -%}
          </div>
        </div>

        <div class="kb-footerbar" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .benefits-{{ section.id }}{
    background: var(--kb-bg);
    padding: var(--kb-pad-y) var(--kb-pad-x);
  }

  .benefits-{{ section.id }} .kb-wrap{
    margin: 0 auto;
  }

  .benefits-{{ section.id }} .kb-card{
    background: var(--kb-card-bg);
    border: 1px solid var(--kb-border);
    border-radius: var(--kb-radius);
    box-shadow: var(--kb-shadow);
    overflow: hidden;
  }

  /* Title bar */
  .benefits-{{ section.id }} .kb-titlebar{
    background: var(--kb-titlebar-bg);
    padding: 18px 18px 14px;
    display: flex;
    justify-content: center;
  }
  .benefits-{{ section.id }} .kb-titlebar-inner{
    background: var(--kb-titlebar-inner-bg);
    border-radius: 8px;
    padding: 14px 18px;
    min-width: min(720px, 92%);
    text-align: center;
  }
  .benefits-{{ section.id }} .kb-heading{
    margin: 0;
    color: var(--kb-title);
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 700;
    letter-spacing: .2px;
  }

  /* Intro */
  .benefits-{{ section.id }} .kb-intro{
    padding: 14px 22px 6px;
    text-align: center;
  }
  .benefits-{{ section.id }} .kb-intro-text{
    color: var(--kb-intro);
    {% comment %} font-size: 12px; {% endcomment %}
    line-height: 1.55;
    max-width: 860px;
    margin: 0 auto;
  }

  /* Rows */
  .benefits-{{ section.id }} .kb-rows{
    padding: 10px 0 0;
  }
  .benefits-{{ section.id }} .kb-row{
    position: relative;
    padding: 0 0 6px;
  }

  .benefits-{{ section.id }} .kb-rowbar{
    background: var(--kb-rowbar);
    display: grid;
    grid-template-columns: 1fr 10px;
    align-items: stretch;
    min-height: 44px;
    margin: 10px 0 0;
  }
  .benefits-{{ section.id }} .kb-rowbar-left{
    display: flex;
    align-items: center;
    gap: 12px;
    padding:0px 16px 0px 0;
  }
  .benefits-{{ section.id }} .kb-rowbar-accent{
    background: var(--kb-accent);
  }

  .benefits-{{ section.id }} .kb-num{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    height: 100%;
    background: var(--kb-accent);
    color: #fff;
    font-weight: 800;
    /* font-size: 13px; */
    letter-spacing: .6px;
    padding: 10px 15px;
  }
  .benefits-{{ section.id }} .kb-rowtitle{
    margin: 0;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: .2px;
  }

  .benefits-{{ section.id }} .kb-rowcontent{
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    padding: 10px 16px 14px;
    align-items: start;
  }

  .benefits-{{ section.id }} .kb-desc{
    color: var(--kb-text);
    font-size: 14px;
    line-height: 1.55;
  }

  .benefits-{{ section.id }} .kb-iconcol{
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding-right: 6px;
    margin-top: -18px; /* pushes icon box up like screenshot */
  }
  .benefits-{{ section.id }} .kb-iconbox{
    width: 86px;
    height: 86px;
    border-radius: 6px;
    background: var(--kb-iconbox);
    display: grid;
    place-items: center;
    box-shadow: 0 10px 20px rgba(0,0,0,.12);
  }
  .benefits-{{ section.id }} .kb-iconbox img{
    width: 54px;
    height: 54px;
    object-fit: contain;
    display: block;
    filter: {% if section.settings.force_white_icons %}brightness(0) invert(1){% else %}none{% endif %};
  }

  .benefits-{{ section.id }} .kb-divider{
    height: 1px;
    background: rgba(0,0,0,.08);
    margin: 0 16px;
  }

  /* Footer */
  .benefits-{{ section.id }} .kb-footer{
    margin-top: 6px;
  }
  .benefits-{{ section.id }} .kb-footer-inner{
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
  }
  .benefits-{{ section.id }} .kb-footer-left{
    background: #ffffff;
    padding: 10px 16px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
  }
  .benefits-{{ section.id }} .kb-footer-logo{
    display: block;
    max-width: 140px;
    height: auto;
  }
  .benefits-{{ section.id }} .kb-footer-text{
    color: white;
    {% comment %} color: var(--kb-muted); {% endcomment %}
    {% comment %} font-size: 11px; {% endcomment %}
    line-height: 1.4;
    text-align: center;
    background: #2C2C2C;
    padding: 20px;
  }
  .benefits-{{ section.id }} .kb-footer-text p{
    max-width:500px;
    margin:auto;
  }
  .benefits-{{ section.id }} .kb-btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--kb-button-bg);
    color: var(--kb-button-text);
    padding: 10px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .benefits-{{ section.id }} .kb-btn:hover{
    opacity: .92;
  }
  .benefits-{{ section.id }} .kb-footerbar{
    height: 46px;
    background: var(--kb-footerbar);
  }

  /* RTE cleanup */
  .benefits-{{ section.id }} .rte p{ margin: 0; }
  .benefits-{{ section.id }} .rte p + p{ margin-top: 8px; }

  /* Responsive */
  @media (max-width: 768px){
    .benefits-{{ section.id }} .kb-titlebar-inner{
      min-width: 94%;
    }
    .benefits-{{ section.id }} .kb-rowcontent{
      grid-template-columns: 1fr;
    }
    .benefits-{{ section.id }} .kb-iconcol{
      justify-content: flex-start;
      margin-top: 0;
    }
    .benefits-{{ section.id }} .kb-footer-inner{
      grid-template-columns: 1fr;
      text-align: center;
    }
    .benefits-{{ section.id }} .kb-footer-right{
      display: flex;
      justify-content: center;
    }
    .benefits-{{ section.id }} .kb-footer-left{
      display: flex;
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Key Benefits",
  "tag": "section",
  "class": "section-key-benefits-foam",
  "settings": [

    {
      "type": "range",
      "id": "padding_y",
      "label": "Section padding (top/bottom)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Section padding (left/right)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable card shadow",
      "default": true
    },

    { "type": "header", "content": "Top header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key Benefits Of Foam Tape" },
    { "type": "richtext", "id": "intro_text", "label": "Intro text", "default": "<p>Extremely adaptable, foam tape allows for endless customization, catering to the demands of nearly any application.</p>" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#d9e5ef" },

    { "type": "color", "id": "titlebar_bg", "label": "Header bar background", "default": "#4aa0c8" },
    { "type": "color", "id": "titlebar_inner_bg", "label": "Header inner background", "default": "#0a6fa0" },
    { "type": "color", "id": "title_color", "label": "Header text color", "default": "#ffffff" },
    { "type": "color", "id": "intro_color", "label": "Intro text color", "default": "#2f3a44" },

    { "type": "color", "id": "row_bar_color", "label": "Row title bar color", "default": "#2f2f2f" },
    { "type": "color", "id": "accent_color", "label": "Accent color (red)", "default": "#e30012" },

    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#2f3a44" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text color", "default": "#d7e6ef" },

    { "type": "color", "id": "icon_box_color", "label": "Default icon box color", "default": "#0a6fa0" },
    { "type": "checkbox", "id": "force_white_icons", "label": "Force icons to white (works best for dark icons)", "default": true },

    { "type": "checkbox", "id": "show_row_dividers", "label": "Show dividers between rows", "default": true },

    { "type": "header", "content": "Footer" },
    { "type": "richtext", "id": "footer_text", "label": "Footer small text", "default": "<p>To learn more about our superior foam tapes and other adhesive solutions, contact us today.</p>" },

    { "type": "image_picker", "id": "footer_logo", "label": "Footer logo" },
    { "type": "text", "id": "footer_logo_alt", "label": "Footer logo alt text", "default": "Company logo" },

    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_text_label", "label": "Button text", "default": "www.example.com" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#e30012" },
    { "type": "color", "id": "button_text", "label": "Button text color", "default": "#ffffff" },

    { "type": "color", "id": "footer_bg", "label": "Footer content background", "default": "#0a6fa0" },
    { "type": "color", "id": "footer_bar_color", "label": "Footer bottom bar color", "default": "#0a6fa0" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "number", "label": "Number (e.g. 01)", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Time Saving" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Add your benefit description here.</p>" },

        { "type": "image_picker", "id": "icon", "label": "Right icon (PNG/SVG)" },
        { "type": "text", "id": "icon_alt", "label": "Icon alt text", "default": "Benefit icon" },

        { "type": "color", "id": "icon_box_color", "label": "Icon box color (override)", "default": "#0a6fa0" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Key Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "number": "01", "title": "Time Saving" } },
        { "type": "benefit", "settings": { "number": "02", "title": "Material Cost Reduction" } },
        { "type": "benefit", "settings": { "number": "03", "title": "Extended Service Life" } },
        { "type": "benefit", "settings": { "number": "04", "title": "Flexible And Adaptable" } }
      ]
    }
  ]
}
{% endschema %}
