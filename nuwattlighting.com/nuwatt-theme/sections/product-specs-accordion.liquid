{% stylesheet %}
.alt-accordion {
    display: flex;
    flex-direction: column;
    width: 100%;
  border: 0.125rem solid #999ea4;
    border-radius: 0.50rem;
  margin-top: 15px;
}

.alt-accordion-section {
    
    margin: 0;
}

.alt-accordion-toggle {
    background-color: #fafbfb;
    color: #222;
    padding: 12px;
    width: 100%;
    text-align: left;
    border: none;
    outline: none;
    transition: background-color 0.3s ease;
    cursor: pointer;
      border-radius: 0.50rem;

}

.alt-accordion-toggle:hover {
    background-color: #efefef;
}

.alt-accordion-body {
    padding: 0 22px;
    max-height: 0;
    overflow-y: hidden;
    transition: max-height 0.3s ease-out, padding 0.3s ease-out;
    background-color: #fff;
        border-radius: 0.50rem;

}

/* Initially open the first section */
.alt-accordion .alt-accordion-section:first-child .alt-accordion-body {
    max-height: 500px; /* Adjust based on your content size */
    padding: 12px 22px;
}

    .alt-accordion-toggle h3{
    font-family: 'nw-medium';
    font-weight: 500;
        text-transform: unset;
    padding: 0;
    margin: 0;
    font-size: 30px;
    letter-spacing: 1px;
  }





{% endstylesheet %}




{% schema %}
  {
    "name": "Product Specs Accordion",
    "settings": [
      {

            "type": "checkbox",
      "id": "specs-accordion-enable",
      "label": "Product Specs Accordion Enabled",
      "default": true
        
      }
    ],

        "presets": [
      {
        "name": "Product Specs Accordion",
        "category": "Custom"
      }
    ]
  }
{% endschema %}