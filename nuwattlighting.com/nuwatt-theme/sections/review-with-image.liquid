<script type="text/javascript" async="true" src="https://scripts.juniphq.com/v1/junip_shopify.js"></script>
<div class="image-with-review">
    <div class="page-width">
        <div class="main-div">
            <div class="image_wrapper">
                {% if section.settings.main_image  != blank %}
                <img src="{{ section.settings.main_image | img_url:'master' }}">
                {% endif %}
            </div>
            <div class="review_section">
                 <span class="junip-store-key" data-store-key="Le1jN8TTeVzxxRUqTk2bMa2T"></span>
                 <div
  class="junip-review-carousel"
  data-title=""
  data-reviews-type="product_reviews"
  data-product-id=""
  data-review-tag=""
  data-show-summary="true">
</div>
            </div>
        </div>
    </div>
</div>



{% schema %}
{
  "name": "Image with review",
  "tag": "section",
  "settings": [
    {
    "type": "image_picker",
    "id": "main_image",
    "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Image with review"
    }
  ]
}
{% endschema %}


<style>
  .image-with-review .page-width{
    max-width:100%;
  }
  .image_wrapper img{
    width:100%;
    height:100%;
  }
  .image-with-review .main-div{
    display:flex;
    gap:15px; 
    align-items: center;
  }
  .image-with-review .image_wrapper {
        width: 50%;
        border-radius: 20px;
        overflow: hidden;
    }
  .image-with-review .review_section{
    width:50%;
  }
  .image-with-review .junip-review-carousel{
    padding:0;
  }
  .image-with-review{
    padding-bottom:50px;
  }
  .junip-review-carousel-container{
    padding-bottom:0;
    margin-bottom:0;
  }
  @media screen and (min-width: 1024px) and (max-width: 1250px){
        .image-with-review{
        padding-bottom:0;
    }
  }
  @media screen and (min-width: 767px) and (max-width: 1023px){
        .image-with-review{
        padding-bottom:0;
    }
    .image-with-review .main-div {
        gap: 25px;
        flex-direction: column;
    }
    .image-with-review .review_section {
        width: 100%;
    }
    .image-with-review .image_wrapper{
      width:100%;
    }
  }

    @media screen and (max-width: 767px){
          .image-with-review .main-div {
        gap: 25px;
        flex-direction: column;
    }
    .image-with-review .review_section {
        width: 100%;
    }
    .image-with-review .image_wrapper{
      width:100%;
    }
         .image-with-review{
        padding-bottom:0;
    }
    }

</style>