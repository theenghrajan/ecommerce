  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<div class="ugc_slider_main">
  <div class="page-width">
    {% if section.settings.main_title != blank %}
    <h2>{{ section.settings.main_title }}</h2>
    {% endif %}
    <div class="innermanwrrpaer">
        <div class="swiper cstm-swiper">
            <div class="swiper-wrapper">
            {% for block in section.blocks %}
            <div class="swiper-slide relative">
                <div class="video-wrapper relative cursor-pointer">
                {{ block.settings.videougc | video_tag:
                    controls: false,
                    autoplay: false,
                    loop: true,
                    muted: false,
                    preload: "auto",
                    poster:''
                }}
                <div class="play-overlay absolute inset-0 flex items-center justify-center bg-black/40">
                    <button class="play-btn text-white text-4xl">▶</button>
                </div>
                </div>
            </div>
            {% endfor %}
            </div>
            <div class="swiper-button-prev">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="#1C274C" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
              </div>
            <div class="swiper-button-next">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="#1C274C" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
              </div>
        </div>
    </div>
  </div>
</div>

  <script>
    let appendNumber = 600;
    let prependNumber = 1;
    const swiper = new Swiper('.swiper', {
      slidesPerView: 5,
      centeredSlides: false,
      spaceBetween: 30,
      loop:true,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      breakpoints: {
          0: {
            slidesPerView: 3,
            spaceBetween: 10,
          },
          768: {
            slidesPerView: 5,
            spaceBetween: 30,
          },
      },
    });


  </script>

<script>
    
    document.addEventListener("DOMContentLoaded", function () {
    const wrappers = document.querySelectorAll(".video-wrapper");

    wrappers.forEach((wrapper, index) => {
      const video = wrapper.querySelector("video");
      const overlay = wrapper.querySelector(".play-overlay");

      wrapper.addEventListener("click", function () {
        // Pause all other videos
        document.querySelectorAll(".video-wrapper video").forEach((v) => {
          if (v !== video) {
            v.pause();
            v.parentElement.querySelector(".play-overlay").style.display = "flex";
          }
        });

        // Toggle current video
        if (video.paused) {
          video.play();
          overlay.style.display = "none";
        } else {
          video.pause();
          overlay.style.display = "flex";
        }
      });

      // When video ends, show overlay again
      video.addEventListener("ended", function () {
        overlay.style.display = "flex";
      });
    });
    
  });


  </script> 



  {% style %}
    .play-btn {
  cursor: pointer;
  transition: all 0.3s ease;
}
.play-btn:hover {
  background-color: rgba(0, 0, 0, 0.7);
}
.video-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}
.video-wrapper video {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 10px;
}
.video-wrapper.relative.cursor-pointer{
    padding-bottom:0;
}
/* .ugc_slider_main {
    padding-bottom: 60px;
} */
.swiper-slide-next{
    transform: scale(1.1);
}
.innermanwrrpaer {
    padding-top: 50px;
    padding-bottom: 50px;
    overflow: hidden;
}
.swiper-slide.relative {
    transform: scale(0.9);
}
@media screen and (min-width:768px){
.swiper-slide-next + .swiper-slide {
    transform: scale(1.16) !important;
    transition: all 0.6s ease-in-out;
}
}
@media screen and (max-width:767px){
  .swiper-slide-next{
    transform: scale(1.1) !important;
    transition: all 0.6s ease-in-out;
  }
  .innermanwrrpaer {
      padding-top: 20px;
      padding-bottom: 20px;
      overflow: hidden;
  }
}
.cstm-swiper .swiper-button-prev svg {
    transform: rotate(180deg);
}

  {% endstyle %}
