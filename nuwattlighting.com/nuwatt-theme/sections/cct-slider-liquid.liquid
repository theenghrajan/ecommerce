/*hand*/
@keyframes swipe {


    0% {
        margin:0;
        transform: rotate(0deg);
    }

    100% {
        margin-right:20px;
        transform: rotate(-5deg);
    }



}

.handswipe {
    animation: swipe .8s alternate infinite; /* IE 10+, Fx 29+ */
    animation-timing-function: ease;
    position: absolute;
    bottom: 95px;
    width: 100px;
    right: 50%;
    top:50%;
}

.handswipe img{
  pointer-events: none;
      -khtml-user-select: none;
    -o-user-select: none;
    -moz-user-select: none;
    -webkit-user-select: none;
    user-select: none;
}

