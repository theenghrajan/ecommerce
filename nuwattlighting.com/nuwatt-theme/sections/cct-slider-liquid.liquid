.myslider {
  -webkit-appearance: none;
  background: #FCF3CF;
  width: 100%;
  height: 20px;
  border: none;
}

.myslider::-webkit-slider-thumb {
  -webkit-appearance: none;
  cursor: pointer;
  background: #34495E;
  width: 13%;
  height: 20px;
}
 
 .myslider{

background: url(https://cdn.shopify.com/s/files/1/0293/5858/7978/files/CCT_GRADIANT_2.png);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    height: 155px;
    width: inherit;
    border: none;
    appearance: none;
 
 
       /* transform: rotate(-90deg); */
   
}



.image {
  position: relative;
  margin: 0 auto;
  width: auto;
}

.image>img {
  position: relative;
  display: none;
}

.image>img.visible,
.image>img:first-child {
  display: block;
}

.sliderOutput>div {
  margin: 5px;
  width: 120px;
  display: inline-block;
  vertical-align: top;
  text-align: center;
}

.sliderOutput h6,
.sliderOutput p {
  margin: 5px;
}


.rangeslider  input[type=range] {
  -webkit-appearance: none;
  width: 100%;

    border: none;
}

.rangeslider input[type=range]::-webkit-slider-runnable-track {
  width: 5px;
  height: 5px;
  box-shadow: none !important;
}


.rangeslider input[type=range]::-webkit-slider-thumb {
  height: 145px;
  width: 61px;
  background: url(https://cdn.shopify.com/s/files/1/0293/5858/7978/files/CCT_SWITCH_2.svg);
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  margin-top: -69px;
  box-shadow: none !important;
}

.rangeslider input[type="range"]::-moz-range-thumb {
  height: 145px;
  width: 61px;
  background: url(https://cdn.shopify.com/s/files/1/0293/5858/7978/files/CCT_SWITCH_2.svg);
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  margin-top: -69px;
  box-shadow: none !important;
}


