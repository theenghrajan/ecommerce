{% stylesheet %}

 .PDPSPEC-root {
      --pdpspec-border: #e2e8f0;
      --pdpspec-hover: #f8fafc;
      --pdpspec-header: #f1f5f9;
      --pdpspec-text-dark: #334155;
      --pdpspec-text-light: #64748b;
      --pdpspec-tooltip: #1e293b;
      --pdpspec-accent: #3b82f6;
      --pdpspec-radius-sm: 4px;
      --pdpspec-radius-md: 8px;
    }

    .PDPSPEC-root {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      line-height: 1.4;
      color: var(--pdpspec-text-dark);
      margin: 0;
      padding: 0.5rem;
      background-color: #f8fafc;
      font-size: 0.9375rem;
    }

    .PDPSPEC-container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      border-radius: var(--pdpspec-radius-md);
      box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      border: 1px solid var(--pdpspec-border);
    }

    .PDPSPEC-section:not(:last-child) {
      border-bottom: 1px solid var(--pdpspec-border);
    }

    .PDPSPEC-section__title {
      font-size: 0.875rem;
      font-weight: 600;
      padding: 0.625rem 0.875rem;
      background: var(--pdpspec-header);
      margin: 0;
      color: var(--pdpspec-text-light);
      text-transform: uppercase;
      letter-spacing: 0.025em;
    }

    .PDPSPEC-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    .PDPSPEC-table {
      width: 100%;
      border-collapse: collapse;
    }

    .PDPSPEC-table:first-child {
      border-right: 1px solid var(--pdpspec-border);
    }

    .PDPSPEC-table th,
    .PDPSPEC-table td {
      padding: 0.5rem 0.875rem;
      text-align: left;
      line-height: 1.4;
    }

    .PDPSPEC-table tr {
      transition: all 0.15s ease-in-out;
    }

    .PDPSPEC-table tr:not(:last-child) {
      border-bottom: 1px solid var(--pdpspec-border);
    }

    .PDPSPEC-table th {
      font-weight: 500;
      color: var(--pdpspec-text-light);
      width: auto;
      position: relative;
      background: var(--pdpspec-header);
    }

    .PDPSPEC-table td {
      font-weight: 450;
    }

    .PDPSPEC-table tr:hover {
      background-color: var(--pdpspec-hover);
    }

    .PDPSPEC-table tr:hover td {
      color: var(--pdpspec-accent);
    }

    .PDPSPEC-info__icon {
      display: inline-flex;
      width: 14px;
      height: 14px;
      margin-left: 0.375rem;
      cursor: help;
      opacity: 0.5;
      vertical-align: middle;
      color: var(--pdpspec-accent);
      transition: opacity 0.15s ease;
    }

    .PDPSPEC-info__icon:hover {
      opacity: 1;
    }

    .PDPSPEC-tooltip {
      position: relative;
      display: inline-block;
    }

    .PDPSPEC-tooltip__text {
      visibility: hidden;
      position: absolute;
      bottom: 125%;
      left: 50%;
      transform: translateX(-50%) translateY(5px);
      background-color: var(--pdpspec-tooltip);
      color: white;
      text-align: center;
      padding: 0.5rem 0.75rem;
      border-radius: var(--pdpspec-radius-sm);
      font-size: 0.8125rem;
      white-space: nowrap;
      z-index: 1;
      opacity: 0;
      transition: all 0.2s ease;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      max-width: 250px;
      backdrop-filter: blur(8px);
      font-weight: 400;
    }

    .PDPSPEC-tooltip__text::after {
      content: "";
      position: absolute;
      top: 100%;
      left: 50%;
      margin-left: -4px;
      border-width: 4px;
      border-style: solid;
      border-color: var(--pdpspec-tooltip) transparent transparent transparent;
    }

    .PDPSPEC-tooltip:hover .PDPSPEC-tooltip__text {
      visibility: visible;
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    @media (max-width: 768px) {
      .PDPSPEC-grid {
        grid-template-columns: 1fr;
      }

      .PDPSPEC-table:first-child {
        border-right: none;
      }

      .PDPSPEC-container {
        margin: 0.5rem;
      }
    }

    @media (max-width: 480px) {
      .PDPSPEC-table th,
      .PDPSPEC-table td {
        /* display: block; */
        width: 50%;
      }

      .PDPSPEC-table th {
        padding-bottom: 0.25rem;
      }

      .PDPSPEC-table td {
        padding-top: 0.25rem;
      }

      .PDPSPEC-tooltip__text {
        width: 200px;
        white-space: normal;
        left: -50px;
        transform: translateY(5px);
      }

      .PDPSPEC-tooltip:hover .PDPSPEC-tooltip__text {
        transform: translateY(0);
      }
    }

    @media print {
      .PDPSPEC-container {
        box-shadow: none;
        border: 1px solid #000;
      }

      .PDPSPEC-tooltip {
        display: none;
      }

      .PDPSPEC-root {
        background: white;
      }
    }

    .PDPSPEC-table th:focus-within {
      outline: 2px solid var(--pdpspec-accent);
      outline-offset: -2px;
      border-radius: var(--pdpspec-radius-sm);
    }
{% endstylesheet %}




