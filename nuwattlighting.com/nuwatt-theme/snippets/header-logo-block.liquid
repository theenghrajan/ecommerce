{%- for block in section.blocks -%}
  {%- if block.type == 'logo' -%}
    {%- liquid
      assign has_logo = true
    -%}

    {%- style -%}
    .header-item--logo,
    [data-layout="left-center"] .header-item--logo,
    [data-layout="left-center"] .header-item--icons {
      flex: 0 1 {{ block.settings.mobile_logo_width }}px;
    }

    @media only screen and (min-width: 769px) {
      .header-item--logo,
      [data-layout="left-center"] .header-item--logo,
      [data-layout="left-center"] .header-item--icons {
        flex: 0 0 {{ block.settings.desktop_logo_width }}px;
      }
    }

    .site-header__logo a {
      width: {{ block.settings.mobile_logo_width }}px;
    }
    .is-light .site-header__logo .logo--inverted {
      width: {{ block.settings.mobile_logo_width }}px;
    }
    @media only screen and (min-width: 769px) {
      .site-header__logo a {
        width: {{ block.settings.desktop_logo_width }}px;
      }

      .is-light .site-header__logo .logo--inverted {
        width: {{ block.settings.desktop_logo_width }}px;
      }
    }

      @media only screen and (max-width: 768px) {
   #svg-nuwatt-logo {
        display: none !important;
    }

}



    
    {%- endstyle -%}

    {%- if template == 'index' -%}
      <h1 class="site-header__logo" {{ block.shopify_attributes }}>
    {%- else -%}
      <div class="h1 site-header__logo" {{ block.shopify_attributes }}>
    {%- endif -%}

    {%- if block.settings.logo -%}
      {%- assign logo_alt = block.settings.logo.alt | default: shop.name -%}
{%- assign inverted_logo_alt = block.settings.logo-inverted.alt | default: shop.name -%}
      <span class="visually-hidden">NuWatt Lighting</span>
      {% comment %}
        .logo--has-inverted is only applied to the default logo if the inverted logo exists. That way it'll only be hidden on the slider when it has a backup.
      {% endcomment %}
      <a
        href="{{ routes.root_url }}"
        class="site-header__logo-link{% if block.settings.logo-inverted %} logo--has-inverted{% endif %}">



        {% comment %} Desktop logo {% endcomment %}
        {%- assign width = block.settings.desktop_logo_width -%}
        {%- capture sizes -%}{{ block.settings.desktop_logo_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ block.settings.desktop_logo_width }}, {{ block.settings.desktop_logo_width | times: 2 | at_most: block.settings.logo.width }}{%- endcapture -%}
        {%- capture style -%}max-height: {{ block.settings.desktop_logo_width | divided_by: block.settings.logo.aspect_ratio }}px;max-width: {{ block.settings.desktop_logo_width }}px;{%- endcapture -%}

        {% comment %} Mobile logo {% endcomment %}
        {%- assign mobile_width = section.settings.mobile_logo_width -%}
        {%- capture mobile_sizes -%}{{ block.settings.mobile_logo_width }}px{%- endcapture -%}
        {%- capture mobile_widths -%}{{ block.settings.mobile_logo_width }}, {{ block.settings.mobile_logo_width | times: 2 | at_most: block.settings.logo.width }}{%- endcapture -%}
        {%- capture mobile_style -%}max-height: {{ block.settings.mobile_logo_width | divided_by: block.settings.logo.aspect_ratio }}px;max-width: {{ block.settings.mobile_logo_width }}px;{%- endcapture -%}

  <img id="svg-nuwatt-logo" src="https://cdn.shopify.com/s/files/1/0293/5858/7978/files/NW_LOGO_2024_CHARCOAL.png?v=1723064239" alt="Nuwatt Lighting" style="">

        {%- render 'image-element',
          img: block.settings.logo,
          img_width: mobile_width,
          sizes: mobile_sizes,
          widths: mobile_widths,
          style: mobile_style,
          classes: 'medium-up--hide',
          loading: 'eager',
          alt: logo_alt,
        -%}

      
      </a>
      {%- if block.settings.logo-inverted -%}
        <a
          href="{{ routes.root_url }}"
          class="site-header__logo-link logo--inverted">

          
{% comment %} Desktop logo {% endcomment %}
          {%- assign width = block.settings.desktop_logo_width -%}
          {%- capture sizes -%}{{ block.settings.desktop_logo_width }}px{%- endcapture -%}
          {%- capture widths -%}{{ block.settings.desktop_logo_width }}, {{ block.settings.desktop_logo_width | times: 2 | at_most: block.settings.logo-inverted.width }}{%- endcapture -%}
          {%- capture style -%}max-height: {{ block.settings.desktop_logo_width | divided_by: block.settings.logo-inverted.aspect_ratio }}px;max-width: {{ block.settings.desktop_logo_width }}px;{%- endcapture -%}

          {% comment %} Mobile logo {% endcomment %}
          {%- assign mobile_width = block.settings.mobile_logo_width -%}
          {%- capture mobile_sizes -%}{{ block.settings.mobile_logo_width }}px{%- endcapture -%}
          {%- capture mobile_widths -%}{{ block.settings.mobile_logo_width }}, {{ block.settings.mobile_logo_width | times: 2 | at_most: block.settings.logo-inverted.width }}{%- endcapture -%}
          {%- capture mobile_style -%}max-height: {{ block.settings.mobile_logo_width | divided_by: block.settings.logo-inverted.aspect_ratio }}px;max-width: {{ block.settings.mobile_logo_width }}px;{%- endcapture -%}

          {%- render 'image-element',
            img: block.settings.logo-inverted,
            img_width: width,
            sizes: sizes,
            widths: widths,
            style: style,
            classes: 'small--hide',
            loading: 'eager',
           alt: inverted_logo_alt,
          -%}
          {%- render 'image-element',
            img: block.settings.logo-inverted,
            img_width: mobile_width,
            sizes: mobile_sizes,
            widths: mobile_widths,
            style: mobile_style,
            classes: 'medium-up--hide',
            loading: 'eager',
            alt: inverted_logo_alt,
          -%}        
        
        </a>
      {%- endif -%}
    {%- else -%}
      <a href="{{ routes.root_url }}">{{ shop.name }}</a>
    {%- endif -%}
    {%- if template == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

  {%- endif -%}
{%- endfor -%}

{%- unless has_logo -%}
  {%- style -%}
    /* prevent text-only logo from breaking mobile nav */
    .header-item--logo {
      max-width: 60%;
    }
  {%- endstyle -%}
  {%- if template == 'index' -%}
    <h1 class="site-header__logo">
  {%- else -%}
    <div class="h1 site-header__logo">
  {%- endif -%}
  <a href="{{ routes.root_url }}" class="site-header__logo-link">
    {{ shop.name }}
  </a>
  {%- if template == 'index' -%}
    </h1>
  {%- else -%}
    </div>
  {%- endif -%}
{%- endunless -%}
