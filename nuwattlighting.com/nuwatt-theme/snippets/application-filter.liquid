
 {% comment %} {% if collection and collection.handle == 'commercial-lighting' %}

  {% assign application_groups =
    'Office|Panel Lights,Tube Lights~Garage & Shop|Wraparound Lights,Shop Lights,Panel Lights~Warehouse|UFO High Bay Lights,Linear High Bay Lights~Gym & Fitness|High Bay Lights,Panel Lights~Hospitality|Recessed Lights~Lobbies & Waiting Areas|Recessed Lights,Panel Lights~Outdoor|Flood Lights,Bullet Lights,Wall Packs,Canopy Lights'
    | split: '~'
  %}

  <div class="application-filter" data-application-filter>
    {% comment %} <div class="application-filter__header">
      <h2 class="application-filter__title">Applications</h2>
    </div> {% endcomment %}

    {% for group_string in application_groups %}
      {% assign group_parts = group_string | split: '|' %}
      {% assign group_name = group_parts[0] %}
      {% assign group_types = group_parts[1] | split: ',' %}

      <fieldset class="application-filter__group">
        <legend class="application-filter__group-title">{{ group_name }}</legend>

        <div class="application-filter__options">
          {% for product_type in group_types %}
            <label class="application-filter__option">
              <input
                type="checkbox"
                class="custom-app-filter"
                value="{{ product_type | strip | escape }}"
              >
              <span>{{ product_type | strip }}</span>
            </label>
          {% endfor %}
        </div>
      </fieldset>
    {% endfor %}
  </div>

  <style>
    .application-filter { margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.1); }
    .application-filter__title { font-size: 16px; font-weight: 700; margin-bottom: 1rem; text-transform: uppercase; }
    .application-filter__group { margin: 0 0 1.5rem; padding: 0; border: 0; }
    .application-filter__group-title { margin: 0 0 0.75rem; padding: 0; font-weight: 600; line-height: 1.35; }
    .application-filter__options { display: grid; gap: 0.6rem; padding-left: 0.25rem; }
    .application-filter__option { display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; line-height: 1.35; }
    .application-filter__option input { flex: 0 0 auto; width: 1rem; height: 1rem; margin-top: 0.15rem; }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const customCheckboxes = document.querySelectorAll('.custom-app-filter');
      if (customCheckboxes.length === 0) return;

      // The exact URL parameter for your Commercial Application metafield
      const paramName = 'filter.p.m.custom.commercial_application';

      // 1. Sync UI state on page load based on the URL
      const urlParams = new URLSearchParams(window.location.search);
      const activeValues = urlParams.getAll(paramName);
      
      customCheckboxes.forEach(cb => {
        if (activeValues.includes(cb.value)) {
          cb.checked = true;
        }
      });

      // 2. Handle checkbox changes
      customCheckboxes.forEach(cb => {
        cb.addEventListener('change', function() {
          updateURLAndFetch();
        });
      });

      function updateURLAndFetch() {
        const url = new URL(window.location);
        url.searchParams.delete(paramName); // Clear existing custom filters
        
        // Append all currently checked boxes (Creates OR logic)
        document.querySelectorAll('.custom-app-filter:checked').forEach(checkedCb => {
          url.searchParams.append(paramName, checkedCb.value);
        });
        
        window.history.pushState({}, '', url); // Update the URL bar
        
        // Fetch the filtered product grid from Shopify (AJAX)
        fetch(url)
          .then(res => res.text())
          .then(text => {
            const html = new DOMParser().parseFromString(text, 'text/html');
            
            // Locate the product grid in the new HTML
            const newGrid = html.querySelector('#ProductGridContainer') || html.querySelector('#product-grid') || html.querySelector('.collection-grid');
            const currentGrid = document.querySelector('#ProductGridContainer') || document.querySelector('#product-grid') || document.querySelector('.collection-grid');
            
            if (newGrid && currentGrid) {
              currentGrid.innerHTML = newGrid.innerHTML;
            }
          })
          .catch(error => console.error('Error fetching filtered products:', error));
      }
    });
  </script>

