<div class="nuwatt-application-filter">
  {% assign application_pairs = '' %}

  {% for product in collection.products %}
    {% assign applications = product.metafields.custom.application.value %}
    {% assign application_type = product.metafields.custom.application_type.value %}

    {% if applications != blank and application_type != blank %}
      {% for application in applications %}
        {% assign application_name = application | strip %}
        {% assign type_name = application_type | strip %}

        {% if application_name != blank and type_name != blank %}
          {% capture pair %}
            {{ application_name }}|||{{ type_name }}
          {% endcapture %}

          {% assign application_pairs =
            application_pairs
            | append: pair
            | append: '###'
          %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}

  {% assign application_pairs =
    application_pairs
    | split: '###'
    | uniq
  %}

  {% assign application_names = '' %}

  {% for pair in application_pairs %}
    {% assign pair_parts = pair | split: '|||' %}
    {% assign application_name = pair_parts[0] | strip %}

    {% if application_name != blank %}
      {% unless application_names contains application_name %}
        {% assign application_names =
          application_names
          | append: application_name
          | append: '###'
        %}
      {% endunless %}
    {% endif %}
  {% endfor %}

  {% assign application_names =
    application_names
    | split: '###'
    | uniq
  %}

  {% for application in application_names %}
    {% if application != blank %}
      <div class="nuwatt-application-group">
        <h4>{{ application }}</h4>

        {% for pair in application_pairs %}
          {% assign pair_parts = pair | split: '|||' %}
          {% assign pair_application = pair_parts[0] | strip %}
          {% assign pair_type = pair_parts[1] | strip %}

          {% if pair_application == application %}
            <label class="nuwatt-application-option">
              <input
                type="checkbox"
                class="nuwatt-application-checkbox"
                data-application="{{ pair_application | escape }}"
                data-type="{{ pair_type | escape }}"
              >

              <span>{{ pair_type }}</span>
            </label>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}
</div>

<script>
(function () {
  function initializeNuwattApplicationFilter() {
    const filterContainer = document.querySelector(
      '.nuwatt-application-filter'
    );

    if (!filterContainer) {
      return;
    }

    const checkboxes = Array.from(
      filterContainer.querySelectorAll(
        '.nuwatt-application-checkbox'
      )
    );

    if (!checkboxes.length) {
      return;
    }

    function getSelectedFilters() {
      return checkboxes
        .filter(function (checkbox) {
          return checkbox.checked;
        })
        .map(function (checkbox) {
          return {
            application: checkbox.dataset.application,
            type: checkbox.dataset.type
          };
        });
    }

    function restoreCheckboxes() {
      const url = new URL(window.location.href);

      const applicationParam = url.searchParams.get(
        'filter.p.m.custom.application'
      );

      const typeParam = url.searchParams.get(
        'filter.p.m.custom.application_type'
      );

      const applications = applicationParam
        ? applicationParam
            .split(',')
            .map(function (value) {
              return value.trim();
            })
        : [];

      const types = typeParam
        ? typeParam
            .split(',')
            .map(function (value) {
              return value.trim();
            })
        : [];

      checkboxes.forEach(function (checkbox) {
        const application =
          checkbox.dataset.application;

        const type =
          checkbox.dataset.type;

        checkbox.checked =
          applications.includes(application) &&
          types.includes(type);
      });
    }

    function createFilterURL() {
      const url = new URL(window.location.href);
      const selected = getSelectedFilters();

      url.searchParams.delete(
        'filter.p.m.custom.application'
      );

      url.searchParams.delete(
        'filter.p.m.custom.application_type'
      );

      url.searchParams.delete('page');

      if (!selected.length) {
        return url;
      }

      /*
       * Shopify treats values inside one metafield as OR.
       *
       * Therefore:
       *
       * application = Office,Garage & Shop
       * type        = Panel Lights
       *
       * means:
       *
       * application contains Office OR Garage & Shop
       * AND type equals Panel Lights
       */

      const applications = [
        ...new Set(
          selected.map(function (item) {
            return item.application;
          })
        )
      ];

      const types = [
        ...new Set(
          selected.map(function (item) {
            return item.type;
          })
        )
      ];

      url.searchParams.set(
        'filter.p.m.custom.application',
        applications.join(',')
      );

      url.searchParams.set(
        'filter.p.m.custom.application_type',
        types.join(',')
      );

      return url;
    }

    async function loadProducts(url) {
      const currentProductGrid =
        document.querySelector('#product-grid');

      if (!currentProductGrid) {
        console.error(
          'Nuwatt filter: #product-grid was not found.'
        );
        return;
      }

      filterContainer.classList.add(
        'nuwatt-filter-loading'
      );

      try {
        const ajaxURL = new URL(url.toString());

        ajaxURL.searchParams.set(
          'section_id',
          'main-collection-product-grid'
        );

        const response = await fetch(
          ajaxURL.toString(),
          {
            method: 'GET',
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          }
        );

        if (!response.ok) {
          throw new Error(
            'Shopify request failed: ' +
            response.status
          );
        }

        const html = await response.text();

        if (!html.trim()) {
          throw new Error(
            'Shopify returned empty HTML.'
          );
        }

        const parser = new DOMParser();

        const newDocument = parser.parseFromString(
          html,
          'text/html'
        );

        const newProductGrid =
          newDocument.querySelector('#product-grid');

        if (!newProductGrid) {
          throw new Error(
            '#product-grid was not found in AJAX response.'
          );
        }

        currentProductGrid.innerHTML =
          newProductGrid.innerHTML;

        const currentCount =
          document.querySelector('.product-count');

        const newCount =
          newDocument.querySelector('.product-count');

        if (currentCount && newCount) {
          currentCount.innerHTML =
            newCount.innerHTML;
        }

        window.history.pushState(
          {},
          '',
          url.pathname + url.search + url.hash
        );

        document.dispatchEvent(
          new CustomEvent(
            'nuwatt:filter-updated'
          )
        );

      } catch (error) {
        console.error(
          'Nuwatt Application Filter:',
          error
        );
      } finally {
        filterContainer.classList.remove(
          'nuwatt-filter-loading'
        );
      }
    }

    checkboxes.forEach(function (checkbox) {
      checkbox.addEventListener(
        'change',
        function () {
          const url = createFilterURL();

          loadProducts(url);
        }
      );
    });

    window.addEventListener(
      'popstate',
      function () {
        restoreCheckboxes();

        const url = new URL(window.location.href);

        loadProducts(url);
      }
    );

    restoreCheckboxes();
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initializeNuwattApplicationFilter
    );
  } else {
    initializeNuwattApplicationFilter();
  }
})();
</script>


