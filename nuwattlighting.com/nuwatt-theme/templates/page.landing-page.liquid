/* How this guide works - step flow */

.how-it-works {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  margin-top: 36px;
  background: transparent;
}

.how-it-works div {
  position: relative;
  padding: 16px 28px 16px 16px;
  font-size: 12.5px;
  color: var(--slate);
}

.how-it-works div:not(:last-child)::after {
  content: "→";
  position: absolute;
  right: 6px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24px;
  font-weight: 400;
  color: var(--gold-deep);
}

.how-it-works b {
  display: block;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .06em;
  color: var(--gold-deep);
  text-transform: uppercase;
  margin-bottom: 4px;
}

@media (max-width: 900px) {
  .how-it-works {
    grid-template-columns: 1fr 1fr;
  }

  .how-it-works div {
    padding-right: 35px;
  }

  .how-it-works div:nth-child(2)::after {
    content: "";
  }

  .how-it-works div:nth-child(odd)::after {
    content: "→";
  }
}

@media (max-width: 520px) {
  .how-it-works {
    grid-template-columns: 1fr;
  }

  .how-it-works div {
    padding: 12px 16px 28px;
  }

  .how-it-works div:not(:last-child)::after {
    content: "↓";
    right: auto;
    left: 50%;
    top: auto;
    bottom: 0;
    transform: translateX(-50%);
    font-size: 20px;
  }
}

</style>

