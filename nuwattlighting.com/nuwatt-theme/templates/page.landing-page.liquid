<!-- ================= SHARED APPLICATION SECTION STYLES ================= -->
<style>
.app-section{
  padding:72px 0; border-bottom:1px solid var(--line); scroll-margin-top:var(--header-h);
}
.app-section:nth-of-type(even){background:var(--paper);}
.app-section__head{max-width:760px; margin-bottom:34px;}
.app-section__num{
  font-family:var(--font-mono); font-size:12px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--gold-deep); font-weight:600; display:block; margin-bottom:10px;
}
.app-section h2{font-size:32px; margin-bottom:14px;}
.app-section__intro{font-size:16px; color:var(--slate); line-height:1.7;}

/* Quick Selection plate — signature element */
.quick-select{
  display:grid; grid-template-columns:1fr 1.6fr; gap:0;
  background:var(--navy); color:var(--white); border-radius:var(--radius-l);
  overflow:hidden; margin:28px 0 48px;
}
.quick-select__label{
  padding:26px 26px; background:var(--navy-2); border-right:1px solid rgba(255,255,255,.1);
  display:flex; flex-direction:column; justify-content:center;
}
.quick-select__label .tag{
  font-family:var(--font-mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--gold); font-weight:600; margin-bottom:8px;
}
.quick-select__label .best-for{font-family:var(--font-display); font-size:18px; font-weight:600; line-height:1.35;}
.quick-select__body{padding:26px 28px; display:flex; flex-direction:column; gap:14px; justify-content:center;}
.quick-select__row{display:flex; gap:14px; align-items:baseline; font-size:14px;}
.quick-select__row .k{
  font-family:var(--font-mono); font-size:11px; letter-spacing:.08em; text-transform:uppercase;
  color:#ebf7f6; min-width:88px; flex-shrink:0;
}
.quick-select__row .v{color:#DDE2EC; line-height:1.6;}
@media (max-width:760px){
  .quick-select{grid-template-columns:1fr;}
  .quick-select__label{border-right:none; border-bottom:1px solid rgba(255,255,255,.1);}
}

/* H3 sub-blocks */
.app-section h3{
  font-size:19px; color:var(--navy); margin:44px 0 18px; padding-top:2px;
  display:flex; align-items:center; gap:10px;
}
.app-section h3::before{content:""; width:20px; height:2px; background:var(--gold-deep); flex-shrink:0;}
.consider-list{
  list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:10px 28px;
}
.consider-list li{
  font-size:14.5px; color:var(--ink); line-height:1.55; padding-left:18px; position:relative;
}
.consider-list li::before{
  content:""; position:absolute; left:0; top:9px; width:6px; height:6px; border-radius:50%;
  background:var(--gold-deep);
}
.consider-list li b{color:var(--navy); font-weight:600;}
@media (max-width:640px){ .consider-list{grid-template-columns:1fr;} }

/* Fixture recommendation cards */
.fixture-grid{display:grid; grid-template-columns:repeat(2, 1fr); gap:18px;}
.fixture-grid.cols-4{grid-template-columns:repeat(4,1fr);}
.fixture-grid.cols-1{grid-template-columns:1fr; max-width:480px;}
.fixture-card{
  border:1px solid var(--line); border-radius:var(--radius-m); background:var(--white);
  padding:22px; display:flex; flex-direction:column; gap:12px;
}
.fixture-card__name{font-family:var(--font-display); font-size:17px; font-weight:600; color:var(--navy);}
.fixture-card__best{
  font-size:13px; color:var(--slate); line-height:1.6;
}
.fixture-card__best strong{color:var(--ink);}
.fixture-card__points{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:6px;}
.fixture-card__points li{
  font-size:12.5px; color:var(--slate); padding-left:14px; position:relative;
}
.fixture-card__points li::before{content:"—"; position:absolute; left:0; color:var(--gold-deep);}
.fixture-card__cta{
  margin-top:auto; align-self:flex-start; font-weight:700; font-size:13.5px; color:var(--gold-deep);
  text-decoration:none; padding-top:6px; border-top:1px solid var(--line); width:100%;
}
.fixture-card__cta:hover{color:var(--navy);}
@media (max-width:760px){
  .fixture-grid, .fixture-grid.cols-4{grid-template-columns:1fr;}
}

/* Mistake callout */
.mistake-box{
  background:var(--mistake-bg); border:1px solid var(--mistake-border); border-radius:var(--radius-m);
  padding:22px 24px;
}
.mistake-box ul{margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:10px;}
.mistake-box li{
  font-size:14.5px; color:var(--ink); padding-left:26px; position:relative; line-height:1.55;
}
.mistake-box li::before{
  content:"✕"; position:absolute; left:0; top:0; color:var(--mistake-text); font-weight:700; font-size:13px;
}

/* Checklist */
.checklist{
  background: #fce8af59;
    border: 1px solid #fef8e5; border-radius:var(--radius-m);
  padding:24px 26px;
}
.checklist__title{
  font-family:var(--font-mono); font-size:11.5px; letter-spacing:.1em; text-transform:uppercase;
  color:var(--check-text); font-weight:600; margin-bottom:14px; display:block;
}
.checklist ul{list-style:none; margin:0; padding:0; columns:2; column-gap:28px;}
.checklist li{break-inside:avoid; margin-bottom:11px;}
.checklist label{
  display:flex; align-items:flex-start; gap:10px; font-size:14px; color:var(--ink); cursor:pointer; line-height:1.5; font-weight: 400 !important;
