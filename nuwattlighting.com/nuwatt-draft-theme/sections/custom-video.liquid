  .headr-gallery__main-link .headr-gallery__image {
    /* Start off invisible and slightly scaled down */
    opacity: 0;

    animation: fadeInHero 1.7s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .headr-gallery__side-link .headr-gallery__image {
    /* Start off invisible and slightly scaled down */
    opacity: 0;

    animation: fadeInHero 1.7s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  @keyframes fadeInHero {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

