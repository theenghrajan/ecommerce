{% style %}
  {%- if section.settings.main_image_height != blank -%}
  @media screen and (min-width: 1025px) {
    #shopify-section-{{ section.id }} .headr-gallery-container {
      height: {{ section.settings.main_image_height }}px !important;
    }
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy {
      height: {{ section.settings.main_image_height }}px !important;
    }
  }
  {%- endif -%}
{% endstyle %}


<div class="page-width headr-gallery-container">
  <a
    href="{% if section.settings.main_image_link %}{{ section.settings.main_image_link }}{% else %}https://www.nuwattlighting.com{% endif %}"
    class="headr-gallery__main-link"
    id="headr-gallery__main-link-sy"
  >
    <div class="headr-gallery__overlay-content">
      {% if section.settings.main_header_title != blank %}
        <h1 class="headr-gallery__title">{{ section.settings.main_header_title }}</h1>
      {% endif %}
      {% if section.settings.main_sub_header_text != blank %}
        <p class="headr-gallery__description">{{ section.settings.main_sub_header_text }}</p>
      {% endif %}
      {% if section.settings.main_button_text != blank %}
        <button class="headr-gallery__button">{{ section.settings.main_button_text }}</button>
      {% endif %}
    </div>







    {% if section.settings.main_image_src != blank %}

      <img
        src="{% if section.settings.main_image_src %}{{ section.settings.main_image_src | remove_first: 'files/' | file_url }}{% else %}https://cdn.shopify.com/s/files/1/0293/5858/7978/files/iStock-853258138_15a105a5-758f-42a3-9a0c-b41cc88b8999.jpg{% endif %}"
        alt="{{ section.settings.main_image_alt }}"
        class="headr-gallery__image main-headr-image-static v">
      {%  else %}

              <div
        data-section-id="template--16663488364618__hero_video_Edip8Y"
        data-section-type="video-section"
        class="video-parent-section hero hero--template--16663488364618__hero_video_Edip8Y loaded"
      >
        <div class="hero__media hero__media--template--16663488364618__hero_video_Edip8Y">
          <div class="hero__media-container nextstepb">

            {{ section.settings.videoex | video_tag:
              controls: false,
              autoplay: true,
              loop: true,
              muted: true
            }}

            {% comment %} <video
              id="Mp4Video-template--16663488364618__hero_video_Edip8Y"
              class="video-div"
              loop
              muted
              playsinline
              autoplay
              preload="metadata"
              aria-hidden="true"
            >
              <!-- Primary video source: MP4 -->
              {% comment %}
              <source src="https://cdn.shopify.com/videos/c/o/v/ca4cfb6203e24c708ff8fcf4513b03f9.mp4" type="video/mp4">
                {% endcomment %}
              <!-- Alternate video source: WebM (optional but recommended) -->
                 <source src="{{ section.settings.button_link }}" type="video/mp4">

                     <source
                src="{{ section.settings.button_link }}"
                type="video/webm"
              >
              {% comment %}
              <source
                src="https://cdn.shopify.com/videos/c/o/v/ca4cfb6203e24c708ff8fcf4513b03f9.webm"
                type="video/webm"
              >
                {% endcomment %}
              <!-- Fallback content for browsers that don't support the video element -->
              Your browser does not support the video tag.
            </video> {% endcomment %}
          </div>
        </div>
      </div>

    {%  endif %}
  </a>
</div>

