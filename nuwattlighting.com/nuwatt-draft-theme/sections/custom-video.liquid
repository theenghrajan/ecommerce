{% style %}
  {%- comment -%}
    #151 (#73): the video was cut off because main_image_height fixed the box at 530px. Gary
    agreed in #24/#30 to a 16:9 video that never crops, capped near 1920x1080 (page-width is
    1900px) and not edge to edge on larger screens. The height setting now only applies to
    a static image.
  {%- endcomment -%}
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .headr-gallery-container,
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy {
      height: auto !important;
    }
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy .video-parent-section {
      position: absolute;
      inset: 0;
      height: 100%;
    }
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy .hero__media,
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy .hero__media-container,
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy .headr-gallery__video {
      width: 100%;
      height: 100%;
    }
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy .headr-gallery__video {
      object-fit: cover;
    }
  }
  {%- if section.settings.main_image_height != blank and section.settings.main_image_src != blank -%}
  @media screen and (min-width: 1025px) {
    #shopify-section-{{ section.id }} .headr-gallery-container {
      height: {{ section.settings.main_image_height }}px !important;
    }
    #shopify-section-{{ section.id }} #headr-gallery__main-link-sy {
      height: {{ section.settings.main_image_height }}px !important;
    }
  }
  {%- endif -%}
{% endstyle %}


<div class="page-width headr-gallery-container">
  <a
    href="{% if section.settings.main_image_link %}{{ section.settings.main_image_link }}{% else %}https://www.nuwattlighting.com{% endif %}"
    class="headr-gallery__main-link"
    id="headr-gallery__main-link-sy"
  >
    <div class="headr-gallery__overlay-content">
      {% if section.settings.main_header_title != blank %}
        <h1 class="headr-gallery__title">{{ section.settings.main_header_title }}</h1>
      {% endif %}
      {% if section.settings.main_sub_header_text != blank %}
        <p class="headr-gallery__description">{{ section.settings.main_sub_header_text }}</p>
      {% endif %}
      {% if section.settings.main_button_text != blank %}
        <button class="headr-gallery__button">{{ section.settings.main_button_text }}</button>
      {% endif %}
    </div>







    {% if section.settings.main_image_src != blank %}

      <img
        src="{% if section.settings.main_image_src %}{{ section.settings.main_image_src | remove_first: 'files/' | file_url }}{% else %}https://cdn.shopify.com/s/files/1/0293/5858/7978/files/iStock-853258138_15a105a5-758f-42a3-9a0c-b41cc88b8999.jpg{% endif %}"
        alt="{{ section.settings.main_image_alt }}"
        class="headr-gallery__image main-headr-image-static v">
      {%  else %}

              <div
        data-section-id="template--16663488364618__hero_video_Edip8Y"
        data-section-type="video-section"
        class="video-parent-section hero hero--template--16663488364618__hero_video_Edip8Y loaded"
      >
        <div class="hero__media hero__media--template--16663488364618__hero_video_Edip8Y">
          <div class="hero__media-container nextstepb">

            {%- comment -%} #151 mobile audit (4): no autoplay/preload in the markup so phones never fetch
              the 26 MB file; the script below starts it at 768px and up. {%- endcomment -%}
            {{ section.settings.videoex | video_tag:
              controls: false,
              autoplay: false,
              loop: true,
              muted: true,
              preload: 'none',
              class: 'headr-gallery__video'
            }}

            {% comment %} <video
              id="Mp4Video-template--16663488364618__hero_video_Edip8Y"
              class="video-div"
              loop
              muted
              playsinline
              autoplay
              preload="metadata"
              aria-hidden="true"
            >
              <!-- Primary video source: MP4 -->
              {% comment %}
              <source src="https://cdn.shopify.com/videos/c/o/v/ca4cfb6203e24c708ff8fcf4513b03f9.mp4" type="video/mp4">
                {% endcomment %}
              <!-- Alternate video source: WebM (optional but recommended) -->
                 <source src="{{ section.settings.button_link }}" type="video/mp4">

                     <source
                src="{{ section.settings.button_link }}"
                type="video/webm"
              >
              {% comment %}
              <source
                src="https://cdn.shopify.com/videos/c/o/v/ca4cfb6203e24c708ff8fcf4513b03f9.webm"
                type="video/webm"
              >
                {% endcomment %}
              <!-- Fallback content for browsers that don't support the video element -->
              Your browser does not support the video tag.
            </video> {% endcomment %}
          </div>
        </div>
      </div>

    {%  endif %}
  </a>

  {%- comment -%}
    #151 mobile audit (4): phones get a 1:1 image with the headline and CTA as live text
    instead of the desktop video (Gary: keep the image 1:1, placeholder image for now).
    Falls back to the video's own preview frame until a mobile image is chosen.
  {%- endcomment -%}
  {%- liquid
    assign mobile_img = section.settings.mobile_image
    if mobile_img == blank and section.settings.videoex != blank
      assign mobile_img = section.settings.videoex.preview_image
    endif
  -%}
  {%- if mobile_img != blank -%}
    <div class="headr-gallery__mobile">
      {{ mobile_img | image_url: width: 1080 | image_tag:
        widths: '400, 600, 800, 1080',
        sizes: 'calc(100vw - 34px)',
        class: 'headr-gallery__mobile-image',
        alt: section.settings.mobile_image_alt,
        loading: 'eager',
        fetchpriority: 'high'
      }}
      {%- if section.settings.mobile_heading != blank or section.settings.mobile_button_text != blank -%}
        <div class="headr-gallery__mobile-content">
          {%- if section.settings.mobile_heading != blank -%}
            <h2 class="headr-gallery__mobile-title">{{ section.settings.mobile_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.mobile_button_text != blank -%}
            <a href="{{ section.settings.mobile_button_link | default: routes.all_products_collection_url }}" class="headr-gallery__mobile-btn">{{ section.settings.mobile_button_text | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    var video = section && section.querySelector('.headr-gallery__video');
    if (!video) return;
    var desktop = window.matchMedia('(min-width: 768px)');
    function start() {
      if (!desktop.matches || video.dataset.started) return;
      video.dataset.started = 'true';
      video.preload = 'auto';
      video.autoplay = true;
      var play = video.play();
      if (play && play.catch) play.catch(function () {});
    }
    start();
    if (desktop.addEventListener) desktop.addEventListener('change', start);
  })();
</script>

