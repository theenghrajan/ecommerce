{% stylesheet %}
  .headr-gallery-container.page-width {
    margin: 0 auto;
    max-width: 1900px;
  }
  .headr-gallery-container {
    /* margin: 10px; */
    height: 550px;
    width: -webkit-fill-available;
    display: grid;
    gap: 10px;
    /* border: solid yellow 2px; */
  }

  .headr-gallery__main-link {
    display: block;
    overflow: hidden;
    text-decoration: none;
    height: 100%;
    position: relative;
    width: inherit;
    background: black
  }

  .headr-gallery__side-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
  }

  .headr-gallery__side-link {
    display: block;
    overflow: hidden;
    text-decoration: none;
    position: relative;
    height: calc((100% - 20px) / 2); /* Account for gap */
  }

  .headr-gallery__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }



  /* New Overlay Styles */
  .headr-gallery__overlay-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    /* background: linear-gradient(to right, rgba(248, 248, 248, 0.9) 30%, transparent); */
    /* background: linear-gradient(to right, rgba(248, 248, 248, 0.9) 6%, transparent); */
    z-index: 2;
  }

  .headr-gallery__side-container__overlay-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    /* background: linear-gradient(to right, rgba(248, 248, 248, 0.6) 6%, transparent); */
    z-index: 2;
     /* background: linear-gradient(to right, rgb(16 16 16 / 90%) 5%, transparent); */
    border-radius: 20px;
  }

  .grdnt{
     background: linear-gradient(to right, rgb(16 16 16 / 80%) 3%, transparent);

  }



  .headr-gallery__title {
    font-family: sans-serif;
    color: white;
    margin: 0;
    max-width: 60%;
    font-weight: 800;
    line-height: 1.2;
    text-shadow: 0 0 6px #000;
  }

  .headr-gallery__title__side-container {
    font-family: sans-serif;
    margin: 0;
    max-width: 60%;
    font-weight: 800;
    line-height: 1.2;
    text-shadow: 0 0 6px #000;
    color: white;
  }

  .headr-gallery__description {
    font-family: sans-serif;
    color: white;
    margin: 0;
    max-width: 60%;
    line-height: 1.5;
    text-shadow: 0 0 6px #000;
  }

  .headr-gallery__description__side-container {
    font-family: sans-serif;
    color: white;
    margin: 0;
    max-width: 60%;
    line-height: 1.5;
    text-shadow: 0 0 6px #000;
  }

  .headr-gallery__button {
    display: inline-block;
    background-color: #fcc934;
    color: #000;
    text-decoration: none;
    padding: 2px 150px 2px 150px;
    border-radius: 2rem;
    font-family: 'nw-medium';
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    max-width: fit-content;
  }

  .headr-gallery__button:hover {
    background-color: #ffa600;
  }

  .headr-gallery__button__side-container {
    display: inline-block;
    background-color: #fcc934;
    color: #000;
    text-decoration: none;
    padding: 2px 20px 2px 20px;
    border-radius: 2rem;

    font-family: 'nw-medium';
    letter-spacing: 2px;

    text-transform: uppercase;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    max-width: fit-content;
  }

  .headr-gallery__button__side-container:hover {
    background-color: #ffa600;
  }

  .main-headr-image-static{
        object-fit: cover;

  }
