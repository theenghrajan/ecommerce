      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 20px;
    }
    .headr-gallery__mobile-title {
      margin: 0;
      color: #fff;
      font-family: var(--typeBasePrimary), var(--typeBaseFallback);
      font-size: 28px;
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: 0;
      text-transform: none !important;
    }
    .headr-gallery__mobile-btn {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 20px;
      border-radius: 6px;
      background: #fcc833;
      color: #202020;
      font-family: var(--typeBasePrimary), var(--typeBaseFallback);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
    }
  }
