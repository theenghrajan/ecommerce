{% comment %}
  SS Sale Banner (#144, /pages/sale)
  One page, one URL all year: a Sale version while the sale runs and an
  Off-season version the rest of the year. Styled from ss-anchor-hero (same
  ss-anchor-* classes, so it matches the anchor pages).

  The schedule lives here. Start/end are Eastern time ("2026-11-30 23:59").
  An inline script compares them with the shopper's clock and sets
  ss-sale--on / ss-sale--off on <html>; other sections on the page use
  snippets/ss-sale-visibility.liquid to show only in one mode. This runs in
  the browser rather than in Liquid because Shopify caches rendered pages, so
  a Liquid date check could stay on the old version after the sale ends.
  "Page mode" can force either version (e.g. to edit it in the theme editor).

  The countdown is its own block, positioned over the banner independently of
  the image, so changing the image never moves it.
{% endcomment %}

{{ 'ss-anchor.css' | asset_url | stylesheet_tag }}
{%- render 'ss-anchor-case', id: section.id, mode: section.settings.text_case -%}
{%- render 'ss-anchor-space', id: section.id, top: 0, bottom: 0 -%}

{%- liquid
  assign o = section.settings.overlay_opacity | divided_by: 100.0
  assign sale_start = ''
  assign sale_end = ''
  if section.settings.sale_start != blank
    assign sale_start = section.settings.sale_start | strip | replace: ' ', 'T' | append: ':00-05:00'
  endif
  if section.settings.sale_end != blank
    assign sale_end = section.settings.sale_end | strip | replace: ' ', 'T' | append: ':00-05:00'
  endif
  assign off_image = section.settings.off_image | default: section.settings.image
  assign off_image_mobile = section.settings.off_image_mobile | default: section.settings.image_mobile
  assign crumb_label = section.settings.breadcrumb_label | default: page.title
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --ss-btn-radius: {{ section.settings.button_radius }}px;
  }
  #shopify-section-{{ section.id }} .ss-anchor-hero {
    min-height: {{ section.settings.min_height }}px;
  }
  #shopify-section-{{ section.id }} .ss-anchor-hero__overlay {
    background: linear-gradient(
      to {{ section.settings.gradient_direction }},
      rgba(0, 0, 0, {{ o }}) 0%,
      rgba(0, 0, 0, {{ o | times: 0.625 }}) 50%,
      rgba(0, 0, 0, 0) 100%
    );
  }
  html.ss-sale--off #shopify-section-{{ section.id }} .ss-sale-only,
  html.ss-sale--on #shopify-section-{{ section.id }} .ss-off-only {
    display: none !important;
  }
  /* Before the script runs (or without JS) show the Sale version only. */
  html:not(.ss-sale--on):not(.ss-sale--off) #shopify-section-{{ section.id }} .ss-off-only {
    display: none !important;
  }
  #shopify-section-{{ section.id }} .ss-sale-hero__img--mobile { display: none; }
  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .ss-anchor-hero {
      min-height: {{ section.settings.min_height_mobile }}px;
    }
    #shopify-section-{{ section.id }} .ss-sale-hero__img--has-mobile { display: none; }
    #shopify-section-{{ section.id }} .ss-sale-hero__img--mobile { display: block; }
  }

  #shopify-section-{{ section.id }} .ss-sale-countdown {
    position: absolute;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-radius: 8px;
    background: {{ section.settings.countdown_bg }};
    color: {{ section.settings.countdown_text }};
    font-family: Roboto, var(--typeBasePrimary), sans-serif;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ss-sale-countdown[hidden] { display: none; }
  #shopify-section-{{ section.id }} .ss-sale-countdown--top-right { top: 24px; right: 24px; }
  #shopify-section-{{ section.id }} .ss-sale-countdown--top-left { top: 24px; left: 24px; }
  #shopify-section-{{ section.id }} .ss-sale-countdown--bottom-right { bottom: 24px; right: 24px; }
  #shopify-section-{{ section.id }} .ss-sale-countdown--bottom-left { bottom: 24px; left: 24px; }
  #shopify-section-{{ section.id }} .ss-sale-countdown--bottom-center { bottom: 24px; left: 50%; transform: translateX(-50%); }
  #shopify-section-{{ section.id }} .ss-sale-countdown__label {
    margin: 0;
    font-size: 13px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .ss-sale-countdown__units {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .ss-sale-countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 54px;
  }
  #shopify-section-{{ section.id }} .ss-sale-countdown__num {
    font-size: 30px;
    line-height: 36px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  #shopify-section-{{ section.id }} .ss-sale-countdown__name {
    font-size: 11px;
    line-height: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  @media only screen and (max-width: 768px) {
    /* Phones: a full-width strip across the top of the banner, so it never
       sits on the heading whatever corner is set for desktop. */
    #shopify-section-{{ section.id }} .ss-sale-countdown {
      top: 0; right: 0; bottom: auto; left: 0;
      transform: none;
      flex-direction: row;
      justify-content: center;
      gap: 12px;
      padding: 10px 16px;
      border-radius: 0;
    }
    #shopify-section-{{ section.id }} .ss-sale-countdown__label { font-size: 11px; max-width: 70px; text-align: left; }
    #shopify-section-{{ section.id }} .ss-sale-countdown__units { gap: 6px; }
    #shopify-section-{{ section.id }} .ss-sale-countdown__unit { min-width: 40px; }
    #shopify-section-{{ section.id }} .ss-sale-countdown__num { font-size: 22px; line-height: 26px; }
    #shopify-section-{{ section.id }} .ss-sale-countdown__name { font-size: 10px; }
    #shopify-section-{{ section.id }} .ss-sale-hero--has-countdown .ss-anchor-hero__inner { padding-top: 88px; }
  }
{%- endstyle -%}

{%- capture countdown_blocks -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'countdown' -%}
      <div
        class="ss-sale-countdown ss-sale-countdown--{{ block.settings.position }}"
        data-ss-countdown
        data-label-before="{{ block.settings.label_before | escape }}"
        data-label-during="{{ block.settings.label_during | escape }}"
        data-show-before="{{ block.settings.show_before }}"
        role="timer"
        aria-live="off"
        hidden
        {{ block.shopify_attributes }}
      >
        <p class="ss-sale-countdown__label" data-ss-countdown-label>{{ block.settings.label_during | escape }}</p>
        <ul class="ss-sale-countdown__units">
          <li class="ss-sale-countdown__unit"><span class="ss-sale-countdown__num" data-unit="d">00</span><span class="ss-sale-countdown__name">Days</span></li>
          <li class="ss-sale-countdown__unit"><span class="ss-sale-countdown__num" data-unit="h">00</span><span class="ss-sale-countdown__name">Hours</span></li>
          <li class="ss-sale-countdown__unit"><span class="ss-sale-countdown__num" data-unit="m">00</span><span class="ss-sale-countdown__name">Mins</span></li>
          <li class="ss-sale-countdown__unit"><span class="ss-sale-countdown__num" data-unit="s">00</span><span class="ss-sale-countdown__name">Secs</span></li>
        </ul>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  id="SsSaleHero-{{ section.id }}"
  class="ss-anchor-section ss-anchor-hero-wrap"
  data-section-id="{{ section.id }}"
  data-section-type="ss-sale-hero"
  data-mode="{{ section.settings.mode }}"
  data-start="{{ sale_start }}"
  data-end="{{ sale_end }}"
>
  <div class="ss-anchor-hero hero{% if countdown_blocks != blank %} ss-sale-hero--has-countdown{% endif %}">
    <div class="ss-anchor-hero__media hero__image-wrapper">
      {%- comment -%} Sale banner {%- endcomment -%}
      <div class="ss-sale-only">
        {%- if section.settings.image != blank -%}
          <div class="ss-sale-hero__img{% if section.settings.image_mobile != blank %} ss-sale-hero__img--has-mobile{% endif %}">
            {%- render 'image-element', img: section.settings.image, alt: '', widths: '600, 900, 1280, 1600, 2000, 2400, 3000', sizes: '100vw', classes: 'hero__image', ariaHidden: true, loading: 'eager' -%}
          </div>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.image_mobile != blank -%}
          <div class="ss-sale-hero__img ss-sale-hero__img--mobile">
            {%- render 'image-element', img: section.settings.image_mobile, alt: '', widths: '400, 600, 800, 1000, 1200', sizes: '100vw', classes: 'hero__image', ariaHidden: true, loading: 'eager' -%}
          </div>
        {%- endif -%}
      </div>
      {%- comment -%} Off-season banner, falls back to the sale images {%- endcomment -%}
      <div class="ss-off-only">
        {%- if off_image != blank -%}
          <div class="ss-sale-hero__img{% if off_image_mobile != blank %} ss-sale-hero__img--has-mobile{% endif %}">
            {%- render 'image-element', img: off_image, alt: '', widths: '600, 900, 1280, 1600, 2000, 2400, 3000', sizes: '100vw', classes: 'hero__image', ariaHidden: true -%}
          </div>
        {%- endif -%}
        {%- if off_image_mobile != blank -%}
          <div class="ss-sale-hero__img ss-sale-hero__img--mobile">
            {%- render 'image-element', img: off_image_mobile, alt: '', widths: '400, 600, 800, 1000, 1200', sizes: '100vw', classes: 'hero__image', ariaHidden: true -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="ss-anchor-hero__overlay" aria-hidden="true"></div>

    {{ countdown_blocks }}

    <div class="ss-anchor-hero__inner hero__text-wrap">
      <div class="ss-anchor-hero__content hero__text-content">
        {%- if section.settings.show_breadcrumb and crumb_label != blank -%}
          <nav class="ss-anchor-hero__crumbs" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ crumb_label | escape }}</span>
          </nav>
        {%- endif -%}

        <div class="ss-sale-only">
          {%- if section.settings.heading != blank -%}
            <h1 class="h1 hero__title ss-anchor-hero__title">{{ section.settings.heading | escape }}</h1>
          {%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}
          <div class="hero__subtitle ss-anchor-hero__text rte ss-sale-only">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="hero__link ss-sale-only">
            <a class="btn ss-anchor-btn" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}

        <div class="ss-off-only">
          {%- if section.settings.off_heading != blank -%}
            <h1 class="h1 hero__title ss-anchor-hero__title">{{ section.settings.off_heading | escape }}</h1>
          {%- endif -%}
        </div>
        {%- if section.settings.off_text != blank -%}
          <div class="hero__subtitle ss-anchor-hero__text rte ss-off-only">{{ section.settings.off_text }}</div>
        {%- endif -%}
        {%- if section.settings.off_button_label != blank -%}
          <div class="hero__link ss-off-only">
            <a class="btn ss-anchor-btn" href="{{ section.settings.off_button_link | default: '#early-access' }}">{{ section.settings.off_button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('SsSaleHero-{{ section.id }}');
    if (!root) return;
    var html = document.documentElement;
    var mode = root.getAttribute('data-mode');
    var start = Date.parse(root.getAttribute('data-start'));
    var end = Date.parse(root.getAttribute('data-end'));
    var timers = root.querySelectorAll('[data-ss-countdown]');

    function saleOn(now) {
      if (mode === 'sale') return true;
      if (mode === 'off') return false;
      if (isNaN(end)) return false;
      return (isNaN(start) || now >= start) && now < end;
    }

    function pad(n) { return n < 10 ? '0' + n : String(n); }

    function paintTimer(el, now, on) {
      var target = null;
      var label = '';
      if (on && !isNaN(end) && now < end) {
        target = end;
        label = el.getAttribute('data-label-during');
      } else if (!on && !isNaN(start) && now < start && el.getAttribute('data-show-before') === 'true') {
        target = start;
        label = el.getAttribute('data-label-before');
      }
      if (target === null) {
        el.hidden = true;
        return;
      }
      var left = Math.max(0, Math.floor((target - now) / 1000));
      el.querySelector('[data-unit="d"]').textContent = pad(Math.floor(left / 86400));
      el.querySelector('[data-unit="h"]').textContent = pad(Math.floor((left % 86400) / 3600));
      el.querySelector('[data-unit="m"]').textContent = pad(Math.floor((left % 3600) / 60));
      el.querySelector('[data-unit="s"]').textContent = pad(left % 60);
      el.querySelector('[data-ss-countdown-label]').textContent = label;
      el.hidden = false;
    }

    function tick() {
      var now = Date.now();
      var on = saleOn(now);
      html.classList.toggle('ss-sale--on', on);
      html.classList.toggle('ss-sale--off', !on);
      for (var i = 0; i < timers.length; i++) paintTimer(timers[i], now, on);
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>

{%- if sale_start != blank and sale_end != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SaleEvent",
      "name": {{ section.settings.heading | default: page.title | json }},
      "url": {{ canonical_url | json }},
      "startDate": {{ sale_start | json }},
      "endDate": {{ sale_end | json }},
      "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": { "@type": "VirtualLocation", "url": {{ canonical_url | json }} },
      "organizer": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SS Sale Banner",
  "tag": "section",
  "class": "ss-anchor-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Sale schedule"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Page mode",
      "info": "Automatic switches on the dates below. Force a version to edit it here.",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Automatic (use dates)" },
        { "value": "sale", "label": "Always show Sale version" },
        { "value": "off", "label": "Always show Off-season version" }
      ]
    },
    {
      "type": "text",
      "id": "sale_start",
      "label": "Sale starts (Eastern time)",
      "info": "Format: 2026-11-27 00:00",
      "default": "2026-11-27 00:00"
    },
    {
      "type": "text",
      "id": "sale_end",
      "label": "Sale ends (Eastern time)",
      "info": "Format: 2026-11-30 23:59",
      "default": "2026-11-30 23:59"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Sale banner image",
      "info": "Desktop. 2400 x 1000px or wider works best."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Sale banner image, mobile",
      "info": "Optional. Square or 4:5 works best."
    },
    {
      "type": "image_picker",
      "id": "off_image",
      "label": "Off-season banner image",
      "info": "Optional. Empty = the sale banner image."
    },
    {
      "type": "image_picker",
      "id": "off_image_mobile",
      "label": "Off-season banner image, mobile",
      "info": "Optional. Empty = the sale mobile image."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height, mobile",
      "min": 240,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction",
      "default": "right",
      "options": [
        { "value": "right", "label": "Dark on the left" },
        { "value": "left", "label": "Dark on the right" },
        { "value": "top", "label": "Dark at the bottom" },
        { "value": "bottom", "label": "Dark at the top" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_label",
      "label": "Breadcrumb page name",
      "info": "Empty = the page title."
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Heading case",
      "default": "sentence",
      "options": [
        { "value": "sentence", "label": "Sentence case" },
        { "value": "uppercase", "label": "UPPERCASE" }
      ]
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Sale version text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H1)",
      "default": "Black Friday & Cyber Monday Sale: 15% Off Everything"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = homepage."
    },
    {
      "type": "header",
      "content": "Off-season version text"
    },
    {
      "type": "text",
      "id": "off_heading",
      "label": "Heading (H1)",
      "default": "NuWatt Lighting Sale"
    },
    {
      "type": "richtext",
      "id": "off_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "off_button_label",
      "label": "Button label",
      "default": "Get Early Access"
    },
    {
      "type": "url",
      "id": "off_button_link",
      "label": "Button link",
      "info": "Empty = the sign-up form on this page."
    },
    {
      "type": "header",
      "content": "Countdown colours"
    },
    {
      "type": "color",
      "id": "countdown_bg",
      "label": "Countdown background",
      "default": "#FCC833"
    },
    {
      "type": "color",
      "id": "countdown_text",
      "label": "Countdown text",
      "default": "#1F1F1F"
    }
  ],
  "blocks": [
    {
      "type": "countdown",
      "name": "Countdown timer",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Counts down to the sale end date while the sale runs. Hidden once the sale ends."
        },
        {
          "type": "select",
          "id": "position",
          "label": "Position on the banner (desktop)",
          "info": "On phones it is a strip across the top of the banner.",
          "default": "top-right",
          "options": [
            { "value": "top-right", "label": "Top right" },
            { "value": "top-left", "label": "Top left" },
            { "value": "bottom-right", "label": "Bottom right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom centre" }
          ]
        },
        {
          "type": "text",
          "id": "label_during",
          "label": "Label during the sale",
          "default": "Sale ends in"
        },
        {
          "type": "checkbox",
          "id": "show_before",
          "label": "Also count down to the start before the sale",
          "default": false
        },
        {
          "type": "text",
          "id": "label_before",
          "label": "Label before the sale",
          "default": "Sale starts in"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS Sale Banner",
      "blocks": [{ "type": "countdown" }]
    }
  ]
}
{% endschema %}
