{% comment %}
  Stamped reviews page (task #151, AC comment #50: "all reviews modules should be run
  through Stamped now"). Replaces the Junip "Reviews" app block on page.reviews.
  Store-wide full-page widget; StampedFn.init is loaded in layout/theme.liquid.
{% endcomment %}

<div class="stamped-reviews-page page-width">
  {%- if section.settings.title != blank -%}
    <div class="section-header text-center">
      <h1 class="section-header__title">{{ section.settings.title | escape }}</h1>
    </div>
  {%- endif -%}
  <div id="stamped-reviews-widget" data-widget-type="full-page"></div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .stamped-reviews-page {
    padding-top: 40px;
    padding-bottom: 60px;
  }
  #shopify-section-{{ section.id }} .section-header__title,
  #shopify-section-{{ section.id }} #stamped-reviews-widget,
  #shopify-section-{{ section.id }} #stamped-reviews-widget * {
    font-family: var(--typeBasePrimary), var(--typeBaseFallback) !important;
  }
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .stamped-reviews-page {
      padding-top: 24px;
      padding-bottom: 40px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Stamped reviews page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Customer Reviews"
    }
  ],
  "presets": [
    {
      "name": "Stamped reviews page"
    }
  ]
}
{% endschema %}
