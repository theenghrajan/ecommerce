{% comment %}
  Our Glowing Reviews (task #151, AC comment #53): hand-picked Stamped.io reviews in a
  carousel, styled after the Dr. Squatch home page reviews (headline, centred cards on a
  brand-colour backing, progress bar and arrows underneath).
  Reviews are fetched from Stamped's public widget API by review ID (same public key the
  Stamped widgets use in layout/theme.liquid), so they stay in sync with Stamped.
  Review IDs: comma-separated, in display order (Stamped admin > Reviews, or the API).
{% endcomment %}

{%- assign review_ids = section.settings.review_ids | remove: ' ' -%}

<div class="glowing-reviews" data-review-ids="{{ review_ids }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="glowing-reviews__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="glowing-reviews__track" role="list" aria-label="{{ section.settings.heading | escape }}" tabindex="0"></div>

    <div class="glowing-reviews__controls" hidden>
      <div class="glowing-reviews__progress" aria-hidden="true"><span></span></div>
      <div class="glowing-reviews__arrows">
        <button type="button" class="glowing-reviews__arrow" data-dir="-1" aria-label="Previous reviews">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M18 11H4M9.5 5.5 4 11l5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="glowing-reviews__arrow" data-dir="1" aria-label="Next reviews">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M4 11h14M12.5 5.5 18 11l-5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="glowing-reviews__footer">
        <a href="{{ section.settings.button_link | default: '/pages/reviews' }}" class="glowing-reviews__button">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} .glowing-reviews');
    if (!root) return;
    var ids = (root.dataset.reviewIds || '').split(',').filter(Boolean);
    var track = root.querySelector('.glowing-reviews__track');
    var controls = root.querySelector('.glowing-reviews__controls');
    var bar = root.querySelector('.glowing-reviews__progress span');
    if (!ids.length) return;

    var url = 'https://stamped.io/api/widget/reviews?storeUrl=363503&apiKey=31f05899-3dc3-476c-91b8-375386ad6cfc&take=' + ids.length +
      ids.map(function (id) { return '&reviewIds=' + encodeURIComponent(id); }).join('');

    var star = '<svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.8z" fill="currentColor"/></svg>';

    function text(s) {
      var d = document.createElement('div');
      d.textContent = s || '';
      return d.innerHTML;
    }

    function render(reviews) {
      // keep the order the IDs were entered in
      var byId = {};
      reviews.forEach(function (r) { byId[String(r.id)] = r; });
      var html = ids.map(function (id) {
        var r = byId[id];
        if (!r) return '';
        var stars = '';
        for (var i = 0; i < 5; i++) stars += star;
        return '<figure class="glowing-reviews__card" role="listitem">' +
          '<div class="glowing-reviews__stars" role="img" aria-label="' + r.reviewRating + ' out of 5 stars">' + stars + '</div>' +
          '<p class="glowing-reviews__title">' + text(r.reviewTitle) + '</p>' +
          '<blockquote class="glowing-reviews__body">' + text(r.reviewMessage) + '</blockquote>' +
          '<figcaption class="glowing-reviews__author">' + text(r.author) + '</figcaption>' +
          '</figure>';
      }).join('');
      if (!html) return;
      track.innerHTML = html;
      controls.hidden = false;
      update();
    }

    function step() {
      var card = track.querySelector('.glowing-reviews__card');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      // +2px: card widths are fractional, so 3 cards can measure as 2.99
      var perView = Math.max(1, Math.floor((track.clientWidth + gap + 2) / (card.offsetWidth + gap)));
      return perView * (card.offsetWidth + gap);
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth;
      var visible = track.scrollWidth ? track.clientWidth / track.scrollWidth : 1;
      var pos = max > 0 ? track.scrollLeft / max : 0;
      bar.style.width = Math.max(visible, 0.1) * 100 + '%';
      bar.style.transform = 'translateX(' + (pos * (1 / Math.max(visible, 0.1) - 1) * 100) + '%)';
      root.querySelectorAll('.glowing-reviews__arrow').forEach(function (b) {
        b.disabled = b.dataset.dir === '-1' ? track.scrollLeft <= 2 : track.scrollLeft >= max - 2;
      });
    }

    root.querySelectorAll('.glowing-reviews__arrow').forEach(function (b) {
      b.addEventListener('click', function () {
        track.scrollBy({ left: step() * Number(b.dataset.dir), behavior: 'smooth' });
      });
    });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update);

    fetch(url)
      .then(function (r) { return r.ok ? r.json() : { data: [] }; })
      .then(function (d) { render(d.data || []); })
      .catch(function () {});
  })();
</script>

{% style %}
  #shopify-section-{{ section.id }} .glowing-reviews {
    padding: 64px 0;
    background: #ffffff;
  }
  #shopify-section-{{ section.id }} .glowing-reviews .page-width {
    max-width: 1900px;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__heading {
    margin: 0 0 32px;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
    text-align: center;
    text-transform: none;
    color: #202020;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 48px) / 3);
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    min-height: 240px;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__track::-webkit-scrollbar {
    display: none;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 32px 28px;
    border-radius: 12px;
    background: #fcc833;
    color: #202020;
    text-align: center;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
  }
  #shopify-section-{{ section.id }} .glowing-reviews__stars {
    display: flex;
    gap: 3px;
    color: #202020;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__title {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__body {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 15px;
    font-style: normal;
    line-height: 1.6;
    color: #202020;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__body::before,
  #shopify-section-{{ section.id }} .glowing-reviews__body::after {
    content: none;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__author {
    margin-top: auto;
    font-size: 15px;
    font-style: italic;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__controls {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__controls[hidden] {
    display: none;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__progress {
    position: relative;
    flex: 1 1 auto;
    height: 3px;
    overflow: hidden;
    background: #e2e6ec;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__progress span {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: #202020;
    transition: transform 0.2s ease;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__arrows {
    display: flex;
    gap: 4px;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: #202020;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  @media (hover: hover) {
    #shopify-section-{{ section.id }} .glowing-reviews__arrow:not(:disabled):hover {
      background: #f4f4f4;
    }
  }
  #shopify-section-{{ section.id }} .glowing-reviews__footer {
    margin-top: 28px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .glowing-reviews__button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 28px;
    border-radius: 6px;
    background: #202020;
    color: #ffffff;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .glowing-reviews__track {
      grid-auto-columns: calc((100% - 16px) / 2);
      gap: 16px;
    }
  }
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .glowing-reviews {
      padding: 40px 0;
    }
    #shopify-section-{{ section.id }} .glowing-reviews__heading {
      margin-bottom: 20px;
      font-size: 28px;
    }
    /* one card plus a peek of the next, so it reads as swipeable */
    #shopify-section-{{ section.id }} .glowing-reviews__track {
      grid-auto-columns: 85%;
      gap: 12px;
    }
    #shopify-section-{{ section.id }} .glowing-reviews__card {
      padding: 24px 20px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Glowing reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Glowing Reviews"
    },
    {
      "type": "textarea",
      "id": "review_ids",
      "label": "Stamped review IDs",
      "info": "Comma-separated, in display order. 5 to 8 works best."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read All Reviews"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Glowing reviews"
    }
  ]
}
{% endschema %}
