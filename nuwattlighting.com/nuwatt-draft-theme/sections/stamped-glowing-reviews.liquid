{% comment %}
  Our Glowing Reviews (task #151, AC comment #53), full-width section. Markup, styles and script
  live in snippets/glowing-reviews.liquid, shared with the Why NuWatt reviews column (#77).
  Review IDs: comma-separated, in display order (Stamped admin > Reviews, or the API).
{% endcomment %}

{% render 'glowing-reviews',
  section_id: section.id,
  review_ids: section.settings.review_ids,
  heading: section.settings.heading,
  button_label: section.settings.button_label,
  button_link: section.settings.button_link,
  layout: 'full'
%}

{% schema %}
{
  "name": "Glowing reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Glowing Reviews"
    },
    {
      "type": "textarea",
      "id": "review_ids",
      "label": "Stamped review IDs",
      "info": "Comma-separated, in display order. 5 to 8 works best."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read All Reviews"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Glowing reviews"
    }
  ]
}
{% endschema %}
