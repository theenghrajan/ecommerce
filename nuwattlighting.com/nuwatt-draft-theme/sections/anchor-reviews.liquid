{% comment %}
  Anchor page — reviews
  Figma: "128 Audit Fixes" / Anchor page — Section - Reviews (node 9172:122)

  Static, merchant-entered quotes. If you run a reviews app, replace the block
  loop with its widget — the surrounding band styling still applies.
{% endcomment %}

{%- render 'anchor-head' -%}

<div
  class="anchor-section anchor-reviews"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="anchor-inner anchor-inner--wide">
    {%- if section.settings.heading != blank -%}
      <h2 class="anchor-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="anchor-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="anchor-review" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div
              class="anchor-review__stars"
              role="img"
              aria-label="{{ block.settings.rating }} out of 5 stars"
            >
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  {%- render 'anchor-icon', icon: 'star' -%}
                {%- else -%}
                  {%- render 'anchor-icon', icon: 'star', classes: 'is-empty' -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.quote != blank -%}
            <p class="anchor-review__quote">{{ block.settings.quote | escape }}</p>
          {%- endif -%}

          {%- if block.settings.author != blank or block.settings.role != blank -%}
            <div>
              {%- if block.settings.author != blank -%}
                <p class="anchor-review__author">{{ block.settings.author | escape }}</p>
              {%- endif -%}
              {%- if block.settings.role != blank -%}
                <p class="anchor-review__role">{{ block.settings.role | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Anchor: Reviews",
  "tag": "section",
  "class": "anchor-section-wrapper",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Customers are Saying"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote",
          "default": "\"Top quality lights and amazing customer service!\""
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "David R."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Subtitle",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anchor: Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "\"Top quality lights and amazing customer service!\"",
            "author": "David R."
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "\"Easy to install and the brightness is perfect.\"",
            "author": "Emily T."
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "\"Fast shipping and excellent products.\"",
            "author": "James L."
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "\"Top quality lights and amazing customer service!\"",
            "author": "David R."
          }
        }
      ]
    }
  ]
}
{% endschema %}
