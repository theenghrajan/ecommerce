function loadTabContent(handle, contentBox) {
  contentBox.innerHTML = '<span class="loader"></span>';

  fetch(`${handle}`)
    .then(response => response.text())
    .then(data => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(data, 'text/html');
      const mainContent = doc.querySelector('.main-content');

      if (mainContent) {
        contentBox.innerHTML = mainContent.innerHTML;
      } else {
        contentBox.innerHTML = '<p>Content not found.</p>';
      }
    })
    .catch(error => {
      contentBox.innerHTML = '<p>Error loading content.</p>';
      console.error(error);
    });
}

document.addEventListener("DOMContentLoaded", function () {
  const tabButtons = document.querySelectorAll(".tab-btn");
  const contentBox = document.getElementById("tab-content-box");

  // Click listener
  tabButtons.forEach(button => {
    button.addEventListener("click", function () {
      const handle = this.getAttribute("data-handle");

      // active class
      tabButtons.forEach(btn => btn.classList.remove("active"));
      this.classList.add("active");

      // ✅ Update URL parameter without reload
      const url = new URL(window.location);
      url.searchParams.set("page", handle);
      window.history.pushState({}, "", url);

      loadTabContent(handle, contentBox);
    });
  });

  // ✅ Load based on URL param first
  const params = new URLSearchParams(window.location.search);
  const search = params.get("page");

  if (search) {
    const matchedTab = Array.from(tabButtons).find(tab =>
      (tab.getAttribute("data-handle") || "")
        .toLowerCase()
        .includes(search.toLowerCase())
    );

    if (matchedTab) {
      matchedTab.classList.add("active");
      matchedTab.click();
      return;
    }
  }

  // ✅ Load first tab if no param
  if (tabButtons.length > 0) {
    const firstTab = tabButtons[0];
    firstTab.classList.add("active");
    loadTabContent(firstTab.getAttribute("data-handle"), contentBox);
  }
});


</script>
