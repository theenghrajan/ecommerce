{% comment %}
  Frequently Bought Together — Figma "128 Audit Fixes" Product Page (node 9211:7),
  "Section Cross Sells" region.

  Modeled directly on sections/product-recommendations.liquid (the theme's existing
  "You may also like" section) rather than snippets/product-complementary.liquid,
  because that snippet hardcodes type: 'horizontal' cards for its block-based usage
  elsewhere in the theme (main-product.liquid's complementary_products block) —
  changing that default would affect those other callers. This section instead
  reuses the exact same <product-recommendations> web component + Shopify Product
  Recommendations API pattern, just with data-intent="complementary" (Shopify's
  native "frequently bought together" recommendation intent) instead of "related",
  and renders snippets/product-grid-item.liquid in its normal default (vertical)
  card mode — unmodified — as a static 4-up grid instead of product-recommendations'
  scrollable one, matching the Figma reference. The "Add to Cart" button on each
  card is the theme's own existing quick-add button (settings.quick_add_enable),
  already on site-wide — no new button/markup was built for it.

  Precedence: Shopify's Product Recommendations API ("complementary" intent) needs
  either manually curated recommendations or real order history to return anything
  — on a dev store with neither, it comes back empty. section.settings.collection
  gives a merchant a reliable manual override: when a collection is picked, this
  section lists that collection's products directly (static, no AJAX call, always
  populated) and the automatic recommendations are skipped entirely. Leave the
  setting blank to use the automatic recommendations as before.
{% endcomment %}

{%- liquid
  assign number_of_products = section.settings.complementary_count

  capture gridView
    render 'products_per_row', products_per_row: section.settings.products_per_row
  endcapture
-%}

{%- if section.settings.collection != blank -%}
  <div
    data-section-id="{{ product.id }}"
    data-subsection
    data-section-type="collection-template"
    class="index-section index-section--sub-product">
    <div class="page-width">
      <header class="section-header">
        <div class="h3 section-header__title">
          {{ section.settings.heading }}
        </div>
      </header>
    </div>

    <div class="page-width page-width--flush-small">
      <div class="product-recommendations page-width">
        <div class="new-grid product-grid pdp-fbt-grid" data-view="{{ gridView }}">
          {%- assign fbt_count = 0 -%}
          {%- for collection_product in section.settings.collection.products -%}
            {%- if collection_product.id == product.id -%}{%- continue -%}{%- endif -%}
            {%- if fbt_count >= number_of_products -%}{%- break -%}{%- endif -%}
            {%- assign fbt_count = fbt_count | plus: 1 -%}
            {%- render 'product-grid-item', product: collection_product, sizeVariable: section.settings.products_per_row, fallback: '45vw' -%}
          {%- endfor -%}
        </div>

        {%- liquid
          if settings.quick_shop_enable
            assign fbt_count = 0
            for collection_product in section.settings.collection.products
              if collection_product.id == product.id
                continue
              endif
              if fbt_count >= number_of_products
                break
              endif
              assign fbt_count = fbt_count | plus: 1
              render 'quick-shop-modal', product: collection_product
            endfor
          endif
        -%}
      </div>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign recommend_products = true
    if recommendations.products and recommendations.products_count > 0
      assign related_collection = recommendations
    endif
  -%}
  <product-recommendations
    id="Recommendations-{{ section.id }}"
    class="recommendations-{{ section.id }}"
    data-section-id="{{ section.id }}"
    data-section-type="product-recommendations"
    data-enable="{{ recommend_products }}"
    data-product-id="{{ product.id }}"
    data-intent="complementary"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ number_of_products }}&intent=complementary"
    data-limit="{{ number_of_products }}">

    <div
      data-section-id="{{ product.id }}"
      data-subsection
      data-section-type="collection-template"
      class="index-section index-section--sub-product">
      <div class="page-width">
        <header class="section-header">
          <div class="h3 section-header__title">
            {{ section.settings.heading }}
          </div>
        </header>
      </div>

      <div class="page-width page-width--flush-small">
        {%- if recommend_products -%}
          <div class="product-recommendations-placeholder">
            {% comment %}
              This content is visually hidden and replaced when recommended
              products show up
            {% endcomment %}
            <div class="new-grid product-grid pdp-fbt-grid visually-invisible" aria-hidden="true" data-view="grid">
              {%- render 'product-grid-item', product: product -%}
            </div>
          </div>
        {%- endif -%}
        {%- if related_collection.products_count > 0 -%}
          <div class="product-recommendations page-width">
            <div class="new-grid product-grid pdp-fbt-grid" data-view="{{ gridView }}">
              {%- for product in related_collection.products limit: number_of_products -%}
                {%- render 'product-grid-item', product: product, sizeVariable: section.settings.products_per_row, fallback: '45vw' -%}
              {%- endfor -%}
            </div>

            {%- liquid
              if settings.quick_shop_enable
                for product in related_collection.products limit: number_of_products
                  render 'quick-shop-modal', product: product
                endfor
              endif
            -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </product-recommendations>
{%- endif -%}

{% schema %}
{
  "name": "PDP Frequently Bought",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (optional)",
      "info": "Lists this collection's products directly and skips the automatic recommendations. Leave blank to use Shopify's automatic \"complementary\" product recommendations instead."
    },
    {
      "type": "range",
      "id": "complementary_count",
      "label": "Number of products",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "default": 4,
      "min": 2,
      "max": 5,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "PDP Frequently Bought"
    }
  ]
}
{% endschema %}
