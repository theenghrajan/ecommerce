{% comment %}
  SS Anchor Reviews
  Figma: "128 Audit Fixes" / Anchor page — Section - Reviews (node 9172:122)

  Stamped.io reviews carousel (AC 490502 #61: "Our reviews are now being
  handled by Stamped.io ... show reviews only for relevant products").
  Was a copy of sections/testimonials.liquid with static review blocks.

  Which reviews show:
    - Collections: reviews of products in these collections (first 50
      products of each, in the collection's own sort order).
    - Products: extra individual products to include.
    - Review IDs: optional - show only these hand-picked Stamped reviews.
    - Minimum rating / number of reviews.
  The Stamped script (StampedFn.init) is loaded from layout/theme.liquid, same
  as on the live theme. Widget attributes are read by Stamped's widget.min.js
  (data-widget-type="carousel", data-product-ids, data-review-ids, data-take,
  data-min-rating, data-fill-empty).
  ponytail: 50 products per collection (Liquid loop cap) - use the Products
  setting for anything beyond that.
{% endcomment %}

{{ 'ss-anchor.css' | asset_url | stylesheet_tag }}
{%- render 'ss-anchor-case', id: section.id, mode: section.settings.text_case -%}
{%- render 'ss-anchor-space', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom -%}

{%- liquid
  assign product_ids = ''
  for col in section.settings.collections
    for p in col.products limit: 50
      assign product_ids = product_ids | append: p.id | append: ','
    endfor
  endfor
  for p in section.settings.products
    assign product_ids = product_ids | append: p.id | append: ','
  endfor
  assign product_ids = product_ids | split: ',' | uniq | join: ','
  assign review_ids = section.settings.review_ids | remove: ' '
-%}

<div
  class="testimonials-section ss-anchor-reviews testimonials-{{ section.id }} text-{{ section.settings.align_text }} color-scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}">
  {%- if section.settings.color_scheme != 'none' -%}
    {%- render 'color-scheme-texture', color_scheme: section.settings.color_scheme -%}
  {%- endif -%}

  <div class="page-width ss-anchor-inner ss-anchor-reviews__inner">
    {%- if section.settings.title != blank -%}
      <div class="section-header">
        <h2>{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}

    {%- if product_ids != blank or review_ids != blank -%}
      <div
        id="stamped-reviews-widget"
        data-widget-type="carousel"
        data-title=""
        {% if product_ids != blank %}data-product-ids="{{ product_ids }}"{% endif %}
        {% if review_ids != blank %}data-review-ids="{{ review_ids }}"{% endif %}
        data-take="{{ section.settings.take }}"
        data-min-rating="{{ section.settings.min_rating }}"
        data-fill-empty="false"
        data-random="false"
        data-show-avatar="true"></div>
    {%- elsif request.design_mode -%}
      <p class="ss-anchor-empty">Choose collections, products or review IDs to show Stamped reviews.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SS Anchor Reviews",
  "class": "ss-anchor-section-wrapper ss-anchor-reviews",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Heading case",
      "info": "Overrides the theme-wide uppercase heading setting for this section only.",
      "default": "sentence",
      "options": [
        { "value": "sentence", "label": "Sentence case" },
        { "value": "uppercase", "label": "UPPERCASE" }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Customers are Saying"
    },
    {
      "type": "select",
      "id": "align_text",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.testimonials.settings.color_scheme.label",
      "default": "none",
      "options": [
        { "value": "none", "label": "t:sections.testimonials.settings.color_scheme.options.none.label" },
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "header",
      "content": "Stamped reviews"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "info": "Shows reviews of products in these collections (first 50 products of each).",
      "limit": 8
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Extra products",
      "limit": 50
    },
    {
      "type": "text",
      "id": "review_ids",
      "label": "Review IDs (optional)",
      "info": "Comma-separated Stamped review IDs to show only those reviews."
    },
    {
      "type": "range",
      "id": "min_rating",
      "label": "Minimum star rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "take",
      "label": "Number of reviews",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "SS Anchor Reviews"
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
