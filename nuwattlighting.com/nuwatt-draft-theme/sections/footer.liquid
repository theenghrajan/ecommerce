      ]
    },
    {
      "type": "contact",
      "name": "t:sections.footer.blocks.contact_and_social.name",
      "settings": [
        {
          "type": "header",
          "content": "t:sections.footer.blocks.contact_and_social.settings.header_contact"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "t:sections.footer.blocks.contact_and_social.settings.phone.label"
        },
        {
          "type": "text",
          "id": "contact_title",
          "label": "Contact title"
        },
        {
