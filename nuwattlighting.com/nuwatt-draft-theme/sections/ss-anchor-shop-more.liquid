{% comment %}
  SS Anchor Shop More
  Figma: "128 Audit Fixes" / Anchor page — Section - Shop More (node 9172:552)

  A TRIMMED COPY of sections/promo-grid.liquid's "advanced" block path,
  prefixed ss-. promo-grid.liquid is left untouched (it is currently used by
  0 templates, but it stays available).

  Trimmed deliberately: promo-grid is a 1078-line mosaic builder with six block
  types (advanced, banner, image, product, sale_collection, simple) and its own
  width/height sizing model. The design here is a plain 3-up card row, so only
  the "advanced" content shape is kept — image, heading, text, one CTA — and
  the mosaic sizing is replaced with the Figma grid.

  Added over the source: per-card overlay opacity, which promo-grid handles via
  colour schemes and image masks rather than a direct control.

  Layout from Figma: heading, 24px gap, 3-up grid at 24px gaps,
  cards 357x256 with text over the image.
{% endcomment %}

{{ 'ss-anchor.css' | asset_url | stylesheet_tag }}
{%- render 'ss-anchor-case', id: section.id, mode: section.settings.text_case -%}
{%- render 'ss-anchor-space', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --ss-card-radius: {{ section.settings.card_radius }}px;
  }
{%- endstyle -%}

<div
  id="SsAnchorShopMore-{{ section.id }}"
  class="ss-anchor-section ss-anchor-shopmore"
  data-section-id="{{ section.id }}"
  data-section-type="ss-anchor-shop-more"
>
  <div class="ss-anchor-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ss-anchor-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="ss-anchor-shopmore__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign overlay = block.settings.overlay | divided_by: 100.0
          assign overlay_mid = overlay | times: 0.5
          assign href = block.settings.link
          if href == blank and block.settings.collection != blank
            assign href = block.settings.collection.url
          endif

          assign img = block.settings.image
          if img == blank and block.settings.collection != blank
            assign img = block.settings.collection.featured_image
          endif
        -%}

        {%- capture card_body -%}
          {%- if img != blank -%}
            <div class="ss-anchor-shopmore__media">
              {%- render 'image-element',
                img: img,
                alt: '',
                widths: '400, 600, 800',
                sizes: '(min-width: 1025px) 357px, 100vw',
                ariaHidden: true
              -%}
            </div>
          {%- else -%}
            <div class="ss-anchor-shopmore__media">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="ss-anchor-shopmore__overlay" style="background: linear-gradient(0deg, rgba(0, 0, 0, {{ overlay }}) 0%, rgba(0, 0, 0, {{ overlay_mid }}) 26%, rgba(0, 0, 0, 0) 58%);" aria-hidden="true"></div>

          <div class="ss-anchor-shopmore__body">
            {%- if block.settings.title != blank -%}
              <h3 class="ss-anchor-shopmore__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="ss-anchor-shopmore__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <span class="ss-anchor-link ss-anchor-link--accent">
                {{ block.settings.link_label | escape }}
                {%- render 'ss-anchor-icon', icon: 'arrow' -%}
              </span>
            {%- endif -%}
          </div>
        {%- endcapture -%}

        {%- comment -%}
          <a> only when there is somewhere to go — an <a> with no href is not
          focusable and misreports itself to assistive tech.
        {%- endcomment -%}
        {%- if href != blank -%}
          <a class="ss-anchor-shopmore__card" href="{{ href }}" {{ block.shopify_attributes }}>{{ card_body }}</a>
        {%- else -%}
          <div class="ss-anchor-shopmore__card" {{ block.shopify_attributes }}>{{ card_body }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SS Anchor Shop More",
  "tag": "section",
  "class": "ss-anchor-section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop More Lighting"
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Heading case",
      "info": "Overrides the theme-wide uppercase heading setting for this section only.",
      "default": "sentence",
      "options": [
        { "value": "sentence", "label": "Sentence case" },
        { "value": "uppercase", "label": "UPPERCASE" }
      ]
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "info": "Overrides the theme default. The design uses 8px.",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Optional. Supplies the image and link when they are left blank."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the collection image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Recessed Lights"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Clean, modern and perfect for any bedroom."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Overrides the collection link."
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Image overlay",
          "min": 0,
          "max": 90,
          "step": 2,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS Anchor Shop More",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
