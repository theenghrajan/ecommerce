{% comment %}
  Anchor page — shop more
  Figma: "128 Audit Fixes" / Anchor page — Section - Shop More (node 9172:552)

  Each block can point at a collection (image, title and URL are read from it)
  or be filled in by hand.
{% endcomment %}

{%- render 'anchor-head' -%}

<div
  class="anchor-section anchor-shopmore"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="anchor-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="anchor-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="anchor-shopmore__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign linked_collection = block.settings.collection
          assign card_title = block.settings.title
          assign card_image = block.settings.image
          assign card_url = block.settings.link

          if linked_collection != blank
            if card_title == blank
              assign card_title = linked_collection.title
            endif
            if card_image == blank and linked_collection.featured_image != blank
              assign card_image = linked_collection.featured_image
            endif
            if card_url == blank
              assign card_url = linked_collection.url
            endif
          endif

          assign card_overlay = block.settings.overlay | divided_by: 100.0
        -%}

        <a
          class="anchor-shopmore__card"
          {% if card_url != blank %}href="{{ card_url }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if card_image != blank -%}
            <span class="anchor-shopmore__media">
              {%- render 'image-element',
                img: card_image,
                alt: '',
                widths: '400, 600, 900',
                sizes: '(min-width: 769px) 33vw, 100vw',
                ariaHidden: true
              -%}
            </span>
          {%- endif -%}

          <span
            class="anchor-shopmore__overlay"
            style="background-color: rgba(0, 0, 0, {{ card_overlay }});"
          ></span>

          <span class="anchor-shopmore__body">
            {%- if card_title != blank -%}
              <h3 class="anchor-shopmore__title">{{ card_title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="anchor-shopmore__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <span class="anchor-link anchor-link--accent">
                {{ block.settings.link_label | escape }}
                {%- render 'anchor-icon', icon: 'arrow', classes: 'anchor-link__icon' -%}
              </span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Anchor: Shop more",
  "tag": "section",
  "class": "anchor-section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop More Lighting"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Category card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Optional. Fills in the image, title and link from the collection."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the collection image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Overrides the collection title."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Overrides the collection link."
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Image overlay",
          "min": 0,
          "max": 90,
          "step": 2,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anchor: Shop more",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Recessed Lights",
            "text": "Clean, modern and perfect for any bedroom."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Ceiling Lights",
            "text": "Stylish flush mounts and low-profile fixtures."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Wall Lights",
            "text": "Add ambiance and accent with stylish wall fixtures."
          }
        }
      ]
    }
  ]
}
{% endschema %}
