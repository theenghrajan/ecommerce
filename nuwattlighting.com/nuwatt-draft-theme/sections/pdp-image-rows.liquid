{% comment %}
  PDP infographic (below the tabs) + optional video rows. See the comment below for how the image is chosen.
{% endcomment %}

{%- comment -%}
  #150 (Gary, AC #90): ONE infographic instead of the 5 separate image frames. The image keeps its own height (it scales
  to its content), with padding around it. A separate mobile-only image can be set; phones (up to 749px) get that image,
  everything wider gets the desktop image.
  Source, first match wins:
  1. product.metafields.custom.infographic_desktop / custom.infographic_mobile (per product, file/image)
  2. this section's "Default desktop / mobile infographic" settings (same image for every product on the template)
  Nothing set -> no infographic. Video blocks (a real uploaded video) still render below it.
{%- endcomment -%}
{%- liquid
  assign ig_desktop = product.metafields.custom.infographic_desktop.value
  assign ig_mobile = product.metafields.custom.infographic_mobile.value
  if ig_desktop == blank and ig_mobile == blank
    assign ig_desktop = section.settings.desktop_image
    assign ig_mobile = section.settings.mobile_image
  endif
  assign ig_alt = product.title | escape
-%}

<div class="pdp-image-rows">
  {%- if ig_desktop != blank or ig_mobile != blank -%}
    {%- comment -%} AC #109: same .page-width wrapper as every other block, so the edges line up {%- endcomment -%}
    <div class="page-width">
    <div class="pdp-infographic{% if ig_desktop == blank %} pdp-infographic--mobile-only{% elsif ig_mobile == blank %} pdp-infographic--single{% endif %}">
      <picture>
        {%- if ig_mobile != blank and ig_desktop != blank -%}
          {%- comment -%} only offer widths the uploaded image really has (a 600px-wide file must not be listed as 750/1100/1500w) {%- endcomment -%}
          {%- capture ig_mobile_srcset -%}
            {%- for w in (1..4) -%}
              {%- case w -%}{%- when 1 -%}{%- assign sw = 400 -%}{%- when 2 -%}{%- assign sw = 750 -%}{%- when 3 -%}{%- assign sw = 1100 -%}{%- else -%}{%- assign sw = 1500 -%}{%- endcase -%}
              {%- if sw < ig_mobile.width -%}{{ ig_mobile | image_url: width: sw }} {{ sw }}w, {% endif -%}
            {%- endfor -%}
            {{ ig_mobile | image_url: width: ig_mobile.width }} {{ ig_mobile.width }}w
          {%- endcapture -%}
          <source media="(max-width: 749px)" srcset="{{ ig_mobile_srcset | strip }}"
            sizes="calc(100vw - 34px)" width="{{ ig_mobile.width }}" height="{{ ig_mobile.height }}">
        {%- endif -%}
        {%- assign ig_img = ig_desktop | default: ig_mobile -%}
        {{ ig_img | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '400,750,1100,1500,2000', sizes: '(min-width: 1280px) 1100px, (min-width: 750px) 85vw, calc(100vw - 34px)', alt: ig_alt, class: 'pdp-infographic__img' }}
      </picture>
    </div>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.settings.media_type == 'video' and block.settings.video != blank -%}
      <div class="page-width">
      <div class="pdp-image-rows__row pdp-image-rows__row--video" {{ block.shopify_attributes }}>
        {{ block.settings.video | video_tag: image_size: '1600x', controls: true }}
        {%- if block.settings.caption != blank -%}<p class="pdp-image-rows__caption">{{ block.settings.caption }}</p>{%- endif -%}
      </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "PDP Image Rows",
  "settings": [
    { "type": "paragraph", "content": "One infographic per product: set the product metafields custom.infographic_desktop and custom.infographic_mobile. The images below are only used for products that have neither." },
    { "type": "image_picker", "id": "desktop_image", "label": "Default desktop infographic" },
    { "type": "image_picker", "id": "mobile_image", "label": "Default mobile infographic", "info": "Shown on phones (up to 749px wide)" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Image or Video Row",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Used when Media type is Image. Takes priority over the theme asset filename below if both are set."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename (fallback)",
          "info": "Only used when Media type is Image and no image above is picked — a filename already in this theme's assets/ folder, e.g. pdp-row-1-spec-diagram.png"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Used when Media type is Video"
        },
        {
          "type": "checkbox",
          "id": "show_play_icon",
          "label": "Show a play-icon overlay",
          "info": "For an image row that acts as a video's poster frame until a real video is uploaded",
          "default": false
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Image Rows",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row", "settings": { "media_type": "video" } }
      ]
    }
  ]
}
{% endschema %}
