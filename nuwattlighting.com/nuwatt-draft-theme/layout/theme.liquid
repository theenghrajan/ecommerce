      <script>
document.addEventListener('DOMContentLoaded', () => {
  // Select the fieldset by its ID
  const fieldset = document.querySelector('#ProductSelect-template--16466481348682__main-6915617161290-option-0');

  // Get all `.variant-input` elements within the selected fieldset
  const variantInputs = fieldset.querySelectorAll('.variant-input');

  // Get the current URL's query parameters
  const urlParams = new URLSearchParams(window.location.search);
  const variantId = urlParams.get('variant');

  // Define the variant-to-data-value mapping
  const variantMapping = {
    "15W": ["39922145787978", "39922145820746"],
    "30W": ["39922145853514", "39922145886282"],
    "50W": ["39922145919050", "39922145951818"],
    "90W": ["40593280729162", "40624111747146"]
  };

  // Find the data-value corresponding to the variant ID
  let dataValueToSelect = null;
  for (const [dataValue, variantIds] of Object.entries(variantMapping)) {
    if (variantIds.includes(variantId)) {
      dataValueToSelect = dataValue;
      break;
    }
  }

  // Function to remove 'selected-pdp-option' from all variant inputs within the fieldset
  function clearSelectedClass() {
    variantInputs.forEach(input => input.classList.remove('selected-pdp-option'));
  }

  // Initialize the selected option based on the URL parameter
  if (dataValueToSelect) {
    // Remove the class from all elements to reset the state
    clearSelectedClass();

    // Find the div with the matching data-value and add the class
    const targetDiv = fieldset.querySelector(`.variant-input[data-value="${dataValueToSelect}"]`);
    if (targetDiv) {
      targetDiv.classList.add('selected-pdp-option');
      // Also check the corresponding input
      const inputElement = targetDiv.querySelector('input[type="radio"]');
      if (inputElement) {
        inputElement.checked = true;
      }
    }
  }

  // Add click event listener to each variant input
  variantInputs.forEach(variantInput => {
    variantInput.addEventListener('click', () => {
      // Remove 'selected-pdp-option' from all variant inputs within the fieldset
      clearSelectedClass();

      // Add 'selected-pdp-option' to the clicked variant input
      variantInput.classList.add('selected-pdp-option');

      // Also check the corresponding input
      const inputElement = variantInput.querySelector('input[type="radio"]');
      if (inputElement) {
        inputElement.checked = true;
      }
    });
  });
});


    </script>



