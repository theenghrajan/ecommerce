<script>

          (function() {
    function updateCanonicalTag() {
      try {
        var URL = window.location.href;
        var htmlTag = URL;

        // Check for unwanted query parameters and clean the URL
        if (
          URL.includes("?page=") || 
          URL.includes("&page=") || 
          URL.includes("?sort") || 
          URL.includes("?srsltid=") || 
          URL.includes("?filter") || 
          URL.includes("?_pos") || 
          URL.includes("?pr_prod_strat")
        ) {
          htmlTag = URL.split("?")[0];
        } else if (URL.includes("&currency=USD")) {
          htmlTag = URL.split("&")[0];
        }

        // Find or create the canonical link
        var canonical = document.querySelector('link[rel="canonical"]');
        if (canonical) {
          canonical.href = htmlTag; // Update the href if it exists
        } else {
          canonical = document.createElement("link");
          canonical.rel = "canonical";
          canonical.href = htmlTag;
          document.head.appendChild(canonical); // Append to <head>
        }
      } catch (error) {
        //console.error("Error updating canonical tag:", error);
      }
    }

    // Run immediately and retry if the canonical tag might not yet exist
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateCanonicalTag);
    } else {
      updateCanonicalTag();
    }
  })();  
</script>
















  
