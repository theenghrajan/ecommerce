    <script>

      

document.addEventListener("DOMContentLoaded", (event) => {


document.querySelectorAll('.alt-accordion-toggle').forEach((header, index) => {
    const accordionBody = header.nextElementSibling;

    // Automatically open the first accordion section
    if (index === 0) {
        header.classList.add('alt-active');
        accordionBody.style.maxHeight = "max-content";
        accordionBody.style.padding = '12px 22px';
    }

    header.addEventListener('click', () => {
        const isAltActive = header.classList.contains('alt-active');

        // Close any open accordion section before opening the new one
        document.querySelectorAll('.alt-accordion-toggle').forEach((h, i) => {
            if (i !== index && h.classList.contains('alt-active')) {
                h.classList.remove('alt-active');
                h.nextElementSibling.style.maxHeight = '0';
                h.nextElementSibling.style.padding = '0 22px';
            }
        });

        // Toggle the current accordion section
        if (isAltActive) {
            header.classList.remove('alt-active');
            accordionBody.style.maxHeight = '0';
            accordionBody.style.padding = '0 22px';
        } else {
            header.classList.add('alt-active');
            accordionBody.style.maxHeight = "max-content";
            accordionBody.style.padding = '12px 22px';
        }
    });
});
    
});

    </script>
  

  





  
