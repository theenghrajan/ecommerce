document.addEventListener("DOMContentLoaded", function () {
  const observer = new MutationObserver(function (mutationsList) {
    for (const mutation of mutationsList) {
      if (mutation.attributeName === 'class') {
        const body = mutation.target;
        const isFancyboxOpen = body.classList.contains('fancybox-active');
        const fancybox_thumbs = document.querySelector('.fancybox-thumbs-y');

        if (isFancyboxOpen) {
          // Fancybox just opened
          const productTitleMain = document.querySelector('.product-single__title');
          if (productTitleMain && fancybox_thumbs) {
            // Prevent adding multiple titles
            if (!fancybox_thumbs.querySelector('.custom-title')) {
              const titleText = document.createElement('div');
              titleText.classList.add('h2', 'product-single__title');
              titleText.textContent = productTitleMain.innerText;
              titleText.classList.add('custom-title'); // Mark it for later removal
              fancybox_thumbs.insertBefore(titleText, fancybox_thumbs.firstChild);
            }
          }
        } else {
          // Fancybox just closed → Remove the title if exists
          if (fancybox_thumbs) {
            const oldTitle = fancybox_thumbs.querySelector('.custom-title');
            if (oldTitle) {
              oldTitle.remove();
            }
          }
        }
      }
    }
  });

  // Start observing the <body> for class changes
  observer.observe(document.body, { attributes: true });
});

</script>



<script>
{% comment %} function updateSelectedPackEachPrice() {
  const selectedPack = document.querySelector('input[name="Pack Size"]:checked');
  const variantSelect =
    document.querySelector('select[name="id"][data-product-select]') ||
    document.querySelector('select[name="id"]');

  if (!selectedPack || !variantSelect) return;

  const selectedOption = variantSelect.options[variantSelect.selectedIndex];
  if (!selectedOption) return;

  const mainPrice = parseFloat(
    selectedOption.getAttribute('data-price') ||
    selectedOption.textContent.match(/(\d+\.\d{2})/)?.[1] ||
    0
  );

  if (!mainPrice) return;

  const packText = selectedPack.value;
  const qtyMatch = packText.match(/(\d+)/);
  const qty = qtyMatch ? parseInt(qtyMatch[1], 10) : 1;

  // round nahi, truncate karo
  const eachPrice = (Math.floor((mainPrice / qty) * 100) / 100).toFixed(2);
  const [whole, decimal] = eachPrice.split('.');

  const selectedPackWrapper = selectedPack.closest('.variant-input');
  if (!selectedPackWrapper) return;

  const lastVariantEl = selectedPackWrapper.querySelector('.lastvariant');
  if (!lastVariantEl) return;

  lastVariantEl.innerHTML = `$${whole}<span class="ctm-dot">.</span>${decimal} ea<span class="ctm-dot">.</span>`;
}

document.addEventListener('change', function (e) {
  if (
    e.target.matches('input[name="Pack Size"]') ||
    e.target.matches('input[name="Beam Angle"]')
  ) {
    setTimeout(updateSelectedPackEachPrice, 150);
  }
});

document.addEventListener('DOMContentLoaded', function () {
  setTimeout(updateSelectedPackEachPrice, 150);
}); {% endcomment %}


function getSelectedBeamAngle() {
  const selectedBeam = document.querySelector('input[name="Beam Angle"]:checked');
  return selectedBeam ? selectedBeam.value.trim() : '';
}

function normalizeText(text) {
  return (text || '').toLowerCase().replace(/\s+/g, ' ').trim();
}

function getVariantPriceForPackAndBeam(packValue, beamValue, variantSelect) {
  if (!variantSelect) return 0;

  const packText = normalizeText(packValue);
  const beamText = normalizeText(beamValue);

  for (let option of variantSelect.options) {
    const optionText = normalizeText(option.textContent);

    // yeh maan ke chal raha hai ki variant option text me
    // Beam Angle aur Pack Size dono present hain
    if (optionText.includes(packText) && optionText.includes(beamText)) {
      const price = parseFloat(
        option.getAttribute('data-price') ||
        option.textContent.match(/(\d+\.\d{2})/)?.[1] ||
        0
      );

      return price || 0;
    }
  }

  return 0;
}

function updateAllPackEachPrices() {
  const beamAngle = getSelectedBeamAngle();

  const variantSelect =
    document.querySelector('select[name="id"][data-product-select]') ||
    document.querySelector('select[name="id"]');

  if (!beamAngle || !variantSelect) return;

  const packInputs = document.querySelectorAll('input[name="Pack Size"]');
  if (!packInputs.length) return;

  packInputs.forEach(function (packInput) {
    const packText = packInput.value;
    const mainPrice = getVariantPriceForPackAndBeam(packText, beamAngle, variantSelect);

    if (!mainPrice) return;

    const qtyMatch = packText.match(/(\d+)/);
    const qty = qtyMatch ? parseInt(qtyMatch[1], 10) : 1;

    // truncate to 2 decimal
    const eachPrice = (Math.floor((mainPrice / qty) * 100) / 100).toFixed(2);
    const [whole, decimal] = eachPrice.split('.');

    const packWrapper = packInput.closest('.variant-input');
    if (!packWrapper) return;

    const lastVariantEl = packWrapper.querySelector('.lastvariant');
    if (!lastVariantEl) return;

    lastVariantEl.innerHTML = `$${whole}<span class="ctm-dot">.</span>${decimal} ea<span class="ctm-dot">.</span>`;
  });
}

document.addEventListener('change', function (e) {
  if (
    e.target.matches('input[name="Pack Size"]') ||
    e.target.matches('input[name="Beam Angle"]') ||
    e.target.matches('select[name="id"]') ||
    e.target.matches('select[name="id"][data-product-select]')
  ) {
    setTimeout(updateAllPackEachPrices, 150);
  }
});

document.addEventListener('DOMContentLoaded', function () {
  setTimeout(updateAllPackEachPrices, 150);
});
</script>

