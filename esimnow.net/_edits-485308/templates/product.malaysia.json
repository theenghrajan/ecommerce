        "review_FhEyYD": {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "I recently downloaded the eSIMnow app, and I must say it has completely transformed my travel experience! Setting up an eSIM has never been easier or more convenient. The user interface is intuitive and straightforward, making it easy for anyone to navigate through the various options. Overall, eSIMnow is a must-have app for any frequent traveler. It saves time and allows for seamless connectivity wherever I go. I highly recommend it to anyone who is looking for eSIM.",
            "avatar_initial": "A",
            "avatar_color": "#1788c4",
            "name": "Aida Yusuf",
            "trip": "",
            "verified": true
          }
        },
        "review_fGWejU": {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "I've used eSIMnow app a few times and found it a very useful app for travelers. The app let you choose eSIM data plan from over 150+ countries and connect to the internet in a couple of minutes. Their price is unbeatable and I would highly recommend eSIMnow app to anyone who is looking for internet connection worldwide.",
            "avatar_initial": "T",
            "avatar_color": "#1fae74",
            "name": "Tewfik",
            "trip": "",
            "verified": true
          }
        },
        "review_X3Wbnh": {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "I recently used eSIMnow while traveling abroad, and it was a game changer! Activating the eSIM was super easy, and I was connected within minutes. The app has a user-friendly interface and offers a variety of affordable data plans to suit different destinations. I loved how I didn’t have to deal with physical SIM cards or hunt for local data options. The connection was fast and reliable, even in remote areas. This app is a must-have for any traveler looking to stay connected.",
            "avatar_initial": "H",
            "avatar_color": "#1788c4",
            "name": "Hayat Mohammed",
            "trip": "",
            "verified": true
          }
        },
        "review_ccnChN": {
          "type": "review",
