    "ss_product_why_pPrVfr": {
      "type": "ss-product-why",
      "blocks": {
        "reason_YAadEx": {
          "type": "reason",
          "settings": {
            "icon": "signal",
            "title": "4 networks means service almost everywhere",
            "text": "<p>Most eSIMs ride <strong>one</strong> Japanese carrier. eSIMnow connects across <strong>NTT Docomo, SoftBank, KDDI/au and Rakuten 5G</strong>, handing your phone to the strongest signal automatically. Coverage holds in rural prefectures, mountain regions and smaller towns where single network plans can leave you stranded.</p>"
          }
        },
        "reason_hhFNVe": {
          "type": "reason",
          "settings": {
            "icon": "phone",
            "title": "No app to download, ever",
            "text": "<p>Airalo, Saily and Holafly make you install an app and create an account before your trip. eSIMnow sends a QR code to your email. <b>Scan once and you are connected.</b> Nothing to manage at the airport.</p>"
          }
        },
        "reason_qhiiJK": {
          "type": "reason",
          "settings": {
            "icon": "speed",
            "title": "Full speed 5G, never throttled",
            "text": "<p>Some plans advertise high speed, then quietly throttle after a threshold. eSIMnow applies <b>no speed caps at any point.</b> The connection you have on day one is the connection you have on your last day.</p>"
          }
        },
        "reason_Hyxy39": {
          "type": "reason",
          "settings": {
            "icon": "price",
            "title": "Half the price for real data",
            "text": "<p>Airalo and Holafly charge <b>$72 to $75</b> for Japan. eSIMnow gives you <b>50GB for $38</b>, about $0.76 per GB. You are not paying a brand premium for the same towers.</p>"
          }
        }
      },
      "block_order": [
        "reason_YAadEx",
        "reason_hhFNVe",
        "reason_qhiiJK",
        "reason_Hyxy39"
      ],
      "name": "SS Product Why",
      "settings": {
        "eyebrow": "Why eSIMnow is the best value",
        "heading": "Not the cheapest. The one that actually works.",
        "lead": "A low price means nothing if the signal drops the moment you leave the city center. Here is exactly why eSIMnow keeps you connected where cheaper single network plans fall short.",
        "image": "shopify://shop_images/Japan_-_Lifestyle_Image.webp"
      }
