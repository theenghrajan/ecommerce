        "question_j68aBc": {
          "type": "question",
          "settings": {
            "question": "Will this eSIM work on my phone?",
            "answer": "Most unlocked iPhones (XS and later) and Android devices (2019 and later) support eSIM. Carrier locked phones may not be compatible. Use the compatibility checker on the site to confirm."
          }
        },
        "question_bQJB69": {
          "type": "question",
          "settings": {
            "question": "Does the Japan plan work outside of major cities?",
            "answer": "Yes. With access to four separate 5G networks, including NTT Docomo and KDDI/au, coverage extends well beyond Tokyo and Osaka into regional towns, rural areas and popular tourist destinations across the country."
          }
        },
        "question_BaANgt": {
          "type": "question",
          "settings": {
            "question": "When does the eSIM activate?",
            "answer": "The eSIM activates the first time it connects to a supported network in Japan. The 30 day data period starts at that point, not at the time of purchase."
          }
        },
        "question_RVKMRA": {
          "type": "question",
          "settings": {
            "question": "How long do I have to install the eSIM after purchase?",
            "answer": "180 days from the date of purchase. Install before you leave home, and activation triggers automatically when you connect in Japan."
          }
        },
        "question_he3y6z": {
          "type": "question",
          "settings": {
            "question": "Can I make phone calls with the Japan eSIM?",
            "answer": "Native calls and SMS are not included, but VoIP apps like WhatsApp, FaceTime and LINE work smoothly over your data connection."
          }
        },
        "question_8xNmr6": {
          "type": "question",
          "settings": {
            "question": "Can I use this as a mobile hotspot?",
            "answer": "Yes. You can share your eSIMnow data connection as a hotspot on most supported devices."
          }
        },
        "question_JmJyWQ": {
          "type": "question",
          "settings": {
            "question": "Do I need to remove my existing SIM?",
            "answer": "No. eSIM runs alongside your existing physical SIM. Your home number stays active for calls and texts while eSIMnow provides data in Japan."
          }
        }
