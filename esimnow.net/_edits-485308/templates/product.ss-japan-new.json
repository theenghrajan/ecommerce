    "ss_local_ip_support_E4zcCJ": {
      "type": "ss-local-ip-support",
      "blocks": {
        "feature_X9xENa": {
          "type": "feature",
          "settings": {
            "list_text": "<strong>Mobile payments and ticketing</strong> apps that check your location work as expected."
          }
        },
        "feature_g8FrTQ": {
          "type": "feature",
          "settings": {
            "list_text": "<strong>Maps, transit and restaurant</strong> results show local, accurate information."
          }
        },
        "feature_aCA3jE": {
          "type": "feature",
          "settings": {
            "list_text": "<b>Faster, lower latency</b> connections because your data is not detouring overseas."
          }
        }
      },
      "block_order": [
        "feature_X9xENa",
        "feature_g8FrTQ",
        "feature_aCA3jE"
      ],
      "name": "SS Local IP Feature",
      "settings": {
        "eyebrow_text": "A Japan based connection",
        "heading": "Your apps work like you are a local",
        "lead_text": "Some eSIMs route your data through servers in another country, giving you a foreign IP address. In Japan, that quietly breaks things you actually need.",
        "good_card_title": "eSIMnow · Japanese IP",
        "good_card_sub": "Routed through Japan, like a local SIM",
        "bad_card_title": "Roaming eSIMs · Foreign IP",
        "bad_card_sub": "Data bounced through another country",
        "side_heading": "Why a local IP matters in Japan",
        "side_paragraph_1": "Japan runs on its apps. You will use mobile payments at convenience stores, scan QR codes for train tickets, book restaurants, and lean on Maps for every transfer. Many of these check where your connection is coming from.",
        "side_paragraph_2": "When your eSIM routes through a foreign country, apps can think you are not really in Japan, and some payment, ticketing and streaming features stop working right when you need them. It is one of the most common frustrations travelers never see coming.",
        "side_paragraph_3": "eSIMnow connects you on a Japanese network so your phone behaves like it belongs there. The same connection a local would have, the moment you land.",
        "note_text": ""
      }
    },
