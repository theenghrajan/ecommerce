<section class="elite-collection elite-split" style="--section-space:{{ section.settings.space }}px;--split-bg:{{ section.settings.background }};--split-panel:{{ section.settings.panel_color }};--split-text:{{ section.settings.text_color }};--split-title-size-desktop:{{ section.settings.heading_size_desktop }}px;--split-title-size-mobile:{{ section.settings.heading_size_mobile }}px"><div class="elite-wrap"><div class="elite-split__grid {% if section.settings.image_position == 'right' %}elite-split__grid--reverse{% endif %}"><div class="elite-split__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '700, 1000, 1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image.alt }}{% endif %}</div><div class="elite-split__content"><div class="elite-kicker" style="color:{{ section.settings.kicker_color }}">{{ section.settings.kicker }}</div><h2 class="elite-heading">{{ section.settings.heading }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<p><a class="elite-btn elite-btn--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} &nbsp; →</a></p>{% endif %}</div></div></div></section>
{% schema %}{"name":"Elite split story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"image_position","label":"Image position","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},{"type":"text","id":"kicker","label":"Eyebrow","default":"Make it yours"},{"type":"text","id":"heading","label":"Heading","default":"Your space. Your game."},{"type":"richtext","id":"text","label":"Text","default":"<p>Build an indoor golf experience around your room, goals and budget.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Talk to an expert"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color","id":"background","label":"Section background","default":"#FFFFFF"},{"type":"color","id":"panel_color","label":"Text-panel background","default":"#071A3A"},{"type":"color","id":"text_color","label":"Text colour","default":"#FFFFFF"},{"type":"color","id":"kicker_color","label":"Eyebrow colour","default":"#4A9FFF"},{"type":"range","id":"heading_size_desktop","label":"Desktop heading size","min":30,"max":80,"step":2,"default":54,"unit":"px"},{"type":"range","id":"heading_size_mobile","label":"Mobile heading size","min":26,"max":54,"step":2,"default":40,"unit":"px"},{"type":"range","id":"space","label":"Top and bottom spacing","min":0,"max":140,"step":10,"default":90,"unit":"px"}],"presets":[{"name":"Elite split story"}]}{% endschema %}