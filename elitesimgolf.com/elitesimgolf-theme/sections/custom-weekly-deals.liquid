    </div><!-- /.esg-wd__slider-wrap -->
    <div class="esg-wd__dots" id="esg-wd-dots-{{ section.id }}"></div>

  </div>
</section>

<script>
(function () {
  var sid = '{{ section.id }}';

  /* ── Helper: pad number ── */
  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  /* ── Countdown engine ── */
  function startCountdown(expiry, onTick, onExpire) {
    var end = new Date(expiry).getTime();
    function tick() {
      var now  = Date.now();
      var diff = end - now;
      if (diff <= 0) { onExpire(); return; }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000)  / 60000);
      var s = Math.floor((diff % 60000)    / 1000);
      onTick(d, h, m, s);
      setTimeout(tick, 1000);
    }
    tick();
  }

  /* ── Global header timer ── */
  {%- if section.settings.show_global_timer and section.settings.expiry_date != blank -%}
  (function() {
    var expiry = '{{ section.settings.expiry_date }}';
    var dEl = document.querySelector('[data-wd-days-{{ section.id }}]');
    var hEl = document.querySelector('[data-wd-hrs-{{ section.id }}]');
    var mEl = document.querySelector('[data-wd-min-{{ section.id }}]');
    var sEl = document.querySelector('[data-wd-sec-{{ section.id }}]');
    if (!dEl) return;
    startCountdown(expiry,
      function(d,h,m,s) {
        dEl.textContent = pad(d);
        hEl.textContent = pad(h);
        mEl.textContent = pad(m);
        sEl.textContent = pad(s);
      },
      function() {
        dEl.textContent = hEl.textContent = mEl.textContent = sEl.textContent = '00';
      }
    );
  })();
  {%- endif -%}

  /* ── Per-card timers ── */
  {%- if section.settings.show_card_timer -%}
  {%- for block in deal_blocks -%}
  {%- assign card_expiry = block.settings.expiry_override | default: section.settings.expiry_date -%}
  {%- if card_expiry != blank -%}
  (function() {
    var key     = '{{ card_expiry }}-{{ forloop.index }}';
    var expiry  = '{{ card_expiry }}';
    var dEls    = document.querySelectorAll('[data-wdc-days="' + key + '"]');
    var hEls    = document.querySelectorAll('[data-wdc-hrs="'  + key + '"]');
    var mEls    = document.querySelectorAll('[data-wdc-min="'  + key + '"]');
    var sEls    = document.querySelectorAll('[data-wdc-sec="'  + key + '"]');
    var expEls  = document.querySelectorAll('[data-wdc-expired="' + key + '"]');

    function set(els, val) { els.forEach(function(e){ e.textContent = val; }); }

    startCountdown(expiry,
      function(d,h,m,s) {
        set(dEls, pad(d));
        set(hEls, pad(h));
        set(mEls, pad(m));
        set(sEls, pad(s));
      },
      function() {
        set(dEls, '00'); set(hEls, '00'); set(mEls, '00'); set(sEls, '00');
        expEls.forEach(function(e){
          e.style.display = 'block';
          e.previousElementSibling.style.display = 'none';
        });
      }
    );
  })();
  {%- endif -%}
  {%- endfor -%}
  {%- endif -%}


  /* ── Reveal price on click ── */
  document.querySelectorAll('[data-wd-reveal]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id      = btn.getAttribute('data-wd-reveal');
      var revealed= document.getElementById('esg-wd-revealed-' + id);
      if (!revealed) return;
      revealed.classList.add('is-visible');
      btn.style.display = 'none';
    });
  });

  /* ── Copy coupon code ── */
  document.querySelectorAll('[data-wd-copy]').forEach(function(el) {
    el.addEventListener('click', function() {
      var code    = el.getAttribute('data-wd-copy');
      var copied  = el.parentElement.querySelector('.esg-wd__coupon-copied');
      navigator.clipboard.writeText(code).then(function() {
        if (copied) {
          copied.classList.add('is-visible');
          setTimeout(function() { copied.classList.remove('is-visible'); }, 2500);
        }
      }).catch(function() {
        /* Fallback for older browsers */
        var ta = document.createElement('textarea');
        ta.value = code; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        if (copied) {
          copied.classList.add('is-visible');
          setTimeout(function() { copied.classList.remove('is-visible'); }, 2500);
        }
      });
    });
  });

  /* ── Mobile slider ── */
  (function() {
    var track  = document.getElementById('esg-wd-track-{{ section.id }}');
    var dotsEl = document.getElementById('esg-wd-dots-{{ section.id }}');
    var btnP   = document.getElementById('esg-wd-prev-{{ section.id }}');
    var btnN   = document.getElementById('esg-wd-next-{{ section.id }}');
    if (!track || !btnP) return;

    var cards = Array.from(track.querySelectorAll('.esg-wd__card'));
    var total = cards.length;
    var cur   = 0;

    function isMobile() { return window.innerWidth <= 560; }

    /* Build dots */
    cards.forEach(function(_, i) {
      var dot = document.createElement('button');
      dot.className = 'esg-wd__dot' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('aria-label', 'Card ' + (i + 1));
      (function(idx){ dot.addEventListener('click', function(){ if(isMobile()) goTo(idx); }); })(i);
      dotsEl.appendChild(dot);
    });

    function goTo(idx) {
      if (!isMobile()) return;
      cur = Math.max(0, Math.min(idx, total - 1));
      var w = cards[0].offsetWidth;
      track.style.transform = 'translateX(-' + (cur * w) + 'px)';
      dotsEl.querySelectorAll('.esg-wd__dot').forEach(function(d, i) {
        d.classList.toggle('is-active', i === cur);
      });
    }

    btnP.addEventListener('click', function() { goTo(cur - 1); });
    btnN.addEventListener('click', function() { goTo(cur + 1); });

    /* Touch swipe */
    var startX = 0;
    track.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend',   function(e) {
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(diff > 0 ? cur + 1 : cur - 1);
    });

    /* Reset on resize */
    window.addEventListener('resize', function() {
      track.style.transform = '';
      cur = 0;
      dotsEl.querySelectorAll('.esg-wd__dot').forEach(function(d, i) {
        d.classList.toggle('is-active', i === 0);
      });
    });
  })();

})();
</script>

