      </div><!-- /.esg-wd__track-outer -->
      <button class="esg-wd__arrow esg-wd__arrow--next" id="esg-wd-next-{{ section.id }}" aria-label="Next">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="9 18 15 12 9 6"/></svg>
