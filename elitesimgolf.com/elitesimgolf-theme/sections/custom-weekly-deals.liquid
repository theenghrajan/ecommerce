                      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                      {{ block.settings.coupon_code }}
                    </span>
                    <span class="esg-wd__coupon-copied" id="esg-wd-copied-{{ block.id }}">✓ Copied!</span>
