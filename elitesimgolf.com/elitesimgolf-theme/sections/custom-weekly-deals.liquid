                  <span class="esg-wd__sep">:</span>
                  <div class="esg-wd__unit">
                    <span class="esg-wd__unit-num" data-wdc-hrs="{{ card_expiry }}-{{ forloop.index }}">--</span>
                    <span class="esg-wd__unit-lbl">Hrs</span>
                  </div>
                  <span class="esg-wd__sep">:</span>
                  <div class="esg-wd__unit">
                    <span class="esg-wd__unit-num" data-wdc-min="{{ card_expiry }}-{{ forloop.index }}">--</span>
                    <span class="esg-wd__unit-lbl">Min</span>
                  </div>
                  <span class="esg-wd__sep">:</span>
                  <div class="esg-wd__unit">
                    <span class="esg-wd__unit-num" data-wdc-sec="{{ card_expiry }}-{{ forloop.index }}">--</span>
