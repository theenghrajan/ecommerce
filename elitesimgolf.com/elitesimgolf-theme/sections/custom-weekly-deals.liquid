                <div class="esg-wd__price-row">
                  {%- if block.settings.price_override != blank -%}
                    <span class="esg-wd__price">{{ block.settings.price_override }}</span>
                  {%- else -%}
                    <span class="esg-wd__price">{{ prod.price | money }}</span>
                  {%- endif -%}
                  {%- if block.settings.compare_override != blank -%}
