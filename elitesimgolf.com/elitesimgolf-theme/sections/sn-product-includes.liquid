<section
  id="{{ section.settings.id }}"
  class="landing"
>
  {% style %}
    #{{section.settings.id}} {
      padding: {{ section.settings.vp-desktop }}px {{ section.settings.hp-desktop }}px;
      background-color: {{ section.settings.background_color }};
      --heading_color: {{ section.settings.heading_color }};
      --text_color: {{ section.settings.text_color }};
      --accent_color: {{ section.settings.accent_color }};
      --btn_bg: {{ section.settings.btn_bg }};
      --btn_text: {{ section.settings.btn_text }};
      background: url({{section.settings.background | image_url: width: 2000}}) no-repeat center center fixed;
      background-size: cover;
      position: relative;
      z-index: 1;
    }
    {% if section.settings.overlay %}
    #{{section.settings.id}}::after{
      display: block;
      position: absolute;
      z-index: -1;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: {{section.settings.overlay}};
      opacity: calc({{section.settings.opacity}} * 0.05);
      content: '';
    }
    {% endif %}

    #{{ section.settings.id }} .sn-heading h2, #{{ section.settings.id }} .sn-heading p{
        margin-bottom: 10px;
    }

    #{{ section.settings.id }} .sn-heading h2{
        color: var(--accent_color);
    }

    .sn-include-cards{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(600px, 1fr));
        gap: 20px;
        max-width: 1280px;
        margin-inline: auto;
    }

    .sn-include-card{
        display: grid;
        grid-template-columns: 160px 1fr;
        gap: 20px;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,0.05);
        background: {{section.settings.card_bg}};
    }

    .sn-include-card img{
        border-radius: 4px;
        background: #fff;
    }

    .sn-include-card p{
        margin-bottom: 0;
    }

    .sn-include-card ul{
      list-style: disc;
      -webkit-padding-start: 20px;
      -moz-padding-start: 20px;
      margin-top: 10px;
    }
    .sn-include-card ul li{
      margin-bottom: 5px;
    }
    @media screen and (max-width: 767px) {
      #{{section.settings.id}} {
          padding: {{ section.settings.vp-mobile }}px {{ section.settings.hp-mobile }}px;
          background-attachment: scroll;
      }
      .sn-include-cards{
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      }

      .sn-include-card{
        grid-template-columns: 80px 1fr;
      }

    }
  {% endstyle %}

  {% if section.settings.heading != '' %}
    <div class="sn-container hcenter text-center">
      <div class="sn-col-1 sn-heading mb-2">
        {{ section.settings.text }}
      </div>
    </div>
  {% endif %}

  <div class="sn-include-cards {%if section.settings.align == 'center' %}text-center{% else %}text-left{% endif %} hcenter">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'card' %}
          <div class="sn-include-card {{ block.settings.class }}" {{ block.shopify_attributes }}>
            <div class="sn-include-image">
              <img
                src="{{ block.settings.image | image_url: width: 320 }}"
                class="sn-img"
                width="320px"
                height="auto"
              >
            </div>
            <div class="sn-include-content">
              <h3>{{ block.settings.title }}</h3>
              {{ block.settings.text }}
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product: what's included",
  "settings": [
    {
      "id": "id",
      "type": "text",
      "label": "Section ID",
      "default": "sn-includes"
    },
    {
      "id": "text",
      "type": "richtext",
      "label": "Section heading"
    },
    {
      "id": "align",
      "type": "select",
      "options": [
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Left",
          "value": "left"
        }
      ],
      "label": "Align text (card content)",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section styles"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": "Background color"
    },
    {
      "id": "heading_color",
      "type": "color",
      "label": "Heading color"
    },
    {
      "id": "text_color",
      "type": "color",
      "label": "Text color"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color"
    },
    {
      "id": "btn_bg",
      "type": "color",
      "label": "Button background color"
    },
    {
      "id": "btn_text",
      "type": "color",
      "label": "Button text color"
    },
    {
      "id": "card_bg",
      "type": "color",
      "label": "Card background color"
    },
    {
      "id": "vp-desktop",
      "type": "range",
      "label": "Vertical padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "id": "hp-desktop",
      "type": "range",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "id": "vp-mobile",
      "type": "range",
      "label": "Vertical padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "id": "hp-mobile",
      "type": "range",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "id": "background",
      "type": "image_picker",
      "label": "Background image"
    },
    {
      "id": "overlay",
      "type": "color",
      "label": "Overlay color"
    },
    {
      "id": "opacity",
      "type": "range",
      "step": 1,
      "min": 0,
      "max": 20,
      "default": 10,
      "label": "Overlay opacity"
    }
  ],
  "blocks": [
    {
      "name": "Card",
      "type": "card",
      "settings": [
        {
          "type": "image_picker",
          "label": "Image",
          "id": "image"
        },
        {
          "type": "inline_richtext",
          "label": "Title",
          "id": "title"
        },
        {
          "type": "richtext",
          "label": "Description",
          "id": "text"
        },
        {
          "type": "text",
          "label": "CSS class",
          "id": "class"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product: what's included"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

