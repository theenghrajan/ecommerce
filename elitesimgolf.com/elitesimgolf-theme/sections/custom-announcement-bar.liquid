<style>
  .cab--{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    min-height: {{ section.settings.bar_height }}px;
    display: flex;
    align-items: center;
  }
  .cab--{{ section.id }} .cab__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 20px;
    padding: 8px 40px;
  }
  .cab--{{ section.id }} .cab__slides {
    display: grid;
    grid-template-areas: "slide";
    place-items: center;
    min-width: 0;
    flex: 1;
  }
  .cab--{{ section.id }} .cab__slide {
    grid-area: slide;
    opacity: 0;
    visibility: hidden;
  }
  .cab--{{ section.id }} .cab__slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .cab--{{ section.id }} .cab__links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-shrink: 0;
  }
  @media (max-width: 1024px) {
    .cab--{{ section.id }} .cab__links { display: none !important; }
  }
</style>
{%- comment -%}
================================================================
  SECTION: CUSTOM ANNOUNCEMENT BAR
  File: sections/custom-announcement-bar.liquid

  Features:
  - Rotating announcements (auto-cycle every X seconds)
  - Manual navigation with < / > arrows
  - Icon + text per announcement (optional link)
  - Right-side quick links with icons
  - Pauses rotation on hover
  - Mobile-responsive (hides right links, keeps rotator)
================================================================
{%- endcomment -%}

{%- assign announcements = section.blocks | where: 'type', 'announcement' -%}
{%- assign quick_links = section.blocks | where: 'type', 'link' -%}
<style>
  .cab--{{ section.id }} { background: {{ section.settings.bg_color }}; min-height: {{ section.settings.bar_height }}px; }
  .cab--{{ section.id }} [data-cab-slide]:not(.is-active) { display: none !important; }
</style>
<div class="cab cab--{{ section.id }}"
     data-rotate-interval="{{ section.settings.rotate_interval }}"
     style="
       background: {{ section.settings.bg_color }};
       color: {{ section.settings.text_color }};
       --cab-bg: {{ section.settings.bg_color }};
       --cab-text: {{ section.settings.text_color }};
       --cab-accent: {{ section.settings.accent_color }};
       --cab-height: {{ section.settings.bar_height }}px;
     ">
  <div class="cab__inner">

    {%- if announcements.size > 0 -%}
      <div class="cab__rotator">
        {%- if announcements.size > 1 and section.settings.show_arrows -%}
          <button class="cab__nav cab__nav--prev" aria-label="Previous announcement" data-cab-prev type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
        {%- endif -%}

        <div class="cab__slides" data-cab-slides aria-live="polite" aria-atomic="true">
          {%- for block in announcements -%}
            <div class="cab__slide{% if forloop.first %} is-active{% endif %}"
                 data-cab-slide
                 {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="cab__slide-inner">
              {%- else -%}
                <span class="cab__slide-inner">
              {%- endif -%}
                {%- if block.settings.icon != blank -%}
                  <span class="cab__icon">
                    <img src="{{ block.settings.icon | image_url: width: 40 }}" alt="" width="18" height="18" loading="lazy">
                  </span>
                {%- endif -%}
                <span class="cab__text">{{ block.settings.text }}</span>
              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if announcements.size > 1 and section.settings.show_arrows -%}
          <button class="cab__nav cab__nav--next" aria-label="Next announcement" data-cab-next type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if quick_links.size > 0 -%}
      <div class="cab__links">
        {%- for block in quick_links -%}
          <a href="{{ block.settings.link | default: '#' }}" class="cab__link" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="cab__link-icon">
                <img src="{{ block.settings.icon | image_url: width: 32 }}" alt="" width="16" height="16" loading="lazy">
              </span>
            {%- endif -%}
            <span class="cab__link-text">{{ block.settings.text }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
.cab--{{ section.id }} {
    background: var(--cab-bg);
    color: var(--cab-text);
    font-size: 14px;
    font-weight: 500;
    min-height: var(--cab-height);
    display: flex;
    align-items: center;
  }

  /* Prevent flash-of-unstyled-content on page load */
  .cab--{{ section.id }} .cab__slide {
    opacity: 0;
    visibility: hidden;
  }
  .cab--{{ section.id }} .cab__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .cab--{{ section.id }} .cab__inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 8px {{ section.settings.side_padding }}px;
  }

  /* ===== Rotator ===== */
.cab--{{ section.id }} .cab__rotator {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 24px;
    flex: 1;
    min-width: 0;
    padding-left: 40px;
  }

  .cab--{{ section.id }} .cab__nav {
    background: none;
    border: 0;
    color: var(--cab-text);
    cursor: pointer;
    padding: 6px;
    opacity: 0.7;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: opacity .15s, background .15s;
    flex-shrink: 0;
  }
  .cab--{{ section.id }} .cab__nav:hover {
    opacity: 1;
    background: rgba(255,255,255,0.1);
  }

  .cab--{{ section.id }} .cab__slides {
    display: grid;
    grid-template-areas: "slide";
    align-items: center;
    justify-items: center;
    min-width: 0;
    max-width: 100%;
  }

  .cab--{{ section.id }} .cab__slide {
    grid-area: slide;
    opacity: 0;
    visibility: hidden;
    transition: opacity .4s ease;
    max-width: 100%;
  }
  .cab--{{ section.id }} .cab__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .cab--{{ section.id }} .cab__slide-inner {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    max-width: 100%;
  }
  .cab--{{ section.id }} a.cab__slide-inner:hover { text-decoration: underline; }

  .cab--{{ section.id }} .cab__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cab--{{ section.id }} .cab__icon img {
    display: block;
    filter: brightness(0) invert(1);
  }

  .cab--{{ section.id }} .cab__text {
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  /* ===== Right-side quick links ===== */
  .cab--{{ section.id }} .cab__links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-shrink: 0;
  }

  .cab--{{ section.id }} .cab__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--cab-text);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: opacity .15s;
  }
  .cab--{{ section.id }} .cab__link:hover { opacity: 0.75; }
  .cab--{{ section.id }} .cab__link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cab--{{ section.id }} .cab__link-icon img {
    display: block;
    filter: brightness(0) invert(1);
  }

  /* ===== Mobile ===== */
  @media (max-width: 1024px) {
    .cab--{{ section.id }} .cab__inner {
      justify-content: center;
      padding: 6px 12px;
      gap: 8px;
    }
    .cab--{{ section.id }} .cab__links { display: none; }
    .cab--{{ section.id }} .cab__rotator { gap: 8px; }
    .cab--{{ section.id }} .cab__text { font-size: 13px; }
    .cab--{{ section.id }} .cab__nav { padding: 4px; }
  }
</style>

<script>
  (function() {
    var root = document.querySelector('.cab--{{ section.id }}');
    if (!root) return;

    var slides = root.querySelectorAll('[data-cab-slide]');
    if (slides.length === 0) return;

    var interval = parseInt(root.dataset.rotateInterval, 10) || 5000;
    var current = 0;
    var timer = null;

    function show(index) {
      slides.forEach(function(slide, i) {
        slide.classList.toggle('is-active', i === index);
      });
      current = index;
    }

    function next() { show((current + 1) % slides.length); }
    function prev() { show((current - 1 + slides.length) % slides.length); }

    function start() {
      stop();
      if (slides.length > 1 && interval > 0) {
        timer = setInterval(next, interval);
      }
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    var prevBtn = root.querySelector('[data-cab-prev]');
    var nextBtn = root.querySelector('[data-cab-next]');

    if (prevBtn) {
      prevBtn.addEventListener('click', function() { prev(); start(); });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() { next(); start(); });
    }

    // Pause on hover
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);

    // Pause when tab is hidden
    document.addEventListener('visibilitychange', function() {
      if (document.hidden) stop(); else start();
    });

    start();
  })();
</script>

{% schema %}
{
  "name": "Custom Announcement Bar",
  "class": "section-custom-announcement",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Rotation" },
    { "type": "range", "id": "rotate_interval", "label": "Rotation interval", "min": 2000, "max": 9500, "step": 500, "default": 5000, "unit": "ms", "info": "How long each announcement shows before switching to the next." },
    { "type": "checkbox", "id": "show_arrows", "label": "Show prev / next arrows", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "bar_height", "label": "Minimum bar height", "min": 32, "max": 80, "step": 2, "default": 44, "unit": "px" },
    { "type": "range", "id": "side_padding", "label": "Side padding", "min": 12, "max": 80, "step": 4, "default": 40, "unit": "px" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0f1c2e" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent (optional)", "default": "#7ac142" }
  ],

  "blocks": [
    {
      "type": "announcement",
      "name": "Rotating Announcement",
      "settings": [
        { "type": "paragraph", "content": "Add multiple 'Rotating Announcement' blocks — they will auto-cycle in the center of the bar." },
        { "type": "image_picker", "id": "icon", "label": "Icon (SVG or PNG)", "info": "Icon will be tinted white automatically." },
        { "type": "text", "id": "text", "label": "Text", "default": "FREE and FAST Shipping" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    },
    {
      "type": "link",
      "name": "Quick Link (right side)",
      "settings": [
        { "type": "paragraph", "content": "Add 'Quick Link' blocks for the right side (Resource Library, Financing, etc.). Hidden on mobile." },
        { "type": "image_picker", "id": "icon", "label": "Icon (SVG or PNG)", "info": "Icon will be tinted white automatically." },
        { "type": "text", "id": "text", "label": "Text", "default": "Resource Library" },
    { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom Announcement Bar",
      "blocks": [
        { "type": "announcement" },
        { "type": "announcement" },
        { "type": "announcement" },
        { "type": "announcement" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
