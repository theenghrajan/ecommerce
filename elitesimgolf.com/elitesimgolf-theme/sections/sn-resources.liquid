<section
  id="{{ section.settings.id }}"
  class="landing"
>
  {% style %}
    #{{section.settings.id}} {
      padding: {{ section.settings.vp-desktop }}px {{ section.settings.hp-desktop }}px;
      background-color: {{ section.settings.background_color }};
      --heading_color: {{ section.settings.heading_color }};
      --text_color: {{ section.settings.text_color }};
      --accent_color: {{ section.settings.accent_color }};
      --btn_bg: {{ section.settings.btn_bg }};
      --btn_text: {{ section.settings.btn_text }};
      background: url({{section.settings.background | image_url: width: 2000}}) no-repeat center center fixed;
      background-size: cover;
      position: relative;
      z-index: 1;
    }
    {% if section.settings.overlay %}
    #{{section.settings.id}}::after{
      display: block;
      position: absolute;
      z-index: -1;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: {{section.settings.overlay}};
      opacity: calc({{section.settings.opacity}} * 0.05);
      content: '';
    }
    {% endif %}
    .sn-resource-wrap{
        padding: 20px;
        border-radius: 10px;
        backdrop-filter: blur(3px);
        background: rgba(0,0,0,0.2);
        height: stretch;
        border: 1px solid transparent;
        position: relative;
    }
    .sn-resource-wrap:hover{
        border: 1px solid var(--accent_color);
    }
    .sn-resource-icon{
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border-radius: 50%;
        {% if section.settings.align == 'center' %}
        margin-inline: auto;
        {% endif %}
        background: {{section.settings.icon_bg}};
    }
    .sn-resource-icon img{
        width: 60px;
        height: 60px;
    }
    .landing .sn-resource-wrap p strong{
      color: var(--accent_color);
    }
    .sn-resource-wrap a{
        display: flex;
        flex-direction: column;
        height: 100%;
        justify-content: space-between;
    }
    .resource-emoji{
        font-size: 28px;
        margin-bottom: 20px;
    }
    .resource-arrow{
        color: var(--accent_color);
        font-size: 22px;
    }
    @media screen and (max-width: 767px) {
      #{{section.settings.id}} {
          padding: {{ section.settings.vp-mobile }}px {{ section.settings.hp-mobile }}px;
          background-attachment: scroll;
      }
    }
  {% endstyle %}

  {% if section.settings.heading != '' %}
    <div class="sn-container hcenter text-center">
      <div class="sn-col-1 sn-heading mb-2">
        {{ section.settings.text }}
      </div>
    </div>
  {% endif %}

  <div class="sn-container {%if section.settings.align == 'center' %}text-center{% else %}text-left{% endif %} hcenter">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'benefit' %}
          <div class="sn-col-3 p-1">
            <div
              class="sn-resource-wrap p-1 {{ block.settings.class }}"
              {{ block.shopify_attributes }}
            >
              <a href="{{ block.settings.url }}">
                <div class="sn-resource-content">
                  <span class="resource-emoji">{{ block.settings.emoji }}</span>
                  <h4 class="mb-1">{{ block.settings.title }}</h4>
                  <div class="sn-text">{{ block.settings.text }}</div>
                </div>
                <div class="resource-arrow">→</div>
              </a>
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product: Resources",
  "settings": [
    {
      "id": "id",
      "type": "text",
      "label": "Section ID",
      "default": "sn-resources"
    },
    {
      "id": "text",
      "type": "richtext",
      "label": "Section heading"
    },
    {
      "id": "align",
      "type": "select",
      "options": [
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Left",
          "value": "left"
        }
      ],
      "label": "Align text (card content)",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section styles"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": "Background color"
    },
    {
      "id": "heading_color",
      "type": "color",
      "label": "Heading color"
    },
    {
      "id": "text_color",
      "type": "color",
      "label": "Text color"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color"
    },
    {
      "id": "btn_bg",
      "type": "color",
      "label": "Button background color"
    },
    {
      "id": "btn_text",
      "type": "color",
      "label": "Button text color"
    },
    {
      "id": "icon_bg",
      "type": "color",
      "label": "Icon background color"
    },
    {
      "id": "vp-desktop",
      "type": "range",
      "label": "Vertical padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "id": "hp-desktop",
      "type": "range",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "id": "vp-mobile",
      "type": "range",
      "label": "Vertical padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "id": "hp-mobile",
      "type": "range",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "id": "background",
      "type": "image_picker",
      "label": "Background image"
    },
    {
      "id": "overlay",
      "type": "color",
      "label": "Overlay color"
    },
    {
      "id": "opacity",
      "type": "range",
      "step": 1,
      "min": 0,
      "max": 20,
      "default": 10,
      "label": "Overlay opacity"
    }
  ],
  "blocks": [
    {
      "name": "Resource",
      "type": "benefit",
      "settings": [
        {
          "type": "text",
          "label": "Emoji",
          "id": "emoji"
        },
        {
          "type": "inline_richtext",
          "label": "Title",
          "id": "title"
        },
        {
          "type": "richtext",
          "label": "Description",
          "id": "text"
        },
        {
          "type": "url",
          "label": "URL",
          "id": "url"
        },
        {
          "type": "text",
          "label": "CSS class",
          "id": "class"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product: Resources"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

