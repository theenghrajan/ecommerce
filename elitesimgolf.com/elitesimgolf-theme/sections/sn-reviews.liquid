<section
  id="{{ section.settings.id }}"
  class="landing"
>
  {% style %}
    #{{section.settings.id}} {
      padding: {{ section.settings.vp-desktop }}px {{ section.settings.hp-desktop }}px;
      background-color: {{ section.settings.background_color }};
      --heading_color: {{ section.settings.heading_color }};
      --text_color: {{ section.settings.text_color }};
      --btn_bg: {{ section.settings.btn_bg }};
      --btn_text: {{ section.settings.btn_text }};
      background: url({{section.settings.background | image_url: width: 2000}}) no-repeat center center fixed;
      background-size: cover;
      position: relative;
      z-index: 1;
    }
    {% if section.settings.overlay %}
    #{{section.settings.id}}::after{
      display: block;
      position: absolute;
      z-index: -1;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: {{section.settings.overlay}};
      opacity: calc({{section.settings.opacity}} * 0.05);
      content: '';
    }
    {% endif %}

    .sn-reviews-slider{
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
    }

    .sn-review-wrap{
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        display: flex !important;
        flex-direction: column;
        border: 1px solid rgba(0,0,0,0.1);
        gap: 12px;
    }
    .sn-review-stars{
        display: inline-flex !important;
        gap: 1px;
        padding: 4px 8px;
        background: #2953b9;
        width: 110px;
        border-radius: 50px;
    }
    .sn-review-stars ion-icon{
        color: #fff;
        font-size: 20px;
        justify-content: center;
    }
    @media screen and (max-width: 767px) {
      #{{section.settings.id}} {
          padding: {{ section.settings.vp-mobile }}px {{ section.settings.hp-mobile }}px;
          background-attachment: scroll;
      }
    }
  {% endstyle %}

  {% if section.settings.heading != '' %}
    <div class="sn-container hcenter text-center">
      <div class="sn-col-1 sn-heading mb-2">
        {{ section.settings.text }}
      </div>
    </div>
  {% endif %}

  <div class="sn-reviews-slider">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'review' %}
          <div class="sn-review-outer p-1">
            <div class="sn-review-wrap p-2 {{ block.settings.class }}" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <div class="review-thumb">
                  <img
                    src="{{ block.settings.image | image_url: width: 240 }}"
                    class="sn-img"
                    width="100%"
                    height="100%"
                  >
                </div>
              {% endif %}
              <div class="sn-review-stars">
                <ion-icon name="star"></ion-icon>
                <ion-icon name="star"></ion-icon>
                <ion-icon name="star"></ion-icon>
                <ion-icon name="star"></ion-icon>
                <ion-icon name="star"></ion-icon>
              </div>
              <p>{{ block.settings.review }}</p>
              <h4>{{ block.settings.name }}</h4>
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

{% schema %}
{
  "name": "Custom: Reviews",
  "settings": [
    {
      "id": "id",
      "type": "text",
      "label": "Section ID",
      "default": "sn-reviews"
    },
    {
      "id": "text",
      "type": "richtext",
      "label": "Section heading"
    },
    {
      "type": "header",
      "content": "Section styles"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": "Background color"
    },
    {
      "id": "heading_color",
      "type": "color",
      "label": "Heading color"
    },
    {
      "id": "text_color",
      "type": "color",
      "label": "Text color"
    },
    {
      "id": "btn_bg",
      "type": "color",
      "label": "Button background color"
    },
    {
      "id": "btn_text",
      "type": "color",
      "label": "Button text color"
    },
    {
      "id": "vp-desktop",
      "type": "range",
      "label": "Vertical padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "id": "hp-desktop",
      "type": "range",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "id": "vp-mobile",
      "type": "range",
      "label": "Vertical padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "id": "hp-mobile",
      "type": "range",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "id": "background",
      "type": "image_picker",
      "label": "Background image"
    },
    {
      "id": "overlay",
      "type": "color",
      "label": "Overlay color"
    },
    {
      "id": "opacity",
      "type": "range",
      "step": 1,
      "min": 0,
      "max": 20,
      "default": 10,
      "label": "Overlay opacity"
    }
  ],
  "blocks": [
    {
      "name": "Review",
      "type": "review",
      "settings": [
        {
          "type": "image_picker",
          "label": "Image",
          "id": "image"
        },
        {
          "type": "inline_richtext",
          "label": "Review",
          "id": "review"
        },
        {
          "type": "inline_richtext",
          "label": "Name",
          "id": "name"
        },
        {
          "type": "text",
          "label": "CSS class",
          "id": "class"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom: Reviews"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
