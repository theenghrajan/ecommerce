der-right: none; }\n  .esg-vtrack .esg-room__head {\n    background: #0A1A3A;\n    color: #ffffff;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 13px;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    border-right-color: rgba(255,255,255,0.15);\n  }\n  .esg-vtrack .esg-room__label {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    color: #0A1A3A;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    font-size: 14px;\n  }\n  .esg-vtrack .esg-room__tag {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 12px;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #0A1A3A;\n    opacity: 0.7;\n  }\n\n  /* ---------- Contact Form ---------- */\n  .esg-vtrack .esg-form { max-width: 760px; margin: 32px auto 0; }\n  .esg-vtrack .esg-form__notice {\n    max-width: 760px;\n    margin: 0 auto 24px;\n    padding: 14px 20px;\n    background: rgba(255,255,255,0.06);\n    border-left: 3px solid #ffffff;\n    color: #ffffff;\n    font-size: 15px;\n    line-height: 1.5;\n    text-align: left;\n  }\n  .esg-vtrack .esg-form__notice strong { letter-spacing: 0.04em; }\n  .esg-vtrack .esg-form__group { margin-bottom: 20px; }\n  .esg-vtrack .esg-form__label {\n    display: block;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #C9D6F2;\n    margin-bottom: 8px;\n  }\n  .esg-vtrack .esg-form__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n  }\n  .esg-vtrack .esg-form input,\n  .esg-vtrack .esg-form select,\n  .esg-vtrack .esg-form textarea {\n    width: 100%;\n    background: rgba(255,255,255,0.05);\n    border: 1px solid rgba(255,255,255,0.2);\n    color: #ffffff;\n    font-family: inherit;\n    font-size: 16px;\n    padding: 14px 16px;\n    border-radius: 2px;\n    outline: none;\n    transition: border-color 0.2s;\n    box-sizing: border-box;\n  }\n  .esg-vtrack .esg-form input::placeholder,\n  .esg-vtrack .esg-form textarea::placeholder { color: rgba(255,255,255,0.4); }\n  .esg-vtrack .esg-form input:focus,\n  .esg-vtrack .esg-form select:focus,\n  .esg-vtrack .esg-form textarea:focus { border-color: #ffffff; }\n  .esg-vtrack .esg-form select {\n    appearance: none;\n    -webkit-appearance: none;\n    -moz-appearance: none;\n    background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%23ffffff' d='M6 8L0 0h12z'/></svg>\");\n    background-repeat: no-repeat;\n    background-position: right 18px center;\n    padding-right: 44px;\n    cursor: pointer;\n  }\n  .esg-vtrack .esg-form select option { background: #0A1A3A; color: #ffffff; }\n  .esg-vtrack .esg-form textarea { min-height: 160px; resize: vertical; }\n  .esg-vtrack .esg-form__submit { text-align: center; margin-top: 12px; }\n\n  /* ---------- Mobile ---------- */\n  @media (max-width: 768px) {\n    .esg-vtrack .esg-section { padding: 64px 0; }\n    .esg-vtrack .esg-row { grid-template-columns: 1fr; gap: 32px; }\n    .esg-vtrack .esg-row--reverse { direction: ltr; }\n    .esg-vtrack .esg-trust__grid { grid-template-columns: repeat(2, 1fr); }\n    .esg-vtrack .esg-dl-grid { grid-template-columns: 1fr; }\n    .esg-vtrack .esg-ts-step { grid-template-columns: 1fr; gap: 8px; padding: 24px; }\n    .esg-vtrack .esg-ts-step__num { font-size: 40px; }\n    .esg-vtrack .esg-room__row { grid-template-columns: 1fr; }\n    .esg-vtrack .esg-room__cell { border-right: none; border-bottom: 1px solid rgba(10,26,58,0.08); }\n    .esg-vtrack .esg-hero { min-height: 50vh; padding: 80px 24px; }\n    .esg-vtrack .esg-form__grid { grid-template-columns: 1fr; }\n  }\n</style>\n\n<div class=\"esg-vtrack\">\n\n  <!-- ============ HERO ============ -->\n  <section class=\"esg-hero\">\n    <div class=\"esg-hero__inner\">\n      <span class=\"esg-eyebrow\">Elite Sim Golf &middot; Setup &amp; Support</span>\n      <h1>VTrack Launch Monitor Setup &amp; Support</h1>\n      <p>Mount it. Plug it in. Calibrate it. Or skip all that and let us walk you through it &mdash; free, over video, on your schedule.</p>\n      <a href=\"#esg-contact\" class=\"esg-btn\">Schedule Free Setup</a>\n      &nbsp;\n      <a href=\"#esg-downloads\" class=\"esg-btn esg-btn--ghost\">Get The Files</a>\n    </div>\n  </section>\n\n  <!-- ============ TRUST STRIP ============ -->\n  <div class=\"esg-trust\">\n    <div class=\"esg-wrap\">\n      <div class=\"esg-trust__grid\">\n        <div class=\"esg-trust__item\">Free Remote Setup</div>\n        <div class=\"esg-trust__item\">Latest Toolkit Builds</div>\n        <div class=\"esg-trust__item\">Real Human Support</div>\n        <div class=\"esg-trust__item\">Text 865-248-2729</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ============ TOC ============ -->\n  <nav class=\"esg-toc\">\n    <div class=\"esg-wrap\">\n      <ul class=\"esg-toc__list\">\n        <li><a href=\"#esg-downloads\">Downloads</a></li>\n        <li><a href=\"#esg-step1\">Step 1 &middot; Mount</a></li>\n        <li><a href=\"#esg-step2\">Step 2 &middot; Software</a></li>\n        <li><a href=\"#esg-calibration\">Calibration</a></li>\n        <li><a href=\"#esg-remote\">Free Remote Setup</a></li>\n        <li><a href=\"#esg-troubleshooting\">Troubleshooting</a></li>\n        <li><a href=\"#esg-contact\">Contact Support</a></li>\n      </ul>\n    </div>\n  </nav>\n\n  <!-- ============ DOWNLOADS ============ -->\n  <section class=\"esg-section\" id=\"esg-downloads\">\n    <div class=\"esg-wrap\">\n      <div style=\"text-align:center; max-width:760px; margin:0 auto 16px;\">\n        <span class=\"esg-eyebrow\">Skip The Hunt</span>\n        <h2>The Files You Need.</h2>\n        <p class=\"lead\">Latest Toolkit software and manufacturer manuals, all in one place. We update these the day Laon Swingcraft ships a new build.</p>\n      </div>\n\n      <div class=\"esg-dl-grid\">\n        <div class=\"esg-dl-card esg-dl-card--primary\">\n          <div>\n            <div class=\"esg-dl-card__tag\">Software &middot; Latest</div>\n            <div class=\"esg-dl-card__title\">VTrackToolkit 2.2.8</div>\n            <p class=\"esg-dl-card__desc\">The bridge between the sensor and your sim software. Install once, calibrate once, you&rsquo;re playing.</p>\n          </div>\n          <a class=\"esg-btn\" href=\"https://swing-data.laon-app.com/public/release/VTrackToolKit_2.2.8_Release.zip\">Download ZIP</a>\n        </div>\n\n        <div class=\"esg-dl-card\">\n          <div>\n            <div class=\"esg-dl-card__tag\">Manual &middot; v1.0.4</div>\n            <div class=\"esg-dl-card__title\">VTrackToolkit Setup Manual</div>\n            <p class=\"esg-dl-card__desc\">Full software install + calibration walkthrough from the manufacturer.</p>\n          </div>\n          <a class=\"esg-btn esg-btn--ghost\" href=\"https://laonswingcraft.com/files/20260115_045000_VTrackToolKit_UserMaual_v1.0.4.pdf\">Open PDF</a>\n        </div>\n\n        <div class=\"esg-dl-card\">\n          <div>\n            <div class=\"esg-dl-card__tag\">Manual &middot; v1.1</div>\n            <div class=\"esg-dl-card__title\">Hardware Install (DX10)</div>\n            <p class=\"esg-dl-card__desc\">Ceiling mount, bracket, sensor, cabling &mdash; the full hardware reference.</p>\n          </div>\n          <a class=\"esg-btn esg-btn--ghost\" href=\"https://laonswingcraft.com/files/20260514_072738_20260515_Hardware_Installation_VTrack%20DX10_v1.1.pdf\">Open PDF</a>\n        </div>\n\n        <div class=\"esg-dl-card\">\n          <div>\n            <div class=\"esg-dl-card__tag\">Manual &middot; EN v1.0.1</div>\n            <div class=\"esg-dl-card__title\">Swing Camera Setup</div>\n            <p class=\"esg-dl-card__desc\">Add-on camera install + alignment instructions.</p>\n          </div>\n          <a class=\"esg-btn esg-btn--ghost\" href=\"https://laonswingcraft.com/files/20260512_083116_20260512_VTrackToolkit_Camera_Manual_EN_1.0.1.pdf\">Open PDF</a>\n        </div>\n      </div>\n\n      <p style=\"margin-top:24px; font-size:15px; opacity:0.8; text-align:center;\">Bookmark this page &mdash; these links always point at the freshest build. New version drops, we swap them within 24 hours.</p>\n    </div>\n  </section>\n\n  <!-- ============ STEP 1: MOUNT ============ -->\n  <section class=\"esg-section esg-section--alt\" id=\"esg-step1\">\n    <div class=\"esg-wrap\">\n      <div class=\"esg-row\">\n        <div>\n          <span class=\"esg-eyebrow\">Step 01</span>\n          <h2>Get It On The Ceiling.</h2>\n          <p class=\"lead\">An overhead launch monitor is a roughly 90-minute job for one person with a ladder. Mark twice, drill once.</p>\n          <p>Tools you&rsquo;ll need (not in the box): screwdriver, tape measure, drill, ladder. The included laser indicator handles level-checking and transferring your mount point to the ceiling.</p>\n        </div>\n        <div>\n          <h3>Measure Before You Mount</h3>\n          <ul class=\"esg-features\">\n            <li><strong>Tee to screen:</strong> at least <strong>9&prime;10&Prime;</strong> (3,000 mm)</li>\n            <li><strong>Floor to bottom of sensor:</strong> <strong>8&prime;6&Prime; &ndash; 9&prime;10&Prime;</strong> (2,600&ndash;3,000 mm)</li>\n            <li>Ceiling has to be <strong>level</strong> &mdash; check both directions with the included laser</li>\n            <li>Use the manual&rsquo;s table to find <strong>L</strong> based on your ceiling height <strong>H</strong></li>\n          </ul>\n          <div class=\"esg-callout\">\n            <div class=\"esg-callout__title\">Quick Conversion</div>\n            <p style=\"margin:0; font-weight:500; color:#0A1A3A;\">L (in) = L (mm) &divide; 25.4 &nbsp;&middot;&nbsp; or &nbsp;mm &times; 0.03937 = inches</p>\n          </div>\n        </div>\n      </div>\n\n      <div style=\"margin-top:64px;\">\n        <h3 style=\"text-align:center;\">The 90-Minute Procedure</h3>\n        <ol class=\"esg-steps\" style=\"max-width:920px; margin:32px auto 0;\">\n          <li><strong>Mark the mount point.</strong> Find the center of the hitting area and draw a line perpendicular to the screen. Measure forward toward the screen by <strong>L</strong> from the manual&rsquo;s table, then transfer that point up to the ceiling with the included laser.</li>\n          <li><strong>Install the bracket.</strong> Mount it with the <strong>7 included screws</strong>, parallel to the screen, level confirmed. Pro tip: temporarily hang the unit and run the calibration screen <em>before</em> fully tightening &mdash; saves a re-mount.</li>\n          <li><strong>Hang the sensor.</strong> The 4 sensor screws ship pre-installed &mdash; half-loosen them, hang the unit on the bracket, press up flush, then tighten all 4.</li>\n          <li><strong>Power &amp; data.</strong> Plug power into the supply adapter. Run the included <strong>CAT6 Ethernet</strong> from sensor directly to your PC NIC &mdash; skip routers and switches.</li>\n          <li><strong>Confirm lights.</strong> Flip the sensor power switch. <strong>Red = power</strong>, <strong>green = Ethernet activity</strong>. If green doesn&rsquo;t blink, the cable, port, or NIC needs attention &mdash; see the Troubleshooting Guide below.</li>\n        </ol>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ STEP 2: SOFTWARE ============ -->\n  <section class=\"esg-section\" id=\"esg-step2\">\n    <div class=\"esg-wrap\">\n      <div style=\"text-align:center; max-width:760px; margin:0 auto 16px;\">\n        <span class=\"esg-eyebrow\">Step 02</span>\n        <h2>Get The Software Talking To The Sensor.</h2>\n        <p class=\"lead\">VTrackToolkit is the bridge between the unit and your sim software. Install it once, calibrate it once, and you&rsquo;re playing.</p>\n      </div>\n\n      <div class=\"esg-row\" style=\"margin-top:48px;\">\n        <div>\n          <h3>Install Or Update Toolkit</h3>\n          <ul class=\"esg-features\">\n            <li><strong>Updating?</strong> Uninstall the old VTrackToolkit from Windows <em>Apps &amp; features</em> first</li>\n            <li>Grab the <a href=\"#esg-downloads\">latest Toolkit ZIP</a>, unzip, and run the MSI</li>\n            <li>Click through the install wizard &mdash; pick a folder if you care, accept the UAC prompt</li>\n          </ul>\n        </div>\n        <div>\n          <h3>Verify The Install</h3>\n          <p>Open the Windows <strong>Start menu</strong> and type <strong>VTrack</strong>. If the program shows up, the install worked. Now make it easy to launch next time:</p>\n\n          <div class=\"esg-callout\">\n            <div class=\"esg-callout__title\">Method 1 &middot; Recommended</div>\n            <div class=\"esg-callout__heading\">Pin To Taskbar</div>\n            <ol style=\"margin:0; padding-left:20px;\">\n              <li>Search for <strong>VTrack</strong> from the Start menu</li>\n              <li>Right-click the VTrack icon</li>\n              <li>Select <strong>Pin to taskbar</strong></li>\n            </ol>\n          </div>\n\n          <div class=\"esg-callout\">\n            <div class=\"esg-callout__title\">Method 2 &middot; Optional</div>\n            <div class=\"esg-callout__heading\">Create A Desktop Shortcut</div>\n            <ol style=\"margin:0; padding-left:20px;\">\n              <li>Press <strong>Windows&nbsp;+&nbsp;R</strong></li>\n              <li>Enter <strong>shell:AppsFolder</strong> and click OK</li>\n              <li>Find <strong>VTrack</strong> in the list, right-click it</li>\n              <li>Select <strong>Create shortcut</strong></li>\n              <li>Click <strong>Yes</strong> when prompted to put it on the desktop</li>\n            </ol>\n          </div>\n        </div>\n      </div>\n\n      <div style=\"margin-top:64px;\">\n        <h3 style=\"text-align:center;\">Connect PC To Sensor</h3>\n        <ol class=\"esg-steps\" style=\"max-width:920px; margin:32px auto 0;\">\n          <li><strong>Open Toolkit Settings.</strong> Go to <strong>Device / Network</strong>, pick the sensor from the list, click Connect. Successful connection should display in the panel.</li>\n          <li><strong>If it doesn&rsquo;t see the unit:</strong> Recheck cable seating at both ends, run manual NIC config (static IP, Jumbo Packet enabled, receive/transmit buffers maxed), and confirm Windows Firewall and antivirus aren&rsquo;t blocking the Toolkit.</li>\n          <li><strong>Full walkthrough:</strong> The <a href=\"#esg-troubleshooting\">Troubleshooting Guide</a> at the bottom of this page covers the exact NIC settings, static IP values, and firewall paths you need.</li>\n        </ol>\n\n        <div class=\"esg-callout esg-callout--red\" style=\"max-width:920px; margin:32px auto 0;\">\n          <p style=\"margin:0;\">Seeing <strong>Calibration Error &ldquo;1001&rdquo;</strong> or no camera image? Jump to the <a href=\"#esg-troubleshooting\"><strong style=\"color:#0A1A3A;\">Troubleshooting Guide</strong></a> and start at Step 1.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ CALIBRATION (dark band) ============ -->\n  <section class=\"esg-section esg-section--dark\" id=\"esg-calibration\">\n    <div class=\"esg-wrap\" style=\"max-width:920px;\">\n      <div style=\"text-align:center;\">\n        <span class=\"esg-eyebrow\">Calibration &middot; The Critical Step</span>\n        <h2>Skip This And Your Numbers Will Lie To You.</h2>\n        <p>This is the 10 minutes that separates a launch monitor from a guessing machine. Do it once, do it right, and you&rsquo;re done.</p>\n      </div>\n\n      <ol class=\"esg-steps\" style=\"margin-top:40px;\">\n        <li><strong>Place the calibration board</strong> with the <strong style=\"color:#fff;\">&ldquo;SCREEN&rdquo;</strong> label facing the screen, vertically aligned.</li>\n        <li><strong>Toolkit &rarr; Settings &rarr; Calibration.</strong> Align the board inside the on-screen guide box. Run it.</li>\n        <li><strong>Run Ball Check.</strong> Place a ball in each indicated section to confirm the unit detects across the full hitting zone.</li>\n        <li><strong>Set Area Settings.</strong> Define your Ready and Tee zones, click Apply.</li>\n        <li><strong>Fire up your sim.</strong> In the Toolkit&rsquo;s <strong style=\"color:#fff;\">Game / Simulator</strong> area, pick your sim (GSPro, E6, etc.), reload if prompted, launch, dial in putting speed, and tee it up.</li>\n      </ol>\n    </div>\n  </section>\n\n  <!-- ============ FREE REMOTE SETUP ============ -->\n  <section class=\"esg-section esg-section--tight\" id=\"esg-remote\">\n    <div class=\"esg-wrap\" style=\"max-width:900px; text-align:center;\">\n      <span class=\"esg-eyebrow\">Or Skip All Of That</span>\n      <h2>Free Remote Setup. We&rsquo;ll Do It With You.</h2>\n      <p class=\"lead\">Every VTrack purchased from Elite Sim Golf includes a free remote setup session. We&rsquo;ll hop on a video call, walk you through Toolkit, get the sensor talking to your PC, and run calibration together.</p>\n      <p>Most sessions take about an hour. Bring the PC, the unit on the ceiling, and a cup of coffee &mdash; we&rsquo;ll handle the rest.</p>\n      <p style=\"margin-top:28px;\">\n        <a href=\"#esg-contact\" class=\"esg-btn\" data-esg-prefill=\"setup\">Schedule My Setup</a>\n        &nbsp;\n        <a href=\"sms:865-248-2729\" class=\"esg-btn esg-btn--ghost\">Text 865-248-2729</a>\n      </p>\n    </div>\n  </section>\n\n  <!-- ============ TROUBLESHOOTING ============ -->\n  <section class=\"esg-section esg-section--alt\" id=\"esg-troubleshooting\">\n    <div class=\"esg-wrap\">\n      <div style=\"text-align:center; max-width:820px; margin:0 auto;\">\n        <span class=\"esg-eyebrow\">Troubleshooting &middot; Updated 1/20/2026</span>\n        <h2>VTrack Troubleshooting Guide</h2>\n        <p class=\"lead\">Network Error or Calibration Error &ldquo;1001&rdquo; &mdash; work through these in order. Most setups clear up by Step 4.</p>\n      </div>\n\n      <div class=\"esg-ts-grid\">\n\n        <div class=\"esg-ts-step\">\n          <div class=\"esg-ts-step__num\">01</div>\n          <div class=\"esg-ts-step__body\">\n            <div class=\"esg-ts-step__tag\">Network Card</div>\n            <h3>Use A Real Intel NIC.</h3>\n            <p>USB-to-Ethernet adapters <strong>won&rsquo;t work</strong> &mdash; the Jumbo Packet, Receive Buffer, and Transmit Buffer menus aren&rsquo;t available on them.</p>\n            <p>Recommended: <strong>Intel Pro/1000 (EXPI9301CT)</strong> &mdash; a single-channel Intel NIC that supports Jumbo Packet and 2048+ Receive/Transmit Descriptors.</p>\n          </div>\n        </div>\n\n        <div class=\"esg-ts-step\">\n          <div class=\"esg-ts-step__num\">02</div>\n          <div class=\"esg-ts-step__body\">\n            <div class=\"esg-ts-step__tag\">Direct Connection</div>\n            <h3>Skip Routers And Switches.</h3>\n            <p>Run the provided <strong>Cat6 / 65&prime; LAN cable</strong> (20 m) straight from the PC NIC to the VTrack.</p>\n            <p>Lights on the unit: <strong>red = power</strong>, <strong>green = blinking</strong> data activity. No green blink means cable, port, or NIC issue.</p>\n          </div>\n        </div>\n\n        <div class=\"esg-ts-step\">\n          <div class=\"esg-ts-step__num\">03</div>\n          <div class=\"esg-ts-step__body\">\n            <div class=\"esg-ts-step__tag\">Static IP</div>\n            <h3>Set Manual IPv4.</h3>\n            <p>Windows: <strong>Network Connections &rarr; Ethernet adapter Properties &rarr; IPv4 Properties</strong>. Set:</p>\n            <div class=\"esg-code\">\n              IP address&nbsp;&nbsp;&nbsp;&nbsp;172.16.1.100<br>\n              Subnet mask&nbsp;&nbsp;&nbsp;255.255.255.0\n            </div>\n            <p>Click OK, disable the adapter, re-enable it, then restart the Toolkit.</p>\n          </div>\n        </div>\n\n        <div class=\"esg-ts-step\">\n          <div class=\"esg-ts-step__num\">04</div>\n          <div class=\"esg-ts-step__body\">\n            <div class=\"esg-ts-step__tag\">NIC Settings</div>\n            <h3>Tune The Advanced Tab.</h3>\n            <p><strong>Device Manager &rarr; Network Adapters</strong> &rarr; right-click your NIC &rarr; <strong>Properties &rarr; Advanced</strong> tab. Set:</p>\n            <div class=\"esg-code\">\n              Jumbo Packet&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;9014 Bytes<br>\n              Receive Buffers&nbsp;&nbsp;&nbsp;max (2048+)<br>\n              Transmit Buffers&nbsp;&nbsp;max (2048+)\n            </div>\n            <p>Restart the PC after applying.</p>\n          </div>\n        </div>\n\n        <div class=\"esg-ts-step\">\n          <div class=\"esg-ts-step__num\">05</div>\n          <div class=\"esg-ts-step__body\">\n            <div class=\"esg-ts-step__tag\">Firewall</div>\n            <h3>Allow LPGAgent Through.</h3>\n            <p>Allow <strong>LPGAgent</strong> through Windows Firewall for both <strong>Private</strong> and <strong>Public</strong> networks. Path:</p>\n            <div class=\"esg-code\">C:\\Program Files\\WindowsApps\\02ce737d-b4f8-4bbb-92b2-1355681ff1e8_2.1.5.0_x64__qbntr2denpnae\\LPGAgent</div>\n          </div>\n        </div>\n\n        <div class=\"esg-ts-step\">\n          <div class=\"esg-ts-step__num\">06</div>\n          <div class=\"esg-ts-step__body\">\n            <div class=\"esg-ts-step__tag\">No Camera Image</div>\n            <h3>Reseat, Disable AV, Restart.</h3>\n            <p>Reseat the LAN cable on <strong>both ends</strong>, disable or uninstall antivirus, and power restart both the VTrack and the PC.</p>\n            <p><em>Why:</em> antivirus often blocks the camera&rsquo;s video input stream before it reaches the Toolkit.</p>\n          </div>\n        </div>\n\n        <div class=\"esg-ts-step\">\n          <div class=\"esg-ts-step__num\">07</div>\n          <div class=\"esg-ts-step__body\">\n            <div class=\"esg-ts-step__tag\">Hard Power Cycle</div>\n            <h3>Drain The Capacitors.</h3>\n            <p>Power down the VTrack <strong>and</strong> the PC, disconnect the network cable, wait <strong>60+ seconds</strong>, reconnect, then power on.</p>\n            <p><em>Why:</em> the wait drains residual capacitors and forces a fresh network handshake on boot.</p>\n          </div>\n        </div>\n\n        <div class=\"esg-ts-step esg-ts-step--error\">\n          <div class=\"esg-ts-step__num\">08</div>\n          <div class=\"esg-ts-step__body\">\n            <div class=\"esg-ts-step__tag\">Error Code &middot; 1001</div>\n            <h3>Calibration Error &ldquo;1001&rdquo;.</h3>\n            <p>Refer back to <strong>Steps 1&ndash;7</strong> above and start with <strong>Step 1 (Network Card)</strong>. Error 1001 is almost always a NIC capability or buffer issue &mdash; verify you&rsquo;re on a supported Intel NIC with Jumbo Packet 9014 and Receive/Transmit Buffers at 2048+ before retrying calibration.</p>\n          </div>\n        </div>\n\n      </div>\n\n      <p style=\"text-align:center; margin-top:32px; font-size:16px;\">Still stuck after Step 7? <a href=\"mailto:support@elitesimgolf.com?subject=VTrack%20Support\"><strong>Email support</strong></a> or text <a href=\"sms:865-248-2729\"><strong>865-248-2729</strong></a>. We&rsquo;ll hop on a remote session and finish it with you.</p>\n    </div>\n  </section>\n\n  <!-- ============ CONTACT FORM ============ -->\n  <section class=\"esg-section esg-section--dark\" id=\"esg-contact\" style=\"padding-bottom:64px;\">\n    <div class=\"esg-wrap\" style=\"max-width:820px; text-align:center;\">\n      <span class=\"esg-eyebrow\">VTrack Support Request</span>\n      <h2>Open A Support Ticket.</h2>\n      <p>Tell us what&rsquo;s happening and we&rsquo;ll get back to you fast &mdash; usually same day, often within the hour.</p>\n\n      <div class=\"esg-form__notice\">\n        <strong>Elite Sim Golf customers only.</strong> This form is for VTrack units purchased through Elite Sim Golf. Didn&rsquo;t buy from us? Contact your original dealer or Laon Swingcraft directly &mdash; we&rsquo;re not able to support units sold elsewhere.\n      </div>\n\n      <form class=\"esg-form\" id=\"esg-support-form\" action=\"mailto:support@elitesimgolf.com\" method=\"post\" enctype=\"text/plain\">\n        <div class=\"esg-form__group\">\n          <label class=\"esg-form__label\" for=\"esg-c-type\">Request Type</label>\n          <select id=\"esg-c-type\" name=\"Request_Type\" required>\n            <option value=\"Support Request\">Support Request</option>\n            <option value=\"Free Remote Setup Request\">Free Remote Setup Request</option>\n          </select>\n        </div>\n\n        <div class=\"esg-form__grid\">\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-c-name\">Name</label>\n            <input type=\"text\" id=\"esg-c-name\" name=\"Name\" placeholder=\"First &amp; Last\" required>\n          </div>\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-c-email\">Email</label>\n            <input type=\"email\" id=\"esg-c-email\" name=\"Email\" placeholder=\"you@example.com\" required>\n          </div>\n        </div>\n\n        <div class=\"esg-form__grid\">\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-c-phone\">Phone</label>\n            <input type=\"tel\" id=\"esg-c-phone\" name=\"Phone\" placeholder=\"(555) 555-5555\" required>\n          </div>\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-c-order\">Order Number</label>\n            <input type=\"text\" id=\"esg-c-order\" name=\"Order_Number\" placeholder=\"#1234 or ESG-1234\" required>\n          </div>\n        </div>\n\n        <div class=\"esg-form__group\">\n          <label class=\"esg-form__label\" for=\"esg-c-issue\" id=\"esg-c-issue-label\">What&rsquo;s The Issue?</label>\n          <textarea id=\"esg-c-issue\" name=\"Details\" placeholder=\"Describe what&rsquo;s happening &mdash; error codes, when it started, what you&rsquo;ve already tried. The more detail, the faster we can help.\" required></textarea>\n        </div>\n\n        <div class=\"esg-form__submit\">\n          <button type=\"submit\" class=\"esg-btn\" id=\"esg-c-submit\">Send Support Request</button>\n        </div>\n      </form>\n\n      <script>\n        (function() {\n          var form = document.getElementById('esg-support-form');\n          var typeSel = document.getElementById('esg-c-type');\n          var label = document.getElementById('esg-c-issue-label');\n          var textarea = document.getElementById('esg-c-issue');\n          var submitBtn = document.getElementById('esg-c-submit');\n\n          var config = {\n            'Support Request': {\n              subject: 'VTrack Support Request',\n              label: 'What\\u2019s The Issue?',\n              placeholder: 'Describe what\\u2019s happening \\u2014 error codes, when it started, what you\\u2019ve already tried. The more detail, the faster we can help.',\n              submit: 'Send Support Request'\n            },\n            'Free Remote Setup Request': {\n              subject: 'Free Remote Setup Request',\n              label: 'Tell Us About Your Setup',\n              placeholder: 'Best days/times for a video call, your time zone, what PC you\\u2019re using, and anything else we should know before we hop on.',\n              submit: 'Request Free Setup'\n            }\n          };\n\n          function applyType(value) {\n            var cfg = config[value] || config['Support Request'];\n            form.action = 'mailto:support@elitesimgolf.com?subject=' + encodeURIComponent(cfg.subject);\n            label.textContent = cfg.label;\n            textarea.setAttribute('placeholder', cfg.placeholder);\n            submitBtn.textContent = cfg.submit;\n          }\n\n          typeSel.addEventListener('change', function() { applyType(this.value); });\n\n          // Prefill from \"Schedule My Setup\" buttons\n          document.querySelectorAll('[data-esg-prefill=\"setup\"]').forEach(function(btn) {\n            btn.addEventListener('click', function() {\n              typeSel.value = 'Free Remote Setup Request';\n              applyType('Free Remote Setup Request');\n              setTimeout(function() {\n                var nameField = document.getElementById('esg-c-name');\n                if (nameField) nameField.focus({ preventScroll: true });\n              }, 600);\n            });\n          });\n\n          applyType(typeSel.value);\n        })();\n      </script>\n\n      <p style=\"margin-top:32px; font-size:15px; color:#C9D6F2;\">Prefer to skip the form? Email <a href=\"mailto:support@elitesimgolf.com?subject=VTrack%20Support\" style=\"color:#ffffff;\"><strong>support@elitesimgolf.com</strong></a> or text <a href=\"sms:865-248-2729\" style=\"color:#ffffff;\"><strong>865-248-2729</strong></a>.</p>\n    </div>\n  </section>\n\n\n</div>",
        "full_width": true,
        "show_space": false,
        "boundary_effect": ""
      }
    }
  },
