-top: 48px;\n  }\n  .esg-vtrack-partner .esg-process__item {\n    background: #ffffff;\n    border: 1px solid rgba(10,26,58,0.08);\n    border-radius: 4px;\n    padding: 32px 28px;\n    position: relative;\n  }\n  .esg-vtrack-partner .esg-process__num {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 800;\n    font-size: 48px;\n    line-height: 1;\n    color: #0A1A3A;\n    margin-bottom: 12px;\n  }\n  .esg-vtrack-partner .esg-process__title {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 20px;\n    color: #0A1A3A;\n    margin-bottom: 8px;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n  }\n  .esg-vtrack-partner .esg-process__body { font-size: 15px; color: #2a3756; line-height: 1.55; margin: 0; }\n  /* Force readable text inside white cards even when sitting on a dark section */\n  .esg-vtrack-partner .esg-section--dark .esg-process__item p,\n  .esg-vtrack-partner .esg-section--dark .esg-process__body { color: #2a3756; }\n  .esg-vtrack-partner .esg-section--dark .esg-process__num,\n  .esg-vtrack-partner .esg-section--dark .esg-process__title { color: #0A1A3A; }\n\n  /* ---------- FAQ ---------- */\n  .esg-vtrack-partner .esg-faq {\n    margin-top: 40px;\n    max-width: 880px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n  .esg-vtrack-partner .esg-faq__item {\n    background: #ffffff;\n    border: 1px solid rgba(10,26,58,0.08);\n    border-radius: 4px;\n    padding: 24px 28px;\n    margin-bottom: 14px;\n  }\n  .esg-vtrack-partner .esg-faq__q {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 21px;\n    color: #0A1A3A;\n    margin: 0 0 10px;\n    letter-spacing: 0.01em;\n  }\n  .esg-vtrack-partner .esg-faq__a { margin: 0; font-size: 16px; color: #2a3756; }\n\n  /* ---------- Form ---------- */\n  .esg-vtrack-partner .esg-form { max-width: 820px; margin: 32px auto 0; }\n  .esg-vtrack-partner .esg-form__notice {\n    max-width: 820px;\n    margin: 0 auto 24px;\n    padding: 14px 20px;\n    background: rgba(255,255,255,0.06);\n    border-left: 3px solid #ffffff;\n    color: #ffffff;\n    font-size: 15px;\n    line-height: 1.5;\n    text-align: left;\n  }\n  .esg-vtrack-partner .esg-form__notice strong { color: #ffffff; letter-spacing: 0.04em; }\n  .esg-vtrack-partner .esg-form__group { margin-bottom: 20px; }\n  .esg-vtrack-partner .esg-form__label {\n    display: block;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #C9D6F2;\n    margin-bottom: 8px;\n  }\n  .esg-vtrack-partner .esg-form__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n  }\n  .esg-vtrack-partner .esg-form input,\n  .esg-vtrack-partner .esg-form select,\n  .esg-vtrack-partner .esg-form textarea {\n    width: 100%;\n    background: rgba(255,255,255,0.05);\n    border: 1px solid rgba(255,255,255,0.2);\n    color: #ffffff;\n    font-family: inherit;\n    font-size: 16px;\n    padding: 14px 16px;\n    border-radius: 2px;\n    outline: none;\n    transition: border-color 0.2s;\n    box-sizing: border-box;\n  }\n  .esg-vtrack-partner .esg-form input::placeholder,\n  .esg-vtrack-partner .esg-form textarea::placeholder { color: rgba(255,255,255,0.4); }\n  .esg-vtrack-partner .esg-form input:focus,\n  .esg-vtrack-partner .esg-form select:focus,\n  .esg-vtrack-partner .esg-form textarea:focus { border-color: #ffffff; }\n  .esg-vtrack-partner .esg-form select {\n    appearance: none;\n    -webkit-appearance: none;\n    -moz-appearance: none;\n    background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%23ffffff' d='M6 8L0 0h12z'/></svg>\");\n    background-repeat: no-repeat;\n    background-position: right 18px center;\n    padding-right: 44px;\n    cursor: pointer;\n  }\n  .esg-vtrack-partner .esg-form select option { background: #0A1A3A; color: #ffffff; }\n  .esg-vtrack-partner .esg-form textarea { min-height: 140px; resize: vertical; }\n  .esg-vtrack-partner .esg-form__submit { text-align: center; margin-top: 12px; }\n\n  /* ---------- Mobile ---------- */\n  @media (max-width: 768px) {\n    .esg-vtrack-partner .esg-section { padding: 64px 0; }\n    .esg-vtrack-partner .esg-wrap { padding: 0 24px; }\n    .esg-vtrack-partner .esg-hero { min-height: 50vh; padding: 80px 24px; }\n    .esg-vtrack-partner .esg-trust__grid { grid-template-columns: 1fr; gap: 10px; }\n    .esg-vtrack-partner .esg-paths { grid-template-columns: 1fr; gap: 20px; }\n    .esg-vtrack-partner .esg-row { grid-template-columns: 1fr; gap: 32px; }\n    .esg-vtrack-partner .esg-row--reverse { direction: ltr; }\n    .esg-vtrack-partner .esg-row__img { min-height: 280px; }\n    .esg-vtrack-partner .esg-stats { grid-template-columns: repeat(2, 1fr); }\n    .esg-vtrack-partner .esg-stats__item:nth-child(2) { border-right: none; }\n    .esg-vtrack-partner .esg-stats__item:nth-child(1),\n    .esg-vtrack-partner .esg-stats__item:nth-child(2) { border-bottom: 1px solid rgba(10,26,58,0.12); }\n    .esg-vtrack-partner .esg-reqs__row { grid-template-columns: 1fr; }\n    .esg-vtrack-partner .esg-reqs__cell { border-right: none; border-bottom: 1px solid rgba(10,26,58,0.08); }\n    .esg-vtrack-partner .esg-process { grid-template-columns: 1fr 1fr; gap: 16px; }\n    .esg-vtrack-partner .esg-form__grid { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 520px) {\n    .esg-vtrack-partner .esg-process { grid-template-columns: 1fr; }\n  }\n</style>\n\n<div class=\"esg-vtrack-partner\">\n\n  <!-- ============ HERO ============ -->\n  <section class=\"esg-hero\">\n    <div class=\"esg-hero__inner\">\n      <span class=\"esg-eyebrow\">Elite Sim Golf &middot; Partner Program</span>\n      <h1>Sell And Install The VTrack. Build A Better Business.</h1>\n      <p>Join the network of sim builders, golf retailers, and resellers offering the VTrack overhead launch monitor &mdash; with dealer pricing and a real support team behind every install.</p>\n      <a href=\"#esg-apply\" class=\"esg-btn\">Apply To Partner</a>\n      &nbsp;\n      <a href=\"#esg-tracks\" class=\"esg-btn esg-btn--ghost\">See The Tracks</a>\n    </div>\n  </section>\n\n  <!-- ============ TRUST STRIP ============ -->\n  <section class=\"esg-trust\">\n    <div class=\"esg-trust__grid\">\n      <div class=\"esg-trust__item\">Dealer Pricing</div>\n      <div class=\"esg-trust__item\">Factory-Direct Projectors</div>\n      <div class=\"esg-trust__item\">ESG-Backed Support</div>\n    </div>\n  </section>\n\n  <!-- ============ INTRO ============ -->\n  <section class=\"esg-section esg-section--alt\">\n    <div class=\"esg-wrap\" style=\"max-width:920px; text-align:center;\">\n      <span class=\"esg-eyebrow\">Why Partner With Elite Sim Golf</span>\n      <h2>Premium Gear. Honest Pricing. Real Support.</h2>\n      <p class=\"lead\">Elite Sim Golf sells launch monitors and full sim setups that actually work &mdash; backed by techs who pick up the phone. We&rsquo;re looking for partners who hold the same standard: sim builders, AV integrators, golf retailers, pro shops, and golf sim resellers who want to add the VTrack to their lineup without going it alone.</p>\n      <p>Whether you sell, install, or both &mdash; there&rsquo;s a track for you below.</p>\n    </div>\n  </section>\n\n  <!-- ============ TWO TRACKS ============ -->\n  <section class=\"esg-section\" id=\"esg-tracks\">\n    <div class=\"esg-wrap\">\n      <div style=\"text-align:center;\">\n        <span class=\"esg-eyebrow\">Pick Your Track</span>\n        <h2>Two Ways To Partner. Pick One Or Both.</h2>\n        <p style=\"max-width:760px; margin:0 auto;\">Resellers move units. Installers put them on ceilings. Some partners do both &mdash; the application form lets you select either or both.</p>\n      </div>\n\n      <div class=\"esg-paths\">\n        <div class=\"esg-path\">\n          <span class=\"esg-path__tag\">Track 01</span>\n          <h3>Authorized Reseller</h3>\n          <p>For sim builders, golf retailers, pro shops, and golf sim resellers selling VTrack units to end customers as part of complete sim packages or as standalone launch monitors.</p>\n          <ul class=\"esg-path__bullets\">\n            <li>Dealer pricing on every unit, every order</li>\n            <li>Margin structure designed for real-world sim build economics</li>\n            <li>Listed on the official Elite Sim Golf authorized reseller directory</li>\n            <li>Tech support backed by ESG &mdash; your customers reach us when they need help</li>\n            <li>No territory locks, no minimum monthly volume</li>\n          </ul>\n          <a href=\"#esg-apply\" class=\"esg-btn\" data-esg-track=\"reseller\">Apply As Reseller</a>\n        </div>\n\n        <div class=\"esg-path\">\n          <span class=\"esg-path__tag\">Track 02</span>\n          <h3>Authorized Installer</h3>\n          <p>For independent installers, AV integrators, and sim builders who handle mounting, calibration, and on-site troubleshooting for customers who buy VTrack units directly from Elite Sim Golf.</p>\n          <ul class=\"esg-path__bullets\">\n            <li>Paid install jobs routed from Elite Sim Golf customers in your area</li>\n            <li>Direct access to ESG tech support during installs &mdash; you&rsquo;re never alone on a ladder</li>\n            <li>Listed on the official ESG installer directory by service area</li>\n            <li>Standard install kits, calibration procedure, and remote backup from our team</li>\n            <li>Flexible &mdash; take the jobs that fit your schedule</li>\n          </ul>\n          <a href=\"#esg-apply\" class=\"esg-btn\" data-esg-track=\"installer\">Apply As Installer</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ BENEFIT ROW 1: DEALER PRICING ============ -->\n  <section class=\"esg-section esg-section--alt\">\n    <div class=\"esg-wrap\">\n      <div class=\"esg-row\">\n        <div>\n          <span class=\"esg-eyebrow\">Benefit 01 &middot; Margin That Makes Sense</span>\n          <h2>Dealer Pricing You Can Actually Build A Business On.</h2>\n          <p>We know what it costs to run a sim build company &mdash; the labor, the screens, the projector mounts, the calls at 9pm. Our dealer pricing leaves enough margin on every VTrack unit to keep the lights on and the customers happy.</p>\n          <ul class=\"esg-features\">\n            <li>Tiered pricing &mdash; better margin as your volume grows</li>\n            <li>No minimum monthly purchase requirement to stay active</li>\n            <li><strong>Deep discounts on Elite Sim Golf enclosures</strong> &mdash; partner-only pricing on the full ESG enclosure lineup so you can spec complete bays at margin</li>\n            <li><strong>Factory-direct BenQ and Optoma pricing</strong> &mdash; we&rsquo;re factory-direct with both, so installers get partner discounts on the projectors you&rsquo;re already specifying</li>\n            <li>Promo windows on bundle pricing for full sim packages</li>\n            <li>Transparent pricing &mdash; no surprise fees, no MAP gymnastics</li>\n          </ul>\n        </div>\n        <div class=\"esg-row__img\" style=\"background-image: url('https://cdn.shopify.com/s/files/1/0692/9698/0162/files/install-vtrack-eagle.jpg');\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ BENEFIT ROW 2: ESG SUPPORT ============ -->\n  <section class=\"esg-section\">\n    <div class=\"esg-wrap\">\n      <div class=\"esg-row esg-row--reverse\">\n        <div>\n          <span class=\"esg-eyebrow\">Benefit 02 &middot; You Are Not Alone</span>\n          <h2>Tech Support Backed By Elite Sim Golf.</h2>\n          <p>The VTrack is a great unit. It&rsquo;s also a Windows networking puzzle the first time you set one up. We&rsquo;re the team that already solved those puzzles &mdash; and we&rsquo;re on call when you hit one.</p>\n          <ul class=\"esg-features\">\n            <li>Direct line to ESG techs during business hours &mdash; phone, text, or email</li>\n            <li>Remote sessions available for calibration issues, NIC config, error 1001</li>\n            <li>Internal partner-only documentation, install checklists, and troubleshooting flows</li>\n            <li>End customers can reach ESG support directly &mdash; you&rsquo;re not the only line of defense</li>\n            <li>Warranty and RMA handled by ESG &mdash; you don&rsquo;t hold defective inventory</li>\n          </ul>\n        </div>\n        <div class=\"esg-row__img\" style=\"background-image: url('https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=1400&auto=format&fit=crop');\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ STATS ============ -->\n  <section class=\"esg-section esg-section--alt esg-section--tight\">\n    <div class=\"esg-wrap\">\n      <div style=\"text-align:center;\">\n        <span class=\"esg-eyebrow\">The Program At A Glance</span>\n        <h2>Built For Partners Who Actually Build.</h2>\n      </div>\n      <div class=\"esg-stats\">\n        <div class=\"esg-stats__item\">\n          <div class=\"esg-stats__num\">2</div>\n          <div class=\"esg-stats__label\">Partner Tracks</div>\n        </div>\n        <div class=\"esg-stats__item\">\n          <div class=\"esg-stats__num\">0</div>\n          <div class=\"esg-stats__label\">Monthly Minimums</div>\n        </div>\n        <div class=\"esg-stats__item\">\n          <div class=\"esg-stats__num\">24h</div>\n          <div class=\"esg-stats__label\">Application Review</div>\n        </div>\n        <div class=\"esg-stats__item\">\n          <div class=\"esg-stats__num\">3</div>\n          <div class=\"esg-stats__label\">Brands &middot; One Account</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ REQUIREMENTS ============ -->\n  <section class=\"esg-section\">\n    <div class=\"esg-wrap\" style=\"max-width:1080px;\">\n      <div style=\"text-align:center;\">\n        <span class=\"esg-eyebrow\">What We Look For</span>\n        <h2>Partner Requirements.</h2>\n        <p style=\"max-width:720px; margin:0 auto;\">Clear, fair, no surprises. If you meet the requirements for your track, we&rsquo;ll fast-track your application.</p>\n      </div>\n\n      <div class=\"esg-reqs\">\n        <div class=\"esg-reqs__row esg-reqs__head\">\n          <div class=\"esg-reqs__cell\">Requirement</div>\n          <div class=\"esg-reqs__cell\">What It Means</div>\n          <div class=\"esg-reqs__cell\">Applies To</div>\n        </div>\n        <div class=\"esg-reqs__row\">\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__label\">Active Business</span></div>\n          <div class=\"esg-reqs__cell\">Registered LLC, Corp, or sole proprietor with current insurance for installation work.</div>\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__tag\">Both Tracks</span></div>\n        </div>\n        <div class=\"esg-reqs__row\">\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__label\">Resale License</span></div>\n          <div class=\"esg-reqs__cell\">Valid resale certificate for your state. We&rsquo;ll collect this during onboarding.</div>\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__tag\">Reseller</span></div>\n        </div>\n        <div class=\"esg-reqs__row\">\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__label\">Install Experience</span></div>\n          <div class=\"esg-reqs__cell\">Prior experience mounting overhead golf launch monitors, sim screens, AV equipment, or similar ceiling-mounted gear.</div>\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__tag\">Installer</span></div>\n        </div>\n        <div class=\"esg-reqs__row\">\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__label\">VTrack Training</span></div>\n          <div class=\"esg-reqs__cell\">Complete the ESG-led video training on VTrack mount geometry, calibration, and Toolkit setup before your first install.</div>\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__tag\">Installer</span></div>\n        </div>\n        <div class=\"esg-reqs__row\">\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__label\">Customer Standards</span></div>\n          <div class=\"esg-reqs__cell\">Commit to ESG&rsquo;s honest-pricing, no-surprise policy. Treat customers the way we treat them &mdash; like golfers, not marks.</div>\n          <div class=\"esg-reqs__cell\"><span class=\"esg-reqs__tag\">Both Tracks</span></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ PROCESS (dark band) ============ -->\n  <section class=\"esg-section esg-section--dark\">\n    <div class=\"esg-wrap\">\n      <div style=\"text-align:center;\">\n        <span class=\"esg-eyebrow\">How It Works</span>\n        <h2>From Application To First Order.</h2>\n        <p style=\"max-width:720px; margin:0 auto;\">No long onboarding gauntlet. Apply, talk to us, get set up, start working.</p>\n      </div>\n      <div class=\"esg-process\">\n        <div class=\"esg-process__item\">\n          <div class=\"esg-process__num\">01</div>\n          <div class=\"esg-process__title\">Apply</div>\n          <p class=\"esg-process__body\">Fill out the form at the bottom of this page. Takes about 3 minutes.</p>\n        </div>\n        <div class=\"esg-process__item\">\n          <div class=\"esg-process__num\">02</div>\n          <div class=\"esg-process__title\">Quick Call</div>\n          <p class=\"esg-process__body\">15-minute call with our partner team to align on track, geography, and goals.</p>\n        </div>\n        <div class=\"esg-process__item\">\n          <div class=\"esg-process__num\">03</div>\n          <div class=\"esg-process__title\">Onboard</div>\n          <p class=\"esg-process__body\">Resellers get dealer portal access; installers complete VTrack training.</p>\n        </div>\n        <div class=\"esg-process__item\">\n          <div class=\"esg-process__num\">04</div>\n          <div class=\"esg-process__title\">Get To Work</div>\n          <p class=\"esg-process__body\">First orders, first installs, first leads routed your way. We&rsquo;re on call.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ FAQ ============ -->\n  <section class=\"esg-section esg-section--alt\">\n    <div class=\"esg-wrap\">\n      <div style=\"text-align:center;\">\n        <span class=\"esg-eyebrow\">Common Questions</span>\n        <h2>Before You Apply.</h2>\n      </div>\n      <div class=\"esg-faq\">\n        <div class=\"esg-faq__item\">\n          <p class=\"esg-faq__q\">Do I need to carry inventory?</p>\n          <p class=\"esg-faq__a\">No. We ship directly on each order. Stock if you want for faster delivery to your customers, but it&rsquo;s not required.</p>\n        </div>\n        <div class=\"esg-faq__item\">\n          <p class=\"esg-faq__q\">Can I be both a reseller and an installer?</p>\n          <p class=\"esg-faq__a\">Yes &mdash; check both tracks on the application. Many of our best partners sell and install.</p>\n        </div>\n        <div class=\"esg-faq__item\">\n          <p class=\"esg-faq__q\">Is there a territory lock?</p>\n          <p class=\"esg-faq__a\">No exclusive territories. We do route installer leads geographically, but resellers can sell wherever they sell.</p>\n        </div>\n        <div class=\"esg-faq__item\">\n          <p class=\"esg-faq__q\">What does the dealer margin actually look like?</p>\n          <p class=\"esg-faq__a\">We share full pricing tiers after your application is approved &mdash; not in a public document. Hop on the intro call and we&rsquo;ll walk you through it.</p>\n        </div>\n        <div class=\"esg-faq__item\">\n          <p class=\"esg-faq__q\">How long does approval take?</p>\n          <p class=\"esg-faq__a\">Most applications get a response within 24 business hours. Full onboarding usually takes 3&ndash;5 business days after the intro call.</p>\n        </div>\n        <div class=\"esg-faq__item\">\n          <p class=\"esg-faq__q\">Do I have to sell only VTrack?</p>\n          <p class=\"esg-faq__a\">No. Carry whatever lineup makes sense for your customers. We just want to be on it.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ APPLICATION FORM (dark) ============ -->\n  <section class=\"esg-section esg-section--dark\" id=\"esg-apply\" style=\"padding-bottom:72px;\">\n    <div class=\"esg-wrap\" style=\"max-width:880px; text-align:center;\">\n      <span class=\"esg-eyebrow\">Partner Application</span>\n      <h2>Apply To Become A VTrack Partner.</h2>\n      <p>Three minutes. We&rsquo;ll get back to you within 24 business hours.</p>\n\n      <div class=\"esg-form__notice\">\n        <strong>For businesses only.</strong> This program is for sim builders, AV integrators, golf retailers, pro shops, and resellers. Looking to buy a VTrack as an end customer? Head to <a href=\"https://elitesimgolf.com\" style=\"color:#fff;\"><strong>elitesimgolf.com</strong></a> instead.\n      </div>\n\n      <form class=\"esg-form\" id=\"esg-partner-form\" action=\"mailto:sales@elitesimgolf.com\" method=\"post\" enctype=\"text/plain\">\n        <div class=\"esg-form__group\">\n          <label class=\"esg-form__label\" for=\"esg-p-track\">Partner Track</label>\n          <select id=\"esg-p-track\" name=\"Partner_Track\" required>\n            <option value=\"Reseller\">Authorized Reseller</option>\n            <option value=\"Installer\">Authorized Installer</option>\n            <option value=\"Both\">Both &mdash; Reseller and Installer</option>\n          </select>\n        </div>\n\n        <div class=\"esg-form__grid\">\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-p-name\">Your Name</label>\n            <input type=\"text\" id=\"esg-p-name\" name=\"Name\" placeholder=\"First &amp; Last\" required>\n          </div>\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-p-company\">Company</label>\n            <input type=\"text\" id=\"esg-p-company\" name=\"Company\" placeholder=\"Business name\" required>\n          </div>\n        </div>\n\n        <div class=\"esg-form__grid\">\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-p-email\">Email</label>\n            <input type=\"email\" id=\"esg-p-email\" name=\"Email\" placeholder=\"you@yourcompany.com\" required>\n          </div>\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-p-phone\">Phone</label>\n            <input type=\"tel\" id=\"esg-p-phone\" name=\"Phone\" placeholder=\"(555) 555-5555\" required>\n          </div>\n        </div>\n\n        <div class=\"esg-form__grid\">\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-p-type\">Business Type</label>\n            <select id=\"esg-p-type\" name=\"Business_Type\" required>\n              <option value=\"\">Select one&hellip;</option>\n              <option value=\"Sim Builder / AV Integrator\">Sim Builder / AV Integrator</option>\n              <option value=\"Golf Retailer / Pro Shop\">Golf Retailer / Pro Shop</option>\n              <option value=\"Golf Sim Reseller\">Golf Sim Reseller</option>\n              <option value=\"Independent Installer\">Independent Installer</option>\n              <option value=\"Teaching Pro / Coach\">Teaching Pro / Coach</option>\n              <option value=\"Other\">Other</option>\n            </select>\n          </div>\n          <div class=\"esg-form__group\">\n            <label class=\"esg-form__label\" for=\"esg-p-years\">Years In Business</label>\n            <select id=\"esg-p-years\" name=\"Years_Operating\" required>\n              <option value=\"\">Select one&hellip;</option>\n              <option value=\"Less than 1 year\">Less than 1 year</option>\n              <option value=\"1-3 years\">1&ndash;3 years</option>\n              <option value=\"3-5 years\">3&ndash;5 years</option>\n              <option value=\"5-10 years\">5&ndash;10 years</option>\n              <option value=\"10+ years\">10+ years</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"esg-form__group\">\n          <label class=\"esg-form__label\" for=\"esg-p-area\">Service Area / Coverage Region</label>\n          <input type=\"text\" id=\"esg-p-area\" name=\"Service_Area\" placeholder=\"e.g. Greater Nashville, TN &middot; or &lsquo;Nationwide&rsquo; if you ship/install everywhere\" required>\n        </div>\n\n        <div class=\"esg-form__group\">\n          <label class=\"esg-form__label\" for=\"esg-p-web\">Website Or Portfolio Link</label>\n          <input type=\"url\" id=\"esg-p-web\" name=\"Website\" placeholder=\"https://yourcompany.com\">\n        </div>\n\n        <div class=\"esg-form__group\">\n          <label class=\"esg-form__label\" for=\"esg-p-brands\">Current Sim / Launch Monitor Brands Carried Or Installed</label>\n          <input type=\"text\" id=\"esg-p-brands\" name=\"Brands\" placeholder=\"e.g. Foresight, Uneekor, SkyTrak, GSPro, Full Swing &mdash; or &lsquo;None yet&rsquo;\">\n        </div>\n\n        <div class=\"esg-form__group\">\n          <label class=\"esg-form__label\" for=\"esg-p-notes\">Anything Else We Should Know</label>\n          <textarea id=\"esg-p-notes\" name=\"Notes\" placeholder=\"How many sim builds per month, key customer types, current volume, why VTrack interests you, questions about the program. Be as specific as you can.\"></textarea>\n        </div>\n\n        <div class=\"esg-form__submit\">\n          <button type=\"submit\" class=\"esg-btn\" id=\"esg-p-submit\">Submit Application</button>\n        </div>\n      </form>\n\n      <script>\n        (function() {\n          var form = document.getElementById('esg-partner-form');\n          var trackSel = document.getElementById('esg-p-track');\n\n          var subjects = {\n            'Reseller': 'VTrack Reseller Application',\n            'Installer': 'VTrack Installer Application',\n            'Both': 'VTrack Reseller + Installer Application'\n          };\n\n          function applyTrack(value) {\n            var subj = subjects[value] || 'VTrack Partner Application';\n            form.action = 'mailto:sales@elitesimgolf.com?subject=' + encodeURIComponent(subj);\n          }\n\n          trackSel.addEventListener('change', function() { applyTrack(this.value); });\n\n          // Prefill from \"Apply As Reseller\" / \"Apply As Installer\" buttons\n          document.querySelectorAll('[data-esg-track]').forEach(function(btn) {\n            btn.addEventListener('click', function() {\n              var t = this.getAttribute('data-esg-track');\n              if (t === 'reseller') trackSel.value = 'Reseller';\n              else if (t === 'installer') trackSel.value = 'Installer';\n              applyTrack(trackSel.value);\n              setTimeout(function() {\n                var nameField = document.getElementById('esg-p-name');\n                if (nameField) nameField.focus({ preventScroll: true });\n              }, 600);\n            });\n          });\n\n          applyTrack(trackSel.value);\n        })();\n      </script>\n\n      <p style=\"margin-top:32px; font-size:15px; color:#C9D6F2;\">Questions before applying? Email <a href=\"mailto:sales@elitesimgolf.com?subject=VTrack%20Partner%20Program%20Question\" style=\"color:#ffffff;\"><strong>sales@elitesimgolf.com</strong></a> or text <a href=\"sms:865-248-2729\" style=\"color:#ffffff;\"><strong>865-248-2729</strong></a>.</p>\n    </div>\n  </section>\n\n</div>",
        "full_width": true,
        "show_space": false,
        "boundary_effect": ""
      }
    }
  },
  "order": [
    "hero",
    "main",
    "custom_liquid_Wkymgg"
  ]
}
