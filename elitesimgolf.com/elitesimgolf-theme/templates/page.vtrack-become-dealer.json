: none;\n    padding: 0;\n    margin: 24px 0 32px;\n  }\n  .esg-vtrack-partner .esg-path__bullets li {\n    position: relative;\n    padding-left: 36px;\n    margin-bottom: 14px;\n    font-size: 16px;\n    color: #2a3756;\n  }\n  .esg-vtrack-partner .esg-path__bullets li::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 12px;\n    width: 24px;\n    height: 2px;\n    background: #0A1A3A;\n  }\n\n  /* ---------- Benefit rows (alternating two-col) ---------- */\n  .esg-vtrack-partner .esg-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 64px;\n    align-items: center;\n  }\n  .esg-vtrack-partner .esg-row + .esg-row { margin-top: 80px; }\n  .esg-vtrack-partner .esg-row--reverse { direction: rtl; }\n  .esg-vtrack-partner .esg-row--reverse > * { direction: ltr; }\n  .esg-vtrack-partner .esg-row__img {\n    width: 100%;\n    height: 100%;\n    min-height: 380px;\n    background-size: cover;\n    background-position: center;\n    border-radius: 4px;\n  }\n\n  /* ---------- Features list ---------- */\n  .esg-vtrack-partner .esg-features {\n    list-style: none;\n    padding: 0;\n    margin: 24px 0 0;\n  }\n  .esg-vtrack-partner .esg-features li {\n    position: relative;\n    padding-left: 36px;\n    margin-bottom: 16px;\n    font-size: 16px;\n    color: #2a3756;\n  }\n  .esg-vtrack-partner .esg-features li::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 12px;\n    width: 24px;\n    height: 2px;\n    background: #0A1A3A;\n  }\n\n  /* ---------- Stats grid ---------- */\n  .esg-vtrack-partner .esg-stats {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    margin-top: 40px;\n    border: 1px solid rgba(10,26,58,0.12);\n    background: #ffffff;\n  }\n  .esg-vtrack-partner .esg-stats__item {\n    padding: 36px 24px;\n    text-align: center;\n    border-right: 1px solid rgba(10,26,58,0.12);\n  }\n  .esg-vtrack-partner .esg-stats__item:last-child { border-right: none; }\n  .esg-vtrack