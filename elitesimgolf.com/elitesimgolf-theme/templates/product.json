        "custom_liquid_YdCQek": {
          "type": "custom-liquid",
          "name": "Optoma Deals",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\n==================================================\nPROMO BOX - OPTOMA (AMBER THEME)\n==================================================\nTrigger: product.vendor = \"Optoma\" (case-insensitive)\nRequires code: OPTOMA10\nShow beginning: April 21, 2026\nAuto-hide after: April 30, 2026\n{%- endcomment -%}\n\n{%- assign today_ts = 'now' | date: '%s' -%}\n{%- assign start_ts = '2026-04-21 00:00:00' | date: '%s' -%}\n{%- assign cutoff_ts = '2026-04-30 23:59:59' | date: '%s' -%}\n{%- assign vendor_downcase = product.vendor | strip | downcase -%}\n\n{%- if today_ts >= start_ts and today_ts <= cutoff_ts and vendor_downcase == 'optoma' -%}\n<div class=\"esg-optoma-promo-box\">\n  <div class=\"esg-optoma-promo-box__top\">\n    <div class=\"esg-optoma-promo-box__title\">\n      <span class=\"esg-optoma-promo-box__title-icon\" aria-hidden=\"true\">\n        <!-- Deal/Tag Icon -->\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M20.59 13.41 11 23l-2.5-2.5\"></path>\n          <path d=\"M17 7h.01\"></path>\n          <path d=\"M3 11V3h8l10 10-8 8L3 11z\"></path>\n        </svg>\n      </span>\n      <span>Extra Savings Available</span>\n    </div>\n    <div class=\"esg-optoma-promo-box__ends\">\n      Ends Apr 30, 2026\n    </div>\n  </div>\n\n  <div class=\"esg-optoma-promo-box__text\">\n    Use code below for <strong>up to 10% off</strong> at checkout.\n  </div>\n\n  <div class=\"esg-optoma-promo-box__row\">\n    <div id=\"esg-optoma-code\" class=\"esg-optoma-promo-box__code\">OPTOMA10</div>\n    <button type=\"button\" id=\"esg-optoma-copy\" class=\"esg-optoma-promo-box__button\">\n      Copy Code\n    </button>\n    <div id=\"esg-optoma-copied\" class=\"esg-optoma-promo-box__copied\">\n      Copied!\n    </div>\n  </div>\n\n  <div class=\"esg-optoma-promo-box__note\">\n    Tap the code or button to copy instantly.\n  </div>\n</div>\n\n<style>\n  .esg-optoma-promo-box {\n    max-width: 1100px;\n    margin: 14px 0;\n    padding: 16px 18px;\n    border: 1px solid #fed7aa;\n    border-radius: 10px;\n    background: linear-gradient(135deg, #fffbeb 0%, #ffedd5 100%);\n    box-shadow: 0 3px 6px rgba(234, 88, 12, 0.05);\n    color: #334155;\n    line-height: 1.4;\n  }\n  .esg-optoma-promo-box__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 8px;\n    flex-wrap: wrap;\n  }\n  .esg-optoma-promo-box__title {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 15px;\n    font-weight: 800;\n    color: #78350f;\n    letter-spacing: .2px;\n  }\n  .esg-optoma-promo-box__title-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 18px;\n    height: 18px;\n    color: #ea580c;\n  }\n  .esg-optoma-promo-box__title-icon svg {\n    width: 18px;\n    height: 18px;\n    display: block;\n  }\n  .esg-optoma-promo-box__ends {\n    display: inline-block;\n    padding: 4px 10px;\n    border-radius: 999px;\n    background: #ffffff;\n    border: 1px solid #fcd34d;\n    color: #b45309;\n    font-size: 12px;\n    font-weight: 800;\n    line-height: 1.2;\n    white-space: nowrap;\n    box-shadow: 0 2px 4px rgba(234, 88, 12, 0.05);\n  }\n  .esg-optoma-promo-box__text {\n    font-size: 13.5px;\n    color: #92400e;\n    margin-bottom: 14px;\n  }\n  .esg-optoma-promo-box__text strong {\n    font-weight: 800;\n    color: #78350f;\n  }\n  .esg-optoma-promo-box__row {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    flex-wrap: wrap;\n  }\n  .esg-optoma-promo-box__code {\n    display: inline-flex;\n    align-items: center;\n    padding: 9px 14px;\n    border-radius: 999px;\n    background: #ffffff;\n    border: 1px dashed #f59e0b;\n    color: #b45309;\n    font-weight: 900;\n    font-size: 13.5px;\n    letter-spacing: .12em;\n    line-height: 1;\n    user-select: all;\n    cursor: pointer;\n    white-space: nowrap;\n  }\n  .esg-optoma-promo-box__button {\n    appearance: none;\n    border: none;\n    border-radius: 999px;\n    padding: 10px 18px;\n    background: #ea580c;\n    color: #ffffff;\n    font-weight: 800;\n    font-size: 13.5px;\n    line-height: 1;\n    cursor: pointer;\n    box-shadow: 0 3px 6px rgba(234, 88, 12, 0.2);\n    transition: all .2s ease;\n  }\n  .esg-optoma-promo-box__button:hover {\n    background: #c2410c;\n    transform: translateY(-1px);\n    box-shadow: 0 5px 8px rgba(234, 88, 12, 0.3);\n  }\n  .esg-optoma-promo-box__copied {\n    display: none;\n    align-items: center;\n    padding: 8px 12px;\n    border-radius: 999px;\n    background: #f0fdf4;\n    border: 1px solid #bbf7d0;\n    color: #16a34a;\n    font-size: 13px;\n    font-weight: 800;\n    line-height: 1;\n    white-space: nowrap;\n  }\n  .esg-optoma-promo-box__note {\n    margin-top: 10px;\n    font-size: 12px;\n    color: #b45309;\n    opacity: 0.85;\n  }\n\n  @media (max-width: 749px) {\n    .esg-optoma-promo-box {\n      padding: 14px;\n    }\n    .esg-optoma-promo-box__title {\n      font-size: 14.5px;\n    }\n    .esg-optoma-promo-box__text {\n      font-size: 13px;\n    }\n    .esg-optoma-promo-box__button,\n    .esg-optoma-promo-box__code {\n      font-size: 13px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  var btn = document.getElementById('esg-optoma-copy');\n  var codeEl = document.getElementById('esg-optoma-code');\n  var badge = document.getElementById('esg-optoma-copied');\n\n  if (!btn || !codeEl) return;\n\n  function showCopied() {\n    if (!badge) return;\n    badge.style.display = 'inline-flex';\n    setTimeout(function () {\n      badge.style.display = 'none';\n    }, 1500);\n  }\n\n  async function copyCode() {\n    var code = (codeEl.textContent || '').trim();\n    try {\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        await navigator.clipboard.writeText(code);\n        showCopied();\n        return;\n      }\n    } catch (e) {}\n    var ta = document.createElement('textarea');\n    ta.value = code;\n    ta.setAttribute('readonly', '');\n    ta.style.position = 'absolute';\n    ta.style.left = '-9999px';\n    document.body.appendChild(ta);\n    ta.select();\n    try {\n      document.execCommand('copy');\n      showCopied();\n    } catch (e) {}\n    document.body.removeChild(ta);\n  }\n\n  btn.addEventListener('click', copyCode);\n  codeEl.addEventListener('click', copyCode);\n  codeEl.title = 'Click to copy';\n})();\n</script>\n{%- endif -%}"
          }
