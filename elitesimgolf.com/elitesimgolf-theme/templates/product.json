   }\n      \n      var diff = cutoff - estNow;\n      \n      var hrs = Math.floor(diff / (1000 * 60 * 60));\n      var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));\n      \n      countdownEl.textContent = hrs + \" Hrs \" + mins + \" Mins\";\n    }\n    \n    updateCountdown();\n    setInterval(updateCountdown, 60000);\n  })();\n</script>\n{%- endif -%}"
