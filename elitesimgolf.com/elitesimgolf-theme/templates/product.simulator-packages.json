        "custom_liquid_pPntfq": {
          "type": "custom-liquid",
          "name": "Freedom Sale",
          "settings": {
            "custom_liquid": "<!-- FREEDOM 250 SALE — PDP Callout Section -->\n<!-- Elite Sim Golf | June 24 – July 31, 2026 -->\n<!--\n  USAGE: Paste into your product .liquid theme file.\n  Tag products with:\n    FREEDOM                           → required to show callout\n    FREE5 / FREE10 / FREE15 / FREE20  → shows that % off (optional)\n  Date gate is server-side — auto-shows June 24 and auto-hides August 1.\n-->\n\n{% assign f250_now   = 'now'                  | date: '%s' | plus: 0 %}\n{% assign f250_start = '2026-06-24T00:00:00Z' | date: '%s' | plus: 0 %}\n{% assign f250_end   = '2026-08-01T00:00:00Z' | date: '%s' | plus: 0 %}\n\n{% if product.tags contains 'FREEDOM' and f250_now >= f250_start and f250_now < f250_end %}\n\n{% assign f250_pct = '' %}\n{% if product.tags contains 'FREE20' %}{% assign f250_pct = '20' %}\n{% elsif product.tags contains 'FREE15' %}{% assign f250_pct = '15' %}\n{% elsif product.tags contains 'FREE10' %}{% assign f250_pct = '10' %}\n{% elsif product.tags contains 'FREE5'  %}{% assign f250_pct = '5'  %}\n{% endif %}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .esg-f250-callout *,\n  .esg-f250-callout *::before,\n  .esg-f250-callout *::after {\n    box-sizing: border-box;\n  }\n\n  .esg-f250-callout {\n    background-color: #0A1A3A;\n    font-family: 'Barlow Condensed', sans-serif;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* Red/white stripe top accent */\n  .esg-f250-callout::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 4px;\n    background: repeating-linear-gradient(\n      to right,\n      #C8102E 0px,\n      #C8102E 50px,\n      #ffffff 50px,\n      #ffffff 100px\n    );\n    opacity: 0.85;\n  }\n\n  .esg-f250-callout__inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 28px 48px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 32px;\n    flex-wrap: wrap;\n  }\n\n  .esg-f250-callout__left {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    flex-wrap: wrap;\n  }\n\n  .esg-f250-callout__lockup {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n\n  .esg-f250-callout__eyebrow {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: #C8102E;\n    line-height: 1;\n  }\n\n  .esg-f250-callout__title {\n    font-size: clamp(22px, 3vw, 32px);\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: -0.01em;\n    color: #ffffff;\n    line-height: 1;\n  }\n\n  .esg-f250-callout__divider {\n    width: 1px;\n    height: 40px;\n    background: rgba(255, 255, 255, 0.15);\n    flex-shrink: 0;\n  }\n\n  .esg-f250-callout__details {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n\n  .esg-f250-callout__savings {\n    font-size: 15px;\n    font-weight: 700;\n    color: #ffffff;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n  }\n\n  .esg-f250-callout__savings em {\n    color: #C8102E;\n    font-style: normal;\n  }\n\n  .esg-f250-callout__date {\n    font-family: 'Inter', system-ui, sans-serif;\n    font-size: 12px;\n    font-weight: 500;\n    color: rgba(255, 255, 255, 0.55);\n    letter-spacing: 0.03em;\n  }\n\n  .esg-f250-callout__date strong {\n    color: #ffffff;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 15px;\n    font-weight: 800;\n    letter-spacing: 0.12em;\n    background: rgba(255, 255, 255, 0.1);\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    padding: 2px 10px;\n    border-radius: 3px;\n    margin-left: 4px;\n  }\n\n  .esg-f250-callout__ends {\n    font-family: 'Inter', system-ui, sans-serif;\n    font-size: 12px;\n    font-weight: 500;\n    color: rgba(255, 255, 255, 0.38);\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 900px) {\n    .esg-f250-callout__inner {\n      padding: 24px;\n      gap: 20px;\n    }\n\n    .esg-f250-callout__divider {\n      display: none;\n    }\n\n    .esg-f250-callout__ends {\n      display: none;\n    }\n  }\n\n  @media (max-width: 560px) {\n    .esg-f250-callout__left {\n      gap: 12px;\n    }\n  }\n</style>\n\n<div class=\"esg-f250-callout\">\n  <div class=\"esg-f250-callout__inner\">\n\n    <div class=\"esg-f250-callout__left\">\n      <div class=\"esg-f250-callout__lockup\">\n        <div class=\"esg-f250-callout__eyebrow\">Limited-Time Offer</div>\n        <div class=\"esg-f250-callout__title\">Freedom 250 Sale</div>\n      </div>\n      <div class=\"esg-f250-callout__divider\"></div>\n      <div class=\"esg-f250-callout__details\">\n        {% if f250_pct != '' %}\n          <div class=\"esg-f250-callout__savings\">Save <em>{{ f250_pct }}%</em> at checkout</div>\n          <div class=\"esg-f250-callout__date\">Use code<strong>FREE</strong> at checkout &mdash; Sale ends July 31, 2026</div>\n        {% else %}\n          <div class=\"esg-f250-callout__savings\"></div>\n          <div class=\"esg-f250-callout__date\">Use code<strong>FREE</strong> at checkout &mdash; Sale ends July 31, 2026</div>\n        {% endif %}\n      </div>\n    </div>\n\n\n  </div>\n</div>\n\n{% endif %}"
          }
