            "custom_liquid": "<!-- Elite Sim Golf Memorial Day Sale Mini PDP Box - Auto Hides After May 31 -->\n<div id=\"esg-memorial-mini-sale\" style=\"max-width:600px;margin:10px 0;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\">\n  <div style=\"background:linear-gradient(135deg,#071a33 0%,#0b2b55 55%,#9f1239 100%);border-radius:12px;padding:11px 12px;color:#fff;box-shadow:0 6px 16px rgba(0,0,0,.16);border:1px solid rgba(255,255,255,.16);\">\n    \n    <div style=\"display:flex;align-items:center;gap:7px;margin-bottom:8px;\">\n      <span style=\"font-size:15px;color:#fff;\">★</span>\n      <div style=\"font-size:11px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:#dbeafe;line-height:1;\">\n        Memorial Day Sale\n      </div>\n    </div>\n\n    <div style=\"font-size:16px;font-weight:950;line-height:1.15;margin-bottom:8px;\">\n      Save Today on Popular Golf Sim Gear!\n    </div>\n\n    <div style=\"background:#fff;color:#071a33;border-radius:9px;padding:7px 9px;margin-bottom:8px;text-align:center;\">\n      <div style=\"font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#6b7280;line-height:1;\">\n        Coupon Code\n      </div>\n      <div style=\"font-size:18px;font-weight:950;letter-spacing:.08em;color:#b91c1c;line-height:1.2;margin-top:2px;\">\n        REMEMBER\n      </div>\n    </div>\n\n    <div style=\"font-size:12px;line-height:1.3;color:#f8fafc;\">\n      For the best deal, text\n      <span style=\"font-weight:950;white-space:nowrap;color:#fff;\">865-248-2729</span> for items excluded from Discount Code.\n    </div>\n\n  </div>\n</div>\n\n<script>\n  (function() {\n    var saleBox = document.getElementById('esg-memorial-mini-sale');\n    var hideAfter = new Date('2026-06-01T00:00:00');\n\n    if (saleBox && new Date() >= hideAfter) {\n      saleBox.style.display = 'none';\n    }\n  })();\n</script>"
