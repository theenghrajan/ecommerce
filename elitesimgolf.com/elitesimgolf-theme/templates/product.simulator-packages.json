            "custom_liquid": "{%- comment -%}\nESG SIMKIT BUILDER PROMO BOX\nTrigger: Product Type contains \"Launch Monitor\" OR Product Tags contain \"launch monitor\"\nPurpose: Upsell the SIMKIT Builder on standalone launch monitor pages.\n{%- endcomment -%}\n\n{%- assign is_launch_monitor = false -%}\n\n{%- comment -%} Check Product Type {%- endcomment -%}\n{%- assign prod_type_downcase = product.type | downcase -%}\n{%- if prod_type_downcase contains 'launch monitor' -%}\n  {%- assign is_launch_monitor = true -%}\n{%- endif -%}\n\n{%- comment -%} Check Product Tags (fallback) {%- endcomment -%}\n{%- unless is_launch_monitor -%}\n  {%- for tag in product.tags -%}\n    {%- assign normalized_tag = tag | strip | downcase -%}\n    {%- if normalized_tag contains 'launch monitor' -%}\n      {%- assign is_launch_monitor = true -%}\n      {%- break -%}\n    {%- endif -%}\n  {%- endfor -%}\n{%- endunless -%}\n\n{%- if is_launch_monitor -%}\n<div class=\"esg-simkit-promo-box\">\n  <div class=\"esg-simkit-promo-box__top\">\n    <div class=\"esg-simkit-promo-box__title\">\n      <span class=\"esg-simkit-promo-box__title-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"></path>\n        </svg>\n      </span>\n      <span>Build Your Dream Simulator</span>\n    </div>\n  </div>\n  <div class=\"esg-simkit-promo-box__text\">\n    Turn this launch monitor into a complete setup. Custom fit your enclosure, impact screen, and mat using the <strong>Elite Sim Golf SIMKIT Builder</strong>.\n  </div>\n  <div class=\"esg-simkit-promo-box__action\">\n    <!-- UPDATE THIS URL TO MATCH YOUR ACTUAL SIMKIT BUILDER PAGE -->\n    <a href=\"/pages/simkit-builder\" class=\"esg-simkit-promo-box__button\">\n      Open SIMKIT Builder\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M5 12h14\"></path>\n        <path d=\"m12 5 7 7-7 7\"></path>\n      </svg>\n    </a>\n  </div>\n</div>\n\n<style>\n  .esg-simkit-promo-box {\n    max-width: 1100px;\n    margin: 12px 0;\n    padding: 14px 16px;\n    border: 1px solid #23923d;\n    border-radius: 12px;\n    background: linear-gradient(180deg, #f7fcf7 0%, #eef8ef 100%);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.75),\n      0 2px 4px rgba(16,42,67,.04);\n    color: #102a43;\n    line-height: 1.4;\n  }\n  .esg-simkit-promo-box__top {\n    margin-bottom: 6px;\n  }\n  .esg-simkit-promo-box__title {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 15px;\n    font-weight: 900;\n    color: #168232;\n    letter-spacing: .2px;\n  }\n  .esg-simkit-promo-box__title-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 18px;\n    height: 18px;\n    color: #168232;\n  }\n  .esg-simkit-promo-box__title-icon svg {\n    width: 18px;\n    height: 18px;\n    display: block;\n  }\n  .esg-simkit-promo-box__text {\n    font-size: 13.5px;\n    color: #243b53;\n    margin-bottom: 12px;\n  }\n  .esg-simkit-promo-box__text strong {\n    font-weight: 800;\n    color: #102a43;\n  }\n  .esg-simkit-promo-box__action {\n    display: flex;\n  }\n  .esg-simkit-promo-box__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    text-decoration: none;\n    border: 1px solid #168232;\n    border-radius: 999px;\n    padding: 9px 16px;\n    background: #168232;\n    color: #ffffff;\n    font-weight: 800;\n    font-size: 13px;\n    line-height: 1;\n    box-shadow: 0 2px 4px rgba(22, 130, 50, 0.2);\n    transition: all 0.2s ease;\n  }\n  .esg-simkit-promo-box__button:hover {\n    background: #136f2b;\n    border-color: #136f2b;\n    transform: translateY(-1px);\n    box-shadow: 0 4px 6px rgba(22, 130, 50, 0.25);\n    color: #fffff