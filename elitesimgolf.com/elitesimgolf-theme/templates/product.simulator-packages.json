        "custom_liquid_zRE3Kx": {
          "type": "custom-liquid",
          "name": "SimKit Builder",
          "settings": {
            "custom_liquid": "{%- comment -%}\nESG SIMKIT BUILDER PROMO BOX\nTrigger: Product Type contains \"Golf Simulator Kit\" (Ignores tags)\nPurpose: Upsell the SIMKIT Builder on simulator package pages.\n{%- endcomment -%}\n\n{%- assign is_golf_simulator_kit = false -%}\n\n{%- comment -%} Check Product Type Only {%- endcomment -%}\n{%- assign prod_type_downcase = product.type | downcase -%}\n{%- if prod_type_downcase contains 'golf simulator kit' -%}\n  {%- assign is_golf_simulator_kit = true -%}\n{%- endif -%}\n\n{%- if is_golf_simulator_kit -%}\n<div class=\"esg-simkit-promo-box\">\n  \n  <div class=\"esg-simkit-promo-box__content\">\n    <div class=\"esg-simkit-promo-box__icon\" aria-hidden=\"true\">\n      <!-- Golf Ball on Tee Icon -->\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <circle cx=\"12\" cy=\"9\" r=\"4\"></circle>\n        <path d=\"M12 13v7\"></path>\n        <path d=\"M8 20h8\"></path>\n      </svg>\n    </div>\n    \n    <div class=\"esg-simkit-promo-box__text-group\">\n      <div class=\"esg-simkit-promo-box__title\">\n        Build Your Dream Home Golf Simulator\n      </div>\n      <div class=\"esg-simkit-promo-box__text\">\n        Not seeing the exact mix of products you're looking for in our simulator packages? Customize your enclosure, projector, hitting mat, and simulator flooring using the <strong>Elite Sim Golf SIMKIT Builder</strong>. Discounts up to 15% off SIMKIT Bundles. <span style=\"opacity: 0.85;\">(Discounts Exclude Launch Monitors)</span>\n      </div>\n    </div>\n  </div>\n\n  <a href=\"/pages/golf-simkit-bundle-builder\" class=\"esg-simkit-promo-box__button\">\n    Open the ELITE SIMKIT Builder\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M5 12h14\"></path>\n      <path d=\"m12 5 7 7-7 7\"></path>\n    </svg>\n  </a>\n\n</div>\n\n<style>\n  .esg-simkit-promo-box {\n    max-width: 1100px;\n    margin: 14px 0;\n    padding: 14px 16px;\n    border: 1px solid #e2e8f0; /* Soft, clean border */\n    border-radius: 12px;\n    background: #ffffff; /* Premium white background */\n    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.02);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    flex-wrap: wrap;\n    color: #334155;\n    line-height: 1.4;\n  }\n  .esg-simkit-promo-box__content {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    flex: 1 1 300px;\n  }\n  .esg-simkit-promo-box__icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 32px;\n    height: 32px;\n    min-width: 32px;\n    border-radius: 8px;\n    background: #eff6ff; /* Soft blue icon background */\n    color: #2563eb; /* Vibrant royal blue icon */\n    flex: 0 0 auto;\n    margin-top: 2px;\n  }\n  .esg-simkit-promo-box__icon svg {\n    width: 18px;\n    height: 18px;\n    display: block;\n  }\n  .esg-simkit-promo-box__text-group {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    min-width: 0;\n  }\n  .esg-simkit-promo-box__title {\n    font-size: 14px;\n    font-weight: 800;\n    color: #0f172a;\n    letter-spacing: .2px;\n  }\n  .esg-simkit-promo-box__text {\n    font-size: 12.5px;\n    color: #475569;\n  }\n  .esg-simkit-promo-box__text strong {\n    font-weight: 700;\n    color: #0f172a;\n  }\n  \n  /* --- UPGRADED BUTTON STYLES --- */\n  .esg-simkit-promo-box__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    text-decoration: none;\n    border: 1px solid transparent;\n    border-radius: 999px;\n    padding: 12px 28px; /* Taller and significantly wider */\n    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); /* Premium gradient */\n    color: #ffffff;\n    font-weight: 800; /* Bolder text */\n    font-size: 14px; /* Slightly larger text */\n    letter-spacing: .3px;\n    line-height: 1;\n    /* Soft shadow + crisp white inner top-glow for a 3D effect */\n    box-shadow: \n      inset 0 1px 0 rgba(255, 255, 255, 0.25), \n      0 4px 10px rgba(37, 99, 235, 0.25);\n    transition: all 0.25s ease;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n  .esg-simkit-promo-box__button:hover {\n    background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%); /* Darkens on hover */\n    transform: translateY(-2px); /* Lifts up slightly more */\n    box-shadow: \n      inset 0 1px 0 rgba(255, 255, 255, 0.2), \n      0 6px 14px rgba(37, 99, 235, 0.35); /* Shadow expands */\n    color: #ffffff;\n  }\n  .esg-simkit-promo-box__button svg {\n    width: 15px;\n    height: 15px;\n    transition: transform 0.25s ease;\n  }\n  .esg-simkit-promo-box__button:hover svg {\n    transform: translateX(4px); /* Arrow slides over */\n  }\n\n  @media (max-width: 749px) {\n    .esg-simkit-promo-box {\n      padding: 14px;\n      flex-direction: column;\n      align-items: stretch;\n      gap: 16px;\n    }\n    .esg-simkit-promo-box__title {\n      font-size: 13.5px;\n    }\n    .esg-simkit-promo-box__text {\n      font-size: 12.5px;\n    }\n    .esg-simkit-promo-box__button {\n      width: 100%;\n      padding: 14px 20px; /* Keeps it nice and tall on mobile */\n    }\n  }\n</style>\n{%- endif -%}"
          }
