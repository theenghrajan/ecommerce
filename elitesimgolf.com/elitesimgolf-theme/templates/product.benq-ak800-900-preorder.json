        "custom_liquid_eNw6Uh": {
          "type": "custom-liquid",
          "name": "New Universal Ship Box",
          "settings": {
            "custom_liquid": "<!-- ============================================================\n     ESG — BenQ AK900ST / AK800ST: Pre-Order Shipping Box\n     Scope: .esg-preship\n     One snippet for both PDPs. The ship window is chosen by variant SKU:\n       AK900ST-001  ->  Ships Mid-October\n       AK800ST-001  ->  Ships Mid-November\n     Any other SKU renders nothing, so it is safe to leave in a shared\n     template. To change a date, edit the two assign lines below.\n\n     ACKNOWLEDGMENT GATE: Add to Cart and Buy it now stay locked until\n     the customer ticks the pre-order checkbox. Clicking or submitting\n     while locked is blocked and the box pulses to draw attention.\n     The checkbox resets on every page load.\n\n     ORDER NOTE: ticking the box also adds a line item property to the\n     product form: \"Pre-Order Acknowledged: Yes, ships {date}; 5%\n     cancellation processing fee applies\". It shows\n     on the cart line, at checkout, on the order in Shopify admin, and in\n     order emails. Unticking removes it. To hide it from customers but\n     keep it in admin, rename the property to start with an underscore\n     (PROP_NAME in the script).\n     ============================================================ -->\n{%- liquid\n  assign esg_preship = ''\n  for v in product.variants\n    assign esg_preship_sku = v.sku | upcase\n    if esg_preship_sku == 'AK900ST-001'\n      assign esg_preship = 'Mid-October'\n    elsif esg_preship_sku == 'AK800ST-001'\n      assign esg_preship = 'Mid-November'\n    endif\n  endfor\n-%}\n{%- if esg_preship != '' -%}\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<div class=\"esg-preship\" id=\"esg-preship\" data-ship=\"{{ esg_preship }}\" role=\"group\" aria-label=\"Pre-order shipping information\">\n  <div class=\"esg-preship__row\">\n    <div class=\"esg-preship__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M1 3h13v13H1z\"></path>\n        <path d=\"M14 8h4.5l3.5 4v4h-8z\"></path>\n        <circle cx=\"5.5\" cy=\"18.5\" r=\"2\"></circle>\n        <circle cx=\"17.5\" cy=\"18.5\" r=\"2\"></circle>\n      </svg>\n    </div>\n    <div class=\"esg-preship__body\">\n      <div class=\"esg-preship__top\">\n        <span class=\"esg-preship__pill\">Pre-Order</span>\n        <span class=\"esg-preship__ship\">Ships {{ esg_preship }}</span>\n      </div>\n      <p class=\"esg-preship__note\">Pre-orders ship in the order received as BenQ inventory arrives.</p>\n      <p class=\"esg-preship__fee\"><strong>Cancellations:</strong> a 5% processing fee applies.</p>\n    </div>\n  </div>\n\n  <label class=\"esg-preship__ack\" for=\"esg-preship-check\">\n    <input type=\"checkbox\" id=\"esg-preship-check\" class=\"esg-preship__check\">\n    <span class=\"esg-preship__box\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n    </span>\n    <span class=\"esg-preship__ack-text\">\n      I understand this is a pre-order that ships {{ esg_preship }}, and that a 5% processing fee applies to cancellations.\n      <span class=\"esg-preship__hint\" id=\"esg-preship-hint\">Check this box to enable Add to Cart.</span>\n    </span>\n  </label>\n</div>\n\n<style>\n  .esg-preship {\n    width: 100%;\n    max-width: 560px;\n    margin: 12px 0;\n    padding: 11px 14px 12px 12px;\n    background: #F4F6FB;\n    border: 1px solid #D5DBEA;\n    border-left: 4px solid #0A1A3A;\n    border-radius: 8px;\n    font-family: 'Inter', system-ui, -apple-system, sans-serif;\n    color: #2a3756;\n    box-sizing: border-box;\n    transition: border-color .2s ease, background-color .2s ease;\n  }\n  .esg-preship * { box-sizing: border-box; }\n\n  .esg-preship__row { display: flex; align-items: center; gap: 12px; }\n\n  .esg-preship__icon {\n    flex: 0 0 auto;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 36px;\n    height: 36px;\n    min-width: 36px;\n    border-radius: 7px;\n    background: #0A1A3A;\n    color: #ffffff;\n  }\n  .esg-preship__icon svg { width: 20px; height: 20px; display: block; }\n\n  .esg-preship__body { min-width: 0; flex: 1 1 auto; }\n\n  .esg-preship__top { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; }\n\n  .esg-preship__pill {\n    display: inline-block;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 800;\n    font-size: 11px;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #ffffff;\n    background: #0A1A3A;\n    border-radius: 999px;\n    padding: 3px 10px;\n    line-height: 1.3;\n  }\n\n  .esg-preship__ship {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 800;\n    font-size: 21px;\n    letter-spacing: .02em;\n    text-transform: uppercase;\n    color: #0A1A3A;\n    line-height: 1.1;\n  }\n\n  .esg-preship__note { margin: 3px 0 0; font-size: 12px; line-height: 1.4; color: #4A5578; }\n  .esg-preship__fee { margin: 2px 0 0; font-size: 12px; line-height: 1.4; color: #0A1A3A; }\n  .esg-preship__fee strong { font-weight: 700; }\n\n  /* ---- Acknowledgment row ---- */\n  .esg-preship__ack {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    margin-top: 10px;\n    padding: 9px 10px;\n    background: #ffffff;\n    border: 1px solid #D5DBEA;\n    border-radius: 6px;\n    cursor: pointer;\n    position: relative;\n    transition: border-color .15s ease;\n  }\n  .esg-preship__ack:hover { border-color: #0A1A3A; }\n\n  .esg-preship__check {\n    position: absolute;\n    opacity: 0;\n    width: 1px;\n    height: 1px;\n    margin: 0;\n  }\n\n  .esg-preship__box {\n    flex: 0 0 auto;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 20px;\n    height: 20px;\n    margin-top: 1px;\n    border: 2px solid #0A1A3A;\n    border-radius: 4px;\n    background: #ffffff;\n    color: transparent;\n    transition: background-color .15s ease, color .15s ease;\n  }\n  .esg-preship__box svg { width: 13px; height: 13px; display: block; }\n\n  .esg-preship__check:checked + .esg-preship__box { background: #0A1A3A; color: #ffffff; }\n  .esg-preship__check:focus-visible + .esg-preship__box { outline: 2px solid #0A1A3A; outline-offset: 2px; }\n\n  .esg-preship__ack-text {\n    font-size: 13px;\n    font-weight: 600;\n    line-height: 1.4;\n    color: #0A1A3A;\n  }\n  .esg-preship__hint {\n    display: block;\n    margin-top: 2px;\n    font-size: 11.5px;\n    font-weight: 500;\n    color: #6B7490;\n  }\n  .esg-preship.is-ack .esg-preship__hint { display: none; }\n  .esg-preship.is-ack { border-color: #B8C2DC; background: #EEF2FA; }\n\n  /* Pulse when the customer tries to add to cart without acknowledging */\n  .esg-preship.is-alert { border-left-color: #C0392B; background: #FDF3F2; border-color: #E6B8B3; }\n  .esg-preship.is-alert .esg-preship__hint { color: #A8281C; font-weight: 700; }\n  .esg-preship.is-shake { animation: esg-preship-shake .4s ease; }\n  @keyframes esg-preship-shake {\n    0%, 100% { transform: translateX(0); }\n    20% { transform: translateX(-5px); }\n    40% { transform: translateX(5px); }\n    60% { transform: translateX(-3px); }\n    80% { transform: translateX(3px); }\n  }\n  @media (prefers-reduced-motion: reduce) { .esg-preship.is-shake { animation: none; } }\n\n  /* Locked purchase buttons (class applied by script) */\n  .esg-preship-locked {\n    opacity: .45 !important;\n    cursor: not-allowed !important;\n    filter: grayscale(.4);\n  }\n  .esg-preship-locked-wrap { pointer-events: none; }\n\n  @media (max-width: 380px) {\n    .esg-preship { padding: 10px 12px 11px 10px; }\n    .esg-preship__icon { width: 32px; height: 32px; min-width: 32px; }\n    .esg-preship__ship { font-size: 19px; }\n    .esg-preship__ack-text { font-size: 12.5px; }\n  }\n</style>\n\n<script>\n(function () {\n  var box = document.getElementById('esg-preship');\n  var check = document.getElementById('esg-preship-check');\n  if (!box || !check || box.getAttribute('data-esg-init')) return;\n  box.setAttribute('data-esg-init', '1');\n\n  // Add to Cart / Buy it now controls. Add selectors here if the theme changes.\n  var BTN = [\n    'form[action*=\"/cart/add\"] [type=\"submit\"]',\n    'form[action*=\"/cart/add\"] button[name=\"add\"]',\n    'button[name=\"add\"]',\n    '.product-form__submit',\n    '[data-add-to-cart]',\n    '.shopify-payment-button',\n    'shopify-accelerated-checkout',\n    'shopify-buy-it-now-button'\n  ].join(',');\n  var FORM = 'form[action*=\"/cart/add\"]';\n\n  // Line item property written to the cart / order when acknowledged.\n  var PROP_NAME = 'properties[Pre-Order Acknowledged]';\n  var PROP_VALUE = 'Yes, ships ' + (box.getAttribute('data-ship') || '') + '; 5% cancellation processing fee applies';\n\n  function syncProp() {\n    var forms = document.querySelectorAll(FORM);\n    for (var i = 0; i < forms.length; i++) {\n      var f = forms[i];\n      var ex = f.querySelector('input[data-esg-preship-prop]');\n      if (check.checked) {\n        if (!ex) {\n          ex = document.createElement('input');\n          ex.type = 'hidden';\n          ex.name = PROP_NAME;\n          ex.setAttribute('data-esg-preship-prop', '1');\n          f.appendChild(ex);\n        }\n        ex.value = PROP_VALUE;\n      } else if (ex) {\n        ex.parentNode.removeChild(ex);\n      }\n    }\n  }\n\n  // Always start locked, even if the browser restored a checked state.\n  check.checked = false;\n\n  function setLock(locked) {\n    var els = document.querySelectorAll(BTN);\n    for (var i = 0; i < els.length; i++) {\n      var el = els[i];\n      if (el.closest('#esg-preship')) continue;\n      var isPay = el.matches('.shopify-payment-button, shopify-accelerated-checkout, shopify-buy-it-now-button');\n      if (locked) {\n        el.classList.add('esg-preship-locked');\n        el.setAttribute('aria-disabled', 'true');\n        if (isPay) el.classList.add('esg-preship-locked-wrap');\n      } else {\n        el.classList.remove('esg-preship-locked', 'esg-preship-locked-wrap');\n        el.removeAttribute('aria-disabled');\n      }\n    }\n  }\n\n  function isLocked() { return !check.checked; }\n\n  function alertBox() {\n    box.classList.add('is-alert');\n    box.classList.remove('is-shake');\n    void box.offsetWidth;\n    box.classList.add('is-shake');\n    var r = box.getBoundingClientRect();\n    if (r.top < 0 || r.bottom > (window.innerHeight || 800)) {\n      box.scrollIntoView({ behavior: 'smooth', block: 'center' });\n    }\n  }\n\n  check.addEventListener('change', function () {\n    box.classList.toggle('is-ack', check.checked);\n    if (check.checked) box.classList.remove('is-alert');\n    setLock(isLocked());\n    syncProp();\n  });\n\n  // Block clicks on locked buttons (capture phase beats theme handlers).\n  document.addEventListener('click', function (e) {\n    if (!isLocked()) return;\n    var t = e.target.closest ? e.target.closest(BTN) : null;\n    if (t && !t.closest('#esg-preship')) {\n      e.preventDefault();\n      e.stopImmediatePropagation();\n      alertBox();\n    }\n  }, true);\n\n  // Block form submits (Enter key, Buy it now, theme AJAX add).\n  document.addEventListener('submit', function (e) {\n    if (!isLocked()) return;\n    if (e.target.matches && e.target.matches(FORM)) {\n      e.preventDefault();\n      e.stopImmediatePropagation();\n      alertBox();\n    }\n  }, true);\n\n  // Re-apply the lock if the theme re-renders the buy buttons.\n  var pending = false;\n  var mo = new MutationObserver(function () {\n    if (pending) return;\n    pending = true;\n    setTimeout(function () { pending = false; setLock(isLocked()); syncProp(); }, 60);\n  });\n  mo.observe(document.body, { childList: true, subtree: true });\n\n  setLock(true);\n})();\n</script>\n{%- endif -%}"
          }
        },
        "custom_liquid_qAdYDw": {
          "type": "custom-liquid",
          "name": "SimKit Builder",
          "disabled": true,
          "settings": {
            "custom_liquid": "<!-- ESG SimKit Builder CTA — place in theme template AFTER the entire payment-buttons block (Add to Cart, Buy with Shop Pay, More payment options) -->\n<!-- Reusable across any product PDP: product name pulls from {{ product.title }} -->\n<style>\n.esg-simkit-cta-box { border:1px solid #0A1A3A; background:#F0F3F8; border-radius:6px; padding:22px 24px; margin-top:16px; }\n.esg-simkit-cta-box h4 { font-family:'Barlow Condensed', sans-serif; font-style:normal; font-size:19px; font-weight:800; letter-spacing:0.02em; text-transform:uppercase; color:#0A1A3A; margin:0 0 8px; line-height:1.15; text-align:center; }\n.esg-simkit-cta-box p { font-family:'Inter', system-ui, -apple-system, sans-serif; font-size:14px; line-height:1.5; color:#2a3756; margin:0 0 16px; text-align:center; }\n.esg-simkit-cta-box a.esg-simkit-cta-link { display:block; width:100%; box-sizing:border-box; text-align:center; background:#0A1A3A; color:#ffffff !important; text-decoration:none; font-family:'Inter', system-ui, -apple-system, sans-serif; font-weight:700; font-size:15px; padding:14px 16px; border-radius:4px; letter-spacing:0.01em; }\n.esg-simkit-cta-box a.esg-simkit-cta-link:hover { background:#132a5c; }\n@media (max-width: 480px) {\n  .esg-simkit-cta-box { padding:18px; }\n  .esg-simkit-cta-box h4 { font-size:17px; }\n}\n</style>\n\n<div class=\"esg-simkit-cta-box\">\n  <h4>Build Your Dream Home Golf Simulator</h4>\n  <p>Pair the {{ product.title }} with a launch monitor, projector, and hitting mat in the SimKit Builder.</p>\n  <a class=\"esg-simkit-cta-link\" href=\"https://elitesimgolf.com/pages/golf-simkit-bundle-builder\">Start Building in the SimKit Builder &rarr;</a>\n</div>"
          }
        },
        "custom_liquid_LWnqjF": {
          "type": "custom-liquid",
          "name": "Projector Fitment",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\n============================================================\n  ESG PROJECTOR FITMENT BOX\n  Paste target: Custom Liquid block on the projector template\n\n  GATE\n    product.type == 'Projector' (exact). 'Projector Mounts' and\n    'Projector/AV Mount Accessories' are separate types and are\n    deliberately excluded — a mount has no throw ratio.\n\n  TAGS (set per projector in Shopify admin)\n    throw:0.69-0.83   range, zoom lens\n    throw:0.496       single value, fixed throw\n    aspect:16:9       optional, defaults to 16:9\n\n  Shopper enters viewable screen HEIGHT. Width comes off the\n  aspect ratio, then throw distance is width x throw ratio.\n\n  With no throw tag the box degrades to the static fitment CTA.\n\n  Styling matches the accessories and shipping blocks: navy\n  #0A1A3A, no gradients, no radius, 1px #E6E9F0 borders with a\n  3px navy top accent, Barlow Condensed headings, Inter body.\n============================================================\n{%- endcomment -%}\n\n{%- if product.type == 'Projector' -%}\n\n{%- liquid\n  assign tr_min = 0\n  assign tr_max = 0\n  assign aspect = '16:9'\n  assign min_height = 72\n  assign max_height = 144\n  assign default_height = 96\n\n  for raw_tag in product.tags\n    assign tag = raw_tag | downcase | strip\n\n    if tag contains 'throw:'\n      assign throw_val = tag | remove_first: 'throw:' | strip\n      if throw_val contains '-'\n        assign throw_parts = throw_val | split: '-'\n        assign tr_min = throw_parts[0] | strip | plus: 0.0\n        assign tr_max = throw_parts[1] | strip | plus: 0.0\n      else\n        assign tr_min = throw_val | plus: 0.0\n        assign tr_max = throw_val | plus: 0.0\n      endif\n    endif\n\n    if tag contains 'aspect:'\n      assign aspect = tag | remove_first: 'aspect:' | strip\n    endif\n  endfor\n\n  assign has_throw_data = false\n  if tr_min > 0 and tr_max > 0\n    assign has_throw_data = true\n  endif\n\n  # A fixed-throw projector should read \"0.496:1\", not \"0.496-0.496:1\"\n  assign is_fixed = false\n  if tr_min == tr_max\n    assign is_fixed = true\n  endif\n-%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<div class=\"esg-fit\"\n     data-esg-fit\n     data-throw-min=\"{{ tr_min }}\"\n     data-throw-max=\"{{ tr_max }}\"\n     data-aspect=\"{{ aspect | escape }}\"\n     data-min-height=\"{{ min_height }}\"\n     data-max-height=\"{{ max_height }}\">\n\n  <div class=\"esg-fit__head\">\n    <span class=\"esg-fit__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M15 3h6v6\"></path>\n        <path d=\"M9 21H3v-6\"></path>\n        <path d=\"M21 3l-7 7\"></path>\n        <path d=\"M3 21l7-7\"></path>\n      </svg>\n    </span>\n\n    <div class=\"esg-fit__headtxt\">\n      <span class=\"esg-fit__ttlrow\">\n        <span class=\"esg-fit__title\">Will This Projector Fit</span>\n        {%- if has_throw_data -%}\n          <span class=\"esg-fit__specs\">\n            Throw ratio\n            {%- if is_fixed %} {{ tr_min }}:1{% else %} {{ tr_min }}–{{ tr_max }}:1{% endif -%}\n            · Aspect {{ aspect }}\n          </span>\n        {%- endif -%}\n      </span>\n      {%- unless has_throw_data -%}\n        <span class=\"esg-fit__text\">Check screen size, aspect ratio, and mounting distance before ordering.</span>\n      {%- endunless -%}\n    </div>\n  </div>\n\n  {%- if has_throw_data -%}\n    <div class=\"esg-fit__calc\" role=\"group\" aria-label=\"Fitment calculator\">\n      <label class=\"esg-fit__field\">\n        <span class=\"esg-fit__lbl\">Viewable Screen Height</span>\n        <span class=\"esg-fit__inputwrap\">\n          <input type=\"number\"\n                 class=\"esg-fit__input\"\n                 min=\"{{ min_height }}\"\n                 max=\"{{ max_height }}\"\n                 step=\"1\"\n                 value=\"{{ default_height }}\"\n                 inputmode=\"numeric\"\n                 aria-label=\"Viewable screen height in inches\">\n          <span class=\"esg-fit__unit\">in</span>\n        </span>\n      </label>\n\n      <div class=\"esg-fit__result\">\n        <span class=\"esg-fit__reslbl\">Throw Distance</span>\n        <span class=\"esg-fit__resval\" data-result>—</span>\n        <span class=\"esg-fit__ressub\" data-result-sub>Screen to lens</span>\n      </div>\n    </div>\n\n    <div class=\"esg-fit__foot\">\n      <span class=\"esg-fit__note\"><span data-width-hint>Screen width —</span> · Estimate only, lens shift and zoom not factored in.</span>\n      <a href=\"/pages/projector-fitment-tool-and-throw-calculator\" class=\"esg-fit__link\">\n        Full fitment tool\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M5 12h14\"></path>\n          <path d=\"m12 5 7 7-7 7\"></path>\n        </svg>\n      </a>\n    </div>\n  {%- else -%}\n    <a href=\"/pages/projector-fitment-tool-and-throw-calculator\" class=\"esg-fit__btn\">\n      Check Fitment\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n        <path d=\"M5 12h14\"></path>\n        <path d=\"m12 5 7 7-7 7\"></path>\n      </svg>\n    </a>\n  {%- endif -%}\n</div>\n\n<style>\n  .esg-fit{box-sizing:border-box;display:flex;flex-direction:column;gap:8px;max-width:660px;margin:12px 0;padding:10px 13px 11px;background:#fff;border:1px solid #E6E9F0;border-top:3px solid #0A1A3A;color:#2a3756;font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.4}\n  .esg-fit *{box-sizing:border-box}\n\n  .esg-fit__head{display:flex;align-items:center;gap:12px;min-width:0}\n  .esg-fit__icon{flex:0 0 32px;width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1px solid #E6E9F0;color:#0A1A3A}\n  .esg-fit__icon svg{width:18px;height:18px;display:block}\n  .esg-fit__headtxt{flex:1 1 auto;min-width:0}\n  .esg-fit__ttlrow{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}\n  .esg-fit__title{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:17px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;color:#0A1A3A;line-height:1.05}\n  .esg-fit__specs{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#6B7390;line-height:1.1}\n  .esg-fit__text{display:block;font-size:12.5px;line-height:1.35;color:#2a3756;margin:3px 0 0}\n\n  .esg-fit__calc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:10px;align-items:stretch}\n  .esg-fit__field{display:flex;flex-direction:column;min-width:0}\n  .esg-fit__lbl{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#6B7390;line-height:1;margin:0 0 5px}\n  .esg-fit__inputwrap{position:relative;display:flex;align-items:stretch}\n  .esg-fit__input{flex:1 1 auto;min-width:0;height:38px;padding:0 34px 0 11px;background:#fff;border:1px solid #C9CEDB;border-radius:0;color:#0A1A3A;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:19px;font-weight:800;letter-spacing:.02em;line-height:1;appearance:textfield;-moz-appearance:textfield;transition:border-color .15s ease,box-shadow .15s ease}\n  .esg-fit__input::-webkit-outer-spin-button,.esg-fit__input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}\n  .esg-fit__input:focus{outline:none;border-color:#0A1A3A;box-shadow:0 0 0 2px rgba(10,26,58,.14)}\n  .esg-fit__unit{position:absolute;right:11px;top:50%;transform:translateY(-50%);font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B7390;pointer-events:none}\n\n  .esg-fit__result{display:flex;flex-direction:column;justify-content:center;padding:7px 12px;background:#0A1A3A;border:1px solid #0A1A3A;min-width:0}\n  .esg-fit__reslbl{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#C9D6F2;line-height:1}\n  .esg-fit__resval{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:21px;font-weight:800;letter-spacing:.02em;line-height:1.1;color:#fff;font-variant-numeric:tabular-nums;margin:4px 0 0}\n  .esg-fit__ressub{font-size:11px;line-height:1.3;color:#C9D6F2;margin:2px 0 0}\n\n  .esg-fit__foot{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}\n  .esg-fit__note{font-size:11px;line-height:1.3;color:#6B7390}\n  .esg-fit__link{display:inline-flex;align-items:center;gap:6px;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#0A1A3A;text-decoration:none;border-bottom:1px solid #0A1A3A;padding-bottom:1px}\n  .esg-fit__link svg{width:12px;height:12px}\n\n  .esg-fit__btn{align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 18px;background:#0A1A3A;border:1px solid #0A1A3A;border-radius:0;color:#fff;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:14px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;line-height:1;text-decoration:none;white-space:nowrap;transition:background .15s ease,color .15s ease}\n  .esg-fit__btn:hover,.esg-fit__btn:focus-visible{background:#fff;color:#0A1A3A}\n  .esg-fit__btn svg{width:13px;height:13px}\n\n  @media (max-width:749px){\n    .esg-fit{padding:10px 12px 11px}\n    .esg-fit__title{font-size:16px}\n    .esg-fit__calc{grid-template-columns:1fr}\n    .esg-fit__input{height:42px;font-size:18px}\n    .esg-fit__resval{font-size:20px}\n    .esg-fit__btn{align-self:stretch;width:100%}\n    .esg-fit__foot{flex-direction:column;align-items:flex-start;gap:5px}\n  }\n</style>\n\n{%- if has_throw_data -%}\n<script>\n(function () {\n  if (window.esgProjFit) { return; }\n  window.esgProjFit = true;\n\n  function ftIn(inches) {\n    var total = Math.round(inches);\n    return Math.floor(total / 12) + \"' \" + (total % 12) + '\"';\n  }\n\n  function wire(root) {\n    if (root.getAttribute('data-esg-ready')) { return; }\n    root.setAttribute('data-esg-ready', '1');\n\n    var input = root.querySelector('.esg-fit__input');\n    var resEl = root.querySelector('[data-result]');\n    var subEl = root.querySelector('[data-result-sub]');\n    var hintEl = root.querySelector('[data-width-hint]');\n    if (!input || !resEl) { return; }\n\n    var trMin = parseFloat(root.getAttribute('data-throw-min'));\n    var trMax = parseFloat(root.getAttribute('data-throw-max'));\n    var minH = parseFloat(root.getAttribute('data-min-height'));\n    var maxH = parseFloat(root.getAttribute('data-max-height'));\n\n    var parts = (root.getAttribute('data-aspect') || '16:9').split(':');\n    var aW = parseFloat(parts[0]) || 16;\n    var aH = parseFloat(parts[1]) || 9;\n    var ratio = aW / aH;\n\n    function update() {\n      var h = parseFloat(input.value);\n\n      if (isNaN(h) || h < minH || h > maxH) {\n        resEl.textContent = '—';\n        if (subEl) { subEl.textContent = 'Enter a height between ' + minH + ' and ' + maxH + ' inches'; }\n        if (hintEl) { hintEl.textContent = 'Screen width —'; }\n        return;\n      }\n\n      var w = h * ratio;\n      if (hintEl) {\n        hintEl.textContent = 'Screen width ' + ftIn(w) + ' (' + aW + ':' + aH + ')';\n      }\n\n      var near = w * trMin;\n      var far = w * trMax;\n\n      if (Math.abs(far - near) < 0.5) {\n        resEl.textContent = ftIn(near);\n        if (subEl) { subEl.textContent = 'Fixed throw, screen to lens'; }\n      } else {\n        resEl.textContent = ftIn(near) + ' – ' + ftIn(far);\n        if (subEl) { subEl.textContent = 'Zoom range, screen to lens'; }\n      }\n    }\n\n    input.addEventListener('input', update);\n    input.addEventListener('change', update);\n    update();\n  }\n\n  function init() {\n    var nodes = document.querySelectorAll('[data-esg-fit]');\n    for (var i = 0; i < nodes.length; i++) { wire(nodes[i]); }\n  }\n\n  init();\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  }\n  document.addEventListener('shopify:section:load', init);\n})();\n</script>\n{%- endif -%}\n{%- endif -%}"
