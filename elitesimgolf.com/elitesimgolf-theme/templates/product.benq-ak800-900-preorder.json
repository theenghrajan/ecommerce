        "custom_liquid_dPaB4K": {
          "type": "custom-liquid",
          "name": "Fathers Day Sale Block",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Elite Sim Golf — Father's Day Sale Mini PDP Box\n  - Renders only for products tagged \"fathers-day\" (or \"dad-sale\")\n  - Auto-hides server-side after the cutoff (no JS hide needed)\n  - Matches VTrack PDP design language: Barlow Condensed, #0A1A3A navy, #086ED3 blue\n{%- endcomment -%}\n\n{%- assign sale_end_str = '2026-06-24 00:00:00' -%}\n{%- assign sale_end_ts  = sale_end_str | date: '%s' -%}\n{%- assign now_ts       = 'now' | date: '%s' -%}\n\n{%- assign is_dad_product = false -%}\n{%- assign tags_downcase = product.tags | join: '|' | downcase | split: '|' -%}\n{%- if tags_downcase contains 'dad' or tags_downcase contains 'dad-sale' or tags_downcase contains 'fathers-day' or tags_downcase contains \"father's day\" or tags_downcase contains 'fathers day' -%}\n  {%- assign is_dad_product = true -%}\n{%- endif -%}\n\n{%- if is_dad_product and now_ts < sale_end_ts -%}\n<div class=\"esg-dad-sale\">\n  <div class=\"esg-dad-sale__accent\"></div>\n\n  <div class=\"esg-dad-sale__eyebrow\">\n    <span class=\"esg-dad-sale__eyebrow-icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"3\" y=\"8\" width=\"18\" height=\"13\" rx=\"1.5\"></rect>\n        <path d=\"M3 12h18\"></path>\n        <path d=\"M12 8v13\"></path>\n        <path d=\"M12 8c-2.5 0-4-1.2-4-3a2 2 0 0 1 4-2c2 0 4 2.5 4 5\"></path>\n        <path d=\"M12 8c2.5 0 4-1.2 4-3a2 2 0 0 0-4-2c-2 0-4 2.5-4 5\"></path>\n      </svg>\n    </span>\n    Father's Day Sale\n  </div>\n\n  <h3 class=\"esg-dad-sale__title\">Give Dad the Ultimate Golf Gift.</h3>\n\n  <div class=\"esg-dad-sale__coupon\">\n    <div class=\"esg-dad-sale__coupon-label\">Coupon Code</div>\n    <div class=\"esg-dad-sale__coupon-code\">DADSDAY</div>\n  </div>\n\n  <div class=\"esg-dad-sale__copy\">\n    Save on simulator packages, launch monitors, enclosures, projectors, mats, and accessories. For the best deal, text <a href=\"sms:+18652482729\" class=\"esg-dad-sale__phone\">865-248-2729</a>.\n  </div>\n</div>\n\n<style>\n  .esg-dad-sale {\n    max-width: 600px;\n    margin: 12px 0;\n    position: relative;\n    overflow: hidden;\n    padding: 12px 14px 13px;\n    border: 1px solid rgba(255, 255, 255, .14);\n    border-radius: 14px;\n    background: linear-gradient(135deg, #020617 0%, #071a33 55%, #0A1A3A 100%);\n    color: #C9D6F2;\n    font-family: inherit;\n    line-height: 1.4;\n    box-shadow: 0 10px 24px rgba(15, 23, 42, .18);\n  }\n\n  .esg-dad-sale__accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 3px;\n    background: linear-gradient(90deg, #086ED3 0%, #ffffff 100%);\n  }\n\n  .esg-dad-sale__eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    margin-bottom: 8px;\n    color: #C9D6F2;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .esg-dad-sale__eyebrow-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 16px;\n    height: 16px;\n    color: #086ED3;\n  }\n\n  .esg-dad-sale__eyebrow-icon svg {\n    width: 16px;\n    height: 16px;\n    display: block;\n  }\n\n  .esg-dad-sale__title {\n    margin: 0 0 10px;\n    color: #ffffff;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: clamp(18px, 2vw, 22px);\n    font-weight: 800;\n    letter-spacing: -.01em;\n    line-height: 1.05;\n    text-transform: uppercase;\n  }\n\n  .esg-dad-sale__coupon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    margin-bottom: 10px;\n    padding: 8px 12px;\n    border-radius: 10px;\n    background: #ffffff;\n    border: 1px solid rgba(8, 110, 211, .25);\n  }\n\n  .esg-dad-sale__coupon-label {\n    color: #2a3756;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .esg-dad-sale__coupon-code {\n    color: #086ED3;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 20px;\n    font-weight: 800;\n    letter-spacing: .12em;\n    line-height: 1;\n  }\n\n  .esg-dad-sale__copy {\n    color: #C9D6F2;\n    font-size: 12.5px;\n    line-height: 1.4;\n  }\n\n  .esg-dad-sale__phone {\n    color: #ffffff;\n    font-weight: 800;\n    white-space: nowrap;\n    text-decoration: underline;\n    text-decoration-color: rgba(255, 255, 255, .35);\n    text-underline-offset: 2px;\n  }\n\n  .esg-dad-sale__phone:hover {\n    text-decoration-color: #ffffff;\n  }\n\n  @media (max-width: 749px) {\n    .esg-dad-sale {\n      padding: 11px 12px 12px;\n      border-radius: 12px;\n    }\n\n    .esg-dad-sale__title {\n      font-size: 18px;\n    }\n\n    .esg-dad-sale__coupon {\n      flex-direction: column;\n      gap: 2px;\n      padding: 7px 10px;\n    }\n\n    .esg-dad-sale__coupon-code {\n      font-size: 18px;\n    }\n\n    .esg-dad-sale__copy {\n      font-size: 12px;\n    }\n  }\n</style>\n{%- endif -%}"
          }
        },
        "custom_liquid_nKLwzq": {
          "type": "custom-liquid",
          "name": "Freedom Sale Block",
          "settings": {
            "custom_liquid": "<!-- FREEDOM 250 SALE — PDP Callout Section -->\n<!-- Elite Sim Golf | June 24 – July 31, 2026 -->\n<!--\n  USAGE: Paste into your product .liquid theme file.\n  Tag products with:\n    FREEDOM                           → required to show callout\n    FREE5 / FREE10 / FREE15 / FREE20  → shows that % off (optional)\n  Date gate is server-side — auto-shows June 24 and auto-hides August 1.\n-->\n\n{% assign f250_now   = 'now'                  | date: '%s' | plus: 0 %}\n{% assign f250_start = '2026-06-24T00:00:00Z' | date: '%s' | plus: 0 %}\n{% assign f250_end   = '2026-08-01T00:00:00Z' | date: '%s' | plus: 0 %}\n\n{% if product.tags contains 'FREEDOM' and f250_now >= f250_start and f250_now < f250_end %}\n\n{% assign f250_pct = '' %}\n{% if product.tags contains 'FREE20' %}{% assign f250_pct = '20' %}\n{% elsif product.tags contains 'FREE15' %}{% assign f250_pct = '15' %}\n{% elsif product.tags contains 'FREE10' %}{% assign f250_pct = '10' %}\n{% elsif product.tags contains 'FREE5'  %}{% assign f250_pct = '5'  %}\n{% endif %}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .esg-f250-callout *,\n  .esg-f250-callout *::before,\n  .esg-f250-callout *::after {\n    box-sizing: border-box;\n  }\n\n  .esg-f250-callout {\n    background-color: #0A1A3A;\n    font-family: 'Barlow Condensed', sans-serif;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* Red/white stripe top accent */\n  .esg-f250-callout::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 4px;\n    background: repeating-linear-gradient(\n      to right,\n      #C8102E 0px,\n      #C8102E 50px,\n      #ffffff 50px,\n      #ffffff 100px\n    );\n    opacity: 0.85;\n  }\n\n  .esg-f250-callout__inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 28px 48px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 32px;\n    flex-wrap: wrap;\n  }\n\n  .esg-f250-callout__left {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    flex-wrap: wrap;\n  }\n\n  .esg-f250-callout__lockup {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n\n  .esg-f250-callout__eyebrow {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: #C8102E;\n    line-height: 1;\n  }\n\n  .esg-f250-callout__title {\n    font-size: clamp(22px, 3vw, 32px);\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: -0.01em;\n    color: #ffffff;\n    line-height: 1;\n  }\n\n  .esg-f250-callout__divider {\n    width: 1px;\n    height: 40px;\n    background: rgba(255, 255, 255, 0.15);\n    flex-shrink: 0;\n  }\n\n  .esg-f250-callout__details {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n\n  .esg-f250-callout__savings {\n    font-size: 15px;\n    font-weight: 700;\n    color: #ffffff;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n  }\n\n  .esg-f250-callout__savings em {\n    color: #C8102E;\n    font-style: normal;\n  }\n\n  .esg-f250-callout__date {\n    font-family: 'Inter', system-ui, sans-serif;\n    font-size: 12px;\n    font-weight: 500;\n    color: rgba(255, 255, 255, 0.55);\n    letter-spacing: 0.03em;\n  }\n\n  .esg-f250-callout__date strong {\n    color: #ffffff;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 15px;\n    font-weight: 800;\n    letter-spacing: 0.12em;\n    background: rgba(255, 255, 255, 0.1);\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    padding: 2px 10px;\n    border-radius: 3px;\n    margin-left: 4px;\n  }\n\n  .esg-f250-callout__ends {\n    font-family: 'Inter', system-ui, sans-serif;\n    font-size: 12px;\n    font-weight: 500;\n    color: rgba(255, 255, 255, 0.38);\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 900px) {\n    .esg-f250-callout__inner {\n      padding: 24px;\n      gap: 20px;\n    }\n\n    .esg-f250-callout__divider {\n      display: none;\n    }\n\n    .esg-f250-callout__ends {\n      display: none;\n    }\n  }\n\n  @media (max-width: 560px) {\n    .esg-f250-callout__left {\n      gap: 12px;\n    }\n  }\n</style>\n\n<div class=\"esg-f250-callout\">\n  <div class=\"esg-f250-callout__inner\">\n\n    <div class=\"esg-f250-callout__left\">\n      <div class=\"esg-f250-callout__lockup\">\n        <div class=\"esg-f250-callout__eyebrow\">Limited-Time Offer</div>\n        <div class=\"esg-f250-callout__title\">Freedom 250 Sale</div>\n      </div>\n      <div class=\"esg-f250-callout__divider\"></div>\n      <div class=\"esg-f250-callout__details\">\n        {% if f250_pct != '' %}\n          <div class=\"esg-f250-callout__savings\">Save <em>{{ f250_pct }}%</em> at checkout</div>\n          <div class=\"esg-f250-callout__date\">Use code<strong>FREE</strong> at checkout &mdash; Sale ends July 31, 2026</div>\n        {% else %}\n          <div class=\"esg-f250-callout__savings\"></div>\n          <div class=\"esg-f250-callout__date\">Use code<strong>FREE</strong> at checkout &mdash; Sale ends July 31, 2026</div>\n        {% endif %}\n      </div>\n    </div>\n\n\n  </div>\n</div>\n\n{% endif %}"
          }
