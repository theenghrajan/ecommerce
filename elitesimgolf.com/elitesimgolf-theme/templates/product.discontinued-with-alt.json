            "custom_liquid": "{%- comment -%}\nDISCONTINUED BOX\nTrigger options:\n1) Add product tag: discontinued\n2) Create product metafield: custom.discontinued (type: true/false) and set to true\n\nClosest alternative hardcoded to Birdie 10:\n- Update birdie_handle if your URL handle is different.\n{%- endcomment -%}\n\n{%- assign birdie_handle = 'birdie-10-golf-simulator-enclosure' -%}\n{%- assign birdie_url = routes.root_url | append: 'products/' | append: birdie_handle -%}\n\n{%- assign is_discontinued = false -%}\n{%- if product.tags contains 'discontinued' -%}\n  {%- assign is_discontinued = true -%}\n{%- endif -%}\n\n{%- if product.metafields.custom.discontinued == true -%}\n  {%- assign is_discontinued = true -%}\n{%- endif -%}\n\n{%- if is_discontinued -%}\n  <div style=\"\n    margin:14px 0 0;\n    padding:14px 16px;\n    border-radius:16px;\n    border:2px solid #ef4444;\n    background:linear-gradient(180deg, #ffffff 0%, #fff5f5 100%);\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    color:#0f172a;\n    display:flex;\n    align-items:flex-start;\n    gap:12px;\n    box-shadow:0 10px 24px rgba(0,0,0,.06);\n  \">\n    <div style=\"\n      width:34px; height:34px; border-radius:12px;\n      background:#ffe4e6;\n      display:flex; align-items:center; justify-content:center;\n      font-size:18px; flex:0 0 auto;\n      border:1px solid rgba(239,68,68,.25);\n    \">⛔</div>\n\n    <div style=\"line-height:1.25; flex:1;\">\n      <div style=\"\n        display:flex;\n        align-items:center;\n        justify-content:space-between;\n        gap:10px;\n        margin:0 0 8px;\n      \">\n        <div style=\"font-weight:900; font-size:13px; letter-spacing:.02em;\">\n          Discontinued Item\n        </div>\n\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          gap:8px;\n          padding:6px 10px;\n          border-radius:999px;\n          background:#ef4444;\n          color:#ffffff;\n          font-weight:900;\n          font-size:12px;\n          letter-spacing:.02em;\n          white-space:nowrap;\n          box-shadow:0 8px 18px rgba(239,68,68,.25);\n        \">\n          NO LONGER AVAILABLE\n        </div>\n      </div>\n\n      <div style=\"\n        font-size:12.5px;\n        color:#334155;\n        background:#ffffff;\n        border:1px solid rgba(15,23,42,.10);\n        border-radius:12px;\n        padding:10px 12px;\n        margin:0 0 10px;\n      \">\n        <div style=\"font-weight:900; color:#0f172a; margin:0 0 4px;\">\n          This product has been discontinued.\n        </div>\n        <div style=\"margin:0;\">\n          The closest alternative is the <span style=\"font-weight:900; color:#086ed3;\">Birdie 10</span>.\n        </div>\n      </div>\n\n      <a href=\"{{ birdie_url }}\" style=\"\n        display:inline-flex;\n        align-items:center;\n        justify-content:center;\n        gap:10px;\n        padding:10px 14px;\n        border-radius:12px;\n        background:#086ed3;\n        color:#ffffff;\n        font-weight:900;\n        font-size:13px;\n        text-decoration:none;\n        border:1px solid rgba(8,110,211,.25);\n        box-shadow:0 10px 20px rgba(8,110,211,.22);\n      \">\n        View Birdie 10\n        <span aria-hidden=\"true\">→</span>\n      </a>\n\n      <div style=\"margin-top:8px; font-size:12px; color:#64748b;\">\n        Need help picking the right fit? Contact us and we’ll help you match sizing and setup.\n      </div>\n    </div>\n  </div>\n{%- endif -%}"
