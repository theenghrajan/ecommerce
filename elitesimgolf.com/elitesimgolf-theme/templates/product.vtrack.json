          "settings": {
            "custom_liquid": "{%- comment -%}\nESG Standalone Button — Add VTrack Impact Protector ($0.01) to Cart\n- Shows ONLY on products tagged: vtrackpromo\n- Adds protector variant ID: 45931905482946\n- Does NOT touch the main Add to Cart behavior\n{%- endcomment -%}\n\n{%- assign show_vtrack_promo_offer = false -%}\n{%- if product.tags contains 'vtrackpromo' -%}\n  {%- assign show_vtrack_promo_offer = true -%}\n{%- endif -%}\n\n{%- if show_vtrack_promo_offer -%}\n<div id=\"esg-protector-standalone\" style=\"\n  max-width:1100px;\n  margin:14px auto 0;\n  font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  color:#111827;\n\">\n  <div style=\"\n    padding:14px 16px;\n    border-radius:16px;\n    border:1px solid #086ed3;\n    background:linear-gradient(180deg,#ffffff 0%,#ffffff 100%);\n    box-shadow:0 10px 22px rgba(8,110,211,.08);\n    display:flex;\n    align-items:flex-start;\n    gap:12px;\n    position:relative;\n    overflow:hidden;\n  \">\n    <div style=\"\n      position:absolute;\n      inset:0 auto 0 0;\n      width:5px;\n      background:linear-gradient(180deg,#086ed3 0%,#38bdf8 100%);\n    \"></div>\n\n    <div style=\"\n      width:100px;\n      height:100px;\n      border-radius:12px;\n      background:#ffffff;\n      border:1px solid rgba(8,110,211,.14);\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      flex:0 0 auto;\n      margin-left:2px;\n      overflow:hidden;\n    \">\n      <img\n        src=\"https://elitesimgolf.com/cdn/shop/files/VTK-Protector.png\"\n        alt=\"VTrack Impact Protector\"\n        style=\"width:100px; height:100px; object-fit:contain; display:block;\"\n      >\n    </div>\n\n    <div style=\"flex:1; min-width:0;\">\n      <div style=\"\n        display:inline-flex;\n        align-items:center;\n        gap:8px;\n        padding:5px 9px;\n        border-radius:999px;\n        background:#086ed3;\n        color:#ffffff;\n        font-size:10px;\n        font-weight:900;\n        letter-spacing:.10em;\n        text-transform:uppercase;\n        margin:0 0 8px;\n      \">\n        Limited Time Add-On\n      </div>\n\n      <div style=\"\n        font-size:15px;\n        line-height:1.3;\n        font-weight:950;\n        color:#0b2a55;\n        margin:0 0 4px;\n      \">\n        VTrack Impact Protector — $0.01 Promo\n      </div>\n\n      <div style=\"font-size:13px; color:#475569; margin:0 0 10px;\">\n        Add the <strong>VTrack Impact Protector</strong> to your cart for a limited-time promotional price of <strong>$0.01</strong>.\n      </div>\n\n      <div style=\"display:flex; flex-wrap:wrap; gap:10px; align-items:center;\">\n        <button type=\"button\" id=\"esgAddProtectorBtn\" style=\"\n          appearance:none;\n          border:none;\n          border-radius:12px;\n          padding:11px 14px;\n          background:#086ed3;\n          color:#ffffff;\n          font-weight:900;\n          font-size:13px;\n          cursor:pointer;\n          box-shadow:0 10px 20px rgba(8,110,211,.18);\n        \">\n          Add VTrack Protector to Cart\n        </button>\n\n        <div style=\"font-size:12px; color:#64748b;\">\n          Elite Sim Golf SKU# <strong>VTRACK-PROTECT</strong>\n        </div>\n      </div>\n\n      <div id=\"esgProtectorStatus\" style=\"\n        display:none;\n        margin-top:10px;\n        padding:10px 12px;\n        border-radius:12px;\n        font-size:12.5px;\n        font-weight:800;\n      \"></div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var VARIANT_ID = 45931905482946;\n  var btn = document.getElementById('esgAddProtectorBtn');\n  var status = document.getElementById('esgProtectorStatus');\n  if (!btn || !status) return;\n\n  function showStatus(message, type) {\n    status.style.display = 'block';\n    status.textContent = message;\n\n    if (type === 'success') {\n      status.style.background = '#ecfdf5';\n      status.style.border = '1px solid #10b981';\n      status.style.color = '#065f46';\n    } else {\n      status.style.background = '#fff7f7';\n      status.style.border = '1px solid #ef4444';\n      status.style.color = '#991b1b';\n    }\n  }\n\n  async function addProtector() {\n    var original = btn.innerHTML;\n    btn.disabled = true;\n    btn.style.opacity = '0.7';\n    btn.innerHTML = 'Adding...';\n\n    try {\n      var res = await fetch('/cart/add.js', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json',\n          'X-Requested-With': 'XMLHttpRequest'\n        },\n        body: JSON.stringify({ id: VARIANT_ID, quantity: 1 })\n      });\n\n      if (!res.ok) {\n        var txt = await res.text();\n        console.error('Add protector failed:', txt);\n        throw new Error('Could not add protector. Check console for details.');\n      }\n\n      showStatus('Added! VTrack Impact Protector is now in your cart.', 'success');\n\n      // Optional: fire a few common cart refresh events (harmless if unused)\n      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles:true }));\n      document.dispatchEvent(new CustomEvent('cart:updated', { bubbles:true }));\n      document.dispatchEvent(new CustomEvent('alchemy:cart:refresh', { bubbles:true }));\n      window.dispatchEvent(new CustomEvent('cart:refresh'));\n    } catch (e) {\n      console.error(e);\n      showStatus(e.message || 'There was a problem adding the protector.', 'error');\n    } finally {\n      btn.disabled = false;\n      btn.style.opacity = '1';\n      btn.innerHTML = original;\n    }\n  }\n\n  btn.addEventListener('click', addProtector);\n})();\n</script>\n{%- endif -%}"
          }
