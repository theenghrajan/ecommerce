ign-items:flex-start;\">\n          <div style=\"\n            width:92px; height:92px;\n            border-radius:12px;\n            background:#ffffff;\n            border:1px solid rgba(8,110,211,.14);\n            display:flex;\n            align-items:center;\n            justify-content:center;\n            flex:0 0 auto;\n            overflow:hidden;\n          \">\n            <img\n              src=\"https://elitesimgolf.com/cdn/shop/files/VTK-Protector.png\"\n              alt=\"VTrack Impact Protector\"\n              style=\"width:92px; height:92px; object-fit:contain; display:block;\"\n            >\n          </div>\n\n          <div style=\"flex:1; min-width:0;\">\n            <div style=\"font-weight:950; font-size:14px; color:#0b2a55; margin:0 0 4px;\">\n              VTrack Protector by Elite Sim Golf\n            </div>\n            <div style=\"font-weight:950; font-size:14px; color:#0b2a55; margin:0 0 8px;\">\n              $179.99\n            </div>\n            <div style=\"font-size:12.5px; color:#475569; margin:0;\">\n              Add the impact shield to help protect your VTrack investment. Made in the USA. Lifetime Guarantee.\n            </div>\n          </div>\n        </div>\n\n        <div style=\"display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:12px;\">\n          <button type=\"button\" id=\"esgAddProtectorOnlyBtn\" style=\"\n            appearance:none;\n            border:none;\n            border-radius:12px;\n            padding:11px 14px;\n            background:#086ed3;\n            color:#ffffff;\n            font-weight:950;\n            font-size:13px;\n            cursor:pointer;\n            box-shadow:0 10px 20px rgba(8,110,211,.18);\n          \">\n            Add Protector ($179.99)\n          </button>\n\n          <div style=\"font-size:12px; color:#64748b;\">\n            SKU# <strong>VTRACK-PROTECT</strong>\n          </div>\n        </div>\n\n        <div id=\"esgStatusProtectorOnly\" styl