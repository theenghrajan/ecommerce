ight:900; font-size:13px; letter-spacing:.02em;\">\n            Inventory Status\n          </div>\n\n          <div style=\"\n            display:inline-flex;\n            align-items:center;\n            gap:8px;\n            padding:6px 10px;\n            border-radius:999px;\n            background:#086ed3;\n            color:#ffffff;\n            font-weight:900;\n            font-size:12px;\n            letter-spacing:.02em;\n            box-shadow:0 8px 18px rgba(8,110,211,.25);\n            white-space:nowrap;\n          \">🚀 FREE UPS 2ND DAY DELIVERY</div>\n        </div>\n\n        <!-- On-hand -->\n        <div style=\"\n          display:flex;\n          align-items:baseline;\n          justify-content:space-between;\n          gap:12px;\n          flex-wrap:wrap;\n          margin:0 0 10px;\n        \">\n          <div style=\"display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;\">\n            <div style=\"\n              font-weight:1000;\n              font-size:26px;\n              line-height:1;\n              color:#0b2a55;\n            \">{{ total_on_hand }}</div>\n\n            <div style=\"font-size:14px; font-weight:800; color:#1f2937;\">\n              TOTAL ON-HAND\n            </div>\n          </div>\n\n          <div style=\"\n            display:inline-flex;\n            align-items:center;\n            padding:4px 10px;\n            border-radius:999px;\n            background:#086ed3;\n            border:1px solid rgba(8,110,211,.18);\n            font-size:12px;\n            font-weight:950;\n            color:#ffffff;\n            white-space:nowrap;\n            box-shadow:0 8px 18px rgba(8,110,211,.22);\n          \">✅ NO TARIFFS, NO WAITS</div>\n        </div>\n\n        <!-- SINGLE LOCATION LINE (no separate warehouse breakdown) -->\n        <div style=\"display:flex; flex-wrap:wrap; gap:8px; margin:0 0 10px;\">\n\n          <span style=\"\n            display:inline-flex; align-items:center; gap:8px;\n            padding:6px 10px; border-radius:999px;\n            background:#e7f2ff; border:1px solid rgba(8,110,211,.22);\n            font-size:12px; font-weight:950; color:#0b2a55; white-space:nowrap;\n          \">\n            📍 AVAILABLE FOR LOCAL PICKUP — LENOIR CITY, TN\n          </span>\n        </div>\n      </div>\n    </div>\n\n  {%- else -%}\n    <!-- ========================================= -->\n    <!-- OUT-OF-STOCK / INCOMING BOX (BOLD compact) -->\n    <!-- ========================================= -->\n\n    <div style=\"\n      margin:12px 0 0;\n      padding:12px 14px;\n      border-radius:14px;\n      border:1px solid rgba(8,110,211,.45);\n      background:linear-gradient(180deg, #ffffff 0%, #ffffff 100%);\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n      color:#0f172a;\n      display:flex;\n      align-items:flex-start;\n      gap:12px;\n      box-shadow:0 12px 26px rgba(8,110,211,.10);\n    \">\n      <div style=\"\n        width:34px; height:34px; border-radius:12px;\n        background:#e7f2ff;\n        border:1px solid rgba(8,110,211,.28);\n        display:flex; align-items:center; justify-content:center;\n        font-size:18px; flex:0 0 auto;\n        box-shadow:0 10px 20px rgba(8,110,211,.12);\n      \">📦</div>\n\n      <div style=\"line-height:1.35; flex:1;\">\n\n        <!-- Title + Badge -->\n        <div style=\"\n          display:flex;\n          align-items:flex-start;\n          justify-content:space-between;\n          gap:10px;\n          flex-wrap:wrap;\n          margin:0 0 8px;\n        \">\n          <div style=\"font-weight:1000; font-size:13px; letter-spacing:.02em;\">\n            Inventory & Shipping\n          </div>\n\n          <div style=\"\n            display:inline-flex;\n            align-items:center;\n            gap:8px;\n            padding:6px 10px;\n            border-radius:999px;\n            background:#086ed3;\n            color:#ffffff;\n            font-weight:950;\n            font-size:12px;\n            letter-spacing:.02em;\n            box-shadow:0 10px 22px rgba(8,110,211,.24);\n            white-space:nowrap;\n          \">🚀 FREE UPS 2ND DAY AIR (VTRACK UNIT ONLY)</div>\n        </div>\n\n        <!-- Shipping copy (always visible) -->\n        <div style=\"\n          font-size:12.5px;\n          color:#334155;\n          background:#ffffff;\n          border:1px solid rgba(8,110,211,.20);\n          border-radius:12px;\n          padding:10px 12px;\n          box-shadow:0 10px 22px rgba(0,0,0,.06);\n        \">\n          <div style=\"font-weight:1000; color:#0b2a55; margin:0 0 4px;\">\n            The <span style=\"color:#086ed3; font-weight:1000;\">VTRACK unit</span> ships FREE via <span style=\"color:#086ed3; font-weight:1000;\">UPS 2nd Day Air</span>.\n          </div>\n          <div style=\"margin:0;\">\n            <span style=\"font-weight:950; color:#0f172a;\">Accessories or other items on the same order ship UPS Ground.</span>\n            Most orders ship the same business day when placed prior to noon (volume/holiday/weekend exclusions apply).\n          </div>\n        </div>\n\n        {%- if show_incoming -%}\n          <!-- Incoming -->\n          <div style=\"margin-top:12px; padding-top:12px; border-top:1px solid rgba(8,110,211,.18);\">\n            <div style=\"\n              display:flex;\n              align-items:flex-start;\n              justify-content:space-between;\n              gap:10px;\n              flex-wrap:wrap;\n              margin:0 0 6px;\n            \">\n              <div style=\"font-weight:1000; font-size:13px; color:#0f172a;\">\n                Incoming Inventory\n              </div>\n              <div style=\"\n                display:inline-flex;\n                align-items:center;\n                gap:8px;\n                padding:6px 10px;\n                border-radius:999px;\n                background:#0b2a55;\n                color:#ffffff;\n                font-weight:950;\n                font-size:12px;\n                box-shadow:0 10px 22px rgba(11,42,85,.22);\n                white-space:nowrap;\n              \">🚚 INCOMING</div>\n            </div>\n\n            <div style=\"\n              font-size:12.5px;\n              color:#334155;\n              background:#ffffff;\n              border:1px dashed rgba(8,110,211,.35);\n              border-radius:12px;\n              padding:10px 12px;\n            \">\n              <div style=\"font-weight:950; color:#0f172a;\">\n                Typical lead time: <span style=\"color:#086ed3;\">2–3 weeks</span>\n              </div>\n\n              <div style=\"margin-top:8px; display:flex; flex-wrap:wrap; gap:8px; align-items:center;\">\n                <span style=\"\n                  display:inline-flex; align-items:center; gap:8px;\n                  padding:6px 10px; border-radius:999px;\n                  background:#f1f5f9;\n                  border:1px solid rgba(15,23,42,.12);\n                  font-size:12px; font-weight:1000; color:#0f172a;\n                  white-space:nowrap;\n                \">\n                  🚚 Incoming: <span style=\"color:#086ed3;\">{{ incoming_qty }}</span>\n                </span>\n\n                <span style=\"\n                  display:inline-flex; align-items:center; gap:8px;\n                  padding:6px 10px; border-radius:999px;\n                  background:#e7f2ff;\n                  border:1px solid rgba(8,110,211,.26);\n                  font-size:12px; font-weight:1000; color:#0b2a55;\n                  white-space:nowrap;\n                \">⏳ PRE-ORDER / BACKORDER</span>\n              </div>\n\n              <div style=\"margin-top:10px;\">\n                <span style=\"\n                  display:inline-flex; align-items:center; gap:8px;\n                  padding:6px 10px; border-radius:999px;\n                  background:#ffffff; border:1px solid rgba(15,23,42,.10);\n                  font-size:12px; font-weight:900; color:#0f172a; white-space:nowrap;\n                \">\n                  📍 AVAILABLE FOR LOCAL PICKUP — LENOIR CITY, TN (when in stock)\n                </span>\n              </div>\n            </div>\n          </div>\n        {%- endif -%}\n\n      </div>\n    </div>\n\n  {%- endif -%}\n\n{%- endif -%}"
          }
        },
        "custom_liquid_DBnyae": {
          "type": "custom-liquid",
          "name": "Inv + Acc Combo",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nESG STREAMLINED VTRACK BOX (ALL-IN-ONE) — simplified shipping copy\n- Inventory (on-hand vs incoming) + Local pickup pill\n- Keeps the FREE UPS 2nd Day Air badge only (removes the long paragraph)\n- Add-on options (Protector Only vs Ultimate Accessory Bundle) shown ONLY when tagged vtrackpromo\nIMPORTANT: Replace VARIANT_ID_BUNDLE with the correct variant ID for the $199.99 Ultimate Accessory Bundle.\n{%- endcomment -%}\n\n{%- assign south_on_hand = 0 -%}\n{%- assign saw_any_qty_field = false -%}\n\n{%- for v in product.variants -%}\n  {%- if v.inventory_quantity != blank -%}\n    {%- assign saw_any_qty_field = true -%}\n    {%- assign south_on_hand = south_on_hand | plus: v.inventory_quantity -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- assign north_on_hand = product.metafields.custom.inv_north_warehouse | default: 0 | plus: 0 -%}\n{%- assign total_on_hand = south_on_hand | plus: north_on_hand -%}\n\n{%- assign incoming_qty = product.metafields.custom.incoming_po_qty | default: 0 | plus: 0 -%}\n{%- assign show_incoming = false -%}\n{%- if saw_any_qty_field and total_on_hand <= 0 and incoming_qty > 0 -%}\n  {%- assign show_incoming = true -%}\n{%- endif -%}\n\n{%- assign show_vtrackpromo = false -%}\n{%- if product.tags contains 'vtrackpromo' -%}\n  {%- assign show_vtrackpromo = true -%}\n{%- endif -%}\n\n{%- if saw_any_qty_field -%}\n<div id=\"esg-vtrack-streamlined\" style=\"\n  margin:14px 0 0;\n  max-width:1100px;\n  font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  color:#0f172a;\n\">\n\n  <div style=\"\n    padding:14px 16px;\n    border-radius:16px;\n    border:1px solid rgba(8,110,211,.40);\n    background:#ffffff;\n    box-shadow:0 12px 26px rgba(8,110,211,.10);\n    position:relative;\n    overflow:hidden;\n  \">\n    <div style=\"\n      position:absolute;\n      inset:0 auto 0 0;\n      width:5px;\n      background:linear-gradient(180deg,#086ed3 0%,#38bdf8 100%);\n    \"></div>\n\n    <!-- Header row -->\n    <div style=\"display:flex; align-items:flex-start; justify-content:space-between; gap:10px; flex-wrap:wrap; padding-left:2px;\">\n      <div style=\"display:flex; gap:10px; align-items:flex-start;\">\n        <div style=\"\n          width:34px; height:34px; border-radius:12px;\n          background:#e7f2ff; border:1px solid rgba(8,110,211,.18);\n          display:flex; align-items:center; justify-content:center;\n          font-size:18px; flex:0 0 auto;\n        \">📦</div>\n\n        <div>\n          <div style=\"font-weight:1000; font-size:13px; letter-spacing:.02em; margin:0 0 2px;\">\n            Inventory Status\n          </div>\n\n          {%- if total_on_hand > 0 -%}\n            <div style=\"font-size:13px; color:#334155; margin:0;\">\n              <strong style=\"color:#0b2a55;\">In stock</strong>\n            </div>\n          {%- else -%}\n            <div style=\"font-size:13px; color:#334155; margin:0;\">\n              <strong style=\"color:#0b2a55;\">Out of stock</strong>\n              {%- if show_incoming -%}\n                — incoming inventory available.\n              {%- endif -%}\n            </div>\n          {%- endif -%}\n        </div>\n      </div>\n\n      <div style=\"\n        display:inline-flex;\n        align-items:center;\n        gap:8px;\n        padding:6px 10px;\n        border-radius:999px;\n        background:#086ed3;\n        color:#ffffff;\n        font-weight:950;\n        font-size:12px;\n        letter-spacing:.02em;\n        box-shadow:0 10px 22px rgba(8,110,211,.24);\n        white-space:nowrap;\n      \">🚀 FREE UPS 2ND DAY AIR (VTRACK UNIT ONLY)</div>\n    </div>\n\n    <!-- Main content -->\n    <div style=\"margin-top:12px; padding-left:44px;\">\n\n      <!-- Quantity / Status row -->\n      <div style=\"display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin:0 0 10px;\">\n        {%- if total_on_hand > 0 -%}\n          <div style=\"display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;\">\n            <div style=\"font-weight:1000; font-size:26px; line-height:1; color:#0b2a55;\">{{ total_on_hand }}</div>\n            <div style=\"font-size:13px; font-weight:950; color:#1f2937;\">TOTAL ON-HAND</div>\n          </div>\n\n          <div style=\"\n            display:inline-flex; align-items:center;\n            padding:5px 10px; border-radius:999px;\n            background:#086ed3; color:#ffffff;\n            font-size:12px; font-weight:950;\n            box-shadow:0 8px 18px rgba(8,110,211,.22);\n            white-space:nowrap;\n          \">✅ NO TARIFFS, NO WAITS</div>\n        {%- else -%}\n          <div style=\"\n            display:inline-flex; align-items:center; gap:8px;\n            padding:6px 10px; border-radius:999px;\n            background:#f1f5f9; border:1px solid rgba(15,23,42,.12);\n            font-size:12px; font-weight:1000; color:#0f172a;\n          \">⏳ PRE-ORDER / BACKORDER</div>\n\n          {%- if show_incoming -%}\n            <div style=\"\n              display:inline-flex; align-items:center; gap:8px;\n              padding:6px 10px; border-radius:999px;\n              background:#e7f2ff; border:1px solid rgba(8,110,211,.26);\n              font-size:12px; font-weight:1000; color:#0b2a55;\n              white-space:nowrap;\n            \">🚚 Incoming: <span style=\"color:#086ed3;\">{{ incoming_qty }}</span></div>\n          {%- endif -%}\n        {%- endif -%}\n      </div>\n\n      <!-- Incoming lead time (only if incoming is present) -->\n      {%- if show_incoming -%}\n        <div style=\"\n          font-size:12.5px;\n          color:#334155;\n          background:#ffffff;\n          border:1px dashed rgba(8,110,211,.35);\n          border-radius:12px;\n          padding:10px 12px;\n          margin:0 0 10px;\n        \">\n          <div style=\"font-weight:950; color:#0f172a;\">\n            Typical lead time: <span style=\"color:#086ed3;\">2–3 weeks</span>\n          </div>\n        </div>\n      {%- endif -%}\n\n      <!-- Local pickup pill -->\n      <div style=\"display:flex; flex-wrap:wrap; gap:8px; margin:0 0 2px;\">\n        <span style=\"\n          display:inline-flex; align-items:center; gap:8px;\n          padding:6px 10px; border-radius:999px;\n          background:#e7f2ff; border:1px solid rgba(8,110,211,.22);\n          font-size:12px; font-weight:950; color:#0b2a55; white-space:nowrap;\n        \">\n          📍 AVAILABLE FOR LOCAL PICKUP — LENOIR CITY, TN{%- if total_on_hand <= 0 -%} (when in stock){%- endif -%}\n        </span>\n      </div>\n\n      {%- if show_vtrackpromo -%}\n        <!-- Divider -->\n        <div style=\"height:1px; background:rgba(15,23,42,.10); margin:12px 0;\"></div>\n\n        <!-- Add-on options (inside same box) -->\n        <div style=\"display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin:0 0 10px;\">\n          <div style=\"font-weight:1000; font-size:13px; letter-spacing:.02em; color:#0f172a;\">\n            Add Accessories\n          </div>\n          <div style=\"\n            display:inline-flex; align-items:center;\n            padding:5px 10px; border-radius:999px;\n            background:#0b2a55; color:#ffffff;\n            font-size:11px; font-weight:950;\n            letter-spacing:.08em; text-transform:uppercase;\n          \">\n            Recommended\n          </div>\n        </div>\n\n        <div style=\"display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:10px;\">\n          <!-- Option 1 -->\n          <div style=\"border:1px solid rgba(8,110,211,.18); border-radius:14px; background:#ffffff; padding:12px;\">\n            <div style=\"display:flex; gap:10px; align-items:flex-start;\">\n              <div style=\"\n                width:64px; height:64px; border-radius:12px;\n                background:#ffffff; border:1px solid rgba(8,110,211,.14);\n                display:flex; align-items:center; justify-content:center;\n                overflow:hidden; flex:0 0 auto;\n              \">\n                <img src=\"https://elitesimgolf.com/cdn/shop/files/VTK-Protector.png\"\n                     alt=\"VTrack Protector\"\n                     style=\"width:64px; height:64px; object-fit:contain; display:block;\">\n              </div>\n\n              <div style=\"flex:1; min-width:0;\">\n                <div style=\"font-weight:950; font-size:13px; color:#0b2a55; margin:0 0 4px;\">\n                  VTrack Protector Only\n                </div>\n                <div style=\"font-weight:950; font-size:13px; color:#0b2a55; margin:0 0 6px;\">\n                  $179.99\n                </div>\n                <div style=\"font-size:12px; color:#475569; margin:0;\">\n                  Made in the USA • Lifetime Guarantee.\n                </div>\n              </div>\n            </div>\n\n            <div style=\"display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:10px;\">\n              <button type=\"button\" id=\"esgAddProtectorOnlyBtn\" style=\"\n                appearance:none; border:none; border-radius:12px;\n                padding:10px 12px; background:#086ed3; color:#ffffff;\n                font-weight:950; font-size:12.5px; cursor:pointer;\n                box-shadow:0 10px 20px rgba(8,110,211,.18);\n              \">Add Protector</button>\n\n              <div style=\"font-size:12px; color:#64748b;\">SKU# <strong>VTRACK-PROTECT</strong></div>\n            </div>\n\n            <div id=\"esgStatusProtectorOnly\" style=\"\n              display:none; margin-top:10px; padding:10px 12px;\n              border-radius:12px; font-size:12.5px; font-weight:800;\n            \"></div>\n          </div>\n\n          <!-- Option 2 -->\n          <div style=\"border:2px solid #0b2a55; border-radius:14px; background:linear-gradient(180deg,#ffffff 0%,#f4f9ff 100%); padding:12px;\">\n            <div style=\"display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin:0 0 8px;\">\n              <div style=\"font-weight:950; font-size:13px; color:#0b2a55;\">Ultimate Accessory Bundle</div>\n              <div style=\"\n                display:inline-flex; align-items:center;\n                padding:4px 8px; border-radius:999px;\n                background:#111827; color:#ffffff;\n                font-size:10px; font-weight:900; letter-spacing:.10em; text-transform:uppercase;\n              \">Best Value</div>\n            </div>\n\n            <div style=\"display:flex; gap:10px; align-items:flex-start;\">\n              <div style=\"\n                width:64px; height:64px; border-radius:12px;\n                background:#ffffff; border:1px solid rgba(15,23,42,.12);\n                display:flex; align-items:center; justify-content:center;\n                overflow:hidden; flex:0 0 auto;\n              \">\n                <!-- Replace with your bundle image when you have it -->\n                <img src=\"https://elitesimgolf.com/cdn/shop/files/VTK-Protector.png\"\n                     alt=\"Ultimate Accessory Bundle\"\n                     style=\"width:64px; height:64px; object-fit:contain; display:block;\">\n              </div>\n\n              <div style=\"flex:1; min-width:0;\">\n                <div style=\"font-weight:950; font-size:13px; color:#0b2a55; margin:0 0 4px;\">$199.99</div>\n                <div style=\"font-size:12px; color:#334155; margin:0 0 6px;\">\n                  Includes <strong>Protector</strong> + <strong>TP5 Pix (Dozen)</strong> + <strong>Remote Power Switch</strong>.\n                </div>\n                <div style=\"display:flex; flex-wrap:wrap; gap:6px;\">\n                  <span style=\"font-size:11px; font-weight:900; color:#0b2a55; border:1px solid rgba(11,42,85,.18); background:#ffffff; padding:5px 8px; border-radius:999px;\">Protector</span>\n                  <span style=\"font-size:11px; font-weight:900; color:#0b2a55; border:1px solid rgba(11,42,85,.18); background:#ffffff; padding:5px 8px; border-radius:999px;\">TP5 Pix</span>\n                  <span style=\"font-size:11px; font-weight:900; color:#0b2a55; border:1px solid rgba(11,42,85,.18); background:#ffffff; padding:5px 8px; border-radius:999px;\">Remote Switch</span>\n                </div>\n              </div>\n            </div>\n\n            <div style=\"display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:10px;\">\n              <button type=\"button\" id=\"esgAddAccessoryBundleBtn\" style=\"\n                appearance:none; border:none; border-radius:12px;\n                padding:10px 12px; background:#0b2a55; color:#ffffff;\n                font-weight:950; font-size:12.5px; cursor:pointer;\n                box-shadow:0 10px 20px rgba(11,42,85,.18);\n              \">Add Bundle</button>\n\n              <div style=\"font-size:12px; color:#334155;\">Adds as 1 item</div>\n            </div>\n\n            <div id=\"esgStatusBundle\" style=\"\n              display:none; margin-top:10px; padding:10px 12px;\n              border-radius:12px; font-size:12.5px; font-weight:800;\n            \"></div>\n          </div>\n        </div>\n\n        <script>\n        (function () {\n          var VARIANT_ID_PROTECTOR = 45931905482946; // Protector Only\n          var VARIANT_ID_BUNDLE    = 00000000000000; // TODO: replace with Ultimate Accessory Bundle variant ID\n\n          var btnProtector = document.getElementById('esgAddProtectorOnlyBtn');\n          var btnBundle    = document.getElementById('esgAddAccessoryBundleBtn');\n          var stProtector  = document.getElementById('esgStatusProtectorOnly');\n          var stBundle     = document.getElementById('esgStatusBundle');\n\n          function showStatus(el, message, type) {\n            if (!el) return;\n            el.style.display = 'block';\n            el.textContent = message;\n\n            if (type === 'success') {\n              el.style.background = '#ecfdf5';\n              el.style.border = '1px solid #10b981';\n              el.style.color = '#065f46';\n            } else {\n              el.style.background = '#fff7f7';\n              el.style.border = '1px solid #ef4444';\n              el.style.color = '#991b1b';\n            }\n          }\n\n          async function addVariant(variantId, btn, statusEl, successMsg) {\n            if (!variantId || String(variantId).indexOf('000000') === 0) {\n              showStatus(statusEl, 'Bundle variant ID is not set yet. Replace VARIANT_ID_BUNDLE in the script.', 'error');\n              return;\n            }\n\n            var original = btn.innerHTML;\n            btn.disabled = true;\n            btn.style.opacity = '0.7';\n            btn.innerHTML = 'Adding...';\n\n            try {\n              var res = await fetch('/cart/add.js', {\n                method: 'POST',\n                headers: {\n                  'Content-Type': 'application/json',\n                  'Accept': 'application/json',\n                  'X-Requested-With': 'XMLHttpRequest'\n                },\n                body: JSON.stringify({ id: variantId, quantity: 1 })\n              });\n\n              if (!res.ok) {\n                var txt = await res.text();\n                console.error('Add failed:', txt);\n                throw new Error('Could not add item. Check console for details.');\n              }\n\n              showStatus(statusEl, successMsg || 'Added to cart.', 'success');\n\n              document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles:true }));\n              document.dispatchEvent(new CustomEvent('cart:updated', { bubbles:true }));\n              document.dispatchEvent(new CustomEvent('alchemy:cart:refresh', { bubbles:true }));\n              window.dispatchEvent(new CustomEvent('cart:refresh'));\n            } catch (e) {\n              console.error(e);\n              showStatus(statusEl, e.message || 'There was a problem adding the item.', 'error');\n            } finally {\n              btn.disabled = false;\n              btn.style.opacity = '1';\n              btn.innerHTML = original;\n            }\n          }\n\n          if (btnProtector) {\n            btnProtector.addEventListener('click', function() {\n              addVariant(VARIANT_ID_PROTECTOR, btnProtector, stProtector, 'Added! VTrack Protector is now in your cart.');\n            });\n          }\n\n          if (btnBundle) {\n            btnBundle.addEventListener('click', function() {\n              addVariant(VARIANT_ID_BUNDLE, btnBundle, stBundle, 'Added! Ultimate Accessory Bundle is now in your cart.');\n            });\n          }\n        })();\n        </script>\n      {%- endif -%}\n\n    </div>\n  </div>\n</div>\n{%- endif -%}"
