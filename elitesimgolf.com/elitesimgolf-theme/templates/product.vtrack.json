        "custom_liquid_gqXLPL": {
          "type": "custom-liquid",
          "name": "Split Inventory",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- assign south_on_hand = 0 -%}\n{%- assign saw_any_qty_field = false -%}\n\n{%- for v in product.variants -%}\n  {%- if v.inventory_quantity != blank -%}\n    {%- assign saw_any_qty_field = true -%}\n    {%- assign south_on_hand = south_on_hand | plus: v.inventory_quantity -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- assign north_on_hand = product.metafields.custom.inv_north_warehouse | default: 0 | plus: 0 -%}\n{%- assign total_on_hand = south_on_hand | plus: north_on_hand -%}\n\n{%- assign incoming_qty = product.metafields.custom.incoming_po_qty | default: 0 | plus: 0 -%}\n\n{%- assign show_incoming = false -%}\n{%- if saw_any_qty_field and total_on_hand <= 0 and incoming_qty > 0 -%}\n  {%- assign show_incoming = true -%}\n{%- endif -%}\n\n{%- if saw_any_qty_field -%}\n\n<!-- VTRACK Inventory + Shipping (BOLD compact style, same color scheme) -->\n<div style=\"\n  margin:12px 0 0;\n  padding:12px 14px;\n  border-radius:14px;\n  border:2px solid rgba(8,110,211,.45);\n  background:linear-gradient(180deg, #ffffff 0%, #f4f9ff 100%);\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  color:#0f172a;\n  display:flex;\n  align-items:flex-start;\n  gap:12px;\n  box-shadow:0 12px 26px rgba(8,110,211,.10);\n\">\n  <div style=\"\n    width:34px; height:34px; border-radius:12px;\n    background:#e7f2ff;\n    border:1px solid rgba(8,110,211,.28);\n    display:flex; align-items:center; justify-content:center;\n    font-size:18px; flex:0 0 auto;\n    box-shadow:0 10px 20px rgba(8,110,211,.12);\n  \">📦</div>\n\n  <div style=\"line-height:1.35; flex:1;\">\n\n    <!-- Title + Badge -->\n    <div style=\"\n      display:flex;\n      align-items:flex-start;\n      justify-content:space-between;\n      gap:10px;\n      flex-wrap:wrap;\n      margin:0 0 8px;\n    \">\n      <div style=\"font-weight:1000; font-size:13px; letter-spacing:.02em;\">\n        Inventory & Shipping\n      </div>\n\n      <!-- Always show shipping badge -->\n      <div style=\"\n        display:inline-flex;\n        align-items:center;\n        gap:8px;\n        padding:6px 10px;\n        border-radius:999px;\n        background:#086ed3;\n        color:#ffffff;\n        font-weight:950;\n        font-size:12px;\n        letter-spacing:.02em;\n        box-shadow:0 10px 22px rgba(8,110,211,.24);\n        white-space:nowrap;\n      \">🚀 FREE UPS 2ND DAY AIR (VTRACK UNIT ONLY)</div>\n    </div>\n\n    <!-- Shipping copy (always visible) -->\n    <div style=\"\n      font-size:12.5px;\n      color:#334155;\n      background:#ffffff;\n      border:1px solid rgba(8,110,211,.20);\n      border-radius:12px;\n      padding:10px 12px;\n      box-shadow:0 10px 22px rgba(0,0,0,.06);\n    \">\n      <div style=\"font-weight:1000; color:#0b2a55; margin:0 0 4px;\">\n         The <span style=\"color:#086ed3; font-weight:1000;\">VTRACK unit</span> ships FREE via <span style=\"color:#086ed3; font-weight:1000;\">UPS 2nd Day Air</span>.\n      </div>\n      <div style=\"margin:0;\">\n        <span style=\"font-weight:950; color:#0f172a;\">Accessories or other items on the same order ship UPS Ground.</span>\n        Most orders ship the same business day when placed prior to noon (volume/holiday/weekend exclusions apply).\n      </div>\n    </div>\n\n    {%- if total_on_hand > 0 -%}\n      <!-- Inventory chips (only show when on-hand > 0) -->\n      <div style=\"margin-top:10px; display:flex; flex-wrap:wrap; gap:8px; align-items:center;\">\n        <span style=\"\n          display:inline-flex; align-items:center; gap:8px;\n          padding:6px 10px; border-radius:999px;\n          background:#ffffff;\n          border:1px solid rgba(15,23,42,.12);\n          font-size:12px; font-weight:1000; color:#0f172a;\n          box-shadow:0 10px 18px rgba(0,0,0,.05);\n          white-space:nowrap;\n        \">\n          TOTAL ON-HAND: <span style=\"color:#086ed3;\">{{ total_on_hand }}</span>\n        </span>\n\n        <span style=\"\n          display:inline-flex; align-items:center; gap:8px;\n          padding:6px 10px; border-radius:999px;\n          background:#e7f2ff;\n          border:1px solid rgba(8,110,211,.26);\n          font-size:12px; font-weight:1000; color:#0b2a55;\n          box-shadow:0 10px 18px rgba(8,110,211,.12);\n          white-space:nowrap;\n        \">✅ IN STOCK</span>\n      </div>\n\n      <!-- Location chips -->\n      <div style=\"margin-top:8px; display:flex; flex-wrap:wrap; gap:8px;\">\n        <span style=\"\n          display:inline-flex; align-items:center; gap:8px;\n          padding:6px 10px; border-radius:999px;\n          background:#ffffff;\n          border:1px solid rgba(15,23,42,.12);\n          font-size:12px; font-weight:1000; color:#0f172a;\n          box-shadow:0 10px 18px rgba(0,0,0,.05);\n          white-space:nowrap;\n        \">\n          Elite Sim Golf Warehouse: <span style=\"color:#086ed3;\">{{ south_on_hand }}</span>\n        </span>\n\n        {%- if north_on_hand > 0 -%}\n          <span style=\"\n            display:inline-flex; align-items:center; gap:8px;\n            padding:6px 10px; border-radius:999px;\n            background:#ffffff;\n            border:1px solid rgba(15,23,42,.12);\n            font-size:12px; font-weight:1000; color:#0f172a;\n            box-shadow:0 10px 18px rgba(0,0,0,.05);\n            white-space:nowrap;\n          \">\n            North Warehouse: <span style=\"color:#086ed3;\">{{ north_on_hand }}</span>\n          </span>\n        {%- endif -%}\n      </div>\n\n      <div style=\"margin-top:8px; font-size:12px; color:#475569;\">\n        If this box shows <strong style=\"color:#0f172a;\">On-Hand</strong>, the item is <strong style=\"color:#0b2a55;\">available now</strong>.\n      </div>\n    {%- endif -%}\n\n    {%- if show_incoming -%}\n      <!-- Incoming (shows when on-hand <= 0 and incoming > 0) -->\n      <div style=\"margin-top:12px; padding-top:12px; border-top:1px solid rgba(8,110,211,.18);\">\n        <div style=\"\n          display:flex;\n          align-items:flex-start;\n          justify-content:space-between;\n          gap:10px;\n          flex-wrap:wrap;\n          margin:0 0 6px;\n        \">\n          <div style=\"font-weight:1000; font-size:13px; color:#0f172a;\">\n            Incoming Inventory\n          </div>\n          <div style=\"\n            display:inline-flex;\n            align-items:center;\n            gap:8px;\n            padding:6px 10px;\n            border-radius:999px;\n            background:#0b2a55;\n            color:#ffffff;\n            font-weight:950;\n            font-size:12px;\n            box-shadow:0 10px 22px rgba(11,42,85,.22);\n            white-space:nowrap;\n          \">🚚 INCOMING</div>\n        </div>\n\n        <div style=\"\n          font-size:12.5px;\n          color:#334155;\n          background:#ffffff;\n          border:1px dashed rgba(8,110,211,.35);\n          border-radius:12px;\n          padding:10px 12px;\n        \">\n          <div style=\"font-weight:950; color:#0f172a;\">\n            Typical lead time: <span style=\"color:#086ed3;\">2–3 weeks</span>\n          </div>\n\n          <div style=\"margin-top:8px; display:flex; flex-wrap:wrap; gap:8px; align-items:center;\">\n            <span style=\"\n              display:inline-flex; align-items:center; gap:8px;\n              padding:6px 10px; border-radius:999px;\n              background:#f1f5f9;\n              border:1px solid rgba(15,23,42,.12);\n              font-size:12px; font-weight:1000; color:#0f172a;\n              white-space:nowrap;\n            \">\n              🚚 Incoming: <span style=\"color:#086ed3;\">{{ incoming_qty }}</span>\n            </span>\n\n            <span style=\"\n              display:inline-flex; align-items:center; gap:8px;\n              padding:6px 10px; border-radius:999px;\n              background:#e7f2ff;\n              border:1px solid rgba(8,110,211,.26);\n              font-size:12px; font-weight:1000; color:#0b2a55;\n              white-space:nowrap;\n            \">⏳ PRE-ORDER / BACKORDER</span>\n          </div>\n        </div>\n      </div>\n    {%- endif -%}\n\n  </div>\n</div>\n\n{%- endif -%}"
          }
        },
        "custom_liquid_zhDmVA": {
          "type": "custom-liquid",
          "name": "Split Inventory V2",
          "disabled": true,
          "settings": {
