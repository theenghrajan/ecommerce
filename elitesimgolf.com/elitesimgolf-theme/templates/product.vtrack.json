g:6px 10px; border-radius:999px;\n            background:#e7f2ff; border:1px solid rgba(8,110,211,.22);\n            font-size:12px; font-weight:950; color:#0b2a55; white-space:nowrap;\n          \">\n            📍 AVAILABLE FOR LOCAL PICKUP — LENOIR CITY, TN\n          </span>\n        </div>\n\n        <div style=\"\n          font-size:12.5px;\n          color:#334155;\n          background:#ffffff;\n          border:1px solid rgba(15,23,42,.10);\n          border-radius:12px;\n          padding:10px 12px;\n        \">\n          <div style=\"margin:0;\">\n            Inventory shown above is available to ship and <span style=\"font-weight:950;\">ships the same business day on orders placed by noon</span>\n            via <span style=\"color:#086ed3; font-weight:1000;\">FREE UPS 2 Day Air</span> (most days) unless we are experiencing heavier than normal order volumes.\n            <span style=\"font-weight:900; color:#0f172a;\">2nd Day Air applies to the VTRACK unit only; accessories/other items ship UPS Ground.</span>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n  {%- else -%}\n    <!-- ========================================= -->\n    <!-- OUT-OF-STOCK / INCOMING BOX (BOLD compact) -->\n    <!-- ========================================= -->\n\n    <div style=\"\n      margin:12px 0 0;\n      padding:12px 14px;\n      border-radius:14px;\n      border:1px solid rgba(8,110,211,.45);\n      background:linear-gradient(180deg, #ffffff 0%, #ffffff 100%);\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n      color:#0f172a;\n      display:flex;\n      align-items:flex-start;\n      gap:12px;\n      box-shadow:0 12px 26px rgba(8,110,211,.10);\n    \">\n      <div style=\"\n        width:34px; height:34px; border-radius:12px;\n        background:#e7f2ff;\n        border:1px solid rgba(8,110,211,.28);\n        display:flex; align-items:center; justify-content:center;\n        font-size:18px; flex:0 0 auto;\n        box-shadow:0 10px 20px rgba(8,110,211,.12);\n      \">📦</div>\n\n      <div style=\"line-height:1.35; flex:1;\">\n\n        <!-- Title + Badge -->\n        <div style=\"\n          display:flex;\n          align-items:flex-start;\n          justify-content:space-between;\n          gap:10px;\n          flex-wrap:wrap;\n          margin:0 0 8px;\n        \">\n          <div style=\"font-weight:1000; font-size:13px; letter-spacing:.02em;\">\n            Inventory & Shipping\n          </div>\n\n          <div style=\"\n            display:inline-flex;\n            align-items:center;\n            gap:8px;\n            padding:6px 10px;\n            border-radius:999px;\n            background:#086ed3;\n            color:#ffffff;\n            font-weight:950;\n            font-size:12px;\n            letter-spacing:.02em;\n            box-shadow:0 10px 22px rgba(8,110,211,.24);\n            white-space:nowrap;\n          \">🚀 FREE UPS 2ND DAY AIR (VTRACK UNIT ONLY)</div>\n        </div>\n\n        <!-- Shipping copy (always visible) -->\n        <div style=\"\n          font-size:12.5px;\n          color:#334155;\n          background:#ffffff;\n          border:1px solid rgba(8,110,211,.20);\n          border-radius:12px;\n          padding:10px 12px;\n          box-shadow:0 10px 22px rgba(0,0,0,.06);\n        \">\n          <div style=\"font-weight:1000; color:#0b2a55; margin:0 0 4px;\">\n            The <span style=\"color:#086ed3; font-weight:1000;\">VTRACK unit</span> ships FREE via <span style=\"color:#086ed3; font-weight:1000;\">UPS 2nd Day Air</span>.\n          </div>\n          <div style=\"margin:0;\">\n            <span style=\"font-weight:950; color:#0f172a;\">Accessories or other items on the same order ship UPS Ground.</span>\n            Most orders ship the same business day when placed prior to noon (volume/holiday/weekend exclusions apply).\n          </div>\n        </div>\n\n        {%- if show_incoming -%}\n          <!-- Incoming -->\n          <div style=\"margin-top:12px; padding-top:12px; border-top:1px solid rgba(8,110,211,.18);\">\n            <div style=\"\n              display:flex;\n              align-items:flex-start;\n              justify-content:space-between;\n              gap:10px;\n              flex-wrap:wrap;\n              margin:0 0 6px;\n            \">\n              <div style=\"font-weight:1000; font-size:13px; color:#0f172a;\">\n                Incoming Inventory\n              </div>\n              <div style=\"\n                display:inline-flex;\n                align-items:center;\n                gap:8px;\n                padding:6px 10px;\n                border-radius:999px;\n                background:#0b2a55;\n                color:#ffffff;\n                font-weight:950;\n                font-size:12px;\n                box-shadow:0 10px 22px rgba(11,42,85,.22);\n                white-space:nowrap;\n              \">🚚 INCOMING</div>\n            </div>\n\n            <div style=\"\n              font-size:12.5px;\n              color:#334155;\n              background:#ffffff;\n              border:1px dashed rgba(8,110,211,.35);\n              border-radius:12px;\n              padding:10px 12px;\n            \">\n              <div style=\"font-weight:950; color:#0f172a;\">\n                Typical lead time: <span style=\"color:#086ed3;\">2–3 weeks</span>\n              </div>\n\n              <div style=\"margin-top:8px; display:flex; flex-wrap:wrap; gap:8px; align-items:center;\">\n                <span style=\"\n                  display:inline-flex; align-items:center; gap:8px;\n                  padding:6px 10px; border-radius:999px;\n                  background:#f1f5f9;\n                  border:1px solid rgba(15,23,42,.12);\n                  font-size:12px; font-weight:1000; color:#0f172a;\n                  white-space:nowrap;\n                \">\n                  🚚 Incoming: <span style=\"color:#086ed3;\">{{ incoming_qty }}</span>\n                </span>\n\n                <span style=\"\n                  display:inline-flex; align-items:center; gap:8px;\n                  padding:6px 10px; border-radius:999px;\n                  background:#e7f2ff;\n                  border:1px solid rgba(8,110,211,.26);\n                  font-size:12px; font-weight:1000; color:#0b2a55;\n                  white-space:nowrap;\n                \">⏳ PRE-ORDER / BACKORDER</span>\n              </div>\n\n              <div style=\"margin-top:10px;\">\n                <span style=\"\n                  display:inline-flex; align-items:center; gap:8px;\n                  padding:6px 10px; border-radius:999px;\n                  background:#ffffff; border:1px solid rgba(15,23,42,.10);\n                  font-size:12px; font-weight:900; color:#0f172a; white-space:nowrap;\n                \">\n                  📍 AVAILABLE FOR LOCAL PICKUP — LENOIR CITY, TN (when in stock)\n                </span>\n              </div>\n            </div>\n          </div>\n        {%- endif -%}\n\n      </div>\n    </div>\n\n  {%- endif -%}\n\n{%- endif -%}"
          }
        },
        "custom_liquid_RggTpD": {
          "type": "custom-liquid",
          "name": "SHIPPING NOTE",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nESG Compact Inventory + Advantage Box (No quantities shown)\nIncludes:\n- Stock vs direct-ship status\n- Always-on FREE UPS NEXT DAY AIR box above cutoff timer\n- Same-day shipping digital countdown (4:00 PM ET) when stocked (not direct ship)\nHidden for: open-box / refurbished\n{%- endcomment -%}\n\n{%- assign total_on_hand = 0 -%}\n{%- assign saw_any_qty_field = false -%}\n\n{%- for v in product.variants -%}\n  {%- if v.inventory_quantity != blank -%}\n    {%- assign saw_any_qty_field = true -%}\n    {%- assign total_on_hand = total_on_hand | plus: v.inventory_quantity -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- assign incoming_qty = product.metafields.custom.incoming_po_qty | default: 0 | plus: 0 -%}\n{%- assign vendor_name = product.vendor | default: 'Vendor' -%}\n\n{%- assign total_available = total_on_hand | plus: incoming_qty -%}\n\n{%- assign has_inventory = false -%}\n{%- if saw_any_qty_field and total_available > 0 -%}\n  {%- assign has_inventory = true -%}\n{%- endif -%}\n\n{%- assign direct_ship = false -%}\n{%- if saw_any_qty_field and total_available <= 0 -%}\n  {%- assign direct_ship = true -%}\n{%- endif -%}\n\n{%- assign is_refurbished = false -%}\n{%- assign is_open_box = false -%}\n{%- if product.tags contains 'refurbished' -%}{%- assign is_refurbished = true -%}{%- endif -%}\n{%- if product.tags contains 'open-box' -%}{%- assign is_open_box = true -%}{%- endif -%}\n{%- assign hide_inventory_box = false -%}\n{%- if is_refurbished or is_open_box -%}{%- assign hide_inventory_box = true -%}{%- endif -%}\n\n{%- assign show_box = false -%}\n{%- if saw_any_qty_field and hide_inventory_box == false -%}\n  {%- assign show_box = true -%}\n{%- endif -%}\n\n{%- if show_box -%}\n<div style=\"\n  margin:14px 0 0;\n  padding:12px 14px;\n  border-radius:16px;\n  border:1px solid rgba(8,110,211,.35);\n  background:#ffffff;\n  font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  color:#0f172a;\n  display:flex;\n  align-items:flex-start;\n  gap:12px;\n  box-shadow:0 10px 22px rgba(8,110,211,.08);\n  position:relative;\n  overflow:hidden;\n\">\n  <div style=\"\n    position:absolute;\n    inset:0 auto 0 0;\n    width:5px;\n    background:linear-gradient(180deg,#086ed3 0%,#38bdf8 100%);\n  \"></div>\n\n  <div style=\"\n    width:32px; height:32px; border-radius:12px;\n    background:#e7f2ff;\n    display:flex; align-items:center; justify-content:center;\n    font-size:16px; flex:0 0 auto;\n    border:1px solid rgba(8,110,211,.18);\n    margin-left:2px;\n  \">✅</div>\n\n  <div style=\"line-height:1.25; flex:1; min-width:0;\">\n    <div style=\"\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap:10px;\n      margin:0 0 8px;\n      flex-wrap:wrap;\n    \">\n      <div style=\"font-weight:950; font-size:13px; letter-spacing:.02em;\">\n        Elite Sim Golf Advantage\n      </div>\n\n      {%- if direct_ship -%}\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          padding:6px 10px;\n          border-radius:999px;\n          background:#0b2a55;\n          color:#ffffff;\n          font-weight:950;\n          font-size:11px;\n          letter-spacing:.06em;\n          white-space:nowrap;\n        \">DIRECT SHIP</div>\n      {%- else -%}\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          padding:6px 10px;\n          border-radius:999px;\n          background:#086ed3;\n          color:#ffffff;\n          font-weight:950;\n          font-size:11px;\n          letter-spacing:.06em;\n          white-space:nowrap;\n          box-shadow:0 8px 18px rgba(8,110,211,.20);\n        \">✅ IN STOCK • READY TO SHIP • REAL INVENTORY</div>\n      {%- endif -%}\n    </div>\n\n    {%- if has_inventory -%}\n      <div style=\"font-size:13px; color:#334155; margin:0 0 10px;\">\n        <Strong> Real Inventory. Real Expectations. Satisfaction Guarantee.</strong> We <strong>stock this item</strong> so you can expect <strong>fast fulfillment</strong> and <strong>real post-purchase support</strong> if you need help. Many of our competitors will promise you the moon and underdeliver.\n      </div>\n    {%- endif -%}\n\n    {%- if direct_ship -%}\n      <div style=\"font-size:13px; color:#334155; margin:0 0 10px;\">\n        This item is fulfilled via <strong>direct ship</strong> from <strong>{{ vendor_name | escape }}</strong>. We’re still here to help with questions and support after delivery.\n      </div>\n    {%- endif -%}\n\n    {%- if has_inventory and direct_ship == false -%}\n\n      <div style=\"\n        margin:0 0 10px;\n        padding:10px 12px;\n        border-radius:14px;\n        border:2px solid rgba(255,80,80,.28);\n        background:linear-gradient(180deg,#ffffff 0%,#fff5f5 100%);\n        display:flex;\n        align-items:center;\n        justify-content:space-between;\n        gap:10px;\n        flex-wrap:wrap;\n        box-shadow:0 10px 20px rgba(255,80,80,.10);\n      \">\n        <div style=\"display:flex; flex-direction:column; gap:6px;\">\n          <div style=\"\n            font-size:11px;\n            font-weight:950;\n            letter-spacing:.10em;\n            text-transform:uppercase;\n            color:#dc2626;\n          \">\n            Free Expedited Shipping\n          </div>\n\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          justify-content:center;\n          min-width:142px;\n          padding:8px 12px;\n          border-radius:12px;\n          background:#0b2a55;\n          color:#ffffff;\n          border:1px solid rgba(11,42,85,.35);\n          box-shadow:0 14px 24px rgba(11,42,85,.18);\n          font-weight:1000;\n          font-size:13px;\n          letter-spacing:.08em;\n          text-transform:uppercase;\n          white-space:nowrap;\n        \">\n          🚀 UPS NEXT DAY AIR SHIPPING INCLUDED\n        </div>\n          <div style=\"font-size:10px; color:#334155; font-weight:800;\">\n            This item qualifies for <strong>FREE UPS Next Day Air Saver</strong> where available. Certain Zip codes ineligible and will default to UPS 2nd Day Air in those rare cases.  \n          </div>\n        </div>\n\n      </div>\n\n      <div id=\"esg-2pm-countdown-wrap\" style=\"\n        margin:0 0 10px;\n        padding:10px 12px;\n        border-radius:14px;\n        border:2px solid rgba(8,110,211,.22);\n        background:linear-gradient(180deg,#ffffff 0%,#f4f9ff 100%);\n        display:flex;\n        align-items:center;\n        justify-content:space-between;\n        gap:10px;\n        flex-wrap:wrap;\n      \">\n        <div style=\"display:flex; flex-direction:column; gap:6px;\">\n          <div style=\"font-size:11px; font-weight:950; letter-spacing:.10em; text-transform:uppercase; color:#086ed3;\">\n            Same-Day Shipping Cutoff\n          </div>\n          <div style=\"font-size:12.5px; color:#334155; font-weight:800;\">\n            Order by <strong>4:00 PM ET</strong>\n          </div>\n        </div>\n\n        <div id=\"esg-2pm-time\" style=\"\n          display:inline-flex;\n          align-items:center;\n          justify-content:center;\n          min-width:142px;\n          padding:8px 12px;\n          border-radius:12px;\n          background:#0b2a55;\n          color:#ffffff;\n          border:1px solid rgba(11,42,85,.35);\n          box-shadow:0 14px 24px rgba(11,42,85,.18);\n          font-weight:1000;\n          font-size:18px;\n          letter-spacing:.18em;\n          font-variant-numeric:tabular-nums;\n          font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,'Liberation Mono','Courier New',monospace;\n        \">--:--:--</div>\n      </div>\n\n      <script>\n      (function () {\n        var wrap = document.getElementById('esg-2pm-countdown-wrap');\n        var timeEl = document.getElementById('esg-2pm-time');\n        if (!wrap || !timeEl) return;\n\n        function getETParts(date) {\n          var parts = new Intl.DateTimeFormat('en-US', {\n            timeZone: 'America/New_York',\n            year: 'numeric',\n            month: '2-digit',\n            day: '2-digit',\n            hour: '2-digit',\n            minute: '2-digit',\n            second: '2-digit',\n            hour12: false\n          }).formatToParts(date);\n\n          var out = {};\n          parts.forEach(function(p){ out[p.type] = p.value; });\n          return out;\n        }\n\n        function pad(n){ return String(n).padStart(2,'0'); }\n\n        function update() {\n          var now = new Date();\n          var p = getETParts(now);\n\n          var hh = parseInt(p.hour, 10);\n          var mm = parseInt(p.minute, 10);\n          var ss = parseInt(p.second, 10);\n\n          var nowSec = hh*3600 + mm*60 + ss;\n          var cutoffSec = 16*3600;\n          var remaining = cutoffSec - nowSec;\n\n          if (remaining <= 0) {\n            wrap.style.display = 'none';\n            return;\n          }\n\n          var rH = Math.floor(remaining / 3600);\n          var rM = Math.floor((remaining % 3600) / 60);\n          var rS = remaining % 60;\n\n          timeEl.textContent = pad(rH) + \":\" + pad(rM) + \":\" + pad(rS);\n        }\n\n        update();\n        setInterval(update, 1000);\n      })();\n      </script>\n    {%- endif -%}\n\n  </div>\n</div>\n{%- endif -%}"
          }
        },
        "custom_liquid_Fj6yVg": {
          "type": "custom-liquid",
          "name": "Shipping Note V2",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nESG Compact VTrack Inventory + Advantage Box\nIncludes:\n- Stock vs direct-ship status\n- FREE UPS NEXT DAY AIR callout when stocked\n- Same-day shipping countdown to 4:00 PM ET when stocked\nHidden for: open-box / refurbished\n{%- endcomment -%}\n\n{%- assign total_on_hand = 0 -%}\n{%- assign saw_any_qty_field = false -%}\n\n{%- for v in product.variants -%}\n  {%- if v.inventory_quantity != blank -%}\n    {%- assign saw_any_qty_field = true -%}\n    {%- assign total_on_hand = total_on_hand | plus: v.inventory_quantity -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- assign incoming_qty = product.metafields.custom.incoming_po_qty | default: 0 | plus: 0 -%}\n{%- assign vendor_name = product.vendor | default: 'Vendor' -%}\n{%- assign total_available = total_on_hand | plus: incoming_qty -%}\n\n{%- assign has_inventory = false -%}\n{%- if saw_any_qty_field and total_available > 0 -%}\n  {%- assign has_inventory = true -%}\n{%- endif -%}\n\n{%- assign direct_ship = false -%}\n{%- if saw_any_qty_field and total_available <= 0 -%}\n  {%- assign direct_ship = true -%}\n{%- endif -%}\n\n{%- assign is_refurbished = false -%}\n{%- assign is_open_box = false -%}\n{%- if product.tags contains 'refurbished' -%}{%- assign is_refurbished = true -%}{%- endif -%}\n{%- if product.tags contains 'open-box' -%}{%- assign is_open_box = true -%}{%- endif -%}\n\n{%- assign hide_inventory_box = false -%}\n{%- if is_refurbished or is_open_box -%}\n  {%- assign hide_inventory_box = true -%}\n{%- endif -%}\n\n{%- assign show_box = false -%}\n{%- if saw_any_qty_field and hide_inventory_box == false -%}\n  {%- assign show_box = true -%}\n{%- endif -%}\n\n{%- if show_box -%}\n<div class=\"esg-vtrack-adv-box\">\n  <div class=\"esg-vtrack-adv-box__top\">\n    <div class=\"esg-vtrack-adv-box__title\">\n      <span class=\"esg-vtrack-adv-box__title-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M20 6 9 17l-5-5\"></path>\n        </svg>\n      </span>\n      <span>Elite Sim Golf Advantage</span>\n    </div>\n\n    {%- if direct_ship -%}\n      <div class=\"esg-vtrack-adv-box__badge esg-vtrack-adv-box__badge--dark\">Direct Ship</div>\n    {%- else -%}\n      <div class=\"esg-vtrack-adv-box__badge\">In Stock • Ready to Ship</div>\n    {%- endif -%}\n  </div>\n\n  {%- if has_inventory -%}\n    <div class=\"esg-vtrack-adv-box__text\">\n      <strong>Real inventory. Real expectations. Real support.</strong> We stock this item for faster fulfillment and better post-purchase support when you need it.\n    </div>\n\n    <div class=\"esg-vtrack-adv-box__panel esg-vtrack-adv-box__panel--shipping\">\n      <div class=\"esg-vtrack-adv-box__panel-top\">\n        <div class=\"esg-vtrack-adv-box__panel-title\">\n          <span class=\"esg-vtrack-adv-box__panel-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"1\" y=\"7\" width=\"11\" height=\"8\" rx=\"1.5\"></rect>\n              <path d=\"M12 9h4l3 3v3h-7z\"></path>\n              <circle cx=\"6\" cy=\"18\" r=\"2\"></circle>\n              <circle cx=\"17\" cy=\"18\" r=\"2\"></circle>\n            </svg>\n          </span>\n          <span>Free Expedited Shipping Included</span>\n        </div>\n\n        <div class=\"esg-vtrack-adv-box__mini-badge\">\n          UPS Next Day Air Saver\n        </div>\n      </div>\n\n      <div class=\"esg-vtrack-adv-box__panel-text\">\n        This item qualifies for <strong>FREE UPS Next Day Air Saver</strong> where available. Some ZIP codes may default to <strong>UPS 2nd Day Air</strong>.\n      </div>\n    </div>\n\n    <div id=\"esg-vtrack-countdown-wrap\" class=\"esg-vtrack-adv-box__panel esg-vtrack-adv-box__panel--cutoff\">\n      <div class=\"esg-vtrack-adv-box__panel-top\">\n        <div class=\"esg-vtrack-adv-box__panel-title\">\n          <span class=\"esg-vtrack-adv-box__panel-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n              <path d=\"M12 7v5l3 2\"></path>\n            </svg>\n          </span>\n          <span>Same-Day Shipping Cutoff</span>\n        </div>\n\n        <div class=\"esg-vtrack-adv-box__timer-note\">\n          Order by 4:00 PM ET\n        </div>\n      </div>\n\n      <div class=\"esg-vtrack-adv-box__timer-row\">\n        <div class=\"esg-vtrack-adv-box__panel-text esg-vtrack-adv-box__panel-text--no-margin\">\n          Order today for same-day processing while stocked.\n        </div>\n\n        <div id=\"esg-vtrack-time\" class=\"esg-vtrack-adv-box__timer\">--:--:--</div>\n      </div>\n    </div>\n\n    <script>\n      (function () {\n        var wrap = document.getElementById('esg-vtrack-countdown-wrap');\n        var timeEl = document.getElementById('esg-vtrack-time');\n        if (!wrap || !timeEl) return;\n\n        function getETParts(date) {\n          var parts = new Intl.DateTimeFormat('en-US', {\n            timeZone: 'America/New_York',\n            year: 'numeric',\n            month: '2-digit',\n            day: '2-digit',\n            hour: '2-digit',\n            minute: '2-digit',\n            second: '2-digit',\n            hour12: false\n          }).formatToParts(date);\n\n          var out = {};\n          parts.forEach(function(p) { out[p.type] = p.value; });\n          return out;\n        }\n\n        function pad(n) {\n          return String(n).padStart(2, '0');\n        }\n\n        function update() {\n          var now = new Date();\n          var p = getETParts(now);\n\n          var hh = parseInt(p.hour, 10);\n          var mm = parseInt(p.minute, 10);\n          var ss = parseInt(p.second, 10);\n\n          var nowSec = hh * 3600 + mm * 60 + ss;\n          var cutoffSec = 16 * 3600;\n          var remaining = cutoffSec - nowSec;\n\n          if (remaining <= 0) {\n            wrap.style.display = 'none';\n            return;\n          }\n\n          var rH = Math.floor(remaining / 3600);\n          var rM = Math.floor((remaining % 3600) / 60);\n          var rS = remaining % 60;\n\n          timeEl.textContent = pad(rH) + \":\" + pad(rM) + \":\" + pad(rS);\n        }\n\n        update();\n        setInterval(update, 1000);\n      })();\n    </script>\n  {%- endif -%}\n\n  {%- if direct_ship -%}\n    <div class=\"esg-vtrack-adv-box__text\">\n      This item is fulfilled via <strong>direct ship</strong> from <strong>{{ vendor_name | escape }}</strong>. We’re still here to help with setup questions and post-purchase support.\n    </div>\n  {%- endif -%}\n</div>\n\n<style>\n  .esg-vtrack-adv-box {\n    max-width: 1100px;\n    margin: 14px 0 0;\n    padding: 13px 14px;\n    border: 1px solid #23923d;\n    border-radius: 12px;\n    background: linear-gradient(180deg, #f7fcf7 0%, #eef8ef 100%);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.75),\n      0 1px 2px rgba(16,42,67,.05);\n    color: #102a43;\n    line-height: 1.35;\n  }\n\n  .esg-vtrack-adv-box__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 8px;\n    flex-wrap: wrap;\n  }\n\n  .esg-vtrack-adv-box__title {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 14px;\n    font-weight: 800;\n    color: #168232;\n    line-height: 1.2;\n    letter-spacing: .1px;\n  }\n\n  .esg-vtrack-adv-box__title-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 16px;\n    height: 16px;\n    min-width: 16px;\n    color: #168232;\n    flex: 0 0 16px;\n  }\n\n  .esg-vtrack-adv-box__title-icon svg {\n    width: 16px;\n    height: 16px;\n    display: block;\n  }\n\n  .esg-vtrack-adv-box__badge {\n    display: inline-block;\n    padding: 5px 8px;\n    border-radius: 999px;\n    background: #ffffff;\n    border: 1px solid rgba(35,146,61,.28);\n    color: #168232;\n    font-size: 12px;\n    font-weight: 800;\n    line-height: 1;\n    white-space: nowrap;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.8);\n  }\n\n  .esg-vtrack-adv-box__badge--dark {\n    background: #0f2740;\n    border-color: #0f2740;\n    color: #ffffff;\n    box-shadow: none;\n  }\n\n  .esg-vtrack-adv-box__text {\n    font-size: 13px;\n    color: #102a43;\n    margin-bottom: 9px;\n  }\n\n  .esg-vtrack-adv-box__text strong {\n    font-weight: 800;\n  }\n\n  .esg-vtrack-adv-box__panel {\n    margin-top: 10px;\n    padding: 11px 12px;\n    border-radius: 12px;\n    background: #ffffff;\n    border: 1px solid rgba(35,146,61,.22);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.85);\n  }\n\n  .esg-vtrack-adv-box__panel--shipping {\n    background: linear-gradient(180deg, #ffffff 0%, #f8fcf8 100%);\n  }\n\n  .esg-vtrack-adv-box__panel--cutoff {\n    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);\n    border-color: rgba(8,110,211,.18);\n  }\n\n  .esg-vtrack-adv-box__panel-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 7px;\n    flex-wrap: wrap;\n  }\n\n  .esg-vtrack-adv-box__panel-title {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 13px;\n    font-weight: 800;\n    color: #102a43;\n    line-height: 1.2;\n  }\n\n  .esg-vtrack-adv-box__panel-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 15px;\n    height: 15px;\n    min-width: 15px;\n    color: #168232;\n    flex: 0 0 15px;\n  }\n\n  .esg-vtrack-adv-box__panel--cutoff .esg-vtrack-adv-box__panel-icon {\n    color: #086ed3;\n  }\n\n  .esg-vtrack-adv-box__panel-icon svg {\n    width: 15px;\n    height: 15px;\n    display: block;\n  }\n\n  .esg-vtrack-adv-box__mini-badge,\n  .esg-vtrack-adv-box__timer-note {\n    display: inline-block;\n    padding: 5px 8px;\n    border-radius: 999px;\n    background: #f8fbff;\n    border: 1px solid rgba(8,110,211,.20);\n    color: #086ed3;\n    font-size: 11.5px;\n    font-weight: 800;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .esg-vtrack-adv-box__panel-text {\n    font-size: 12.5px;\n    color: #35506b;\n    margin: 0;\n  }\n\n  .esg-vtrack-adv-box__panel-text strong {\n    font-weight: 800;\n    color: #102a43;\n  }\n\n  .esg-vtrack-adv-box__panel-text--no-margin {\n    margin: 0;\n  }\n\n  .esg-vtrack-adv-box__timer-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    flex-wrap: wrap;\n  }\n\n  .esg-vtrack-adv-box__timer {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 120px;\n    padding: 7px 10px;\n    border-radius: 999px;\n    background: #0b2a55;\n    border: 1px solid rgba(11,42,85,.35);\n    color: #ffffff;\n    font-weight: 900;\n    font-size: 14px;\n    letter-spacing: .14em;\n    line-height: 1;\n    white-space: nowrap;\n    font-variant-numeric: tabular-nums;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n    box-shadow: 0 1px 2px rgba(16,42,67,.10);\n  }\n\n  @media (max-width: 749px) {\n    .esg-vtrack-adv-box {\n      padding: 12px;\n      border-radius: 10px;\n    }\n\n    .esg-vtrack-adv-box__title {\n      font-size: 13.5px;\n    }\n\n    .esg-vtrack-adv-box__badge,\n    .esg-vtrack-adv-box__text,\n    .esg-vtrack-adv-box__panel-title,\n    .esg-vtrack-adv-box__mini-badge,\n    .esg-vtrack-adv-box__timer-note,\n    .esg-vtrack-adv-box__panel-text {\n      font-size: 12px;\n    }\n\n    .esg-vtrack-adv-box__timer {\n      font-size: 13px;\n      min-width: 110px;\n      letter-spacing: .12em;\n    }\n  }\n</style>\n{%- endif -%}"
          }
        },
        "custom_liquid_AUHyi9": {
          "type": "custom-liquid",
          "name": "Shipping Note V3",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  ESG SHIPPING STATUS BOXES — condensed\n  - In-Stock: shows when total_inventory > 0\n      * Mon–Fri before 2:00 PM ET → live HH:MM:SS countdown\n      * Weekends / after Fri 2PM ET → \"Ships <next business day>\"\n  - Estimated Ship: shows when total_inventory <= 0\n      * 1–3 business day window (skips Sat/Sun)\n{%- endcomment -%}\n\n{%- assign total_inventory = 0 -%}\n{%- for variant in product.variants -%}\n  {%- assign total_inventory = total_inventory | plus: variant.inventory_quantity -%}\n{%- endfor -%}\n\n{%- if total_inventory > 0 -%}\n<div class=\"esg-shipbox\">\n  <div class=\"esg-shipbox__accent\"></div>\n\n  <div class=\"esg-shipbox__row\">\n    <span class=\"esg-shipbox__status\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"></path></svg>\n      In Stock • Ready to Ship\n    </span>\n  </div>\n\n  <div id=\"esg-2pm-countdown-wrap\" class=\"esg-shipbox__countdown\">\n    <div class=\"esg-shipbox__countdown-copy\">\n      <div class=\"esg-shipbox__cutoff-label\" id=\"esg-cutoff-label\">Same-Day Shipping Cutoff</div>\n      <div class=\"esg-shipbox__cutoff-sub\" id=\"esg-cutoff-sub\">Order by <strong>2:00 PM ET</strong></div>\n    </div>\n    <div id=\"esg-2pm-time\" class=\"esg-shipbox__clock\">--:--:--</div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var wrap = document.getElementById('esg-2pm-countdown-wrap');\n  var timeEl = document.getElementById('esg-2pm-time');\n  var labelEl = document.getElementById('esg-cutoff-label');\n  var subEl = document.getElementById('esg-cutoff-sub');\n  if (!wrap || !timeEl) return;\n\n  var DAY_NAMES = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\n  function pad(n) { return String(n).padStart(2, '0'); }\n  function getETParts(d) {\n    var out = {};\n    new Intl.DateTimeFormat('en-US', {\n      timeZone: 'America/New_York',\n      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false\n    }).formatToParts(d).forEach(function (p) { out[p.type] = p.value; });\n    return out;\n  }\n  function getETDow(d) {\n    var wk = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short' }).format(d);\n    return ({Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6})[wk];\n  }\n  function nextBusinessDayName(from) {\n    for (var i = 1; i <= 7; i++) {\n      var dow = getETDow(new Date(from.getTime() + i * 86400000));\n      if (dow !== 0 && dow !== 6) return DAY_NAMES[dow];\n    }\n    return 'next business day';\n  }\n  function update() {\n    var now = new Date();\n    var p = getETParts(now);\n    var dow = getETDow(now);\n    var nowSec = parseInt(p.hour,10)*3600 + parseInt(p.minute,10)*60 + parseInt(p.second,10);\n    var cutoffSec = 14 * 3600;\n    var closed = (dow === 0 || dow === 6) || nowSec >= cutoffSec;\n\n    if (closed) {\n      var nd = nextBusinessDayName(now);\n      labelEl.textContent = 'Next Shipping Day';\n      subEl.innerHTML = 'Orders ship <strong>' + nd + '</strong>';\n      timeEl.textContent = nd.toUpperCase();\n      timeEl.classList.add('esg-shipbox__clock--text');\n      return;\n    }\n    labelEl.textContent = 'Same-Day Shipping Cutoff';\n    subEl.innerHTML = 'Order by <strong>2:00 PM ET</strong>';\n    timeEl.classList.remove('esg-shipbox__clock--text');\n    var r = cutoffSec - nowSec;\n    timeEl.textContent = pad(Math.floor(r/3600)) + ':' + pad(Math.floor((r%3600)/60)) + ':' + pad(r%60);\n  }\n  update();\n  setInterval(update, 1000);\n})();\n</script>\n{%- endif -%}\n\n\n{%- if total_inventory <= 0 -%}\n  {%- assign one_day = 86400 -%}\n  {%- assign today_ts = 'now' | date: '%s' | plus: 0 -%}\n  {%- assign business_days_found = 0 -%}\n  {%- assign ship_start_ts = blank -%}\n  {%- assign ship_end_ts = blank -%}\n\n  {%- for i in (1..7) -%}\n    {%- assign add = one_day | times: i -%}\n    {%- assign check_ts = today_ts | plus: add -%}\n    {%- assign check_day = check_ts | date: '%u' | plus: 0 -%}\n    {%- unless check_day == 6 or check_day == 7 -%}\n      {%- assign business_days_found = business_days_found | plus: 1 -%}\n      {%- if business_days_found == 1 -%}{%- assign ship_start_ts = check_ts -%}{%- endif -%}\n      {%- if business_days_found == 3 -%}{%- assign ship_end_ts = check_ts -%}{%- break -%}{%- endif -%}\n    {%- endunless -%}\n  {%- endfor -%}\n\n  <div class=\"esg-shipest\">\n    <div class=\"esg-shipest__accent\"></div>\n    <div class=\"esg-shipest__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 7v5l3 2\"></path></svg>\n    </div>\n    <div class=\"esg-shipest__content\">\n      <div class=\"esg-shipest__label\">Estimated Ship Date</div>\n      <div class=\"esg-shipest__dates\">{{ ship_start_ts | date: '%a %b %-d' }} — {{ ship_end_ts | date: '%a %b %-d' }}</div>\n      <div class=\"esg-shipest__sub\">Typically 1–3 business days.</div>\n    </div>\n  </div>\n{%- endif -%}\n\n<style>\n  .esg-shipbox, .esg-shipest {\n    max-width: 1100px;\n    margin: 10px 0;\n    position: relative;\n    overflow: hidden;\n    border: 1px solid #e5e7eb;\n    border-radius: 16px;\n    background: #ffffff;\n    box-shadow: 0 8px 20px rgba(15, 23, 42, .05);\n    color: #2a3756;\n    font-family: inherit;\n    line-height: 1.35;\n  }\n  .esg-shipbox__accent, .esg-shipest__accent {\n    position: absolute; inset: 0 0 auto; height: 3px;\n    background: linear-gradient(90deg, #086ED3 0%, #0A1A3A 100%);\n  }\n\n  /* In-stock box */\n  .esg-shipbox { padding: 10px 12px 11px; }\n  .esg-shipbox__row { margin-bottom: 8px; }\n  .esg-shipbox__status {\n    display: inline-flex; align-items: center; gap: 6px;\n    padding: 5px 10px; border-radius: 999px;\n    background: #ecfdf3; border: 1px solid #bbf7d0; color: #15803d;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px; font-weight: 700; letter-spacing: .1em;\n    text-transform: uppercase; line-height: 1; white-space: nowrap;\n  }\n  .esg-shipbox__status svg { width: 11px; height: 11px; }\n\n  .esg-shipbox__countdown {\n    padding: 8px 11px; border-radius: 10px;\n    border: 1px solid rgba(8, 110, 211, .18); background: #ffffff;\n    display: flex; align-items: center; justify-content: space-between;\n    gap: 10px; flex-wrap: wrap;\n    box-shadow: 0 2px 6px rgba(8, 110, 211, .06);\n  }\n  .esg-shipbox__countdown-copy { display: flex; flex-direction: column; gap: 2px; }\n  .esg-shipbox__cutoff-label {\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 11px; font-weight: 700; letter-spacing: .14em;\n    text-transform: uppercase; color: #086ED3; line-height: 1;\n  }\n  .esg-shipbox__cutoff-sub { font-size: 12.5px; color: #2a3756; font-weight: 500; }\n  .esg-shipbox__cutoff-sub strong { color: #0A1A3A; font-weight: 700; }\n\n  .esg-shipbox__clock {\n    display: inline-flex; align-items: center; justify-content: center;\n    min-width: 130px; padding: 6px 12px; border-radius: 7px;\n    background: linear-gradient(180deg, #0A1A3A 0%, #071a33 100%);\n    color: #ffffff; font-weight: 800; font-size: 18px;\n    letter-spacing: .12em; line-height: 1;\n    font-variant-numeric: tabular-nums;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;\n    box-shadow: inset 0 2px 4px rgba(0,0,0,.25), 0 2px 6px rgba(10, 26, 58, .25);\n    border: 1px solid rgba(255, 255, 255, .08);\n  }\n  .esg-shipbox__clock--text {\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    letter-spacing: .14em; font-size: 16px;\n  }\n\n  /* Estimated ship box */\n  .esg-shipest {\n    padding: 9px 12px; display: flex; align-items: center; gap: 10px;\n  }\n  .esg-shipest__icon {\n    display: inline-flex; align-items: center; justify-content: center;\n    width: 34px; height: 34px; min-width: 34px; border-radius: 9px;\n    background: #ffffff; color: #086ED3;\n    border: 1px solid rgba(8, 110, 211, .18);\n    box-shadow: 0 2px 6px rgba(8, 110, 211, .08);\n    flex: 0 0 auto;\n  }\n  .esg-shipest__icon svg { width: 18px; height: 18px; display: block; }\n  .esg-shipest__content { min-width: 0; line-height: 1.3; }\n  .esg-shipest__label {\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 11px; font-weight: 700; letter-spacing: .14em;\n    text-transform: uppercase; color: #086ED3; margin-bottom: 1px;\n  }\n  .esg-shipest__dates {\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 15px; font-weight: 800; color: #0A1A3A;\n    letter-spacing: .02em; text-transform: uppercase; line-height: 1.15;\n  }\n  .esg-shipest__sub { font-size: 12px; color: #2a3756; line-height: 1.35; }\n\n  @media (max-width: 749px) {\n    .esg-shipbox, .esg-shipest { border-radius: 14px; }\n    .esg-shipbox { padding: 9px 11px 10px; }\n    .esg-shipbox__cutoff-label { font-size: 10.5px; }\n    .esg-shipbox__cutoff-sub { font-size: 12px; }\n    .esg-shipbox__clock { min-width: 118px; font-size: 16px; padding: 6px 10px; }\n    .esg-shipbox__clock--text { font-size: 14px; }\n    .esg-shipest { padding: 9px 11px; }\n    .esg-shipest__icon { width: 30px; height: 30px; min-width: 30px; }\n    .esg-shipest__icon svg { width: 16px; height: 16px; }\n    .esg-shipest__dates { font-size: 14px; }\n  }\n</style>"
          }
        },
        "custom_liquid_3pNXCy": {
          "type": "custom-liquid",
          "name": "Split Inventory V5",
          "disabled": true,
          "settings": {
