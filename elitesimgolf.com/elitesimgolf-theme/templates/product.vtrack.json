          "name": "Trust Badge",
          "settings": {
            "custom_liquid": "<div class=\"esg-vtrack-compact-box\">\n  <div class=\"esg-vtrack-compact-accent\"></div>\n\n  <div class=\"esg-vtrack-compact-header\">\n    <span class=\"esg-vtrack-compact-header-icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M20 6 9 17l-5-5\"></path>\n      </svg>\n    </span>\n    <span>Why Buy VTrack From Elite Sim Golf</span>\n  </div>\n\n  <div class=\"esg-vtrack-compact-intro\">\n    <strong>America's #1 VTrack Dealer</strong> — expert support, fast shipping, and real post-purchase help. Don't believe us? Our reviews speak for themselves.\n  </div>\n\n  <div class=\"esg-vtrack-compact-grid\">\n\n    <div class=\"esg-vtrack-compact-item\">\n      <div class=\"esg-vtrack-compact-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n          <path d=\"M22 4L12 14.01l-3-3\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-vtrack-compact-content\">\n        <div class=\"esg-vtrack-compact-title\">Lowest Price Guaranteed</div>\n        <div class=\"esg-vtrack-compact-text\">You won't find a better price — if you do, let us know and we'll beat it.</div>\n      </div>\n    </div>\n\n    <div class=\"esg-vtrack-compact-item\">\n      <div class=\"esg-vtrack-compact-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n          <path d=\"M12 7v5l3 3\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-vtrack-compact-content\">\n        <div class=\"esg-vtrack-compact-title\">30-Day Risk-Free Guarantee</div>\n        <div class=\"esg-vtrack-compact-text\">Buy with confidence — if you're not happy, we'll take it back.</div>\n      </div>\n    </div>\n\n    <div class=\"esg-vtrack-compact-item\">\n      <div class=\"esg-vtrack-compact-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-vtrack-compact-content\">\n        <div class=\"esg-vtrack-compact-title\">Remote Setup Help</div>\n        <div class=\"esg-vtrack-compact-text\">Support with setup, calibration, and software — buy with confidence.</div>\n      </div>\n    </div>\n\n    <div class=\"esg-vtrack-compact-item\">\n      <div class=\"esg-vtrack-compact-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n          <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n          <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        </svg>\n      </div>\n      <div class=\"esg-vtrack-compact-content\">\n        <div class=\"esg-vtrack-compact-title\">Fast U.S. Shipping</div>\n        <div class=\"esg-vtrack-compact-text\">Quick turnaround from U.S.-stocked inventory. Not a dropshipper.</div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .esg-vtrack-compact-box {\n    max-width: 1100px;\n    margin: 12px 0;\n    position: relative;\n    overflow: hidden;\n    padding: 11px 12px 12px;\n    border: 1px solid #e5e7eb;\n    border-radius: 14px;\n    background: #ffffff;\n    box-shadow: 0 6px 16px rgba(15, 23, 42, .04);\n    color: #2a3756;\n    font-family: inherit;\n    line-height: 1.35;\n  }\n\n  .esg-vtrack-compact-accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 3px;\n    background: linear-gradient(90deg, #086ED3 0%, #0A1A3A 100%);\n  }\n\n  .esg-vtrack-compact-header {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-bottom: 8px;\n    color: #086ED3;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .esg-vtrack-compact-header-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 14px;\n    height: 14px;\n    color: #086ED3;\n  }\n\n  .esg-vtrack-compact-header-icon svg {\n    width: 14px;\n    height: 14px;\n    display: block;\n  }\n\n  .esg-vtrack-compact-intro {\n    margin: 0 0 10px;\n    padding: 8px 10px;\n    border-radius: 10px;\n    background: #f8fbff;\n    border: 1px solid rgba(8, 110, 211, .18);\n    font-size: 12.5px;\n    color: #2a3756;\n    line-height: 1.4;\n  }\n\n  .esg-vtrack-compact-intro strong {\n    color: #0A1A3A;\n    font-weight: 700;\n  }\n\n  .esg-vtrack-compact-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 9px 14px;\n  }\n\n  .esg-vtrack-compact-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 8px;\n    min-width: 0;\n  }\n\n  .esg-vtrack-compact-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 26px;\n    height: 26px;\n    min-width: 26px;\n    border-radius: 8px;\n    background: #eff6ff;\n    color: #086ED3;\n    margin-top: 1px;\n  }\n\n  .esg-vtrack-compact-icon svg {\n    width: 14px;\n    height: 14px;\n    display: block;\n  }\n\n  .esg-vtrack-compact-content {\n    min-width: 0;\n  }\n\n  .esg-vtrack-compact-title {\n    color: #0A1A3A;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 14px;\n    font-weight: 800;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    line-height: 1.15;\n    margin-bottom: 2px;\n  }\n\n  .esg-vtrack-compact-text {\n    color: #2a3756;\n    font-size: 12px;\n    line-height: 1.4;\n  }\n\n  @media (max-width: 749px) {\n    .esg-vtrack-compact-box {\n      padding: 10px 11px 11px;\n      border-radius: 12px;\n    }\n\n    .esg-vtrack-compact-grid {\n      grid-template-columns: 1fr;\n      gap: 9px;\n    }\n\n    .esg-vtrack-compact-intro,\n    .esg-vtrack-compact-text {\n      font-size: 12px;\n    }\n\n    .esg-vtrack-compact-title {\n      font-size: 13px;\n    }\n  }\n</style>"
          }
