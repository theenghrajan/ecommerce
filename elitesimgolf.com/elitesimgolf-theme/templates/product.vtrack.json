        "custom_liquid_zMxpfP": {
          "type": "custom-liquid",
          "name": "Vtrack Flash Sale",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nESG PDP Countdown Timer — Flash Sale Ends April 15, 2026\n- Shows ONLY on products tagged: vtrackbundle\n{%- endcomment -%}\n\n{%- assign show_vtrackbundle_flash = false -%}\n{%- if product.tags contains 'vtrackbundle' -%}\n  {%- assign show_vtrackbundle_flash = true -%}\n{%- endif -%}\n\n{%- if show_vtrackbundle_flash -%}\n<div id=\"esg-flash-countdown\" style=\"\n  max-width:1100px;\n  margin:14px auto 0;\n  font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  color:#111827;\n\">\n  <div style=\"\n    border:1px solid #dc2626;\n    border-radius:18px;\n    background:linear-gradient(180deg,#ffffff 0%,#fff5f5 100%);\n    box-shadow:0 14px 28px rgba(220,38,38,.10);\n    padding:16px 18px;\n    overflow:hidden;\n    position:relative;\n  \">\n    <div style=\"\n      position:absolute;\n      inset:0 auto 0 0;\n      width:6px;\n      background:linear-gradient(180deg,#dc2626 0%,#f97316 100%);\n    \"></div>\n\n    <div style=\"padding-left:4px;\">\n      <div style=\"\n        display:inline-flex;\n        align-items:center;\n        padding:6px 10px;\n        border-radius:999px;\n        background:#dc2626;\n        color:#ffffff;\n        font-size:11px;\n        font-weight:900;\n        letter-spacing:.10em;\n        text-transform:uppercase;\n        margin:0 0 10px;\n      \">\n        VTrack Flash Sale\n      </div>\n\n      <div style=\"\n        font-size:20px;\n        line-height:1.2;\n        font-weight:950;\n        color:#7f1d1d;\n        margin:0 0 6px;\n      \">\n        VTrack Ultimate Bundle Sale Ends April 15th\n      </div>\n\n      <div style=\"\n        font-size:14px;\n        color:#7c2d12;\n        margin:0 0 14px;\n      \">\n        Limited-time pricing ends soon. Lock in the deal before the countdown hits zero.\n      </div>\n\n      <div id=\"esg-flash-countdown-grid\" style=\"\n        display:grid;\n        grid-template-columns:repeat(4, minmax(90px, 1fr));\n        gap:10px;\n      \">\n        <div style=\"border:1px solid rgba(220,38,38,.16); border-radius:14px; background:#ffffff; padding:12px; text-align:center;\">\n          <div id=\"esg-days\" style=\"font-size:18px; line-height:1; font-weight:950; color:#111827;\">00</div>\n          <div style=\"margin-top:6px; font-size:11px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; color:#6b7280;\">Days</div>\n        </div>\n\n        <div style=\"border:1px solid rgba(220,38,38,.16); border-radius:14px; background:#ffffff; padding:12px; text-align:center;\">\n          <div id=\"esg-hours\" style=\"font-size:18px; line-height:1; font-weight:950; color:#111827;\">00</div>\n          <div style=\"margin-top:6px; font-size:11px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; color:#6b7280;\">Hours</div>\n        </div>\n\n        <div style=\"border:1px solid rgba(220,38,38,.16); border-radius:14px; background:#ffffff; padding:12px; text-align:center;\">\n          <div id=\"esg-minutes\" style=\"font-size:18px; line-height:1; font-weight:950; color:#111827;\">00</div>\n          <div style=\"margin-top:6px; font-size:11px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; color:#6b7280;\">Minutes</div>\n        </div>\n\n        <div style=\"border:1px solid rgba(220,38,38,.16); border-radius:14px; background:#ffffff; padding:12px; text-align:center;\">\n          <div id=\"esg-seconds\" style=\"font-size:18px; line-height:1; font-weight:950; color:#111827;\">00</div>\n          <div style=\"margin-top:6px; font-size:11px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; color:#6b7280;\">Seconds</div>\n        </div>\n      </div>\n\n      <div id=\"esg-expired-note\" style=\"\n        display:none;\n        margin-top:12px;\n        padding:12px 14px;\n        border-radius:12px;\n        border:1px solid rgba(220,38,38,.16);\n        background:#ffffff;\n        font-size:13px;\n        font-weight:800;\n        color:#7f1d1d;\n      \">\n        This flash sale has ended.\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var endDate = new Date(\"April 15, 2026 23:59:59\").getTime();\n\n  var daysEl = document.getElementById(\"esg-days\");\n  var hoursEl = document.getElementById(\"esg-hours\");\n  var minutesEl = document.getElementById(\"esg-minutes\");\n  var secondsEl = document.getElementById(\"esg-seconds\");\n  var expiredNote = document.getElementById(\"esg-expired-note\");\n\n  function pad(num) {\n    return String(num).padStart(2, \"0\");\n  }\n\n  function updateCountdown() {\n    var now = new Date().getTime();\n    var distance = endDate - now;\n\n    if (distance <= 0) {\n      if (daysEl) daysEl.textContent = \"00\";\n      if (hoursEl) hoursEl.textContent = \"00\";\n      if (minutesEl) minutesEl.textContent = \"00\";\n      if (secondsEl) secondsEl.textContent = \"00\";\n      if (expiredNote) expiredNote.style.display = \"block\";\n      return;\n    }\n\n    var days = Math.floor(distance / (1000 * 60 * 60 * 24));\n    var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n    var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));\n    var seconds = Math.floor((distance % (1000 * 60)) / 1000);\n\n    if (daysEl) daysEl.textContent = pad(days);\n    if (hoursEl) hoursEl.textContent = pad(hours);\n    if (minutesEl) minutesEl.textContent = pad(minutes);\n    if (secondsEl) secondsEl.textContent = pad(seconds);\n  }\n\n  updateCountdown();\n  setInterval(updateCountdown, 1000);\n})();\n</script>\n{%- endif -%}"
          }
