ector</strong> to protect your investment. Made in the USA. Lifetime Guarantee. </div> <div style=\"display:flex; flex-wrap:wrap; gap:10px; align-items:center;\"> <button type=\"button\" id=\"esgAddProtectorBtn\" style=\" appearance:none; border:none; border-radius:12px; padding:11px 14px; background:#086ed3; color:#ffffff; font-weight:900; font-size:13px; cursor:pointer; box-shadow:0 10px 20px rgba(8,110,211,.18); \"> Add VTrack Protector to Cart </button> <div style=\"font-size:12px; color:#64748b;\"> Elite Sim Golf SKU# <strong>VTRACK-PROTECT</strong> </div> </div> <div id=\"esgProtectorStatus\" style=\" display:none; margin-top:10px; padding:10px 12px; border-radius:12px; font-size:12.5px; font-weight:800; \"></div> </div> </div> </div> <script> (function () { var VARIANT_ID = 45931905482946; var btn = document.getElementById('esgAddProtectorBtn'); var status = document.getElementById('esgProtectorStatus'); if (!btn || !status) return; function showStatus(message, type) { status.style.display = 'block'; status.textContent = message; if (type === 'success') { status.style.background = '#ecfdf5'; status.style.border = '1px solid #10b981'; status.style.color = '#065f46'; } else { status.style.background = '#fff7f7'; status.style.border = '1px solid #ef4444'; status.style.color = '#991b1b'; } } async function addProtector() { var original = btn.innerHTML; btn.disabled = true; btn.style.opacity = '0.7'; btn.innerHTML = 'Adding...'; try { var res = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ id: VARIANT_ID, quantity: 1 }) }); if (!res.ok) { var txt = await res.text(); console.error('Add protector failed:', txt); throw new Error('Could not add protector. Check console for details.'); } showStatus('Added! VTrack Impact Protector is now in your cart.', 'success'); // Optional: fire a few common cart refresh events (harmless if unused) document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles:true })); document.dispatchEvent(new CustomEvent('cart:updated', { bubbles:true })); document.dispatchEvent(new CustomEvent('alchemy:cart:refresh', { bubbles:true })); window.dispatchEvent(new CustomEvent('cart:refresh')); } catch (e) { console.error(e); showStatus(e.message || 'There was a problem adding the protector.', 'error'); } finally { btn.disabled = false; btn.style.opacity = '1'; btn.innerHTML = original; } } btn.addEventListener('click', addProtector); })(); </script> {%- endif -%}"
