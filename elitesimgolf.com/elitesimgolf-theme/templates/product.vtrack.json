a(15,23,42,.12);\n            display:flex;\n            align-items:center;\n            justify-content:center;\n            flex:0 0 auto;\n            overflow:hidden;\n          \">\n            <img\n              src=\"https://elitesimgolf.com/cdn/shop/files/VTK-Protector.png\"\n              alt=\"Ultimate Accessory Bundle\"\n              style=\"width:92px; height:92px; object-fit:contain; display:block;\"\n            >\n            {%- comment -%}\n              Replace the src above with your bundle image when available, e.g.:\n              src=\"BUNDLE_IMAGE_URL\"\n            {%- endcomment -%}\n          </div>\n\n          <div style=\"flex:1; min-width:0;\">\n            <div style=\"font-weight:950; font-size:14px; color:#0b2a55; margin:0 0 4px;\">\n              Ultimate Accessory Bundle\n            </div>\n            <div style=\"font-weight:950; font-size:14px; color:#0b2a55; margin:0 0 8px;\">\n              $199.99\n            </div>\n\n            <div style=\"font-size:12.5px; color:#334155; margin:0;\">\n              Includes <strong>VTrack Protector</strong>, a <strong>Dozen TP5 Pix Balls</strong>, and a <strong>Remote Power Switch</strong>.\n            </div>\n\n            <div style=\"margin-top:8px; display:flex; flex-wrap:wrap; gap:6px;\">\n    </div>\n          </div>\n        </div>\n\n        <div style=\"display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:12px;\">\n          <button type=\"button\" id=\"esgAddAccessoryBundleBtn\" style=\"\n            appearance:none;\n            border:none;\n            border-radius:12px;\n            padding:11px 14px;\n            background:#0b2a55;\n            color:#ffffff;\n            font-weight:950;\n            font-size:13px;\n            cursor:pointer;\n            box-shadow:0 10px 20px rgba(11,42,85,.18);\n          \">\n            Add Bundle ($199.99)\n          </button>\n\n          <div style=\"font-size:12px; color:#334155;\">\n            Adds bundle as a single item\n          </div>\n        </div>\n\n        <div id=\"esgStatusBundle\" style=\"\n          display:none;\n          margin-top:10px;\n          padding:10px 12px;\n          border-radius:12px;\n          font-size:12.5px;\n          font-weight:800;\n        \"></div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function () {\n  // Variant IDs (replace bundle ID)\n  var VARIANT_ID_PROTECTOR = 45931905482946; // Protector Only\n  var VARIANT_ID_BUNDLE    = 00000000000000; // TODO: replace with Ultimate Accessory Bundle variant ID\n\n  var btnProtector = document.getElementById('esgAddProtectorOnlyBtn');\n  var btnBundle    = document.getElementById('esgAddAccessoryBundleBtn');\n  var stProtector  = document.getElementById('esgStatusProtectorOnly');\n  var stBundle     = document.getElementById('esgStatusBundle');\n\n  function showStatus(el, message, type) {\n    if (!el) return;\n    el.style.display = 'block';\n    el.textContent = message;\n\n    if (type === 'success') {\n      el.style.background = '#ecfdf5';\n      el.style.border = '1px solid #10b981';\n      el.style.color = '#065f46';\n    } else {\n      el.style.background = '#fff7f7';\n      el.style.border = '1px solid #ef4444';\n      el.style.color = '#991b1b';\n    }\n  }\n\n  async function addVariant(variantId, btn, statusEl, successMsg) {\n    if (!variantId || String(variantId).indexOf('000000') === 0) {\n      showStatus(statusEl, 'Bundle variant ID is not set yet. Replace VARIANT_ID_BUNDLE in the script.', 'error');\n      return;\n    }\n\n    var original = btn.innerHTML;\n    btn.disabled = true;\n    btn.style.opacity = '0.7';\n    btn.innerHTML = 'Adding...';\n\n    try {\n      var res = await fetch('/cart/add.js', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json',\n          'X-Requested-With': 'XMLHttpRequest'\n        },\n        body: JSON.stringify({ id: variantId, quantity: 1 })\n      });\n\n      if (!res.ok) {\n        var txt = await res.text();\n        console.error('Add failed:', txt);\n        throw new Error('Could not add item. Check console for details.');\n      }\n\n      showStatus(statusEl, successMsg || 'Added to cart.', 'success');\n\n      // Optional cart refresh events\n      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles:true }));\n      document.dispatchEvent(new CustomEvent('cart:updated', { bubbles:true }));\n      document.dispatchEvent(new CustomEvent('alchemy:cart:refresh', { bubbles:true }));\n      window.dispatchEvent(new CustomEvent('cart:refresh'));\n    } catch (e) {\n      console.error(e);\n      showStatus(statusEl, e.message || 'There was a problem adding the item.', 'error');\n    } finally {\n      btn.disabled = false;\n      btn.style.opacity = '1';\n      btn.innerHTML = original;\n    }\n  }\n\n  if (btnProtector) {\n    btnProtector.addEventListener('click', function() {\n      addVariant(VARIANT_ID_PROTECTOR, btnProtector, stProtector, 'Added! VTrack Protector is now in your cart.');\n    });\n  }\n\n  if (btnBundle) {\n    btnBundle.addEventListener('click', function() {\n      addVariant(VARIANT_ID_BUNDLE, btnBundle, stBundle, 'Added! Ultimate Accessory Bundle is now in your cart.');\n    });\n  }\n})();\n</script>\n{%- endif -%}"
