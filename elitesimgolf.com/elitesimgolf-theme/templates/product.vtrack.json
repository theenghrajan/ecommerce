          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nELITE SIM GOLF – VTrack top support box\nPlace near add-to-cart / buy buttons\n{%- endcomment -%}\n\n{%- assign is_vtrack_page = false -%}\n{%- if product.title contains 'VTrack' or product.handle contains 'vtrack' -%}\n  {%- assign is_vtrack_page = true -%}\n{%- endif -%}\n\n{%- if is_vtrack_page -%}\n<style>\n  .esg-vtrack-support-box{\n    margin:14px 0 0;\n    padding:16px;\n    border:1px solid #cfe5ff;\n    border-radius:16px;\n    background:linear-gradient(180deg,#f8fbff 0%,#eef6ff 100%);\n    box-shadow:0 8px 24px rgba(8,110,211,.08);\n    font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;\n  }\n  .esg-vtrack-support-head{\n    display:flex;\n    align-items:flex-start;\n    gap:12px;\n  }\n  .esg-vtrack-support-icon{\n    width:40px;\n    height:40px;\n    min-width:40px;\n    border-radius:12px;\n    background:#086ed3;\n    color:#fff;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:18px;\n    font-weight:800;\n  }\n  .esg-vtrack-support-title{\n    margin:0 0 4px;\n    font-size:16px;\n    line-height:1.2;\n    font-weight:800;\n    color:#0f172a;\n  }\n  .esg-vtrack-support-text{\n    margin:0;\n    font-size:14px;\n    line-height:1.55;\n    color:#334155;\n  }\n  .esg-vtrack-support-actions{\n    display:flex;\n    flex-wrap:wrap;\n    gap:10px;\n    margin-top:14px;\n  }\n  .esg-vtrack-btn{\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    min-height:42px;\n    padding:0 16px;\n    border-radius:999px;\n    text-decoration:none;\n    font-size:14px;\n    font-weight:800;\n    transition:.2s ease;\n  }\n  .esg-vtrack-btn-primary{\n    background:#086ed3;\n    color:#fff !important;\n    border:1px solid #086ed3;\n  }\n  .esg-vtrack-btn-primary:hover{\n    background:#065fb8;\n    border-color:#065fb8;\n  }\n  .esg-vtrack-btn-secondary{\n    background:#fff;\n    color:#086ed3 !important;\n    border:1px solid #086ed3;\n  }\n  .esg-vtrack-btn-secondary:hover{\n    background:#f3f8ff;\n  }\n  @media (max-width: 767px){\n    .esg-vtrack-support-actions{\n      flex-direction:column;\n    }\n    .esg-vtrack-btn{\n      width:100%;\n    }\n  }\n</style>\n\n<div class=\"esg-vtrack-support-box\">\n  <div class=\"esg-vtrack-support-head\">\n    <div class=\"esg-vtrack-support-icon\">▶</div>\n    <div>\n      <h3 class=\"esg-vtrack-support-title\">VTrack+GSPro  Step-by-step Setup Video</h3>\n      <p class=\"esg-vtrack-support-text\">\n        Watch our full Elite Sim Golf step-by-step video covering VTrack ToolKit setup, calibration, ball check procedure, tee settings, testing, and GSPro configuration.\n      </p>\n    </div>\n  </div>\n\n  <div class=\"esg-vtrack-support-actions\">\n    <a href=\"#vtrack-setup-video-guide\" class=\"esg-vtrack-btn esg-vtrack-btn-primary\">Watch Setup Video</a>\n    <a href=\"https://youtu.be/DKIgurI3IvA?si=M4MI6P1I09_F8WCy\" target=\"_blank\" rel=\"noopener\" class=\"esg-vtrack-btn esg-vtrack-btn-secondary\">Open on YouTube</a>\n  </div>\n</div>\n{%- endif -%}"
          }
        },
