        "custom_liquid_bz8Rf3": {
          "type": "custom-liquid",
          "name": "Custom LM Accessories",
          "settings": {
            "custom_liquid": "{%- comment -%}\n============================================================\n  ESG ACCESSORIES -- INLINE VERSION\n  Paste this whole thing into the Custom Liquid block on the\n  ProTee VX product template. No esg-accessories snippet needed.\n  Still requires snippets/esg-acc-row.liquid (already saved).\n\n  Heading resolves automatically from the product:\n    'acc-label:<value>' tag  ->  longest tag matching the start\n    of the title  ->  vendor  ->  'Popular Accessories'\n============================================================\n{%- endcomment -%}\n\n{%- liquid\n  assign uid = 'esgacc-' | append: product.id\n\n  assign esg_label = ''\n\n  if esg_label == ''\n    for t in product.tags\n      assign t_low = t | downcase\n      if t_low contains 'acc-label:'\n        assign esg_label = t | split: ':' | last | strip\n        break\n      endif\n    endfor\n  endif\n\n  if esg_label == ''\n    assign best = ''\n    assign title_len = product.title | size\n    for t in product.tags\n      assign t_len = t | size\n      if t_len > 0 and t_len <= title_len\n        assign head = product.title | slice: 0, t_len\n        if head == t\n          assign best_len = best | size\n          if t_len > best_len\n            assign best = t\n          endif\n        endif\n      endif\n    endfor\n    assign esg_label = best\n  endif\n\n  if esg_label == ''\n    assign esg_label = product.vendor | default: ''\n  endif\n\n  assign heading_pattern = 'Popular [label] Accessories'\n\n  if esg_label == ''\n    assign heading_text = 'Popular Accessories'\n  else\n    assign heading_text = heading_pattern | replace: '[label]', esg_label\n  endif\n\n\n  assign sub_text = ''\n  if sub_text == ''\n    if esg_label == ''\n      assign sub_text = '[count] add-on[s] buyers order most'\n    else\n      assign sub_text = '[count] add-on[s] [label] buyers order most'\n    endif\n  endif\n  assign handles_str = ''\n  assign max = 24\n  assign visible = 3\n\n  # ----------------------------------------------------------\n  # DEFAULT SET (fallback)\n  # Used only when a launch monitor product has no complementary\n  # products assigned in Search & Discovery. Edit this one line to\n  # change what shows: comma separated product handles, in order.\n  # Keep it to generic add-ons that suit ANY launch monitor -- model\n  # specific items belong on that model's own complementary list.\n  # ----------------------------------------------------------\n  assign fallback_handles = 'gspro-golf-simulator-software-1-year-subscription,flex-4-gspro-wireless-controller-elite-sim-golf-edition-by-club-keyboard,golf-simulator-gaming-desktop-pc-all-configurations-by-elite-sim-golf'\n\n  # Gate: launch monitor product pages only. The substring test is\n  # deliberate -- the real type on these products is 'Golf Launch\n  # Monitor', not 'Launch Monitor', so an exact match never fires.\n  # Accessory and protection types contain the same substring, so\n  # they are excluded: a case or shield PDP is not a launch monitor.\n  assign type_low = product.type | default: '' | downcase\n  assign type_ok = false\n  if type_low contains 'launch monitor'\n    assign type_ok = true\n    if type_low contains 'accessor'\n      assign type_ok = false\n    endif\n    if type_low contains 'protection'\n      assign type_ok = false\n    endif\n  endif\n\n  # Count assigned complementary products that would actually render.\n  # Unpublished or deleted references come back nil, so a non-empty\n  # metafield can still produce zero rows -- count the usable ones.\n  assign complementary = product.metafields.shopify--discovery--product_recommendation.complementary_products.value\n  assign comp_valid = 0\n  for cp in complementary limit: max\n    if cp != blank and cp.handle != product.handle\n      assign comp_valid = comp_valid | plus: 1\n    endif\n  endfor\n\n  assign use_fallback = false\n  if comp_valid == 0 and type_ok and fallback_handles != ''\n    assign use_fallback = true\n  endif\n\n  # all_products is capped at 20 lookups per template by Shopify, so the\n  # handle driven paths stay well under it.\n  assign fb_max = 12\n  assign visible_plus = visible | plus: 1\n  assign is_open = true\n  assign n = 0\n-%}\n\n{%- comment -%} Resolve which products to show {%- endcomment -%}\n{%- capture rows -%}\n  {%- if handles_str != '' -%}\n    {%- assign handle_list = handles_str | split: ',' -%}\n    {%- for h in handle_list -%}\n      {%- assign key = h | strip -%}\n      {%- assign p = all_products[key] -%}\n      {%- if p != blank and p.id != blank and p.handle != product.handle -%}\n        {%- assign n = n | plus: 1 -%}\n        {%- if n == visible_plus -%}<details class=\"esg-acc-more\"><summary class=\"esg-acc-more__sum\"><span class=\"esg-acc-more__txt esg-acc-more__txt--closed\">Show [MORE] more</span><span class=\"esg-acc-more__txt esg-acc-more__txt--open\">Show less</span><span class=\"esg-acc-more__chev\" aria-hidden=\"true\"></span></summary><div class=\"esg-acc-more__body\">{%- endif -%}\n        {%- render 'esg-acc-row', p: p -%}\n      {%- endif -%}\n    {%- endfor -%}\n  {%- elsif use_fallback -%}\n    {%- assign fb_list = fallback_handles | split: ',' -%}\n    {%- for h in fb_list limit: fb_max -%}\n      {%- assign key = h | strip -%}\n      {%- assign p = all_products[key] -%}\n      {%- if p != blank and p.id != blank and p.handle != product.handle -%}\n        {%- assign n = n | plus: 1 -%}\n        {%- if n == visible_plus -%}<details class=\"esg-acc-more\"><summary class=\"esg-acc-more__sum\"><span class=\"esg-acc-more__txt esg-acc-more__txt--closed\">Show [MORE] more</span><span class=\"esg-acc-more__txt esg-acc-more__txt--open\">Show less</span><span class=\"esg-acc-more__chev\" aria-hidden=\"true\"></span></summary><div class=\"esg-acc-more__body\">{%- endif -%}\n        {%- render 'esg-acc-row', p: p -%}\n      {%- endif -%}\n    {%- endfor -%}\n  {%- else -%}\n    {%- for p in complementary limit: max -%}\n      {%- if p != blank and p.handle != product.handle -%}\n        {%- assign n = n | plus: 1 -%}\n        {%- if n == visible_plus -%}<details class=\"esg-acc-more\"><summary class=\"esg-acc-more__sum\"><span class=\"esg-acc-more__txt esg-acc-more__txt--closed\">Show [MORE] more</span><span class=\"esg-acc-more__txt esg-acc-more__txt--open\">Show less</span><span class=\"esg-acc-more__chev\" aria-hidden=\"true\"></span></summary><div class=\"esg-acc-more__body\">{%- endif -%}\n        {%- render 'esg-acc-row', p: p -%}\n      {%- endif -%}\n    {%- endfor -%}\n  {%- endif -%}\n{%- endcapture -%}\n\n{%- assign row_count = rows | split: 'data-esg-row' | size | minus: 1 -%}\n\n{%- if row_count > visible -%}\n  {%- assign extra = row_count | minus: visible -%}\n  {%- assign rows = rows | append: '</div></details>' | replace: '[MORE]', extra -%}\n{%- endif -%}\n\n{%- if row_count > 0 -%}\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .esg-acc-wrap{container-type:inline-size;margin:0;box-sizing:border-box}\n  .esg-acc-wrap *,.esg-acc-wrap *::before,.esg-acc-wrap *::after{box-sizing:border-box}\n  .esg-acc-wrap .esg-acc{border:1px solid #E6E9F0;border-top:3px solid #0A1A3A;background:#fff;margin:0}\n  .esg-acc-wrap .esg-acc__sum{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;cursor:pointer;list-style:none;background:#F8F8F8;transition:background .15s ease}\n  .esg-acc-wrap .esg-acc__sum::-webkit-details-marker{display:none}\n  .esg-acc-wrap .esg-acc__sum::marker{content:\"\"}\n  .esg-acc-wrap .esg-acc__sum:hover{background:#F1F3F7}\n  .esg-acc-wrap .esg-acc__sum-txt{min-width:0}\n  .esg-acc-wrap .esg-acc__label{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:17px;font-weight:800;line-height:1.15;letter-spacing:.01em;text-transform:uppercase;color:#0A1A3A}\n  .esg-acc-wrap .esg-acc__count{display:block;font-family:'Inter',system-ui,sans-serif;font-size:11px;font-weight:400;line-height:1.4;color:#6B7390;margin-top:3px;text-transform:none}\n  .esg-acc-wrap .esg-acc__chev{flex:0 0 auto;width:20px;height:20px;position:relative}\n  .esg-acc-wrap .esg-acc__chev::before,.esg-acc-wrap .esg-acc__chev::after{content:\"\";position:absolute;top:9px;width:11px;height:2px;background:#0A1A3A;transition:transform .2s ease}\n  .esg-acc-wrap .esg-acc__chev::before{left:1px;transform:rotate(45deg)}\n  .esg-acc-wrap .esg-acc__chev::after{right:1px;transform:rotate(-45deg)}\n  .esg-acc-wrap .esg-acc[open] .esg-acc__chev::before{transform:rotate(-45deg)}\n  .esg-acc-wrap .esg-acc[open] .esg-acc__chev::after{transform:rotate(45deg)}\n  .esg-acc-wrap .esg-acc__body{border-top:1px solid #E6E9F0}\n  .esg-acc-wrap .esg-acc__grid{display:grid;grid-template-columns:1fr;gap:0}\n  .esg-acc-wrap .esg-acc-card{display:flex;align-items:center;gap:12px;padding:12px 16px;text-decoration:none;color:inherit;cursor:pointer;border-bottom:1px solid #E6E9F0;transition:background .15s ease}\n  .esg-acc-wrap .esg-acc-card:last-child{border-bottom:0}\n  .esg-acc-wrap .esg-acc-card:hover,.esg-acc-wrap .esg-acc-card:focus,.esg-acc-wrap .esg-acc-card:focus-within{background:#F8F8F8;text-decoration:none}\n  .esg-acc-wrap .esg-acc-card__thumb{flex:0 0 58px;width:58px;height:58px;background:#fff;border:1px solid #E6E9F0}\n  .esg-acc-wrap .esg-acc-card__thumb img{display:block;width:100%;height:100%;max-width:100%;object-fit:contain;padding:5px;margin:0}\n  .esg-acc-wrap .esg-acc-card__info{flex:1 1 auto;min-width:0}\n  .esg-acc-wrap .esg-acc-card__title{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:15px;font-weight:700;line-height:1.2;letter-spacing:.02em;text-transform:uppercase;color:#0A1A3A;text-decoration:none;margin:0 0 3px}\n  .esg-acc-wrap .esg-acc-card__title:hover,.esg-acc-wrap .esg-acc-card__title:focus-visible{text-decoration:underline;text-underline-offset:2px}\n  .esg-acc-wrap .esg-acc-card__meta{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-family:'Inter',system-ui,sans-serif;font-size:11px;font-weight:400;line-height:1.35;color:#6B7390;margin:0 0 5px}\n  .esg-acc-wrap .esg-acc-card__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px}\n  .esg-acc-wrap .esg-acc-card__now{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:17px;font-weight:800;line-height:1;color:#0A1A3A}\n  .esg-acc-wrap .esg-acc-card__was{font-family:'Inter',system-ui,sans-serif;font-size:11px;color:#6B7390;text-decoration:line-through}\n  .esg-acc-wrap .esg-acc-card__save{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0A1A3A;border:1px solid #0A1A3A;padding:1px 5px}\n  .esg-acc-wrap .esg-acc-card__out{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B7390;border:1px solid #C9CEDB;padding:1px 5px}\n  .esg-acc-wrap .esg-acc-card__unit{font-family:'Inter',system-ui,sans-serif;font-size:11px;color:#6B7390}\n  .esg-acc-wrap .esg-acc-card__add{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;min-width:56px;padding:7px 13px 6px;background:#fff;border:1px solid #0A1A3A;border-radius:0;color:#0A1A3A;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:14px;font-weight:700;line-height:1;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:background .15s ease,color .15s ease}\n  .esg-acc-wrap .esg-acc-card__add:hover,.esg-acc-wrap .esg-acc-card__add:focus-visible{background:#0A1A3A;color:#fff}\n  .esg-acc-wrap .esg-acc-card__add[aria-disabled=\"true\"]{opacity:.45;cursor:default}\n  .esg-acc-wrap .esg-acc-more{grid-column:1 / -1;border-top:1px solid #E6E9F0}\n  .esg-acc-wrap .esg-acc-more__sum{display:flex;align-items:center;justify-content:center;gap:7px;padding:11px 16px;cursor:pointer;list-style:none;background:#fff;transition:background .15s ease}\n  .esg-acc-wrap .esg-acc-more__sum::-webkit-details-marker{display:none}\n  .esg-acc-wrap .esg-acc-more__sum::marker{content:\"\"}\n  .esg-acc-wrap .esg-acc-more__sum:hover{background:#F8F8F8}\n  .esg-acc-wrap .esg-acc-more__txt{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0A1A3A;line-height:1}\n  .esg-acc-wrap .esg-acc-more__txt--open{display:none}\n  .esg-acc-wrap .esg-acc-more[open] .esg-acc-more__txt--closed{display:none}\n  .esg-acc-wrap .esg-acc-more[open] .esg-acc-more__txt--open{display:inline}\n  .esg-acc-wrap .esg-acc-more__chev{flex:0 0 auto;width:9px;height:9px;border-right:2px solid #0A1A3A;border-bottom:2px solid #0A1A3A;transform:rotate(45deg);margin-top:-3px;transition:transform .2s ease}\n  .esg-acc-wrap .esg-acc-more[open] .esg-acc-more__chev{transform:rotate(-135deg);margin-top:2px}\n  .esg-acc-wrap .esg-acc-more__body{display:grid;grid-template-columns:1fr;border-top:1px solid #E6E9F0}\n  .esg-acc-wrap .esg-acc-more__body .esg-acc-card:last-child{border-bottom:0}\n  @container (min-width: 860px){\n    .esg-acc-wrap .esg-acc__grid{grid-template-columns:repeat(3,1fr)}\n    .esg-acc-wrap .esg-acc-more__body{grid-template-columns:repeat(3,1fr)}\n    .esg-acc-wrap .esg-acc-more__body .esg-acc-card{border-bottom:0;border-right:1px solid #E6E9F0}\n    .esg-acc-wrap .esg-acc-more__body .esg-acc-card:last-child{border-right:0}\n    .esg-acc-wrap .esg-acc-card{border-bottom:0;border-right:1px solid #E6E9F0}\n    .esg-acc-wrap .esg-acc-card:last-child{border-right:0}\n    .esg-acc-wrap .esg-acc__sum{padding:15px 18px}\n  }\n</style>\n\n<div class=\"esg-acc-wrap\" id=\"{{ uid }}\">\n  <details class=\"esg-acc\"{% if is_open %} open{% endif %}>\n    <summary class=\"esg-acc__sum\">\n      <span class=\"esg-acc__sum-txt\">\n        <span class=\"esg-acc__label\">{{ heading_text | escape }}</span>\n        {%- liquid\n          assign plural = 's'\n          if row_count == 1\n            assign plural = ''\n          endif\n          assign sub_final = sub_text | replace: '[count]', row_count | replace: '[s]', plural | replace: '[label]', esg_label | strip\n        -%}\n        {%- if sub_final != blank -%}\n          <span class=\"esg-acc__count\">{{ sub_final | escape }}</span>\n        {%- endif -%}\n      </span>\n      <span class=\"esg-acc__chev\" aria-hidden=\"true\"></span>\n    </summary>\n    <div class=\"esg-acc__body\">\n      <div class=\"esg-acc__grid\">{{ rows }}</div>\n    </div>\n  </details>\n</div>\n\n{%- comment -%}\n  ------------------------------------------------------------\n  QUICK VIEW POPUP — self-contained.\n\n  This deliberately does NOT use Alchemy's <quick-add-drawer>.\n  That component copies the fetched page's <product-form> markup,\n  calls form.init(), then Shopify.PaymentButton.init(). Any throw\n  in that chain aborts the rest of the render, and this store is\n  already logging shop-js module load failures. The drawer also\n  only exists when settings.enable_quick_add is on.\n\n  Instead: read the product JSON at /products/<handle>.js, build\n  the popup markup here, and post straight to /cart/add.js. No\n  theme JS, no theme setting, no custom elements.\n  ------------------------------------------------------------\n{%- endcomment -%}\n<style>\n  .esg-qv{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;font-family:'Inter',system-ui,-apple-system,sans-serif}\n  .esg-qv.is-open{display:flex}\n  .esg-qv *,.esg-qv *::before,.esg-qv *::after{box-sizing:border-box}\n  .esg-qv__veil{position:absolute;inset:0;background:rgba(10,26,58,.62)}\n  .esg-qv__box{position:relative;width:100%;max-width:560px;max-height:calc(100vh - 40px);overflow-y:auto;background:#fff;border:1px solid #E6E9F0;border-top:3px solid #0A1A3A;padding:26px 28px 28px}\n  .esg-qv__x{position:absolute;top:10px;right:10px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;padding:0 0 3px;background:#fff;border:1px solid #E6E9F0;color:#0A1A3A;font-size:22px;line-height:1;cursor:pointer;transition:background .15s ease,color .15s ease}\n  .esg-qv__x:hover,.esg-qv__x:focus-visible{background:#0A1A3A;border-color:#0A1A3A;color:#fff}\n  .esg-qv__head{display:flex;gap:18px;align-items:flex-start;padding-right:30px}\n  .esg-qv__img{flex:0 0 96px;width:96px;height:96px;border:1px solid #E6E9F0;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}\n  .esg-qv__img img{max-width:100%;max-height:100%;object-fit:contain;padding:5px;display:block}\n  .esg-qv__ttl{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:22px;font-weight:800;line-height:1.15;letter-spacing:.01em;text-transform:uppercase;color:#0A1A3A;text-decoration:none;margin:0 0 7px}\n  .esg-qv__ttl:hover,.esg-qv__ttl:focus-visible{text-decoration:underline;text-underline-offset:2px}\n  .esg-qv__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px}\n  .esg-qv__now{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:24px;font-weight:800;line-height:1;color:#0A1A3A}\n  .esg-qv__was{font-size:12px;color:#6B7390;text-decoration:line-through}\n  .esg-qv__save{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0A1A3A;border:1px solid #0A1A3A;padding:2px 6px}\n  .esg-qv__desc{font-size:13px;line-height:1.6;color:#2a3756;margin:18px 0 0}\n  .esg-qv__lbl{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#6B7390;margin:20px 0 6px}\n  .esg-qv__sel{width:100%;padding:11px 12px;background:#fff;border:1px solid #C9CEDB;border-radius:0;color:#0A1A3A;font-family:'Inter',system-ui,sans-serif;font-size:14px;line-height:1.3}\n  .esg-qv__sel:focus{outline:2px solid #0A1A3A;outline-offset:1px}\n  .esg-qv__add{width:100%;margin:20px 0 0;padding:15px 18px;background:#0A1A3A;border:1px solid #0A1A3A;border-radius:0;color:#fff;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:17px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;line-height:1;cursor:pointer;transition:background .15s ease,color .15s ease}\n  .esg-qv__add:hover:not([disabled]),.esg-qv__add:focus-visible:not([disabled]){background:#fff;color:#0A1A3A}\n  .esg-qv__add[disabled]{opacity:.5;cursor:default}\n  .esg-qv__note{font-size:12px;line-height:1.5;color:#2a3756;border-left:3px solid #0A1A3A;background:#F8F8F8;padding:10px 12px;margin:14px 0 0}\n  .esg-qv__full{display:inline-block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#0A1A3A;text-decoration:none;border-bottom:1px solid #0A1A3A;margin:18px 0 0}\n  .esg-qv__load{font-size:13px;color:#6B7390;padding:26px 0}\n  .esg-qv__hide{display:none}\n  @media (max-width:560px){\n    .esg-qv{padding:12px}\n    .esg-qv__box{padding:22px 18px 24px}\n    .esg-qv__head{gap:14px}\n    .esg-qv__img{flex:0 0 74px;width:74px;height:74px}\n    .esg-qv__ttl{font-size:19px}\n  }\n</style>\n\n<script>\n  /* Opens for any click on .esg-qv-open or on a card body. The title\n     link is left alone so it still navigates to the full product page. */\n  (function () {\n    if (window.esgQuickView) return;\n    window.esgQuickView = true;\n\n    var root = null, box = null, lastFocus = null, current = null;\n\n    function money(cents) {\n      var s = (Math.round(cents) / 100).toFixed(2).split('.');\n      return '$' + s[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',') + '.' + s[1];\n    }\n\n    /* /products/<handle>.js returns options as objects ({name, position,\n       values}), not strings, so joining them raw prints [object Object].\n       Both shapes are handled since older endpoints return plain strings.\n       Shopify's placeholder name \"Title\" is not shown to shoppers. */\n    function optionLabel(data) {\n      var names = (data.options || []).map(function (o) {\n        return (o && typeof o === 'object') ? (o.name || '') : String(o || '');\n      }).filter(function (n) {\n        return n && n.toLowerCase() !== 'title';\n      });\n      return names.length ? names.join(' / ') : 'Option';\n    }\n\n    function el(tag, cls, txt) {\n      var n = document.createElement(tag);\n      if (cls) n.className = cls;\n      if (txt != null) n.textContent = txt;\n      return n;\n    }\n\n    function build() {\n      root = el('div', 'esg-qv');\n      root.setAttribute('role', 'dialog');\n      root.setAttribute('aria-modal', 'true');\n      root.setAttribute('aria-label', 'Product quick view');\n\n      var veil = el('div', 'esg-qv__veil');\n      veil.addEventListener('click', close);\n\n      box = el('div', 'esg-qv__box');\n\n      var x = el('button', 'esg-qv__x', '\\u00D7');\n      x.type = 'button';\n      x.setAttribute('aria-label', 'Close quick view');\n      x.addEventListener('click', close);\n\n      box.appendChild(x);\n      root.appendChild(veil);\n      root.appendChild(box);\n      document.body.appendChild(root);\n\n      document.addEventListener('keydown', function (e) {\n        if (e.key === 'Escape' && root.classList.contains('is-open')) close();\n      });\n    }\n\n    function close() {\n      if (!root) return;\n      root.classList.remove('is-open');\n      document.documentElement.style.overflow = '';\n      if (lastFocus && lastFocus.focus) lastFocus.focus();\n    }\n\n    function clear() {\n      while (box.childNodes.length > 1) box.removeChild(box.lastChild);\n    }\n\n    function open(card) {\n      if (!root) build();\n      lastFocus = document.activeElement;\n      current = card;\n      clear();\n      box.appendChild(el('p', 'esg-qv__load', 'Loading\\u2026'));\n      root.classList.add('is-open');\n      document.documentElement.style.overflow = 'hidden';\n      box.querySelector('.esg-qv__x').focus();\n\n      var handle = card.getAttribute('data-esg-handle');\n      var url = card.getAttribute('data-product-url') || ('/products/' + handle);\n\n      fetch('/products/' + handle + '.js', { headers: { 'Accept': 'application/json' } })\n        .then(function (r) {\n          if (!r.ok) throw new Error(r.status);\n          return r.json();\n        })\n        .then(function (data) { render(data, card, url); })\n        .catch(function () {\n          clear();\n          box.appendChild(el('p', 'esg-qv__note',\n            'This item could not be loaded here. Open the full product page to continue.'));\n          var a = el('a', 'esg-qv__full', 'View full details');\n          a.href = url;\n          box.appendChild(a);\n        });\n    }\n\n    function render(data, card, url) {\n      clear();\n\n      var head = el('div', 'esg-qv__head');\n      var imgWrap = el('span', 'esg-qv__img');\n      if (data.featured_image) {\n        var img = document.createElement('img');\n        img.src = data.featured_image.replace(/(\\.[a-z]+)(\\?|$)/i, '_240x$1$2');\n        img.alt = data.title;\n        imgWrap.appendChild(img);\n      }\n      head.appendChild(imgWrap);\n\n      var info = el('div');\n      var ttl = el('a', 'esg-qv__ttl', data.title);\n      ttl.href = url;\n      info.appendChild(ttl);\n\n      var priceRow = el('div', 'esg-qv__price');\n      info.appendChild(priceRow);\n      head.appendChild(info);\n      box.appendChild(head);\n\n      var desc = card.getAttribute('data-esg-desc');\n      if (desc) box.appendChild(el('p', 'esg-qv__desc', desc));\n\n      /* Variant picker built from the product JSON rather than copied\n         page markup, so it never depends on theme custom elements. */\n      var sel = null;\n      var live = data.variants.filter(function (v) { return v.available; });\n\n      if (data.variants.length > 1) {\n        box.appendChild(el('span', 'esg-qv__lbl', optionLabel(data)));\n        sel = el('select', 'esg-qv__sel');\n        sel.setAttribute('aria-label', optionLabel(data));\n        data.variants.forEach(function (v) {\n          var o = document.createElement('option');\n          o.value = v.id;\n          o.textContent = v.title + ' \\u2014 ' + money(v.price) + (v.available ? '' : ' \\u2014 Sold out');\n          o.disabled = !v.available;\n          sel.appendChild(o);\n        });\n        if (live.length) sel.value = live[0].id;\n        box.appendChild(sel);\n      }\n\n      var btn = el('button', 'esg-qv__add', 'Add to cart');\n      btn.type = 'button';\n      box.appendChild(btn);\n\n      var note = el('p', 'esg-qv__note esg-qv__hide');\n      box.appendChild(note);\n\n      var full = el('a', 'esg-qv__full', 'View full details');\n      full.href = url;\n      box.appendChild(full);\n\n      function currentVariant() {\n        var id = sel ? parseInt(sel.value, 10) : (live.length ? live[0].id : data.variants[0].id);\n        for (var i = 0; i < data.variants.length; i++) {\n          if (data.variants[i].id === id) return data.variants[i];\n        }\n        return null;\n      }\n\n      function paint() {\n        var v = currentVariant();\n        priceRow.textContent = '';\n        if (!v) return;\n        priceRow.appendChild(el('span', 'esg-qv__now', money(v.price)));\n        if (v.compare_at_price && v.compare_at_price > v.price) {\n          priceRow.appendChild(el('span', 'esg-qv__was', money(v.compare_at_price)));\n          priceRow.appendChild(el('span', 'esg-qv__save',\n            'Save ' + money(v.compare_at_price - v.price).replace(/\\.00$/, '')));\n        }\n        if (v.available) {\n          btn.textContent = 'Add to cart';\n          btn.removeAttribute('disabled');\n        } else {\n          btn.textContent = 'Sold out';\n          btn.setAttribute('disabled', 'disabled');\n        }\n      }\n\n      if (sel) sel.addEventListener('change', paint);\n      paint();\n\n      btn.addEventListener('click', function () {\n        var v = currentVariant();\n        if (!v || !v.available) return;\n        btn.setAttribute('disabled', 'disabled');\n        btn.textContent = 'Adding\\u2026';\n        note.className = 'esg-qv__note esg-qv__hide';\n\n        fetch('/cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n          body: JSON.stringify({ items: [{ id: v.id, quantity: 1 }] })\n        })\n          .then(function (r) {\n            return r.json().then(function (j) { return { ok: r.ok, body: j }; });\n          })\n          .then(function (res) {\n            if (!res.ok) throw new Error(res.body.description || res.body.message || 'Not added');\n            btn.textContent = 'Added to cart';\n            note.className = 'esg-qv__note';\n            note.textContent = data.title + ' was added to the cart.';\n            refreshCart();\n            setTimeout(paint, 2500);\n          })\n          .catch(function (err) {\n            note.className = 'esg-qv__note';\n            note.textContent = String(err.message || err);\n            paint();\n          });\n      });\n    }\n\n    /* Update the header count and let the theme's cart drawer resync. */\n    function refreshCart() {\n      fetch('/cart.js', { headers: { 'Accept': 'application/json' } })\n        .then(function (r) { return r.json(); })\n        .then(function (cart) {\n          document.querySelectorAll('#CartCount, .js-cart-count').forEach(function (n) {\n            n.textContent = cart.item_count;\n          });\n          document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:refresh'));\n        })\n        .catch(function () {});\n    }\n\n    document.addEventListener('click', function (evt) {\n      if (!evt.target.closest) return;\n\n      var trigger = evt.target.closest('.esg-qv-open');\n      var card = trigger ? trigger.closest('.esg-acc-card') : null;\n\n      if (!trigger) {\n        card = evt.target.closest('.esg-acc-card');\n        if (!card) return;\n        /* let real links and buttons behave normally */\n        if (evt.target.closest('a, button')) return;\n      }\n      if (!card) return;\n      if (!card.getAttribute('data-esg-handle')) return;\n\n      evt.preventDefault();\n      open(card);\n    });\n  })();\n</script>\n\n{%- endif -%}"
          }
        },
