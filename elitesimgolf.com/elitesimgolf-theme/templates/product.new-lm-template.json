    "custom_liquid_xz3Bbp": {
      "type": "custom-liquid",
      "name": "Trust Strip",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Elite Sim Golf — Full-Width Trust Bar (Flat, Configurable)\n  ---------------------------------------------------------------\n  Default 4 items, in order:\n    1. Live Chat + Call/Text (combined)\n    2. Price Match Guarantee\n    3. Authorized {{ product.vendor }} Dealer\n    4. Financing Available\n\n  Available item slugs:\n    chat_call, price_match, authorized, financing,\n    shipping, guarantee, family_owned\n\n  \"guarantee\" only renders if product is tagged\n    30-day-guarantee / 30-day-trial / 30day / 30-day\n\n  Bar auto-flows based on item count: 1-5 items sit on one row;\n  6 items go 3x2 and 7 items go 4+3. All counts collapse to 2-up\n  under 1024px and 1-up under 600px.\n  Default: light. Add class \"esg-trust-bar--dark\" for navy variant.\n\n  STYLE: converted to the ESG navy system - navy #0A1A3A accents,\n  #E6E9F0 borders, square corners, own Barlow Condensed + Inter\n  links, no theme font inheritance. Matches the free-shipping,\n  projector-fitment, and shipping-status blocks.\n\n  HEIGHT: reduced 25% from the previous version. Measured 4-up\n  desktop 216px -> 162px. Sizes that drive height are grouped in\n  the \"height budget\" comments below - adjust those, not the\n  colors, if it needs to change again.\n{%- endcomment -%}\n\n{%- comment -%} ====== EDIT THIS LIST TO CHANGE ITEMS ====== {%- endcomment -%}\n{%- assign items = 'authorized,chat_call,price_match,financing' | split: ',' -%}\n\n{%- comment -%} 30-Day guarantee tag check {%- endcomment -%}\n{%- assign tags_dc = product.tags | join: '|' | downcase | split: '|' -%}\n{%- assign show_guarantee = false -%}\n{%- if tags_dc contains '30-day-guarantee' or tags_dc contains '30-day-trial' or tags_dc contains '30day' or tags_dc contains '30-day' -%}\n  {%- assign show_guarantee = true -%}\n{%- endif -%}\n\n{%- assign vendor_name = product.vendor | default: 'Top Brands' -%}\n\n{%- comment -%} Build active list, filtering guarantee when ineligible {%- endcomment -%}\n{%- assign active = '' -%}\n{%- for slug in items -%}\n  {%- assign s = slug | strip -%}\n  {%- if s == 'guarantee' and show_guarantee == false -%}{%- continue -%}{%- endif -%}\n  {%- if active == '' -%}\n    {%- assign active = s -%}\n  {%- else -%}\n    {%- assign active = active | append: ',' | append: s -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- assign active_items = active | split: ',' -%}\n{%- assign item_count = active_items.size -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<div class=\"esg-trust-bar esg-trust-bar--cols-{{ item_count }}\">\n  <div class=\"esg-trust-bar__accent\"></div>\n  <div class=\"esg-trust-bar__inner\">\n\n    {%- for slug in active_items -%}\n\n      {%- if slug == 'chat_call' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path>\n              <circle cx=\"9\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <circle cx=\"12.5\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <circle cx=\"16\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Golf Sim Pros</div>\n            <div class=\"esg-trust-bar__text\">Questions? Chat or call to speak with a real golf pro.</div>\n            <div class=\"esg-trust-bar__actions\">\n              <a href=\"/?chat\"\n                 class=\"esg-trust-bar__btn esg-trust-bar__btn--primary esg-trust-bar__chat-btn\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                Live Chat\n              </a>\n              <a href=\"tel:+18656571028\"\n                 class=\"esg-trust-bar__btn esg-trust-bar__btn--secondary\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg>\n                Call or Text 865-657-1028\n              </a>\n            </div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'price_match' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M20.59 13.41 11.17 22a2 2 0 0 1-2.83 0L2 15.66a2 2 0 0 1 0-2.83L11.41 3.41A2 2 0 0 1 12.83 3H20a2 2 0 0 1 2 2v7.17a2 2 0 0 1-.59 1.24z\"></path>\n              <circle cx=\"7.5\" cy=\"7.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <path d=\"m9 14 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Price Match Guarantee</div>\n            <div class=\"esg-trust-bar__text\">Find a lower price and we'll match or beat it — no questions asked.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'authorized' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z\"></path>\n              <path d=\"m9 12 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Authorized {{ vendor_name | escape }} Dealer</div>\n            <div class=\"esg-trust-bar__text\">Premier {{ vendor_name | escape }} partner with full warranty support.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'financing' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"></rect>\n              <line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"></line>\n              <line x1=\"6\" y1=\"15\" x2=\"10\" y2=\"15\"></line>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Financing Available</div>\n            <div class=\"esg-trust-bar__text\">Pay over time with Shop Pay, Affirm, or Klarna.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'shipping' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n              <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n              <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n              <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Fast &amp; Free Shipping</div>\n            <div class=\"esg-trust-bar__text\">Free expedited delivery on most orders (exclusions apply).</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'guarantee' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z\"></path>\n              <path d=\"m9 12 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">30-Day Risk-Free Guarantee</div>\n            <div class=\"esg-trust-bar__text\">Not happy? Send it back — no hassle.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'family_owned' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M3 11.5 12 4l9 7.5\"></path>\n              <path d=\"M5 10v10h14V10\"></path>\n              <path d=\"M12 20v-6\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Family-Owned, U.S. Based</div>\n            <div class=\"esg-trust-bar__text\">Real inventory, real people — not a dropshipper.</div>\n          </div>\n        </div>\n\n      {%- endif -%}\n\n    {%- endfor -%}\n\n  </div>\n</div>\n\n<script>\n(function () {\n  'use strict';\n  // Intercept clicks on /?chat links and open Shopify Inbox in-place when present.\n  // If the widget isn't loaded yet, the link falls through to navigation, which\n  // Shopify Inbox handles automatically on the next page load.\n  document.addEventListener('click', function (e) {\n    var a = e.target.closest && e.target.closest('a[href=\"/?chat\"]');\n    if (!a) return;\n    try {\n      var host = document.querySelector('inbox-online-store-chat');\n      var btn = host && host.shadowRoot && host.shadowRoot.querySelector('button.chat-toggle');\n      if (btn) {\n        e.preventDefault();\n        btn.click();\n      }\n    } catch (err) { /* fall back to default link navigation */ }\n  });\n})();\n</script>\n\n<style>\n  .esg-trust-bar {\n    position: relative;\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n    border-top: 1px solid #E6E9F0;\n    border-bottom: 1px solid #E6E9F0;\n    color: #2a3756;\n    font-family: 'Inter', system-ui, -apple-system, sans-serif;\n    line-height: 1.4;\n    overflow: hidden;\n  }\n\n  .esg-trust-bar__accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 3px;               /* height budget: was 5 */\n    background: #0A1A3A;\n    z-index: 1;\n  }\n\n  .esg-trust-bar__inner {\n    max-width: 1500px;\n    margin: 0 auto;\n    padding: 14px 32px;        /* height budget: was 28px vertical */\n    display: grid;\n    gap: 18px 28px;            /* height budget: row gap was 24 */\n    align-items: center;\n  }\n\n  .esg-trust-bar--cols-4 .esg-trust-bar__inner { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-3 .esg-trust-bar__inner { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-2 .esg-trust-bar__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-1 .esg-trust-bar__inner { grid-template-columns: 1fr; }\n  .esg-trust-bar--cols-5 .esg-trust-bar__inner { grid-template-columns: repeat(5, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-6 .esg-trust-bar__inner { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-7 .esg-trust-bar__inner { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n\n  .esg-trust-bar__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 8px;                  /* height budget: was 10 */\n    min-width: 0;\n    position: relative;\n    padding: 0 8px;\n  }\n\n  .esg-trust-bar__item + .esg-trust-bar__item::before {\n    content: '';\n    position: absolute;\n    left: -14px;\n    top: 6%;\n    bottom: 6%;\n    width: 1px;\n    background: #E6E9F0;\n  }\n\n  .esg-trust-bar__icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 46px;               /* height budget: was 64 */\n    height: 46px;\n    min-width: 46px;\n    border-radius: 0;\n    background: #ffffff;\n    color: #0A1A3A;\n    flex: 0 0 auto;\n    border: 1px solid #E6E9F0;\n  }\n\n  .esg-trust-bar__icon svg { width: 24px; height: 24px; display: block; }\n\n  .esg-trust-bar__content { min-width: 0; width: 100%; }\n\n  .esg-trust-bar__title {\n    color: #0A1A3A;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 17px;           /* height budget: was 18 */\n    font-weight: 800;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    line-height: 1.1;\n    margin-bottom: 2px;\n  }\n\n  .esg-trust-bar__text {\n    color: #2a3756;\n    font-size: 12.5px;         /* height budget: was 13.5 */\n    line-height: 1.35;         /* height budget: was 1.45 */\n  }\n\n  .esg-trust-bar__link {\n    color: #0A1A3A;\n    font-weight: 700;\n    text-decoration: none;\n    border-bottom: 1px solid #0A1A3A;\n    white-space: nowrap;\n    cursor: pointer;\n  }\n\n  .esg-trust-bar__link:hover { border-bottom-color: #0A1A3A; }\n\n  .esg-trust-bar__sep {\n    margin: 0 6px;\n    color: #6B7390;\n  }\n\n  /* ---------- Action buttons ---------- */\n  .esg-trust-bar__actions {\n    display: flex;\n    flex-wrap: nowrap;\n    justify-content: center;\n    gap: 5px;\n    margin-top: 5px;           /* height budget: was 6 */\n  }\n\n  .esg-trust-bar__btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    padding: 5px 9px;          /* height budget: was 6px vertical */\n    border-radius: 0;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 11.5px;\n    font-weight: 700;\n    letter-spacing: .05em;\n    text-transform: uppercase;\n    line-height: 1;\n    text-decoration: none;\n    border: 1px solid transparent;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: background-color .15s ease, color .15s ease, border-color .15s ease;\n  }\n  .esg-trust-bar__btn svg { width: 11px; height: 11px; display: block; flex: 0 0 auto; }\n\n  .esg-trust-bar__btn:focus-visible {\n    outline: 2px solid #0A1A3A;\n    outline-offset: 2px;\n    box-shadow: 0 0 0 4px rgba(10, 26, 58, .14);\n  }\n\n  .esg-trust-bar__btn--primary {\n    background: #0A1A3A;\n    color: #ffffff;\n    border-color: #0A1A3A;\n  }\n  .esg-trust-bar__btn--primary:hover {\n    background: #2a3756;\n    border-color: #2a3756;\n    color: #ffffff;\n  }\n\n  .esg-trust-bar__btn--secondary {\n    background: #ffffff;\n    color: #0A1A3A;\n    border-color: #0A1A3A;\n  }\n  .esg-trust-bar__btn--secondary:hover {\n    background: #F8F8F8;\n    border-color: #0A1A3A;\n    color: #0A1A3A;\n  }\n\n  /* ---------- Dark variant ---------- */\n  .esg-trust-bar--dark {\n    background: #0A1A3A;\n    border-top-color: rgba(255, 255, 255, .08);\n    border-bottom-color: rgba(255, 255, 255, .08);\n    color: #C9D6F2;\n  }\n  .esg-trust-bar--dark .esg-trust-bar__accent { background: #ffffff; }\n  .esg-trust-bar--dark .esg-trust-bar__icon {\n    background: rgba(255, 255, 255, .06);\n    color: #ffffff;\n    border-color: rgba(255, 255, 255, .14);\n  }\n  .esg-trust-bar--dark .esg-trust-bar__title { color: #ffffff; }\n  .esg-trust-bar--dark .esg-trust-bar__text { color: #C9D6F2; }\n  .esg-trust-bar--dark .esg-trust-bar__link {\n    color: #ffffff;\n    border-bottom-color: rgba(255, 255, 255, .35);\n  }\n  .esg-trust-bar--dark .esg-trust-bar__link:hover { border-bottom-color: #ffffff; }\n  .esg-trust-bar--dark .esg-trust-bar__sep { color: rgba(255, 255, 255, .35); }\n  .esg-trust-bar--dark .esg-trust-bar__btn--primary {\n    background: #0A1A3A; color: #ffffff; border-color: #0A1A3A;\n  }\n  .esg-trust-bar--dark .esg-trust-bar__btn--primary:hover {\n    background: #ffffff; color: #0A1A3A; border-color: #ffffff;\n  }\n  .esg-trust-bar--dark .esg-trust-bar__btn--secondary {\n    background: transparent; color: #ffffff;\n    border-color: rgba(255, 255, 255, .35);\n  }\n  .esg-trust-bar--dark .esg-trust-bar__btn--secondary:hover {\n    background: rgba(255, 255, 255, .08);\n    border-color: #ffffff; color: #ffffff;\n  }\n  .esg-trust-bar--dark .esg-trust-bar__item + .esg-trust-bar__item::before {\n    background: rgba(255, 255, 255, .14);\n  }\n\n  /* ---------- Breakpoints ---------- */\n  @media (max-width: 1024px) {\n    .esg-trust-bar--cols-7 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-6 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-5 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-4 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-3 .esg-trust-bar__inner {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 12px 24px;          /* height budget: row gap was 20 */\n      padding: 11px 24px;      /* height budget: was 22px vertical */\n    }\n    .esg-trust-bar__item + .esg-trust-bar__item::before { display: none; }\n  }\n\n  @media (max-width: 600px) {\n    .esg-trust-bar--cols-7 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-6 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-5 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-4 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-3 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-2 .esg-trust-bar__inner {\n      grid-template-columns: 1fr;\n      gap: 8px;                /* height budget: was 16 */\n      padding: 11px 18px;      /* height budget: was 18px vertical */\n    }\n    .esg-trust-bar__item { gap: 7px; }\n    .esg-trust-bar__icon { width: 38px; height: 38px; min-width: 38px; border-radius: 0; }\n    .esg-trust-bar__icon svg { width: 20px; height: 20px; }\n    .esg-trust-bar__title { font-size: 15.5px; }\n    .esg-trust-bar__text { font-size: 12.5px; }\n    .esg-trust-bar__actions { flex-wrap: wrap; margin-top: 4px; }\n    .esg-trust-bar__btn { font-size: 11.5px; padding: 6px 10px; }\n    .esg-trust-bar__btn svg { width: 11px; height: 11px; }\n  }\n</style>",
