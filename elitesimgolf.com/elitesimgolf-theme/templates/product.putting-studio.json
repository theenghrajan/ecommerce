ector('button[name=\"add\"]') ||\n      document.querySelector('button[type=\"submit\"][name=\"add\"]') ||\n      document.querySelector('form[action*=\"/cart/add\"] button[type=\"submit\"]');\n\n    if (!addToCartBtn) return;\n\n    addToCartBtn.disabled = !checkbox.checked;\n    addToCartBtn.style.opacity = checkbox.checked ? '1' : '.55';\n    addToCartBtn.style.cursor = checkbox.checked ? 'pointer' : 'not-allowed';\n  }\n\n  function initAck() {\n    var checkbox = document.getElementById('esgBigMossAckCheckbox');\n    if (!checkbox) return;\n\n    checkbox.addEventListener('change', setButtonState);\n    setButtonState();\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initAck);\n  } else {\n    initAck();\n  }\n})();\n</script>"
