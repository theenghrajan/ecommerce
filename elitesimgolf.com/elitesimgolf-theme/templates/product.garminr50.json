        "custom_liquid_cYF6gV": {
          "type": "custom-liquid",
          "name": "Live Inventory Algorithm",
          "settings": {
            "custom_liquid": "{%- assign total_on_hand = 0 -%}\n{%- assign saw_any_qty_field = false -%}\n\n{%- for v in product.variants -%}\n  {%- if v.inventory_quantity != blank -%}\n    {%- assign saw_any_qty_field = true -%}\n    {%- assign total_on_hand = total_on_hand | plus: v.inventory_quantity -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- assign incoming_qty = product.metafields.custom.incoming_po_qty | default: 0 -%}\n\n{%- assign show_incoming = false -%}\n{%- if saw_any_qty_field and total_on_hand <= 0 and incoming_qty > 0 -%}\n  {%- assign show_incoming = true -%}\n{%- endif -%}\n\n{%- assign show_box = false -%}\n{%- if saw_any_qty_field and total_on_hand > 0 -%}\n  {%- assign show_box = true -%}\n{%- elsif show_incoming -%}\n  {%- assign show_box = true -%}\n{%- endif -%}\n\n{%- if show_box -%}\n\n<div style=\"\n  margin:14px 0 0;\n  padding:14px 16px;\n  border-radius:16px;\n  border:2px solid #086ed3;\n  background:linear-gradient(180deg, #ffffff 0%, #f4f9ff 100%);\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  color:#0f172a;\n  display:flex;\n  align-items:flex-start;\n  gap:12px;\n  box-shadow:0 10px 24px rgba(0,0,0,.06);\n\">\n  <div style=\"\n    width:34px; height:34px; border-radius:12px;\n    background:#e7f2ff;\n    display:flex; align-items:center; justify-content:center;\n    font-size:18px; flex:0 0 auto;\n    border:1px solid rgba(8,110,211,.18);\n  \">📦</div>\n\n  <div style=\"line-height:1.25; flex:1;\">\n    <!-- Header row -->\n    <div style=\"\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap:10px;\n      margin:0 0 8px;\n    \">\n      <div style=\"font-weight:900; font-size:13px; letter-spacing:.02em;\">\n        Inventory Status\n      </div>\n\n      {%- if saw_any_qty_field and total_on_hand > 0 -%}\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          gap:8px;\n          padding:6px 10px;\n          border-radius:999px;\n          background:#086ed3;\n          color:#ffffff;\n          font-weight:900;\n          font-size:12px;\n          letter-spacing:.02em;\n          box-shadow:0 8px 18px rgba(8,110,211,.25);\n          white-space:nowrap;\n        \">✅ AVAILABLE</div>\n      {%- elsif show_incoming -%}\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          gap:8px;\n          padding:6px 10px;\n          border-radius:999px;\n          background:#0b2a55;\n          color:#ffffff;\n          font-weight:900;\n          font-size:12px;\n          letter-spacing:.02em;\n          box-shadow:0 8px 18px rgba(11,42,85,.20);\n          white-space:nowrap;\n        \">🚚 INCOMING</div>\n      {%- endif -%}\n    </div>\n\n    {%- if saw_any_qty_field and total_on_hand > 0 -%}\n      <!-- On-hand -->\n      <div style=\"\n        display:flex;\n        align-items:baseline;\n        justify-content:space-between;\n        gap:12px;\n        flex-wrap:wrap;\n        margin:0 0 10px;\n      \">\n        <div style=\"display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;\">\n          <div style=\"\n            font-weight:1000;\n            font-size:26px;\n            line-height:1;\n            color:#0b2a55;\n          \">{{ total_on_hand }}</div>\n\n          <div style=\"font-size:14px; font-weight:800; color:#1f2937;\">\n            ON-HAND (in building)\n          </div>\n        </div>\n\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          padding:4px 10px;\n          border-radius:999px;\n          background:#ffffff;\n          border:1px solid rgba(15,23,42,.10);\n          font-size:12px;\n          font-weight:900;\n          color:#0f172a;\n          white-space:nowrap;\n        \">\n          SHIPS SAME BUSINESS DAY FROM OUR WAREHOUSE\n        </div>\n      </div>\n\n      <div style=\"\n        font-size:12.5px;\n        color:#334155;\n        background:#ffffff;\n        border:1px solid rgba(15,23,42,.10);\n        border-radius:12px;\n        padding:10px 12px;\n      \">\n        <div style=\"margin:0;\">\n          This is <span style=\"color:#086ed3; font-weight:900;\">real inventory in our building</span> and ships the <span style=\"font-weight:900;\">same business day if ordered by noon</span> (most days) unless we are experiencing heavier than normal order volumes.\n        </div>\n      </div>\n    {%- endif -%}\n\n    {%- if show_incoming -%}\n      <!-- Divider -->\n      <div style=\"margin:12px 0 10px; height:1px; background:rgba(8,110,211,.18);\"></div>\n\n      <!-- Incoming -->\n      <div style=\"\n        display:flex;\n        align-items:flex-start;\n        justify-content:space-between;\n        gap:12px;\n        flex-wrap:wrap;\n        padding:10px 12px;\n        border-radius:12px;\n        border:1px dashed rgba(8,110,211,.35);\n        background:#ffffff;\n      \">\n        <div style=\"min-width:220px;\">\n          <div style=\"font-weight:900; font-size:12px; color:#0f172a; letter-spacing:.02em; text-transform:uppercase;\">\n            Quantity in Production\n          </div>\n          <div style=\"font-size:12.5px; color:#475569; margin-top:2px;\">\n            Incoming on open purchase orders (auto-updates as POs change)\n          </div>\n          <div style=\"font-size:12.5px; color:#0f172a; margin-top:6px; font-weight:900;\">\n            Typical lead time: <span style=\"color:#086ed3;\">2–3 weeks</span>\n          </div>\n        </div>\n\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          gap:8px;\n          padding:6px 10px;\n          border-radius:999px;\n          background:#f1f5f9;\n          border:1px solid rgba(15,23,42,.12);\n          font-weight:1000;\n          font-size:13px;\n          color:#0f172a;\n          white-space:nowrap;\n        \">\n          🚚 <span style=\"color:#086ed3;\">{{ incoming_qty }}</span> incoming\n        </div>\n      </div>\n    {%- endif -%}\n\n  </div>\n</div>\n\n{%- endif -%}"
          }
