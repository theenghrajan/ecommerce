24px;      /* height budget: was 22px vertical */\n    }\n    .esg-trust-bar__item + .esg-trust-bar__item::before { display: none; }\n  }\n\n  @media (max-width: 600px) {\n    .esg-trust-bar--cols-7 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-6 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-5 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-4 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-3 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-2 .esg-trust-bar__inner {\n      grid-template-columns: 1fr;\n      gap: 8px;                /* height budget: was 16 */\n      padding: 11px 18px;      /* height budget: was 18px vertical */\n    }\n    .esg-trust-bar__item { gap: 7px; }\n    .esg-trust-bar__icon { width: 38px; height: 38px; min-width: 38px; border-radius: 0; }\n    .esg-trust-bar__icon svg { width: 20px; height: 20px; }\n    .esg-trust-bar__title { font-size: 15.5px; }\n    .esg-trust-bar__text { font-size: 12.5px; }\n    .esg-trust-bar__actions { flex-wrap: wrap; margin-top: 4px; }\n    .esg-trust-bar__btn { font-size: 11.5px; padding: 6px 10px; }\n    .esg-trust-bar__btn svg { width: 11px; height: 11px; }\n  }\n</style>",
