        "custom_liquid_FKVhxB": {
          "type": "custom-liquid",
          "name": "Garmin R50 Block",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  ESG GARMIN R50 SHIPPING BOX (restyled + weekend-aware)\n  Trigger: product tagged 'garmin r50' (case-insensitive, also matches garmin-r50)\n  Behavior:\n    - Mon–Fri before 2:00 PM ET → live \"Order within HH Hrs MM Mins\"\n    - Mon–Fri after 2:00 PM ET → \"Ships <Next Business Day, Mon Day>\"\n    - Sat/Sun → \"Ships <Monday, Mon Day>\"\n    - All states explicitly mention UPS 2nd Day Air\n  Design language:\n    - Barlow Condensed eyebrow + title (uppercase, navy)\n    - #086ED3 blue, #0A1A3A navy, #2a3756 body\n    - 16px radius, 3px gradient top accent\n    - White-chip icon, ESG pill badge\n{%- endcomment -%}\n\n{%- assign has_garmin_r50_tag = false -%}\n{%- for tag in product.tags -%}\n  {%- assign normalized_tag = tag | strip | downcase -%}\n  {%- if normalized_tag == 'garmin r50' or normalized_tag == 'garmin-r50' or normalized_tag == 'garmin_r50' -%}\n    {%- assign has_garmin_r50_tag = true -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- if has_garmin_r50_tag -%}\n<div class=\"esg-r50\">\n  <div class=\"esg-r50__accent\"></div>\n\n  <div class=\"esg-r50__head\">\n    <div class=\"esg-r50__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n        <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n        <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n      </svg>\n    </div>\n    <div class=\"esg-r50__head-text\">\n      <div class=\"esg-r50__eyebrow\">UPS 2nd Day Air · 30-Day Returns</div>\n      <h3 class=\"esg-r50__title\">Free 2-Day Shipping on the Garmin R50</h3>\n    </div>\n  </div>\n\n  <div class=\"esg-r50__text\" id=\"esg-r50-copy\">\n    Order your <strong>Garmin Approach R50</strong> by 2:00 PM ET for same-day shipping via UPS 2nd Day Air.\n  </div>\n\n  <div class=\"esg-r50__timer\">\n    <span id=\"esg-r50-label\" class=\"esg-r50__timer-label\">Order within</span>\n    <span id=\"esg-r50-countdown\" class=\"esg-r50__badge\">— Hrs — Mins</span>\n  </div>\n</div>\n\n<style>\n  .esg-r50 {\n    max-width: 1100px;\n    margin: 14px 0;\n    position: relative;\n    overflow: hidden;\n    padding: 13px 16px 14px;\n    border: 1px solid #e5e7eb;\n    border-radius: 16px;\n    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);\n    box-shadow: 0 8px 20px rgba(15, 23, 42, .05);\n    color: #2a3756;\n    font-family: inherit;\n    line-height: 1.4;\n  }\n  .esg-r50__accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 3px;\n    background: linear-gradient(90deg, #086ED3 0%, #0A1A3A 100%);\n  }\n\n  .esg-r50__head {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    margin-bottom: 8px;\n  }\n  .esg-r50__icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 38px;\n    height: 38px;\n    min-width: 38px;\n    border-radius: 10px;\n    background: #ffffff;\n    color: #086ED3;\n    border: 1px solid rgba(8, 110, 211, .18);\n    box-shadow: 0 2px 6px rgba(8, 110, 211, .08);\n    flex: 0 0 auto;\n    margin-top: 1px;\n  }\n  .esg-r50__icon svg { width: 20px; height: 20px; display: block; }\n\n  .esg-r50__head-text { min-width: 0; }\n  .esg-r50__eyebrow {\n    color: #086ED3;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    line-height: 1;\n    margin-bottom: 4px;\n  }\n  .esg-r50__title {\n    margin: 0;\n    color: #0A1A3A;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 17px;\n    font-weight: 800;\n    letter-spacing: .02em;\n    text-transform: uppercase;\n    line-height: 1.1;\n  }\n\n  .esg-r50__text {\n    font-size: 13px;\n    color: #2a3756;\n    line-height: 1.45;\n    margin-bottom: 10px;\n  }\n  .esg-r50__text strong { color: #0A1A3A; font-weight: 700; }\n\n  .esg-r50__timer {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .esg-r50__timer-label {\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: #086ED3;\n    line-height: 1;\n  }\n  .esg-r50__badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 6px 12px;\n    border-radius: 999px;\n    background: #0A1A3A;\n    border: 1px solid #0A1A3A;\n    color: #ffffff;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    line-height: 1;\n    font-variant-numeric: tabular-nums;\n    white-space: nowrap;\n  }\n\n  @media (max-width: 749px) {\n    .esg-r50 { padding: 12px 14px 13px; border-radius: 14px; }\n    .esg-r50__title { font-size: 15.5px; }\n    .esg-r50__text { font-size: 12.5px; }\n    .esg-r50__badge { font-size: 12px; padding: 6px 11px; }\n  }\n</style>\n\n<script>\n(function () {\n  var labelEl = document.getElementById('esg-r50-label');\n  var badgeEl = document.getElementById('esg-r50-countdown');\n  var copyEl  = document.getElementById('esg-r50-copy');\n  if (!labelEl || !badgeEl || !copyEl) return;\n\n  function pad(n) { return String(n).padStart(2, '0'); }\n\n  function getETParts(d) {\n    var out = {};\n    new Intl.DateTimeFormat('en-US', {\n      timeZone: 'America/New_York',\n      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false\n    }).formatToParts(d).forEach(function (p) { out[p.type] = p.value; });\n    return out;\n  }\n  function getETDow(d) {\n    var wk = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short' }).format(d);\n    return ({ Sun:0, Mon:1, Tue:2, Wed:3, Thu:4, Fri:5, Sat:6 })[wk];\n  }\n  function formatET(d, opts) {\n    return new Intl.DateTimeFormat('en-US', Object.assign({ timeZone: 'America/New_York' }, opts)).format(d);\n  }\n  function nextBusinessDay(from) {\n    for (var i = 1; i <= 7; i++) {\n      var d = new Date(from.getTime() + i * 86400000);\n      var dow = getETDow(d);\n      if (dow !== 0 && dow !== 6) return d;\n    }\n    return null;\n  }\n\n  function update() {\n    var now = new Date();\n    var p = getETParts(now);\n    var dow = getETDow(now);\n    var nowSec = parseInt(p.hour, 10) * 3600 + parseInt(p.minute, 10) * 60 + parseInt(p.second, 10);\n    var cutoffSec = 14 * 3600; // 2:00 PM ET\n    var isWeekend = (dow === 0 || dow === 6);\n    var pastCutoff = nowSec >= cutoffSec;\n\n    if (isWeekend || pastCutoff) {\n      var nb = nextBusinessDay(now);\n      var weekdayShort = nb ? formatET(nb, { weekday: 'short' }) : '';\n      var weekdayLong  = nb ? formatET(nb, { weekday: 'long' })  : '';\n      var dateLong     = nb ? formatET(nb, { month: 'long', day: 'numeric' })  : '';\n      var dateShort    = nb ? formatET(nb, { month: 'short', day: 'numeric' }) : '';\n\n      labelEl.textContent = 'Ships';\n      badgeEl.textContent = (weekdayShort + ' · ' + dateShort).toUpperCase();\n      copyEl.innerHTML = 'Your <strong>Garmin Approach R50</strong> ships <strong>' +\n        weekdayLong + (dateLong ? ', ' + dateLong : '') +\n        '</strong> via UPS 2nd Day Air.';\n      return;\n    }\n\n    // Live countdown to 2 PM ET\n    var remaining = cutoffSec - nowSec;\n    var hrs = Math.floor(remaining / 3600);\n    var mins = Math.floor((remaining % 3600) / 60);\n    labelEl.textContent = 'Order within';\n    badgeEl.textContent = hrs + ' HRS ' + pad(mins) + ' MINS';\n    copyEl.innerHTML = 'Order your <strong>Garmin Approach R50</strong> by <strong>2:00 PM ET</strong> for same-day shipping via UPS 2nd Day Air.';\n  }\n\n  update();\n  // Update every 30s — fine-grained enough for hour/minute display, light on CPU\n  setInterval(update, 30000);\n})();\n</script>\n{%- endif -%}"
          }
        },
        "custom_liquid_dtnQBp": {
          "type": "custom-liquid",
          "name": "Shipping/Stock Notification",
          "settings": {
            "custom_liquid": "{%- comment -%}\n============================================================\n  ESG FREE SHIPPING BOX — tag driven\n  Paste target: Custom Liquid block on the product template\n  (or snippets/esg-shipping-box.liquid + a render tag)\n\n  TRIGGER TAGS (case insensitive, - _ and : tolerated)\n    freeshipping:nda    -> Free Next Day Air  / UPS Next Day Air\n    freeshipping:2day   -> Free 2-Day Air     / UPS 2nd Day Air\n    If both are present, nda wins.\n    If neither is present, nothing renders.\n\n  PRODUCT NAME\n    shipname:<value> tag  ->  product.title\n    The tag wins so the box can read \"Garmin Approach R50\"\n    while the Shopify title stays SEO-loaded, e.g.\n    \"Garmin Approach R50 Portable Golf Launch Monitor\".\n    Colons in the display name are supported: the tag is split\n    on the FIRST colon only.\n\n  MINIMUM QUANTITY ON HAND  (opt-in)\n    shipmin:2   -> only show the box when the SELECTED variant\n                   has 2 or more units on hand.\n    shipmin     -> bare tag, threshold defaults to 2.\n    shipmin:5   -> any threshold works.\n    shipqty:<n> -> accepted as an alias.\n\n    Without one of these tags there is no inventory gate and\n    the box behaves exactly as before.\n\n    The gate is per VARIANT, not per product. A product-level\n    sum is wrong here for two reasons seen in this catalog:\n    multi-variant products hide sold-out sizes behind an\n    in-stock total, and oversold variants (-3, -4) cancel out\n    positive ones. Each variant is evaluated on its own count.\n\n    Variants with inventory tracking turned off are treated as\n    unlimited and always pass the gate, because Shopify has no\n    count to compare.\n\n    Oversold variants (negative inventory_quantity) fail the\n    gate. That is the point: a next-day-air promise should not\n    render when the unit is not on the shelf.\n\n    If NO variant meets the threshold, the block outputs\n    nothing at all - no markup, no CSS, no JS.\n\n  IN STOCK HIGHLIGHT\n    When a shipmin / shipqty tag is present AND the selected\n    variant clears the threshold, the box also carries an\n    IN STOCK pill plus a NO DROP SHIPPING note in the meta\n    line. Both strings are config variables below\n    (stock_label / stock_note) so the wording is a one-line\n    change. Without the tag neither element renders, so\n    nothing changes on products that do not opt in.\n\n    The pill is green with a pulsing dot. This is an\n    intentional exception to the navy / white / gray palette,\n    approved for this element only, because the in-stock\n    state is the one place on the page where a status colour\n    carries meaning. Everything else stays navy.\n\n    Green tokens live in the CSS custom properties on\n    .esg-fship (--esg-stock-fg / --esg-stock-bg /\n    --esg-stock-dot) so the shade is a one-line change.\n\n    The dot is circular, unlike every other element here: a\n    pulsing square reads as a rendering fault. The pill\n    corners stay square.\n\n    The pulse is disabled automatically under\n    prefers-reduced-motion, and it animates opacity and\n    transform only, so it does not force layout work on\n    long product pages.\n\n    Note that a variant with inventory tracking turned off\n    passes the gate and therefore shows IN STOCK, because\n    Shopify exposes no count to contradict it. Only tag\n    products whose counts are actually maintained.\n\n  CUTOFF\n    cutoff_hour below is 24h ET. 14 = 2:00 PM ET.\n    cutoff_hour and cutoff_text must be changed together.\n\n  BEHAVIOR\n    Mon-Fri before cutoff -> live \"Order within HH Hrs MM Mins\"\n    Mon-Fri after cutoff  -> \"Ships <next business day>\"\n    Sat / Sun             -> \"Ships <Monday>\"\n    All states name the UPS service level.\n\n  Holidays are NOT handled. A UPS holiday falling on a weekday\n  will still read as a ship day.\n\n  Styling matches the accessories section: navy #0A1A3A, no\n  gradients, no radius, 1px #E6E9F0 border with a 3px navy top\n  accent, Barlow Condensed headings, Inter body.\n============================================================\n{%- endcomment -%}\n\n{%- liquid\n  assign cutoff_hour = 14\n  assign cutoff_text = '2:00 PM ET'\n  assign default_min = 2\n  assign untracked_qty = 999999\n\n  # in-stock highlight copy, shown only when the min-qty tag is used\n  assign stock_label = 'In Stock'\n  assign stock_note = 'No Drop Shipping'\n\n  # ---- trigger + display name + min qty from tags ----------\n  assign svc_key = ''\n  assign name_tag = ''\n  assign gate_on = false\n  assign min_qty = 0\n\n  for tag in product.tags\n    assign t = tag | strip | downcase | replace: '_', ':' | replace: '-', ':'\n\n    if t == 'freeshipping:nda' or t == 'freeshipping:next:day' or t == 'freeshipping:nextday'\n      assign svc_key = 'nda'\n    endif\n\n    if t == 'freeshipping:2day' or t == 'freeshipping:2:day' or t == 'freeshipping:two:day'\n      if svc_key == ''\n        assign svc_key = '2day'\n      endif\n    endif\n\n    # shipmin / shipqty -> minimum quantity on hand gate.\n    # t is already normalised, so shipmin:2 shipmin-2 shipmin_2 all match.\n    assign mparts = t | split: ':'\n    assign mhead = mparts[0] | default: ''\n    if mhead == 'shipmin' or mhead == 'shipqty'\n      assign gate_on = true\n      assign mval = mparts[1] | default: ''\n      if mval == ''\n        assign min_qty = default_min\n      else\n        assign min_qty = mval | plus: 0\n      endif\n      # non-numeric or nonsense value falls back to the default\n      if min_qty < 1\n        assign min_qty = default_min\n      endif\n    endif\n\n    # shipname: keeps its original casing, so test the raw tag\n    assign raw = tag | strip\n    assign probe = raw | downcase\n    if probe contains 'shipname:'\n      # size comes off the UNSTRIPPED first segment so the slice index\n      # stays aligned with the raw string, e.g. 'shipname :Foo'\n      assign seg0 = raw | split: ':' | first\n      assign head = seg0 | strip | downcase\n      if head == 'shipname'\n        assign cut = seg0 | size | plus: 1\n        assign name_tag = raw | slice: cut, 255 | strip\n      endif\n    endif\n  endfor\n\n  # ---- per-variant inventory map ---------------------------\n  # Emitted as id:qty pairs and read by JS on variant change.\n  # Never summed: see the note in the header comment.\n  assign sel_id = product.selected_or_first_available_variant.id | default: ''\n  assign inv_map = ''\n  assign max_qty = 0\n  assign sel_qty = 0\n  assign have_sel = false\n\n  for v in product.variants\n    assign im = v.inventory_management | default: ''\n    if im == ''\n      assign q = untracked_qty\n    else\n      assign q = v.inventory_quantity | plus: 0\n    endif\n\n    assign inv_map = inv_map | append: v.id | append: ':' | append: q | append: ','\n\n    if q > max_qty\n      assign max_qty = q\n    endif\n\n    assign vid = v.id | append: ''\n    assign sid = sel_id | append: ''\n    if vid == sid\n      assign sel_qty = q\n      assign have_sel = true\n    endif\n  endfor\n\n  # no selected variant resolved -> fall back to the best count\n  # so a working box is never withheld on a technicality\n  unless have_sel\n    assign sel_qty = max_qty\n  endunless\n\n  # ---- gate outcomes --------------------------------------\n  assign any_pass = true\n  assign show_initial = true\n  if gate_on\n    if max_qty < min_qty\n      assign any_pass = false\n    endif\n    if sel_qty < min_qty\n      assign show_initial = false\n    endif\n  endif\n\n  # ---- service level copy ---------------------------------\n  if svc_key == 'nda'\n    assign headline = 'Free Next Day Air'\n    assign service = 'UPS Next Day Air'\n    assign arrival = 'arriving the next business day'\n  elsif svc_key == '2day'\n    assign headline = 'Free UPS 2-Day Air'\n    assign service = 'UPS 2nd Day Air'\n    assign arrival = 'arriving within two business days'\n  endif\n\n  # ---- display name: tag override, then product title -----\n  assign disp = name_tag | default: ''\n  if disp == ''\n    assign disp = product.title\n  endif\n-%}\n\n{%- if svc_key != '' and any_pass -%}\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<div class=\"esg-fship\"\n     data-esg-fship\n     data-esg-name=\"{{ disp | escape }}\"\n     data-esg-service=\"{{ service | escape }}\"\n     data-esg-arrival=\"{{ arrival | escape }}\"\n     data-esg-cutoff=\"{{ cutoff_hour }}\"\n     data-esg-cutoff-text=\"{{ cutoff_text | escape }}\"\n     data-esg-min=\"{{ min_qty }}\"\n     data-esg-inv=\"{{ inv_map }}\"\n     {% unless show_initial %}hidden{% endunless %}>\n  <span class=\"esg-fship__icon\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n      <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n      <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n      <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n    </svg>\n  </span>\n\n  <span class=\"esg-fship__body\">\n    <span class=\"esg-fship__ttlrow\">\n      <span class=\"esg-fship__title\">{{ headline }}</span>\n      {%- if gate_on -%}\n      <span class=\"esg-fship__stock\" data-esg-stock>\n        <span class=\"esg-fship__dot\" aria-hidden=\"true\"></span>{{ stock_label }}\n      </span>\n      {%- endif -%}\n      <span class=\"esg-fship__svc\">{{ service }}{% if gate_on %} · {{ stock_note }}{% endif %}</span>\n    </span>\n    <span class=\"esg-fship__text\" data-esg-copy>Order your <strong>{{ disp }}</strong> by <strong>{{ cutoff_text }}</strong> to ship today.</span>\n  </span>\n\n  <span class=\"esg-fship__timer\">\n    <span class=\"esg-fship__lbl\" data-esg-lbl>Order within</span>\n    <span class=\"esg-fship__badge\" data-esg-badge>— HRS — MINS</span>\n  </span>\n</div>\n\n<style>\n  .esg-fship{box-sizing:border-box;display:flex;align-items:center;gap:12px;max-width:660px;margin:12px 0;padding:10px 13px;background:#fff;border:1px solid #E6E9F0;border-top:3px solid #0A1A3A;color:#2a3756;font-family:'Inter',system-ui,-apple-system,sans-serif;--esg-stock-fg:#0E7A3C;--esg-stock-bg:#F1F9F4;--esg-stock-dot:#16A34A}\n  /* The UA sheet's [hidden]{display:none} loses to .esg-fship{display:flex},\n     so the hidden state needs an explicit author rule or the gate does nothing. */\n  .esg-fship[hidden]{display:none}\n  .esg-fship *{box-sizing:border-box}\n  .esg-fship__icon{flex:0 0 32px;width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1px solid #E6E9F0;color:#0A1A3A}\n  .esg-fship__icon svg{width:18px;height:18px;display:block}\n  .esg-fship__body{flex:1 1 220px;min-width:0}\n  .esg-fship__ttlrow{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}\n  .esg-fship__title{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:17px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;color:#0A1A3A;line-height:1.05}\n  .esg-fship__svc{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#6B7390;line-height:1.1}\n  .esg-fship__stock{display:inline-flex;align-items:center;gap:6px;padding:3px 8px 2px;background:var(--esg-stock-bg);border:1px solid var(--esg-stock-fg);color:var(--esg-stock-fg);font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;line-height:1;white-space:nowrap}\n  /* Circular on purpose: a pulsing square reads as a rendering fault.\n     The pill corners stay square like every other ESG element. */\n  .esg-fship__dot{position:relative;flex:0 0 7px;width:7px;height:7px;border-radius:50%;background:var(--esg-stock-dot);display:block}\n  /* The ring is a pseudo element so the pulse never affects layout. */\n  .esg-fship__dot::after{content:'';position:absolute;top:50%;left:50%;width:7px;height:7px;margin:-3.5px 0 0 -3.5px;border-radius:50%;background:var(--esg-stock-dot);opacity:.55;animation:esgFshipPulse 2s cubic-bezier(.22,.61,.36,1) infinite}\n  @keyframes esgFshipPulse{0%{transform:scale(1);opacity:.55}70%{transform:scale(3.2);opacity:0}100%{transform:scale(3.2);opacity:0}}\n  @media (prefers-reduced-motion:reduce){.esg-fship__dot::after{animation:none;opacity:0}}\n  .esg-fship__text{display:block;font-size:12.5px;line-height:1.35;color:#2a3756;margin:3px 0 0}\n  .esg-fship__text strong{color:#0A1A3A;font-weight:700}\n  .esg-fship__timer{flex:0 0 auto;display:flex;align-items:center;gap:8px}\n  .esg-fship__lbl{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#6B7390;line-height:1;white-space:nowrap}\n  .esg-fship__badge{display:inline-flex;align-items:center;justify-content:center;padding:6px 10px 5px;background:#0A1A3A;border:1px solid #0A1A3A;border-radius:0;color:#fff;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n  @media (max-width:749px){\n    .esg-fship{flex-wrap:wrap;gap:10px;padding:10px 12px}\n    .esg-fship__title{font-size:16px}\n    .esg-fship__text{font-size:12px}\n    .esg-fship__timer{width:100%;padding-left:45px}\n    .esg-fship__badge{font-size:12px}\n  }\n</style>\n\n<script>\n(function () {\n  if (window.esgFreeShip) { return; }\n  window.esgFreeShip = true;\n\n  var DOW = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };\n\n  function pad(n) { return String(n).padStart(2, '0'); }\n\n  function etFmt(d, opts) {\n    var o = { timeZone: 'America/New_York' };\n    for (var k in opts) { if (Object.prototype.hasOwnProperty.call(opts, k)) { o[k] = opts[k]; } }\n    return new Intl.DateTimeFormat('en-US', o).format(d);\n  }\n\n  function etSeconds(d) {\n    var out = {};\n    new Intl.DateTimeFormat('en-US', {\n      timeZone: 'America/New_York',\n      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false\n    }).formatToParts(d).forEach(function (p) { out[p.type] = p.value; });\n    // Intl can emit hour 24 at midnight\n    var h = parseInt(out.hour, 10) % 24;\n    return h * 3600 + parseInt(out.minute, 10) * 60 + parseInt(out.second, 10);\n  }\n\n  function etDow(d) { return DOW[etFmt(d, { weekday: 'short' })]; }\n\n  function nextBusinessDay(from) {\n    for (var i = 1; i <= 7; i++) {\n      var d = new Date(from.getTime() + i * 86400000);\n      var dow = etDow(d);\n      if (dow !== 0 && dow !== 6) { return d; }\n    }\n    return null;\n  }\n\n  // ---- minimum quantity on hand gate ----------------------\n\n  function invMap(root) {\n    var map = {};\n    var raw = root.getAttribute('data-esg-inv') || '';\n    raw.split(',').forEach(function (pair) {\n      if (!pair) { return; }\n      var bits = pair.split(':');\n      if (bits.length < 2) { return; }\n      var q = parseInt(bits[1], 10);\n      if (!isNaN(q)) { map[bits[0]] = q; }\n    });\n    return map;\n  }\n\n  // Read the variant the customer is actually looking at.\n  // URL wins because that is what Shopify itself treats as canonical.\n  function currentVariantId() {\n    var m = window.location.search.match(/[?&]variant=(\\d+)/);\n    if (m) { return m[1]; }\n    var form = document.querySelector('form[action*=\"/cart/add\"]');\n    if (form) {\n      var field = form.querySelector('input[name=\"id\"], select[name=\"id\"]');\n      if (field && field.value) { return String(field.value); }\n    }\n    return null;\n  }\n\n  // true  -> show, false -> hide, null -> cannot tell, leave as rendered.\n  // Returning null matters: Liquid already resolved the correct state for the\n  // selected variant server side, so an unidentifiable variant must not clobber it.\n  function gatePasses(root) {\n    var min = parseInt(root.getAttribute('data-esg-min'), 10);\n    if (isNaN(min) || min < 1) { return true; }\n    var id = currentVariantId();\n    if (!id) { return null; }\n    var q = invMap(root)[id];\n    if (q === undefined) { return null; }\n    return q >= min;\n  }\n\n  // Build the sentence as DOM nodes so a product name never gets\n  // interpreted as markup.\n  function setCopy(el, parts) {\n    while (el.firstChild) { el.removeChild(el.firstChild); }\n    parts.forEach(function (part) {\n      if (typeof part === 'string') {\n        el.appendChild(document.createTextNode(part));\n        return;\n      }\n      var b = document.createElement('strong');\n      b.textContent = part.b;\n      el.appendChild(b);\n    });\n  }\n\n  function paint(root) {\n    var pass = gatePasses(root);\n    if (pass === true) { root.removeAttribute('hidden'); }\n    if (pass === false) { root.setAttribute('hidden', ''); return; }\n\n    var lbl = root.querySelector('[data-esg-lbl]');\n    var badge = root.querySelector('[data-esg-badge]');\n    var copy = root.querySelector('[data-esg-copy]');\n    if (!lbl || !badge || !copy) { return; }\n\n    var name = root.getAttribute('data-esg-name') || 'this item';\n    var arrival = root.getAttribute('data-esg-arrival') || '';\n    var cutTxt = root.getAttribute('data-esg-cutoff-text') || '2:00 PM ET';\n    var cutH = parseInt(root.getAttribute('data-esg-cutoff'), 10);\n    if (isNaN(cutH)) { cutH = 14; }\n\n    var now = new Date();\n    var dow = etDow(now);\n    var nowSec = etSeconds(now);\n    var cutSec = cutH * 3600;\n    var weekend = (dow === 0 || dow === 6);\n\n    if (weekend || nowSec >= cutSec) {\n      var nb = nextBusinessDay(now);\n      var dayLong = nb ? etFmt(nb, { weekday: 'long' }) : '';\n      var dateLong = nb ? etFmt(nb, { month: 'long', day: 'numeric' }) : '';\n      var dayShort = nb ? etFmt(nb, { weekday: 'short' }) : '';\n      var dateShort = nb ? etFmt(nb, { month: 'short', day: 'numeric' }) : '';\n\n      lbl.textContent = 'Ships';\n      badge.textContent = (dayShort + ' · ' + dateShort).toUpperCase();\n      setCopy(copy, [\n        'The ', { b: name }, ' ships ',\n        { b: dayLong + (dateLong ? ', ' + dateLong : '') }, '.'\n      ]);\n      return;\n    }\n\n    var left = cutSec - nowSec;\n    var hrs = Math.floor(left / 3600);\n    var mins = Math.floor((left % 3600) / 60);\n\n    lbl.textContent = 'Order within';\n    badge.textContent = hrs + ' HRS ' + pad(mins) + ' MINS';\n    setCopy(copy, [\n      'Order your ', { b: name }, ' by ', { b: cutTxt }, ' to ship today.'\n    ]);\n  }\n\n  function tick() {\n    var nodes = document.querySelectorAll('[data-esg-fship]');\n    for (var i = 0; i < nodes.length; i++) { paint(nodes[i]); }\n  }\n\n  // Variant pickers differ per theme and some do not fire a native change\n  // event, so the id is also polled. Polling only compares a string and\n  // repaints on an actual change.\n  var lastId = null;\n  function watchVariant() {\n    var id = currentVariantId();\n    if (id !== lastId) { lastId = id; tick(); }\n  }\n\n  tick();\n  lastId = currentVariantId();\n  setInterval(tick, 30000);\n  setInterval(watchVariant, 1000);\n  document.addEventListener('change', watchVariant);\n  window.addEventListener('popstate', watchVariant);\n  document.addEventListener('DOMContentLoaded', tick);\n  document.addEventListener('shopify:section:load', tick);\n})();\n</script>\n{%- endif -%}"
          }
        },
        "custom_liquid_NQH4XB": {
          "type": "custom-liquid",
          "name": "ProTeeVX Swing Cameras",
          "settings": {
            "custom_liquid": "<!-- ============================================================\n     PROTEE VX — SWING CAMERA SET \"INCLUDED\" PROMO MODULE\n     ESG NAVY VERSION (no gold accents)\n\n     SELF-CONTAINED. Paste anywhere on any ProTee VX page\n     (standalone PDP, Premium 4K package pages, projector-combo\n     PDPs). No parent wrapper required.\n\n     LAYOUT: fixed 100x100 product thumbnail + copy, always a slim\n     horizontal strip (no stacking breakpoint) -- sized to sit\n     directly below the shipping/availability blocks without\n     dominating the page the way a full-width hero image would.\n\n     All classes namespaced .esg-vxpromo* so they cannot collide\n     with theme CSS or other ESG modules on the same page.\n\n     Recreates the reference \"Included\" strip (logo · checkmark ·\n     headline · copy) in the navy/light-gray system instead of\n     white/green. No countdown timer -- the \"Cameras Included\" badge\n     sits static on the left of the top strip. The right side of that\n     same strip now carries the ProTee \"Authorized Reseller\" logo\n     image instead of a text wordmark -- the \"ProTee VX Swing Camera\n     Set\" name is not printed anywhere in the top strip; it is\n     introduced once, in the body copy below, so the name only\n     appears a single time in the whole module.\n\n     TAG GATE: this block only renders on products tagged \"ProTee VX\"\n     (case-insensitive, exact tag match). Because Shopify's product\n     description field cannot run Liquid, the gate is done in JS: on\n     load it reads the current product's tags from the storefront's\n     public /products/<handle>.js endpoint (same endpoint the ESG\n     accessories block already uses) and only reveals the wrapper if\n     a matching tag is present. The wrapper ships with inline\n     style=\"display:none\" by default so nothing flashes on pages\n     where the tag check fails or the fetch errors.\n\n     TO CHANGE THE REQUIRED TAG, edit data-esg-vxpromo-tag on the\n     wrapper div. To disable the gate entirely (always show), remove\n     that attribute and the inline display:none.\n\n     If this same HTML/description field is only ever pasted onto\n     ProTee VX products anyway, the tag check is a safety net, not a\n     requirement -- but it means the identical snippet can safely be\n     synced into Popular-ProTee-VX-Accessories-style shared sections\n     or pasted onto a non-VX page by mistake without leaking the\n     promo there.\n\n     PASTE NOTE: paste in Shopify's HTML/code view (the < > button),\n     NOT the rich-text view -- rich text strips <style> blocks.\n\n     RESELLER BADGE: the ProTee \"Authorized Reseller\" logo is now\n     folded directly into the module's own top strip (right side,\n     opposite the \"Cameras Included\" pill) instead of sitting above it\n     as a separate block -- one card, one border, no duplicate tag\n     gate. It renders unconditionally as part of the module markup\n     (same JS tag gate as the rest of the card, no separate Liquid\n     check), sized larger (28px tall, 34px at >=400px container width)\n     now that it no longer has to share the row with a text wordmark.\n     The redundant \"Elite Sim Golf is an Authorized ProTee Reseller\"\n     sentence was removed from the fine print since the logo now\n     states that visually.\n     ============================================================ -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n.esg-vxpromo{container-type:inline-size;margin:12px 0;box-sizing:border-box;border:1px solid #E6E9F0;background:#ffffff;position:relative}\n.esg-vxpromo *,.esg-vxpromo *::before,.esg-vxpromo *::after{box-sizing:border-box}\n\n/* --- top identity strip: Included pill (left) + reseller logo (right) --- */\n.esg-vxpromo__top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 14px;padding:9px 12px;border-bottom:1px solid #E6E9F0}\n.esg-vxpromo__reseller-logo{flex:0 0 auto;display:block;margin-left:auto;height:28px;width:auto;max-width:180px}\n.esg-vxpromo__included{position:relative;flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:12px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#ffffff;background:#0A1A3A;padding:4px 10px 4px 8px}\n.esg-vxpromo__included svg{flex:0 0 auto;display:block}\n\n/* --- body: 100x100 thumbnail + copy, always a slim horizontal strip\n     (this sits directly under the shipping blocks, so it should read\n     as a compact bar, not a stacked card) --- */\n.esg-vxpromo__body{display:flex;flex-direction:row;align-items:center;gap:10px;padding:8px 12px}\n.esg-vxpromo__media{flex:0 0 100px;width:100px;height:100px;background:#F8F8F8;border:1px solid #E6E9F0;overflow:hidden}\n.esg-vxpromo__media img{display:block;width:100%;height:100%;object-fit:contain;margin:0}\n.esg-vxpromo__main{flex:1 1 auto;min-width:0}\n.esg-vxpromo__eyebrow{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:10.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#3E4B7A;margin:0 0 4px}\n.esg-vxpromo__copy{font-family:'Inter',system-ui,-apple-system,sans-serif;font-size:12.5px;font-weight:400;line-height:1.45;color:#4A5578;margin:0;padding:0}\n.esg-vxpromo__copy strong{color:#0A1A3A;font-weight:700}\n.esg-vxpromo__fine{font-family:'Inter',system-ui,-apple-system,sans-serif;font-size:9.5px;font-weight:400;line-height:1.3;color:#8890A8;margin:4px 0 0;padding-top:4px;border-top:1px solid #F0F2F7}\n\n@container (min-width: 560px){\n  .esg-vxpromo__body{padding:9px 16px;gap:14px}\n}\n\n@container (min-width: 400px){\n  .esg-vxpromo__reseller-logo{height:34px;max-width:210px}\n}\n\n@container (max-width: 330px){\n  .esg-vxpromo__top{justify-content:flex-start}\n  .esg-vxpromo__reseller-logo{margin-left:0}\n}\n</style>\n\n<div class=\"esg-vxpromo\" data-esg-vxpromo data-esg-vxpromo-tag=\"ProTee VX\" style=\"display:none\">\n\n  <div class=\"esg-vxpromo__top\">\n    <span class=\"esg-vxpromo__included\">\n      <svg width=\"11\" height=\"11\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M13.5 4L6 11.5L2.5 8\" stroke=\"#ffffff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      <span>Cameras Included</span>\n    </span>\n\n    <img class=\"esg-vxpromo__reseller-logo\" src=\"https://cdn.shopify.com/s/files/1/0692/9698/0162/files/ProTee-AuthorizedReseller-DarkGreen-Transparent-US-Large.png?v=1786403473\" alt=\"ProTee Golf Authorized Reseller\" width=\"320\" height=\"120\" loading=\"lazy\">\n  </div>\n\n  <div class=\"esg-vxpromo__body\">\n    <span class=\"esg-vxpromo__media\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0692/9698/0162/files/swingcameras-proteevx_700x700_66cb5ab1-18c9-4a45-9444-89d697faddd3.png?v=1789303749\" alt=\"ProTee swing camera set included with the ProTee VX overhead launch monitor\" loading=\"lazy\" width=\"100\" height=\"100\">\n    </span>\n    <div class=\"esg-vxpromo__main\">\n      <span class=\"esg-vxpromo__eyebrow\">Limited-Time Promotion · ProTee VX Swing Camera Set</span>\n      <p class=\"esg-vxpromo__copy\">Included with every ProTee VX overhead launch monitor ordered from Elite Sim Golf — a <strong>set of two ProTee swing cameras</strong>, roughly a $600 value.</p>\n      <p class=\"esg-vxpromo__fine\">While camera stock lasts. Tripods and camera mounts sold separately.</p>\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function(){\n  // TAG GATE — only reveal the module on products tagged \"ProTee VX\"\n  // (case-insensitive, exact tag match against the storefront's public\n  // tag list). The wrapper starts with inline display:none so a slow\n  // or failed fetch never flashes the promo on the wrong product.\n  function revealIfTagged(root) {\n    var wantTag = (root.getAttribute('data-esg-vxpromo-tag') || '').trim().toLowerCase();\n    if (!wantTag) { root.style.display = ''; return; }\n\n    var handle = (window.location.pathname.match(/\\/products\\/([^/?#]+)/) || [])[1];\n    if (!handle) { return; } // not on a product page — stay hidden\n\n    fetch('/products/' + handle + '.js', { headers: { 'Accept': 'application/json' } })\n      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })\n      .then(function (p) {\n        var tags = (p.tags || []).map(function (t) { return String(t).trim().toLowerCase(); });\n        if (tags.indexOf(wantTag) !== -1) {\n          root.style.display = '';\n        }\n        // no match: leave hidden, don't touch layout\n      })\n      .catch(function () {\n        // Fetch failed (offline product, network hiccup, etc.) — stay\n        // hidden rather than risk showing the promo on the wrong page.\n      });\n  }\n\n  document.querySelectorAll('[data-esg-vxpromo]').forEach(revealIfTagged);\n})();\n</script>"
          }
        },
        "custom_liquid_C6rNL8": {
          "type": "custom-liquid",
          "name": "SIMKIT Builder",
          "settings": {
            "custom_liquid": "<!-- ============================================================\n     PROTEE AUTHORIZED RESELLER + SIMKIT BUILDER PROMO\n\n     PROTEE BADGE:\n     Displays when product has tag: ProTee VX\n\n     SIMKIT PROMO:\n     Displays when Product Type contains: Launch Monitor\n\n     Styling intentionally matches the ESG accessory block:\n     - Navy top border\n     - Light gray header\n     - White content area\n     - Barlow Condensed headings\n     - Inter body text\n     - Square/minimal styling\n     - Centered CTA\n     ============================================================ -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n{%- comment -%}\n  DETECT LAUNCH MONITOR PRODUCT TYPE\n{%- endcomment -%}\n\n{%- assign is_launch_monitor = false -%}\n{%- assign prod_type_dc = product.type | downcase -%}\n\n{%- if prod_type_dc contains 'launch monitor' -%}\n  {%- assign is_launch_monitor = true -%}\n{%- endif -%}\n\n\n{%- if is_launch_monitor -%}\n\n<div class=\"esg-simkit-wrap\">\n\n  <div class=\"esg-simkit\">\n\n    <!-- HEADER -->\n    <div class=\"esg-simkit__head\">\n\n      <div class=\"esg-simkit__head-text\">\n\n        <div class=\"esg-simkit__title\">\n          BUILD YOUR COMPLETE GOLF SIMULATOR\n        </div>\n\n        <div class=\"esg-simkit__sub\">\n          Save up to 15% when you build a complete SIMKIT\n        </div>\n\n      </div>\n\n    </div>\n\n\n    <!-- BODY -->\n    <div class=\"esg-simkit__body\">\n\n      <div class=\"esg-simkit__copy\">\n\n        Turn the <strong>{{ product.title }}</strong> into a complete home golf\n        simulator. Use the <strong>Elite Sim Golf SIMKIT Builder</strong> to\n        custom-fit your enclosure, projector, hitting mat and accessories while\n        saving up to <strong>15% on eligible bundle components.</strong>\n\n      </div>\n\n\n      <div class=\"esg-simkit__note\">\n        Launch monitor excluded from bundle discount.\n      </div>\n\n\n      <div class=\"esg-simkit__cta\">\n\n        <a\n          class=\"esg-simkit__button\"\n          href=\"/pages/golf-simkit-bundle-builder\">\n\n          OPEN SIMKIT BUILDER\n\n          <span class=\"esg-simkit__arrow\" aria-hidden=\"true\">→</span>\n\n        </a>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</div>\n\n{%- endif -%}\n\n\n<style>\n\n/* ============================================================\n   SHARED BOX SIZING\n============================================================ */\n\n.esg-protee-badge,\n.esg-simkit-wrap,\n.esg-simkit-wrap *,\n.esg-simkit-wrap *::before,\n.esg-simkit-wrap *::after {\n  box-sizing: border-box;\n}\n\n\n/* ============================================================\n   PROTEE AUTHORIZED RESELLER BADGE\n============================================================ */\n\n.esg-protee-badge {\n  width: 100%;\n  margin: 14px 0 18px;\n  text-align: center;\n}\n\n.esg-protee-badge img {\n  display: block;\n  width: 100%;\n  max-width: 250px;\n  height: auto;\n  margin: 0 auto;\n}\n\n\n/* ============================================================\n   SIMKIT WRAPPER\n============================================================ */\n\n.esg-simkit-wrap {\n  width: 100%;\n  margin: 18px 0 22px;\n}\n\n\n/* ============================================================\n   MAIN SIMKIT BOX\n============================================================ */\n\n.esg-simkit {\n  width: 100%;\n\n  margin: 0;\n\n  background: #ffffff;\n\n  border: 1px solid #E6E9F0;\n  border-top: 3px solid #0A1A3A;\n}\n\n\n/* ============================================================\n   HEADER\n============================================================ */\n\n.esg-simkit__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 10px;\n\n  padding: 14px 16px;\n\n  background: #F8F8F8;\n\n  border-bottom: 1px solid #E6E9F0;\n}\n\n\n.esg-simkit__head-text {\n  min-width: 100%;\n}\n\n\n/* MAIN HEADING */\n\n.esg-simkit__title {\n  display: block;\n\n  margin: 0;\n\n  font-family:\n    'Barlow Condensed',\n    'Arial Narrow',\n    sans-serif;\n\n  font-size: 20px;\n  font-weight: 800;\n\n  line-height: 1.15;\n\n  letter-spacing: .01em;\n\n  text-transform: uppercase;\n\n  color: #0A1A3A;\n\n  text-align: center;\n}\n\n\n/* SUBHEADING */\n\n.esg-simkit__sub {\n  display: block;\n\n  margin-top: 3px;\n\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 11px;\n  font-weight: 400;\n\n  line-height: 1.4;\n\n  color: #6B7390;\n\n  text-align: center;\n}\n\n\n/* ============================================================\n   BODY\n============================================================ */\n\n.esg-simkit__body {\n  padding: 14px 16px 15px;\n\n  background: #ffffff;\n}\n\n\n/* MAIN COPY */\n\n.esg-simkit__copy {\n  margin: 0 auto;\n\n  max-width: 760px;\n\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 12px;\n  font-weight: 400;\n\n  line-height: 1.55;\n\n  color: #4A5268;\n\n  text-align: left;\n}\n\n\n.esg-simkit__copy strong {\n  font-weight: 600;\n  color: #0A1A3A;\n}\n\n\n/* DISCLAIMER */\n\n.esg-simkit__note {\n  margin-top: 5px;\n\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 10px;\n  font-weight: 400;\n\n  line-height: 1.35;\n\n  color: #8A91A3;\n\n  text-align: center;\n}\n\n\n/* ============================================================\n   CTA\n============================================================ */\n\n.esg-simkit__cta {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  margin-top: 12px;\n}\n\n\n/* BUTTON */\n\n.esg-simkit__button {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 8px;\n\n  min-width: 205px;\n\n  padding: 10px 20px;\n\n  background: #0A1A3A;\n\n  border: 1px solid #0A1A3A;\n\n  color: #ffffff !important;\n\n  font-family:\n    'Barlow Condensed',\n    'Arial Narrow',\n    sans-serif;\n\n  font-size: 13px;\n  font-weight: 800;\n\n  line-height: 1;\n\n  letter-spacing: .06em;\n\n  text-transform: uppercase;\n\n  text-decoration: none !important;\n\n  transition:\n    background .15s ease,\n    border-color .15s ease;\n}\n\n\n.esg-simkit__button:hover,\n.esg-simkit__button:focus {\n  background: #086ED3;\n\n  border-color: #086ED3;\n\n  color: #ffffff !important;\n\n  text-decoration: none !important;\n}\n\n\n/* ARROW */\n\n.esg-simkit__arrow {\n  display: inline-block;\n\n  font-family:\n    'Barlow Condensed',\n    'Arial Narrow',\n    sans-serif;\n\n  font-size: 17px;\n  font-weight: 700;\n\n  line-height: .7;\n\n  transition: transform .15s ease;\n}\n\n\n.esg-simkit__button:hover .esg-simkit__arrow {\n  transform: translateX(2px);\n}\n\n\n/* ============================================================\n   MOBILE\n============================================================ */\n\n@media (max-width: 749px) {\n\n  .esg-protee-badge {\n    margin: 12px 0 16px;\n  }\n\n  .esg-protee-badge img {\n    max-width: 215px;\n  }\n\n\n  .esg-simkit-wrap {\n    margin: 15px 0 18px;\n  }\n\n\n  .esg-simkit__head {\n    padding: 13px 14px;\n  }\n\n\n  .esg-simkit__title {\n    font-size: 16px;\n  }\n\n\n  .esg-simkit__sub {\n    font-size: 10.5px;\n  }\n\n\n  .esg-simkit__body {\n    padding: 13px 14px 14px;\n  }\n\n\n  .esg-simkit__copy {\n    font-size: 11.5px;\n\n    line-height: 1.5;\n  }\n\n\n  .esg-simkit__note {\n    font-size: 9.5px;\n  }\n\n\n  .esg-simkit__cta {\n    margin-top: 11px;\n  }\n\n\n  .esg-simkit__button {\n    min-width: 200px;\n\n    padding: 10px 18px;\n\n    font-size: 12.5px;\n  }\n\n}\n\n</style>"
          }
        },
        "buy-buttons": {
          "type": "buy-buttons",
          "settings": {
            "show_qty_selector": true,
            "enable_dynamic_checkout": true,
            "show_pickup_availability": true,
            "show_backorder_text": false,
            "show_gift_card_recipient": false,
            "show_inventory_notice": "never",
            "show_inventory_count": "always",
            "inventory_threshold": 1
          }
        },
        "custom_liquid_zbmPDE": {
          "type": "custom-liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<!-- ============================================================\n     POPULAR PROTEE VX ACCESSORIES\n     LIVE SHOPIFY DATA + INLINE ADD-WITH-PROTEE TOGGLES\n\n     PRODUCT ORDER:\n     1. ProTee VX Protective Case\n     2. GSPro Software\n     3. Elite Sim Golf Gaming Desktop PC\n     4. SurfThing SG3 PC\n\n     IMPORTANT:\n     Place in a Custom Liquid block, Liquid section, or snippet.\n\n     ADD TO CART:\n     - No accessory selected = theme handles Add to Cart normally\n     - Accessory selected = main product + selected accessories\n       are added together in one Shopify cart request\n\n     TOGGLE POSITION:\n     Bottom-right INSIDE each product card\n============================================================ -->\n\n\n{%- assign acc_case = all_products['proteevx-protective-case'] -%}\n{%- assign acc_gspro = all_products['gspro-golf-simulator-software-1-year-subscription'] -%}\n{%- assign acc_esg_pc = all_products['golf-simulator-gaming-desktop-pc-all-configurations-by-elite-sim-golf'] -%}\n{%- assign acc_surfthing = all_products['golf-simulator-pc-add-on-surfthing-sg3-series'] -%}\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link\n  href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap\"\n  rel=\"stylesheet\">\n\n\n<style>\n\n/* ============================================================\n   WRAPPER\n============================================================ */\n\n.esg-acc-wrap {\n  container-type: inline-size;\n  margin: 24px 0;\n  box-sizing: border-box;\n}\n\n.esg-acc-wrap *,\n.esg-acc-wrap *::before,\n.esg-acc-wrap *::after {\n  box-sizing: border-box;\n}\n\n\n/* ============================================================\n   MAIN CONTAINER\n============================================================ */\n\n.esg-acc {\n  margin: 0;\n  background: #ffffff;\n  border: 1px solid #E6E9F0;\n  border-top: 3px solid #0A1A3A;\n}\n\n\n/* ============================================================\n   HEADER\n============================================================ */\n\n.esg-acc__sum {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 10px;\n  padding: 14px 16px;\n\n  cursor: pointer;\n  list-style: none;\n\n  background: #F8F8F8;\n\n  transition: background .15s ease;\n}\n\n.esg-acc__sum::-webkit-details-marker {\n  display: none;\n}\n\n.esg-acc__sum::marker {\n  content: \"\";\n}\n\n.esg-acc__sum:hover {\n  background: #F1F3F7;\n}\n\n.esg-acc__sum-txt {\n  min-width: 0;\n}\n\n.esg-acc__label {\n  display: block;\n\n  font-family:\n    'Barlow Condensed',\n    'Arial Narrow',\n    sans-serif;\n\n  font-size: 17px;\n  font-weight: 800;\n\n  line-height: 1.15;\n  letter-spacing: .01em;\n\n  text-transform: uppercase;\n\n  color: #0A1A3A;\n}\n\n.esg-acc__count {\n  display: block;\n\n  margin-top: 3px;\n\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 11px;\n  font-weight: 400;\n\n  line-height: 1.4;\n\n  color: #6B7390;\n}\n\n\n/* ============================================================\n   CHEVRON\n============================================================ */\n\n.esg-acc__chev {\n  position: relative;\n\n  flex: 0 0 auto;\n\n  width: 20px;\n  height: 20px;\n}\n\n.esg-acc__chev::before,\n.esg-acc__chev::after {\n  content: \"\";\n\n  position: absolute;\n\n  top: 9px;\n\n  width: 11px;\n  height: 2px;\n\n  background: #0A1A3A;\n\n  transition: transform .2s ease;\n}\n\n.esg-acc__chev::before {\n  left: 1px;\n  transform: rotate(45deg);\n}\n\n.esg-acc__chev::after {\n  right: 1px;\n  transform: rotate(-45deg);\n}\n\n.esg-acc[open] .esg-acc__chev::before {\n  transform: rotate(-45deg);\n}\n\n.esg-acc[open] .esg-acc__chev::after {\n  transform: rotate(45deg);\n}\n\n\n/* ============================================================\n   BODY + GRID\n============================================================ */\n\n.esg-acc__body {\n  border-top: 1px solid #E6E9F0;\n}\n\n.esg-acc__grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 0;\n}\n\n\n/* ============================================================\n   PRODUCT CARD\n============================================================ */\n\n.esg-acc-card {\n  position: relative;\n\n  display: grid;\n\n  grid-template-columns:\n    58px minmax(0, 1fr) auto;\n\n  align-items: center;\n\n  gap: 12px;\n\n  /*\n    Extra bottom padding creates space\n    for the inline toggle.\n  */\n  padding: 12px 16px 38px;\n\n  background: #ffffff;\n\n  border-bottom: 1px solid #E6E9F0;\n\n  transition: background .15s ease;\n}\n\n.esg-acc-card:last-child {\n  border-bottom: 0;\n}\n\n.esg-acc-card:hover {\n  background: #F8F8F8;\n}\n\n\n/* ============================================================\n   PRODUCT LINK\n============================================================ */\n\n.esg-acc-card__product-link {\n  display: contents;\n  color: inherit;\n  text-decoration: none;\n}\n\n.esg-acc-card__product-link:hover,\n.esg-acc-card__product-link:focus {\n  text-decoration: none;\n}\n\n\n/* ============================================================\n   IMAGE\n============================================================ */\n\n.esg-acc-card__thumb {\n  grid-column: 1;\n  grid-row: 1;\n\n  display: block;\n\n  width: 58px;\n  height: 58px;\n\n  background: #ffffff;\n\n  border: 1px solid #E6E9F0;\n}\n\n.esg-acc-card__thumb img {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  max-width: 100%;\n\n  object-fit: contain;\n\n  padding: 5px;\n\n  margin: 0;\n}\n\n\n/* ============================================================\n   PRODUCT INFO\n============================================================ */\n\n.esg-acc-card__info {\n  grid-column: 2;\n  grid-row: 1;\n\n  min-width: 0;\n}\n\n.esg-acc-card__title {\n  display: block;\n\n  margin: 0 0 3px;\n\n  font-family:\n    'Barlow Condensed',\n    'Arial Narrow',\n    sans-serif;\n\n  font-size: 15px;\n  font-weight: 700;\n\n  line-height: 1.2;\n\n  letter-spacing: .02em;\n\n  text-transform: uppercase;\n\n  color: #0A1A3A;\n}\n\n.esg-acc-card__meta {\n  display: block;\n\n  margin: 0 0 5px;\n\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 11px;\n  font-weight: 400;\n\n  line-height: 1.35;\n\n  color: #6B7390;\n}\n\n\n/* ============================================================\n   PRICE\n============================================================ */\n\n.esg-acc-card__price {\n  display: flex;\n  align-items: baseline;\n  flex-wrap: wrap;\n\n  gap: 6px;\n}\n\n.esg-acc-card__now {\n  font-family:\n    'Barlow Condensed',\n    'Arial Narrow',\n    sans-serif;\n\n  font-size: 17px;\n  font-weight: 800;\n\n  line-height: 1;\n\n  color: #0A1A3A;\n}\n\n.esg-acc-card__was {\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 11px;\n\n  color: #6B7390;\n\n  text-decoration: line-through;\n}\n\n.esg-acc-card__save {\n  font-family:\n    'Barlow Condensed',\n    'Arial Narrow',\n    sans-serif;\n\n  font-size: 10px;\n  font-weight: 700;\n\n  letter-spacing: .08em;\n\n  text-transform: uppercase;\n\n  color: #0A1A3A;\n\n  border: 1px solid #0A1A3A;\n\n  padding: 1px 5px;\n}\n\n.esg-acc-card__unit {\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 11px;\n\n  color: #6B7390;\n}\n\n\n/* ============================================================\n   ARROW\n============================================================ */\n\n.esg-acc-card__arrow {\n  grid-column: 3;\n  grid-row: 1;\n\n  flex: 0 0 auto;\n\n  font-family:\n    'Barlow Condensed',\n    'Arial Narrow',\n    sans-serif;\n\n  font-size: 17px;\n  font-weight: 700;\n\n  color: #0A1A3A;\n\n  line-height: 1;\n\n  transition: transform .15s ease;\n}\n\n.esg-acc-card:hover .esg-acc-card__arrow {\n  transform: translateX(2px);\n}\n\n\n/* ============================================================\n   INLINE TOGGLE\n   BOTTOM RIGHT INSIDE PRODUCT CARD\n============================================================ */\n\n.esg-acc-card__toggle {\n  position: absolute;\n\n  right: 14px;\n  bottom: 10px;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-end;\n\n  margin: 0;\n  padding: 0;\n}\n\n.esg-acc-toggle {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-end;\n\n  gap: 7px;\n\n  cursor: pointer;\n\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 10px;\n  font-weight: 600;\n\n  line-height: 1;\n\n  letter-spacing: .05em;\n\n  text-transform: uppercase;\n\n  color: #0A1A3A;\n}\n\n.esg-acc-toggle input {\n  position: absolute;\n\n  opacity: 0;\n\n  pointer-events: none;\n}\n\n.esg-acc-toggle__switch {\n  position: relative;\n\n  display: inline-block;\n\n  flex: 0 0 auto;\n\n  width: 32px;\n  height: 17px;\n\n  background: #CDD2DC;\n\n  border-radius: 999px;\n\n  transition: background .15s ease;\n}\n\n.esg-acc-toggle__switch::after {\n  content: \"\";\n\n  position: absolute;\n\n  top: 2px;\n  left: 2px;\n\n  width: 13px;\n  height: 13px;\n\n  background: #ffffff;\n\n  border-radius: 50%;\n\n  box-shadow: 0 1px 2px rgba(0,0,0,.18);\n\n  transition: transform .15s ease;\n}\n\n.esg-acc-toggle input:checked + .esg-acc-toggle__switch {\n  background: #086ED3;\n}\n\n.esg-acc-toggle input:checked + .esg-acc-toggle__switch::after {\n  transform: translateX(15px);\n}\n\n\n/* ============================================================\n   STATUS\n============================================================ */\n\n.esg-acc-status {\n  display: none;\n\n  padding: 9px 14px;\n\n  border-top: 1px solid #E6E9F0;\n\n  background: #F8F8F8;\n\n  font-family:\n    'Inter',\n    system-ui,\n    -apple-system,\n    sans-serif;\n\n  font-size: 11px;\n\n  color: #0A1A3A;\n\n  text-align: center;\n}\n\n.esg-acc-status.is-visible {\n  display: block;\n}\n\n\n/* ============================================================\n   WIDE PRODUCT COLUMN — 2 × 2\n============================================================ */\n\n@container (min-width: 860px) {\n\n  .esg-acc__grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .esg-acc-card {\n    border-right: 1px solid #E6E9F0;\n  }\n\n  .esg-acc-card:nth-child(2n) {\n    border-right: 0;\n  }\n\n  .esg-acc-card:nth-last-child(-n+2) {\n    border-bottom: 0;\n  }\n\n  .esg-acc__sum {\n    padding: 15px 18px;\n  }\n\n}\n\n\n/* ============================================================\n   MOBILE\n============================================================ */\n\n@media (max-width: 749px) {\n\n  .esg-acc-wrap {\n    margin: 18px 0;\n  }\n\n  .esg-acc__sum {\n    padding: 13px 14px;\n  }\n\n  .esg-acc__label {\n    font-size: 16px;\n  }\n\n  .esg-acc-card {\n    padding:\n      11px\n      13px\n      37px;\n\n    gap: 10px;\n\n    grid-template-columns:\n      54px minmax(0,1fr) auto;\n  }\n\n  .esg-acc-card__thumb {\n    width: 54px;\n    height: 54px;\n  }\n\n  .esg-acc-card__toggle {\n    right: 12px;\n    bottom: 9px;\n  }\n\n  .esg-acc-toggle {\n    font-size: 9.5px;\n  }\n\n}\n\n</style>\n\n\n<div class=\"esg-acc-wrap\">\n\n  <details class=\"esg-acc\" open>\n\n    <summary class=\"esg-acc__sum\">\n\n      <span class=\"esg-acc__sum-txt\">\n\n        <span class=\"esg-acc__label\">\n          Popular ProTee VX Accessories\n        </span>\n\n        <span class=\"esg-acc__count\">\n          Select accessories to add with your ProTee VX\n        </span>\n\n      </span>\n\n      <span\n        class=\"esg-acc__chev\"\n        aria-hidden=\"true\">\n      </span>\n\n    </summary>\n\n\n    <div class=\"esg-acc__body\">\n\n      <div class=\"esg-acc__grid\">\n\n\n        <!-- ==================================================\n             1. PROTEE VX PROTECTIVE CASE\n        =================================================== -->\n\n        {%- unless acc_case == empty -%}\n\n          <div class=\"esg-acc-card\">\n\n            <a\n              class=\"esg-acc-card__product-link\"\n              href=\"{{ acc_case.url }}\">\n\n              <span class=\"esg-acc-card__thumb\">\n\n                {%- if acc_case.featured_image -%}\n\n                  {{\n                    acc_case.featured_image\n                    | image_url: width: 160\n                    | image_tag:\n                      loading: 'lazy',\n                      alt: acc_case.title\n                  }}\n\n                {%- endif -%}\n\n              </span>\n\n\n              <span class=\"esg-acc-card__info\">\n\n                <span class=\"esg-acc-card__title\">\n                  {{ acc_case.title }}\n                </span>\n\n                <span class=\"esg-acc-card__meta\">\n                  Custom-fit travel and storage case\n                </span>\n\n                <span class=\"esg-acc-card__price\">\n\n                  <span class=\"esg-acc-card__now\">\n                    {{ acc_case.price | money }}\n                  </span>\n\n                  {%- if acc_case.compare_at_price > acc_case.price -%}\n\n                    <span class=\"esg-acc-card__was\">\n                      {{ acc_case.compare_at_price | money }}\n                    </span>\n\n                    <span class=\"esg-acc-card__save\">\n                      SAVE\n                      {{\n                        acc_case.compare_at_price\n                        | minus: acc_case.price\n                        | money_without_trailing_zeros\n                      }}\n                    </span>\n\n                  {%- endif -%}\n\n                </span>\n\n              </span>\n\n\n              <span class=\"esg-acc-card__arrow\">\n                →\n              </span>\n\n            </a>\n\n\n            <div class=\"esg-acc-card__toggle\">\n\n              <label class=\"esg-acc-toggle\">\n\n                <input\n                  type=\"checkbox\"\n                  class=\"esg-acc-addon\"\n                  data-variant-id=\"{{ acc_case.selected_or_first_available_variant.id }}\">\n\n                <span class=\"esg-acc-toggle__switch\"></span>\n\n                ADD WITH PROTEE\n\n              </label>\n\n            </div>\n\n          </div>\n\n        {%- endunless -%}\n\n\n\n        <!-- ==================================================\n             2. GSPRO\n        =================================================== -->\n\n        {%- unless acc_gspro == empty -%}\n\n          <div class=\"esg-acc-card\">\n\n            <a\n              class=\"esg-acc-card__product-link\"\n              href=\"{{ acc_gspro.url }}\">\n\n              <span class=\"esg-acc-card__thumb\">\n\n                {%- if acc_gspro.featured_image -%}\n\n                  {{\n                    acc_gspro.featured_image\n                    | image_url: width: 160\n                    | image_tag:\n                      loading: 'lazy',\n                      alt: acc_gspro.title\n                  }}\n\n                {%- endif -%}\n\n              </span>\n\n\n              <span class=\"esg-acc-card__info\">\n\n                <span class=\"esg-acc-card__title\">\n                  {{ acc_gspro.title }}\n                </span>\n\n                <span class=\"esg-acc-card__meta\">\n                  Most-used simulator platform with ProTee VX\n                </span>\n\n                <span class=\"esg-acc-card__price\">\n\n                  <span class=\"esg-acc-card__now\">\n                    {{ acc_gspro.price | money }}\n                  </span>\n\n                  <span class=\"esg-acc-card__unit\">\n                    per year\n                  </span>\n\n                  {%- if acc_gspro.compare_at_price > acc_gspro.price -%}\n\n                    <span class=\"esg-acc-card__was\">\n                      {{ acc_gspro.compare_at_price | money }}\n                    </span>\n\n                  {%- endif -%}\n\n                </span>\n\n              </span>\n\n\n              <span class=\"esg-acc-card__arrow\">\n                →\n              </span>\n\n            </a>\n\n\n            <div class=\"esg-acc-card__toggle\">\n\n              <label class=\"esg-acc-toggle\">\n\n                <input\n                  type=\"checkbox\"\n                  class=\"esg-acc-addon\"\n                  data-variant-id=\"{{ acc_gspro.selected_or_first_available_variant.id }}\">\n\n                <span class=\"esg-acc-toggle__switch\"></span>\n\n                ADD WITH PROTEE\n\n              </label>\n\n            </div>\n\n          </div>\n\n        {%- endunless -%}\n\n\n\n        <!-- ==================================================\n             3. ELITE SIM GOLF GAMING DESKTOP PC\n        =================================================== -->\n\n        {%- unless acc_esg_pc == empty -%}\n\n          <div class=\"esg-acc-card\">\n\n            <a\n              class=\"esg-acc-card__product-link\"\n              href=\"{{ acc_esg_pc.url }}\">\n\n              <span class=\"esg-acc-card__thumb\">\n\n                {%- if acc_esg_pc.featured_image -%}\n\n                  {{\n                    acc_esg_pc.featured_image\n                    | image_url: width: 160\n                    | image_tag:\n                      loading: 'lazy',\n                      alt: acc_esg_pc.title\n                  }}\n\n                {%- endif -%}\n\n              </span>\n\n\n              <span class=\"esg-acc-card__info\">\n\n                <span class=\"esg-acc-card__title\">\n                  {{ acc_esg_pc.title }}\n                </span>\n\n                <span class=\"esg-acc-card__meta\">\n                  Elite Sim Golf simulator-ready PC configurations\n                </span>\n\n                <span class=\"esg-acc-card__price\">\n\n                  {%- if acc_esg_pc.price_varies -%}\n\n                    <span class=\"esg-acc-card__unit\">\n                      From\n                    </span>\n\n                  {%- endif -%}\n\n                  <span class=\"esg-acc-card__now\">\n                    {{ acc_esg_pc.price | money }}\n                  </span>\n\n                  {%- if acc_esg_pc.compare_at_price > acc_esg_pc.price -%}\n\n                    <span class=\"esg-acc-card__was\">\n                      {{ acc_esg_pc.compare_at_price | money }}\n                    </span>\n\n                  {%- endif -%}\n\n                </span>\n\n              </span>\n\n\n              <span class=\"esg-acc-card__arrow\">\n                →\n              </span>\n\n            </a>\n\n\n            <div class=\"esg-acc-card__toggle\">\n\n              <label class=\"esg-acc-toggle\">\n\n                <input\n                  type=\"checkbox\"\n                  class=\"esg-acc-addon\"\n                  data-variant-id=\"{{ acc_esg_pc.selected_or_first_available_variant.id }}\">\n\n                <span class=\"esg-acc-toggle__switch\"></span>\n\n                ADD WITH PROTEE\n\n              </label>\n\n            </div>\n\n          </div>\n\n        {%- endunless -%}\n\n\n\n        <!-- ==================================================\n             4. SURFTHING SG3 PC\n        =================================================== -->\n\n        {%- unless acc_surfthing == empty -%}\n\n          <div class=\"esg-acc-card\">\n\n            <a\n              class=\"esg-acc-card__product-link\"\n              href=\"{{ acc_surfthing.url }}\">\n\n              <span class=\"esg-acc-card__thumb\">\n\n                {%- if acc_surfthing.featured_image -%}\n\n                  {{\n                    acc_surfthing.featured_image\n                    | image_url: width: 160\n                    | image_tag:\n                      loading: 'lazy',\n                      alt: acc_surfthing.title\n                  }}\n\n                {%- endif -%}\n\n              </span>\n\n\n              <span class=\"esg-acc-card__info\">\n\n                <span class=\"esg-acc-card__title\">\n                  {{ acc_surfthing.title }}\n                </span>\n\n                <span class=\"esg-acc-card__meta\">\n                  4 tiers · 1080P through 4K Ultra\n                </span>\n\n                <span class=\"esg-acc-card__price\">\n\n                  {%- if acc_surfthing.price_varies -%}\n\n                    <span class=\"esg-acc-card__unit\">\n                      From\n                    </span>\n\n                  {%- endif -%}\n\n                  <span class=\"esg-acc-card__now\">\n                    {{ acc_surfthing.price | money }}\n                  </span>\n\n                  {%- if acc_surfthing.compare_at_price > acc_surfthing.price -%}\n\n                    <span class=\"esg-acc-card__was\">\n                      {{ acc_surfthing.compare_at_price | money }}\n                    </span>\n\n                  {%- endif -%}\n\n                </span>\n\n              </span>\n\n\n              <span class=\"esg-acc-card__arrow\">\n                →\n              </span>\n\n            </a>\n\n\n            <div class=\"esg-acc-card__toggle\">\n\n              <label class=\"esg-acc-toggle\">\n\n                <input\n                  type=\"checkbox\"\n                  class=\"esg-acc-addon\"\n                  data-variant-id=\"{{ acc_surfthing.selected_or_first_available_variant.id }}\">\n\n                <span class=\"esg-acc-toggle__switch\"></span>\n\n                ADD WITH PROTEE\n\n              </label>\n\n            </div>\n\n          </div>\n\n        {%- endunless -%}\n\n\n      </div>\n\n\n      <div\n        class=\"esg-acc-status\"\n        aria-live=\"polite\">\n      </div>\n\n    </div>\n\n  </details>\n\n</div>\n\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  const accessoryBlock = document.querySelector('.esg-acc-wrap');\n\n  if (!accessoryBlock) return;\n\n\n  let bundleSubmitting = false;\n\n\n  /* ==========================================================\n     STATUS MESSAGE\n  ========================================================== */\n\n  function setAccessoryStatus(message) {\n\n    const status =\n      accessoryBlock.querySelector('.esg-acc-status');\n\n    if (!status) return;\n\n\n    status.textContent = message;\n    status.classList.add('is-visible');\n\n  }\n\n\n  /* ==========================================================\n     GET CHECKED ACCESSORIES\n  ========================================================== */\n\n  function getSelectedAccessories() {\n\n    return Array.from(\n      accessoryBlock.querySelectorAll(\n        '.esg-acc-addon:checked'\n      )\n    )\n\n    .map(function (checkbox) {\n\n      const variantId =\n        parseInt(\n          checkbox.dataset.variantId,\n          10\n        );\n\n\n      return {\n        id: variantId,\n        quantity: 1\n      };\n\n    })\n\n    .filter(function (item) {\n\n      return (\n        Number.isFinite(item.id) &&\n        item.id > 0\n      );\n\n    });\n\n  }\n\n\n  /* ==========================================================\n     GET MAIN PRODUCT FROM PRODUCT FORM\n  ========================================================== */\n\n  function getMainProductItem(form) {\n\n    const variantInput =\n      form.querySelector('[name=\"id\"]');\n\n\n    if (\n      !variantInput ||\n      !variantInput.value\n    ) {\n\n      return null;\n\n    }\n\n\n    const quantityInput =\n      form.querySelector('[name=\"quantity\"]');\n\n\n    let quantity = 1;\n\n\n    if (\n      quantityInput &&\n      quantityInput.value\n    ) {\n\n      quantity =\n        parseInt(\n          quantityInput.value,\n          10\n        ) || 1;\n\n    }\n\n\n    quantity = Math.max(1, quantity);\n\n\n    return {\n      id: parseInt(\n        variantInput.value,\n        10\n      ),\n\n      quantity: quantity\n    };\n\n  }\n\n\n  /* ==========================================================\n     ADD MAIN PRODUCT + ACCESSORIES TOGETHER\n  ========================================================== */\n\n  async function addBundle(form) {\n\n    const mainItem =\n      getMainProductItem(form);\n\n\n    if (\n      !mainItem ||\n      !Number.isFinite(mainItem.id) ||\n      mainItem.id <= 0\n    ) {\n\n      throw new Error(\n        'Could not determine the selected ProTee VX variant.'\n      );\n\n    }\n\n\n    const accessories =\n      getSelectedAccessories();\n\n\n    const items = [\n      mainItem,\n      ...accessories\n    ];\n\n\n    setAccessoryStatus(\n      'Adding ProTee VX and selected accessories…'\n    );\n\n\n    const response =\n      await fetch(\n        window.Shopify.routes.root + 'cart/add.js',\n        {\n\n          method: 'POST',\n\n          headers: {\n            'Content-Type': 'application/json',\n            'Accept': 'application/json'\n          },\n\n          body: JSON.stringify({\n            items: items\n          })\n\n        }\n      );\n\n\n    const result =\n      await response.json();\n\n\n    if (!response.ok) {\n\n      throw new Error(\n        result.description ||\n        result.message ||\n        'Unable to add the selected items.'\n      );\n\n    }\n\n\n    return result;\n\n  }\n\n\n  /* ==========================================================\n     INTERCEPT MAIN PRODUCT ADD TO CART\n  ========================================================== */\n\n  document.addEventListener(\n    'submit',\n\n    async function (event) {\n\n      const form = event.target;\n\n\n      if (\n        !(form instanceof HTMLFormElement)\n      ) {\n\n        return;\n\n      }\n\n\n      /*\n        Ignore anything inside accessory block\n      */\n\n      if (\n        form.closest('.esg-acc-wrap')\n      ) {\n\n        return;\n\n      }\n\n\n      const action =\n        form.getAttribute('action') || '';\n\n\n      if (\n        !action.includes('/cart/add')\n      ) {\n\n        return;\n\n      }\n\n\n      const accessories =\n        getSelectedAccessories();\n\n\n      /*\n        NO ACCESSORIES SELECTED:\n        Leave native theme Add to Cart untouched.\n      */\n\n      if (\n        accessories.length === 0\n      ) {\n\n        return;\n\n      }\n\n\n      /*\n        ACCESSORIES SELECTED:\n        Add main product + accessories together.\n      */\n\n      event.preventDefault();\n      event.stopPropagation();\n      event.stopImmediatePropagation();\n\n\n      if (bundleSubmitting) {\n        return;\n      }\n\n\n      bundleSubmitting = true;\n\n\n      try {\n\n        const result =\n          await addBundle(form);\n\n\n        setAccessoryStatus(\n          'ProTee VX and selected accessories added to cart.'\n        );\n\n\n        /*\n          Reset toggles\n        */\n\n        accessoryBlock\n          .querySelectorAll(\n            '.esg-acc-addon:checked'\n          )\n          .forEach(\n            function (checkbox) {\n\n              checkbox.checked = false;\n\n            }\n          );\n\n\n        /*\n          Fetch current cart\n        */\n\n        const cartResponse =\n          await fetch(\n            window.Shopify.routes.root + 'cart.js',\n            {\n              headers: {\n                'Accept': 'application/json'\n              }\n            }\n          );\n\n\n        const cart =\n          await cartResponse.json();\n\n\n        /*\n          Common cart update events\n        */\n\n        document.dispatchEvent(\n          new CustomEvent(\n            'cart:refresh',\n            {\n              bubbles: true,\n\n              detail: {\n                cart: cart,\n                result: result\n              }\n            }\n          )\n        );\n\n\n        document.dispatchEvent(\n          new CustomEvent(\n            'cart:updated',\n            {\n              bubbles: true,\n\n              detail: {\n                cart: cart,\n                result: result\n              }\n            }\n          )\n        );\n\n\n        document.dispatchEvent(\n          new CustomEvent(\n            'cart:change',\n            {\n              bubbles: true,\n\n              detail: {\n                cart: cart,\n                result: result\n              }\n            }\n          )\n        );\n\n\n        /*\n          Try to update visible cart counters\n        */\n\n        const cartCountSelectors = [\n          '[data-cart-count]',\n          '.cart-count',\n          '.cart-count-bubble',\n          '.header-cart-count',\n          '.cart-link__count'\n        ];\n\n\n        cartCountSelectors.forEach(\n          function (selector) {\n\n            document\n              .querySelectorAll(selector)\n              .forEach(\n                function (element) {\n\n                  element.textContent =\n                    cart.item_count;\n\n                }\n              );\n\n          }\n        );\n\n\n      } catch (error) {\n\n        console.error(\n          'ESG ProTee bundle error:',\n          error\n        );\n\n\n        setAccessoryStatus(\n          error.message ||\n          'Unable to add the selected items. Please try again.'\n        );\n\n\n      } finally {\n\n        bundleSubmitting = false;\n\n      }\n\n    },\n\n    true\n  );\n\n});\n</script>"
          }
        },
        "custom_liquid_rbjCka": {
          "type": "custom-liquid",
          "name": "Custom Accessories",
          "settings": {
            "custom_liquid": "{%- comment -%}\n============================================================\n  ESG ACCESSORIES -- INLINE VERSION\n  Paste this whole thing into the Custom Liquid block on the\n  ProTee VX product template. No esg-accessories snippet needed.\n  Still requires snippets/esg-acc-row.liquid (already saved).\n\n  Heading resolves automatically from the product:\n    'acc-label:<value>' tag  ->  longest tag matching the start\n    of the title  ->  vendor  ->  'Popular Accessories'\n============================================================\n{%- endcomment -%}\n\n{%- liquid\n  assign uid = 'esgacc-' | append: product.id\n\n  assign esg_label = ''\n\n  if esg_label == ''\n    for t in product.tags\n      assign t_low = t | downcase\n      if t_low contains 'acc-label:'\n        assign esg_label = t | split: ':' | last | strip\n        break\n      endif\n    endfor\n  endif\n\n  if esg_label == ''\n    assign best = ''\n    assign title_len = product.title | size\n    for t in product.tags\n      assign t_len = t | size\n      if t_len > 0 and t_len <= title_len\n        assign head = product.title | slice: 0, t_len\n        if head == t\n          assign best_len = best | size\n          if t_len > best_len\n            assign best = t\n          endif\n        endif\n      endif\n    endfor\n    assign esg_label = best\n  endif\n\n  if esg_label == ''\n    assign esg_label = product.vendor | default: ''\n  endif\n\n  assign heading_pattern = 'Popular [label] Accessories'\n\n  if esg_label == ''\n    assign heading_text = 'Popular Accessories'\n  else\n    assign heading_text = heading_pattern | replace: '[label]', esg_label\n  endif\n\n\n  assign sub_text = ''\n  if sub_text == ''\n    if esg_label == ''\n      assign sub_text = '[count] add-on[s] buyers order most'\n    else\n      assign sub_text = '[count] add-on[s] [label] buyers order most'\n    endif\n  endif\n  assign handles_str = ''\n  assign max = 24\n  assign visible = 3\n\n  # ----------------------------------------------------------\n  # DEFAULT SET (fallback)\n  # Used only when a launch monitor product has no complementary\n  # products assigned in Search & Discovery. Edit this one line to\n  # change what shows: comma separated product handles, in order.\n  # Keep it to generic add-ons that suit ANY launch monitor -- model\n  # specific items belong on that model's own complementary list.\n  # ----------------------------------------------------------\n  assign fallback_handles = 'gspro-golf-simulator-software-1-year-subscription,golf-simulator-pc-add-on-surfthing-sg3-series,golf-simulator-gaming-desktop-pc-all-configurations-by-elite-sim-golf'\n\n  # Gate: launch monitor product pages only. The substring test is\n  # deliberate -- the real type on these products is 'Golf Launch\n  # Monitor', not 'Launch Monitor', so an exact match never fires.\n  # Accessory and protection types contain the same substring, so\n  # they are excluded: a case or shield PDP is not a launch monitor.\n  assign type_low = product.type | default: '' | downcase\n  assign type_ok = false\n  if type_low contains 'launch monitor'\n    assign type_ok = true\n    if type_low contains 'accessor'\n      assign type_ok = false\n    endif\n    if type_low contains 'protection'\n      assign type_ok = false\n    endif\n  endif\n\n  # Count assigned complementary products that would actually render.\n  # Unpublished or deleted references come back nil, so a non-empty\n  # metafield can still produce zero rows -- count the usable ones.\n  assign complementary = product.metafields.shopify--discovery--product_recommendation.complementary_products.value\n  assign comp_valid = 0\n  for cp in complementary limit: max\n    if cp != blank and cp.handle != product.handle\n      assign comp_valid = comp_valid | plus: 1\n    endif\n  endfor\n\n  assign use_fallback = false\n  if comp_valid == 0 and type_ok and fallback_handles != ''\n    assign use_fallback = true\n  endif\n\n  # all_products is capped at 20 lookups per template by Shopify, so the\n  # handle driven paths stay well under it.\n  assign fb_max = 12\n  assign visible_plus = visible | plus: 1\n  assign is_open = true\n  assign n = 0\n-%}\n\n{%- comment -%} Resolve which products to show {%- endcomment -%}\n{%- capture rows -%}\n  {%- if handles_str != '' -%}\n    {%- assign handle_list = handles_str | split: ',' -%}\n    {%- for h in handle_list -%}\n      {%- assign key = h | strip -%}\n      {%- assign p = all_products[key] -%}\n      {%- if p != blank and p.id != blank and p.handle != product.handle -%}\n        {%- assign n = n | plus: 1 -%}\n        {%- if n == visible_plus -%}<details class=\"esg-acc-more\"><summary class=\"esg-acc-more__sum\"><span class=\"esg-acc-more__txt esg-acc-more__txt--closed\">Show [MORE] more</span><span class=\"esg-acc-more__txt esg-acc-more__txt--open\">Show less</span><span class=\"esg-acc-more__chev\" aria-hidden=\"true\"></span></summary><div class=\"esg-acc-more__body\">{%- endif -%}\n        {%- render 'esg-acc-row', p: p -%}\n      {%- endif -%}\n    {%- endfor -%}\n  {%- elsif use_fallback -%}\n    {%- assign fb_list = fallback_handles | split: ',' -%}\n    {%- for h in fb_list limit: fb_max -%}\n      {%- assign key = h | strip -%}\n      {%- assign p = all_products[key] -%}\n      {%- if p != blank and p.id != blank and p.handle != product.handle -%}\n        {%- assign n = n | plus: 1 -%}\n        {%- if n == visible_plus -%}<details class=\"esg-acc-more\"><summary class=\"esg-acc-more__sum\"><span class=\"esg-acc-more__txt esg-acc-more__txt--closed\">Show [MORE] more</span><span class=\"esg-acc-more__txt esg-acc-more__txt--open\">Show less</span><span class=\"esg-acc-more__chev\" aria-hidden=\"true\"></span></summary><div class=\"esg-acc-more__body\">{%- endif -%}\n        {%- render 'esg-acc-row', p: p -%}\n      {%- endif -%}\n    {%- endfor -%}\n  {%- else -%}\n    {%- for p in complementary limit: max -%}\n      {%- if p != blank and p.handle != product.handle -%}\n        {%- assign n = n | plus: 1 -%}\n        {%- if n == visible_plus -%}<details class=\"esg-acc-more\"><summary class=\"esg-acc-more__sum\"><span class=\"esg-acc-more__txt esg-acc-more__txt--closed\">Show [MORE] more</span><span class=\"esg-acc-more__txt esg-acc-more__txt--open\">Show less</span><span class=\"esg-acc-more__chev\" aria-hidden=\"true\"></span></summary><div class=\"esg-acc-more__body\">{%- endif -%}\n        {%- render 'esg-acc-row', p: p -%}\n      {%- endif -%}\n    {%- endfor -%}\n  {%- endif -%}\n{%- endcapture -%}\n\n{%- assign row_count = rows | split: 'data-esg-row' | size | minus: 1 -%}\n\n{%- if row_count > visible -%}\n  {%- assign extra = row_count | minus: visible -%}\n  {%- assign rows = rows | append: '</div></details>' | replace: '[MORE]', extra -%}\n{%- endif -%}\n\n{%- if row_count > 0 -%}\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .esg-acc-wrap{container-type:inline-size;margin:0;box-sizing:border-box}\n  .esg-acc-wrap *,.esg-acc-wrap *::before,.esg-acc-wrap *::after{box-sizing:border-box}\n  .esg-acc-wrap .esg-acc{border:1px solid #E6E9F0;border-top:3px solid #0A1A3A;background:#fff;margin:0}\n  .esg-acc-wrap .esg-acc__sum{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;cursor:pointer;list-style:none;background:#F8F8F8;transition:background .15s ease}\n  .esg-acc-wrap .esg-acc__sum::-webkit-details-marker{display:none}\n  .esg-acc-wrap .esg-acc__sum::marker{content:\"\"}\n  .esg-acc-wrap .esg-acc__sum:hover{background:#F1F3F7}\n  .esg-acc-wrap .esg-acc__sum-txt{min-width:0}\n  .esg-acc-wrap .esg-acc__label{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:17px;font-weight:800;line-height:1.15;letter-spacing:.01em;text-transform:uppercase;color:#0A1A3A}\n  .esg-acc-wrap .esg-acc__count{display:block;font-family:'Inter',system-ui,sans-serif;font-size:11px;font-weight:400;line-height:1.4;color:#6B7390;margin-top:3px;text-transform:none}\n  .esg-acc-wrap .esg-acc__chev{flex:0 0 auto;width:20px;height:20px;position:relative}\n  .esg-acc-wrap .esg-acc__chev::before,.esg-acc-wrap .esg-acc__chev::after{content:\"\";position:absolute;top:9px;width:11px;height:2px;background:#0A1A3A;transition:transform .2s ease}\n  .esg-acc-wrap .esg-acc__chev::before{left:1px;transform:rotate(45deg)}\n  .esg-acc-wrap .esg-acc__chev::after{right:1px;transform:rotate(-45deg)}\n  .esg-acc-wrap .esg-acc[open] .esg-acc__chev::before{transform:rotate(-45deg)}\n  .esg-acc-wrap .esg-acc[open] .esg-acc__chev::after{transform:rotate(45deg)}\n  .esg-acc-wrap .esg-acc__body{border-top:1px solid #E6E9F0}\n  .esg-acc-wrap .esg-acc__grid{display:grid;grid-template-columns:1fr;gap:0}\n  .esg-acc-wrap .esg-acc-card{display:flex;align-items:center;gap:12px;padding:12px 16px;text-decoration:none;color:inherit;cursor:pointer;border-bottom:1px solid #E6E9F0;transition:background .15s ease}\n  .esg-acc-wrap .esg-acc-card:last-child{border-bottom:0}\n  .esg-acc-wrap .esg-acc-card:hover,.esg-acc-wrap .esg-acc-card:focus,.esg-acc-wrap .esg-acc-card:focus-within{background:#F8F8F8;text-decoration:none}\n  .esg-acc-wrap .esg-acc-card__thumb{flex:0 0 58px;width:58px;height:58px;background:#fff;border:1px solid #E6E9F0}\n  .esg-acc-wrap .esg-acc-card__thumb img{display:block;width:100%;height:100%;max-width:100%;object-fit:contain;padding:5px;margin:0}\n  .esg-acc-wrap .esg-acc-card__info{flex:1 1 auto;min-width:0}\n  .esg-acc-wrap .esg-acc-card__title{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:15px;font-weight:700;line-height:1.2;letter-spacing:.02em;text-transform:uppercase;color:#0A1A3A;text-decoration:none;margin:0 0 3px}\n  .esg-acc-wrap .esg-acc-card__title:hover,.esg-acc-wrap .esg-acc-card__title:focus-visible{text-decoration:underline;text-underline-offset:2px}\n  .esg-acc-wrap .esg-acc-card__meta{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-family:'Inter',system-ui,sans-serif;font-size:11px;font-weight:400;line-height:1.35;color:#6B7390;margin:0 0 5px}\n  .esg-acc-wrap .esg-acc-card__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px}\n  .esg-acc-wrap .esg-acc-card__now{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:17px;font-weight:800;line-height:1;color:#0A1A3A}\n  .esg-acc-wrap .esg-acc-card__was{font-family:'Inter',system-ui,sans-serif;font-size:11px;color:#6B7390;text-decoration:line-through}\n  .esg-acc-wrap .esg-acc-card__save{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0A1A3A;border:1px solid #0A1A3A;padding:1px 5px}\n  .esg-acc-wrap .esg-acc-card__out{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B7390;border:1px solid #C9CEDB;padding:1px 5px}\n  .esg-acc-wrap .esg-acc-card__unit{font-family:'Inter',system-ui,sans-serif;font-size:11px;color:#6B7390}\n  .esg-acc-wrap .esg-acc-card__add{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;min-width:56px;padding:7px 13px 6px;background:#fff;border:1px solid #0A1A3A;border-radius:0;color:#0A1A3A;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:14px;font-weight:700;line-height:1;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:background .15s ease,color .15s ease}\n  .esg-acc-wrap .esg-acc-card__add:hover,.esg-acc-wrap .esg-acc-card__add:focus-visible{background:#0A1A3A;color:#fff}\n  .esg-acc-wrap .esg-acc-card__add[aria-disabled=\"true\"]{opacity:.45;cursor:default}\n  .esg-acc-wrap .esg-acc-more{grid-column:1 / -1;border-top:1px solid #E6E9F0}\n  .esg-acc-wrap .esg-acc-more__sum{display:flex;align-items:center;justify-content:center;gap:7px;padding:11px 16px;cursor:pointer;list-style:none;background:#fff;transition:background .15s ease}\n  .esg-acc-wrap .esg-acc-more__sum::-webkit-details-marker{display:none}\n  .esg-acc-wrap .esg-acc-more__sum::marker{content:\"\"}\n  .esg-acc-wrap .esg-acc-more__sum:hover{background:#F8F8F8}\n  .esg-acc-wrap .esg-acc-more__txt{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0A1A3A;line-height:1}\n  .esg-acc-wrap .esg-acc-more__txt--open{display:none}\n  .esg-acc-wrap .esg-acc-more[open] .esg-acc-more__txt--closed{display:none}\n  .esg-acc-wrap .esg-acc-more[open] .esg-acc-more__txt--open{display:inline}\n  .esg-acc-wrap .esg-acc-more__chev{flex:0 0 auto;width:9px;height:9px;border-right:2px solid #0A1A3A;border-bottom:2px solid #0A1A3A;transform:rotate(45deg);margin-top:-3px;transition:transform .2s ease}\n  .esg-acc-wrap .esg-acc-more[open] .esg-acc-more__chev{transform:rotate(-135deg);margin-top:2px}\n  .esg-acc-wrap .esg-acc-more__body{display:grid;grid-template-columns:1fr;border-top:1px solid #E6E9F0}\n  .esg-acc-wrap .esg-acc-more__body .esg-acc-card:last-child{border-bottom:0}\n  @container (min-width: 860px){\n    .esg-acc-wrap .esg-acc__grid{grid-template-columns:repeat(3,1fr)}\n    .esg-acc-wrap .esg-acc-more__body{grid-template-columns:repeat(3,1fr)}\n    .esg-acc-wrap .esg-acc-more__body .esg-acc-card{border-bottom:0;border-right:1px solid #E6E9F0}\n    .esg-acc-wrap .esg-acc-more__body .esg-acc-card:last-child{border-right:0}\n    .esg-acc-wrap .esg-acc-card{border-bottom:0;border-right:1px solid #E6E9F0}\n    .esg-acc-wrap .esg-acc-card:last-child{border-right:0}\n    .esg-acc-wrap .esg-acc__sum{padding:15px 18px}\n  }\n</style>\n\n<div class=\"esg-acc-wrap\" id=\"{{ uid }}\">\n  <details class=\"esg-acc\"{% if is_open %} open{% endif %}>\n    <summary class=\"esg-acc__sum\">\n      <span class=\"esg-acc__sum-txt\">\n        <span class=\"esg-acc__label\">{{ heading_text | escape }}</span>\n        {%- liquid\n          assign plural = 's'\n          if row_count == 1\n            assign plural = ''\n          endif\n          assign sub_final = sub_text | replace: '[count]', row_count | replace: '[s]', plural | replace: '[label]', esg_label | strip\n        -%}\n        {%- if sub_final != blank -%}\n          <span class=\"esg-acc__count\">{{ sub_final | escape }}</span>\n        {%- endif -%}\n      </span>\n      <span class=\"esg-acc__chev\" aria-hidden=\"true\"></span>\n    </summary>\n    <div class=\"esg-acc__body\">\n      <div class=\"esg-acc__grid\">{{ rows }}</div>\n    </div>\n  </details>\n</div>\n\n{%- comment -%}\n  ------------------------------------------------------------\n  QUICK VIEW POPUP — self-contained.\n\n  This deliberately does NOT use Alchemy's <quick-add-drawer>.\n  That component copies the fetched page's <product-form> markup,\n  calls form.init(), then Shopify.PaymentButton.init(). Any throw\n  in that chain aborts the rest of the render, and this store is\n  already logging shop-js module load failures. The drawer also\n  only exists when settings.enable_quick_add is on.\n\n  Instead: read the product JSON at /products/<handle>.js, build\n  the popup markup here, and post straight to /cart/add.js. No\n  theme JS, no theme setting, no custom elements.\n  ------------------------------------------------------------\n{%- endcomment -%}\n<style>\n  .esg-qv{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;font-family:'Inter',system-ui,-apple-system,sans-serif}\n  .esg-qv.is-open{display:flex}\n  .esg-qv *,.esg-qv *::before,.esg-qv *::after{box-sizing:border-box}\n  .esg-qv__veil{position:absolute;inset:0;background:rgba(10,26,58,.62)}\n  .esg-qv__box{position:relative;width:100%;max-width:560px;max-height:calc(100vh - 40px);overflow-y:auto;background:#fff;border:1px solid #E6E9F0;border-top:3px solid #0A1A3A;padding:26px 28px 28px}\n  .esg-qv__x{position:absolute;top:10px;right:10px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;padding:0 0 3px;background:#fff;border:1px solid #E6E9F0;color:#0A1A3A;font-size:22px;line-height:1;cursor:pointer;transition:background .15s ease,color .15s ease}\n  .esg-qv__x:hover,.esg-qv__x:focus-visible{background:#0A1A3A;border-color:#0A1A3A;color:#fff}\n  .esg-qv__head{display:flex;gap:18px;align-items:flex-start;padding-right:30px}\n  .esg-qv__img{flex:0 0 96px;width:96px;height:96px;border:1px solid #E6E9F0;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}\n  .esg-qv__img img{max-width:100%;max-height:100%;object-fit:contain;padding:5px;display:block}\n  .esg-qv__ttl{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:22px;font-weight:800;line-height:1.15;letter-spacing:.01em;text-transform:uppercase;color:#0A1A3A;text-decoration:none;margin:0 0 7px}\n  .esg-qv__ttl:hover,.esg-qv__ttl:focus-visible{text-decoration:underline;text-underline-offset:2px}\n  .esg-qv__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px}\n  .esg-qv__now{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:24px;font-weight:800;line-height:1;color:#0A1A3A}\n  .esg-qv__was{font-size:12px;color:#6B7390;text-decoration:line-through}\n  .esg-qv__save{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0A1A3A;border:1px solid #0A1A3A;padding:2px 6px}\n  .esg-qv__desc{font-size:13px;line-height:1.6;color:#2a3756;margin:18px 0 0}\n  .esg-qv__lbl{display:block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#6B7390;margin:20px 0 6px}\n  .esg-qv__sel{width:100%;padding:11px 12px;background:#fff;border:1px solid #C9CEDB;border-radius:0;color:#0A1A3A;font-family:'Inter',system-ui,sans-serif;font-size:14px;line-height:1.3}\n  .esg-qv__sel:focus{outline:2px solid #0A1A3A;outline-offset:1px}\n  .esg-qv__add{width:100%;margin:20px 0 0;padding:15px 18px;background:#0A1A3A;border:1px solid #0A1A3A;border-radius:0;color:#fff;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:17px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;line-height:1;cursor:pointer;transition:background .15s ease,color .15s ease}\n  .esg-qv__add:hover:not([disabled]),.esg-qv__add:focus-visible:not([disabled]){background:#fff;color:#0A1A3A}\n  .esg-qv__add[disabled]{opacity:.5;cursor:default}\n  .esg-qv__note{font-size:12px;line-height:1.5;color:#2a3756;border-left:3px solid #0A1A3A;background:#F8F8F8;padding:10px 12px;margin:14px 0 0}\n  .esg-qv__full{display:inline-block;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#0A1A3A;text-decoration:none;border-bottom:1px solid #0A1A3A;margin:18px 0 0}\n  .esg-qv__load{font-size:13px;color:#6B7390;padding:26px 0}\n  .esg-qv__hide{display:none}\n  @media (max-width:560px){\n    .esg-qv{padding:12px}\n    .esg-qv__box{padding:22px 18px 24px}\n    .esg-qv__head{gap:14px}\n    .esg-qv__img{flex:0 0 74px;width:74px;height:74px}\n    .esg-qv__ttl{font-size:19px}\n  }\n</style>\n\n<script>\n  /* Opens for any click on .esg-qv-open or on a card body. The title\n     link is left alone so it still navigates to the full product page. */\n  (function () {\n    if (window.esgQuickView) return;\n    window.esgQuickView = true;\n\n    var root = null, box = null, lastFocus = null, current = null;\n\n    function money(cents) {\n      var s = (Math.round(cents) / 100).toFixed(2).split('.');\n      return '$' + s[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',') + '.' + s[1];\n    }\n\n    /* /products/<handle>.js returns options as objects ({name, position,\n       values}), not strings, so joining them raw prints [object Object].\n       Both shapes are handled since older endpoints return plain strings.\n       Shopify's placeholder name \"Title\" is not shown to shoppers. */\n    function optionLabel(data) {\n      var names = (data.options || []).map(function (o) {\n        return (o && typeof o === 'object') ? (o.name || '') : String(o || '');\n      }).filter(function (n) {\n        return n && n.toLowerCase() !== 'title';\n      });\n      return names.length ? names.join(' / ') : 'Option';\n    }\n\n    function el(tag, cls, txt) {\n      var n = document.createElement(tag);\n      if (cls) n.className = cls;\n      if (txt != null) n.textContent = txt;\n      return n;\n    }\n\n    function build() {\n      root = el('div', 'esg-qv');\n      root.setAttribute('role', 'dialog');\n      root.setAttribute('aria-modal', 'true');\n      root.setAttribute('aria-label', 'Product quick view');\n\n      var veil = el('div', 'esg-qv__veil');\n      veil.addEventListener('click', close);\n\n      box = el('div', 'esg-qv__box');\n\n      var x = el('button', 'esg-qv__x', '\\u00D7');\n      x.type = 'button';\n      x.setAttribute('aria-label', 'Close quick view');\n      x.addEventListener('click', close);\n\n      box.appendChild(x);\n      root.appendChild(veil);\n      root.appendChild(box);\n      document.body.appendChild(root);\n\n      document.addEventListener('keydown', function (e) {\n        if (e.key === 'Escape' && root.classList.contains('is-open')) close();\n      });\n    }\n\n    function close() {\n      if (!root) return;\n      root.classList.remove('is-open');\n      document.documentElement.style.overflow = '';\n      if (lastFocus && lastFocus.focus) lastFocus.focus();\n    }\n\n    function clear() {\n      while (box.childNodes.length > 1) box.removeChild(box.lastChild);\n    }\n\n    function open(card) {\n      if (!root) build();\n      lastFocus = document.activeElement;\n      current = card;\n      clear();\n      box.appendChild(el('p', 'esg-qv__load', 'Loading\\u2026'));\n      root.classList.add('is-open');\n      document.documentElement.style.overflow = 'hidden';\n      box.querySelector('.esg-qv__x').focus();\n\n      var handle = card.getAttribute('data-esg-handle');\n      var url = card.getAttribute('data-product-url') || ('/products/' + handle);\n\n      fetch('/products/' + handle + '.js', { headers: { 'Accept': 'application/json' } })\n        .then(function (r) {\n          if (!r.ok) throw new Error(r.status);\n          return r.json();\n        })\n        .then(function (data) { render(data, card, url); })\n        .catch(function () {\n          clear();\n          box.appendChild(el('p', 'esg-qv__note',\n            'This item could not be loaded here. Open the full product page to continue.'));\n          var a = el('a', 'esg-qv__full', 'View full details');\n          a.href = url;\n          box.appendChild(a);\n        });\n    }\n\n    function render(data, card, url) {\n      clear();\n\n      var head = el('div', 'esg-qv__head');\n      var imgWrap = el('span', 'esg-qv__img');\n      if (data.featured_image) {\n        var img = document.createElement('img');\n        img.src = data.featured_image.replace(/(\\.[a-z]+)(\\?|$)/i, '_240x$1$2');\n        img.alt = data.title;\n        imgWrap.appendChild(img);\n      }\n      head.appendChild(imgWrap);\n\n      var info = el('div');\n      var ttl = el('a', 'esg-qv__ttl', data.title);\n      ttl.href = url;\n      info.appendChild(ttl);\n\n      var priceRow = el('div', 'esg-qv__price');\n      info.appendChild(priceRow);\n      head.appendChild(info);\n      box.appendChild(head);\n\n      var desc = card.getAttribute('data-esg-desc');\n      if (desc) box.appendChild(el('p', 'esg-qv__desc', desc));\n\n      /* Variant picker built from the product JSON rather than copied\n         page markup, so it never depends on theme custom elements. */\n      var sel = null;\n      var live = data.variants.filter(function (v) { return v.available; });\n\n      if (data.variants.length > 1) {\n        box.appendChild(el('span', 'esg-qv__lbl', optionLabel(data)));\n        sel = el('select', 'esg-qv__sel');\n        sel.setAttribute('aria-label', optionLabel(data));\n        data.variants.forEach(function (v) {\n          var o = document.createElement('option');\n          o.value = v.id;\n          o.textContent = v.title + ' \\u2014 ' + money(v.price) + (v.available ? '' : ' \\u2014 Sold out');\n          o.disabled = !v.available;\n          sel.appendChild(o);\n        });\n        if (live.length) sel.value = live[0].id;\n        box.appendChild(sel);\n      }\n\n      var btn = el('button', 'esg-qv__add', 'Add to cart');\n      btn.type = 'button';\n      box.appendChild(btn);\n\n      var note = el('p', 'esg-qv__note esg-qv__hide');\n      box.appendChild(note);\n\n      var full = el('a', 'esg-qv__full', 'View full details');\n      full.href = url;\n      box.appendChild(full);\n\n      function currentVariant() {\n        var id = sel ? parseInt(sel.value, 10) : (live.length ? live[0].id : data.variants[0].id);\n        for (var i = 0; i < data.variants.length; i++) {\n          if (data.variants[i].id === id) return data.variants[i];\n        }\n        return null;\n      }\n\n      function paint() {\n        var v = currentVariant();\n        priceRow.textContent = '';\n        if (!v) return;\n        priceRow.appendChild(el('span', 'esg-qv__now', money(v.price)));\n        if (v.compare_at_price && v.compare_at_price > v.price) {\n          priceRow.appendChild(el('span', 'esg-qv__was', money(v.compare_at_price)));\n          priceRow.appendChild(el('span', 'esg-qv__save',\n            'Save ' + money(v.compare_at_price - v.price).replace(/\\.00$/, '')));\n        }\n        if (v.available) {\n          btn.textContent = 'Add to cart';\n          btn.removeAttribute('disabled');\n        } else {\n          btn.textContent = 'Sold out';\n          btn.setAttribute('disabled', 'disabled');\n        }\n      }\n\n      if (sel) sel.addEventListener('change', paint);\n      paint();\n\n      btn.addEventListener('click', function () {\n        var v = currentVariant();\n        if (!v || !v.available) return;\n        btn.setAttribute('disabled', 'disabled');\n        btn.textContent = 'Adding\\u2026';\n        note.className = 'esg-qv__note esg-qv__hide';\n\n        fetch('/cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n          body: JSON.stringify({ items: [{ id: v.id, quantity: 1 }] })\n        })\n          .then(function (r) {\n            return r.json().then(function (j) { return { ok: r.ok, body: j }; });\n          })\n          .then(function (res) {\n            if (!res.ok) throw new Error(res.body.description || res.body.message || 'Not added');\n            btn.textContent = 'Added to cart';\n            note.className = 'esg-qv__note';\n            note.textContent = data.title + ' was added to the cart.';\n            refreshCart();\n            setTimeout(paint, 2500);\n          })\n          .catch(function (err) {\n            note.className = 'esg-qv__note';\n            note.textContent = String(err.message || err);\n            paint();\n          });\n      });\n    }\n\n    /* Update the header count and let the theme's cart drawer resync. */\n    function refreshCart() {\n      fetch('/cart.js', { headers: { 'Accept': 'application/json' } })\n        .then(function (r) { return r.json(); })\n        .then(function (cart) {\n          document.querySelectorAll('#CartCount, .js-cart-count').forEach(function (n) {\n            n.textContent = cart.item_count;\n          });\n          document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:refresh'));\n        })\n        .catch(function () {});\n    }\n\n    document.addEventListener('click', function (evt) {\n      if (!evt.target.closest) return;\n\n      var trigger = evt.target.closest('.esg-qv-open');\n      var card = trigger ? trigger.closest('.esg-acc-card') : null;\n\n      if (!trigger) {\n        card = evt.target.closest('.esg-acc-card');\n        if (!card) return;\n        /* let real links and buttons behave normally */\n        if (evt.target.closest('a, button')) return;\n      }\n      if (!card) return;\n      if (!card.getAttribute('data-esg-handle')) return;\n\n      evt.preventDefault();\n      open(card);\n    });\n  })();\n</script>\n\n{%- endif -%}"
          }
        },
