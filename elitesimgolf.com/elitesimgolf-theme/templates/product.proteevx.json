        "custom_liquid_zWXpen": {
          "type": "custom-liquid",
          "name": "Fathers Day Sale Block",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Elite Sim Golf — Father's Day Sale Mini PDP Box\n  - Renders only for products tagged \"fathers-day\" (or \"dad-sale\")\n  - Auto-hides server-side after the cutoff (no JS hide needed)\n  - Matches VTrack PDP design language: Barlow Condensed, #0A1A3A navy, #086ED3 blue\n{%- endcomment -%}\n\n{%- assign sale_end_str = '2026-06-24 00:00:00' -%}\n{%- assign sale_end_ts  = sale_end_str | date: '%s' -%}\n{%- assign now_ts       = 'now' | date: '%s' -%}\n\n{%- assign is_dad_product = false -%}\n{%- assign tags_downcase = product.tags | join: '|' | downcase | split: '|' -%}\n{%- if tags_downcase contains 'dad' or tags_downcase contains 'dad-sale' or tags_downcase contains 'fathers-day' or tags_downcase contains \"father's day\" or tags_downcase contains 'fathers day' -%}\n  {%- assign is_dad_product = true -%}\n{%- endif -%}\n\n{%- if is_dad_product and now_ts < sale_end_ts -%}\n<div class=\"esg-dad-sale\">\n  <div class=\"esg-dad-sale__accent\"></div>\n\n  <div class=\"esg-dad-sale__eyebrow\">\n    <span class=\"esg-dad-sale__eyebrow-icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"3\" y=\"8\" width=\"18\" height=\"13\" rx=\"1.5\"></rect>\n        <path d=\"M3 12h18\"></path>\n        <path d=\"M12 8v13\"></path>\n        <path d=\"M12 8c-2.5 0-4-1.2-4-3a2 2 0 0 1 4-2c2 0 4 2.5 4 5\"></path>\n        <path d=\"M12 8c2.5 0 4-1.2 4-3a2 2 0 0 0-4-2c-2 0-4 2.5-4 5\"></path>\n      </svg>\n    </span>\n    Father's Day Sale\n  </div>\n\n  <h3 class=\"esg-dad-sale__title\">Give Dad the Ultimate Golf Gift.</h3>\n\n  <div class=\"esg-dad-sale__coupon\">\n    <div class=\"esg-dad-sale__coupon-label\">Coupon Code</div>\n    <div class=\"esg-dad-sale__coupon-code\">DADSDAY</div>\n  </div>\n\n  <div class=\"esg-dad-sale__copy\">\n    Save on simulator packages, launch monitors, enclosures, projectors, mats, and accessories. For the best deal, text <a href=\"sms:+18652482729\" class=\"esg-dad-sale__phone\">865-248-2729</a>.\n  </div>\n</div>\n\n<style>\n  .esg-dad-sale {\n    max-width: 600px;\n    margin: 12px 0;\n    position: relative;\n    overflow: hidden;\n    padding: 12px 14px 13px;\n    border: 1px solid rgba(255, 255, 255, .14);\n    border-radius: 14px;\n    background: linear-gradient(135deg, #020617 0%, #071a33 55%, #0A1A3A 100%);\n    color: #C9D6F2;\n    font-family: inherit;\n    line-height: 1.4;\n    box-shadow: 0 10px 24px rgba(15, 23, 42, .18);\n  }\n\n  .esg-dad-sale__accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 3px;\n    background: linear-gradient(90deg, #086ED3 0%, #ffffff 100%);\n  }\n\n  .esg-dad-sale__eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    margin-bottom: 8px;\n    color: #C9D6F2;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .esg-dad-sale__eyebrow-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 16px;\n    height: 16px;\n    color: #086ED3;\n  }\n\n  .esg-dad-sale__eyebrow-icon svg {\n    width: 16px;\n    height: 16px;\n    display: block;\n  }\n\n  .esg-dad-sale__title {\n    margin: 0 0 10px;\n    color: #ffffff;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: clamp(18px, 2vw, 22px);\n    font-weight: 800;\n    letter-spacing: -.01em;\n    line-height: 1.05;\n    text-transform: uppercase;\n  }\n\n  .esg-dad-sale__coupon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    margin-bottom: 10px;\n    padding: 8px 12px;\n    border-radius: 10px;\n    background: #ffffff;\n    border: 1px solid rgba(8, 110, 211, .25);\n  }\n\n  .esg-dad-sale__coupon-label {\n    color: #2a3756;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .esg-dad-sale__coupon-code {\n    color: #086ED3;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 20px;\n    font-weight: 800;\n    letter-spacing: .12em;\n    line-height: 1;\n  }\n\n  .esg-dad-sale__copy {\n    color: #C9D6F2;\n    font-size: 12.5px;\n    line-height: 1.4;\n  }\n\n  .esg-dad-sale__phone {\n    color: #ffffff;\n    font-weight: 800;\n    white-space: nowrap;\n    text-decoration: underline;\n    text-decoration-color: rgba(255, 255, 255, .35);\n    text-underline-offset: 2px;\n  }\n\n  .esg-dad-sale__phone:hover {\n    text-decoration-color: #ffffff;\n  }\n\n  @media (max-width: 749px) {\n    .esg-dad-sale {\n      padding: 11px 12px 12px;\n      border-radius: 12px;\n    }\n\n    .esg-dad-sale__title {\n      font-size: 18px;\n    }\n\n    .esg-dad-sale__coupon {\n      flex-direction: column;\n      gap: 2px;\n      padding: 7px 10px;\n    }\n\n    .esg-dad-sale__coupon-code {\n      font-size: 18px;\n    }\n\n    .esg-dad-sale__copy {\n      font-size: 12px;\n    }\n  }\n</style>\n{%- endif -%}"
          }
