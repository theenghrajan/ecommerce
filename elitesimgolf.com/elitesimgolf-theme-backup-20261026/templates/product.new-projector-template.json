        "custom_liquid_tbWYJT": {
          "type": "custom-liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Elite Sim Golf — Full-Width Trust Bar (Flat, Configurable)\n  ---------------------------------------------------------------\n  Default 4 items, in order:\n    1. Live Chat + Call/Text (combined)\n    2. Price Match Guarantee\n    3. Authorized {{ product.vendor }} Dealer\n    4. Financing Available\n\n  Available item slugs:\n    chat_call, price_match, authorized, financing,\n    shipping, guarantee, family_owned\n\n  \"guarantee\" only renders if product is tagged\n    30-day-guarantee / 30-day-trial / 30day / 30-day\n\n  Bar auto-flows between 4 / 3 / 2 / 1 columns based on item count.\n  Default: light. Add class \"esg-trust-bar--dark\" for navy variant.\n{%- endcomment -%}\n\n{%- comment -%} ====== EDIT THIS LIST TO CHANGE ITEMS ====== {%- endcomment -%}\n{%- assign items = 'chat_call,price_match,authorized,financing' | split: ',' -%}\n\n{%- comment -%} 30-Day guarantee tag check {%- endcomment -%}\n{%- assign tags_dc = product.tags | join: '|' | downcase | split: '|' -%}\n{%- assign show_guarantee = false -%}\n{%- if tags_dc contains '30-day-guarantee' or tags_dc contains '30-day-trial' or tags_dc contains '30day' or tags_dc contains '30-day' -%}\n  {%- assign show_guarantee = true -%}\n{%- endif -%}\n\n{%- assign vendor_name = product.vendor | default: 'Top Brands' -%}\n\n{%- comment -%} Build active list, filtering guarantee when ineligible {%- endcomment -%}\n{%- assign active = '' -%}\n{%- for slug in items -%}\n  {%- assign s = slug | strip -%}\n  {%- if s == 'guarantee' and show_guarantee == false -%}{%- continue -%}{%- endif -%}\n  {%- if active == '' -%}\n    {%- assign active = s -%}\n  {%- else -%}\n    {%- assign active = active | append: ',' | append: s -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- assign active_items = active | split: ',' -%}\n{%- assign item_count = active_items.size -%}\n\n<div class=\"esg-trust-bar esg-trust-bar--cols-{{ item_count }}\">\n  <div class=\"esg-trust-bar__accent\"></div>\n  <div class=\"esg-trust-bar__inner\">\n\n    {%- for slug in active_items -%}\n\n      {%- if slug == 'chat_call' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path>\n              <circle cx=\"9\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <circle cx=\"12.5\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <circle cx=\"16\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Live Chat &amp; Real Experts</div>\n            <div class=\"esg-trust-bar__actions\">\n              <a href=\"javascript:void(0);\"\n                 class=\"esg-trust-bar__btn esg-trust-bar__btn--primary esg-trust-bar__chat-btn\"\n                 data-esg-chat-trigger>\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                Start a Live Chat\n              </a>\n              <a href=\"tel:+18652482729\"\n                 class=\"esg-trust-bar__btn esg-trust-bar__btn--secondary\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg>\n                Call or Text 865-248-2729\n              </a>\n            </div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'price_match' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M20.59 13.41 11.17 22a2 2 0 0 1-2.83 0L2 15.66a2 2 0 0 1 0-2.83L11.41 3.41A2 2 0 0 1 12.83 3H20a2 2 0 0 1 2 2v7.17a2 2 0 0 1-.59 1.24z\"></path>\n              <circle cx=\"7.5\" cy=\"7.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <path d=\"m9 14 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Price Match Guarantee</div>\n            <div class=\"esg-trust-bar__text\">Find a lower price and we'll match or beat it — no questions asked.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'authorized' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z\"></path>\n              <path d=\"m9 12 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Authorized {{ vendor_name | escape }} Dealer</div>\n            <div class=\"esg-trust-bar__text\">Premier {{ vendor_name | escape }} partner with full warranty support.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'financing' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"></rect>\n              <line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"></line>\n              <line x1=\"6\" y1=\"15\" x2=\"10\" y2=\"15\"></line>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Financing Available</div>\n            <div class=\"esg-trust-bar__text\">Pay over time with Shop Pay, Affirm, or Klarna.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'shipping' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n              <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n              <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n              <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Fast &amp; Free Shipping</div>\n            <div class=\"esg-trust-bar__text\">Free expedited delivery on most orders (exclusions apply).</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'guarantee' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z\"></path>\n              <path d=\"m9 12 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">30-Day Risk-Free Guarantee</div>\n            <div class=\"esg-trust-bar__text\">Not happy? Send it back — no hassle.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'family_owned' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M3 11.5 12 4l9 7.5\"></path>\n              <path d=\"M5 10v10h14V10\"></path>\n              <path d=\"M12 20v-6\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Family-Owned, U.S. Based</div>\n            <div class=\"esg-trust-bar__text\">Real inventory, real people — not a dropshipper.</div>\n          </div>\n        </div>\n\n      {%- endif -%}\n\n    {%- endfor -%}\n\n  </div>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  // ---------- Chat opener ----------\n  function clickEl(el) {\n    if (!el) return false;\n    try {\n      if (typeof el.open === 'function') { el.open(); return true; }\n      el.click();\n      return true;\n    } catch (e) { return false; }\n  }\n\n  // Generic shadow-root walk — fallback if Inbox host id ever changes.\n  function findInShadowRoots() {\n    var hosts = document.querySelectorAll('*');\n    for (var i = 0; i < hosts.length; i++) {\n      var sr = hosts[i].shadowRoot;\n      if (!sr) continue;\n      var btn = sr.querySelector('button.chat-toggle, button[class*=\"chat-toggle\" i], button[aria-label*=\"chat\" i], button[aria-label*=\"message\" i]');\n      if (btn) return btn;\n    }\n    return null;\n  }\n\n  function openChat() {\n    // 1. Shopify Inbox — host is <inbox-online-store-chat> with button.chat-toggle in its shadow root.\n    var inboxHostSelectors = [\n      'inbox-online-store-chat',\n      '#chat-button-container',\n      '#ShopifyChat',\n      '#shopify-chat'\n    ];\n    for (var h = 0; h < inboxHostSelectors.length; h++) {\n      var host = document.querySelector(inboxHostSelectors[h]);\n      if (host && host.shadowRoot) {\n        var btn = host.shadowRoot.querySelector('button.chat-toggle, button[class*=\"chat-toggle\" i], button[aria-label*=\"chat\" i]');\n        if (btn && clickEl(btn)) return true;\n      }\n    }\n\n    // 2. Generic: walk every shadow root on the page.\n    var shadowBtn = findInShadowRoots();\n    if (shadowBtn && clickEl(shadowBtn)) return true;\n\n    // 2. Light-DOM selectors (in case the widget exposes a regular button).\n    var inboxSelectors = [\n      'shopify-chat',\n      'shopify-chat-button',\n      '#ShopifyChat',\n      '#shopify-chat',\n      '.shopify-chat',\n      '#shopify-chat-launcher',\n      '#ShopifyChat-launcher',\n      '[data-shopify-chat]',\n      'button.chat-toggle',\n      'button[aria-label*=\"chat\" i]',\n      'button[aria-label*=\"message\" i]'\n    ];\n    for (var i = 0; i < inboxSelectors.length; i++) {\n      var el = document.querySelector(inboxSelectors[i]);\n      if (el) {\n        var clickable = el.tagName === 'BUTTON' || el.tagName === 'A'\n          ? el\n          : (el.querySelector('button, a, [role=\"button\"]') || el);\n        if (clickEl(clickable)) return true;\n      }\n    }\n\n    // 3. Fallback: post message into a Shopify chat iframe.\n    var iframe = document.querySelector('iframe[src*=\"shopify\"][src*=\"chat\"], iframe[id*=\"ShopifyChat\" i], iframe[id*=\"chat\" i], iframe[name*=\"shopify-chat\" i]');\n    if (iframe && iframe.contentWindow) {\n      try {\n        iframe.contentWindow.postMessage({ type: 'open' }, '*');\n        iframe.contentWindow.postMessage({ action: 'open' }, '*');\n        if (iframe.parentElement) iframe.parentElement.click();\n        return true;\n      } catch (e) {}\n    }\n\n    // 4. Programmatic APIs (other providers, kept as fallback).\n    if (window.ShopifyChat && typeof window.ShopifyChat.open === 'function') {\n      try { window.ShopifyChat.open(); return true; } catch (e) {}\n    }\n    if (window.tidioChatApi && typeof window.tidioChatApi.open === 'function') {\n      try { window.tidioChatApi.open(); return true; } catch (e) {}\n    }\n    if (window.$crisp) {\n      try { window.$crisp.push(['do', 'chat:open']); return true; } catch (e) {}\n    }\n    if (window.Gorgias) {\n      try { window.Gorgias('open'); return true; } catch (e) {}\n    }\n    if (window.zE) {\n      try { window.zE('messenger', 'open'); return true; } catch (e) {}\n    }\n    return false;\n  }\n\n  function attempt(maxTries) {\n    var tries = 0;\n    function go() {\n      tries++;\n      if (openChat()) return;\n      if (tries < maxTries) setTimeout(go, 300);\n      else {\n        // Last resort — let the user know to use phone\n        window.location.href = 'sms:+18652482729';\n      }\n    }\n    go();\n  }\n\n  function bind() {\n    var triggers = document.querySelectorAll('[data-esg-chat-trigger]');\n    Array.prototype.forEach.call(triggers, function (el) {\n      el.addEventListener('click', function (e) {\n        e.preventDefault();\n        // Retry up to ~3s in case the widget script hasn't injected yet\n        attempt(10);\n      });\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', bind);\n  } else {\n    bind();\n  }\n})();\n</script>\n\n<style>\n  .esg-trust-bar {\n    position: relative;\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n    border-top: 1px solid #e5e7eb;\n    border-bottom: 1px solid #e5e7eb;\n    color: #2a3756;\n    font-family: inherit;\n    line-height: 1.4;\n    overflow: hidden;\n  }\n\n  .esg-trust-bar__accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 5px;\n    background: #086ED3;\n    z-index: 1;\n  }\n\n  .esg-trust-bar__inner {\n    max-width: 1500px;\n    margin: 0 auto;\n    padding: 28px 32px;\n    display: grid;\n    gap: 24px 28px;\n    align-items: center;\n  }\n\n  .esg-trust-bar--cols-4 .esg-trust-bar__inner { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-3 .esg-trust-bar__inner { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-2 .esg-trust-bar__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-1 .esg-trust-bar__inner { grid-template-columns: 1fr; }\n\n  .esg-trust-bar__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 10px;\n    min-width: 0;\n    position: relative;\n    padding: 0 8px;\n  }\n\n  .esg-trust-bar__item + .esg-trust-bar__item::before {\n    content: '';\n    position: absolute;\n    left: -14px;\n    top: 10%;\n    bottom: 10%;\n    width: 1px;\n    background: rgba(8, 110, 211, .18);\n  }\n\n  .esg-trust-bar__icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 64px;\n    height: 64px;\n    min-width: 64px;\n    border-radius: 16px;\n    background: #ffffff;\n    color: #086ED3;\n    flex: 0 0 auto;\n    border: 1px solid rgba(8, 110, 211, .18);\n  }\n\n  .esg-trust-bar__icon svg { width: 32px; height: 32px; display: block; }\n\n  .esg-trust-bar__content { min-width: 0; width: 100%; }\n\n  .esg-trust-bar__title {\n    color: #0A1A3A;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 18px;\n    font-weight: 800;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    line-height: 1.1;\n    margin-bottom: 3px;\n  }\n\n  .esg-trust-bar__text {\n    color: #2a3756;\n    font-size: 13.5px;\n    line-height: 1.45;\n  }\n\n  .esg-trust-bar__link {\n    color: #086ED3;\n    font-weight: 700;\n    text-decoration: none;\n    border-bottom: 1px solid rgba(8, 110, 211, .35);\n    white-space: nowrap;\n    cursor: pointer;\n  }\n\n  .esg-trust-bar__link:hover { border-bottom-color: #086ED3; }\n\n  .esg-trust-bar__sep {\n    margin: 0 6px;\n    color: rgba(8, 110, 211, .45);\n  }\n\n  /* ---------- Action buttons ---------- */\n  .esg-trust-bar__actions {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 6px;\n    margin-top: 6px;\n  }\n\n  .esg-trust-bar__btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 5px;\n    padding: 6px 11px;\n    border-radius: 999px;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    line-height: 1;\n    text-decoration: none;\n    border: 1px solid transparent;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: background-color .15s ease, color .15s ease, border-color .15s ease;\n  }\n  .esg-trust-bar__btn svg { width: 12px; height: 12px; display: block; flex: 0 0 auto; }\n\n  .esg-trust-bar__btn--primary {\n    background: #086ED3;\n    color: #ffffff;\n    border-color: #086ED3;\n  }\n  .esg-trust-bar__btn--primary:hover {\n    background: #0A1A3A;\n    border-color: #0A1A3A;\n    color: #ffffff;\n  }\n\n  .esg-trust-bar__btn--secondary {\n    background: #ffffff;\n    color: #086ED3;\n    border-color: rgba(8, 110, 211, .35);\n  }\n  .esg-trust-bar__btn--secondary:hover {\n    background: #f0f7ff;\n    border-color: #086ED3;\n    color: #086ED3;\n  }\n\n  /* ---------- Dark variant ---------- */\n  .esg-trust-bar--dark {\n    background: #0A1A3A;\n    border-top-color: rgba(255, 255, 255, .08);\n    border-bottom-color: rgba(255, 255, 255, .08);\n    color: #C9D6F2;\n  }\n  .esg-trust-bar--dark .esg-trust-bar__accent { background: #086ED3; }\n  .esg-trust-bar--dark .esg-trust-bar__icon {\n    background: rgba(255, 255, 255, .06);\n    color: #ffffff;\n    border-color: rgba(255, 255, 255, .14);\n  }\n  .esg-trust-bar--dark .esg-trust-bar__title { color: #ffffff; }\n  .esg-trust-bar--dark .esg-trust-bar__text { color: #C9D6F2; }\n  .esg-trust-bar--dark .esg-trust-bar__link {\n    color: #ffffff;\n    border-bottom-color: rgba(255, 255, 255, .35);\n  }\n  .esg-trust-bar--dark .esg-trust-bar__link:hover { border-bottom-color: #ffffff; }\n  .esg-trust-bar--dark .esg-trust-bar__sep { color: rgba(255, 255, 255, .35); }\n  .esg-trust-bar--dark .esg-trust-bar__btn--primary {\n    background: #086ED3; color: #ffffff; border-color: #086ED3;\n  }\n  .esg-trust-bar--dark .esg-trust-bar__btn--primary:hover {\n    background: #ffffff; color: #0A1A3A; border-color: #ffffff;\n  }\n  .esg-trust-bar--dark .esg-trust-bar__btn--secondary {\n    background: transparent; color: #ffffff;\n    border-color: rgba(255, 255, 255, .35);\n  }\n  .esg-trust-bar--dark .esg-trust-bar__btn--secondary:hover {\n    background: rgba(255, 255, 255, .08);\n    border-color: #ffffff; color: #ffffff;\n  }\n  .esg-trust-bar--dark .esg-trust-bar__item + .esg-trust-bar__item::before {\n    background: rgba(255, 255, 255, .14);\n  }\n\n  /* ---------- Breakpoints ---------- */\n  @media (max-width: 1024px) {\n    .esg-trust-bar--cols-4 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-3 .esg-trust-bar__inner {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 20px 24px;\n      padding: 22px 24px;\n    }\n    .esg-trust-bar__item + .esg-trust-bar__item::before { display: none; }\n  }\n\n  @media (max-width: 600px) {\n    .esg-trust-bar--cols-4 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-3 .esg-trust-bar__inner,\n    .esg-trust-bar--cols-2 .esg-trust-bar__inner {\n      grid-template-columns: 1fr;\n      gap: 16px;\n      padding: 18px 18px;\n    }\n    .esg-trust-bar__icon { width: 56px; height: 56px; min-width: 56px; border-radius: 14px; }\n    .esg-trust-bar__icon svg { width: 28px; height: 28px; }\n    .esg-trust-bar__title { font-size: 16px; }\n    .esg-trust-bar__text { font-size: 13px; }\n    .esg-trust-bar__btn { font-size: 12px; padding: 7px 12px; }\n  }\n</style>"
          }
