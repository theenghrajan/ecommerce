      "name": "Custom: Benefits",
      "settings": {
        "id": "sn-benefits",
        "text": "<h2>Who the BenQ AH30ST Is For</h2><p>Choose the <strong>BenQ AH30ST</strong> if you want a <strong>dedicated 1080P golf simulator projector</strong> that:</p>",
        "columns": "4",
        "align": "left",
        "background_color": "#2953b9",
        "heading_color": "#ffffff",
        "text_color": "#f8f8f8",
        "accent_color": "#ffffff",
        "btn_bg": "",
        "btn_text": "",
        "icon_bg": "#6dd8ff",
        "vp-desktop": 72,
        "hp-desktop": 24,
        "vp-mobile": 48,
