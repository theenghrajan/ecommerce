        "custom_liquid_fMCmMX": {
          "type": "custom-liquid",
          "name": "New Universal Ship Box",
          "settings": {
            "custom_liquid": "{%- assign total_inventory = 0 -%}\n{%- for variant in product.variants -%}\n  {%- assign total_inventory = total_inventory | plus: variant.inventory_quantity -%}\n{%- endfor -%}\n\n{%- if total_inventory > 0 -%}\n<div class=\"esg-shipbox-universal\">\n  <div class=\"esg-shipbox-universal__top\">\n    <div class=\"esg-shipbox-universal__title\">\n      <span class=\"esg-shipbox-universal__title-icon\" aria-hidden=\"true\">\n        <!-- Shield Check Icon -->\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n          <path d=\"M9 12l2 2 4-4\"></path>\n        </svg>\n      </span>\n      <span>Elite Sim Golf Advantage</span>\n    </div>\n  </div>\n\n  <div class=\"esg-shipbox-universal__status\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M20 6L9 17l-5-5\"></path>\n    </svg>\n    IN STOCK • READY TO SHIP\n  </div>\n\n  <div class=\"esg-shipbox-universal__text\">\n    We stock this item so you can expect fast fulfillment and real post-purchase support if you need help.\n  </div>\n\n  <div id=\"esg-2pm-countdown-wrap\" class=\"esg-shipbox-universal__countdown-wrap\">\n    <div class=\"esg-shipbox-universal__countdown-copy\">\n      <div class=\"esg-shipbox-universal__cutoff-label\">Same-Day Shipping Cutoff</div>\n      <div class=\"esg-shipbox-universal__cutoff-subtext\">\n        Order by <strong>2:00 PM ET</strong>\n      </div>\n    </div>\n    <div id=\"esg-2pm-time\" class=\"esg-shipbox-universal__clock\">--:--:--</div>\n  </div>\n</div>\n\n<style>\n  .esg-shipbox-universal {\n    max-width: 1100px;\n    margin: 14px 0;\n    padding: 16px 18px;\n    border: 1px solid #bbf7d0; /* Soft mint green border */\n    border-radius: 10px;\n    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); /* Fresh green gradient */\n    box-shadow: 0 3px 6px rgba(34, 197, 94, 0.05); /* Gentle green shadow */\n    color: #334155;\n    line-height: 1.4;\n  }\n  .esg-shipbox-universal__top {\n    margin-bottom: 8px;\n  }\n  .esg-shipbox-universal__title {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 15px;\n    font-weight: 800;\n    color: #064e3b; /* Deep forest green text */\n    letter-spacing: .2px;\n  }\n  .esg-shipbox-universal__title-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 18px;\n    height: 18px;\n    color: #16a34a; /* Vibrant emerald green icon */\n  }\n  .esg-shipbox-universal__title-icon svg {\n    width: 18px;\n    height: 18px;\n    display: block;\n  }\n  .esg-shipbox-universal__status {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    padding: 6px 12px;\n    border-radius: 999px;\n    background: #ffffff;\n    border: 1px solid #86efac; /* Green status border */\n    color: #15803d; /* Stronger green for status */\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: .05em;\n    white-space: nowrap;\n    box-shadow: 0 2px 4px rgba(22, 163, 74, 0.1);\n    margin-bottom: 10px;\n  }\n  .esg-shipbox-universal__status svg {\n    width: 12px;\n    height: 12px;\n  }\n  .esg-shipbox-universal__text {\n    font-size: 13.5px;\n    color: #3f6212;\n    margin-bottom: 14px;\n  }\n  .esg-shipbox-universal__countdown-wrap {\n    margin: 0;\n    padding: 12px 14px;\n    border-radius: 12px;\n    border: 1px solid #bbf7d0; /* Soft green border for inner box */\n    background: #ffffff; /* Clean white inner box */\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    flex-wrap: wrap;\n    box-shadow: 0 2px 4px rgba(34, 197, 94, 0.05);\n  }\n  .esg-shipbox-universal__countdown-copy {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n  .esg-shipbox-universal__cutoff-label {\n    font-size: 11px;\n    font-weight: 900;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #16a34a; /* Emerald green */\n  }\n  .esg-shipbox-universal__cutoff-subtext {\n    font-size: 13px;\n    color: #3f6212;\n    font-weight: 700;\n  }\n  .esg-shipbox-universal__cutoff-subtext strong {\n    color: #064e3b;\n    font-weight: 800;\n  }\n  .esg-shipbox-universal__clock {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 150px;\n    padding: 8px 14px;\n    border-radius: 8px;\n    background: #064e3b; /* Deep forest green clock background */\n    color: #ffffff;\n    font-weight: 800;\n    font-size: 20px;\n    letter-spacing: .12em;\n    line-height: 1;\n    font-variant-numeric: tabular-nums;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;\n    box-shadow: inset 0 2px 4px rgba(0,0,0,.2);\n  }\n\n  @media (max-width: 749px) {\n    .esg-shipbox-universal {\n      padding: 14px;\n    }\n    .esg-shipbox-universal__title {\n      font-size: 14.5px;\n    }\n    .esg-shipbox-universal__status {\n      font-size: 11.5px;\n    }\n    .esg-shipbox-universal__text {\n      font-size: 13px;\n    }\n    .esg-shipbox-universal__countdown-wrap {\n      padding: 10px 12px;\n    }\n    .esg-shipbox-universal__cutoff-label {\n      font-size: 10.5px;\n    }\n    .esg-shipbox-universal__cutoff-subtext {\n      font-size: 12px;\n    }\n    .esg-shipbox-universal__clock {\n      min-width: 130px;\n      font-size: 17px;\n      padding: 8px 12px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  var wrap = document.getElementById('esg-2pm-countdown-wrap');\n  var timeEl = document.getElementById('esg-2pm-time');\n  if (!wrap || !timeEl) return;\n\n  function getETParts(date) {\n    var parts = new Intl.DateTimeFormat('en-US', {\n      timeZone: 'America/New_York',\n      year: 'numeric',\n      month: '2-digit',\n      day: '2-digit',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n      hour12: false\n    }).formatToParts(date);\n\n    var out = {};\n    parts.forEach(function(p) { out[p.type] = p.value; });\n    return out;\n  }\n\n  function pad(n) {\n    return String(n).padStart(2, '0');\n  }\n\n  function update() {\n    var now = new Date();\n    var p = getETParts(now);\n    var hh = parseInt(p.hour, 10);\n    var mm = parseInt(p.minute, 10);\n    var ss = parseInt(p.second, 10);\n\n    var nowSec = hh * 3600 + mm * 60 + ss;\n    var cutoffSec = 14 * 3600;\n    var remaining = cutoffSec - nowSec;\n\n    if (remaining <= 0) {\n      wrap.style.display = 'none';\n      return;\n    }\n\n    var rH = Math.floor(remaining / 3600);\n    var rM = Math.floor((remaining % 3600) / 60);\n    var rS = remaining % 60;\n\n    timeEl.textContent = pad(rH) + \":\" + pad(rM) + \":\" + pad(rS);\n  }\n\n  update();\n  setInterval(update, 1000);\n})();\n</script>\n{%- endif -%}"
          }
