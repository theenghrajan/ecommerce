        "custom_liquid_iD9iTc": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "<div class=\"esg-why-buy-box\">\n  <div class=\"esg-why-buy-header\">\n    <span class=\"esg-why-buy-header-icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M20 6 9 17l-5-5\"></path>\n      </svg>\n    </span>\n    <span>Why Buy from Elite Sim Golf</span>\n  </div>\n\n  <div class=\"esg-why-buy-grid\">\n    <!-- Item 1: Authorized Dealer -->\n    <div class=\"esg-why-buy-item\">\n      <div class=\"esg-why-buy-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n          <path d=\"M22 4L12 14.01l-3-3\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-why-buy-content\">\n        <div class=\"esg-why-buy-title\">Authorized {{ product.vendor }} Dealer</div>\n        <div class=\"esg-why-buy-text\">Premier {{ product.vendor }} Partner.</div>\n      </div>\n    </div>\n\n    <!-- Item 2: Fast Shipping -->\n    <div class=\"esg-why-buy-item\">\n      <div class=\"esg-why-buy-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n          <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n          <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        </svg>\n      </div>\n      <div class=\"esg-why-buy-content\">\n        <div class=\"esg-why-buy-title\">Ships Same Business Day*</div>\n        <div class=\"esg-why-buy-text\">Orders placed before <strong>2PM EST.</strong></div>\n      </div>\n    </div>\n\n    <!-- Item 3: Free Shipping -->\n    <div class=\"esg-why-buy-item\">\n      <div class=\"esg-why-buy-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path>\n          <polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"></polyline>\n          <line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"></line>\n        </svg>\n      </div>\n      <div class=\"esg-why-buy-content\">\n        <div class=\"esg-why-buy-title\">Free Shipping on Most Orders</div>\n        <div class=\"esg-why-buy-text\">Ships free, may qualify for no sales tax.</div>\n      </div>\n    </div>\n\n    <!-- Item 4: Real Experts -->\n    <div class=\"esg-why-buy-item\">\n      <div class=\"esg-why-buy-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-why-buy-content\">\n        <div class=\"esg-why-buy-title\">Real Golf Experts, Not Bots</div>\n        <div class=\"esg-why-buy-text\">Call <strong>866-4-SIM-GOLF</strong> anytime.</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .esg-why-buy-box {\n    max-width: 1100px;\n    margin: 14px 0;\n    padding: 12px 16px;\n    border: 1px solid #e2e8f0;\n    border-radius: 10px;\n    background: #ffffff;\n    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.02);\n    color: #334155;\n    line-height: 1.35;\n  }\n  .esg-why-buy-header {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 11.5px;\n    font-weight: 800;\n    color: #64748b;\n    text-transform: uppercase;\n    letter-spacing: .05em;\n    margin-bottom: 12px;\n  }\n  .esg-why-buy-header-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 14px;\n    height: 14px;\n    color: #086ed3; /* Keeps your signature blue accent for headers */\n  }\n  .esg-why-buy-header-icon svg {\n    width: 14px;\n    height: 14px;\n    display: block;\n  }\n  .esg-why-buy-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 12px 16px; /* Replaces messy borders with clean gaps */\n  }\n  .esg-why-buy-item {\n    display: flex;\n    align-items: flex-start; /* Aligns icon with top line of text */\n    gap: 8px;\n  }\n  .esg-why-buy-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 26px;\n    height: 26px;\n    min-width: 26px;\n    border-radius: 6px;\n    background: #eff6ff; /* Soft blue background to match the style */\n    color: #2563eb; /* Vibrant blue SVG */\n    flex: 0 0 auto;\n    margin-top: 2px; /* Slight nudge down to center with title */\n  }\n  .esg-why-buy-icon svg {\n    width: 14px;\n    height: 14px;\n  }\n  .esg-why-buy-content {\n    min-width: 0;\n  }\n  .esg-why-buy-title {\n    font-size: 13px;\n    font-weight: 800;\n    color: #0f172a;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis; /* Prevents long vendor names from breaking layout */\n  }\n  .esg-why-buy-text {\n    font-size: 12px;\n    color: #64748b;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .esg-why-buy-text strong {\n    color: #334155;\n    font-weight: 800;\n  }\n\n  @media (max-width: 749px) {\n    .esg-why-buy-box {\n      padding: 12px 14px;\n    }\n    .esg-why-buy-grid {\n      grid-template-columns: 1fr; /* Stacks to single column on mobile */\n      gap: 12px;\n    }\n    .esg-why-buy-title,\n    .esg-why-buy-text {\n      white-space: normal; /* Lets text wrap naturally on tiny screens */\n    }\n  }\n</style>"
