          "settings": {
            "custom_liquid": "{%- if product.type == 'Projector' -%}\n<div class=\"esg-projector-fit-box\">\n  <div class=\"esg-projector-fit-box__top\">\n    <div class=\"esg-projector-fit-box__title\">\n      <span class=\"esg-projector-fit-box__title-icon\" aria-hidden=\"true\">\n        <!-- Expand / Fitment Icon -->\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M15 3h6v6\"></path>\n          <path d=\"M9 21H3v-6\"></path>\n          <path d=\"M21 3l-7 7\"></path>\n          <path d=\"M3 21l7-7\"></path>\n        </svg>\n      </span>\n      <span>Will This Projector Fit My Space?</span>\n    </div>\n  </div>\n  <div class=\"esg-projector-fit-box__text\">\n    Use our projector fitment tool to check screen size, aspect ratio, and mounting distance before you buy.\n  </div>\n  <div class=\"esg-projector-fit-box__action\">\n    <a href=\"/blogs/faq/golf-simulator-projector-fitment-tool\" class=\"esg-projector-fit-box__button\">\n      Check Fitment\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M5 12h14\"></path>\n        <path d=\"m12 5 7 7-7 7\"></path>\n      </svg>\n    </a>\n  </div>\n</div>\n\n<style>\n  .esg-projector-fit-box {\n    max-width: 1100px;\n    margin: 14px 0;\n    padding: 16px 18px;\n    border: 1px solid #bae6fd; /* Soft sky blue border */\n    border-radius: 10px;\n    background: linear-gradient(135deg, #eff6ff 0%, #e0f2fe 100%); /* Fresh, soft blue gradient */\n    box-shadow: 0 3px 6px rgba(14, 165, 233, 0.05); /* Gentle colored shadow */\n    color: #334155;\n    line-height: 1.4;\n  }\n  .esg-projector-fit-box__top {\n    margin-bottom: 6px;\n  }\n  .esg-projector-fit-box__title {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 15px;\n    font-weight: 800;\n    color: #0f172a; /* Deep navy text for high legibility */\n    letter-spacing: .2px;\n  }\n  .esg-projector-fit-box__title-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 18px;\n    height: 18px;\n    color: #2563eb; /* Vibrant royal blue icon */\n  }\n  .esg-projector-fit-box__title-icon svg {\n    width: 18px;\n    height: 18px;\n    display: block;\n  }\n  .esg-projector-fit-box__text {\n    font-size: 13.5px;\n    color: #475569;\n    margin-bottom: 14px;\n  }\n  .esg-projector-fit-box__action {\n    display: flex;\n  }\n  .esg-projector-fit-box__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    text-decoration: none;\n    border: none;\n    border-radius: 999px; /* Pill shape for a friendly CTA */\n    padding: 10px 18px;\n    background: #2563eb; /* Energetic royal blue button */\n    color: #ffffff;\n    font-weight: 700;\n    font-size: 13.5px;\n    line-height: 1;\n    box-shadow: 0 3px 6px rgba(37, 99, 235, 0.25);\n    transition: all 0.2s ease;\n  }\n  .esg-projector-fit-box__button:hover {\n    background: #1d4ed8; /* Deeper blue on hover */\n    transform: translateY(-1px);\n    box-shadow: 0 5px 8px rgba(37, 99, 235, 0.35);\n    color: #ffffff;\n  }\n  .esg-projector-fit-box__button svg {\n    width: 14px;\n    height: 14px;\n    transition: transform 0.2s ease;\n  }\n  .esg-projector-fit-box__button:hover svg {\n    transform: translateX(3px); /* Small nudge animation */\n  }\n\n  @media (max-width: 749px) {\n    .esg-projector-fit-box {\n      padding: 14px;\n    }\n    .esg-projector-fit-box__title {\n      font-size: 14.5px;\n    }\n    .esg-projector-fit-box__text {\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n    .esg-projector-fit-box__button {\n      width: 100%;\n      padding: 12px 16px;\n    }\n  }\n</style>\n{%- endif -%}"
