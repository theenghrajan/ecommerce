          "name": "Sale Item Block V2",
          "settings": {
            "custom_liquid": "{%- comment -%}\nESG PDP PROMO BOX — BenQ Super Sale\nTrigger: product tag \"simkitsupersale\"\nRequires code: GOLFJOY10 (customer must enter at checkout/cart)\nAuto-hide after: March 30, 2026\nIncludes 1-click copy button\n{%- endcomment -%}\n\n{%- assign today_ts = 'now' | date: '%s' -%}\n{%- assign cutoff_ts = '2026-03-30' | date: '%s' -%}\n\n{%- if today_ts <= cutoff_ts and product.tags contains 'simkitsupersale' -%}\n<div style=\"\n  margin:14px 0 0;\n  padding:12px 14px;\n  border-radius:16px;\n  border:1px solid rgba(8,110,211,.35);\n  background:#ffffff;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;\n  color:#0f172a;\n  box-shadow:0 10px 22px rgba(8,110,211,.08);\n\">\n  <div style=\"display:flex; gap:10px; align-items:flex-start;\">\n    <div style=\"\n      width:32px; height:32px; border-radius:12px;\n      background:#e7f2ff;\n      border:1px solid rgba(8,110,211,.18);\n      display:flex; align-items:center; justify-content:center;\n      font-size:16px; flex:0 0 auto;\n    \">🏷️</div>\n\n    <div style=\"flex:1; min-width:0;\">\n      <div style=\"\n        display:flex;\n        align-items:flex-start;\n        justify-content:space-between;\n        gap:10px;\n        flex-wrap:wrap;\n        margin:0 0 6px;\n      \">\n        <div style=\"\n          font-size:14px;\n          letter-spacing:.12em;\n          text-transform:uppercase;\n          font-weight:950;\n          color:#086ed3;\n          margin:0;\n        \">SIM KIT SUPER SALE</div>\n\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          padding:4px 8px;\n          border-radius:999px;\n          background:#0b2a55;\n          color:#ffffff;\n          font-size:11px;\n          font-weight:900;\n          letter-spacing:.06em;\n          white-space:nowrap;\n        \">Ends Mar 30, 2026</div>\n      </div>\n\n      <div style=\"font-weight:950; font-size:15px; line-height:1.25; margin:0 0 8px;\">\n        Get <span style=\"color:#f59e0b;\">extra savings up to 10% off</span> with code:\n      </div>\n\n      <div style=\"\n        display:flex;\n        align-items:center;\n        gap:8px;\n        flex-wrap:wrap;\n      \">\n        <div id=\"esg-benq-code\" style=\"\n          display:inline-flex;\n          align-items:center;\n          padding:9px 12px;\n          border-radius:12px;\n          border:1px dashed rgba(8,110,211,.35);\n          background:#f8fbff;\n          font-weight:1000;\n          letter-spacing:.08em;\n          color:#0b2a55;\n          font-size:13px;\n          user-select:all;\n        \">GOLFJOY10</div>\n\n        <button type=\"button\" id=\"esg-benq-copy\" style=\"\n          appearance:none;\n          border:none;\n          border-radius:12px;\n          padding:9px 12px;\n          background:#086ed3;\n          color:#ffffff;\n          font-weight:950;\n          font-size:12.5px;\n          cursor:pointer;\n          box-shadow:0 10px 18px rgba(8,110,211,.18);\n        \">Copy</button>\n\n        <div id=\"esg-benq-copied\" style=\"\n          display:none;\n          padding:7px 10px;\n          border-radius:999px;\n          background:#ecfdf5;\n          border:1px solid #10b981;\n          color:#065f46;\n          font-weight:900;\n          font-size:12px;\n          white-space:nowrap;\n        \">✅ Copied</div>\n      </div>\n\n      <div style=\"margin-top:8px; font-size:12.5px; color:#475569;\">\n        Enter this code in your cart/checkout to apply the discount.\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var btn = document.getElementById('esg-benq-copy');\n  var codeEl = document.getElementById('esg-benq-code');\n  var badge = document.getElementById('esg-benq-copied');\n  if (!btn || !codeEl) return;\n\n  function showCopied() {\n    if (!badge) return;\n    badge.style.display = 'inline-flex';\n    setTimeout(function () {\n      badge.style.display = 'none';\n    }, 1400);\n  }\n\n  btn.addEventListener('click', async function () {\n    var code = (codeEl.textContent || '').trim();\n    try {\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        await navigator.clipboard.writeText(code);\n        showCopied();\n        return;\n      }\n    } catch (e) {}\n\n    // Fallback copy (older browsers)\n    var ta = document.createElement('textarea');\n    ta.value = code;\n    ta.setAttribute('readonly', '');\n    ta.style.position = 'absolute';\n    ta.style.left = '-9999px';\n    document.body.appendChild(ta);\n    ta.select();\n    try { document.execCommand('copy'); showCopied(); } catch (e) {}\n    document.body.removeChild(ta);\n  });\n\n  // Optional: click the code itself to copy\n  codeEl.style.cursor = 'pointer';\n  codeEl.title = 'Click to copy';\n  codeEl.addEventListener('click', function () {\n    btn.click();\n  });\n})();\n</script>\n{%- endif -%}"
          }
