        "custom_liquid_MVemU4": {
          "type": "custom-liquid",
          "name": "Stock Availability",
          "settings": {
            "custom_liquid": "{%- comment -%}\nESG Compact Inventory + Advantage Box (No quantities shown)\nIncludes:\n- Stock vs direct-ship status\n- Same-day shipping digital countdown (2:00 PM ET) when stocked (not direct ship)\n- Polished shipping pills for tags: free2day / freenextday\nHidden for: open-box / refurbished\n{%- endcomment -%}\n\n{%- assign total_on_hand = 0 -%}\n{%- assign saw_any_qty_field = false -%}\n\n{%- for v in product.variants -%}\n  {%- if v.inventory_quantity != blank -%}\n    {%- assign saw_any_qty_field = true -%}\n    {%- assign total_on_hand = total_on_hand | plus: v.inventory_quantity -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- assign incoming_qty = product.metafields.custom.incoming_po_qty | default: 0 | plus: 0 -%}\n{%- assign vendor_name = product.vendor | default: 'Vendor' -%}\n\n{%- assign total_available = total_on_hand | plus: incoming_qty -%}\n\n{%- assign has_inventory = false -%}\n{%- if saw_any_qty_field and total_available > 0 -%}\n  {%- assign has_inventory = true -%}\n{%- endif -%}\n\n{%- assign direct_ship = false -%}\n{%- if saw_any_qty_field and total_available <= 0 -%}\n  {%- assign direct_ship = true -%}\n{%- endif -%}\n\n{%- comment -%} Hide this box entirely for Open Box or Refurbished listings {%- endcomment -%}\n{%- assign is_refurbished = false -%}\n{%- assign is_open_box = false -%}\n{%- if product.tags contains 'refurbished' -%}{%- assign is_refurbished = true -%}{%- endif -%}\n{%- if product.tags contains 'open-box' -%}{%- assign is_open_box = true -%}{%- endif -%}\n{%- assign hide_inventory_box = false -%}\n{%- if is_refurbished or is_open_box -%}{%- assign hide_inventory_box = true -%}{%- endif -%}\n\n{%- assign show_box = false -%}\n{%- if saw_any_qty_field and hide_inventory_box == false -%}\n  {%- assign show_box = true -%}\n{%- endif -%}\n\n{%- if show_box -%}\n<div style=\"\n  margin:14px 0 0;\n  padding:12px 14px;\n  border-radius:16px;\n  border:1px solid rgba(8,110,211,.35);\n  background:#ffffff;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  color:#0f172a;\n  display:flex;\n  align-items:flex-start;\n  gap:12px;\n  box-shadow:0 10px 22px rgba(8,110,211,.08);\n  position:relative;\n  overflow:hidden;\n\">\n  <div style=\"\n    position:absolute;\n    inset:0 auto 0 0;\n    width:5px;\n    background:linear-gradient(180deg,#086ed3 0%,#38bdf8 100%);\n  \"></div>\n\n  <div style=\"\n    width:32px; height:32px; border-radius:12px;\n    background:#e7f2ff;\n    display:flex; align-items:center; justify-content:center;\n    font-size:16px; flex:0 0 auto;\n    border:1px solid rgba(8,110,211,.18);\n    margin-left:2px;\n  \">✅</div>\n\n  <div style=\"line-height:1.25; flex:1; min-width:0;\">\n    <div style=\"\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap:10px;\n      margin:0 0 8px;\n      flex-wrap:wrap;\n    \">\n      <div style=\"font-weight:950; font-size:13px; letter-spacing:.02em;\">\n        Elite Sim Golf Advantage\n      </div>\n\n      {%- if direct_ship -%}\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          padding:6px 10px;\n          border-radius:999px;\n          background:#0b2a55;\n          color:#ffffff;\n          font-weight:950;\n          font-size:11px;\n          letter-spacing:.06em;\n          white-space:nowrap;\n        \">DIRECT SHIP</div>\n      {%- else -%}\n        <div style=\"\n          display:inline-flex;\n          align-items:center;\n          padding:6px 10px;\n          border-radius:999px;\n          background:#086ed3;\n          color:#ffffff;\n          font-weight:950;\n          font-size:11px;\n          letter-spacing:.06em;\n          white-space:nowrap;\n          box-shadow:0 8px 18px rgba(8,110,211,.20);\n        \">✅ IN STOCK • READY TO SHIP</div>\n      {%- endif -%}\n    </div>\n\n    {%- if has_inventory -%}\n      <div style=\"font-size:13px; color:#334155; margin:0 0 10px;\">\n        We <strong>stock this item</strong> so you can expect <strong>fast fulfillment</strong> and <strong>real post-purchase support</strong> if you need help.\n      </div>\n    {%- endif -%}\n\n    {%- if direct_ship -%}\n      <div style=\"font-size:13px; color:#334155; margin:0 0 10px;\">\n        This item is fulfilled via <strong>direct ship</strong> from <strong>{{ vendor_name | escape }}</strong>. We’re still here to help with questions and support after delivery.\n      </div>\n    {%- endif -%}\n\n    {%- if has_inventory and direct_ship == false -%}\n      <!-- DIGITAL CLOCK COUNTDOWN (2:00 PM ET) -->\n      <div id=\"esg-2pm-countdown-wrap\" style=\"\n        margin:0 0 10px;\n        padding:10px 12px;\n        border-radius:14px;\n        border:2px solid rgba(8,110,211,.22);\n        background:linear-gradient(180deg,#ffffff 0%,#f4f9ff 100%);\n        display:flex;\n        align-items:center;\n        justify-content:space-between;\n        gap:10px;\n        flex-wrap:wrap;\n      \">\n        <div style=\"display:flex; flex-direction:column; gap:6px;\">\n          <div style=\"font-size:11px; font-weight:950; letter-spacing:.10em; text-transform:uppercase; color:#086ed3;\">\n            Same-Day Shipping Cutoff\n          </div>\n          <div style=\"font-size:12.5px; color:#334155; font-weight:800;\">\n            Order by <strong>2:00 PM ET</strong>\n          </div>\n        </div>\n\n        <div id=\"esg-2pm-time\" style=\"\n          display:inline-flex;\n          align-items:center;\n          justify-content:center;\n          min-width:142px;\n          padding:8px 12px;\n          border-radius:12px;\n          background:#0b2a55;\n          color:#ffffff;\n          border:1px solid rgba(11,42,85,.35);\n          box-shadow:0 14px 24px rgba(11,42,85,.18);\n          font-weight:1000;\n          font-size:18px;\n          letter-spacing:.18em;\n          font-variant-numeric: tabular-nums;\n          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;\n        \">--:--:--</div>\n      </div>\n\n      <script>\n      (function () {\n        var wrap = document.getElementById('esg-2pm-countdown-wrap');\n        var timeEl = document.getElementById('esg-2pm-time');\n        if (!wrap || !timeEl) return;\n\n        function getETParts(date) {\n          var parts = new Intl.DateTimeFormat('en-US', {\n            timeZone: 'America/New_York',\n            year: 'numeric',\n            month: '2-digit',\n            day: '2-digit',\n            hour: '2-digit',\n            minute: '2-digit',\n            second: '2-digit',\n            hour12: false\n          }).formatToParts(date);\n\n          var out = {};\n          parts.forEach(function(p){ out[p.type] = p.value; });\n          return out;\n        }\n\n        function pad(n){ return String(n).padStart(2,'0'); }\n\n        function update() {\n          var now = new Date();\n          var p = getETParts(now);\n\n          var hh = parseInt(p.hour, 10);\n          var mm = parseInt(p.minute, 10);\n          var ss = parseInt(p.second, 10);\n\n          var nowSec = hh*3600 + mm*60 + ss;\n          var cutoffSec = 14*3600; // 2:00 PM ET\n          var remaining = cutoffSec - nowSec;\n\n          if (remaining <= 0) {\n            wrap.style.display = 'none';\n            return;\n          }\n\n          var rH = Math.floor(remaining / 3600);\n          var rM = Math.floor((remaining % 3600) / 60);\n          var rS = remaining % 60;\n\n          timeEl.textContent = pad(rH) + \":\" + pad(rM) + \":\" + pad(rS);\n        }\n\n        update();\n        setInterval(update, 1000);\n      })();\n      </script>\n    {%- endif -%}\n\n    <!-- Polished shipping pills -->\n    {%- if product.tags contains 'free2day' or product.tags contains 'freenextday' -%}\n      <div style=\"display:flex; flex-wrap:wrap; gap:10px; margin:0;\">\n        {%- if product.tags contains 'free2day' -%}\n          <span style=\"\n            display:inline-flex;\n            align-items:center;\n            gap:8px;\n            padding:7px 10px;\n            border-radius:999px;\n            background:linear-gradient(180deg,#ffffff 0%,#f4f9ff 100%);\n            border:2px solid rgba(8,110,211,.45);\n            color:#0b2a55;\n            font-size:12px;\n            font-weight:950;\n            letter-spacing:.02em;\n            white-space:nowrap;\n            box-shadow:0 10px 18px rgba(8,110,211,.10);\n          \">\n            <span style=\"\n              width:22px; height:22px;\n              border-radius:999px;\n              background:#086ed3;\n              color:#ffffff;\n              display:inline-flex;\n              align-items:center;\n              justify-content:center;\n              font-size:12px;\n              font-weight:1000;\n              line-height:1;\n              box-shadow:0 8px 14px rgba(8,110,211,.18);\n              flex:0 0 auto;\n            \">✈️</span>\n            FREE UPS 2ND DAY AIR\n          </span>\n        {%- endif -%}\n\n        {%- if product.tags contains 'freenextday' -%}\n          <span style=\"\n            display:inline-flex;\n            align-items:center;\n            gap:8px;\n            padding:7px 10px;\n            border-radius:999px;\n            background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%);\n            border:2px solid rgba(15,23,42,.38);\n            color:#0f172a;\n            font-size:12px;\n            font-weight:950;\n            letter-spacing:.02em;\n            white-space:nowrap;\n            box-shadow:0 10px 18px rgba(15,23,42,.10);\n          \">\n            <span style=\"\n              width:22px; height:22px;\n              border-radius:999px;\n              background:#0b2a55;\n              color:#ffffff;\n              display:inline-flex;\n              align-items:center;\n              justify-content:center;\n              font-size:12px;\n              font-weight:1000;\n              line-height:1;\n              box-shadow:0 8px 14px rgba(11,42,85,.18);\n              flex:0 0 auto;\n            \">🚀</span>\n            FREE UPS NEXT DAY AIR\n          </span>\n        {%- endif -%}\n      </div>\n    {%- endif -%}\n\n  </div>\n</div>\n{%- endif -%}"
          }
        },
