    "multi_column_w9xBVR": {
      "type": "multi-column",
      "blocks": {
        "column_8mKWKN": {
          "type": "column",
          "settings": {
            "show_image": true,
            "image": "shopify://shop_images/tubing.png",
            "heading": "heavywall tubing",
            "heading_size": "h4",
            "text": "<p>All our ELITE SIM GOLF Enclosures use 1-1/4\" Powder Coated Steel tubing for the frame. The system snaps together using snap clips in minutes, most enclosures can be assembled in 30 minutes or less. </p>",
            "button_label": "",
            "button_link": "#",
            "button_style": "feature-link"
          }
        },
        "column_YtdiNd": {
          "type": "column",
          "settings": {
            "show_image": true,
            "image": "shopify://shop_images/thumbnail_IMG_5470.jpg",
            "heading": "MATERIALS & TECHNOLOGY",
            "heading_size": "h4",
            "text": "<p>All our ELITE SIM GOLF Enclosures have a 360 Hook and Loops Velcro system around the impact screen to keep errant golf balls from contacting the frame and at the front of the enclosure to keep the fabric tight.</p>",
            "button_label": "",
            "button_link": "#",
            "button_style": "feature-link"
          }
        },
        "column_TcgJMf": {
          "type": "column",
          "settings": {
            "show_image": true,
            "image": "shopify://shop_images/Screenshot_2025-08-25_092324.png",
            "heading": "4K ULTRA impact screens",
            "heading_size": "h4",
            "text": "<p>All our ELITE SIM GOLF Enclosures use 4K ULTRA Premium 3D/Triple Layer Impact Screens to ensure a long life of the impact screen and the highest quality 4K picture imaginable. Blackout screen optional with all sims.</p>",
            "button_label": "",
            "button_link": "#",
            "button_style": "feature-link"
          }
