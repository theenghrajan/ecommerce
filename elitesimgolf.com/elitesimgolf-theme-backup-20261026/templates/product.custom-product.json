    "sn_product_includes_6qaEcj": {
      "type": "sn-product-includes",
      "blocks": {
        "card_RTdkg8": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/vtrack_28c9ba79-95a9-4eab-b2b1-c4253c2d9528.webp",
            "title": "Laon Swingcraft VTrack Overhead Launch Monitor (with case)",
            "text": "<p>Ceiling-mounted, markerless ball & club tracking with dual high-speed cameras. 25+ parameters, slow-motion impact video, GSPro & E6 compatible.</p>",
            "class": ""
          }
        },
        "card_zpWcdV": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/E12-Front-SDS_0396465c-6a98-4115-a10a-76823abbde9e.webp",
            "title": "Elite Sim Golf Eagle 12 Enclosure",
            "text": "<p>12ft dedicated hitting bay — 144\" wide × 98\" high × 60\" deep — with safe ball containment and a finished sim-room look.</p>",
            "class": ""
          }
        },
        "card_rdAzgQ": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/ak700st-gallery1.png",
            "title": "BenQ AK700ST 4K Golf Simulator Projector",
            "text": "<p>Dedicated golf simulator projector delivering true 4K UHD. Sharper detail, cleaner text overlays, and a more immersive image on your impact screen.</p>",
            "class": ""
          }
        },
        "card_qtMa4q": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/ept510.webp",
            "title": "Elite ProTee 5x10 Hitting Mat (removable hitting strip)",
            "text": "<p>Large hitting surface for multiple ball positions and left/right-hand flexibility. Built for long-term, high-use durability.</p>",
            "class": ""
          }
        },
        "card_4RnEBF": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/6x12landingmat.png",
            "title": "6x12 Landing Mat",
            "text": "<p>Extends your floor coverage forward, completing the bay feel and protecting your floor surface in the ball landing zone.</p>",
            "class": ""
          }
        },
        "card_y9BxNW": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/cm00g3.webp",
            "title": "BenQ Projector Mount",
            "text": "<p>Ceiling mount hardware designed to position and secure the AK700ST at the correct throw distance for the Eagle 12 screen.</p>",
