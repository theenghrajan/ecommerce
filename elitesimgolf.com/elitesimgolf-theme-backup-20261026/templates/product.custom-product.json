    "sn_product_intro_3qBL4H": {
      "type": "sn-product-intro",
      "blocks": {
        "text_WFQCrb": {
          "type": "text",
          "settings": {
            "text": "<p>The No-Compromise Build</p>",
            "class": "sn-uppercase sn-highlight mb-2"
          }
        },
        "text_Vibkg9": {
          "type": "text",
          "settings": {
            "text": "<h2>Your <em>complete</em> overhead simulator bay — out of the box.</h2>",
            "class": ""
          }
        },
        "text_khdp7V": {
          "type": "text",
          "settings": {
            "text": "<p>The VTrack Premium 4K Bundle is built for golfers who don't want to compromise. Ceiling-mounted markerless tracking. 4K projection. A full 12-foot Eagle enclosure. A pro-grade hitting mat setup. Everything curated to work together, so you spend your time dialing in your swing — not troubleshooting compatibility.</p>",
            "class": ""
          }
        },
        "text_KmFGYk": {
          "type": "text",
          "settings": {
            "text": "<p>The Laon Swingcraft VTrack launch monitor sits overhead, out of the way, tracking every shot with dual high-speed cameras. No stickers, no special balls, no floor unit to swing around. Just clean, fast, accurate feedback — and slow-motion impact video to show you exactly what happened at contact.</p>",
            "class": ""
          }
        },
        "stats_TwgF7F": {
          "type": "stats",
          "settings": {
            "title1": "25+",
            "text1": "Shot Parameters",
            "title2": "4K",
            "text2": "Ultra HD Projection",
            "title3": "12ft",
            "text3": "Hitting Bay Width",
            "title4": "~250ms",
            "text4": "Shot Feedback Speed",
            "class": "mt-2"
          }
        },
        "review_Nt8F9e": {
          "type": "review",
          "settings": {
            "message": "<p><em>\"I was torn between a few overhead options, but the VTrack bundle made the decision easy. Setup was simpler than expected, the data is incredible, and the 4K image on the impact screen is genuinely beautiful. This is a permanent fixture in my garage now.\"</em></p>",
            "letters": "JM",
            "name": "James M.",
            "info": "Eagle 12 + VTrack Owner · Verified Purchase",
            "class": "mb-2"
          }
        },
        "review_XTNar4": {
          "type": "review",
          "settings": {
            "message": "<p><em>\"The overhead design was the whole reason I went with VTrack. Nothing on the floor means my kids can use the sim without me worrying about the monitor. The bundle from Elite Sim Golf arrived packaged correctly and everything fit perfectly.\"</em></p>",
            "letters": "DR",
            "name": "David R.",
            "info": "VTrack Premium Bundle Owner · Verified Purchase",
            "class": ""
          }
        }
      },
      "block_order": [
        "text_WFQCrb",
