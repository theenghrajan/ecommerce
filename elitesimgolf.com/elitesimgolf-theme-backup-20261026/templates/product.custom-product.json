    "sn_product_features_gKVKtn": {
      "type": "sn-product-features",
      "blocks": {
        "tab1_7WNRNd": {
          "type": "tab1",
          "settings": {
            "number": "01",
            "title": "Dual High-Speed Stereoscopic Cameras",
            "text": "<p>Two high-speed cameras capture the ball and club through impact from above, delivering photometric tracking data without any floor-mounted hardware in your swing path.</p>",
            "class": ""
          }
        },
        "tab1_HdzNHz": {
          "type": "tab1",
          "settings": {
            "number": "02",
            "title": "Markerless Tracking — No Special Balls or Stickers",
            "text": "<p>VTrack's core experience requires no club-face stickers, reflective dots, or specially marked balls. Drop a standard golf ball and swing.</p>",
            "class": ""
          }
        },
        "tab1_MVj3x8": {
          "type": "tab1",
          "settings": {
            "number": "03",
            "title": "25+ Ball & Club Data Parameters",
            "text": "<p>Ball Speed, Launch Angle, Launch Direction, Spin Rate, Spin Axis, Carry & Total Distance, Apex, Club Speed, Club Path, Face Angle, Face-to-Path, Attack Angle, Dynamic Loft, Impact Location, and more.</p>",
            "class": ""
          }
        },
        "tab1_ddVrdE": {
          "type": "tab1",
          "settings": {
            "number": "04",
            "title": "Slow-Motion Impact Video",
            "text": "<p>Automatically captures slow-motion footage of every strike. See exactly what happened at contact — a powerful feedback tool for diagnosing strike quality, gear effect, and swing flaws.</p>",
            "class": ""
          }
        },
        "tab1_4RGYyy": {
          "type": "tab1",
          "settings": {
            "number": "05",
            "title": "~200–250ms Shot Feedback Speed",
            "text": "<p>Fast shot-to-result response time keeps simulator play feeling connected and natural. Noticeable during both practice and full-round simulation.</p>",
            "class": ""
          }
        },
        "tab1_zUCPjj": {
          "type": "tab1",
          "settings": {
            "number": "06",
            "title": "Left & Right-Handed Friendly",
            "text": "<p>Because VTrack mounts overhead and in front of the hitting area, it supports both left- and right-handed golfers without moving the unit — ideal for multi-player households and sim studios.</p>",
            "class": ""
          }
        },
        "tab1_86FtAC": {
          "type": "tab1",
          "settings": {
            "number": "07",
            "title": "GSPro, E6 Connect & E6 Apex Compatible",
            "text": "<p>Play on your preferred platform. VTrack connects to today's most popular simulator software. VTrack ToolKit handles setup, calibration, and area configuration.</p>",
            "class": ""
          }
        },
        "tab1_jYn6gP": {
          "type": "tab1",
          "settings": {
            "number": "08",
            "title": "No Required Subscription for Core Functionality",
            "text": "<p>No mandatory recurring fee to keep using the launch monitor you purchased. Long-term ownership value without the hidden costs of competing subscription-gated hardware.</p>",
            "class": ""
          }
        },
        "tab2_GeHj3Y": {
          "type": "tab2",
          "settings": {
            "number": "01",
            "title": "12-Foot Wide Hitting Bay",
            "text": "<p>The Eagle 12 gives you 144\" (12ft) of width — enough for a generous, comfortable swing for players of any size. Creates a proper \"sim room\" feel in a garage or dedicated space.</p>",
            "class": ""
          }
        },
        "tab2_7AUeUX": {
          "type": "tab2",
          "settings": {
            "number": "02",
            "title": "Safe Ball Containment",
            "text": "<p>Designed to keep errant shots safely contained within the enclosure. Protects walls, windows, and surrounding areas from ball impact — essential for any serious home simulator.</p>",
            "class": ""
          }
        },
        "tab2_Rh7gCd": {
          "type": "tab2",
          "settings": {
            "number": "03",
            "title": "Clean, Finished Aesthetic",
            "text": "<p>The Eagle 12 is built to look like a permanent installation, not a temporary setup. Ideal for finished basements, dedicated sim rooms, and garage builds where appearance matters.</p>",
            "class": ""
          }
        },
        "tab2_Da6Xdt": {
          "type": "tab2",
          "settings": {
            "number": "04",
            "title": "Dimensions: 144\" W × 98\" H × 60\" D",
            "text": "<p>A generous, well-proportioned bay configuration designed to work with overhead launch monitors like the VTrack. Compatible with VTrack's 31\" × 24\" hitting zone requirements.</p>",
            "class": ""
          }
        },
        "tab3_mGHjqB": {
          "type": "tab3",
          "settings": {
            "number": "01",
            "title": "True 4K Ultra HD Resolution",
            "text": "<p>The BenQ AK700ST delivers native 4K UHD — a significant step up from 1080P in sharpness, text clarity, and overall visual quality, especially noticeable in menus and course details.</p>",
            "class": ""
          }
        },
        "tab3_ki9AEr": {
          "type": "tab3",
          "settings": {
            "number": "02",
            "title": "Dedicated Golf Simulator Projector",
            "text": "<p>Optimized for golf simulation environments — not a repurposed home theater unit. BenQ's golf-specific short-throw design is built for the throw distances and impact screen use cases in a simulator bay.</p>",
            "class": ""
          }
        },
        "tab3_t7pqM3": {
          "type": "tab3",
          "settings": {
            "number": "03",
            "title": "Short-Throw Lens",
            "text": "<p>ST (Short-Throw) lens configuration allows the projector to produce a large, bright image from a short distance — ideal for ceiling mounting in real-world rooms with limited depth.</p>",
            "class": ""
          }
        },
        "tab3_Qi3RzQ": {
          "type": "tab3",
          "settings": {
            "number": "04",
            "title": "Wireless Connectivity via QCast Dongle",
            "text": "<p>The included BenQ QCast wireless USB dongle allows screen casting without running extra cables — helps keep your sim space clean and reduces visible cable management challenges.</p>",
            "class": ""
          }
        },
        "tab4_kmCDzf": {
          "type": "tab4",
          "settings": {
            "number": "01",
            "title": "Elite ProTee 5x10 Hitting Mat",
            "text": "<p>A large 5ft × 10ft hitting surface with a removable hitting strip. Accommodates a wide range of ball positions and stance widths — built for durability in high-use sim environments.</p>",
            "class": ""
          }
        },
        "tab4_K3jKM8": {
          "type": "tab4",
          "settings": {
            "number": "02",
            "title": "6x12 Landing Mat",
            "text": "<p>Extends the floor coverage forward from the hitting mat, completing the bay feel and protecting your floor from wear and impact in the ball landing zone.</p>",
            "class": ""
          }
        },
        "tab4_7kgELL": {
          "type": "tab4",
          "settings": {
            "number": "03",
            "title": "VTrack Impact Protector",
            "text": "<p>A dedicated clear shield designed by Elite Sim Golf to protect the VTrack unit from accidental ball impact and ricochet damage. Protects your investment without affecting tracking performance.</p>",
            "class": ""
          }
        },
        "tab4_M3Bmn3": {
          "type": "tab4",
          "settings": {
            "number": "04",
            "title": "TaylorMade TP5 Pix Golf Balls (12-pack)",
            "text": "<p>Premium multi-layer golf balls included in the bundle so you can start playing on day one — no separate order needed.</p>",
            "class": ""
          }
        }
      },
