          }
        },
        "card_ewNXwU": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/25ft_projector_install.png",
            "title": "Projector Install Kit — 25ft Power + 25ft HDMI",
            "text": "<p>Long-run cables for clean ceiling installs. Eliminates the need to source your own cables for concealed or routed runs.</p>",
