    "sn_benefits_GXtkrM": {
      "type": "sn-benefits",
      "blocks": {
        "benefit_4rJzMK": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/ceiling.svg",
            "title": "Ceiling-Mounted, Out of the Way",
            "text": "<p>VTrack mounts overhead — permanently. No floor unit to aim around, nothing to trip on, nothing expensive sitting where a mishit can reach it. Your bay stays clean, open, and <strong>ready for any golfer</strong> — left or right-handed — without moving a thing.</p>",
            "class": ""
          }
        },
        "benefit_yiABce": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/flash.svg",
            "title": "No Dots. No Stickers. No Special Balls.",
            "text": "<p>Drop a standard golf ball and swing. VTrack's dual high-speed cameras capture everything at contact — ball speed, launch angle, spin, club path, face angle, and more — <strong>without any prep work</strong>. Just play.</p>",
            "class": ""
          }
        },
        "benefit_LAbTqi": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/slow-motion.svg",
            "title": "Slow-Motion Impact Video, Every Shot",
            "text": "<p>See exactly what happened at contact. VTrack's high-speed cameras capture slow-motion impact video automatically, bridging the gap between <strong>feel and reality</strong> for faster, more meaningful improvement.</p>",
            "class": ""
          }
        },
        "benefit_kQBhPN": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/4k-film.svg",
            "title": "True 4K on a 12ft Screen",
            "text": "<p>The BenQ AK700ST is a dedicated golf simulator projector — not a repurposed home theater unit. Sharper text, crisper course detail, and a more immersive picture. Paired with the Eagle 12, it's a <strong>genuinely premium visual experience</strong>.</p>",
            "class": ""
          }
        },
        "benefit_QVUAzY": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/link.svg",
            "title": "GSPro & E6 Ready, No Subscription Required",
            "text": "<p>VTrack works out of the box with GSPro, E6 Connect, and E6 Apex. And unlike some competing systems, there's <strong>no mandatory recurring fee</strong> just to use the launch monitor's core functionality.</p>",
            "class": ""
          }
        },
        "benefit_nnNCzh": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/puzzle.svg",
            "title": "Curated to Work Together",
            "text": "<p>Every item in this bundle — the enclosure, projector, mats, cabling, and accessories — was selected by Elite Sim Golf specifically for this configuration. <strong>No compatibility guesswork</strong>, no missing pieces.</p>",
            "class": ""
          }
        }
      },
      "block_order": [
        "benefit_4rJzMK",
        "benefit_yiABce",
        "benefit_LAbTqi",
