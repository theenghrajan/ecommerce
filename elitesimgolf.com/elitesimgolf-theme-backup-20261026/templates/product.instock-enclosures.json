order-radius:50%;\n      background:currentColor;\n      flex:0 0 auto;\n    }\n    .esg-availability-mini .esg-avail-list{\n      list-style:none;\n      margin:0;\n      padding:0;\n      display:grid;\n      gap:9px;\n    }\n    .esg-availability-mini .esg-avail-list li{\n      position:relative;\n      padding-left:22px;\n      color:var(--esg-text);\n      font-size:14px;\n      line-height:1.45;\n      font-weight:600;\n    }\n    .esg-availability-mini .esg-avail-list li:before{\n      content:\"✓\";\n      position:absolute;\n      left:0;\n      top:0;\n      color:var(--esg-blue);\n      font-weight:900;\n    }\n    .esg-availability-mini .esg-avail-note{\n      margin-top:10px;\n      font-size:12px;\n      line-height:1.45;\n      color:var(--esg-muted);\n    }\n  </style>\n\n  {% assign current_variant = product.selected_or_first_available_variant %}\n\n  <div class=\"esg-avail-wrap\">\n    <div class=\"esg-avail-head\">Product Availability</div>\n    <div class=\"esg-avail-body\">\n\n      {% if current_variant.available %}\n        <div class=\"esg-avail-status in-stock\">\n          <span class=\"esg-avail-dot\"></span>\n          In Stock\n        </div>\n\n        <ul class=\"esg-avail-list\">\n          <li>Available — Most Orders Ship Same Business Day</li>\n          <li>\n  FREE UPS Ground Delivery \n  <span style=\"font-size:11px;color:#64748b;opacity:.85;\">\n    (Pre-cut EMT Pipe Kits Excluded)\n  </span>\n</li>\n          <li>Ships from our warehouse in Loudon, TN</li>\n          <li>Available for Local Pickup</li>\n        </ul>\n      {% else %}\n        <div class=\"esg-avail-status out-stock\">\n          <span class=\"esg-avail-dot\"></span>\n          Currently Out of Stock\n        </div>\n\n        <ul class=\"esg-avail-list\">\n          <li>Typically ships in 3–5 Business Days</li>\n        </ul>\n      {% endif %}\n\n    </div>\n  </div>\n</div>"
