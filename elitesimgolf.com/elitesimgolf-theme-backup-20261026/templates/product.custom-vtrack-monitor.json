    "sn_product_features_gKVKtn": {
      "type": "sn-product-features",
      "blocks": {
        "tab1_7WNRNd": {
          "type": "tab1",
          "settings": {
            "number": "01",
            "title": "<strong>Dual Stereoscopic High-Speed Cameras</strong>",
            "text": "<p>VTrack uses two high-speed cameras capturing up to 1,800 frames per second to observe the ball and club through impact from an overhead position. This photometric approach delivers precise data without requiring floor-mounted hardware in your hitting area.</p>",
            "class": ""
          }
        },
        "tab1_HdzNHz": {
          "type": "tab1",
          "settings": {
            "number": "02",
            "title": "<strong>Markerless Ball Tracking</strong>",
            "text": "<p>The core VTrack experience requires no club-face stickers, reflective dots, or specially marked golf balls. Drop a standard ball, swing, and let the cameras do the rest. An optional marked ball mode is available for golfers who prefer it.</p>",
            "class": ""
          }
        },
        "tab1_MVj3x8": {
          "type": "tab1",
          "settings": {
            "number": "03",
            "title": "<strong>25+ Ball and Club Parameters</strong>",
            "text": "<p>Ball Speed, Launch Angle, Launch Direction, Spin Rate, Spin Axis, Carry Distance, Total Distance, Apex Height, Shot Curvature / Side Distance, Club Speed, Club Path, Face Angle, Face-to-Path, Attack Angle, Dynamic Loft, Impact Location, and more.</p>",
            "class": ""
          }
        },
        "tab1_ddVrdE": {
          "type": "tab1",
          "settings": {
            "number": "04",
            "title": "<strong>Slow-Motion Impact Video</strong>",
            "text": "<p>Every shot is captured in slow motion. Instead of guessing what happened at contact, you can see it — club path, face delivery, strike location, and gear-effect misses all become visible in a way that pure numbers can't convey.</p>",
            "class": ""
          }
        },
        "tab1_4RGYyy": {
          "type": "tab1",
          "settings": {
            "number": "05",
            "title": "<strong>~200–250ms Shot Feedback Speed</strong>",
            "text": "<p>Fast response from impact to screen. Simulator play feels connected rather than delayed, which makes a noticeable difference during practice sessions and full-round simulation on GSPro or E6.</p>",
            "class": ""
          }
        },
        "tab1_zUCPjj": {
          "type": "tab1",
          "settings": {
            "number": "06",
            "title": "<strong>31\" × 24\" Hitting Zone</strong>",
            "text": "<p>A generous hitting zone that accommodates a wide range of ball positions, stance widths, and player types. Less stress about precise ball placement — more room to swing naturally.</p>",
            "class": ""
          }
        },
        "tab2_GeHj3Y": {
          "type": "tab2",
          "settings": {
            "number": "01",
            "title": "<strong>GSPro Compatible</strong>",
            "text": "<p>VTrack integrates with GSPro for realistic ball flight simulation, access to a large course library, and online play. A complete setup walkthrough is available from Elite Sim Golf covering VTrack ToolKit configuration and GSPro connection.</p>",
            "class": ""
          }
        },
        "tab2_7AUeUX": {
          "type": "tab2",
          "settings": {
            "number": "02",
            "title": "<strong>E6 Connect & E6 Apex Compatible</strong>",
            "text": "<p>VTrack also connects to E6 Connect and E6 Apex for golfers who prefer the E6 platform's course play and environments.</p>",
            "class": ""
          }
        },
        "tab2_Rh7gCd": {
          "type": "tab2",
          "settings": {
            "number": "03",
            "title": "<strong>VTrack ToolKit (Included)</strong>",
            "text": "<p>The native management application for settings, calibration, data analysis, and player management. Used during initial setup and ongoing session management.</p>",
            "class": ""
          }
        },
        "tab2_Da6Xdt": {
          "type": "tab2",
          "settings": {
            "number": "04",
            "title": "<strong>VTrack Practice Range (Included)</strong>",
            "text": "<p>A structured practice application included with the unit for dedicated training sessions, ball-striking analysis, and progress tracking outside of full simulator rounds.</p>",
            "class": ""
          }
        },
        "tab2_jAHpQT": {
          "type": "tab2",
          "settings": {
            "number": "05",
            "title": "<strong>CSV Data Export</strong>",
            "text": "<p>Export your session data in CSV format to track performance over time, share with a coach, or run your own analysis.</p>",
            "class": ""
          }
        },
        "tab2_zdraYL": {
          "type": "tab2",
          "settings": {
            "number": "06",
            "title": "<strong>No Required Subscription for Core Functionality</strong>",
            "text": "<p>The VTrack launch monitor's core tracking and practice features do not require a recurring monitor subscription. Third-party simulator software licenses are separate.</p>",
            "class": ""
          }
        },
        "tab3_mGHjqB": {
          "type": "tab3",
          "settings": {
            "number": "01",
            "title": "<strong>106\" Minimum Ceiling Height Required</strong>",
            "text": "<p>VTrack is designed for rooms with at least 106\" (8'10\") of ceiling clearance. This is the most important room requirement — it allows the cameras to achieve the correct angle, field of view, and tracking performance.</p>",
            "class": ""
          }
        },
        "tab3_ki9AEr": {
          "type": "tab3",
          "settings": {
            "number": "02",
            "title": "<strong>Ceiling-Mounted Overhead Design</strong>",
            "text": "<p>The unit mounts to the ceiling in front of the hitting area, keeping the entire floor zone clear. Nothing on the floor means a cleaner bay, a safer environment, and an unobstructed swing path.</p>",
            "class": ""
          }
        },
        "tab3_t7pqM3": {
          "type": "tab3",
          "settings": {
            "number": "03",
            "title": "<strong>Left and Right-Handed Support</strong>",
            "text": "<p>Because VTrack mounts overhead, it tracks both left- and right-handed golfers without repositioning the unit. Ideal for families, shared sim rooms, and studios with multiple players.</p>",
            "class": ""
          }
        },
        "tab3_Qi3RzQ": {
          "type": "tab3",
          "settings": {
            "number": "04",
            "title": "<strong>Guided Calibration via ToolKit</strong>",
            "text": "<p>VTrack ToolKit walks through the calibration process including calibration board placement, ball check procedure, area settings, and tee configuration. Elite Sim Golf also provides a complete video setup guide for GSPro.</p>",
            "class": ""
          }
        },
        "tab3_WeF93n": {
          "type": "tab3",
          "settings": {
            "number": "05",
            "title": "<strong>DIY-Friendly for Rooms That Meet Requirements</strong>",
            "text": "<p>Golfers comfortable with ceiling-mounted equipment — projectors, mounts, enclosures — will generally find VTrack a manageable DIY install. Proper mounting alignment and completing the calibration process are the key steps to consistent long-term performance.</p>",
            "class": ""
          }
        },
        "tab3_ULdG7n": {
          "type": "tab3",
          "settings": {
            "number": "06",
            "title": "<strong>VTrack Protector Available from Elite Sim Golf</strong>",
            "text": "<p>Elite Sim Golf manufactures a dedicated VTrack Impact Protector in-house — designed to shield the overhead unit from accidental ball impact and ricochet damage in active sim environments. Available separately and included in select bundles.</p>",
            "class": ""
          }
        }
      },
