            "custom_liquid": "{%- comment -%}\nESG PDP PROMO BOX — Vendor Trigger\nTrigger: product.vendor = \"GolfJoy\" (case-insensitive)\nRequires code: GOLFJOY10\nAuto-hide after: March 30, 2026\nCompact styling to match ESG shipping box\n{%- endcomment -%}\n\n{%- assign today_ts = 'now' | date: '%s' -%}\n{%- assign cutoff_ts = '2026-03-30' | date: '%s' -%}\n{%- assign vendor_downcase = product.vendor | strip | downcase -%}\n\n{%- if today_ts <= cutoff_ts and vendor_downcase == 'golfjoy' -%}\n<div class=\"esg-promo-code-box\">\n  <div class=\"esg-promo-code-box__top\">\n    <div class=\"esg-promo-code-box__title\">\n      <span class=\"esg-promo-code-box__title-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M20.59 13.41 11 23l-2.5-2.5\"></path>\n          <path d=\"M17 7h.01\"></path>\n          <path d=\"M3 11V3h8l10 10-8 8L3 11z\"></path>\n        </svg>\n      </span>\n      <span>Extra Savings Available</span>\n    </div>\n\n    <div class=\"esg-promo-code-box__ends\">\n      Ends Mar 30, 2026\n    </div>\n  </div>\n\n  <div class=\"esg-promo-code-box__text\">\n    Use code below for <strong>up to 10% off</strong> at cart or checkout.\n  </div>\n\n  <div class=\"esg-promo-code-box__row\">\n    <div id=\"esg-promo-code\" class=\"esg-promo-code-box__code\">GOLFJOY10</div>\n\n    <button type=\"button\" id=\"esg-promo-copy\" class=\"esg-promo-code-box__button\">\n      Copy Code\n    </button>\n\n    <div id=\"esg-promo-copied\" class=\"esg-promo-code-box__copied\">\n      Copied\n    </div>\n  </div>\n\n  <div class=\"esg-promo-code-box__note\">\n    Tap the code or button to copy instantly.\n  </div>\n</div>\n\n<style>\n  .esg-promo-code-box {\n    max-width: 1100px;\n    margin: 12px 0 0;\n    padding: 13px 14px;\n    border: 1px solid #23923d;\n    border-radius: 12px;\n    background: linear-gradient(180deg, #f7fcf7 0%, #eef8ef 100%);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.75),\n      0 1px 2px rgba(16,42,67,.05);\n    color: #102a43;\n    line-height: 1.35;\n  }\n\n  .esg-promo-code-box__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 7px;\n    flex-wrap: wrap;\n  }\n\n  .esg-promo-code-box__title {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 14px;\n    font-weight: 800;\n    color: #168232;\n    letter-spacing: .1px;\n    line-height: 1.2;\n  }\n\n  .esg-promo-code-box__title-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 16px;\n    height: 16px;\n    min-width: 16px;\n    color: #168232;\n    flex: 0 0 16px;\n  }\n\n  .esg-promo-code-box__title-icon svg {\n    width: 16px;\n    height: 16px;\n    display: block;\n  }\n\n  .esg-promo-code-box__ends {\n    display: inline-block;\n    padding: 5px 8px;\n    border-radius: 999px;\n    background: #ffffff;\n    border: 1px solid rgba(35,146,61,.28);\n    color: #168232;\n    font-size: 12px;\n    font-weight: 800;\n    line-height: 1;\n    white-space: nowrap;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.8);\n  }\n\n  .esg-promo-code-box__text {\n    font-size: 13px;\n    color: #102a43;\n    margin-bottom: 9px;\n  }\n\n  .esg-promo-code-box__text strong {\n    font-weight: 800;\n  }\n\n  .esg-promo-code-box__row {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n\n  .esg-promo-code-box__code {\n    display: inline-flex;\n    align-items: center;\n    padding: 8px 11px;\n    border-radius: 999px;\n    background: #ffffff;\n    border: 1px dashed rgba(35,146,61,.45);\n    color: #168232;\n    font-weight: 900;\n    font-size: 12.5px;\n    letter-spacing: .12em;\n    line-height: 1;\n    user-select: all;\n    cursor: pointer;\n    white-space: nowrap;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.85);\n  }\n\n  .esg-promo-code-box__button {\n    appearance: none;\n    border: 1px solid #23923d;\n    border-radius: 999px;\n    padding: 8px 12px;\n    background: #168232;\n    color: #ffffff;\n    font-weight: 800;\n    font-size: 12.5px;\n    line-height: 1;\n    cursor: pointer;\n    box-shadow: 0 1px 2px rgba(16,42,67,.08);\n    transition: transform .15s ease, box-shadow .15s ease, background .15s ease;\n  }\n\n  .esg-promo-code-box__button:hover {\n    background: #136f2b;\n    transform: translateY(-1px);\n  }\n\n  .esg-promo-code-box__copied {\n    display: none;\n    align-items: center;\n    padding: 7px 10px;\n    border-radius: 999px;\n    background: #ffffff;\n    border: 1px solid rgba(35,146,61,.35);\n    color: #168232;\n    font-size: 12px;\n    font-weight: 800;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .esg-promo-code-box__note {\n    margin-top: 8px;\n    font-size: 12px;\n    color: #35506b;\n  }\n\n  @media (max-width: 749px) {\n    .esg-promo-code-box {\n      padding: 12px;\n      border-radius: 10px;\n    }\n\n    .esg-promo-code-box__title {\n      font-size: 13.5px;\n    }\n\n    .esg-promo-code-box__title-icon {\n      width: 15px;\n      height: 15px;\n      min-width: 15px;\n      flex-basis: 15px;\n    }\n\n    .esg-promo-code-box__title-icon svg {\n      width: 15px;\n      height: 15px;\n    }\n\n    .esg-promo-code-box__ends,\n    .esg-promo-code-box__text,\n    .esg-promo-code-box__button,\n    .esg-promo-code-box__code {\n      font-size: 12px;\n    }\n\n    .esg-promo-code-box__note {\n      font-size: 11.5px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  var btn = document.getElementById('esg-promo-copy');\n  var codeEl = document.getElementById('esg-promo-code');\n  var badge = document.getElementById('esg-promo-copied');\n  if (!btn || !codeEl) return;\n\n  function showCopied() {\n    if (!badge) return;\n    badge.style.display = 'inline-flex';\n    setTimeout(function () {\n      badge.style.display = 'none';\n    }, 1400);\n  }\n\n  async function copyCode() {\n    var code = (codeEl.textContent || '').trim();\n\n    try {\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        await navigator.clipboard.writeText(code);\n        showCopied();\n        return;\n      }\n    } catch (e) {}\n\n    var ta = document.createElement('textarea');\n    ta.value = code;\n    ta.setAttribute('readonly', '');\n    ta.style.position = 'absolute';\n    ta.style.left = '-9999px';\n    document.body.appendChild(ta);\n    ta.select();\n\n    try {\n      document.execCommand('copy');\n      showCopied();\n    } catch (e) {}\n\n    document.body.removeChild(ta);\n  }\n\n  btn.addEventListener('click', copyCode);\n  codeEl.addEventListener('click', copyCode);\n  codeEl.title = 'Click to copy';\n})();\n</script>\n{%- endif -%}{%- assign has_garmin_r50_tag = false -%}\n{%- for tag in product.tags -%}\n  {%- assign normalized_tag = tag | strip | downcase -%}\n  {%- if normalized_tag == 'spica 3' -%}\n    {%- assign has_garmin_r50_tag = true -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- if has_garmin_r50_tag -%}\n<div class=\"esg-r50-shipbox\">\n  <div class=\"esg-r50-shipbox__title\">Free 2-Day Shipping + 30-Day Returns</div>\n  <div class=\"esg-r50-shipbox__text\">\n    Order your <strong>GolfJoy Spica 3</strong> by 2PM ET for same-day shipping.\n  </div>\n  <div class=\"esg-r50-shipbox__timer\">\n    Order within <span id=\"esg-r50-countdown\">22 Hrs 0 Mins</span>\n  </div>\n</div>\n\n<style>\n  .esg-r50-shipbox {\n    max-width: 1100px;\n    margin: 12px 0;\n    padding: 12px 14px;\n    border: 1.5px solid #198f2d;\n    border-radius: 10px;\n    background: #eef6ee;\n    color: #102a43;\n    line-height: 1.35;\n  }\n\n  .esg-r50-shipbox__title {\n    font-size: 18px;\n    font-weight: 800;\n    color: #198f2d;\n    margin-bottom: 4px;\n  }\n\n  .esg-r50-shipbox__text {\n    font-size: 14px;\n    margin-bottom: 4px;\n  }\n\n  .esg-r50-shipbox__text strong {\n    font-weight: 800;\n  }\n\n  .esg-r50-shipbox__timer {\n    font-size: 14px;\n    font-weight: 600;\n  }\n\n  .esg-r50-shipbox__timer span {\n    color: #198f2d;\n    font-weight: 800;\n    white-space: nowrap;\n  }\n\n  @media (max-width: 749px) {\n    .esg-r50-shipbox {\n      padding: 10px 12px;\n      border-radius: 8px;\n    }\n\n    .esg-r50-shipbox__title {\n      font-size: 14px;\n    }\n\n    .esg-r50-shipbox__text,\n    .esg-r50-shipbox__timer {\n      font-size: 13px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var countdownEl = document.getElementById(\"esg-r50-countdown\");\n    if (!countdownEl) return;\n\n    function updateCountdown() {\n      var now = new Date();\n      var estString = now.toLocaleString(\"en-US\", { timeZone: \"America/New_York\" });\n      var estNow = new Date(estString);\n\n      var cutoff = new Date(estNow);\n      cutoff.setHours(14, 0, 0, 0);\n\n      if (estNow >= cutoff) {\n        cutoff.setDate(cutoff.getDate() + 1);\n      }\n\n      var diff = cutoff - estNow;\n      var hrs = Math.floor(diff / (1000 * 60 * 60));\n      var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));\n\n      countdownEl.textContent = hrs + \" Hrs \" + mins + \" Mins\";\n    }\n\n    updateCountdown();\n    setInterval(updateCountdown, 60000);\n  })();\n</script>\n{%- endif -%}"
