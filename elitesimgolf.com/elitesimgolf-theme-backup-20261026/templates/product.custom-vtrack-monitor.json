    "sn_benefits_GXtkrM": {
      "type": "sn-benefits",
      "blocks": {
        "benefit_4rJzMK": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/ceiling.svg",
            "title": "<strong>🏔️ Nothing on the Floor — Ever</strong>",
            "text": "<p>VTrack mounts to your ceiling and stays there. No floor unit to aim around, nothing to trip on, nothing expensive sitting in the path of a mishit. Your bay stays clean, open, and ready for any golfer.</p>",
            "class": ""
          }
        },
        "benefit_yiABce": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/flash.svg",
            "title": "<strong>🎯 Drop a Ball. Swing. That's It.</strong>",
            "text": "<p>No stickers on your clubs. No reflective dots. No special marked balls required. VTrack's markerless camera system captures everything at contact with a standard golf ball and your own clubs — exactly as golf should be played.</p>",
            "class": ""
          }
        },
        "benefit_LAbTqi": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/slow-motion.svg",
            "title": "<strong>🎬 See What Actually Happens at Impact</strong>",
            "text": "<p>VTrack automatically captures slow-motion impact video of every shot, showing you exactly how the club is delivering the ball at contact. It bridges the gap between feel and reality — one of the most powerful feedback tools available in this price range.</p>",
            "class": ""
          }
        },
        "benefit_kQBhPN": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/dashboard.svg",
            "title": "<strong>📊 Data Deep Enough to Actually Improve</strong>",
            "text": "<p>25+ ball and club parameters including ball speed, spin rate, spin axis, launch angle, club path, face angle, attack angle, dynamic loft, and impact location. Not just carry distance — real performance data for real improvement.</p>",
            "class": ""
          }
        },
        "benefit_QVUAzY": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/link.svg",
            "title": "<strong>🔗 GSPro and E6 — Ready Out of the Box</strong>",
            "text": "<p>VTrack connects to GSPro, E6 Connect, and E6 Apex without workarounds. It also includes VTrack ToolKit for settings and calibration, VTrack Practice Range for structured sessions, and CSV export for coaching or tracking progress over time.</p>",
            "class": ""
          }
        },
        "benefit_nnNCzh": {
          "type": "benefit",
          "settings": {
            "icon": "shopify://shop_images/save-money.svg",
            "title": "<strong>💰 No Mandatory Subscription for Core Use</strong>",
            "text": "<p>There is no required recurring fee to unlock the VTrack's core tracking functionality. Play and practice with the hardware you own. Third-party software like GSPro or E6 may have their own licenses, but the launch monitor itself doesn't hold your data hostage.</p>",
            "class": ""
          }
        }
      },
      "block_order": [
