          "name": "VTRACK Shipping/Inventory Notice",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- assign on_hand = product.selected_or_first_available_variant.inventory_quantity | default: 0 -%}\n{%- assign incoming_po = product.metafields.custom.incoming_po_qty | default: 0 -%}\n\n<div class=\"esg-vtrack-stock-box\">\n  <div class=\"esg-vtrack-stock-header\">\n    <span class=\"esg-vtrack-stock-dot\"></span>\n    <span>Live Inventory & Shipping</span>\n  </div>\n\n  <!-- Inventory Row -->\n  <div class=\"esg-vtrack-stock-row\">\n    <div class=\"esg-vtrack-stock-left\">\n      <div class=\"esg-vtrack-stock-label\">Inventory</div>\n\n      {%- if on_hand > 0 -%}\n        <div class=\"esg-vtrack-stock-value\">{{ on_hand }} In Stock</div>\n        <div class=\"esg-vtrack-stock-sub\">Ready to ship now.</div>\n      {%- elsif incoming_po > 0 -%}\n        <div class=\"esg-vtrack-stock-value\">{{ incoming_po }} Incoming</div>\n        <div class=\"esg-vtrack-stock-sub\">More units on the way.</div>\n      {%- else -%}\n        <div class=\"esg-vtrack-stock-value\">Check Availability</div>\n        <div class=\"esg-vtrack-stock-sub\">Contact us for current lead time.</div>\n      {%- endif -%}\n    </div>\n\n    {%- if on_hand > 0 and incoming_po > 0 -%}\n      <div class=\"esg-vtrack-stock-pill\">+ {{ incoming_po }} incoming</div>\n    {%- endif -%}\n  </div>\n\n  <!-- Shipping Row -->\n  <div class=\"esg-vtrack-stock-row\">\n    <div class=\"esg-vtrack-stock-left\">\n      <div class=\"esg-vtrack-stock-label\">Same-Day Shipping via UPS Next Day Air</div>\n\n      {%- if on_hand > 0 -%}\n        <div class=\"esg-vtrack-stock-value\">Order by 4PM ET</div>\n        <div class=\"esg-vtrack-stock-sub\">Ships same business day, arrives the following day!</div>\n      {%- else -%}\n        <div class=\"esg-vtrack-stock-value\">Fast Fulfillment</div>\n        <div class=\"esg-vtrack-stock-sub\">Applies to in-stock units.</div>\n      {%- endif -%}\n    </div>\n\n    {%- if on_hand > 0 -%}\n      <div class=\"esg-vtrack-stock-timer\" id=\"esg-vtrack-cutoff-timer\">Calculating…</div>\n    {%- endif -%}\n  </div>\n</div>\n\n<style>\n  .esg-vtrack-stock-box {\n    max-width: 1100px;\n    margin: 14px 0;\n    padding: 10px 12px;\n    border-radius: 12px;\n    border: 1px solid rgba(8,110,211,.22);\n    background: #086ed3;\n    box-shadow: 0 10px 24px rgba(29,78,216,.18);\n    font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;\n    color: #ffffff;\n    line-height: 1.25;\n  }\n\n  .esg-vtrack-stock-header {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 10.5px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: .08em;\n    color: rgba(255,255,255,.92);\n    margin-bottom: 8px;\n  }\n\n  .esg-vtrack-stock-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 999px;\n    background: #ffffff;\n    box-shadow: 0 0 0 4px rgba(255,255,255,.14);\n    flex: 0 0 auto;\n  }\n\n  .esg-vtrack-stock-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    padding: 8px 0;\n    border-top: 1px solid rgba(255,255,255,.16);\n  }\n\n  .esg-vtrack-stock-row:first-of-type {\n    border-top: 0;\n    padding-top: 0;\n  }\n\n  .esg-vtrack-stock-left {\n    min-width: 0;\n  }\n\n  .esg-vtrack-stock-label {\n    font-size: 10px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: .07em;\n    color: rgba(255,255,255,.82);\n    margin-bottom: 2px;\n  }\n\n  .esg-vtrack-stock-value {\n    font-size: 17px;\n    font-weight: 900;\n    color: #ffffff;\n    line-height: 1.1;\n    margin-bottom: 1px;\n  }\n\n  .esg-vtrack-stock-sub {\n    font-size: 11px;\n    color: rgba(255,255,255,.9);\n    line-height: 1.3;\n  }\n\n  .esg-vtrack-stock-pill {\n    display: inline-flex;\n    align-items: center;\n    white-space: nowrap;\n    padding: 5px 8px;\n    border-radius: 999px;\n    background: rgba(255,255,255,.18);\n    border: 1px solid rgba(255,255,255,.24);\n    color: #ffffff;\n    font-size: 10.5px;\n    font-weight: 900;\n    line-height: 1;\n  }\n\n  .esg-vtrack-stock-timer {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    white-space: nowrap;\n    padding: 6px 9px;\n    border-radius: 999px;\n    background: #ffffff;\n    color: #1d4ed8;\n    font-size: 10.5px;\n    font-weight: 900;\n    line-height: 1.1;\n    box-shadow: 0 2px 8px rgba(255,255,255,.18);\n  }\n\n  @media (max-width: 749px) {\n    .esg-vtrack-stock-row {\n      align-items: flex-start;\n      flex-direction: column;\n      gap: 6px;\n    }\n\n    .esg-vtrack-stock-value {\n      font-size: 16px;\n    }\n\n    .esg-vtrack-stock-timer,\n    .esg-vtrack-stock-pill {\n      align-self: flex-start;\n    }\n  }\n</style>\n\n<script>\n  (function() {\n    var timerEl = document.getElementById('esg-vtrack-cutoff-timer');\n    if (!timerEl) return;\n\n    function getEasternTimeParts(date) {\n      var parts = new Intl.DateTimeFormat('en-US', {\n        timeZone: 'America/New_York',\n        year: 'numeric',\n        month: 'numeric',\n        day: 'numeric',\n        hour: 'numeric',\n        minute: 'numeric',\n        second: 'numeric',\n        hour12: false\n      }).formatToParts(date);\n\n      var map = {};\n      parts.forEach(function(part) {\n        if (part.type !== 'literal') map[part.type] = parseInt(part.value, 10);\n      });\n      return map;\n    }\n\n    function updateTimer() {\n      var now = new Date();\n      var et = getEasternTimeParts(now);\n      var currentSeconds = (et.hour * 3600) + (et.minute * 60) + et.second;\n      var cutoffSeconds = 16 * 3600;\n      var remaining = cutoffSeconds - currentSeconds;\n\n      if (remaining > 0) {\n        var hrs = Math.floor(remaining / 3600);\n        var mins = Math.floor((remaining % 3600) / 60);\n        var secs = remaining % 60;\n        timerEl.textContent = hrs + 'h ' + mins + 'm ' + secs + 's left';\n      } else {\n        timerEl.textContent = 'Cutoff passed';\n      }\n    }\n\n    updateTimer();\n    setInterval(updateTimer, 1000);\n  })();\n</script>"
