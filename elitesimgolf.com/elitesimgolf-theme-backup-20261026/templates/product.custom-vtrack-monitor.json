    "sn_product_intro_3qBL4H": {
      "type": "sn-product-intro",
      "blocks": {
        "text_WFQCrb": {
          "type": "text",
          "settings": {
            "text": "<p>The Overhead Launch Monitor Built for Serious Home Simulators</p>",
            "class": "sn-uppercase sn-highlight mb-2"
          }
        },
        "text_Vibkg9": {
          "type": "text",
          "settings": {
            "text": "<h2>Pro-level overhead tracking. Clean setup. No compromise.</h2>",
            "class": ""
          }
        },
        "text_khdp7V": {
          "type": "text",
          "settings": {
            "text": "<p>The Laon Swingcraft VTrack is a ceiling-mounted, photometric golf launch monitor designed for home simulators and private studios that demand real data without the clutter of a floor unit. It mounts overhead, tracks every shot with dual high-speed cameras, and delivers detailed ball and club data in real time — without stickers, without special balls, and without a mandatory subscription just to use the hardware you own.</p><p>With a generous 31\" × 24\" hitting zone, left and right-handed support, slow-motion impact video, and compatibility with GSPro and E6, the VTrack turns a well-planned simulator bay into a performance tool you'll actually use every day.</p>",
            "class": ""
          }
        },
        "stats_TwgF7F": {
          "type": "stats",
          "settings": {
            "title1": "25+",
            "text1": "Shot Parameters",
            "title2": "<strong>31\" × 24\"</strong>",
            "text2": "Hitting Zone",
            "title3": "<strong>~250ms</strong>",
            "text3": "Shot Feedback",
            "title4": "<strong>106\"</strong>",
            "text4": "Min. Ceiling Height",
            "class": "mt-2"
          }
        },
        "review_Nt8F9e": {
          "type": "review",
          "settings": {
            "message": "<p><em>\"Fantastic OHLM! Very impressed with the accuracy and easy integration with GSPro. Been using the VTrack in our commercial setting for a few weeks now and all the customers are loving the experience.\"</em></p>",
            "letters": "BG",
            "name": "Barton G.",
            "info": "Verified Purchase",
            "class": "mb-2"
          }
        },
        "review_XTNar4": {
          "type": "review",
          "settings": {
            "message": "<p><em>\"I find the VTrack to be consistently accurate. We play several rounds per day and any misreads are 98% human error — and they are few. The data it provides is very helpful. The support from Elite Sim Golf from start to way after the sale has been outstanding.\"</em></p>",
            "letters": "CL",
            "name": "Chuck L.",
            "info": "Verified Purchase",
            "class": ""
          }
        }
      },
