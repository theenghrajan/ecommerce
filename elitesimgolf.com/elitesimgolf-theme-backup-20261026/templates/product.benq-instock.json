        "custom_liquid_tbWYJT": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "<div class=\"esg-why-buy-box\">\n  <div class=\"esg-why-buy-accent\"></div>\n\n  <div class=\"esg-why-buy-header\">\n    <span class=\"esg-why-buy-header-icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M20 6 9 17l-5-5\"></path>\n      </svg>\n    </span>\n    <span>Why Buy from Elite Sim Golf</span>\n  </div>\n\n  <div class=\"esg-why-buy-grid\">\n    <!-- Item 1: Authorized Dealer -->\n    <div class=\"esg-why-buy-item\">\n      <div class=\"esg-why-buy-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n          <path d=\"M22 4L12 14.01l-3-3\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-why-buy-content\">\n        <div class=\"esg-why-buy-title\">Authorized {{ product.vendor }} Dealer</div>\n        <div class=\"esg-why-buy-text\">Premier {{ product.vendor }} Partner.</div>\n      </div>\n    </div>\n\n    <!-- Item 2: Fast Shipping -->\n    <div class=\"esg-why-buy-item\">\n      <div class=\"esg-why-buy-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n          <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n          <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        </svg>\n      </div>\n      <div class=\"esg-why-buy-content\">\n        <div class=\"esg-why-buy-title\">Ships Same Business Day*</div>\n        <div class=\"esg-why-buy-text\">Orders placed before <strong>2PM ET</strong>.</div>\n      </div>\n    </div>\n\n    <!-- Item 3: Free Shipping -->\n    <div class=\"esg-why-buy-item\">\n      <div class=\"esg-why-buy-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path>\n          <polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"></polyline>\n          <line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"></line>\n        </svg>\n      </div>\n      <div class=\"esg-why-buy-content\">\n        <div class=\"esg-why-buy-title\">Free Shipping on Most Orders</div>\n        <div class=\"esg-why-buy-text\">Ships free; may qualify for no sales tax.</div>\n      </div>\n    </div>\n\n    <!-- Item 4: Real Experts -->\n    <div class=\"esg-why-buy-item\">\n      <div class=\"esg-why-buy-icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-why-buy-content\">\n        <div class=\"esg-why-buy-title\">Real Golf Experts, Not Bots</div>\n        <div class=\"esg-why-buy-text\">Call <a href=\"tel:+18664746465\" class=\"esg-why-buy-link\">866-4-SIM-GOLF</a> anytime.</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .esg-why-buy-box {\n    max-width: 1100px;\n    margin: 12px 0;\n    position: relative;\n    overflow: hidden;\n    padding: 11px 14px 12px;\n    border: 1px solid #e5e7eb;\n    border-radius: 14px;\n    background: #ffffff;\n    box-shadow: 0 6px 16px rgba(15, 23, 42, .04);\n    color: #2a3756;\n    font-family: inherit;\n    line-height: 1.35;\n  }\n\n  .esg-why-buy-accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 3px;\n    background: linear-gradient(90deg, #086ED3 0%, #0A1A3A 100%);\n  }\n\n  .esg-why-buy-header {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-bottom: 10px;\n    color: #086ED3;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .esg-why-buy-header-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 14px;\n    height: 14px;\n    color: #086ED3;\n  }\n\n  .esg-why-buy-header-icon svg {\n    width: 14px;\n    height: 14px;\n    display: block;\n  }\n\n  .esg-why-buy-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 10px 16px;\n  }\n\n  .esg-why-buy-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 8px;\n    min-width: 0;\n  }\n\n  .esg-why-buy-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 26px;\n    height: 26px;\n    min-width: 26px;\n    border-radius: 8px;\n    background: #eff6ff;\n    color: #086ED3;\n    flex: 0 0 auto;\n    margin-top: 1px;\n  }\n\n  .esg-why-buy-icon svg {\n    width: 14px;\n    height: 14px;\n    display: block;\n  }\n\n  .esg-why-buy-content {\n    min-width: 0;\n  }\n\n  .esg-why-buy-title {\n    color: #0A1A3A;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    line-height: 1.15;\n    margin-bottom: 2px;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .esg-why-buy-text {\n    color: #2a3756;\n    font-size: 10px;\n    line-height: 1.4;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .esg-why-buy-text strong {\n    color: #0A1A3A;\n    font-weight: 700;\n  }\n\n  .esg-why-buy-link {\n    color: #086ED3;\n    font-weight: 700;\n    text-decoration: none;\n    border-bottom: 1px solid rgba(8, 110, 211, .35);\n  }\n\n  .esg-why-buy-link:hover {\n    border-bottom-color: #086ED3;\n  }\n\n  @media (max-width: 749px) {\n    .esg-why-buy-box {\n      padding: 11px 12px 12px;\n      border-radius: 12px;\n    }\n\n    .esg-why-buy-grid {\n      grid-template-columns: 1fr;\n      gap: 10px;\n    }\n\n    .esg-why-buy-title,\n    .esg-why-buy-text {\n      white-space: normal;\n    }\n\n    .esg-why-buy-text {\n      font-size: 10px;\n    }\n\n    .esg-why-buy-title {\n      font-size: 10px;\n    }\n  }\n</style>"
