          "settings": {
            "custom_liquid": "{%- comment -%}\n==================================================\nESG PDP PROMO BOX — PGA CHAMPIONSHIP SALE\nTrigger: product tag \"CHAMP\"\nCoupon Code: CHAMP\nShow Date: May 11, 2026\nHide After: May 25, 2026\n==================================================\n{%- endcomment -%}\n\n{%- assign today_ts = 'now' | date: '%s' -%}\n{%- assign start_ts = '2026-05-11' | date: '%s' -%}\n{%- assign cutoff_ts = '2026-05-26' | date: '%s' -%}\n\n{%- if product.tags contains 'CHAMP' and today_ts >= start_ts and today_ts < cutoff_ts -%}\n\n<div class=\"esg-pga-promo-box\">\n  <div class=\"esg-pga-promo-box__inner\">\n    <div class=\"esg-pga-promo-box__badge\">\n🏆 PGA Championship Sale 🏆\n    </div>\n\n    <div class=\"esg-pga-promo-box__content\">\n      <div class=\"esg-pga-promo-box__kicker\">\n      </div>\n\n      <div class=\"esg-pga-promo-box__title\">\n        Save During Major Championship Week\n      </div>\n\n      <p class=\"esg-pga-promo-box__text\">\n        Upgrade your golf simulator setup during one of golf’s biggest weeks. Use coupon code\n        <strong>CHAMP</strong> at checkout to unlock limited-time savings on eligible products, with discounts varying by product and select items discounted up to 20%.\n      </p>\n\n      <div class=\"esg-pga-promo-box__coupon-row\">\n        <div class=\"esg-pga-promo-box__coupon\">\n          <span>Code:</span>\n          <strong id=\"esg-pga-code\">CHAMP</strong>\n        </div>\n\n        <button\n          type=\"button\"\n          class=\"esg-pga-promo-box__copy\"\n          onclick=\"\n            navigator.clipboard.writeText('CHAMP');\n            this.innerText='Copied!';\n            setTimeout(() => this.innerText='Copy Code', 1800);\n          \"\n        >\n          Copy Code\n        </button>\n      </div>\n\n      <div class=\"esg-pga-promo-box__fineprint\">\n        Sale runs May 11–25, 2026. Valid on eligible products only. Discounts vary by product. Select products may be discounted up to 20%. Discount applied at checkout with code CHAMP.\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .esg-pga-promo-box {\n    margin: 16px 0 20px;\n    padding: 2px;\n    border-radius: 20px;\n    background:\n      linear-gradient(135deg, #d7b46a 0%, #f3d890 35%, #086ED3 70%, #06111f 100%);\n    box-shadow: 0 14px 30px rgba(8, 110, 211, 0.18);\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  }\n\n  .esg-pga-promo-box__inner {\n    position: relative;\n    overflow: hidden;\n    border-radius: 18px;\n    padding: 18px;\n    background:\n      radial-gradient(circle at top left, rgba(243, 216, 144, 0.26), transparent 34%),\n      linear-gradient(135deg, #06111f 0%, #0b2442 48%, #071827 100%);\n    color: #ffffff;\n  }\n\n  .esg-pga-promo-box__inner::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px),\n      linear-gradient(0deg, rgba(255,255,255,0.035) 1px, transparent 1px);\n    background-size: 22px 22px;\n    opacity: 0.42;\n    pointer-events: none;\n  }\n\n  .esg-pga-promo-box__inner::after {\n    content: \"🏆\";\n    position: absolute;\n    right: 18px;\n    top: 14px;\n    font-size: 58px;\n    line-height: 1;\n    opacity: 0.14;\n    transform: rotate(-8deg);\n    pointer-events: none;\n  }\n\n  .esg-pga-promo-box__badge {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    margin-bottom: 11px;\n    padding: 6px 11px;\n    border-radius: 999px;\n    background: rgba(243, 216, 144, 0.16);\n    border: 1px solid rgba(243, 216, 144, 0.45);\n    color: #f7df9b;\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    z-index: 1;\n  }\n\n  .esg-pga-promo-box__content {\n    position: relative;\n    z-index: 1;\n  }\n\n  .esg-pga-promo-box__kicker {\n    margin-bottom: 3px;\n    color: #f7df9b;\n    font-size: 13px;\n    font-weight: 900;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n\n  .esg-pga-promo-box__title {\n    margin-bottom: 6px;\n    color: #ffffff;\n    font-size: 21px;\n    line-height: 1.18;\n    font-weight: 950;\n  }\n\n  .esg-pga-promo-box__text {\n    max-width: 720px;\n    margin: 0 0 14px;\n    color: rgba(255, 255, 255, 0.9);\n    font-size: 14.5px;\n    line-height: 1.55;\n  }\n\n  .esg-pga-promo-box__text strong {\n    color: #f7df9b;\n    font-weight: 950;\n  }\n\n  .esg-pga-promo-box__coupon-row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    align-items: center;\n    margin-top: 10px;\n  }\n\n  .esg-pga-promo-box__coupon {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    min-height: 42px;\n    padding: 8px 14px;\n    border-radius: 14px;\n    background: rgba(255, 255, 255, 0.09);\n    border: 1px dashed rgba(243, 216, 144, 0.62);\n    color: #ffffff;\n    font-size: 14px;\n    font-weight: 800;\n  }\n\n  .esg-pga-promo-box__coupon span {\n    color: rgba(255, 255, 255, 0.72);\n    font-weight: 800;\n  }\n\n  .esg-pga-promo-box__coupon strong {\n    color: #f7df9b;\n    font-size: 18px;\n    letter-spacing: 0.16em;\n    font-weight: 950;\n  }\n\n  .esg-pga-promo-box__copy {\n    min-height: 42px;\n    padding: 9px 15px;\n    border: 0;\n    border-radius: 14px;\n    background: #086ED3;\n    color: #ffffff;\n    cursor: pointer;\n    font-size: 14px;\n    font-weight: 900;\n    box-shadow: 0 8px 20px rgba(8, 110, 211, 0.35);\n    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;\n  }\n\n  .esg-pga-promo-box__copy:hover {\n    transform: translateY(-1px);\n    background: #075fba;\n    box-shadow: 0 10px 24px rgba(8, 110, 211, 0.45);\n  }\n\n  .esg-pga-promo-box__fineprint {\n    margin-top: 11px;\n    color: rgba(255, 255, 255, 0.66);\n    font-size: 12px;\n    line-height: 1.4;\n  }\n\n  @media (max-width: 640px) {\n    .esg-pga-promo-box__inner {\n      padding: 16px;\n    }\n\n    .esg-pga-promo-box__title {\n      font-size: 19px;\n    }\n\n    .esg-pga-promo-box__coupon-row {\n      align-items: stretch;\n    }\n\n    .esg-pga-promo-box__coupon,\n    .esg-pga-promo-box__copy {\n      width: 100%;\n      justify-content: center;\n    }\n  }\n</style>\n\n{%- endif -%}"
