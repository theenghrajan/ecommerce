      "disabled": true,
      "name": "Trust Strip",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Elite Sim Golf — Full-Width Trust Bar\n  - Drop into a section with full-width layout (above gallery, below ATC, or above footer)\n  - Default: light variant\n  - Add class \"esg-trust-bar--dark\" on the outer wrapper for the navy variant\n  - 4-up on desktop, 2-up on tablet, stacked on mobile\n{%- endcomment -%}\n\n<div class=\"esg-trust-bar\">\n  <div class=\"esg-trust-bar__accent\"></div>\n  <div class=\"esg-trust-bar__inner\">\n\n    <div class=\"esg-trust-bar__item\">\n      <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n          <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n          <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        </svg>\n      </div>\n      <div class=\"esg-trust-bar__content\">\n        <div class=\"esg-trust-bar__title\">Free U.S. Shipping</div>\n        <div class=\"esg-trust-bar__text\">Fast, expedited delivery on most orders.</div>\n      </div>\n    </div>\n\n    <div class=\"esg-trust-bar__item\">\n      <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z\"></path>\n          <path d=\"m9 12 2 2 4-4\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-trust-bar__content\">\n        <div class=\"esg-trust-bar__title\">30-Day Risk-Free Guarantee</div>\n        <div class=\"esg-trust-bar__text\">Not happy? Send it back — no hassle.</div>\n      </div>\n    </div>\n\n    <div class=\"esg-trust-bar__item\">\n      <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-trust-bar__content\">\n        <div class=\"esg-trust-bar__title\">Real Golf Experts</div>\n        <div class=\"esg-trust-bar__text\">Call <a href=\"tel:+18664746465\" class=\"esg-trust-bar__link\">866-4-SIM-GOLF</a> — not bots.</div>\n      </div>\n    </div>\n\n    <div class=\"esg-trust-bar__item\">\n      <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n          <path d=\"M22 4L12 14.01l-3-3\"></path>\n        </svg>\n      </div>\n      <div class=\"esg-trust-bar__content\">\n        <div class=\"esg-trust-bar__title\">Authorized Dealer</div>\n        <div class=\"esg-trust-bar__text\">Backed by every brand we carry.</div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .esg-trust-bar {\n    position: relative;\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n    border-top: 1px solid #e5e7eb;\n    border-bottom: 1px solid #e5e7eb;\n    color: #2a3756;\n    font-family: inherit;\n    line-height: 1.4;\n    overflow: hidden;\n  }\n\n  .esg-trust-bar__accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 3px;\n    background: linear-gradient(90deg, #086ED3 0%, #0A1A3A 100%);\n    z-index: 1;\n  }\n\n  .esg-trust-bar__inner {\n    max-width: 1500px;\n    margin: 0 auto;\n    padding: 18px 32px;\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 20px 28px;\n    align-items: center;\n  }\n\n  .esg-trust-bar__item {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    min-width: 0;\n  }\n\n  .esg-trust-bar__icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 38px;\n    height: 38px;\n    min-width: 38px;\n    border-radius: 10px;\n    background: #eff6ff;\n    color: #086ED3;\n    flex: 0 0 auto;\n  }\n\n  .esg-trust-bar__icon svg {\n    width: 20px;\n    height: 20px;\n    display: block;\n  }\n\n  .esg-trust-bar__content {\n    min-width: 0;\n  }\n\n  .esg-trust-bar__title {\n    color: #0A1A3A;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 15px;\n    font-weight: 800;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    line-height: 1.15;\n    margin-bottom: 2px;\n  }\n\n  .esg-trust-bar__text {\n    color: #2a3756;\n    font-size: 12.5px;\n    line-height: 1.4;\n  }\n\n  .esg-trust-bar__link {\n    color: #086ED3;\n    font-weight: 700;\n    text-decoration: none;\n    border-bottom: 1px solid rgba(8, 110, 211, .35);\n  }\n\n  .esg-trust-bar__link:hover {\n    border-bottom-color: #086ED3;\n  }\n\n  /* ---------- Dark variant ---------- */\n  .esg-trust-bar--dark {\n    background: #0A1A3A;\n    border-top-color: rgba(255, 255, 255, .08);\n    border-bottom-color: rgba(255, 255, 255, .08);\n    color: #C9D6F2;\n  }\n\n  .esg-trust-bar--dark .esg-trust-bar__icon {\n    background: rgba(255, 255, 255, .08);\n    color: #ffffff;\n  }\n\n  .esg-trust-bar--dark .esg-trust-bar__title {\n    color: #ffffff;\n  }\n\n  .esg-trust-bar--dark .esg-trust-bar__text {\n    color: #C9D6F2;\n  }\n\n  .esg-trust-bar--dark .esg-trust-bar__link {\n    color: #ffffff;\n    border-bottom-color: rgba(255, 255, 255, .35);\n  }\n\n  .esg-trust-bar--dark .esg-trust-bar__link:hover {\n    border-bottom-color: #ffffff;\n  }\n\n  /* ---------- Breakpoints ---------- */\n  @media (max-width: 1024px) {\n    .esg-trust-bar__inner {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 16px 24px;\n      padding: 16px 24px;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .esg-trust-bar__inner {\n      grid-template-columns: 1fr;\n      gap: 12px;\n      padding: 14px 18px;\n    }\n\n    .esg-trust-bar__icon {\n      width: 34px;\n      height: 34px;\n      min-width: 34px;\n      border-radius: 9px;\n    }\n\n    .esg-trust-bar__icon svg {\n      width: 18px;\n      height: 18px;\n    }\n\n    .esg-trust-bar__title {\n      font-size: 14px;\n    }\n\n    .esg-trust-bar__text {\n      font-size: 12px;\n    }\n  }\n</style>",
        "full_width": true,
