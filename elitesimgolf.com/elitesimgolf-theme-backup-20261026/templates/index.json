    "custom_faqs_4bPdQT": {
      "type": "custom-faqs",
      "blocks": {
        "faq_item_QrYF8j": {
          "type": "faq_item",
          "settings": {
            "question": "What's included in a simulator package?",
            "answer": "<p>Our simulator packages include everything you need: a high-accuracy launch monitor, impact screen, projector, hitting mat, and software. Optional add-ons like enclosures and premium frames are also available.</p>"
          }
        },
        "faq_item_JbwVWm": {
          "type": "faq_item",
          "settings": {
            "question": "How much space do I need for a golf simulator?",
            "answer": "<p>We recommend a minimum of 10ft wide × 10ft deep × 9ft high. Ideal setups are 12–15ft wide with 10ft ceilings, but we have solutions for a variety of room sizes — reach out and we'll find the right fit.</p>"
          }
        },
        "faq_item_NRK3Dq": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need any technical experience to set one up?",
            "answer": "<p>No technical experience required. Every kit comes with step-by-step assembly manuals and access to our remote support team. We also offer professional installation services if preferred.</p>"
          }
        },
        "faq_item_apWer3": {
          "type": "faq_item",
          "settings": {
            "question": "What launch monitors do you carry?",
            "answer": "<p>We carry all major brands including Trackman, Foresight Sports, Uneekor, Garmin Approach, and FlightScope — covering a wide range of budgets and accuracy levels.</p>"
          }
        },
        "faq_item_FD8nDb": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer financing?",
            "answer": "<p>Yes! We offer flexible financing options through our payment partners. Many customers qualify for 0% APR promotional periods. Contact us for details or apply at checkout.</p>"
          }
        },
        "faq_item_jWdMyx": {
          "type": "faq_item",
          "settings": {
            "question": "What if something arrives damaged or doesn't work?",
            "answer": "<p>All products are covered by our warranty and our dedicated support team. If anything arrives damaged, contact us within 48 hours and we'll arrange a replacement or resolution — no hassle.</p>"
          }
        }
      },
