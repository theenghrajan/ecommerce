      "type": "sn-faq",
      "blocks": {
        "collapsible_Hg7fnW": {
          "type": "collapsible",
          "settings": {
            "icon": "shopify://shop_images/question.svg",
            "question": "<strong>What's included in a simulator package?</strong>",
            "answer": "<p>A: Our packages include everything you need to start playing — an enclosure, impact screen, launch monitor, and projector. Some packages also include hitting mats, software, and mounting hardware. Each product page lists exactly what's in the box.</p>",
            "class": "mt-1"
          }
        },
        "collapsible_rGGJVD": {
          "type": "collapsible",
          "settings": {
            "icon": "shopify://shop_images/question.svg",
            "question": "<strong>How much space do I need for a golf simulator?</strong>",
            "answer": "<p>A: Most setups fit comfortably in a standard garage bay or basement. Our smallest enclosure (Birdie 10) starts at 10' wide x 8.5' high x 5' deep. We recommend at least 12–14 feet of ceiling clearance for a full, comfortable swing.</p>",
            "class": ""
          }
        },
        "collapsible_HCtyht": {
          "type": "collapsible",
          "settings": {
            "icon": "shopify://shop_images/question.svg",
            "question": "<strong>Do I need any technical experience to set one up?</strong>",
            "answer": "<p>A: No. Our packages are designed to be plug-and-play. Most customers have everything up and running within a few hours. We also have assembly manuals, video guides, and a support team you can call or text if you get stuck.</p>",
            "class": ""
          }
        },
        "collapsible_QCrmcm": {
          "type": "collapsible",
          "settings": {
            "icon": "shopify://shop_images/question.svg",
            "question": "<strong>What launch monitors do you carry?</strong>",
            "answer": "<p>A: We carry top brands including Garmin, Uneekor, VTrack, FlightScope, and Rapsodo — covering a range of budgets and use cases, from casual home use to serious game improvement.</p>",
            "class": ""
          }
        },
        "collapsible_3pVT4B": {
          "type": "collapsible",
          "settings": {
            "icon": "shopify://shop_images/question.svg",
            "question": "<strong>Do you offer financing?</strong>",
            "answer": "<p>A: Yes. We support multiple payment options including Shop Pay installments, PayPal, and more at checkout. You can get a high-end setup without paying everything upfront.</p><p>\"Rates from 0%-36% APR. Payment options through Shop Pay Installments, are subject to an eligibility check and are provided by these lending partners: <a href=\"https://www.affirm.com/lenders\" title=\"https://www.affirm.com/lenders\">affirm.com/lenders</a>. Options depend on your purchase amount, and a down payment may be required. State notices to consumers <a href=\"https://www.affirm.com/licenses\" title=\"https://www.affirm.com/licenses\">https://www.affirm.com/licenses</a>.\"</p>",
            "class": ""
          }
        },
        "collapsible_FC7wgB": {
          "type": "collapsible",
          "settings": {
            "icon": "shopify://shop_images/question.svg",
            "question": "<strong>What if something arrives damaged or doesn't work?</strong>",
            "answer": "<p>A: Contact us and we'll make it right. Our support team is available Monday–Friday 9AM–6PM, and you can reach us by phone, text, or email anytime.</p>",
            "class": ""
          }
        }
      },
