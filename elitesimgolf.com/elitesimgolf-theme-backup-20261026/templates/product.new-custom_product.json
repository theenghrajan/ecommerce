    "custom_liquid_xz3Bbp": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Trust Strip",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Elite Sim Golf — Full-Width Trust Bar (Flat, Configurable)\n  ---------------------------------------------------------------\n  Default 4 items, in order:\n    1. Live Chat + Call/Text (combined)\n    2. Price Match Guarantee\n    3. Authorized {{ product.vendor }} Dealer\n    4. Financing Available\n\n  Available item slugs:\n    chat_call, price_match, authorized, financing,\n    shipping, guarantee, family_owned\n\n  \"guarantee\" only renders if product is tagged\n    30-day-guarantee / 30-day-trial / 30day / 30-day\n\n  Bar auto-flows between 4 / 3 / 2 / 1 columns based on item count.\n  Default: light. Add class \"esg-trust-bar--dark\" for navy variant.\n{%- endcomment -%}\n\n{%- comment -%} ====== EDIT THIS LIST TO CHANGE ITEMS ====== {%- endcomment -%}\n{%- assign items = 'authorized,chat_call,price_match,financing' | split: ',' -%}\n\n{%- comment -%} 30-Day guarantee tag check {%- endcomment -%}\n{%- assign tags_dc = product.tags | join: '|' | downcase | split: '|' -%}\n{%- assign show_guarantee = false -%}\n{%- if tags_dc contains '30-day-guarantee' or tags_dc contains '30-day-trial' or tags_dc contains '30day' or tags_dc contains '30-day' -%}\n  {%- assign show_guarantee = true -%}\n{%- endif -%}\n\n{%- assign vendor_name = product.vendor | default: 'Top Brands' -%}\n\n{%- comment -%} Build active list, filtering guarantee when ineligible {%- endcomment -%}\n{%- assign active = '' -%}\n{%- for slug in items -%}\n  {%- assign s = slug | strip -%}\n  {%- if s == 'guarantee' and show_guarantee == false -%}{%- continue -%}{%- endif -%}\n  {%- if active == '' -%}\n    {%- assign active = s -%}\n  {%- else -%}\n    {%- assign active = active | append: ',' | append: s -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- assign active_items = active | split: ',' -%}\n{%- assign item_count = active_items.size -%}\n\n<div class=\"esg-trust-bar esg-trust-bar--cols-{{ item_count }}\">\n  <div class=\"esg-trust-bar__accent\"></div>\n  <div class=\"esg-trust-bar__inner\">\n\n    {%- for slug in active_items -%}\n\n      {%- if slug == 'chat_call' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path>\n              <circle cx=\"9\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <circle cx=\"12.5\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <circle cx=\"16\" cy=\"11.5\" r=\".9\" fill=\"currentColor\"></circle>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Golf Sim Pros</div>\n            <div class=\"esg-trust-bar__text\">Questions? Chat or call to speak with a real golf pro.</div>\n            <div class=\"esg-trust-bar__actions\">\n              <a href=\"/?chat\"\n                 class=\"esg-trust-bar__btn esg-trust-bar__btn--primary esg-trust-bar__chat-btn\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                Live Chat\n              </a>\n              <a href=\"tel:+18652482729\"\n                 class=\"esg-trust-bar__btn esg-trust-bar__btn--secondary\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg>\n                Call or Text 865-248-2729\n              </a>\n            </div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'price_match' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M20.59 13.41 11.17 22a2 2 0 0 1-2.83 0L2 15.66a2 2 0 0 1 0-2.83L11.41 3.41A2 2 0 0 1 12.83 3H20a2 2 0 0 1 2 2v7.17a2 2 0 0 1-.59 1.24z\"></path>\n              <circle cx=\"7.5\" cy=\"7.5\" r=\".9\" fill=\"currentColor\"></circle>\n              <path d=\"m9 14 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Price Match Guarantee</div>\n            <div class=\"esg-trust-bar__text\">Find a lower price and we'll match or beat it — no questions asked.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'authorized' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z\"></path>\n              <path d=\"m9 12 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Authorized {{ vendor_name | escape }} Dealer</div>\n            <div class=\"esg-trust-bar__text\">Premier {{ vendor_name | escape }} partner with full warranty support.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'financing' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"></rect>\n              <line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"></line>\n              <line x1=\"6\" y1=\"15\" x2=\"10\" y2=\"15\"></line>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Financing Available</div>\n            <div class=\"esg-trust-bar__text\">Pay over time with Shop Pay, Affirm, or Klarna.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'shipping' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n              <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n              <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n              <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Fast &amp; Free Shipping</div>\n            <div class=\"esg-trust-bar__text\">Free expedited delivery on most orders (exclusions apply).</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'guarantee' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z\"></path>\n              <path d=\"m9 12 2 2 4-4\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">30-Day Risk-Free Guarantee</div>\n            <div class=\"esg-trust-bar__text\">Not happy? Send it back — no hassle.</div>\n          </div>\n        </div>\n\n      {%- elsif slug == 'family_owned' -%}\n        <div class=\"esg-trust-bar__item\">\n          <div class=\"esg-trust-bar__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M3 11.5 12 4l9 7.5\"></path>\n              <path d=\"M5 10v10h14V10\"></path>\n              <path d=\"M12 20v-6\"></path>\n            </svg>\n          </div>\n          <div class=\"esg-trust-bar__content\">\n            <div class=\"esg-trust-bar__title\">Family-Owned, U.S. Based</div>\n            <div class=\"esg-trust-bar__text\">Real inventory, real people — not a dropshipper.</div>\n          </div>\n        </div>\n\n      {%- endif -%}\n\n    {%- endfor -%}\n\n  </div>\n</div>\n\n<script>\n(function () {\n  'use strict';\n  // Intercept clicks on /?chat links and open Shopify Inbox in-place when present.\n  // If the widget isn't loaded yet, the link falls through to navigation, which\n  // Shopify Inbox handles automatically on the next page load.\n  document.addEventListener('click', function (e) {\n    var a = e.target.closest && e.target.closest('a[href=\"/?chat\"]');\n    if (!a) return;\n    try {\n      var host = document.querySelector('inbox-online-store-chat');\n      var btn = host && host.shadowRoot && host.shadowRoot.querySelector('button.chat-toggle');\n      if (btn) {\n        e.preventDefault();\n        btn.click();\n      }\n    } catch (err) { /* fall back to default link navigation */ }\n  });\n})();\n</script>\n\n<style>\n  .esg-trust-bar {\n    position: relative;\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n    border-top: 1px solid #e5e7eb;\n    border-bottom: 1px solid #e5e7eb;\n    color: #2a3756;\n    font-family: inherit;\n    line-height: 1.4;\n    overflow: hidden;\n  }\n\n  .esg-trust-bar__accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 5px;\n    background: #086ED3;\n    z-index: 1;\n  }\n\n  .esg-trust-bar__inner {\n    max-width: 1500px;\n    margin: 0 auto;\n    padding: 28px 32px;\n    display: grid;\n    gap: 24px 28px;\n    align-items: center;\n  }\n\n  .esg-trust-bar--cols-4 .esg-trust-bar__inner { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-3 .esg-trust-bar__inner { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-2 .esg-trust-bar__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .esg-trust-bar--cols-1 .esg-trust-bar__inner { grid-template-columns: 1fr; }\n\n  .esg-trust-bar__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 10px;\n    min-width: 0;\n    position: relative;\n    padding: 0 8px;\n  }\n\n  .esg-trust-bar__item + .esg-trust-bar__item::before {\n    content: '';\n    position: absolute;\n    left: -14px;\n    top: 10%;\n    bottom: 10%;\n    width: 1px;\n    background: rgba(8, 110, 211, .18);\n  }\n\n  .esg-trust-bar__icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 64px;\n    height: 64px;\n    min-width: 64px;\n    border-radius: 16px;\n    background: #ffffff;\n    color: #086ED3;\n    flex: 0 0 auto;\n    border: 1px solid rgba(8, 110, 211, .18);\n  }\n\n  .esg-trust-bar__icon svg { width: 32px; height: 32px; display: block; }\n\n  .esg-trust-bar__content { min-width: 0; width: 100%; }\n\n  .esg-trust-bar__title {\n    color: #0A1A3A;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 18px;\n    font-weight: 800;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    line-height: 1.1;\n    margin-bottom: 3px;\n  }\n\n  .esg-trust-bar__text {\n    color: #2a3756;\n    font-size: 13.5px;\n    line-height: 1.45;\n  }\n\n  .esg-trust-bar__link {\n    color: #086ED3;\n    font-weight: 700;\n    text-decoration: none;\n    border-bottom: 1px solid rgba(8, 110, 211, .35);\n    white-space: nowrap;\n    cursor: pointer;\n  }\n\n  .esg-trust-bar__link:hover { border-bottom-color: #086ED3; }\n\n  .esg-trust-bar__sep {\n    margin: 0 6px;\n    color: rgba(8, 110, 211, .45);\n  }\n\n  /* ---------- Action buttons ---------- */\n  .esg-trust-bar__actions {\n    display: flex;\n    flex-wrap: nowrap;\n    justify-content: center;\n    gap: 5px;\n    margin-top: 6px;\n  }\n\n  .esg-trust-bar__btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    padding: 6px 9px;\n    border-radius: 999px;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 11.5px;\n    font-weight: 700;\n    letter-spacing: .05em;\n    text-transform: uppercase;\n    line-height: 1;\n    text-decoration: none;\n    border: 1px solid transparent;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: background-color .15s ease, color .15s ease, border-color .15s ease;\n  }\n  .esg-trust-bar__btn svg { width: 11px; height: 11px; display: block; flex: 0 0 auto; }\n\n  .esg-trust-bar__btn--primary {\n    background: #086ED3;\n    color: #ffffff;\n    border-color: #086ED3;\n  }\n  .esg-trust-bar__btn--primary:hover {\n    background: #0A1A3A;\n    border-color: #0A1A3A;\n    color: #ffffff;\n  }\n\n  .esg-trust-bar__btn