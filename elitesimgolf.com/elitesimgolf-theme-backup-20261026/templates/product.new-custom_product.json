        "custom_liquid_NQH4XB": {
          "type": "custom-liquid",
          "name": "SimKit Builder",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  ESG SIMKIT BUILDER PROMO BOX (restyled to match ESG design system)\n  Trigger: Product Type contains \"Launch Monitor\" (ignores tags)\n  Purpose: Upsell the SIMKIT Builder on standalone launch monitor PDPs.\n  Design language:\n    - Barlow Condensed eyebrow + title (uppercase, navy)\n    - #086ED3 blue accent, #0A1A3A navy ink, #2a3756 body\n    - 16px radius, 3px gradient top accent\n    - White-chip icon with blue border + inset (matches VTrack PDP)\n    - Pill CTA, primary blue\n{%- endcomment -%}\n\n{%- assign is_launch_monitor = false -%}\n{%- assign prod_type_dc = product.type | downcase -%}\n{%- if prod_type_dc contains 'launch monitor' -%}\n  {%- assign is_launch_monitor = true -%}\n{%- endif -%}\n\n{%- if is_launch_monitor -%}\n<div class=\"esg-simkit\">\n  <div class=\"esg-simkit__accent\"></div>\n\n  <div class=\"esg-simkit__content\">\n    <div class=\"esg-simkit__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <circle cx=\"12\" cy=\"8.5\" r=\"4\"></circle>\n        <path d=\"M9.5 11.2c.2.4.5.7.9.9\"></path>\n        <path d=\"M14.5 6.8c-.2-.4-.5-.7-.9-.9\"></path>\n        <path d=\"M12 12.5v7.5\"></path>\n        <path d=\"M8 20h8\"></path>\n      </svg>\n    </div>\n\n    <div class=\"esg-simkit__text-group\">\n      <div class=\"esg-simkit__eyebrow\">Save up to 15% on a Full Setup</div>\n      <h3 class=\"esg-simkit__title\">Build Your Dream Home Golf Simulator</h3>\n      <div class=\"esg-simkit__text\">\n        Turn the <strong>{{ product.title }}</strong> into a complete setup. Custom-fit your enclosure, projector, and hitting mat with the <strong>Elite Sim Golf SIMKIT Builder</strong> &mdash; save up to <strong>15% off bundles</strong>.\n        <span class=\"esg-simkit__note\">(Excludes launch monitors)</span>\n      </div>\n    </div>\n  </div>\n\n  <a href=\"/pages/golf-simkit-bundle-builder\" class=\"esg-simkit__button\">\n    Open SIMKIT Builder\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n      <path d=\"M5 12h14\"></path>\n      <path d=\"m12 5 7 7-7 7\"></path>\n    </svg>\n  </a>\n</div>\n\n<style>\n  .esg-simkit {\n    max-width: 1100px;\n    margin: 14px 0;\n    position: relative;\n    overflow: hidden;\n    padding: 14px 16px;\n    border: 1px solid #e5e7eb;\n    border-radius: 16px;\n    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);\n    box-shadow: 0 8px 20px rgba(15, 23, 42, .05);\n    color: #2a3756;\n    font-family: inherit;\n    line-height: 1.4;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    flex-wrap: wrap;\n  }\n\n  .esg-simkit__accent {\n    position: absolute;\n    inset: 0 0 auto;\n    height: 3px;\n    background: linear-gradient(90deg, #086ED3 0%, #0A1A3A 100%);\n  }\n\n  .esg-simkit__content {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    flex: 1 1 320px;\n    min-width: 0;\n  }\n\n  .esg-simkit__icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 38px;\n    height: 38px;\n    min-width: 38px;\n    border-radius: 10px;\n    background: #ffffff;\n    color: #086ED3;\n    border: 1px solid rgba(8, 110, 211, .18);\n    box-shadow: 0 2px 6px rgba(8, 110, 211, .08);\n    flex: 0 0 auto;\n    margin-top: 2px;\n  }\n  .esg-simkit__icon svg { width: 20px; height: 20px; display: block; }\n\n  .esg-simkit__text-group {\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n    min-width: 0;\n  }\n\n  .esg-simkit__eyebrow {\n    color: #086ED3;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .esg-simkit__title {\n    margin: 0;\n    color: #0A1A3A;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 18px;\n    font-weight: 800;\n    letter-spacing: .02em;\n    text-transform: uppercase;\n    line-height: 1.1;\n  }\n\n  .esg-simkit__text {\n    font-size: 13px;\n    color: #2a3756;\n    line-height: 1.45;\n  }\n  .esg-simkit__text strong {\n    color: #0A1A3A;\n    font-weight: 700;\n  }\n  .esg-simkit__note {\n    color: #6B7390;\n    font-size: 12px;\n  }\n\n  .esg-simkit__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    padding: 10px 18px;\n    border-radius: 999px;\n    background: #086ED3;\n    color: #ffffff;\n    border: 1px solid #086ED3;\n    font-family: 'Barlow Condensed', 'Barlow', sans-serif;\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    line-height: 1;\n    text-decoration: none;\n    white-space: nowrap;\n    flex-shrink: 0;\n    transition: background-color .15s ease, border-color .15s ease, transform .15s ease;\n  }\n  .esg-simkit__button:hover {\n    background: #0A1A3A;\n    border-color: #0A1A3A;\n    color: #ffffff;\n    transform: translateY(-1px);\n  }\n  .esg-simkit__button svg {\n    width: 14px;\n    height: 14px;\n    transition: transform .15s ease;\n  }\n  .esg-simkit__button:hover svg { transform: translateX(2px); }\n\n  @media (max-width: 749px) {\n    .esg-simkit {\n      padding: 13px 14px;\n      border-radius: 14px;\n      flex-direction: column;\n      align-items: stretch;\n      gap: 12px;\n    }\n    .esg-simkit__title { font-size: 16px; }\n    .esg-simkit__text { font-size: 12.5px; }\n    .esg-simkit__button {\n      width: 100%;\n      padding: 11px 16px;\n      font-size: 12.5px;\n    }\n  }\n</style>\n{%- endif -%}"
          }
