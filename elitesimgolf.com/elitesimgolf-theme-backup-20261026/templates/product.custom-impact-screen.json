{\n    max-width: 1100px;\n    margin: 14px 0;\n    padding: 14px 16px;\n    border: 1px solid #e2e8f0; /* Soft, clean border */\n    border-radius: 12px;\n    background: #ffffff; /* Premium white background */\n    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.02);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    flex-wrap: wrap;\n    color: #334155;\n    line-height: 1.4;\n  }\n  .esg-simkit-promo-box__content {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    flex: 1 1 300px;\n  }\n  .esg-simkit-promo-box__icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 32px;\n    height: 32px;\n    min-width: 32px;\n    border-radius: 8px;\n    background: #eff6ff; /* Soft blue icon background */\n    color: #2563eb; /* Vibrant royal blue icon */\n    flex: 0 0 auto;\n    margin-top: 2px;\n  }\n  .esg-simkit-promo-box__icon svg {\n    width: 18px;\n    height: 18px;\n    display: block;\n  }\n  .esg-simkit-promo-box__text-group {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    min-width: 0;\n  }\n  .esg-simkit-promo-box__title {\n    font-size: 14px;\n    font-weight: 800;\n    color: #0f172a;\n    letter-spacing: .2px;\n  }\n  .esg-simkit-promo-box__text {\n    font-size: 12.5px;\n    color: #475569;\n  }\n  .esg-simkit-promo-box__text strong {\n    font-weight: 700;\n    color: #0f172a;\n  }\n  .esg-simkit-promo-box__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    text-decoration: none;\n    border: none;\n    border-radius: 999px;\n    padding: 10px 18px;\n    background: #2563eb; /* Energetic royal blue button */\n    color: #ffffff;\n    font-weight: 700;\n    font-size: 13.5px;\n    line-height: 1;\n    box-shadow: 0 3px 6px rgba(37, 99, 235, 0.25);\n    transition: all 0.2s ease;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n  .esg-simkit-promo-box__button:hover {\n    background: #1d4ed8;\n    transform: translateY(-1px);\n    box-shadow: 0 5px 8px rgba(37, 99, 235, 0.35);\n    color: #ffffff;\n  }\n  .esg-simkit-promo-box__button svg {\n    width: 14px;\n    height: 14px;\n    transition: transform 0.2s ease;\n  }\n  .esg-simkit-promo-box__button:hover svg {\n    transform: translateX(3px);\n  }\n\n  @media (max-width: 749px) {\n    .esg-simkit-promo-box {\n      padding: 14px;\n      flex-direction: column;\n      align-items: stretch;\n      gap: 14px;\n    }\n    .esg-simkit-promo-box__title {\n      font-size: 13.5px;\n    }\n    .esg-simkit-promo-box__text {\n      font-size: 12.5px;\n    }\n    .esg-simkit-promo-box__button {\n      width: 100%;\n      padding: 12px 16px;\n    }\n  }\n</style>\n{%- endif -%}"
