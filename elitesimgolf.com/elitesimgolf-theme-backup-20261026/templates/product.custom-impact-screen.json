            "custom_liquid": "{%- assign has_garmin_r50_tag = false -%}\n{%- for tag in product.tags -%}\n  {%- assign normalized_tag = tag | strip | downcase -%}\n  {%- if normalized_tag == 'garmin r50' -%}\n    {%- assign has_garmin_r50_tag = true -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- if has_garmin_r50_tag -%}\n<div class=\"esg-r50-shipbox\">\n  <div class=\"esg-r50-shipbox__top\">\n    <div class=\"esg-r50-shipbox__title\">\n      <span class=\"esg-r50-shipbox__title-icon\" aria-hidden=\"true\">\n        <!-- Shipping Truck Icon -->\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n          <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n          <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        </svg>\n      </span>\n      <span>Free 2-Day Shipping + 30-Day Returns</span>\n    </div>\n  </div>\n  \n  <div class=\"esg-r50-shipbox__text\">\n    Order your <strong>Garmin Approach R50</strong> by 2PM ET for same-day shipping.\n  </div>\n  \n  <div class=\"esg-r50-shipbox__timer\">\n    Order within <span id=\"esg-r50-countdown\" class=\"esg-r50-shipbox__badge\">22 Hrs 0 Mins</span>\n  </div>\n</div>\n\n<style>\n  .esg-r50-shipbox {\n    max-width: 1100px;\n    margin: 14px 0;\n    padding: 16px 18px;\n    border: 1px solid #bbf7d0; /* Soft mint green border */\n    border-radius: 10px;\n    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); /* Fresh green gradient */\n    box-shadow: 0 3px 6px rgba(34, 197, 94, 0.05); /* Gentle green shadow */\n    color: #334155;\n    line-height: 1.4;\n  }\n  .esg-r50-shipbox__top {\n    margin-bottom: 6px;\n  }\n  .esg-r50-shipbox__title {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 15px;\n    font-weight: 800;\n    color: #064e3b; /* Deep forest green text */\n    letter-spacing: .2px;\n  }\n  .esg-r50-shipbox__title-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 18px;\n    height: 18px;\n    color: #16a34a; /* Vibrant emerald green icon */\n  }\n  .esg-r50-shipbox__title-icon svg {\n    width: 18px;\n    height: 18px;\n    display: block;\n  }\n  .esg-r50-shipbox__text {\n    font-size: 13.5px;\n    color: #3f6212;\n    margin-bottom: 12px;\n  }\n  .esg-r50-shipbox__text strong {\n    font-weight: 800;\n    color: #064e3b;\n  }\n  .esg-r50-shipbox__timer {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 13.5px;\n    font-weight: 600;\n    color: #3f6212;\n  }\n  .esg-r50-shipbox__badge {\n    display: inline-block;\n    padding: 5px 10px;\n    background: #ffffff; /* White pill background to make timer pop */\n    border: 1px solid #86efac;\n    border-radius: 6px;\n    color: #15803d; /* Darker green for readability */\n    font-weight: 800;\n    font-variant-numeric: tabular-nums; /* Keeps numbers from shifting widths */\n    box-shadow: 0 2px 4px rgba(22, 163, 74, 0.1);\n  }\n\n  @media (max-width: 749px) {\n    .esg-r50-shipbox {\n      padding: 14px;\n    }\n    .esg-r50-shipbox__title {\n      font-size: 14.5px;\n    }\n    .esg-r50-shipbox__text,\n    .esg-r50-shipbox__timer {\n      font-size: 13px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var countdownEl = document.getElementById(\"esg-r50-countdown\");\n    if (!countdownEl) return;\n\n    function updateCountdown() {\n      var now = new Date();\n      var estString = now.toLocaleString(\"en-US\", { timeZone: \"America/New_York\" });\n      var estNow = new Date(estString);\n      \n      var cutoff = new Date(estNow);\n      cutoff.setHours(14, 0, 0, 0);\n      \n      if (estNow >= cutoff) {\n        cutoff.setDate(cutoff.getDate() + 1);\n      }\n      \n      var diff = cutoff - estNow;\n      \n      var hrs = Math.floor(diff / (1000 * 60 * 60));\n      var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));\n      \n      countdownEl.textContent = hrs + \" Hrs \" + mins + \" Mins\";\n    }\n    \n    updateCountdown();\n    setInterval(updateCountdown, 60000);\n  })();\n</script>\n{%- endif -%}"
