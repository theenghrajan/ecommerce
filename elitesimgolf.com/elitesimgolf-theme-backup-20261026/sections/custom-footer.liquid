{% comment %}
  Elite Sim Golf — Custom Footer
  Section: custom-footer.liquid
  Drop into: sections/custom-footer.liquid
  Add to layout/theme.liquid above </body>:
    {% section 'custom-footer' %}
  Remove the default footer include if present.
{% endcomment %}

{%- liquid
  assign col_count = 0
  if section.settings.show_policies_col
    assign col_count = col_count | plus: 1
  endif
  if section.settings.show_support_col
    assign col_count = col_count | plus: 1
  endif
  if section.settings.show_extra_col
    assign col_count = col_count | plus: 1
  endif
  if section.settings.show_newsletter
    assign col_count = col_count | plus: 1
  endif
-%}

<style>
  /* ── Kill theme default footer gap ── */
  footer:not(#esg-footer-{{ section.id }}),
  .site-footer:not(#esg-footer-{{ section.id }}),
  .footer:not(#esg-footer-{{ section.id }}),
  [data-section-type="footer"]:not(#esg-footer-{{ section.id }}) {
    display: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    height: 0 !important;
    min-height: 0 !important;
    overflow: hidden !important;
  }

  /* Kill any gap above/below our footer — Shopify section wrapper */
  #esg-footer-{{ section.id }},
  .shopify-section:has(#esg-footer-{{ section.id }}),
  .shopify-section + .shopify-section:last-child {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  /* ── Reset & Base ── */
  .esg-footer *,
  .esg-footer *::before,
  .esg-footer *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── Footer Shell ── */
  .esg-footer {
    background: {{ section.settings.footer_bg }};
    color: {{ section.settings.footer_text }};
    font-family: {{ section.settings.body_font }}, system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    border-top: 3px solid {{ section.settings.accent_color }};
    position: relative;
  }

  /* bg image div — injected via inline style in HTML */
  .esg-footer__bg-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: 0;
  }

  /* dark overlay so text stays readable */
  .esg-footer__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(10,22,40,0.95) 0%, rgba(10,22,40,0.80) 50%, rgba(10,22,40,0.55) 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Mobile: image shows, overlay goes top→bottom */
  @media (max-width: 768px) {
    .esg-footer__bg-img {
      display: block !important;
      background-position: center center !important;
    }
    .esg-footer__bg-overlay {
      background: linear-gradient(
        to bottom,
        rgba(10,22,40,0.88) 0%,
        rgba(10,22,40,0.78) 40%,
        rgba(10,22,40,0.70) 100%
      );
    }
  }

  .esg-footer__top-strip,
  .esg-footer__body,
  .esg-footer__divider,
  .esg-footer__bottom {
    position: relative;
    z-index: 2;
  }

  /* ── Top Strip ── */
  .esg-footer__top-strip {
    background: {{ section.settings.accent_color }};
    padding: 10px 0;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: {{ section.settings.footer_bg }};
  }

  /* ── Main Body ── */
  .esg-footer__body {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 0;
    max-width: 1300px;
    margin: 0 auto;
    padding: 52px 32px 36px;
  }

  /* ── Brand Column ── */
  .esg-footer__brand {
    padding-right: 40px;
    border-right: 1px solid rgba(255,255,255,0.08);
    text-align: left !important;
  }

  .esg-footer__logo img {
    max-width: 160px;
    height: auto;
    display: block;
    margin-bottom: 6px;
    margin-left: 0 !important;
  }

  .esg-footer__logo-text {
    font-size: 12px;
    color: #ffffff;
    letter-spacing: 0.04em;
    margin-bottom: 24px;
    text-align: left !important;
  }

  .esg-footer__contact-heading {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
    text-align: left !important;
  }

  .esg-footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 13px;
    font-size: 15px;
    color: #ffffff;
    text-decoration: none;
    text-align: left !important;
  }

  .esg-footer__contact-item:hover { color: #fff; }

  .esg-footer__contact-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: {{ section.settings.accent_color }};
  }

  .esg-footer__contact-item strong {
    color: rgba(255,255,255,0.85);
    font-weight: 600;
    font-size: 12px;
    display: block;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 1px;
  }

  .esg-footer__hours {
    margin-top: 18px;
    padding: 12px 14px;
    background: rgba(255,255,255,0.05);
    border-radius: 6px;
    border-left: 2px solid {{ section.settings.accent_color }};
    font-size: 14px;
    color: #ffffff;
    text-align: left !important;
  }

  .esg-footer__hours strong {
    display: block;
    color: #ffffff;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 4px;
  }

  /* ── Link Columns ── */
  .esg-footer__cols {
    padding-left: 48px;
    display: grid;
    grid-template-columns: repeat({{ col_count }}, 1fr);
    gap: 32px;
  }

  .esg-footer__col-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .esg-footer__col-title svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .esg-footer__col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .esg-footer__col-links a {
    color: #ffffff;
    text-decoration: none;
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 7px;
    transition: color 0.2s, gap 0.2s;
  }

  .esg-footer__col-links a:hover {
    color: #fff;
    gap: 10px;
  }

  .esg-footer__col-links a::before {
    content: '';
    width: 5px;
    height: 5px;
    border-top: 1.5px solid {{ section.settings.accent_color }};
    border-right: 1.5px solid {{ section.settings.accent_color }};
    transform: rotate(45deg);
    flex-shrink: 0;
    transition: margin-left 0.2s;
  }

  /* ── Newsletter ── */
  .esg-footer__newsletter p {
    font-size: 14px;
    color: #ffffff;
    margin-bottom: 16px;
    line-height: 1.55;
  }

  .esg-footer__newsletter-form {
    display: flex;
    gap: 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.15);
    transition: border-color 0.2s;
  }

  .esg-footer__newsletter-form:focus-within {
    border-color: {{ section.settings.accent_color }};
  }

  .esg-footer__newsletter-input {
    flex: 1;
    background: rgba(255,255,255,0.06);
    border: none;
    outline: none;
    padding: 11px 14px;
    font-size: 15px;
    color: #fff;
    font-family: inherit;
  }

  .esg-footer__newsletter-input::placeholder { color: rgba(255,255,255,0.35); }

  .esg-footer__newsletter-btn {
    background: {{ section.settings.accent_color }};
    border: none;
    padding: 11px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }

  .esg-footer__newsletter-btn:hover { opacity: 0.85; }
  .esg-footer__newsletter-btn svg { width: 18px; height: 18px; }

  .esg-footer__newsletter-success {
    display: none;
    font-size: 13px;
    color: #6ee7a0;
    margin-top: 10px;
  }

  /* ── Social ── */
  .esg-footer__social-heading {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    margin-top: 26px;
    margin-bottom: 12px;
  }

  .esg-footer__social-icons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .esg-footer__social-icons a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .esg-footer__social-icons a:hover {
    border-color: {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
    background: rgba(255,255,255,0.04);
  }

  .esg-footer__social-icons svg { width: 16px; height: 16px; }

  /* ── Divider ── */
  .esg-footer__divider {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0;
    border: none;
    border-top: 1px solid rgba(255,255,255,0.07);
    display: block;
    height: 1px;
    box-sizing: content-box;
  }

  /* ── Bottom Bar ── */
  .esg-footer__bottom {
    max-width: 1300px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .esg-footer__copyright {
    font-size: 14px;
    color: #ffffff;
  }

  .esg-footer__copyright a {
    color: #ffffff;
    text-decoration: none;
  }

  .esg-footer__copyright a:hover { color: #fff; }

  .esg-footer__payment-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .esg-footer__payment-icons img,
  .esg-footer__payment-icons svg,
  .esg-footer__payment-icons .esg-payment-icon {
    height: 26px;
    width: auto;
    border-radius: 4px;
    display: inline-block;
    vertical-align: middle;
  }

  /* ══════════════════════════════
     MOBILE  (≤ 768px)
  ══════════════════════════════ */
  @media (max-width: 768px) {

    .esg-footer__top-strip {
      font-size: 12px;
      padding: 9px 16px;
      line-height: 1.5;
    }

    .esg-footer__body {
      grid-template-columns: 1fr;
      padding: 28px 16px 20px;
      gap: 0;
    }

    .esg-footer__brand {
      border-right: none;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      padding-right: 0;
      padding-bottom: 24px;
      margin-bottom: 0;
      text-align: left !important;
    }

    .esg-footer__logo { text-align: left !important; }
    .esg-footer__logo img { max-width: 130px; margin-left: 0 !important; }
    .esg-footer__logo-text { text-align: left !important; }
    .esg-footer__contact-heading { text-align: left !important; }
    .esg-footer__contact-item { text-align: left !important; }
    .esg-footer__hours { text-align: left !important; margin-top: 12px; }

    .esg-footer__cols {
      padding-left: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      margin-top: 0;
    }

    .esg-footer__col {
      padding: 18px 12px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .esg-footer__col:nth-child(even) {
      border-left: 1px solid rgba(255,255,255,0.07);
    }

    .esg-footer__col-title {
      cursor: pointer;
      justify-content: space-between;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      font-size: 11px;
      margin-bottom: 12px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .esg-footer__col-title > svg:first-child { display: none; }

    .esg-footer__col-title::after {
      content: '';
      width: 7px;
      height: 7px;
      border-right: 2px solid {{ section.settings.accent_color }};
      border-bottom: 2px solid {{ section.settings.accent_color }};
      transform: rotate(-135deg);
      transition: transform 0.25s ease;
      flex-shrink: 0;
    }

    .esg-footer__col-title.is-closed::after {
      transform: rotate(45deg);
    }

    .esg-footer__col-links {
      max-height: 600px;
      overflow: hidden;
      transition: max-height 0.35s ease, opacity 0.25s ease;
      opacity: 1;
    }

    .esg-footer__col-links.is-closed {
      max-height: 0;
      opacity: 0;
    }

    .esg-footer__col-links li { margin-bottom: 9px; }
    .esg-footer__col-links a { font-size: 13px; }

    .esg-footer__newsletter {
      grid-column: 1 / -1 !important;
      border-left: none !important;
      padding: 20px 12px 16px !important;
      border-bottom: none !important;
    }

    .esg-footer__newsletter p { font-size: 13px; }

    .esg-footer__newsletter-input {
      font-size: 14px;
      padding: 12px 14px;
    }

    .esg-footer__newsletter-btn { padding: 12px 18px; }

    .esg-footer__social-heading { margin-top: 20px; }

    .esg-footer__social-icons a { width: 38px; height: 38px; }

    .esg-footer__divider { margin: 0; }

    .esg-footer__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 16px;
      gap: 12px;
    }

    .esg-footer__copyright { font-size: 12px; }

    .esg-footer__payment-icons {
      justify-content: center;
      gap: 6px;
    }

    .esg-footer__payment-icons img,
    .esg-footer__payment-icons svg,
    .esg-footer__payment-icons .esg-payment-icon { height: 22px; }
  }

  @media (max-width: 380px) {
    .esg-footer__col-links a { font-size: 12px; }
    .esg-footer__col { padding: 14px 10px; }
  }
</style>

<footer class="esg-footer" id="esg-footer-{{ section.id }}">

  {%- if section.settings.footer_bg_image != blank -%}
    <div class="esg-footer__bg-img" style="background-image:url('{{ section.settings.footer_bg_image | image_url: width: 1800 }}'); background-position:{{ section.settings.footer_bg_position }}; opacity:{{ section.settings.footer_bg_opacity | divided_by: 100.0 }};"></div>
    <div class="esg-footer__bg-overlay"></div>
  {%- endif -%}

  {%- if section.settings.top_strip_text != blank -%}
    <div class="esg-footer__top-strip">{{ section.settings.top_strip_text }}</div>
  {%- endif -%}

  <div class="esg-footer__body">

    <!-- Brand / Contact -->
    <div class="esg-footer__brand">
      <div class="esg-footer__logo">
        {%- if section.settings.footer_logo != blank -%}
          <img src="{{ section.settings.footer_logo | image_url: width: 320 }}"
               alt="{{ shop.name }}" width="160" loading="lazy">
        {%- else -%}
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="160" loading="lazy">
        {%- endif -%}
        <div class="esg-footer__logo-text">{{ section.settings.logo_subtext | default: shop.domain }}</div>
      </div>

      <div class="esg-footer__contact-heading">Contact Us</div>

      {%- if section.settings.address != blank -%}
        <div class="esg-footer__contact-item">
          <svg class="esg-footer__contact-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>{{ section.settings.address }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="esg-footer__contact-item">
          <svg class="esg-footer__contact-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <div><strong>Phone</strong>{{ section.settings.phone }}</div>
        </a>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <a href="mailto:{{ section.settings.email }}" class="esg-footer__contact-item">
          <svg class="esg-footer__contact-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <div><strong>Email</strong>{{ section.settings.email }}</div>
        </a>
      {%- endif -%}

      {%- if section.settings.support_hours != blank -%}
        <div class="esg-footer__hours">
          <strong>Support Hours</strong>
          {{ section.settings.support_hours }}
        </div>
      {%- endif -%}
    </div>

    <!-- Link Columns + Newsletter -->
    <div class="esg-footer__cols">

      {%- if section.settings.show_policies_col -%}
        <div class="esg-footer__col">
          <div class="esg-footer__col-title" data-esg-accordion>
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Policies
          </div>
          <ul class="esg-footer__col-links" data-esg-links>
            {%- assign policies_menu = linklists[section.settings.policies_menu] -%}
            {%- if policies_menu != blank -%}
              {%- for link in policies_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/policies/terms-of-service">Terms of Service</a></li>
              <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
              <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
              <li><a href="/policies/refund-policy">Return &amp; Refund Policy</a></li>
              <li><a href="/policies/payment">Payment Policy</a></li>
              <li><a href="/pages/wholesale">Wholesale Inquiry</a></li>
              <li><a href="/blogs/news">Elite Sim Golf Blog</a></li>
              <li><a href="/pages/installation">Installation Services</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.show_support_col -%}
        <div class="esg-footer__col">
          <div class="esg-footer__col-title" data-esg-accordion>
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            Support
          </div>
          <ul class="esg-footer__col-links" data-esg-links>
            {%- assign support_menu = linklists[section.settings.support_menu] -%}
            {%- if support_menu != blank -%}
              {%- for link in support_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/pages/contact">Contact Us</a></li>
              <li><a href="/pages/remote-support">Remote Support Session</a></li>
              <li><a href="/pages/military-discount">Military/First Responder Discount</a></li>
              <li><a href="/pages/faq">Frequently Asked Questions</a></li>
              <li><a href="/pages/assembly-manuals">Simulator Assembly Manuals</a></li>
              <li><a href="/pages/track-your-order">Track Your Order</a></li>
              <li><a href="/pages/warranty">Warranty Request</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.show_extra_col -%}
        <div class="esg-footer__col">
          <div class="esg-footer__col-title" data-esg-accordion>
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
            {{ section.settings.extra_col_title | default: 'Quick Links' }}
          </div>
          <ul class="esg-footer__col-links" data-esg-links>
            {%- assign extra_menu = linklists[section.settings.extra_menu] -%}
            {%- if extra_menu != blank -%}
              {%- for link in extra_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="esg-footer__col esg-footer__newsletter">
          <div class="esg-footer__col-title">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Newsletter
          </div>
          <p>{{ section.settings.newsletter_text | default: 'Sign up for exclusive offers and discounts, original stories, VIP access to special events and much more.' }}</p>
          {%- form 'customer', id: 'esg-footer-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="esg-footer__newsletter-form">
              <input
                class="esg-footer__newsletter-input"
                type="email"
                name="contact[email]"
                id="esg-newsletter-email"
                placeholder="Your email"
                autocomplete="email"
                required>
              <button type="submit" class="esg-footer__newsletter-btn" aria-label="Subscribe">
                <svg viewBox="0 0 24 24" fill="none" stroke="#0d1b2a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
            <div class="esg-footer__newsletter-success" id="esg-nl-success">
              ✓ Thanks for subscribing!
            </div>
          {%- endform -%}

          <div class="esg-footer__social-heading">Follow Us</div>
          <div class="esg-footer__social-icons">
            {%- if section.settings.facebook_url != blank -%}
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.youtube_url != blank -%}
              <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="{{ section.settings.footer_bg }}"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.tiktok_url != blank -%}
              <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.94a8.19 8.19 0 004.79 1.53V7a4.85 4.85 0 01-1.02-.31z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.twitter_url != blank -%}
              <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener" aria-label="X / Twitter">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>

  <hr class="esg-footer__divider">

  <div class="esg-footer__bottom">
    <p class="esg-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}
      <a href="/">{{ shop.name }}</a>.
      All Rights Reserved.
      {%- if section.settings.powered_by -%}
        &nbsp;·&nbsp; Powered by <a href="https://www.shopify.com" target="_blank" rel="noopener">Shopify</a>.
      {%- endif -%}
    </p>
    <div class="esg-footer__payment-icons">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'esg-payment-icon' }}
      {%- endfor -%}
    </div>
  </div>

</footer>

<script>
(function() {
  var nlForm = document.getElementById('esg-footer-newsletter-form');
  if (nlForm) {
    nlForm.addEventListener('submit', function() {
      setTimeout(function() {
        var s = document.getElementById('esg-nl-success');
        if (s) s.style.display = 'block';
      }, 800);
    });
  }

  function esgInitAccordion() {
    if (window.innerWidth > 768) return;
    var titles = document.querySelectorAll('#esg-footer-{{ section.id }} [data-esg-accordion]');
    titles.forEach(function(title) {
      var links = title.nextElementSibling;
      if (!links) return;
      links.classList.remove('is-closed');
      title.classList.remove('is-closed');
      title.addEventListener('click', function() {
        var closed = links.classList.contains('is-closed');
        if (closed) {
          links.classList.remove('is-closed');
          title.classList.remove('is-closed');
        } else {
          links.classList.add('is-closed');
          title.classList.add('is-closed');
        }
      });
    });
  }
  esgInitAccordion();
})();
</script>

