{% comment %}
  Elite Sim Golf — Benefits + Trust Bar
  sections/custom-benefits.liquid
{% endcomment %}

{%- assign benefit_blocks = section.blocks | where: "type", "benefit" -%}
{%- assign trust_blocks   = section.blocks | where: "type", "trust_item" -%}

<style>
  .esb * { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── Shell ── */
  .esb {
    position: relative;
    overflow: hidden;
    font-family: {{ section.settings.body_font }}, system-ui, sans-serif;
    background: {{ section.settings.bg_color }};
  }

  /* ── Parallax BG ── */
  .esb__bg {
    position: absolute;
    inset: 0;
    background-attachment: fixed;
    background-size: cover;
    background-repeat: no-repeat;
    z-index: 0;
    pointer-events: none;
  }
  .esb__overlay {
    position: absolute;
    inset: 0;
    background: rgba(4,10,22,{{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
    pointer-events: none;
  }
  @media (max-width: 768px) {
    .esb__bg { background-attachment: scroll; }
  }

  /* ── Cards area ── */
  .esb__cards-wrap {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
  }

  /* ── Header ── */
  .esb__header {
    text-align: center;
    margin-bottom: 64px;
  }
  .esb__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 14px;
  }
  .esb__eyebrow-line {
    width: 52px; height: 1px;
    background: {{ section.settings.accent_color }};
    opacity: 0.6;
  }
  .esb__eyebrow-text {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    font-family: {{ section.settings.body_font }}, system-ui, sans-serif;
  }
  .esb__title {
    font-size: clamp(28px, 4.5vw, 52px);
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #fff;
    line-height: 1.1;
    text-shadow: 0 2px 20px rgba(0,0,0,0.7);
    font-family: {{ section.settings.body_font }}, system-ui, sans-serif;
  }
  .esb__title em { font-style: normal; font-weight: 900; color: {{ section.settings.accent_color }}; }

  /* ── Grid ── */
  .esb__grid {
    display: grid;
    grid-template-columns: repeat({{ benefit_blocks.size }}, 1fr);
    gap: 0;
  }

  /* ── Card ── */
  .esb__card {
    position: relative;
    padding: 20px 40px 44px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* vertical separator */
  .esb__card + .esb__card {
    border-left: 1px solid rgba(255,255,255,0.12);
  }

  /* ── Icon circle ── */
  .esb__icon {
    width: 110px; height: 110px;
    border-radius: 50%;
    border: 1px solid {{ section.settings.accent_color }};
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 36px;
    position: relative;
    background: rgba(4,10,22,0.6);
    transition: transform 0.35s ease, box-shadow 0.35s;
    flex-shrink: 0;
  }
  /* outer halo ring */
  .esb__icon::before {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid {{ section.settings.accent_color }};
    opacity: 0.22;
  }
  .esb__card:hover .esb__icon {
    transform: translateY(-6px);
    box-shadow: 0 0 28px rgba(45,125,210,0.25);
  }
  .esb__icon svg {
    width: 48px; height: 48px;
    color: {{ section.settings.accent_color }};
    stroke-width: 1.3;
    fill: none;
  }
  .esb__icon img {
    width: 48px; height: 48px; object-fit: contain;
  }
  .esb__icon-emoji { font-size: 42px; line-height: 1; }

  /* ── Card title ── */
  .esb__card-title {
    font-size: 16px; font-weight: 800;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #fff; line-height: 1.35;
    margin-bottom: 24px;
    text-shadow: 0 1px 10px rgba(0,0,0,0.6);
    font-family: {{ section.settings.body_font }}, system-ui, sans-serif;
  }

  /* ── Card text ── */
  .esb__card-text {
    font-size: 15px;
    color: rgba(255,255,255,0.78);
    line-height: 1.75;
    text-align: center;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
    max-width: 300px;
    margin-bottom: 32px;
    flex: 1;
    font-family: {{ section.settings.body_font }}, system-ui, sans-serif;
  }

  /* ── Diamond at BOTTOM (like screenshot) ── */
  .esb__diamond-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 100%;
    margin-top: auto;
  }
  .esb__diamond-row::before,
  .esb__diamond-row::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.15);
  }
  .esb__diamond-gem {
    width: 10px; height: 10px;
    border: 1.5px solid {{ section.settings.accent_color }};
    transform: rotate(45deg);
    flex-shrink: 0;
    margin: 0 10px;
    background: transparent;
  }

  /* ── Trust Bar ── */
  .esb__trust-outer {
    position: relative;
    z-index: 2;
    padding: 0 40px {{ section.settings.trust_padding_bottom }}px;
  }
  .esb__trust {
    max-width: 1100px;
    margin: 0 auto;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    display: grid;
    grid-template-columns: repeat({{ trust_blocks.size }}, 1fr);
    overflow: hidden;
  }

  .esb__trust-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 28px 28px;
    border-right: 1px solid rgba(255,255,255,0.09);
    transition: background 0.25s;
  }
  .esb__trust-item:last-child { border-right: none; }
  .esb__trust-item:hover { background: rgba(255,255,255,0.06); }

  .esb__trust-icon {
    color: {{ section.settings.accent_color }};
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    width: 46px; height: 46px;
  }
  .esb__trust-icon svg { width: 40px; height: 40px; stroke-width: 1.3; fill: none; }
  .esb__trust-icon img { width: 40px; height: 40px; object-fit: contain; }
  .esb__trust-icon-emoji { font-size: 32px; line-height: 1; }

  .esb__trust-label {
    font-size: 12px; font-weight: 800;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #fff; line-height: 1.45;
    font-family: {{ section.settings.body_font }}, system-ui, sans-serif;
  }

  /* ══ TABLET ══ */
  @media (max-width: 900px) {
    .esb__cards-wrap { padding-left: 20px; padding-right: 20px; }
    .esb__grid { grid-template-columns: repeat(2, 1fr); }
    .esb__card { padding: 20px 24px 36px; }
    .esb__card:nth-child(odd):last-child { grid-column: 1 / -1; }
    .esb__trust-outer { padding: 0 20px {{ section.settings.trust_padding_bottom }}px; }
    .esb__trust { grid-template-columns: repeat(2, 1fr); }
    .esb__trust-item:nth-child(2) { border-right: none; }
    .esb__trust-item:nth-child(1),
    .esb__trust-item:nth-child(2) { border-bottom: 1px solid rgba(255,255,255,0.09); }
  }

  /* ══ MOBILE ══ */
  @media (max-width: 560px) {
    .esb__header { margin-bottom: 36px; }
    .esb__grid { grid-template-columns: 1fr; }
    .esb__card {
      flex-direction: row; text-align: left;
      align-items: flex-start; gap: 20px;
      padding: 28px 20px 28px;
      border-left: none !important;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .esb__icon { width: 74px; height: 74px; flex-shrink: 0; margin-bottom: 0; }
    .esb__icon::before { display: none; }
    .esb__icon svg { width: 32px; height: 32px; }
    .esb__icon-emoji { font-size: 30px; }
    .esb__card-body { flex: 1; display: flex; flex-direction: column; }
    .esb__card-title { font-size: 13px; margin-bottom: 10px; text-align: left; }
    .esb__card-text { font-size: 13px; text-align: left; max-width: none; margin-bottom: 16px; }
    .esb__diamond-row { justify-content: flex-start; }
    .esb__diamond-row::after { display: none; }
    .esb__card:hover .esb__icon { transform: none; }
    .esb__trust { grid-template-columns: 1fr; border-radius: 8px; }
    .esb__trust-item { border-right: none !important; border-bottom: 1px solid rgba(255,255,255,0.09); padding: 18px 20px; }
    .esb__trust-item:last-child { border-bottom: none; }
  }
</style>

<section class="esb" id="esb-{{ section.id }}">

  {%- if section.settings.bg_image != blank -%}
    <div class="esb__bg" style="background-image:url('{{ section.settings.bg_image | image_url: width: 1800 }}'); background-position:{{ section.settings.bg_position }};"></div>
    <div class="esb__overlay"></div>
  {%- endif -%}

  <!-- Cards -->
  <div class="esb__cards-wrap">

    {%- if section.settings.show_header -%}
      <div class="esb__header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="esb__eyebrow">
            <span class="esb__eyebrow-line"></span>
            <span class="esb__eyebrow-text">{{ section.settings.eyebrow }}</span>
            <span class="esb__eyebrow-line"></span>
          </div>
        {%- endif -%}
        <h2 class="esb__title">
          {{ section.settings.title_plain -}}
          {%- if section.settings.title_accent != blank %} <em>{{ section.settings.title_accent }}</em>{%- endif %}
        </h2>
      </div>
    {%- endif -%}

    <div class="esb__grid">
      {%- for block in benefit_blocks -%}
        <div class="esb__card" {{ block.shopify_attributes }}>
          <!-- Icon -->
          <div class="esb__icon">
            {%- if block.settings.icon_image != blank -%}
              <img src="{{ block.settings.icon_image | image_url: width: 120 }}" alt="{{ block.settings.title }}" width="48" height="48" loading="lazy">
            {%- elsif block.settings.icon_type == 'expert' -%}
              <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            {%- elsif block.settings.icon_type == 'expert_star' -%}
              <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l1.5 3 2.5.5-1.8 1.8.4 2.7L12 20.5l-2.6 1.5.4-2.7L8 17.5l2.5-.5z" stroke-width="0.8"/></svg>
            {%- elsif block.settings.icon_type == 'tag' -%}
              <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
            {%- elsif block.settings.icon_type == 'truck' -%}
              <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
            {%- elsif block.settings.icon_type == 'shield' -%}
              <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            {%- elsif block.settings.icon_type == 'star' -%}
              <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
            {%- elsif block.settings.icon_type == 'headset' -%}
              <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 18v-6a9 9 0 0118 0v6"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg>
            {%- elsif block.settings.icon_type == 'emoji' -%}
              <span class="esb__icon-emoji">{{ block.settings.icon_emoji | default: '⭐' }}</span>
            {%- endif -%}
          </div>
          <!-- Content -->
          <div class="esb__card-body">
            <div class="esb__card-title">{{ block.settings.title }}</div>
            <p class="esb__card-text">{{ block.settings.text }}</p>
            <div class="esb__diamond-row"><div class="esb__diamond-gem"></div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- Trust Bar -->
  {%- if section.settings.show_trust_bar and trust_blocks.size > 0 -%}
    <div class="esb__trust-outer">
      <div class="esb__trust">
        {%- for block in trust_blocks -%}
          <div class="esb__trust-item" {{ block.shopify_attributes }}>
            <div class="esb__trust-icon">
              {%- if block.settings.icon_image != blank -%}
                <img src="{{ block.settings.icon_image | image_url: width: 80 }}" alt="{{ block.settings.label }}" width="40" height="40" loading="lazy">
              {%- elsif block.settings.icon_type == 'shield_check' -%}
                <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              {%- elsif block.settings.icon_type == 'award' -%}
                <svg viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="8" r="6"/><path stroke-linecap="round" stroke-linejoin="round" d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
              {%- elsif block.settings.icon_type == 'lock' -%}
                <svg viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4"/></svg>
              {%- elsif block.settings.icon_type == 'headset' -%}
                <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 18v-6a9 9 0 0118 0v6"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg>
              {%- elsif block.settings.icon_type == 'truck' -%}
                <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
              {%- elsif block.settings.icon_type == 'star' -%}
                <svg viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
              {%- elsif block.settings.icon_type == 'emoji' -%}
                <span class="esb__trust-icon-emoji">{{ block.settings.icon_emoji | default: '✅' }}</span>
              {%- endif -%}
            </div>
            <div class="esb__trust-label">{{ block.settings.label | newline_to_br }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "ESG Benefits",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0a1628"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness %",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 60
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top",    "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center",   "label": "Left" },
        { "value": "right center",  "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Advantage"
    },
    {
      "type": "text",
      "id": "title_plain",
      "label": "Title — white part",
      "default": "Why Choose"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title — accent color part",
      "default": "Elite Sim Golf"
    },
    {
      "type": "header",
      "content": "Trust Bar"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show trust bar",
      "default": true
    },
    {
      "type": "range",
      "id": "trust_padding_bottom",
      "label": "Trust bar bottom padding (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 48
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (gold)",
      "default": "#2d7dd2"
    },
    {
      "type": "text",
      "id": "body_font",
      "label": "Font family",
      "default": "Inter"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (px)",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Cards bottom padding (px)",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "✦ Benefit Card",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon type",
          "default": "expert_star",
          "options": [
            { "value": "expert",      "label": "Person" },
            { "value": "expert_star", "label": "Person + Star" },
            { "value": "tag",         "label": "Price Tag" },
            { "value": "truck",       "label": "Delivery Truck" },
            { "value": "shield",      "label": "Shield" },
            { "value": "star",        "label": "Star" },
            { "value": "headset",     "label": "Headset" },
            { "value": "emoji",       "label": "Custom Emoji" }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image (overrides icon type)"
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Emoji (only if icon type = Custom Emoji)",
          "default": "⭐"
        },
        {
          "type": "text",
