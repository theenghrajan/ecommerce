<section
  id="{{ section.settings.id }}"
  class="landing"
>
  {% style %}
    #{{section.settings.id}} {
      padding: {{ section.settings.vp-desktop }}px {{ section.settings.hp-desktop }}px;
      background-color: {{ section.settings.background_color }};
      --heading_color: {{ section.settings.heading_color }};
      --text_color: {{ section.settings.text_color }};
      --btn_bg: {{ section.settings.btn_bg }};
      --btn_text: {{ section.settings.btn_text }};
      background: url({{section.settings.background | image_url: width: 2000}}) no-repeat center center fixed;
      background-size: cover;
      position: relative;
      z-index: 1;
    }
    {% if section.settings.overlay %}
    #{{section.settings.id}}::after{
      display: block;
      position: absolute;
      z-index: -1;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: {{section.settings.overlay}};
      opacity: calc({{section.settings.opacity}} * 0.05);
      content: '';
    }
    {% endif %}
    .marquee-slider{
        display: flex;
        overflow-x: hidden;
        flex-wrap: nowrap;
    }
    .marquee-wrap{
        flex-shrink: 0;
        margin: 0 40px;
    }
    .marquee-text{
        letter-spacing: 2px;
        text-transform: uppercase;
    }
    .marquee-text p{
      font-size: 14px;
      margin-bottom: 0;
    }
    @media screen and (max-width: 767px) {
      #{{section.settings.id}} {
          padding: {{ section.settings.vp-mobile }}px {{ section.settings.hp-mobile }}px;
          background-attachment: scroll;
      }
    }
  {% endstyle %}

  <div class="sn-container text-center full">
    <div class="marquee-slider">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'marquee' %}
            <div class="marquee-wrap" {{ block.shopify_attributes }}>
              {% if block.settings.icon %}
                <span class="marquee-icon">
                  <img
                    src="{{ block.settings.icon | image_url: width: 64 }}"
                    width="100%"
                    height="auto"
                    alt=""
                    class="sn-img"
                  >
                </span>
              {% endif %}
              {% if block.settings.text != '' %}
                <span class="marquee-text">
                  {{ block.settings.text }}
                </span>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  {{ section.settings['custom-js'] }}
</section>

{% schema %}
{
  "name": "Custom-Marquee",
  "settings": [
    {
      "id": "id",
      "type": "text",
      "label": "Section ID",
      "default": "sn-hero"
    },
    {
      "type": "header",
      "content": "Section styles"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": "Background color"
    },
    {
      "id": "heading_color",
      "type": "color",
      "label": "Heading color"
    },
    {
      "id": "text_color",
      "type": "color",
      "label": "Text color"
    },
    {
      "id": "btn_bg",
      "type": "color",
      "label": "Button background color"
    },
    {
      "id": "btn_text",
      "type": "color",
      "label": "Button text color"
    },
    {
      "id": "vp-desktop",
      "type": "range",
      "label": "Vertical padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "id": "hp-desktop",
      "type": "range",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "id": "vp-mobile",
      "type": "range",
      "label": "Vertical padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48
    },
    {
      "id": "hp-mobile",
      "type": "range",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "id": "background",
      "type": "image_picker",
      "label": "Background image"
    },
    {
      "id": "overlay",
      "type": "color",
      "label": "Overlay color"
    },
    {
      "id": "opacity",
      "type": "range",
      "step": 1,
      "min": 0,
      "max": 20,
      "default": 10,
      "label": "Overlay opacity"
    }
  ],
  "blocks": [
    {
      "name": "Marquee item",
      "type": "marquee",
      "settings": [
        {
          "id": "icon",
          "type": "image_picker",
          "label": "Icon"
        },
        {
          "id": "text",
          "type": "richtext",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom-Marquee"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
