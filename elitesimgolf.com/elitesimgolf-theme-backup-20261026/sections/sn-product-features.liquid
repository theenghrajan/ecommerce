<section
  id="{{ section.settings.id }}"
  class="landing"
>
  {% style %}
    #{{section.settings.id}} {
      padding: {{ section.settings.vp-desktop }}px {{ section.settings.hp-desktop }}px;
      background-color: {{ section.settings.background_color }};
      --heading_color: {{ section.settings.heading_color }};
      --text_color: {{ section.settings.text_color }};
      --accent_color: {{ section.settings.accent_color }};
      --btn_bg: {{ section.settings.btn_bg }};
      --btn_text: {{ section.settings.btn_text }};
      --card_bg: {{ section.settings.card_bg }};
      background: url({{section.settings.background | image_url: width: 2000}}) no-repeat center center fixed;
      background-size: cover;
      position: relative;
      z-index: 1;
    }
    {% if section.settings.overlay %}
    #{{section.settings.id}}::after{
      display: block;
      position: absolute;
      z-index: -1;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: {{section.settings.overlay}};
      opacity: calc({{section.settings.opacity}} * 0.05);
      content: '';
    }
    {% endif %}

    .features-tabs{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        max-width: 1280px;
        margin-inline: auto;
        background: rgba(0,0,0,0.1);
        border-radius: 10px;
        gap: 1px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }
    .features-tabs button{
        cursor: pointer;
        background: var(--card_bg);
        color: var(--text_color);
        padding: 12px 24px;
        font-size: 18px;
        text-transform: uppercase;
    }
    .features-tabs button.feature-tab.active{
        background: var(--accent_color);
        color: #fff;
    }
    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        padding: 20px 0;
        max-width: 1280px;
        margin-inline: auto;
    }
    .feature-num{
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: var(--accent_color);
        border-radius: 20px;
        color: #fff;
        margin-bottom: 20px;
    }
    .feature-item{
        padding: 20px;
        border-radius: 10px;
        background: var(--card_bg);
        border: 1px solid rgba(0,0,0,0.1);
        transition: ease-in-out 0.4s;
    }
    .feature-item:hover{
        background: rgba(255,255,255,0.05);
    }
    .feature-title{
        font-size: 20px;
        margin-bottom: 10px;
        color: var(--heading_color);
        font-weight: bold;
        text-transform: uppercase;
    }
    .feature-body{
        color: var(--text_color);
    }
    @media screen and (max-width: 767px) {
      #{{section.settings.id}} {
          padding: {{ section.settings.vp-mobile }}px {{ section.settings.hp-mobile }}px;
          background-attachment: scroll;
      }
    }
  {% endstyle %}

  {% if section.settings.heading != '' %}
    <div class="sn-container hcenter text-center">
      <div class="sn-col-1 sn-heading mb-2">
        {{ section.settings.text }}
      </div>
    </div>
  {% endif %}

  <div class="features-tabs">
    {% if section.settings.tab1 != '' %}
      <button class="feature-tab active" onclick="switchTab(this, 'vtrack')">
        {{ section.settings.tab1 }}
      </button>
    {% endif %}
    {% if section.settings.tab2 != '' %}
      <button class="feature-tab" onclick="switchTab(this, 'enclosure')">
        {{ section.settings.tab2 }}
      </button>
    {% endif %}
    {% if section.settings.tab3 != '' %}
      <button class="feature-tab" onclick="switchTab(this, 'projector')">{{ section.settings.tab3 }}</button>
    {% endif %}
    {% if section.settings.tab4 != '' %}
      <button class="feature-tab" onclick="switchTab(this, 'mats')">{{ section.settings.tab4 }}</button>
    {% endif %}
  </div>

  {% if section.settings.tab1 != '' %}
    <div id="tab-vtrack" class="features-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tab1' %}
            <div class="feature-item {{ block.settings.class }}" {{ block.shopify_attributes }}>
              <div class="feature-num">{{ block.settings.number }}</div>
              <div>
                <div class="feature-title">{{ block.settings.title }}</div>
                <div class="feature-body">{{ block.settings.text }}</div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.tab2 != '' %}
    <div id="tab-enclosure" class="features-grid" style="display:none;">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tab2' %}
            <div class="feature-item {{ block.settings.class }}" {{ block.shopify_attributes }}>
              <div class="feature-num">{{ block.settings.number }}</div>
              <div>
                <div class="feature-title">{{ block.settings.title }}</div>
                <div class="feature-body">{{ block.settings.text }}</div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.tab3 != '' %}
    <div id="tab-projector" class="features-grid" style="display:none;">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tab3' %}
            <div class="feature-item {{ block.settings.class }}" {{ block.shopify_attributes }}>
              <div class="feature-num">{{ block.settings.number }}</div>
              <div>
                <div class="feature-title">{{ block.settings.title }}</div>
                <div class="feature-body">{{ block.settings.text }}</div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.tab4 != '' %}
    <div id="tab-mats" class="features-grid" style="display:none;">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tab4' %}
            <div class="feature-item {{ block.settings.class }}" {{ block.shopify_attributes }}>
              <div class="feature-num">{{ block.settings.number }}</div>
              <div>
                <div class="feature-title">{{ block.settings.title }}</div>
                <div class="feature-body">{{ block.settings.text }}</div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  {% endif %}
</section>

<script>
  function switchTab(btn, id) {
    document.querySelectorAll('.feature-tab').forEach((t) => t.classList.remove('active'));
    btn.classList.add('active');
    ['vtrack', 'enclosure', 'projector', 'mats'].forEach((name) => {
      const el = document.getElementById('tab-' + name);
      if (el) el.style.display = name === id ? 'grid' : 'none';
    });
  }
</script>

