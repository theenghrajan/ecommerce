        {
          "type": "inline_richtext",
          "label": "Title",
          "id": "title4"
        },
        {
          "type": "inline_richtext",
          "label": "Text",
          "id": "text4"
        },
        {
          "type": "text",
          "label": "CSS class",
          "id": "class"
