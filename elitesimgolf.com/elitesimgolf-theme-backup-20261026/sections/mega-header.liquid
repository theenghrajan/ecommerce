{%- comment -%}
================================================================
  SECTION: HEADER WITH MEGA MENUS
  File: sections/custom-header.liquid
================================================================
{%- endcomment -%}

{%- assign expert_phone_raw = section.settings.expert_phone | default: '865-657-1028' -%}
{%- assign expert_phone_link = expert_phone_raw | remove: '-' | remove: ' ' | remove: '(' | remove: ')' | remove: '.' -%}
{%- assign expert_email = section.settings.expert_email | default: 'info@elitesimgolf.com' -%}

<div class="hdr hdr--{{ section.id }}"
     data-sticky="{{ section.settings.sticky }}"
     style="
            background: {{ section.settings.header_bg }};
       color: {{ section.settings.header_text }};
       --hdr-bg: {{ section.settings.header_bg }};
       --hdr-text: {{ section.settings.header_text }};
       --hdr-accent: {{ section.settings.accent }};
       --hdr-accent-text: {{ section.settings.accent_text }};
       --hdr-card: {{ section.settings.card_bg }};
       --hdr-card-text: {{ section.settings.card_text }};
       --hdr-muted: {{ section.settings.muted_text }};
       --hdr-border: {{ section.settings.border_color }};
       --hdr-mega-accent: #091836;
       --hdr-navbar-bg: {{ section.settings.navbar_bg }};
       --hdr-navbar-text: {{ section.settings.navbar_text }};
       --hdr-announce-bg: {{ section.settings.announce_bg }};
       --hdr-announce-text: {{ section.settings.announce_text_color }};
       --hdr-max: {{ section.settings.container_width }}px;
     ">

  {%- if section.settings.show_announcement and section.settings.announce_text != blank -%}
    <div class="hdr__announce">
      <div class="hdr__announce-inner">
        {%- if section.settings.announce_link != blank -%}
          <a href="{{ section.settings.announce_link }}">{{ section.settings.announce_text }}</a>
        {%- else -%}
          <span>{{ section.settings.announce_text }}</span>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <header class="hdr__main">

    {%- comment -%} ================= UTILITY BAR (Row 1) ================= {%- endcomment -%}
    <div class="hdr__utility">
      <div class="hdr__utility-inner">

        <a href="{{ routes.root_url }}" class="hdr__logo">
          {%- if section.settings.logo != blank -%}
            <img
  src="{{ section.settings.logo | image_url: width: 500 }}"
  alt="{{ shop.name | escape }}"
  width="{{ section.settings.logo.width }}"
  height="{{ section.settings.logo.height }}"
  loading="eager"
  style="width:{{ section.settings.logo_width }}px;height:auto;">
          {%- else -%}
            <span class="hdr__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        <button class="hdr__burger" aria-label="Open menu" aria-expanded="false" data-mobile-toggle>
          <span></span><span></span><span></span>
        </button>

        {%- if section.settings.show_search_bar -%}
          <form class="hdr__search" action="{{ routes.search_url }}" method="get" role="search">
            <input type="search" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search for golf simulators, launch monitors, and more...' }}" aria-label="Search">
            <button type="submit" aria-label="Search">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            </button>
          </form>
        {%- endif -%}

        <div class="hdr__expert">
          <span class="hdr__expert-avatar">
            {%- if section.settings.expert_avatar != blank -%}
              <img src="{{ section.settings.expert_avatar | image_url: width: 120 }}" alt="Expert" width="52" height="52" loading="lazy">
            {%- else -%}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
            {%- endif -%}
          </span>
          <div class="hdr__expert-info">
            <span class="hdr__expert-title">{{ section.settings.expert_title | default: 'Expert Sim Builders' }}</span>
            <a href="tel:{{ expert_phone_link }}" class="hdr__expert-line hdr__expert-phone">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.89.34 1.77.65 2.61a2 2 0 0 1-.45 2.11L8.04 9.91a16 16 0 0 0 6.05 6.05l1.47-1.27a2 2 0 0 1 2.11-.45c.84.31 1.72.53 2.61.65A2 2 0 0 1 22 16.92z"/></svg>
              <span>{{ expert_phone_raw }}</span>
            </a>
            <a href="mailto:{{ expert_email }}" class="hdr__expert-line hdr__expert-email">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
              <span>{{ expert_email }}</span>
            </a>
          </div>
        </div>

        <div class="hdr__icons">
          {%- if section.settings.show_account -%}
            <a href="{{ routes.account_url }}" class="hdr__icon" aria-label="Account">
              <span class="hdr__icon-graphic">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
              </span>
              <span class="hdr__icon-label">ACCOUNT</span>
            </a>
          {%- endif -%}
          {%- if section.settings.show_cart -%}
            <a href="{{ routes.cart_url }}" class="hdr__icon hdr__cart" aria-label="Cart">
              <span class="hdr__icon-graphic">
                <img src="https://cdn.shopify.com/s/files/1/0692/9698/0162/files/projecter_Accessoroies_6.png?v=1785008276"
                     alt="Cart" class="hdr__cart-img" width="26" height="26" loading="lazy">
              </span>
<span class="hdr__cart-count"
      id="CartCount"
      {% if cart.item_count == 0 %}style="display:none"{% endif %}>
    {{ cart.item_count }}
</span>
              <span class="hdr__icon-label">CART</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} ================= NAV BAR (Row 2) ================= {%- endcomment -%}
    <div class="hdr__nav-bar">
      <div class="hdr__nav-bar-inner">
        <nav class="hdr__nav" aria-label="Main navigation" data-nav>
          <div class="hdr__nav-top" style="display:none;">
            <a href="{{ routes.root_url }}" class="hdr__nav-logo">
              {%- if section.settings.logo != blank -%}
                <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" loading="lazy">
              {%- else -%}
                <span class="hdr__nav-logo-text">{{ shop.name }}</span>
              {%- endif -%}
            </a>
            <button class="hdr__nav-close" aria-label="Close menu" data-mobile-close type="button">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
            </button>
          </div>
          <ul class="hdr__nav-list">
            {%- for link in section.settings.main_menu.links -%}
              {%- assign mega = null -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'mega' and block.settings.enabled and block.settings.target_handle == link.handle -%}
                  {%- assign mega = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              <li class="hdr__nav-item{% if mega %} has-mega{% endif %}{% if link.current %} is-active{% endif %}" data-nav-item>
                <a href="{{ link.url }}"
                   class="hdr__nav-link"
                   {% if mega %}aria-haspopup="true" aria-expanded="false" data-mega-trigger{% endif %}>
                  {{ link.title }}
                  {%- if mega -%}
                    <svg class="hdr__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                      <path d="M1 1l4 4 4-4" stroke="currentColor" fill="none" stroke-width="1.5"/>
                    </svg>
                  {%- endif -%}
                </a>

                {%- if mega -%}
                  <div class="hdr__mega" data-mega-panel style="opacity:0;visibility:hidden;pointer-events:none;">
                    <div class="hdr__mega-inner">
                      <div class="hdr__mega-card">
                      {%- assign mega_content_cols = mega.settings.columns_count | default: 3 | plus: 0 -%}
                      {%- assign mega_cols = mega_content_cols -%}
                      {%- assign has_featured = false -%}
                      {%- if mega.settings.feat_heading != blank or mega.settings.feat_product != blank or mega.settings.feat_image != blank -%}
                        {%- assign has_featured = true -%}
                        {%- assign mega_cols = mega_cols | plus: 1 -%}
                      {%- endif -%}
                      <div class="hdr__mega-grid{% if has_featured %} hdr__mega-grid--has-featured{% endif %}" style="--mega-cols: {{ mega_cols }}; --mega-content-cols: {{ mega_content_cols }};">

                        {%- for c in (1..3) -%}
                          {%- assign col_h_key   = 'col' | append: c | append: '_heading' -%}
                          {%- assign col_ic_key  = 'col' | append: c | append: '_icon' -%}
                          {%- assign col_ft_key  = 'col' | append: c | append: '_footer_text' -%}
                          {%- assign col_fl_key  = 'col' | append: c | append: '_footer_link' -%}
                          {%- assign col_heading = mega.settings[col_h_key] -%}

                          {%- if col_heading != blank -%}
                            <div class="hdr__mega-col">
                              <div class="hdr__mega-col-head">
                                {%- if mega.settings[col_ic_key] != blank -%}
                                  <span class="hdr__mega-col-icon">
                                    <img src="{{ mega.settings[col_ic_key] | image_url: width: 44 }}" alt="" width="22" height="22" loading="lazy">
                                  </span>
                                {%- endif -%}
                                <span class="hdr__mega-col-title">{{ col_heading }}</span>
                              </div>

                              <ul class="hdr__mega-items">
                                {%- for i in (1..10) -%}
                                  {%- assign it_ic = 'col' | append: c | append: '_item' | append: i | append: '_icon' -%}
                                  {%- assign it_t  = 'col' | append: c | append: '_item' | append: i | append: '_title' -%}
                                  {%- assign it_s  = 'col' | append: c | append: '_item' | append: i | append: '_subtitle' -%}
                                  {%- assign it_l  = 'col' | append: c | append: '_item' | append: i | append: '_link' -%}
                                  {%- assign item_title = mega.settings[it_t] -%}
                                  {%- if item_title != blank -%}
                                    <li class="hdr__mega-item">
                                      <a href="{{ mega.settings[it_l] | default: '#' }}" class="hdr__mega-link">
                                        {%- if mega.settings[it_ic] != blank -%}
                                          <span class="hdr__mega-icon">
                                            <img src="{{ mega.settings[it_ic] | image_url: width: 40 }}" alt="" width="20" height="20" loading="lazy">
                                          </span>
                                        {%- endif -%}
                                        <span class="hdr__mega-body">
                                          <span class="hdr__mega-title">{{ item_title }}</span>
                                          {%- if mega.settings[it_s] != blank -%}
                                            <span class="hdr__mega-sub">{{ mega.settings[it_s] }}</span>
                                          {%- endif -%}
                                        </span>
                                        <span class="hdr__mega-arrow" aria-hidden="true">›</span>
                                      </a>
                                    </li>
                                  {%- endif -%}
                                {%- endfor -%}
                              </ul>

                              {%- if mega.settings[col_ft_key] != blank -%}
                                <a href="{{ mega.settings[col_fl_key] | default: '#' }}" class="hdr__mega-col-footer">
                                  {{ mega.settings[col_ft_key] }} <span aria-hidden="true">→</span>
                                </a>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}

                        {%- if has_featured -%}
                          {%- assign fp = mega.settings.feat_product -%}
                          {%- assign feat_img = mega.settings.feat_image -%}
                          {%- if feat_img == blank and fp.featured_image != blank -%}
                            {%- assign feat_img = fp.featured_image -%}
                          {%- endif -%}
                          {%- assign feat_url = mega.settings.feat_link -%}
                          {%- if feat_url == blank and fp != blank -%}
                            {%- assign feat_url = fp.url -%}
                          {%- endif -%}
                          {%- assign feat_price = mega.settings.feat_price -%}
                          {%- if feat_price == blank and fp != blank -%}
                            {%- assign feat_price = fp.price | money -%}
                          {%- endif -%}

                          <div class="hdr__feat">
                            {%- if mega.settings.feat_eyebrow != blank -%}
                              <span class="hdr__feat-eyebrow">{{ mega.settings.feat_eyebrow }}</span>
                            {%- endif -%}
                            {%- if mega.settings.feat_heading != blank -%}
                              <h3 class="hdr__feat-title">{{ mega.settings.feat_heading }}</h3>
                            {%- endif -%}

                            {%- if mega.settings.feat_show_rating and mega.settings.feat_rating > 0 -%}
                              <div class="hdr__feat-rating">
                                <span class="hdr__stars" aria-label="Rated {{ mega.settings.feat_rating }} of 5">
                                  {%- for s in (1..5) -%}{% if s <= mega.settings.feat_rating %}★{% else %}☆{% endif %}{%- endfor -%}
                                </span>
                                {%- if mega.settings.feat_rating_count > 0 -%}
                                  <span class="hdr__feat-rc">({{ mega.settings.feat_rating_count }})</span>
                                {%- endif -%}
                              </div>
                            {%- endif -%}

                            {%- if feat_img != blank -%}
                              <a href="{{ feat_url | default: '#' }}" class="hdr__feat-img">
                                <img src="{{ feat_img | image_url: width: 600 }}"
                                     alt="{{ mega.settings.feat_heading | escape }}"
                                     width="300" height="200" loading="lazy">
                              </a>
                            {%- endif -%}

                            {%- if feat_price != blank -%}
                              <div class="hdr__feat-price">{{ feat_price }}</div>
                            {%- endif -%}

                            {%- if mega.settings.feat_btn_text != blank -%}
                              <a href="{{ feat_url | default: '#' }}" class="hdr__feat-btn">
                                {{ mega.settings.feat_btn_text }}
                              </a>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      </div>

                      {%- assign has_brand_row = false -%}
                      {%- assign has_feature_row = false -%}
                      {%- for i in (1..5) -%}
                        {%- assign brand_img_key = 'brand' | append: i | append: '_image' -%}
                        {%- assign brand_text_key = 'brand' | append: i | append: '_text' -%}
                        {%- if mega.settings[brand_img_key] != blank or mega.settings[brand_text_key] != blank -%}
                          {%- assign has_brand_row = true -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- for i in (1..4) -%}
                        {%- assign usp_icon_key = 'usp' | append: i | append: '_icon' -%}
                        {%- assign usp_title_key = 'usp' | append: i | append: '_title' -%}
                        {%- assign usp_text_key = 'usp' | append: i | append: '_text' -%}
                        {%- if mega.settings[usp_icon_key] != blank or mega.settings[usp_title_key] != blank or mega.settings[usp_text_key] != blank -%}
                          {%- assign has_feature_row = true -%}
                        {%- endif -%}
                      {%- endfor -%}

                      {%- if has_brand_row or has_feature_row -%}
                        <div class="hdr__mega-extras">
                          {%- if has_brand_row -%}
                            <div class="hdr__mega-brands">
                              <div class="hdr__mega-brands-title">
                                {%- if mega.settings.brands_icon != blank -%}
                                  <img src="{{ mega.settings.brands_icon | image_url: width: 44 }}" alt="" width="22" height="22" loading="lazy">
                                {%- endif -%}
                                <span>{{ mega.settings.brands_title | default: 'Popular Brands' }}</span>
                              </div>

                              <div class="hdr__mega-brands-list">
                                {%- for i in (1..5) -%}
                                  {%- assign brand_img_key = 'brand' | append: i | append: '_image' -%}
                                  {%- assign brand_link_key = 'brand' | append: i | append: '_link' -%}
                                  {%- assign brand_text_key = 'brand' | append: i | append: '_text' -%}
                                  {%- assign brand_img = mega.settings[brand_img_key] -%}
                                  {%- assign brand_text = mega.settings[brand_text_key] -%}
                                  {%- if brand_img != blank or brand_text != blank -%}
                                    <a href="{{ mega.settings[brand_link_key] | default: '#' }}" class="hdr__mega-brand">
                                      {%- if brand_img != blank -%}
                                        <img src="{{ brand_img | image_url: width: 240 }}" alt="{{ brand_text | default: 'Brand' | escape }}" loading="lazy">
                                      {%- else -%}
                                        <span class="hdr__mega-brand-text">{{ brand_text }}</span>
                                      {%- endif -%}
                                    </a>
                                  {%- endif -%}
                                {%- endfor -%}

                                {%- if mega.settings.brands_footer_text != blank -%}
                                  <a href="{{ mega.settings.brands_footer_link | default: '#' }}" class="hdr__mega-brands-footer">
                                    {{ mega.settings.brands_footer_text }} <span aria-hidden="true">→</span>
                                  </a>
                                {%- endif -%}
                              </div>
                            </div>
                          {%- endif -%}

                          {%- if has_feature_row -%}
                            <div class="hdr__mega-usps">
                              {%- for i in (1..4) -%}
                                {%- assign usp_icon_key = 'usp' | append: i | append: '_icon' -%}
                                {%- assign usp_title_key = 'usp' | append: i | append: '_title' -%}
                                {%- assign usp_text_key = 'usp' | append: i | append: '_text' -%}
                                {%- assign usp_icon = mega.settings[usp_icon_key] -%}
                                {%- assign usp_title = mega.settings[usp_title_key] -%}
                                {%- assign usp_text = mega.settings[usp_text_key] -%}
                                {%- if usp_icon != blank or usp_title != blank or usp_text != blank -%}
                                  <div class="hdr__mega-usp">
                                    {%- if usp_icon != blank -%}
                                      <span class="hdr__mega-usp-icon">
                                        <img src="{{ usp_icon | image_url: width: 52 }}" alt="" width="26" height="26" loading="lazy">
                                      </span>
                                    {%- endif -%}
                                    <span class="hdr__mega-usp-body">
                                      {%- if usp_title != blank -%}
                                        <span class="hdr__mega-usp-title">{{ usp_title }}</span>
                                      {%- endif -%}
                                      {%- if usp_text != blank -%}
                                        <span class="hdr__mega-usp-text">{{ usp_text }}</span>
                                      {%- endif -%}
                                    </span>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          <div class="hdr__mobile-meta" style="display:none;">
            <a href="{{ routes.account_url }}" class="hdr__mobile-meta-link">
              <span class="hdr__mobile-meta-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
              </span>
              <span>Login</span>
            </a>

            <a href="tel:{{ expert_phone_link }}" class="hdr__mobile-meta-link">
              <span class="hdr__mobile-meta-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.89.34 1.77.65 2.61a2 2 0 0 1-.45 2.11L8.04 9.91a16 16 0 0 0 6.05 6.05l1.47-1.27a2 2 0 0 1 2.11-.45c.84.31 1.72.53 2.61.65A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <span>Call us now: {{ expert_phone_raw }}</span>
            </a>

            <a href="mailto:{{ expert_email }}" class="hdr__mobile-meta-link">
              <span class="hdr__mobile-meta-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
              </span>
              <span>{{ expert_email }}</span>
            </a>

            <div class="hdr__mobile-socials">
              <a href="https://www.facebook.com/people/ELITE-Sim-Golf/61579712016641/" class="hdr__mobile-social" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.6-1.6H17V4.8c-.4-.1-1.6-.2-2.9-.2-2.9 0-4.8 1.8-4.8 5V11H6.5v3h2.8v8h4.2z"/></svg>
              </a>
              <a href="https://youtube.com/@elitesimgolf" class="hdr__mobile-social" aria-label="YouTube">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.7 31.7 0 0 0 0 12a31.7 31.7 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.7 31.7 0 0 0 24 12a31.7 31.7 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
              </a>
              <a href="https://www.tiktok.com/@elitesimgolf?_r=1&_t=ZS-98MDP0w8lbs" class="hdr__mobile-social" aria-label="TikTok" target="_blank" rel="noopener">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.24V2h-3.12v13.22a2.66 2.66 0 1 1-2.66-2.66c.23 0 .46.03.68.09V9.47a5.78 5.78 0 1 0 5.1 5.75V8.54a7.9 7.9 0 0 0 4.62 1.48V6.9c-.29 0-.57-.07-.85-.21z"/>
  </svg>
</a>
            </div>
          </div>
        </nav>
      </div>
    </div>

  </header>

  <nav class="hdr__mobile-bottom-nav" aria-label="Mobile quick navigation">
    <button class="hdr__mobile-bottom-nav-item" type="button" aria-label="Open menu" data-mobile-toggle>
