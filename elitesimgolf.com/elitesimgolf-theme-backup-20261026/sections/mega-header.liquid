<script>
  (function() {
    var root = document.querySelector('.hdr--{{ section.id }}');
    if (!root) return;

    var header = root.querySelector('.hdr__main');

function updateHeader() {
  if (root.dataset.sticky !== 'true') return;

  var scrolled = window.pageYOffset || document.documentElement.scrollTop;

  if (scrolled > 50) {
    root.classList.add('is-scrolled');
    header.classList.add('is-sticky');
  } else {
    root.classList.remove('is-scrolled');
    header.classList.remove('is-sticky');
  }
}

updateHeader(); // Run immediately on page load
window.addEventListener('scroll', updateHeader, { passive: true });

    // Mobile toggle
    var burgers = root.querySelectorAll('[data-mobile-toggle]');
    var nav = root.querySelector('[data-nav]');
    var closeBtn = root.querySelector('[data-mobile-close]');

    function setMobileMenu(open) {
      if (!nav) return;
      nav.classList.toggle('is-open', open);
      root.classList.toggle('is-mobile-open', open);
      document.body.classList.toggle('custom-nav-open', open);
      burgers.forEach(function(burger) {
        burger.setAttribute('aria-expanded', open);
        burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (!open) {
        root.querySelectorAll('.hdr__nav-item.is-open, .hdr__mega-col.is-open').forEach(function(el) {
          el.classList.remove('is-open');
        });
      }
    }

    burgers.forEach(function(burger) {
      burger.addEventListener('click', function() {
        setMobileMenu(!nav.classList.contains('is-open'));
      });
    });
    if (closeBtn) {
      closeBtn.addEventListener('click', function() { setMobileMenu(false); });
    }
    if (nav) {
      nav.querySelectorAll('a[href]').forEach(function(link) {
        link.addEventListener('click', function() {
          if (window.matchMedia('(max-width: 1024px)').matches && !link.hasAttribute('data-mega-trigger')) {
            setMobileMenu(false);
          }
        });
      });
      window.addEventListener('resize', function() {
        if (!window.matchMedia('(max-width: 1024px)').matches) setMobileMenu(false);
      });
    }

    // Mobile: nav-item accordion
    root.querySelectorAll('.hdr__nav-item.has-mega').forEach(function(item) {
      var link = item.querySelector('.hdr__nav-link');
      if (!link) return;
      link.addEventListener('click', function(e) {
        if (window.matchMedia('(max-width: 1024px)').matches) {
          e.preventDefault();
          var willOpen = !item.classList.contains('is-open');
          root.querySelectorAll('.hdr__nav-item.is-open').forEach(function(o) {
            if (o !== item) {
              o.classList.remove('is-open');
              var l = o.querySelector('.hdr__nav-link');
              if (l) l.setAttribute('aria-expanded', 'false');
              o.querySelectorAll('.hdr__mega-col.is-open').forEach(function(c) { c.classList.remove('is-open'); });
            }
          });
          item.classList.toggle('is-open', willOpen);
          link.setAttribute('aria-expanded', willOpen);
        }
      });
    });

    // Mobile: per-column accordion
    root.querySelectorAll('.hdr__mega-col-head').forEach(function(head) {
      head.addEventListener('click', function(e) {
        if (window.matchMedia('(max-width: 1024px)').matches) {
          e.preventDefault();
          e.stopPropagation();
          var col = head.closest('.hdr__mega-col');
          if (col) col.classList.toggle('is-open');
        }
      });
    });

// Desktop: hover any nav item closes other megas; mouse outside nav/mega closes all
// ===== Desktop Mega Menu =====
if (!window.matchMedia('(max-width: 1024px)').matches) {

  let closeTimer;

  root.querySelectorAll('.hdr__nav-item.has-mega').forEach(function(item){

    const mega = item.querySelector('.hdr__mega');

    item.addEventListener('mouseenter',function(){

      clearTimeout(closeTimer);

      root.querySelectorAll('.hdr__nav-item.has-mega.is-open').forEach(function(open){
        if(open!==item){
          open.classList.remove('is-open');
        }
      });

      item.classList.add('is-open');

    });

    item.addEventListener('mouseleave',function(){

      closeTimer = setTimeout(function(){

        if(!mega.matches(':hover')){
          item.classList.remove('is-open');
        }

      },80);

    });

    if(mega){

      mega.addEventListener('mouseenter',function(){
        clearTimeout(closeTimer);
      });

      mega.addEventListener('mouseleave',function(){
        item.classList.remove('is-open');
      });

    }

  });

  document.addEventListener('click',function(e){

    if(!e.target.closest('.hdr__nav-item') &&
       !e.target.closest('.hdr__mega')){

      root.querySelectorAll('.hdr__nav-item.is-open').forEach(function(item){
        item.classList.remove('is-open');
      });

    }

  });

}
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        root.querySelectorAll('.hdr__nav-item.is-open').forEach(function(el) {
          el.classList.remove('is-open');
        });
        setMobileMenu(false);
      }
    });
  })();
  function updateCartCount() {

    fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {

            const badge = document.getElementById('CartCount');

            if (!badge) return;

            badge.textContent = cart.item_count;

            if (cart.item_count > 0) {
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }

        });

}
</script>

