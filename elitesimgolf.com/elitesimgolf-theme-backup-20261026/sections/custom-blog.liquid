      "label": "Title — main part",
      "default": "Elite Sim Golf"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title — accent color part",
      "default": "Blog"
    },
    {
      "type": "header",
      "content": "Card Options"
    },
    {
      "type": "checkbox",
