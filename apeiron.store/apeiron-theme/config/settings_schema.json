  {
    "name": "Product card",
    "settings": [
      {
        "type": "header",
        "content": "Product card settings"
      },
      {
        "type": "select",
        "id": "discount_type",
        "label": "Discount badge type",
        "options": [
          {
            "value": "currency",
            "label": "Currency"
          },
          {
            "value": "percents",
            "label": "Percentage"
          },
          {
            "value": "hidden",
            "label": "Hidden"
          }
        ],
        "default": "currency"
      }
    ]
  },
  {
    "name": "Global subscriptions",
    "settings": [
      {
        "type": "checkbox",
        "id": "allow_subscriptions",
        "label": "Allow subscriptions",
        "default": false
      }
    ]
  },
  {
    "name": "Product delivery settings",
    "settings": [
      {
        "type": "header",
        "content": "Delivery settings"
      },
      {
        "type": "select",
        "id": "delivery_mode",
        "label": "Skip weekends",
        "options": [
          {
            "value": "yes",
            "label": "Yes"
          },
          {
            "value": "no",
            "label": "No"
          }
        ],
        "default": "yes"
      },
      {
        "type": "select",
        "id": "delivery_days",
        "label": "Delivery days",
        "options": [
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          },
          {
            "value": "5",
            "label": "5"
          }
        ],
        "default": "5"
      }
    ]
  },
