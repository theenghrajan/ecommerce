{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign title = section.settings.title

  assign blocks = section.blocks

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  assign animation = 'animate__animated opacity-0'
  if section.index0 == 0 or section.index0 == 1
    assign animation = ''
  endif

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary"
>
  <div
    class="gap-7.5 lg:gap-15 container grid grid-cols-1 lg:grid-cols-2 {{ animation -}}"
    {% if animation %}
      x-intersect.once="$el.classList.add('animate__fadeIn')"
    {% endif %}
  >
    {% if title != blank %}
      <div class="lg:pt-17.5 flex justify-center">
        <h2 class="text-sc-title max-w-[var(--width)] text-3xl font-semibold lg:text-5xl" style="--width: 480px;">
          {{- title -}}
        </h2>
      </div>
    {% endif %}

    {% if blocks.size > 0 %}
      <div
        class="border-c-border lg:p-7.5 grid w-full grid-cols-1 gap-6 rounded-lg border p-5"
        x-data="{active: 0}"
      >
        {% for block in blocks %}
          {% liquid
            assign b_title = block.settings.title
            assign b_icon = block.settings.icon
            assign b_text = block.settings.text
          %}

          <div
            class="space-y-3 {{ animation -}}"
            {% if animation %}
              style="animation-delay: {{ forloop.index0 | times: 100 | append: 'ms' }};"
              x-intersect.once="$el.classList.add('animate__fadeIn')"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="flex items-center space-x-2">
              {% if b_icon != blank %}
                <div class="w-full max-w-6">
                  {{ b_icon | image_url: width: 24 | image_tag: class: 'object-contain no-select w-full h-full' }}
                </div>
              {% endif %}

              {% if b_title != blank %}
                <h3 class="text-sc-title font-third text-lg lg:text-xl">{{- b_title -}}</h3>
              {% endif %}
            </div>

            {% if b_text != blank %}
              <div class="rte bg-sc-bg-secondary text-sc-body-primary rounded-lg p-5 text-base lg:text-lg">
                {{- b_text -}}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Specifications",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section anchor id",
      "default": "Specifications"
    },
    {
      "type": "color",
      "id": "c-bg-primary",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c-bg-secondary",
      "label": "Block background color",
      "default": "#F7FAFF"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Title color",
      "default": "#1A4178"
    },
    {
      "type": "color",
      "id": "c-body-primary",
      "label": "Text color",
      "default": "#25282A"
    },
    {
      "type": "header",
      "content": "Content settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title"
    },
    {
      "type": "header",
      "content": "Padding Y settings"
    },
    {
      "type": "number",
      "id": "pt_mob",
      "label": "Mobile padding top in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pb_mob",
      "label": "Mobile padding bottom in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pt_tab",
      "label": "Tablet padding top in px",
      "default": 60
    },
    {
      "type": "number",
      "id": "pb_tab",
      "label": "Tablet padding bottom in px",
      "default": 60
    },
    {
      "type": "number",
      "id": "pt_desk",
      "label": "Desktop padding top in px",
      "default": 90
    },
    {
      "type": "number",
      "id": "pb_desk",
      "label": "Desktop padding bottom in px",
      "default": 90
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.cart"]
  },
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Block title"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Block icon"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Block text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Specifications",
      "category": "Sections",
      "settings": {
        "title": "What to Expect with BPC-157 Prime Capsules"
      },
      "blocks": [
        {
          "type": "block",
          "settings": {
            "title": "When to Take",
            "text": "<p>Take 1 capsule up to 2 times per day with food. For higher dosages, please consult your healthcare provider.</p>"
          }
        },
        {
          "type": "block",
          "settings": {
            "title": "Onset Time",
            "text": "<p>7 days, estimated optimal impacts after 3-4 weeks of regular use.</p>"
          }
        },
        {
          "type": "block",
          "settings": {
            "title": "Contraindications",
            "text": "<p><strong>ALLERGY WARNING<br/></strong><br/>This product is contraindicated in an individual with a history of hypersensitivity to any of its ingredients. <br/> The omega-3 fatty acids in Super EPA are derived from fish.<br/><br/><strong>PREGNANCY <br/></strong><br/>If pregnant, consult your health-care practitioner before using this product.<br/><br/><strong>INTERACTIONS <br/></strong><br/>There are no known adverse interactions or contraindications at publication date.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
