{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign title = section.settings.title
  assign description = section.settings.description
  assign image = section.settings.image
  assign image_mob = section.settings.image_mob | default: image

  assign btn_url = section.settings.btn_url
  assign btn_text = section.settings.btn_text
  assign btn_type = section.settings.btn_type

  assign blocks = section.blocks

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  assign animation = 'animate__animated opacity-0'
  if section.index0 == 0 or section.index0 == 1
    assign animation = ''
  endif

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary"
>
  <div
    class="gap-7.5 container grid grid-cols-1 {{ animation -}}"
    {% if animation %}
      x-intersect.once="$el.classList.add('animate__fadeIn')"
    {% endif %}
  >
    {% if title != blank or description != blank %}
      <div
        class="py-15 md:px-7.5 relative flex min-h-[300px] flex-col justify-center overflow-hidden rounded-lg px-5 lg:!bg-none"
        {% if image_mob != blank %}
          style="background-image: url('{{ image_mob | image_url: width: 991 }}'); background-size: cover; background-position: center;"
        {% endif %}
      >
        {% if image != blank %}
          <div
            class="absolute inset-0 hidden lg:block"
            style="background-image: url('{{ image | image_url: width: 1700 }}'); background-size: cover; background-position: center;"
          ></div>
        {% endif %}

        <div class="relative space-y-4">
          {% if title != blank %}
            <h2 class="text-sc-title text-3xl font-semibold lg:text-5xl">
              {{- title -}}
            </h2>
          {% endif %}

          {% if description != blank %}
            <div class="rte text-sc-title">{{- description -}}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if blocks.size > 0 %}
      <div
        class="border-c-border lg:p-7.5 bg-sc-bg-secondary flex w-full flex-col rounded-lg border p-5"
        x-data="{active: 1}"
      >
        {% for block in blocks %}
          {% liquid
            assign b_title = block.settings.title
            assign b_subtitle = block.settings.b_subtitle
            assign b_text = block.settings.text

            if b_title == blank
              continue
            endif
          %}

          <div
            class="{%- unless forloop.last -%} pb-3 border-b mb-3 lg:mb-4 lg:pb-4 border-c-border {%- endunless %} {{ animation -}}"
            {% if animation %}
              style="animation-delay: {{ forloop.index | times: 100 | append: 'ms' }}"
              x-intersect.once="$el.classList.add('animate__fadeIn')"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <button
              @click="active === {{ forloop.index }} ? active = null : active = {{ forloop.index }}"
              type="button"
              class="no-select flex w-full flex-col space-y-2 text-left"
              aria-controls="{{ forloop.index | append: block.id | prepend: 'content-' }}"
              aria-label="{{ b_title }}"
            >
              <span class="flex w-full items-center justify-between space-x-3">
                <span class="text-sc-body-primary text-xl font-semibold lg:text-2xl xl:text-3xl">
                  {{- b_title -}}
                </span>

                {% render 'icon',
                  name: 'accordion-icon',
                  class: 'shrink-0 duration-200 w-6 h-6 ease-in-out text-c-navy',
                  active: forloop.index
                %}
              </span>

              {% if b_subtitle != blank %}
                <span class="font-third text-sc-body-primary text-base lg:text-lg">{{- b_subtitle -}}</span>
              {% endif %}
            </button>

            <div
              x-cloak
              x-collapse
              x-show="active === {{ forloop.index }}"
              :aria-hidden="active !== {{ forloop.index }}"
              id="{{ forloop.index | append: block.id | prepend: 'content-' }}"
            >
              <div class="rte text-sc-body-primary pt-2 text-base xl:text-xl">{{- b_text -}}</div>
            </div>
          </div>
        {% endfor %}

        {% if btn_text != blank %}
          <a
            href="{{ btn_url }}"
            class="{% render 'btn-class', btn: btn_type %} mt-7.5 group w-max max-w-full lg:mt-10 {{ animation }}"
            aria-label="{{ btn_text }}"
            {% if animation %}
              style="animation-delay: {{ blocks.size | times: 100 | append: 'ms' }}"
              x-intersect.once="$el.classList.add('animate__fadeIn')"
            {% endif %}
          >
            <span>
              {{- btn_text -}}
            </span>
            {% render 'icon',
              name: 'btn-arrow',
              class: 'transition-transform w-5 duration-200 ease-in-out group-hover:translate-x-1.5'
            %}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Vertical accordion",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section anchor id",
      "default": "Vertical accordion"
    },
    {
      "type": "color",
      "id": "c-bg-primary",
      "label": "Background color",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "c-bg-secondary",
      "label": "Block background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Section text color",
      "default": "#1A4178"
    },
    {
      "type": "color",
      "id": "c-body-primary",
      "label": "Accordion text color",
      "default": "#25282A"
    },
    {
      "type": "header",
      "content": "Content settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Section description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    },
    {
      "type": "image_picker",
      "id": "image_mob",
      "label": "Section mobile image"
    },
    {
      "type": "header",
      "content": "Button settings"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button url"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Section button text",
      "default": "Vew information sheet"
    },
    {
      "type": "select",
      "id": "btn_type",
      "label": "Button type",
      "options": [
        {
          "value": "btn_primary_fill",
          "label": "Primary fill"
        },
        {
          "value": "btn_primary_outline",
          "label": "Primary outline"
        },
        {
          "value": "btn_secondary_fill",
          "label": "Secondary fill"
        },
        {
          "value": "btn_secondary_outline",
          "label": "Secondary outline"
        },
        {
          "value": "link_primary",
          "label": "Link primary"
        },
        {
          "value": "link_secondary",
          "label": "Link secondary"
        }
      ],
      "default": "btn_primary_outline"
    },
    {
      "type": "header",
      "content": "Padding Y settings"
    },
    {
      "type": "number",
      "id": "pt_mob",
      "label": "Mobile padding top in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pb_mob",
      "label": "Mobile padding bottom in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pt_tab",
      "label": "Tablet padding top in px",
      "default": 60
    },
    {
      "type": "number",
      "id": "pb_tab",
      "label": "Tablet padding bottom in px",
      "default": 60
    },
    {
      "type": "number",
      "id": "pt_desk",
      "label": "Desktop padding top in px",
      "default": 90
    },
    {
      "type": "number",
      "id": "pb_desk",
      "label": "Desktop padding bottom in px",
      "default": 90
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.cart"]
  },
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Block title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Block subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Block text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertical accordion",
      "category": "Sections",
      "settings": {
        "title": "Practitioner Resources",
        "description": "For professionals looking to help their patients."
      },
      "blocks": [
        {
          "type": "block",
          "settings": {
            "title": "People Requiring:",
            "text": "<ul><li>Digestive Support; Both Upper & Lower</li><li>Musculoskeletal Support</li><li>Gut Brain Axis Protocols</li><li>Immune System Support</li></ul>"
          }
        },
        {
          "type": "block",
          "settings": {
            "title": "Research"
          }
        }
      ]
    }
  ]
}
{% endschema %}
