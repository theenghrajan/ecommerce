        {
          "value": "column",
          "label": "Column"
        }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Title color",
      "default": "#1A4178"
    },
    {
      "type": "color",
