{% liquid
  assign title = section.settings.title
  assign subtitle = section.settings.subtitle
  assign text = section.settings.text

  assign btn_url = section.settings.btn_url
  assign btn_text = section.settings.btn_text
  assign btn_type = section.settings.btn_type

  assign label_icon = section.settings.label_icon
  assign label_text = section.settings.label_text

  assign html = section.settings.html
  assign liquid = section.settings.liquid

  assign animation = 'animate__animated opacity-0'
  if section.index0 == 0 or section.index0 == 1
    assign animation = ''
  endif

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

<div
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary text-sc-title overflow-hidden"
>
  <div class="container justify-between xl:flex xl:space-x-5">
    <div class="mx-auto flex max-w-[950px] flex-col lg:items-center lg:text-center">
      {% if subtitle != blank %}
        <p class="rte font-third mb-3 text-base md:mb-4 lg:text-lg">{{- subtitle -}}</p>
      {% endif %}

      {% if title != blank %}
        <h2 class="rte text-3xl font-semibold lg:text-5xl">{{- title -}}</h2>
      {% endif %}

      {% if text != blank %}
        <div class="rte text-sc-body-primary mt-4 text-lg md:mt-5 lg:text-xl">{{- text -}}</div>
      {% endif %}

      {% if btn_text != blank %}
        <div class="mt-7.5 md:mt-10">
          <a
            href="{{ btn_url }}"
            class="{% render 'btn-class', btn: btn_type %} w-max max-w-full lg:mx-auto {{ animation -}}"
            aria-label="{{ btn_text }}"
            {% if animation %}
              x-intersect.once="$el.classList.add('animate__fadeIn')"
            {% endif %}
          >
            <span>
              {{- btn_text -}}
            </span>
          </a>
        </div>
      {% endif %}

      {% if label_text != blank %}
        <div class="mt-4 flex items-center gap-2.5">
          {% if label_icon != blank %}
            <div class="w-full max-w-4">
              {{
                label_icon
                | image_url: width: 32
                | image_tag: alt: label_icon.alt, class: 'h-full w-full object-contain', widths: '16, 32'
              }}
            </div>
          {% endif %}

          <div class="rte font-third text-sc-title text-sm">{{- label_text -}}</div>
        </div>
      {% endif %}
    </div>
  </div>

  {% if html != blank or liquid != blank %}
    <div class="text-sc-body-primary container flex flex-col space-y-5 {% if subtitle != blank or title != blank or text != blank %} pt-10 lg:pt-15 {% endif %}">
      {% if html != blank or liquid != blank %}
        <div>
          {{ html }}
        </div>
      {% endif %}

      {% if liquid != blank %}
        <div>
          {{ liquid }}
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "About / richtext",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "c-bg-primary",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Title color",
      "default": "#1A4178"
    },
    {
      "type": "color",
      "id": "c-body-primary",
      "label": "Text color",
      "default": "#25282A"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Section title",
      "default": "SECTION TITLE"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Section subtitle"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Section text"
    },
    {
      "type": "header",
      "content": "Button settings"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button url"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Section button text",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "select",
      "id": "btn_type",
      "label": "Button type",
      "options": [
        {
          "value": "btn_primary_fill",
          "label": "Primary fill"
        },
        {
          "value": "btn_primary_outline",
          "label": "Primary outline"
        },
        {
          "value": "btn_secondary_fill",
          "label": "Secondary fill"
        },
        {
          "value": "btn_secondary_outline",
          "label": "Secondary outline"
        },
        {
          "value": "link_primary",
          "label": "Link primary"
        }
      ],
      "default": "btn_primary_outline"
    },
    {
      "type": "header",
      "content": "Bottom label"
    },
    {
      "type": "image_picker",
      "id": "label_icon",
      "label": "Label icon"
    },
    {
      "type": "inline_richtext",
      "id": "label_text",
      "label": "Label text"
    },
    {
      "type": "html",
      "id": "html",
      "label": "Html component"
    },
    {
      "type": "liquid",
      "id": "liquid",
      "label": "Liquid component"
    },
    {
      "type": "header",
      "content": "Padding Y settings"
    },
    {
      "type": "number",
      "id": "pt_mob",
      "label": "Mobile padding top in px",
      "default": 20
    },
    {
      "type": "number",
      "id": "pb_mob",
      "label": "Mobile padding bottom in px",
      "default": 40
    },
    {
      "type": "number",
      "id": "pt_tab",
      "label": "Tablet padding top in px",
      "default": 45
    },
    {
      "type": "number",
      "id": "pb_tab",
      "label": "Tablet padding bottom in px",
      "default": 45
    },
    {
      "type": "number",
      "id": "pt_desk",
      "label": "Desktop padding top in px",
      "default": 80
    },
    {
      "type": "number",
      "id": "pb_desk",
      "label": "Desktop padding bottom in px",
      "default": 100
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.cart"]
  },
  "presets": [
    {
      "category": "Sections",
      "name": "About / richtext",
      "settings": {
        "title": "APEIRON",
        "subtitle": "(/əˈpaɪˌrɒn/; ἄπειρον)",
        "text": "<p>from ancient Greek meaning (that which is) unlimited; boundless; infinite; often describing the primordial substance from which all things come and return to. </p>"
      }
    }
  ]
}
{% endschema %}
