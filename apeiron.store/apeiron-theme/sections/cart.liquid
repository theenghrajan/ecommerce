      "info": "Use {interest} to show customer interest"
    },
    {
      "type": "header",
      "content": "Cart checkout button styles"
    },
    {
      "type": "color",
      "id": "btn_cta_bg_default",
      "label": "Button bg default",
      "default": "#1A4178"
    },
    {
      "type": "color",
      "id": "btn_cta_text_default",
      "label": "Button text default",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_cta_bg_hover",
      "label": "Button bg hover",
      "default": "#25282A"
    },
    {
      "type": "color",
      "id": "btn_cta_text_hover",
      "label": "Button text hover",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "empty_cart_btn",
      "name": "Empty cart button",
      "settings": [
        {
          "type": "text",
