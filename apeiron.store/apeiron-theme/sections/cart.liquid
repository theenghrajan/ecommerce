{% liquid
  assign cart_upsells = section.settings.cart_upsells
  assign cart_progress_bar_threshold = section.settings.cart_progress_bar_threshold | times: 100
  assign cart_item_count = cart.item_count
  for item in cart.items
    if item.handle == 'order-coverage'
      assign cart_item_count = cart.item_count | minus: 1
      break
    endif
  endfor
%}

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.store('cart').obj.visibleItemCount = {{ cart_item_count | json }};
    {% for upsell_product in cart_upsells -%}
    Alpine.store('cart').upsells.push(Number({{- upsell_product.id -}}));
    {%- endfor %}
    Alpine.store('cart').cart_progress_bar_threshold = {{ cart_progress_bar_threshold }};
  });
</script>

{% render 'css-variables-setter' %}

<template x-teleport="#cart-overlay">
  <div data-section-id="{{ section.id }}">
    {% render 'layout-cart-drawer' %}
  </div>
</template>
{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "bi-section--cart",
  "settings": [
    {
      "type": "text",
      "id": "cart_title",
      "label": "Cart drawer title",
      "default": "Shopping Cart"
    },
    {
      "type": "text",
      "id": "empty_cart_title",
      "label": "Empty cart drawer title",
      "default": "Your cart is empty"
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Show savings",
      "default": true
    },
    {
      "type": "color",
      "id": "show_saving_color",
      "label": "Show savings color",
      "default": "#F93822"
    },
    {
      "type": "header",
      "content": "Cart drawer progress bar settings"
    },
    {
      "type": "checkbox",
      "id": "cart_progress_bar_enabled",
      "label": "Progress bar enabled ?",
      "default": true
    },
    {
      "type": "number",
      "id": "cart_progress_bar_threshold",
      "label": "Progress bar threshold",
      "default": 100
    },
    {
      "type": "inline_richtext",
      "id": "cart_progress_message",
      "label": "Progress bar message",
      "default": "Spend [amount_left] more and get free shipping!",
      "info": "[amount_left] don't remove, will be replaced to value"
    },
    {
      "type": "inline_richtext",
      "id": "cart_progress_reached_message",
      "label": "Progress bar reached message",
      "default": "Congrats! You've unlocked FREE SHIPPING!"
    },
    {
      "type": "header",
      "content": "Cart drawer subscription settings"
    },
    {
      "type": "checkbox",
      "id": "allow_subscriptions",
      "label": "Show subscription widget",
      "default": false
    },
    {
      "type": "header",
      "content": "Cart drawer upsells settings"
    },
    {
      "type": "checkbox",
      "id": "cart_upsells_enabled",
      "label": "Upsells enabled ?",
