      "default": "Free"
    },
    {
      "type": "richtext",
      "id": "cart_footer_privacy_rte",
      "label": "Cart drawer privacy"
    },
    {
      "type": "richtext",
      "id": "cart_footer_interest",
      "label": "Cart drawer interest",
