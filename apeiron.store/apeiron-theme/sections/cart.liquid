    {
      "type": "header",
      "content": "Cart drawer reviews settings"
    },
    {
      "type": "checkbox",
      "id": "oke_reiews",
      "label": "Okendo reviews",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "review_star",
      "label": "Review stars"
    },
    {
      "type": "richtext",
      "id": "review_text",
      "label": "Review text"
    },
    {
      "type": "checkbox",
      "id": "show_cc",
      "label": "Show credit cards",
      "default": false
    },
    {
      "type": "header",
      "content": "Cart drawer footer settings"
    },
    {
      "type": "inline_richtext",
      "id": "cart_footer_label",
      "label": "Cart footer bar title",
      "default": "Science-Backed Results || 60-Day Free Returns || 1-Year Warranty",
      "info": "use || to separate"
    },
    {
      "type": "text",
      "id": "cart_footer_shipping",
