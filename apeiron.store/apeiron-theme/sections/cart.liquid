          "id": "btn_type",
          "label": "Button type",
          "options": [
            {
              "value": "btn_cta_fill",
              "label": "CTA fill"
            },
            {
              "value": "btn_primary_fill",
              "label": "Primary fill"
            },
            {
              "value": "btn_primary_outline",
              "label": "Primary outline"
            },
            {
              "value": "btn_secondary_fill",
              "label": "Secondary fill"
            },
            {
              "value": "btn_secondary_outline",
              "label": "Secondary outline"
            }
          ],
          "default": "btn_cta_fill"
        },
        {
          "type": "header",
          "content": "CTA fill button styles"
        },
        {
          "type": "color",
          "id": "btn_cta_bg_default",
          "label": "Button bg default",
          "default": "#25282A"
        },
        {
          "type": "color",
          "id": "btn_cta_text_default",
          "label": "Button text default",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "btn_cta_bg_hover",
          "label": "Button bg hover",
          "default": "#1A4178"
        },
        {
          "type": "color",
          "id": "btn_cta_text_hover",
          "label": "Button text hover",
          "default": "#FFFFFF"
        }
