{% liquid
  assign active = section.settings.active
  assign linklist = section.settings.linklist
  assign btn_text = section.settings.btn_text
  assign btn_url = section.settings.btn_url
  assign btn_type = section.settings.btn_type
%}

<template x-teleport="#mobile-menu-overlay">
  <div
    @click.outside="$store.mobileMenu.hide()"
    @click.self="$store.mobileMenu.hide()"
    class="fixed bottom-0 left-0 h-full w-full md:top-0 md:h-[calc(100%-40px)] md:p-5"
  >
    <div
      data-section-id="{{ section.id }}"
      class="bg-c-white absolute z-10 flex h-full w-full flex-col items-start overflow-hidden shadow md:max-w-[500px] md:rounded-lg"
      x-cloak
      x-show="$store.mobileMenu.visible"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="translate-y-full md:translate-y-0 md:-translate-x-full"
      x-transition:enter-end="translate-y-0 md:translate-x-0"
      x-transition:leave="transition ease-in duration-300"
      x-transition:leave-start="translate-y-0 md:translate-x-0"
      x-transition:leave-end="translate-y-full md:translate-y-0 md:-translate-x-full"
    >
      <div class="flex h-full w-full flex-1 flex-col">
        <div class="bg-c-white md:px-7.5 sticky top-0 flex min-h-12 w-full items-center justify-between space-x-4 px-5 py-2 md:py-5">
          <button
            type="button"
            aria-label="toggle mobile menu"
            class="group flex h-10 w-10 items-center justify-center"
            @click="$store.mobileMenu.visible ? $store.mobileMenu.hide(): $store.mobileMenu.show()"
            x-init="$el.focus()"
          >
            <span class="sr-only">Open navigation menu</span>
            {% render 'icon', name: 'close', class: 'w-4.5 h-4.5 text-c-shadow duration-200 group-hover:text-c-navy' %}
          </button>

          {% if settings.logo != blank %}
            <span class="mx-auto block w-full max-w-[var(--logo-mob-w)]">
              {{
                settings.logo
                | image_url: width: settings.logo.width, height: settings.logo.height
                | image_tag: alt: 'store logo', class: 'w-full object-contain'
              }}
            </span>
          {% else %}
            <span class="">{{- shop.name -}}</span>
          {% endif %}

          <div class="flex items-center">
            <button
              type="button"
              aria-label="search"
              @click="$store.drawer.show({ id: 'search-drawer'}); $store.mobileMenu.hide()"
              class="group relative flex h-9 w-9 items-center justify-center"
            >
              {% render 'icon', name: 'search', class: 'w-6 h-6 text-c-shadow duration-200 group-hover:text-c-navy' %}
            </button>

            <a
              href="{{ btn_url }}"
              aria-label="{{ btn_text }}"
              class="{% render 'btn-class', btn: btn_type %} ml-3 min-h-9 px-3 text-base leading-none"
            >
              <span>{{- btn_text -}}</span>
            </a>
          </div>
        </div>

        <div class="scrollbar-hide pt-7.5 pb-7.5 bg-sc-bg-secondary relative flex w-full flex-1 flex-col overflow-y-auto overflow-x-hidden">
          <ul
            class="flex w-full flex-1 flex-col"
            x-data="{ active: '{{ active | handleize }}' }"
          >
            {% content_for 'blocks' %}
          </ul>

          {% if linklist != blank %}
            <div class="md:px-7.5 w-full px-5">
              <ul class="mt-5 flex w-full flex-col space-y-3 pt-5">
                {% for link in linklist.links %}
                  <li class="text-c-shadow hover:text-c-navy w-max max-w-full text-lg font-semibold duration-200 ease-in-out">
                    <a
                      aria-label="{{ link.title }}"
                      href="{{- link.url -}}"
                    >
                      {{- link.title -}}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</template>

{% schema %}
{
  "name": "MOBILE MENU",
  "tag": "aside",
  "class": "bi-section--menu",
  "settings": [
    {
      "type": "text",
      "id": "active",
      "label": "Active tab name",
      "default": "Best seller"
    },
    {
      "type": "link_list",
      "id": "linklist",
      "label": "Bottom linklist"
    },
    {
      "type": "header",
      "content": "Drawer button"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Drawer button text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Drawer button url"
    },
    {
      "type": "select",
      "id": "btn_type",
      "label": "Drawer button type",
      "options": [
        {
          "value": "btn_primary_fill",
          "label": "Primary fill"
        },
        {
          "value": "btn_primary_outline",
          "label": "Primary outline"
        },
        {
          "value": "btn_secondary_fill",
          "label": "Secondary fill"
        },
        {
          "value": "btn_secondary_outline",
          "label": "Secondary outline"
        }
      ],
      "default": "btn_primary_fill"
    }
  ],
  "blocks": [{ "type": "_mobile-menu-dropdown" }]
}
{% endschema %}
