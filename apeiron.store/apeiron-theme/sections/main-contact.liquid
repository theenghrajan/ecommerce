{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign image = section.settings.image
  assign image_mob = section.settings.image_mob | default: image

  assign image_mob_class = 'object-cover w-full h-full lg:hidden'
  assign image_class = 'object-cover w-full h-full hidden lg:block'

  assign title = section.settings.title
  assign text = section.settings.text
  assign button_type = section.settings.button_type

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

{% capture images %}
  {% if image_mob != blank %}
    {{
      image_mob
      | image_url: width: 744
      | image_tag: alt: image_mob.alt, class: image_mob_class, widths: '315, 355, 744', draggable: false
    }}
  {% else %}
    {{ 'lifestyle-2' | placeholder_svg_tag: image_mob_class }}
  {% endif %}

  {% if image != blank %}
    {{
      image
      | image_url: width: 1200
      | image_tag: alt: image.alt, class: image_class, widths: '744, 1200', draggable: false
    }}
  {% else %}
    {{ 'lifestyle-2' | placeholder_svg_tag: image_class }}
  {% endif %}
{% endcapture %}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary"
>
  <div class="gap-7.5 lg:gap-x-15 container grid grid-cols-1 lg:grid-cols-2">
    <div class="image-overflow-hidden order-1 rounded-lg lg:-order-1">
      {{ images }}
    </div>

    <div class="mx-auto max-w-xl space-y-3">
      {% if title != blank %}
        {% if section.index == 1 %}
          <h1 class="text-sc-title text-3xl font-semibold md:text-4xl lg:text-5xl">
            {{- title -}}
          </h1>
        {% else %}
          <h2 class="text-sc-title text-3xl font-semibold md:text-4xl lg:text-5xl">
            {{- title -}}
          </h2>
        {% endif %}
      {% endif %}

      {% if text != blank %}
        <div class="rte text-sc-body-primary text-base lg:text-lg">{{- text -}}</div>
      {% endif %}

      {% render 'contact-form', class: 'w-full pt-2', btn_type: button_type %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main contact",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section anchor id",
      "default": "Main contact"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Title color",
      "default": "#1A4178"
    },
    {
      "type": "color",
      "id": "c-body-primary",
      "label": "Text color",
      "default": "#25282A"
    },
    {
      "type": "color",
      "id": "c-bg-primary",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mob",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Content settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Hi! How can we help?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Section text",
      "default": "<p>We're here to assist you in any way we can. Just fill out the form below or reach out to us directly using the contact information provided.</p>"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Section button type",
      "options": [
        {
          "value": "btn_primary_fill",
          "label": "Primary fill"
        },
        {
          "value": "btn_primary_outline",
          "label": "Primary outline"
        },
        {
          "value": "btn_secondary_fill",
          "label": "Secondary fill"
        },
        {
          "value": "btn_secondary_outline",
          "label": "Secondary outline"
        }
      ],
      "default": "btn_primary_fill"
    },
    {
      "type": "header",
      "content": "Padding Y settings"
    },
    {
      "type": "number",
      "id": "pt_mob",
      "label": "Mobile padding top in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pb_mob",
      "label": "Mobile padding bottom in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pt_tab",
      "label": "Tablet padding top in px",
      "default": 40
    },
    {
      "type": "number",
      "id": "pb_tab",
      "label": "Tablet padding bottom in px",
      "default": 40
    },
    {
      "type": "number",
      "id": "pt_desk",
      "label": "Desktop padding top in px",
      "default": 70
    },
    {
      "type": "number",
      "id": "pb_desk",
      "label": "Desktop padding bottom in px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Contact topic",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Topic label",
          "default": "CUSTOMER SERVICE"
        }
      ]
    }
  ]
}
{% endschema %}
