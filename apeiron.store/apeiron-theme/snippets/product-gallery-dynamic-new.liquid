{% liquid
  assign hide_product_media = section.settings.hide_product_media
  assign image_blocks = section.blocks | where: 'type', 'image'
  if show_variant_image
    assign variant_media_list = ''
    for variant in product.variants
      assign variant_media_list = variant_media_list | append: variant.featured_media.id | append: ' '
    endfor
  endif
%}

<div class="lg:top-7.5 lg:sticky">
  {% if color_option_index == blank %}
    <div
      x-ignore
      x-load="idle"
      x-data="splideSlider({ thumb: true })"
      data-slide
    >
      <div
        x-ref="mainSlider"
        class="splide md:-mx-15 group relative -mx-5 mb-5 w-screen overflow-hidden lg:m-0 lg:w-full lg:rounded-[20px]"
        data-splide='{ "arrows": false, "pagination": false, "rewind": true, "startAt": 0, "perPage": 1, "speed": 700, "rewindSpeed": 700, "gap": 0 }'
        style="visibility: visible;"
      >
        <div class="splide__track">
          <ul class="splide__list overflow-initial">
            {% liquid
              assign counter = 1
              assign media_size = 0
              assign media_size_added = false

              for media in product.media
                if media.alt contains 'hidden'
                  continue
                endif

                if variant_media_list contains media.id
                  unless media_size_added
                    assign media_size = media_size | plus: 1
                    assign media_size_added = true
                  endunless
                  continue
                endif
              endfor

              unless hide_product_media
                for media in product.media
                  if media.alt contains 'hidden'
                    continue
                  endif

                  assign media_size = media_size | plus: 1
                endfor
              endunless

              for block in image_blocks
                assign media_size = media_size | plus: 1
              endfor
            %}

            {% if media_size_added %}
              <li class="splide__slide no-select-all bg-c-seabright group relative flex h-0 w-full snap-start scroll-ml-0 list-none flex-col overflow-hidden pb-[100%] lg:pb-[100%]">
                {% for variant in product.variants %}
                  {% if product.selected_or_first_available_variant.id == variant.id %}
                    {% assign variant_image = variant.featured_media | default: product.images[0] %}
                    <div x-show="!selectedVariant">
                      {{
                        variant_image
                        | image_url: width: 760
                        | image_tag:
                          alt: variant_image.alt,
                          class: 'h-full w-full absolute inset-0 object-cover no-select pointer-events-none',
                          widths: '246, 315, 493, 600, 760, 823, 990, 1100, 1200',
                          sizes: '(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px',
                          fetchpriority: 'high',
                          loading: 'eager',
                          preload: true,
                          draggable: false
                      }}

                      {% if top_badge %}
                        <span class="bg-c-white font-third text-c-navy top-4.5 absolute left-5 w-max max-w-full rounded-[30px] border border-[#D5D5D5] px-3.5 py-1.5 text-sm uppercase lg:text-base xl:left-6 xl:top-6 xl:px-4 xl:text-lg">
                          {{- top_badge -}}
                        </span>
                      {% endif %}
                      {% if logos %}
                        <div class="lg:top-7.5 lg:right-7.5 absolute right-3 top-3 grid grid-cols-1 gap-1.5">
                          {% for logo in logos %}
                            <div class="w-15 h-15 smD:h-20 smD:w-20">
                              {{
                                logo
                                | image_url: width: 160
                                | image_tag: alt: logo.alt
                                | default: 'logo',
                                  class: 'w-full h-full object-contain',
                                  loading: 'lazy',
                                  widths: '60, 80, 160',
                                  draggable: false
                              }}
                            </div>
                          {% endfor %}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                  <template x-if="selectedVariant.id === {{ variant.id }}">
                    {% assign variant_image = variant.featured_media | default: product.images[0] %}
                    <div class="">
                      {{
                        variant_image
                        | image_url: width: 760
                        | image_tag:
                          alt: variant_image.alt,
                          class: 'h-full w-full absolute inset-0 object-cover no-select pointer-events-none',
                          widths: '246, 315, 493, 600, 760, 823, 990, 1100, 1200',
                          sizes: '(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px',
                          loading: 'eager',
                          preload: true,
                          draggable: false
                      }}

                      {% if top_badge %}
                        <span class="bg-c-white font-third text-c-navy top-4.5 absolute left-5 w-max max-w-full rounded-[30px] border border-[#D5D5D5] px-3.5 py-1.5 text-sm uppercase lg:text-base xl:left-6 xl:top-6 xl:px-4 xl:text-lg">
                          {{- top_badge -}}
                        </span>
                      {% endif %}
                      {% if logos %}
                        <div class="lg:top-7.5 lg:right-7.5 absolute right-3 top-3 grid grid-cols-1 gap-1.5">
                          {% for logo in logos %}
                            <div class="w-15 h-15 smD:h-20 smD:w-20">
                              {{
                                logo
                                | image_url: width: 160
                                | image_tag: alt: logo.alt
                                | default: 'logo',
                                  class: 'w-full h-full object-contain',
                                  loading: 'lazy',
                                  widths: '60, 80, 160',
                                  draggable: false
                              }}
                            </div>
                          {% endfor %}
                        </div>
                      {% endif %}
                    </div>
                  </template>
                {% endfor %}
              </li>
              {% assign counter = counter | plus: 1 %}
            {% endif %}

            {% unless hide_product_media %}
              {% for media in product.media %}
                {% liquid
                  if media.alt contains 'hidden'
                    continue
                  endif

                  if variant_media_list and variant_media_list contains media.id
                    continue
                  endif

                  if media_size_added
                    assign lazy_load = 'lazy'
                    assign preload = false
                  else
                    assign lazy_load = 'eager'
                    assign preload = true
                  endif

                  if counter > 1
                    assign lazy_load = 'lazy'
                    assign preload = false
                  endif
                %}
                <li class="splide__slide no-select-all bg-c-seabright group relative flex h-0 w-full snap-start scroll-ml-0 list-none flex-col overflow-hidden pb-[100%] lg:pb-[100%]">
                  {% case media.media_type %}
                    {% when 'image' %}
                      {{
                        media
                        | image_url: width: 760
                        | image_tag:
                          alt: media.alt,
                          class: 'h-full w-full absolute inset-0 object-cover no-select pointer-events-none',
                          widths: '246, 315, 493, 600, 760, 823, 990, 1100, 1200',
                          sizes: '(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px',
                          loading: lazy_load,
                          preload: preload,
                          draggable: false
                      }}

                      {% if counter == 1 %}
                        {% if top_badge %}
                          <span class="bg-c-white font-third text-c-navy top-4.5 absolute left-5 w-max max-w-full rounded-[30px] border border-[#D5D5D5] px-3.5 py-1.5 text-sm uppercase lg:text-base xl:left-6 xl:top-6 xl:px-4 xl:text-lg">
                            {{- top_badge -}}
                          </span>
                        {% endif %}
                      {% endif %}
                    {% when 'video' %}
                      <span
                        class="absolute inset-0 overflow-hidden"
                        x-data="videoToggler()"
                        x-intersect:leave="pauseVideo()"
                      >
                        <button
                          type="button"
                          @click.stop="togglePlay()"
                          aria-label="play/pause video"
                          :class="play && 'opacity-0 group-hover:opacity-100'"
                          class="h-15 w-15 bg-c-shadow absolute left-1/2 top-1/2 z-[2] flex -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-white duration-300"
                        >
                          <span x-show="!play" x-cloak>
                            {%- render 'icon', name: 'play-btn', class: 'w-7.5 h-7.5' -%}
                          </span>
                          <span x-show="play" x-cloak>
                            {%- render 'icon', name: 'pause-btn', class: 'w-7.5 h-7.5' -%}
                          </span>
                        </button>

                        <button
                          type="button"
                          @click="toggleVolume()"
                          aria-label="mute/unmute video"
                          class="z-1 bg-c-shadow absolute left-2 top-2 hidden h-7 w-7 items-center justify-center rounded-full md:left-5 md:top-5 md:h-10 md:w-10 lg:flex"
                        >
                          <span class="text-white" x-show="muted">
                            {%- render 'icon', name: 'muted', class: 'w-4 h-4' -%}
                          </span>
                          <span class="text-white" x-show="!muted" x-cloak>
                            {%- render 'icon', name: 'unmuted', class: 'w-3 h-4' -%}
                          </span>
                        </button>

                        {% assign img_poster = none %}
                        {% if media.preview_image != blank %}
                          {% assign img_poster = media.preview_image | image_url: width: 520 %}
                        {% endif %}

                        <span class="block h-full w-full cursor-pointer" @click.stop="togglePlay()">
                          {{
                            media
                            | video_tag:
                              loop: true,
                              controls: false,
                              class: 'h-full w-full object-cover',
                              x-ref: 'video',
                              playsinline: true,
                              poster: img_poster,
                              preload: 'metadata'
                          }}
                        </span>
                      </span>
                  {% endcase %}
                </li>
                {% assign counter = counter | plus: 1 %}
              {% endfor %}
            {% endunless %}

            {% for block in image_blocks %}
              {% liquid
                assign lazy_load = 'eager'
                assign preload = true
                if counter > 1
                  assign lazy_load = 'lazy'
                  assign preload = false
                endif
              %}
              <li class="splide__slide no-select-all bg-c-seabright group relative flex h-0 w-full snap-start scroll-ml-0 list-none flex-col overflow-hidden pb-[100%] lg:pb-[100%]">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 760
                    | image_tag:
                      alt: block.settings.image.alt,
                      class: 'h-full w-full absolute inset-0 object-cover no-select pointer-events-none',
                      widths: '246, 315, 493, 600, 760, 823, 990, 1100, 1200',
                      sizes: '(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px',
                      loading: lazy_load,
                      preload: preload,
                      draggable: false
                  }}

                  {% if counter == 1 %}
                    {% if top_badge %}
                      <span class="bg-c-white font-third text-c-navy top-4.5 absolute left-5 w-max max-w-full rounded-[30px] border border-[#D5D5D5] px-3.5 py-1.5 text-sm uppercase lg:text-base xl:left-6 xl:top-6 xl:px-4 xl:text-lg">
                        {{- top_badge -}}
                      </span>
                    {% endif %}
                  {% endif %}
                {% elsif block.settings.video != blank %}
                  <span
                    class="absolute inset-0 overflow-hidden"
                    x-data="videoToggler()"
                    x-intersect:leave="pauseVideo()"
                  >
                    <button
                      type="button"
                      @click.stop="togglePlay()"
                      aria-label="play/pause video"
                      :class="play && 'opacity-0 group-hover:opacity-100'"
                      class="h-15 w-15 bg-c-shadow absolute left-1/2 top-1/2 z-[2] flex -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-white duration-300"
                    >
                      <span x-show="!play" x-cloak>
                        {%- render 'icon', name: 'play-btn', class: 'w-7.5 h-7.5' -%}
                      </span>
                      <span x-show="play" x-cloak>
                        {%- render 'icon', name: 'pause-btn', class: 'w-7.5 h-7.5' -%}
                      </span>
                    </button>

                    <button
                      type="button"
                      @click="toggleVolume()"
                      aria-label="mute/unmute video"
                      class="z-1 bg-c-shadow absolute left-2 top-2 hidden h-7 w-7 items-center justify-center rounded-full md:left-5 md:top-5 md:h-10 md:w-10 lg:flex"
                    >
                      <span class="text-white" x-show="muted">
                        {%- render 'icon', name: 'muted', class: 'w-4 h-4' -%}
                      </span>
                      <span class="text-white" x-show="!muted" x-cloak>
                        {%- render 'icon', name: 'unmuted', class: 'w-3 h-4' -%}
                      </span>
                    </button>

                    {% assign img_poster = none %}
                    {% if block.settings.video.preview_image != blank %}
                      {% assign img_poster = block.settings.video.preview_image | image_url: width: 520 %}
                    {% endif %}

                    <span class="block h-full w-full cursor-pointer" @click.stop="togglePlay()">
                      {{
                        block.settings.video
                        | video_tag:
                          loop: true,
                          controls: false,
                          class: 'h-full w-full object-cover',
                          x-ref: 'video',
                          playsinline: true,
                          poster: img_poster,
                          preload: 'metadata'
                      }}
                    </span>
                  </span>
                {% endif %}
              </li>
              {% assign counter = counter | plus: 1 %}
            {% endfor %}
          </ul>

          {% if media_size > 1 %}
            <div class="px-7.5 absolute bottom-4 flex w-full justify-center space-x-2 lg:hidden">
              {% assign thumb_counter = 1 %}
              {% for i in (1..media_size) %}
                <button
                  class="bg-c-white border-c-navy h-4 w-4 shrink-0 rounded-full border duration-300 ease-in-out"
                  :class="index === {{ thumb_counter | minus: 1 }} && '!bg-c-navy'"
                  @click="slider.go({{ thumb_counter | minus: 1 }})"
                  aria-label="next slide"
                ></button>
                {% assign thumb_counter = thumb_counter | plus: 1 %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      {% if media_size > 1 %}
        <div
          class="splide px-7.5 smD:px-6 smD:h-[110px] xl:pt-7.5 2k:px-15 hidden h-[70px] items-center {% if media_size > 5 %} justify-between {% else %} justify-center {% endif %} pt-5 lg:flex"
          x-ref="thumbSlider"
          data-splide='{ "arrows": false, "pagination": false, "rewind": true, "startAt": 0, "speed": 700, "rewindSpeed": 700, "fixedWidth": "80px", "fixedHeight": "80px", "gap": 12, "breakpoints": { "1150": { "fixedWidth": "50px", "fixedHeight": "50px", "gap": 8 } } }'
          style="visibility: visible;"
        >
          {% if media_size > 5 %}
            <button
              aria-label="Previous slide"
              @click.debounce.300ms="thumbSlider.go('<')"
              class="z-1 ring-c-blue text-c-white md:h-7.5 md:w-7.5 bg-c-blue flex h-6 w-6 shrink-0 items-center justify-center rounded-full shadow-2xl ring-1 ring-inset duration-200 ease-in-out xl:h-[34px] xl:w-[34px]"
            >
              {% render 'icon', name: 'carousel-arrow', class: 'w-2.5 h-3 xl:h-4 xl:w-3 text-inherit ease-in-out' %}
            </button>
          {% endif %}

          <div class="splide__track smD:max-w-[448px] mx-4 w-full max-w-[282px]">
            <ul class="splide__list overflow-initial {% if media_size <= 5 %} justify-center !-mr-1 smD:!-mr-3 {% endif %}">
              {% assign counter = 1 %}

              {% if media_size_added %}
                <li
                  class="splide__slide w-12.5 h-12.5 no-select-all smD:h-20 smD:w-20 smD:mr-3 relative mr-2 flex shrink-0 snap-start scroll-ml-0 list-none overflow-hidden rounded-lg ring-1 ring-inset ring-transparent transition-shadow"
                  :class="index == {{ counter | minus: 1 }} && '!ring-c-navy'"
                >
                  {% for variant in product.variants %}
                    {% if product.selected_or_first_available_variant.id == variant.id %}
                      {% assign variant_image = variant.featured_media | default: product.images[0] %}
                      <button
                        x-show="!selectedVariant"
                        aria-label="Slide to slide - {{ variant_image.alt }}"
                        @click="thumbSlider.go({{ counter | minus: 1 }})"
                        class="absolute inset-0 h-full w-full"
                      >
                        {{
                          variant_image
                          | image_url: width: 280
                          | image_tag:
                            alt: variant_image.alt,
                            class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                            widths: '44, 88, 140, 280'
                        }}
                      </button>
                    {% endif %}
                    <template x-if="selectedVariant.id === {{ variant.id }}">
                      {% assign variant_image = variant.featured_media | default: product.images[0] %}
                      <button
                        aria-label="Slide to slide - {{ variant_image.alt }}"
                        @click="thumbSlider.go({{ counter | minus: 1 }})"
                        class="absolute inset-0 h-full w-full"
                      >
                        {{
                          variant_image
                          | image_url: width: 280
                          | image_tag:
                            alt: variant_image.alt,
                            class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                            widths: '44, 88, 140, 280'
                        }}
                      </button>
                    </template>
                  {% endfor %}
                </li>
                {% assign counter = counter | plus: 1 %}
              {% endif %}

              {% unless hide_product_media %}
                {% for media in product.media %}
                  {% liquid
                    assign media_alt = media.alt | split: '||' | last | strip
                    if media.alt contains 'hidden'
                      continue
                    endif
                    if variant_media_list and variant_media_list contains media.id
                      continue
                    endif
                    if media_alt != value and media.alt contains '||'
                      continue
                    endif
                  %}
                  <li
                    class="splide__slide w-12.5 h-12.5 no-select-all smD:h-20 smD:w-20 smD:mr-3 relative mr-2 flex shrink-0 snap-start scroll-ml-0 list-none overflow-hidden rounded-lg ring-1 ring-inset ring-transparent transition-shadow"
                    :class="index == {{ counter | minus: 1 }} && '!ring-c-navy'"
                  >
                    <button
                      aria-label="Slide to slide - {{ media.alt }}"
                      @click="thumbSlider.go({{ counter | minus: 1 }})"
                      class="absolute inset-0 h-full w-full"
                    >
                      {% case media.media_type %}
                        {% when 'image' %}
                          {{
                            media
                            | image_url: width: 280
                            | image_tag:
                              alt: media.alt,
                              class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                              widths: '44, 88, 140, 280'
                          }}
                        {% when 'video' %}
                          {{
                            media.preview_image
                            | image_url: width: 280
                            | image_tag:
                              alt: media.preview_image.alt,
                              class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                              widths: '44, 88, 140, 280'
                          }}
                      {% endcase %}
                    </button>
                  </li>
                  {% assign counter = counter | plus: 1 %}
                {% endfor %}
              {% endunless %}

              {% for block in image_blocks %}
                {% liquid
                  unless hide_product_media
                    assign lazy_load = false
                  endunless
                  if counter > 5
                    assign lazy_load = 'lazy'
                  endif
                  assign b_image = false
                  if block.settings.image != blank
                    assign b_image = block.settings.image
                  elsif block.settings.video != blank
                    assign b_image = block.settings.video.preview_image
                  endif
                %}
                <li
                  class="splide__slide w-12.5 h-12.5 no-select-all smD:h-20 smD:w-20 smD:mr-3 relative mr-2 flex shrink-0 snap-start scroll-ml-0 list-none overflow-hidden rounded-lg ring-1 ring-inset ring-transparent transition-shadow"
                  :class="index == {{ counter | minus: 1 }} && '!ring-c-navy'"
                >
                  <button
                    aria-label="Slide to slide - {{ b_image.alt }}"
                    @click="thumbSlider.go({{ counter | minus: 1 }})"
                    class="absolute inset-0 h-full w-full"
                  >
                    {% if b_image != blank %}
                      {{
                        b_image
                        | image_url: width: 280
                        | image_tag:
                          alt: b_image.alt,
                          class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                          widths: '44, 88, 140, 280'
                      }}
                    {% endif %}
                  </button>
                </li>
                {% assign counter = counter | plus: 1 %}
              {% endfor %}
            </ul>
          </div>

          {% if media_size > 5 %}
            <button
              aria-label="Next slide"
              @click.debounce.300ms="thumbSlider.go('>')"
              class="z-1 ring-c-blue text-c-white md:h-7.5 md:w-7.5 bg-c-blue flex h-6 w-6 shrink-0 items-center justify-center rounded-full shadow-2xl ring-1 ring-inset duration-200 ease-in-out xl:h-[34px] xl:w-[34px]"
            >
              {% render 'icon',
                name: 'carousel-arrow',
                class: 'w-2.5 h-3 xl:h-4 xl:w-3 text-inherit rotate-180 ease-in-out'
              %}
            </button>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% else %}
    {% for option in product.options_with_values %}
      {% for value in option.values %}
        {% if value.swatch.color or all_metaobject_color_swathes contains value %}
          {% liquid
            assign media_size = 0
            assign media_size_added = false

            for media in product.media
              if media.alt contains 'hidden'
                continue
              endif

              if variant_media_list contains media.id
                unless media_size_added
                  assign media_size = media_size | plus: 1
                  assign media_size_added = true
                endunless
                continue
              endif
            endfor

            unless hide_product_media
              for media in product.media
                assign media_alt = media.alt | split: '||' | last | strip
                if media.alt contains 'hidden'
                  continue
                endif

                if media_alt != value and media.alt contains '||'
                  continue
                endif

                assign media_size = media_size | plus: 1
              endfor
            endunless

            for block in image_blocks
              assign media_size = media_size | plus: 1
            endfor

            if media_size == 0
              continue
            endif
          %}

          <div
            {% unless product.selected_or_first_available_variant.options[color_option_index] == value %}
              x-cloak
            {% endunless %}
            x-show="selectedVariant.options[{{- color_option_index -}}] === '{{ value }}'"
          >
            <div
              x-ignore
              x-load="visible"
              x-data="splideSlider({ thumb: true })"
              :data-slider="selectedVariant.options[{{- color_option_index -}}] === '{{ value }}'"
            >
              <div
                x-ref="mainSlider"
                class="splide md:-mx-15 group relative -mx-5 mb-5 w-screen overflow-hidden lg:m-0 lg:w-full lg:rounded-[20px]"
                data-splide='{ "arrows": false, "pagination": false, "rewind": true, "startAt": 0, "perPage": 1, "speed": 700, "rewindSpeed": 700, "gap": 0 }'
                style="visibility: visible;"
              >
                <div class="splide__track">
                  <ul class="splide__list overflow-initial">
                    {% assign counter = 1 %}

                    {% if media_size_added %}
                      <li
                        class="splide__slide no-select-all bg-c-seabright group relative flex h-0 w-full snap-start scroll-ml-0 list-none flex-col overflow-hidden pb-[100%] lg:pb-[100%]"
                      >
                        {% for variant in product.variants %}
                          {% if product.selected_or_first_available_variant.id == variant.id %}
                            {% assign variant_image = variant.featured_media | default: product.images[0] %}
                            <div x-show="!selectedVariant">
                              {{
                                variant_image
                                | image_url: width: 760
                                | image_tag:
                                  alt: variant_image.alt,
                                  class: 'h-full w-full absolute inset-0 object-cover no-select pointer-events-none',
                                  widths: '246, 315, 493, 600, 760, 823, 990, 1100, 1200',
                                  sizes: '(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px',
                                  fetchpriority: 'high',
                                  loading: 'eager',
                                  preload: true,
                                  draggable: false
                              }}

                              {% if top_badge %}
                                <span class="bg-c-white font-third text-c-navy top-4.5 absolute left-5 w-max max-w-full rounded-[30px] border border-[#D5D5D5] px-3.5 py-1.5 text-sm uppercase lg:text-base xl:left-6 xl:top-6 xl:px-4 xl:text-lg">
                                  {{- top_badge -}}
                                </span>
                              {% endif %}
                              {% if logos %}
                                <div class="lg:top-7.5 lg:right-7.5 absolute right-3 top-3 grid grid-cols-1 gap-1.5">
                                  {% for logo in logos %}
                                    <div class="w-15 h-15 smD:h-20 smD:w-20">
                                      {{
                                        logo
                                        | image_url: width: 160
                                        | image_tag: alt: logo.alt
                                        | default: 'logo',
                                          class: 'w-full h-full object-contain',
                                          loading: 'lazy',
                                          widths: '60, 80, 160',
                                          draggable: false
                                      }}
                                    </div>
                                  {% endfor %}
                                </div>
                              {% endif %}
                            </div>
                          {% endif %}
                          <template x-if="selectedVariant.id === {{ variant.id }}">
                            {% assign variant_image = variant.featured_media | default: product.images[0] %}
                            <div class="">
                              {{
                                variant_image
                                | image_url: width: 760
                                | image_tag:
                                  alt: variant_image.alt,
                                  class: 'h-full w-full absolute inset-0 object-cover no-select pointer-events-none',
                                  widths: '246, 315, 493, 600, 760, 823, 990, 1100, 1200',
                                  sizes: '(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px',
                                  fetchpriority: 'high',
                                  loading: 'eager',
                                  preload: true,
                                  draggable: false
                              }}

                              {% if top_badge %}
                                <span class="bg-c-white font-third text-c-navy top-4.5 absolute left-5 w-max max-w-full rounded-[30px] border border-[#D5D5D5] px-3.5 py-1.5 text-sm uppercase lg:text-base xl:left-6 xl:top-6 xl:px-4 xl:text-lg">
                                  {{- top_badge -}}
                                </span>
                              {% endif %}
                              {% if logos %}
                                <div class="lg:top-7.5 lg:right-7.5 absolute right-3 top-3 grid grid-cols-1 gap-1.5">
                                  {% for logo in logos %}
                                    <div class="w-15 h-15 smD:h-20 smD:w-20">
                                      {{
                                        logo
                                        | image_url: width: 160
                                        | image_tag: alt: logo.alt
                                        | default: 'logo',
                                          class: 'w-full h-full object-contain',
                                          loading: 'lazy',
                                          widths: '60, 80, 160',
                                          draggable: false
                                      }}
                                    </div>
                                  {% endfor %}
                                </div>
                              {% endif %}
                            </div>
                          </template>
                        {% endfor %}
                      </li>
                      {% assign counter = counter | plus: 1 %}
                    {% endif %}

                    {% unless hide_product_media %}
                      {% for media in product.media %}
                        {% liquid
                          assign media_alt = media.alt | split: '||' | last | strip
                          if media.alt contains 'hidden'
                            continue
                          endif
                          if variant_media_list and variant_media_list contains media.id
                            continue
                          endif
                          if media_alt != value and media.alt contains '||'
                            continue
                          endif

                          if media_size_added
                            assign lazy_load = 'lazy'
                            assign preload = false
                          else
                            assign lazy_load = 'eager'
                            assign preload = true
                          endif

                          if counter > 1
                            assign lazy_load = 'lazy'
                            assign preload = false
                          endif
                        %}
                        <li class="splide__slide no-select-all bg-c-seabright group relative flex h-0 w-full snap-start scroll-ml-0 list-none flex-col overflow-hidden pb-[100%] lg:pb-[100%]">
                          {% case media.media_type %}
                            {% when 'image' %}
                              {{
                                media
                                | image_url: width: 760
                                | image_tag:
                                  alt: media.alt,
                                  class: 'h-full w-full absolute inset-0 object-cover no-select pointer-events-none',
                                  widths: '246, 315, 493, 600, 760, 823, 990, 1100, 1200',
                                  sizes: '(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px',
                                  loading: lazy_load,
                                  preload: preload,
                                  draggable: false
                              }}

                              {% if counter == 1 %}
                                {% if top_badge %}
                                  <span class="bg-c-white font-third text-c-navy top-4.5 absolute left-5 w-max max-w-full rounded-[30px] border border-[#D5D5D5] px-3.5 py-1.5 text-sm uppercase lg:text-base xl:left-6 xl:top-6 xl:px-4 xl:text-lg">
                                    {{- top_badge -}}
                                  </span>
                                {% endif %}
                              {% endif %}
                            {% when 'video' %}
                              <span
                                class="absolute inset-0 overflow-hidden"
                                x-data="videoToggler()"
                                x-intersect:leave="pauseVideo()"
                              >
                                <button
                                  type="button"
                                  @click.stop="togglePlay()"
                                  aria-label="play/pause video"
                                  :class="play && 'opacity-0 group-hover:opacity-100'"
                                  class="h-15 w-15 absolute left-1/2 top-1/2 z-[2] flex -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-[#DDBFC2] text-white duration-300"
                                >
                                  <span x-show="!play" x-cloak>
                                    {%- render 'icon', name: 'play-btn', class: 'w-7.5 h-7.5' -%}
                                  </span>
                                  <span x-show="play" x-cloak>
                                    {%- render 'icon', name: 'pause-btn', class: 'w-7.5 h-7.5' -%}
                                  </span>
                                </button>

                                <button
                                  type="button"
                                  @click="toggleVolume()"
                                  aria-label="mute/unmute video"
                                  class="z-1 bg-c-shadow absolute left-2 top-2 hidden h-7 w-7 items-center justify-center rounded-full md:left-5 md:top-5 md:h-10 md:w-10 lg:flex"
                                >
                                  <span class="text-white" x-show="muted">
                                    {%- render 'icon', name: 'muted', class: 'w-4 h-4' -%}
                                  </span>
                                  <span class="text-white" x-show="!muted" x-cloak>
                                    {%- render 'icon', name: 'unmuted', class: 'w-3 h-4' -%}
                                  </span>
                                </button>

                                {% assign img_poster = none %}
                                {% if media.preview_image != blank %}
                                  {% assign img_poster = media.preview_image | image_url: width: 520 %}
                                {% endif %}

                                <span class="block h-full w-full cursor-pointer" @click.stop="togglePlay()">
                                  {{
                                    media
                                    | video_tag:
                                      loop: true,
                                      controls: false,
                                      class: 'h-full w-full object-cover',
                                      x-ref: 'video',
                                      playsinline: true,
                                      poster: img_poster,
                                      preload: 'metadata'
                                  }}
                                </span>
                              </span>
                          {% endcase %}
                        </li>
                        {% assign counter = counter | plus: 1 %}
                      {% endfor %}
                    {% endunless %}

                    {% for block in image_blocks %}
                      {% liquid
                        assign lazy_load = 'eager'
                        assign preload = true

                        if counter > 1
                          assign lazy_load = 'lazy'
                          assign preload = false
                        endif
                      %}
                      <li class="splide__slide no-select-all bg-c-seabright group relative flex h-0 w-full snap-start scroll-ml-0 list-none flex-col overflow-hidden pb-[100%] lg:pb-[100%]">
                        {% if block.settings.image != blank %}
                          {{
                            block.settings.image
                            | image_url: width: 760
                            | image_tag:
                              alt: block.settings.image.alt,
                              class: 'h-full w-full absolute inset-0 object-cover no-select pointer-events-none',
                              widths: '246, 315, 493, 600, 760, 823, 990, 1100, 1200',
                              sizes: '(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px',
                              loading: lazy_load,
                              preload: preload,
                              draggable: false
                          }}

                          {% if counter == 1 %}
                            {% if top_badge %}
                              <span class="bg-c-white font-third text-c-navy top-4.5 absolute left-5 w-max max-w-full rounded-[30px] border border-[#D5D5D5] px-3.5 py-1.5 text-sm uppercase lg:text-base xl:left-6 xl:top-6 xl:px-4 xl:text-lg">
                                {{- top_badge -}}
                              </span>
                            {% endif %}
                          {% endif %}
                        {% elsif block.settings.video != blank %}
                          <span
                            class="absolute inset-0 overflow-hidden"
                            x-data="videoToggler()"
                            x-intersect:leave="pauseVideo()"
                          >
                            <button
                              type="button"
                              @click.stop="togglePlay()"
                              aria-label="play/pause video"
                              :class="play && 'opacity-0 group-hover:opacity-100'"
                              class="h-15 w-15 bg-c-shadow absolute left-1/2 top-1/2 z-[2] flex -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-white duration-300"
                            >
                              <span x-show="!play" x-cloak>
                                {%- render 'icon', name: 'play-btn', class: 'w-7.5 h-7.5' -%}
                              </span>
                              <span x-show="play" x-cloak>
                                {%- render 'icon', name: 'pause-btn', class: 'w-7.5 h-7.5' -%}
                              </span>
                            </button>

                            <button
                              type="button"
                              @click="toggleVolume()"
                              aria-label="mute/unmute video"
                              class="z-1 bg-c-shadow absolute left-2 top-2 hidden h-7 w-7 items-center justify-center rounded-full md:left-5 md:top-5 md:h-10 md:w-10 lg:flex"
                            >
                              <span class="text-white" x-show="muted">
                                {%- render 'icon', name: 'muted', class: 'w-4 h-4' -%}
                              </span>
                              <span class="text-white" x-show="!muted" x-cloak>
                                {%- render 'icon', name: 'unmuted', class: 'w-3 h-4' -%}
                              </span>
                            </button>

                            {% assign img_poster = none %}
                            {% if block.settings.video.preview_image != blank %}
                              {% assign img_poster = block.settings.video.preview_image | image_url: width: 520 %}
                            {% endif %}

                            <span class="block h-full w-full cursor-pointer" @click.stop="togglePlay()">
                              {{
                                block.settings.video
                                | video_tag:
                                  loop: true,
                                  controls: false,
                                  class: 'h-full w-full object-cover',
                                  x-ref: 'video',
                                  playsinline: true,
                                  poster: img_poster,
                                  preload: 'metadata'
                              }}
                            </span>
                          </span>
                        {% endif %}
                      </li>
                      {% assign counter = counter | plus: 1 %}
                    {% endfor %}
                  </ul>

                  {% if media_size > 1 %}
                    <div class="px-7.5 absolute bottom-4 flex w-full justify-center space-x-2 lg:hidden">
                      {% assign thumb_counter = 1 %}
                      {% for i in (1..media_size) %}
                        <button
                          class="bg-c-white border-c-navy h-4 w-4 shrink-0 rounded-full border duration-300 ease-in-out"
                          :class="index === {{ thumb_counter | minus: 1 }} && '!bg-c-navy'"
                          @click="slider.go({{ thumb_counter | minus: 1 }})"
                          aria-label="next slide"
                        ></button>
                        {% assign thumb_counter = thumb_counter | plus: 1 %}
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              </div>

              {% if media_size > 1 %}
                <div
                  class="splide px-7.5 smD:px-6 smD:h-[110px] xl:pt-7.5 2k:px-15 hidden h-[70px] items-center {% if media_size > 5 %} justify-between {% else %} justify-center {% endif %} pt-5 lg:flex"
                  x-ref="thumbSlider"
                  data-splide='{ "arrows": false, "pagination": false, "rewind": true, "startAt": 0, "speed": 700, "rewindSpeed": 700, "fixedWidth": "80px", "fixedHeight": "80px", "gap": 12, "breakpoints": { "1150": { "fixedWidth": "50px", "fixedHeight": "50px", "gap": 8 } } }'
                  style="visibility: visible;"
                >
                  {% if media_size > 5 %}
                    <button
                      aria-label="Previous slide"
                      @click.debounce.300ms="thumbSlider.go('<')"
                      class="z-1 ring-c-blue text-c-white md:h-7.5 md:w-7.5 bg-c-blue flex h-6 w-6 shrink-0 items-center justify-center rounded-full shadow-2xl ring-1 ring-inset duration-200 ease-in-out xl:h-[34px] xl:w-[34px]"
                    >
                      {% render 'icon',
                        name: 'carousel-arrow',
                        class: 'w-2.5 h-3 xl:h-4 xl:w-3 text-inherit ease-in-out'
                      %}
                    </button>
                  {% endif %}

                  <div class="splide__track smD:max-w-[448px] mx-4 w-full max-w-[282px]">
                    <ul class="splide__list overflow-initial {% if media_size <= 5 %} justify-center !-mr-2 smD:!-mr-3 {% endif %}">
                      {% assign counter = 1 %}

                      {% if media_size_added %}
                        <li
                          class="splide__slide w-12.5 h-12.5 no-select-all smD:h-20 smD:w-20 smD:mr-3 relative mr-2 flex shrink-0 snap-start scroll-ml-0 list-none overflow-hidden rounded-lg ring-1 ring-inset ring-transparent transition-shadow"
                          :class="index == {{ counter | minus: 1 }} && '!ring-c-navy'"
                        >
                          {% for variant in product.variants %}
                            {% if product.selected_or_first_available_variant.id == variant.id %}
                              {% assign variant_image = variant.featured_media | default: product.images[0] %}
                              <button
                                x-show="!selectedVariant"
                                aria-label="Slide to slide - {{ variant_image.alt }}"
                                @click="thumbSlider.go({{ counter | minus: 1 }})"
                                class="absolute inset-0 h-full w-full"
                              >
                                {{
                                  variant_image
                                  | image_url: width: 280
                                  | image_tag:
                                    alt: variant_image.alt,
                                    class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                                    widths: '44, 88, 140, 280'
                                }}
                              </button>
                            {% endif %}
                            <template x-if="selectedVariant.id === {{ variant.id }}">
                              {% assign variant_image = variant.featured_media | default: product.images[0] %}
                              <button
                                aria-label="Slide to slide - {{ variant_image.alt }}"
                                @click="thumbSlider.go({{ counter | minus: 1 }})"
                                class="absolute inset-0 h-full w-full"
                              >
                                {{
                                  variant_image
                                  | image_url: width: 280
                                  | image_tag:
                                    alt: variant_image.alt,
                                    class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                                    widths: '44, 88, 140, 280'
                                }}
                              </button>
                            </template>
                          {% endfor %}
                        </li>
                        {% assign counter = counter | plus: 1 %}
                      {% endif %}

                      {% unless hide_product_media %}
                        {% for media in product.media %}
                          {% liquid
                            assign media_alt = media.alt | split: '||' | last | strip
                            if media.alt contains 'hidden'
                              continue
                            endif
                            if variant_media_list and variant_media_list contains media.id
                              continue
                            endif
                            if media_alt != value and media.alt contains '||'
                              continue
                            endif
                          %}
                          <li
                            class="splide__slide w-12.5 h-12.5 no-select-all smD:h-20 smD:w-20 smD:mr-3 relative mr-2 flex shrink-0 snap-start scroll-ml-0 list-none overflow-hidden rounded-lg ring-1 ring-inset ring-transparent transition-shadow"
                            :class="index == {{ counter | minus: 1 }} && '!ring-c-navy'"
                          >
                            <button
                              aria-label="Slide to slide - {{ media.alt }}"
                              @click="thumbSlider.go({{ counter | minus: 1 }})"
                              class="absolute inset-0 h-full w-full"
                            >
                              {% case media.media_type %}
                                {% when 'image' %}
                                  {{
                                    media
                                    | image_url: width: 280
                                    | image_tag:
                                      alt: media.alt,
                                      class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                                      widths: '44, 88, 140, 280'
                                  }}
                                {% when 'video' %}
                                  {{
                                    media.preview_image
                                    | image_url: width: 280
                                    | image_tag:
                                      alt: media.preview_image.alt,
                                      class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                                      widths: '44, 88, 140, 280'
                                  }}
                              {% endcase %}
                            </button>
                          </li>
                          {% assign counter = counter | plus: 1 %}
                        {% endfor %}
                      {% endunless %}

                      {% for block in image_blocks %}
                        {% liquid
                          unless hide_product_media
                            assign lazy_load = false
                          endunless
                          if counter > 5
                            assign lazy_load = 'lazy'
                          endif
                          assign b_image = false
                          if block.settings.image != blank
                            assign b_image = block.settings.image
                          elsif block.settings.video != blank
                            assign b_image = block.settings.video.preview_image
                          endif
                        %}
                        <li
                          class="splide__slide w-12.5 h-12.5 no-select-all smD:h-20 smD:w-20 smD:mr-3 relative mr-2 flex shrink-0 snap-start scroll-ml-0 list-none overflow-hidden rounded-lg ring-1 ring-inset ring-transparent transition-shadow"
                          :class="index == {{ counter | minus: 1 }} && '!ring-c-navy'"
                        >
                          <button
                            aria-label="Slide to slide - {{ b_image.alt }}"
                            @click="thumbSlider.go({{ counter | minus: 1 }})"
                            class="absolute inset-0 h-full w-full"
                          >
                            {% if b_image != blank %}
                              {{
                                b_image
                                | image_url: width: 280
                                | image_tag:
                                  alt: b_image.alt,
                                  class: 'h-full w-full object-cover relative no-select pointer-events-none -z-1',
                                  widths: '44, 88, 140, 280'
                              }}
                            {% endif %}
                          </button>
                        </li>
                        {% assign counter = counter | plus: 1 %}
                      {% endfor %}
                    </ul>
                  </div>

                  {% if media_size > 5 %}
                    <button
                      aria-label="Next slide"
                      @click.debounce.300ms="thumbSlider.go('>')"
                      class="z-1 ring-c-blue text-c-white md:h-7.5 md:w-7.5 bg-c-blue flex h-6 w-6 shrink-0 items-center justify-center rounded-full shadow-2xl ring-1 ring-inset duration-200 ease-in-out xl:h-[34px] xl:w-[34px]"
                    >
                      {% render 'icon',
                        name: 'carousel-arrow',
                        class: 'w-2.5 h-3 xl:h-4 xl:w-3 text-inherit rotate-180 ease-in-out'
                      %}
                    </button>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endif %}
</div>
