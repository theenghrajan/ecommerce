{%- comment -%} FAQs from article metafield custom.ss_faqs (list of ss_article_faqs metaobjects: question, answer) + FAQPage schema {%- endcomment -%}
{%- assign faqs = article.metafields.custom.ss_faqs.value -%}
{%- if faqs != blank -%}
  <div class="ss-article-faqs mt-10">
    <h2 class="text-sc-title mb-5 text-3xl font-semibold">Frequently Asked Questions</h2>
    <div class="border-c-border lg:space-y-7.5 space-y-5 border-t pt-5" x-data="{active: 0}">
      {%- for faq in faqs -%}
        {%- assign answer = faq.answer | metafield_tag -%}
        {% render 'faq-block',
          question: faq.question,
          answer: answer,
          active: forloop.index0,
          class: 'pb-5 border-b border-c-border lg:pb-7.5 last:border-none'
        %}
      {%- endfor -%}
    </div>
  </div>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq in faqs -%}
        {
          "@type": "Question",
          "name": {{ faq.question.value | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | metafield_text | json }} }
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
