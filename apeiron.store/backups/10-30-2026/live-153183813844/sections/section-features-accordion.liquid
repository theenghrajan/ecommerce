{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign title = section.settings.title
  assign description = section.settings.description
  assign image = section.settings.image
  assign layout = section.settings.layout

  assign btn_url = section.settings.btn_url
  assign btn_text = section.settings.btn_text
  assign btn_type = section.settings.btn_type

  assign blocks = section.blocks

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk

  assign animation = 'animate__animated opacity-0'
  case section.index0
    when 1
      assign loading = 'eager'
      assign preload = true
      assign animation = ''
    when 2
      assign loading = 'eager'
      assign preload = false
    else
      assign loading = 'lazy'
      assign preload = false
  endcase
%}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary"
>
  <div class="xl:gap-15 container flex flex-col md:flex-row lg:grid lg:grid-cols-2 lg:gap-10">
    <div class="md:mr-7.5 image-overflow-hidden mb-5 h-auto w-full shrink-0 rounded-lg md:mb-0 md:min-h-[500px] md:max-w-[307px] lg:m-0 lg:max-w-none">
      {% if image != blank %}
        {{
          image
          | image_url: width: 680
          | image_tag:
            alt: image.alt,
            loading: loading,
            preload: preload,
            class: 'w-full h-full object-cover rounded',
            widths: '340, 680',
            draggable: false
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover rounded' }}
      {% endif %}
    </div>

    <div class="xl:p-7.5 {% if layout == 'rtl' -%} lg:-order-1 {%- endif -%}">
      {% if title != blank %}
        <h2
          class="text-sc-title mb-3 text-3xl font-semibold lg:mb-4 lg:text-4xl xl:text-5xl {{ animation -}}"
          {% if animation %}
            x-intersect.once="$el.classList.add('animate__fadeIn')"
          {% endif %}
        >
          {{- title -}}
        </h2>
      {% endif %}

      {% if description != blank %}
        <div
          class="rte text-sc-body-primary text-base xl:text-lg {{ animation -}}"
          {% if animation %}
            x-intersect.once="$el.classList.add('animate__fadeIn')"
          {% endif %}
        >
          {{- description -}}
        </div>
      {% endif %}

      {% if blocks.size > 0 %}
        <div
          class="flex w-full flex-col space-y-3 lg:space-y-4 {% if title != blank or description != blank -%} mt-5 lg:mt-10 {%- endif -%}"
          x-data="{ active: 1 }"
        >
          {% for block in blocks %}
            {% liquid
              assign b_title = block.settings.title
              assign b_subtitle = block.settings.subtitle
              assign b_description = block.settings.description

              if b_title == blank
                continue
              endif
            %}
            <div
              class="{% unless forloop.last %} pb-3 border-b lg:pb-4 border-c-border {% endunless %} {{ animation -}}"
              {% if animation %}
                style="animation-delay: {{ forloop.index | times: 100 | append: 'ms' }}"
                x-intersect.once="$el.classList.add('animate__fadeIn')"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <button
                @click="active === {{ forloop.index }} ? active = null : active = {{ forloop.index }}"
                type="button"
                class="no-select flex w-full flex-col space-y-2 text-left"
                aria-controls="{{ forloop.index | append: block.id | prepend: 'content-' }}"
                aria-label="{{ b_title }}"
              >
                <span class="flex w-full items-center justify-between space-x-3">
                  <span class="text-sc-body-primary text-xl font-semibold lg:text-2xl xl:text-3xl">
                    {{- b_title -}}
                  </span>

                  {% render 'icon',
                    name: 'accordion-icon',
                    class: 'shrink-0 duration-200 w-6 h-6 ease-in-out text-sc-title',
                    active: forloop.index
                  %}
                </span>

                {% if b_subtitle != blank %}
                  <span class="font-third text-sc-title text-base lg:text-lg">{{- b_subtitle -}}</span>
                {% endif %}
              </button>

              <div
                x-cloak
                x-collapse
                x-show="active === {{ forloop.index }}"
                :aria-hidden="active !== {{ forloop.index }}"
                id="{{ forloop.index | append: block.id | prepend: 'content-' }}"
              >
                <div class="rte text-sc-body-primary pt-2 text-base xl:text-xl">{{- b_description -}}</div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if btn_text != blank %}
        <a
          href="{{ btn_url }}"
          class="{% render 'btn-class', btn: btn_type %} group mt-5 w-max max-w-full lg:mt-10 {{ animation }}"
          aria-label="{{ btn_text }}"
          {% if animation %}
            style="animation-delay: {{ blocks.size | times: 100 | append: 'ms' }}"
            x-intersect.once="$el.classList.add('animate__fadeIn')"
          {% endif %}
        >
          <span>
            {{- btn_text -}}
          </span>
          {% render 'icon',
            name: 'btn-arrow',
            class: 'transition-transform w-5 duration-200 ease-in-out group-hover:translate-x-1.5'
          %}
        </a>
      {% endif %}
    </div>
  </div>
</div>

