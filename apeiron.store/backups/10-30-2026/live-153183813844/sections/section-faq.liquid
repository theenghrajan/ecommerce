{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign title = section.settings.title
  assign description = section.settings.description

  assign btn_url = section.settings.btn_url
  assign btn_text = section.settings.btn_text
  assign btn_type = section.settings.btn_type

  assign blocks = section.blocks

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  assign animation = 'animate__animated opacity-0'
  if section.index0 == 0 or section.index0 == 1
    assign animation = ''
  endif

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary"
>
  <div
    class="space-y-7.5 container lg:flex lg:space-y-0 {{ animation }}"
    {% if animation %}
      x-intersect.once="$el.classList.add('animate__fadeIn')"
    {% endif %}
  >
    {% if title != blank or description != blank or btn_text != blank %}
      <div class="border-c-border lg:pr-15 w-full lg:mb-0 lg:mr-10 lg:max-w-[530px] lg:border-r">
        {% if title != blank %}
          <h2 class="rte text-sc-title mb-5 text-3xl font-semibold lg:text-5xl">
            {{- title -}}
          </h2>
        {% endif %}

        {% if description != blank %}
          <div class="rte text-sc-body-primary mt-2.5 text-lg lg:text-xl">{{- description -}}</div>
        {% endif %}

        {% if btn_text != blank %}
          <a
            href="{{ btn_url }}"
            class="{% render 'btn-class', btn: btn_type %} mt-5 w-max max-w-full lg:mt-10 {{ animation -}}"
            aria-label="{{ btn_text }}"
            {% if animation %}
              x-intersect.once="$el.classList.add('animate__fadeIn')"
            {% endif %}
          >
            {{- btn_text -}}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if blocks.size > 0 %}
      <div
        class="border-c-border lg:space-y-7.5 w-full space-y-5 border-t pt-5 lg:border-none lg:p-0"
        x-data="{active: 0}"
      >
        {% for block in blocks %}
          {% liquid
            assign b_title = block.settings.title
            assign b_text = block.settings.text
          %}

          {% render 'faq-block',
            block: block,
            question: b_title,
            answer: b_text,
            active: forloop.index0,
            class: 'pb-5 border-b border-c-border lg:pb-7.5 last:border-none'
          %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script type="application/ld+json">
    {
      "@context":"https://schema.org",
      "@type":"FAQPage",
      "mainEntity":[
      {% for block in blocks -%}
      {%- liquid
        assign title = block.settings.title
        assign text = block.settings.text
      -%}
      {
        "@type":"Question",
        "name":"{{- title | escape -}}",
        "acceptedAnswer":{
          "@type":"Answer",
          "text":"{{- text | escape -}}"
        }
      }{%- unless forloop.last -%},{%- endunless %}
    {% endfor %}
    ]
  }
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section anchor id",
