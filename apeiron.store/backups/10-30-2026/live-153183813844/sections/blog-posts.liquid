{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign headline = section.settings.headline
  assign description = section.settings.description
  assign mob_alignment = section.settings.mob_alignment | prepend: 'text-'
  assign desk_alignment = section.settings.alignment | prepend: 'lg:text-'
  assign alignment = mob_alignment | append: ' ' | append: desk_alignment

  assign autoplay = section.settings.autoplay | times: 1000
  assign pagination_style = section.settings.pagination_style

  assign blog = section.settings.blog
  assign main_article = article
  unless blog != blank
    assign article_blog_handle = main_article.handle | split: '/' | first
    assign blog = blogs[article_blog_handle]
  endunless

  assign limit = section.settings.limit

  assign animation = 'animate__animated opacity-0'
  if section.index0 == 0 or section.index0 == 1
    assign animation = ''
  endif

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary overflow-hidden {{ alignment -}}"
>
  <div class="container">
    {% if headline != blank %}
      <h2
        class="text-sc-title mb-3 text-3xl font-semibold lg:mb-4 lg:text-5xl {{ animation -}}"
        {% if animation %}
          x-intersect.once="$el.classList.add('animate__fadeIn')"
        {% endif %}
      >
        {{- headline -}}
      </h2>
    {% endif %}

    {% if description != blank %}
      <div
        class="rte text-sc-body-primary text-base lg:text-lg {{ animation -}}"
        {% if animation %}
          style="animation-delay: 100ms"
          x-intersect.once="$el.classList.add('animate__fadeIn')"
        {% endif %}
      >
        {{- description -}}
      </div>
    {% endif %}

    <div
      class="splide {% if headline != blank or description != blank -%} mt-5 lg:mt-10 {%- endif %} {{ animation -}}"
      x-ignore
      x-load="visible (300px 300px 300px 300px)"
      x-data="splideSlider()"
      data-splide='{ {%- if autoplay > 0 -%}"autoplay": true, "interval": {{ autoplay -}},{%- endif %} "arrows": false, "pagination": false, "rewind": true, "startAt": 0, "perPage": 3, "speed": 500, "gap": 30, "breakpoints": { "1279": { "perPage": 2, "gap": 30 }, "820": { "perPage": 1, "gap": 30 }, "370": { "fixedWidth": "240px", "gap": 20 } } }'
      {% if animation %}
        style="animation-delay: 200ms"
        x-intersect.once="$el.classList.add('animate__fadeIn')"
      {% endif %}
    >
      <div class="splide__track overflow-visible">
        <ul class="splide__list">
          {% assign counter = 0 %}
          {%- for article in blog.articles -%}
            {% if counter == limit %}
              {% break %}
            {% endif %}
            {% unless article.handle == main_article.handle %}
              <li class="splide__slide group relative flex flex-col h-auto overflow-hidden text-left">
                {%- render 'blog-post-card', article: article, show_date: true, show_excerpt: true, blog: blog -%}
              </li>
              {% assign counter = counter | plus: 1 %}
            {% endunless %}
          {% endfor %}
        </ul>
      </div>

      {% if counter > 1 %}
        <div
          class="md:mt-7.5 mt-5 flex lg:hidden"
          data-pagination-bar-inner
        >
          {% render 'splide-pagination', bar: true, style: pagination_style %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section anchor id",
      "default": "Blog posts"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Title color",
      "default": "#1A4178"
    },
    {
      "type": "color",
      "id": "c-body-primary",
      "label": "Text color",
      "default": "#25282A"
    },
    {
      "type": "color",
      "id": "c-bg-primary",
      "label": "Background color",
      "default": "#F9F9F9"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Section title",
      "default": "Related articles"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section description",
      "default": "<p>Evidence-based guides for optimal performance and healthspan.</p>"
    },
    {
      "type": "text_alignment",
      "id": "mob_alignment",
      "label": "Mobile text alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Text alignment",
      "default": "center"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Section blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Blog posts limit",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "art",
      "default": 3
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "options": [
        {
          "value": "pagination--light",
          "label": "Light"
        },
        {
          "value": "pagination--dark",
          "label": "Dark"
        }
      ],
      "default": "pagination--dark"
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Slider autoplay duration",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Y settings"
    },
    {
      "type": "number",
      "id": "pt_mob",
      "label": "Mobile padding top in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pb_mob",
      "label": "Mobile padding bottom in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pt_tab",
      "label": "Tablet padding top in px",
      "default": 40
    },
    {
      "type": "number",
      "id": "pb_tab",
      "label": "Tablet padding bottom in px",
      "default": 40
    },
    {
      "type": "number",
      "id": "pt_desk",
      "label": "Desktop padding top in px",
      "default": 80
    },
    {
      "type": "number",
      "id": "pb_desk",
      "label": "Desktop padding bottom in px",
      "default": 80
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.cart"]
  },
  "presets": [
    {
      "name": "Blog posts",
      "category": "Sections",
      "settings": {
        "blog": "news"
      }
    }
  ]
}
{% endschema %}
