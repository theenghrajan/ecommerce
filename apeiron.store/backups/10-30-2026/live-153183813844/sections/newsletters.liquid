{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign subtitle = section.settings.subtitle
  assign title = section.settings.title
  assign mob_alignment = section.settings.mob_alignment | prepend: 'text-'
  assign desk_alignment = section.settings.alignment | prepend: 'lg:text-'
  assign alignment = mob_alignment | append: ' ' | append: desk_alignment

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  assign animation = 'animate__animated opacity-0'
  if section.index0 == 0 or section.index0 == 1
    assign animation = ''
  endif

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary lg:bg-sc-bg-secondary"
>
  <div class="container space-y-5 lg:max-w-[var(--width-desk)] {{ alignment -}}" style="--width-desk: 840px;">
    {% if subtitle != blank or title != blank %}
      <div class="space-y-3">
        {% if subtitle != blank %}
          <span
            class="rte text-sc-body-primary text-base lg:text-lg {{ animation -}}"
            {% if animation %}
              x-intersect.once="$el.classList.add('animate__fadeIn')"
            {% endif %}
          >
            {{- subtitle -}}
          </span>
        {% endif %}

        {% if title != blank %}
          <h2
            class="text-sc-title text-3xl font-semibold lg:text-5xl {{ animation -}}"
            {% if animation %}
              style="animation-delay: 100ms"
              x-intersect.once="$el.classList.add('animate__fadeIn')"
            {% endif %}
          >
            {{- title -}}
          </h2>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="w-full {{ animation -}}"
        {% if animation %}
          style="animation-delay: 100ms"
          x-intersect.once="$el.classList.add('animate__fadeIn')"
        {% endif %}
      >
        {%- liquid
          for block in section.blocks
            case block.type
              when '@app'
                render block
              when 'block'
                assign klaviyo_snippet = section.blocks[0].settings.klaviyo_snippet
                echo klaviyo_snippet
            endcase
          endfor
        -%}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Newsletters",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section anchor id",
      "default": "Newsletters"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "c-bg-primary",
      "label": "Mobile Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c-bg-secondary",
      "label": "Desktop Background color",
      "default": "#F7FAFF"
    },
    {
      "type": "color",
      "id": "c-body-primary",
      "label": "Subtitle color",
      "default": "#25282A"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Title color",
      "default": "#1A4178"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Section subtitle"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Section title"
    },
    {
      "type": "text_alignment",
      "id": "mob_alignment",
      "label": "Mobile text alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Text alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Padding Y settings"
    },
    {
      "type": "number",
      "id": "pt_mob",
      "label": "Mobile padding top in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pb_mob",
      "label": "Mobile padding bottom in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pt_tab",
      "label": "Tablet padding top in px",
      "default": 60
    },
    {
      "type": "number",
      "id": "pb_tab",
      "label": "Tablet padding bottom in px",
      "default": 60
    },
    {
      "type": "number",
      "id": "pt_desk",
      "label": "Desktop padding top in px",
      "default": 80
    },
    {
      "type": "number",
      "id": "pb_desk",
      "label": "Desktop padding bottom in px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "block",
      "limit": 1,
      "settings": [
        {
          "type": "liquid",
          "id": "klaviyo_snippet",
          "label": "Klaviyo snippet (liquid)"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.cart"]
  },
  "presets": [
    {
      "name": "Newsletters",
      "category": "Sections",
      "settings": {
        "subtitle": "Doctor-backed recovery & longevity tips",
        "title": "Get Science-Backed Tips and 10% Off Your First Order"
      }
    }
  ]
}
{% endschema %}
