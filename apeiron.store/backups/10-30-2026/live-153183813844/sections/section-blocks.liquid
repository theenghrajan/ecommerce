{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign blocks = section.blocks

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary text-sc-title relative"
>
  <ul class="container grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-5 lg:grid-cols-4">
    {% for block in blocks %}
      {% liquid
        assign title = block.settings.title
        assign description = block.settings.description
      %}
      <li
        class="bg-sc-bg-secondary animate__animated space-y-3 rounded-lg p-5 opacity-0"
        x-intersect.once="$el.classList.add('animate__fadeIn')"
        style="animation-delay: {{ forloop.index | times: 100 | append: 'ms' }}"
        {{ block.shopify_attributes }}
      >
        {% if title != blank %}
          <span class="text-sc-title text-lg font-medium">{{- title -}}</span>
        {% endif %}

        {% if description != blank %}
          <div class="rte text-sc-body-primary text-lg">{{- description -}}</div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "Tech blocks",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section anchor id",
      "default": "Tech blocks"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "c-bg-primary",
      "label": "Background color",
      "default": "#ECF3FF"
    },
    {
      "type": "color",
      "id": "c-bg-secondary",
      "label": "Block background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Title color",
      "default": "#1A4178"
    },
    {
      "type": "color",
      "id": "c-body-primary",
      "label": "Text color",
      "default": "#25282A"
    },
    {
      "type": "header",
      "content": "Padding Y settings"
    },
    {
      "type": "number",
      "id": "pt_mob",
      "label": "Mobile padding top in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pb_mob",
      "label": "Mobile padding bottom in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pt_tab",
      "label": "Tablet padding top in px",
      "default": 40
    },
    {
      "type": "number",
      "id": "pb_tab",
      "label": "Tablet padding bottom in px",
      "default": 40
    },
    {
      "type": "number",
      "id": "pt_desk",
      "label": "Desktop padding top in px",
      "default": 60
    },
    {
      "type": "number",
      "id": "pb_desk",
      "label": "Desktop padding bottom in px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Block title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Block description"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.cart"]
  }
}
{% endschema %}
