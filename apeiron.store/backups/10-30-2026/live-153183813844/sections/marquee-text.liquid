{% liquid
  assign section_anchor_id = section.settings.section_anchor_id | handleize

  assign marquee_reverse = section.settings.marquee_reverse
  assign marquee_speed = section.settings.marquee_speed
  assign center_fit = section.settings.center_fit
  assign stop_on_hover = section.settings.stop_on_hover

  assign blocks = section.blocks

  assign animation = 'animate__animated opacity-0'
  if section.index0 == 0 or section.index0 == 1
    assign animation = ''
  endif

  assign pt_mob = section.settings.pt_mob
  assign pb_mob = section.settings.pb_mob
  assign pt_tab = section.settings.pt_tab
  assign pb_tab = section.settings.pb_tab
  assign pt_desk = section.settings.pt_desk
  assign pb_desk = section.settings.pb_desk

  render 'css-variables-setter'
  render 'section-paddings', section_id: section.id, pt_mob: pt_mob, pb_mob: pb_mob, pt_tab: pt_tab, pb_tab: pb_tab, pt_desk: pt_desk, pb_desk: pb_desk
%}

{%- unless stop_on_hover -%}
  <style>
    [data-section-id='{{ section.id }}'] [data-marquee-inner]:hover .marquee {
      animation-play-state: running;
    }
  </style>
{%- endunless -%}

<div
  id="{{ section_anchor_id }}"
  data-section-id="{{ section.id }}"
  class="bg-sc-bg-primary relative overflow-hidden {{ animation -}}"
  {% if animation %}
    x-intersect.once="$el.classList.add('animate__fadeIn')"
  {% endif %}
>
  <div class="container flex overflow-visible" data-marquee-inner>
    <ul
      class="inline-flex w-max items-center will-change-transform {% if marquee_reverse %}marquee-reverse{% endif %}"
      x-load="visible (300px 300px 300px 300px)"
      x-data="marquee"
      @resize.window="marqueeLogic()"
      data-marquee-speed="{{ marquee_speed }}s"
      {% if center_fit %}
        data-center-fit
      {% endif %}
    >
      {% for block in blocks %}
        {% liquid
          assign icon = block.settings.icon
          assign text = block.settings.text
        %}

        {% if text != blank %}
          <li
            class="
              text-sc-title mx-2 flex shrink-0 items-center space-x-2.5 whitespace-nowrap lg:mx-5
              {% if marquee_reverse -%}flex-row-reverse !space-x-reverse {%- endif -%}
            "
            data-marquee-el
            {{ block.shopify_attributes }}
          >
            {% if icon != blank %}
              {{
                icon
                | image_url: width: 100
                | image_tag:
                  alt: icon.alt,
                  class: 'lg:w-10 lg:h-10 w-12.5 h-12.5 object-contain',
                  srcset: null,
                  widths: '40, 50, 100'
              }}
            {% endif %}

            <span class="font-third text-sc-title whitespace-nowrap text-sm lg:text-lg">{{- text -}}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Marquee text",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "c-title",
      "label": "Title color",
      "default": "#FEFBF9"
    },
    {
      "type": "color",
      "id": "c-bg-primary",
      "label": "Background color",
      "default": "#1A4178"
    },
    {
      "type": "header",
      "content": "Marquee settings"
    },
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section anchor id",
      "default": "Marquee text"
    },
    {
      "type": "checkbox",
      "id": "marquee_reverse",
      "label": "Reverse marquee animation",
      "default": false
    },
    {
      "type": "number",
      "id": "marquee_speed",
      "label": "Marquee speed (in sec)",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "center_fit",
      "label": "Center when blocks fit",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stop_on_hover",
      "label": "Stop animation on hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding Y settings"
    },
    {
      "type": "number",
      "id": "pt_mob",
      "label": "Mobile padding top in px",
      "default": 20
    },
    {
      "type": "number",
      "id": "pb_mob",
      "label": "Mobile padding bottom in px",
      "default": 20
    },
    {
      "type": "number",
      "id": "pt_tab",
      "label": "Tablet padding top in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pb_tab",
      "label": "Tablet padding bottom in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pt_desk",
      "label": "Desktop padding top in px",
      "default": 30
    },
    {
      "type": "number",
      "id": "pb_desk",
      "label": "Desktop padding bottom in px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Block icon"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Block text",
          "default": "MARQUEE TEXT"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.cart"]
  },
  "presets": [
    {
      "name": "Marquee text",
      "category": "Sections",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "ISO Certified."
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Manufactured in the USA 🇺🇸"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Physician backed."
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "GMP Certified."
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Third party tested in FDA-registered labs."
          }
        }
      ]
    }
  ]
}
{% endschema %}
