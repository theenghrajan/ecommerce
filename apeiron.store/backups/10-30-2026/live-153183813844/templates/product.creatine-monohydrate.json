    "section_faq_XeGrmV": {
      "type": "section-faq",
      "blocks": {
        "block_tak6ta": {
          "type": "block",
          "settings": {
            "title": "What should I consider before taking this product?",
            "text": "<p>Before using this product it is recommended that you consult your healthcare professional. If you are taking any medications, it’s important to discuss potential interactions with your healthcare provider. Do not use if tamper seal is damaged.</p>"
          }
        },
        "block_3MVhQ7": {
          "type": "block",
          "settings": {
            "title": "Where is this product manufactured and what product quality control tests are performed?",
            "text": "<p>Our BPC-157 products are manufactured in Nevada in a state-of-the-art, FDA-registered facility that meets or exceeds <a href=\"https://www.fda.gov/drugs/pharmaceutical-quality-resources/facts-about-current-good-manufacturing-practice-cgmp#:~:text=What%20is%20CGMP%3F,of%20manufacturing%20processes%20and%20facilities.\">current Good Manufacturing Practices (cGMP)</a>. Quality control testing is carried out at each stage of the manufacturing process, starting with rigorous raw material assessments and continuing through to finished product testing. </p><p>Our Creatine Monohydrate is third-party tested by ISO certified, FDA registered laboratories for purity, potency and contaminates.</p>"
          }
        },
        "block_AKtNdP": {
          "type": "block",
          "settings": {
            "title": "Is Apeiron Elementals Creatine Monohydrate third-party verified?",
            "text": "<p>Yes, our Creatine Monohydrate is third-party tested for purity, quality and consistency.</p>"
          }
        },
        "block_caxTCm": {
          "type": "block",
          "settings": {
            "title": "Should I take this on an empty stomach or with food?",
            "text": "<p>You can take creatine with our without food, though taking near a meal may improve absorption.  Best taken 30-90 minutes before or after exercise. For best results take consistently and use along side a balanced diet and exercise routine.</p>"
          }
        },
        "block_8WQY6L": {
          "type": "block",
          "settings": {
            "title": "What other supplements work synergistically with this product?",
            "text": "<p>Many supplements can taken along side Creatine, but folks can also take BPC-157, Marine Collagen, and/or EPA/DHA (Omega-3) to create improved recovery and strength building.</p>"
          }
        },
        "block_4XQyf9": {
          "type": "block",
          "settings": {
            "title": "Is this product vegan?",
            "text": "<p>Yes, our Creatine is also formulated without gluten, dairy, and soy.</p>"
          }
        }
      },
