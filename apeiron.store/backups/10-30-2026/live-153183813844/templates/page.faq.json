        "item_jeAT4w": {
          "type": "item",
          "settings": {
            "category": "Shipping & Delivery",
            "title": "Will my package ship out the same day I place my order?",
            "text": "<p>Orders are processed and shipped by 4:40pm CDT. If you order is placed after that time it will be shipped on the next business day. Business days are Monday through Friday, not including national holidays. If your package handling time exceeds 48 business hours for an extenuating circumstance, you will be directly notified.</p>"
          }
        },
        "item_7zt98f": {
          "type": "item",
          "settings": {
            "category": "Shipping & Delivery",
            "title": "Do you ship internationally?",
            "text": "<p>Yes. See our full shipping policy for a list of countries that we currently ship to. </p><p>Please note: Each country has different laws and regulations about buying products from other countries. Before you place your order, please be sure of your local customs laws concerning the shipment of dietary supplements. It is your responsibility to know what is legal in your country and what is not.</p>"
          }
        },
