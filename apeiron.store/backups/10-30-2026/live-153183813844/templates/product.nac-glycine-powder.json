    "section_faq_fpX9kh": {
      "type": "section-faq",
      "blocks": {
        "block_8mafef": {
          "type": "block",
          "settings": {
            "title": "What should I consider before taking this product?",
            "text": "<p>Before using this product it is recommenced to consult your healthcare professional. If you are taking any medications and/or have pre-existing medical conditions, it’s important to discuss potential interactions with your healthcare provider. Do not use if tamper seal is damaged.</p>"
          }
        },
        "block_nybtBh": {
          "type": "block",
          "settings": {
            "title": "Where is this product manufactured and what product quality control tests are performed?",
            "text": "<p>Our products are manufactured in Florida in a state-of-the-art, FDA-registered facility that meets or exceeds <a href=\"https://www.fda.gov/drugs/pharmaceutical-quality-resources/facts-about-current-good-manufacturing-practice-cgmp#:~:text=What%20is%20CGMP%3F,of%20manufacturing%20processes%20and%20facilities.\">current Good Manufacturing Practices (cGMP)</a>. Quality control testing is carried out at each stage of the manufacturing process, starting with rigorous raw material assessments and continuing through to finished product testing. </p><p></p>"
          }
        },
        "block_EJ7FEj": {
          "type": "block",
          "settings": {
            "title": "Should I take this on an empty stomach or with food?",
            "text": "<p>You can take this supplememnt with or without food.</p>"
          }
        },
        "block_jBh8KH": {
          "type": "block",
          "settings": {
            "title": "Is this product vegan?",
            "text": "<p>Yes, it is also formulated without dairy, gluten, or soy.</p>"
          }
        },
        "block_wGNAYC": {
          "type": "block",
          "settings": {
            "title": "What other supplements work synergistically with this product?",
            "text": "<p>Consider adding our Longevity formula - Rejuvenate UA for optimized support of cellular energy and protection. Dihydroberberine and NMN also work well with this formula to support metabolic health and cellular energy.</p>"
          }
        },
        "block_KxD9Bg": {
          "type": "block",
          "settings": {
            "title": "How long does it typically take to experience the benefits?",
            "text": "<p>People can begin to see early biochemical improvements within 2 weeks, but more noticeable effects on energy, cognition, and overall health typically require 3 to 4 months or longer of daily supplementation at this dose. Continued supplementation supports sustained benefits on aging markers, health span, and possibly longevity.</p>"
          }
        }
