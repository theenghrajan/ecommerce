<h2 class="text-sc-title mb-3 text-4xl font-semibold">
  {{ 'customer.reset_password.title' | t }}
</h2>

<div class="text-c-shadow text-base">
  {{ 'customer.reset_password.subtext' | t }}
</div>

<form class="mt-7.5" @submit.prevent="resetFormSubmit()">
  <div x-show="statusState" data-status-paste class="mb-3 "></div>

  {% assign placeholder = 'form.email' | t %}
  {%- render 'input',
    name: 'customer[email]',
    label: placeholder,
    type: 'text',
    required: true,
    input_height: 54,
    autocomplete: 'email',
    x_model: 'loginEmail',
    x_input: 'clearStatus()'
  -%}

  <div class="mt-7.5 flex flex-col">
    <button
      type="submit"
      :aria-busy="loading"
      aria-label="{{ 'customer.reset_password.submit' | t }}"
      class="min-h-10 w-full rounded-md py-1 {% render 'btn-class', btn: 'btn_primary_fill' %}"
    >
      <span>{{ 'customer.reset_password.submit' | t }}</span>
      {% render 'btn-loader' %}
    </button>

    <a
      href="{{ shop.url }}"
      aria-label="{{ 'customer.login.cancel' | t }}"
      class="mt-4 min-h-10 w-full rounded-md py-1 {% render 'btn-class', btn: 'btn_primary_outline' %}"
    >
      <span>{{ 'customer.login.cancel' | t }}</span>
    </a>

    <div class="md:mt-7.5 border-c-border pt-7.5 mt-5 w-full space-x-2 border-t">
      <span class="text-c-shadow text-base lg:text-lg">
        {{- 'customer.login.have_an_account' | t -}}
      </span>
      <button
        {% if request.page_type contains 'customers/' %}
          @click.prevent="login_tab = 'login'; changeUrl('/account/login')"
        {% else %}
          @click.prevent="login_tab = 'login'"
        {% endif %}
        aria-label="{{ 'customer.login.sign_in' | t }}"
        class="text-c-shadow w-max max-w-full text-left text-lg font-semibold underline"
      >
        <span>{{ 'customer.login.sign_in' | t }}</span>
      </button>
    </div>
  </div>
</form>
