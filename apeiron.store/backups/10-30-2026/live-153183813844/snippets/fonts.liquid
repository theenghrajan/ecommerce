{% comment %}
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Font format name mapping:
      Web Open Font Format => woff
      Web Open Font Format 2 => woff2
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Font weight name mapping:
      Thin (Hairline)           => 100
      Extra Light (Ultra Light) => 200
      Light                     => 300
      Normal (Regular)          => 400
      Medium                    => 500
      Semi Bold (Demi Bold)     => 600
      Bold                      => 700
      Extra Bold (Ultra Bold)   => 800
      Black (Heavy)             => 900
      Extra Black (Ultra Black) => 950
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
{% endcomment %}

<style>
  @font-face {
    font-family: 'Trispace';
    font-style: normal;
    font-weight: 400;
    src: url('{{ 'Trispace-Regular.ttf' | asset_url }}') format('truetype');
    font-display: swap;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400;
    src: url('{{ 'Inter-Regular.woff2' | asset_url }}') format("woff2");
    font-display: swap;
  }

  /* medium weight */
  @font-face {
    font-family: 'Trispace';
    font-style: normal;
    font-weight: 500;
    src: url('{{ 'Trispace-Medium.ttf' | asset_url }}') format('truetype');
    font-display: swap;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 500;
    src: url('{{ 'Inter-Medium.woff2' | asset_url }}') format("woff2");
    font-display: swap;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 600;
    src: url('{{ 'Inter-SemiBold.woff2' | asset_url }}') format("woff2");
    font-display: swap;
  }

  /* bold weight */
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 700;
    src: url('{{ 'Inter-Bold.woff2' | asset_url }}') format("woff2");
    font-display: swap;
  }

  /*
    IF YOU NEED USE CUSTOM, DONT FORGET CREATE CUSTOM STRUCTURE
    without any quotes
    --font-primary: Untitled Sans, sans-serif;
    --font-secondary: {{ settings.font_secondary.family }}, {{ settings.font_secondary.fallback_families }};
  */
  :root {
    --font-primary: 'Inter', sans-serif;
    --font-secondary: 'Inter', sans-serif;
    --font-third: 'Trispace', sans-serif;
  }

  /* EXAMPLE HOW ADD CUSTOM FONT */
  {% comment %}
    /* FONT "Untitled Sans" START */
      @font-face {
        font-family: 'Untitled Sans';
        font-style: normal;
        font-weight: 400;
        src: url('{{ 'untitled-sans-web-regular.woff2' | asset_url }}') format('woff2'),
        url('{{ 'untitled-sans-web-regular.woff' | asset_url }}') format('woff');
        font-display: fallback;
      }
    /* FONT "Untitled Sans" END */
  {% endcomment %}
</style>
