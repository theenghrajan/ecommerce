{% comment %}
  use text-COLOR for changing icon color, not fill-colorValue
  PARAMS:
      icon ----> Icon name
      size ----> "l" = 40x40px, "m" = 24x24px, "s" = 16x16px;
      class ----> custom tailwind classes if needed;
{% endcomment %}
{% case size %}
  {% when 'sm' %}
    {% assign size = 'w-4 h-4' %}
  {% when 'md' %}
    {% assign size = 'w-6 h-6' %}
  {% when 'lg' %}
    {% assign size = 'w-10 h-10' %}
{% endcase %}

{% assign classes = size | append: ' ' | append: class %}

{% case name %}
