{%- case request.page_type -%}
  {%- when 'product' -%}
    {%- assign variant_image = product.selected_or_first_available_variant.featured_media -%}
    <link
      rel="preload"
      as="image"
      href="{{ variant_image | image_url: width: 760 }}"
      imagesrcset="
        {{ variant_image | image_url: width: 246 }} 246w,
        {{ variant_image | image_url: width: 315 }} 315w,
        {{ variant_image | image_url: width: 493 }} 493w,
        {{ variant_image | image_url: width: 600 }} 600w,
        {{ variant_image | image_url: width: 760 }} 760w,
        {{ variant_image | image_url: width: 823 }} 823w,
        {{ variant_image | image_url: width: 990 }} 990w,
        {{ variant_image | image_url: width: 1100 }} 1100w,
        {{ variant_image | image_url: width: 1200 }} 1200w
      "
      imagesizes="(max-width: 991px) 100vw, (max-width: 1919px) 660px, 760px"
      fetchpriority="high"
    />
  {%- when 'article' -%}
    <link rel="preload" as="image" href="{{ article.image | image_url: width: 1728 }}" fetchpriority="high" />
{%- endcase -%}