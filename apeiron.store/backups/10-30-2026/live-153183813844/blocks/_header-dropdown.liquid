{% liquid
  assign title = block.settings.title
  assign subtitle = block.settings.subtitle
  assign grid_title = block.settings.grid_title
  assign link = block.settings.link
  assign list = block.settings.list
%}

<span
  class="group-hover:text-c-navy text-c-shadow relative flex after:invisible after:absolute after:left-0 after:top-full after:h-10 after:w-full after:content-[''] group-hover:after:visible"
  {{ block.shopify_attributes }}
>
  {% if link == blank %}
    <button class="flex h-full items-center text-lg font-semibold">
      <span class="ease mr-0.5 block duration-200">{{ title }}</span>
      {%- if list != blank or block.blocks.size > 0 -%}
        {% render 'icon',
          name: 'chevron-header',
          class: 'text-c-shadow group-hover:rotate-90 ease-in-out duration-200 group-hover:text-c-navy'
        %}
      {%- endif -%}
    </button>
  {% else %}
    <a
      class="flex h-full items-center text-lg font-semibold duration-200"
      href="{{ link }}"
      aria-label="Redirect to {{ title }}"
    >
      <span>
        {{ title }}
      </span>
      {%- if list != blank or block.blocks.size > 0 -%}
        {% render 'icon',
          name: 'chevron-header',
          class: 'text-c-shadow group-hover:rotate-90 ease-in-out duration-200 group-hover:text-c-navy'
        %}
      {%- endif -%}
    </a>
  {% endif %}
</span>

{% if list != blank or block.blocks.size > 0 %}
  <span class="bg-sc-bg-secondary absolute left-0 top-full z-10 flex w-full origin-top scale-y-0 flex-col opacity-0 drop-shadow-lg delay-200 duration-200 will-change-[opacity,_transform] group-hover:scale-y-100 group-hover:opacity-100">
    <span
      class="pb-15 container grid pt-10 opacity-0 duration-300 group-hover:opacity-100"
      {%- if list != blank and block.blocks.size > 0 -%}
        style="grid-template-columns: minmax(0, 280px) minmax(0, 1fr);"
      {%- endif -%}
    >
      {% if list != blank %}
        <ul
          class="pr-12.5 bg-sc-bg-secondary z-1 border-c-border relative flex max-w-[var(--width)] shrink-0 flex-col space-y-4 border-r"
          style="--width: 280px;"
        >
          {%- if subtitle != blank -%}
            <li class="z-1 text-c-navy relative text-xl font-bold">{{- subtitle -}}</li>
          {%- endif -%}

          {%- for link in list.links -%}
            <li class="z-1 relative text-lg">
              <a
                href="{{- link.url -}}"
                class="hover:text-c-navy text-c-shadow flex w-max max-w-full flex-wrap duration-300 ease-in-out"
                aria-label="{{- link.title -}}"
              >
                <span>{{- link.title -}}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {% endif %}

      {% if block.blocks.size > 0 %}
        <div class="flex flex-col space-y-4 {% if list != blank -%} ml-12.5 {%- endif -%}">
          {% if grid_title != blank %}
            <span class="text-c-navy text-xl font-bold">{{- grid_title -}}</span>
          {% endif %}

          <ul class="lg:gap-y-7.5 grid gap-5 {% if list != blank -%} grid-cols-3 {%- else -%} grid-cols-4 {%- endif -%}">
            {% content_for 'blocks' %}
          </ul>
        </div>
      {% endif %}
    </span>

    {%- if section.settings.bottom_title != blank or section.settings.bottom_btn_text != blank -%}
      <span class="bg-sc-bg-secondary text-c-shadow border-c-border mt-auto border-t py-5">
        <span class="container flex items-center justify-between space-x-10">
          {% if section.settings.bottom_title != blank %}
            <span class="rte text-xl">{{ section.settings.bottom_title }}</span>
          {% endif %}

          {% if section.settings.bottom_btn_text != blank %}
            <a
              href="{{ section.settings.bottom_btn_url }}"
              class="{% render 'btn-class', btn: section.settings.bottom_btn_type %}"
            >
              <span class="font-third">{{- section.settings.bottom_btn_text -}}</span>
            </a>
          {% endif %}
        </span>
      </span>
    {%- endif -%}
  </span>
  <div
    class="z-5 pointer-events-none absolute left-0 top-full h-screen w-full bg-black/20 opacity-0 delay-200 duration-200 will-change-[opacity] group-hover:opacity-100"
  ></div>
{% endif %}

{% schema %}
{
  "name": "Dropdown",
  "tag": "li",
  "class": "group flex h-full text-base",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Block title"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Block subtitle"
    },
    {
      "type": "inline_richtext",
      "id": "grid_title",
      "label": "Block grid title"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Block link (optional)"
    },
    {
      "type": "link_list",
      "id": "list",
      "label": "Dropdown list (optional)"
    }
  ],
  "blocks": [
    {
      "type": "_link"
    }
  ],
  "presets": [{ "name": "List item" }]
}
{% endschema %}
