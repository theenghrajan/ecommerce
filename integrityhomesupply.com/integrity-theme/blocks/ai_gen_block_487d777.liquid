{% doc %}
  @prompt
    split image banner 1 image taking up half and 1 smaller image on the other top half and text on the bottom, make the layout changeable, make the images boxy, make the section 1200px, make the smaller image fit to the file, add an option to change the height of the section, add a button below the text, make the big image a slider, have the arrow background circle size adjustable, make the arrow background able to adjust opacity, add option to adjust margin 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 1200px;
    margin: {{ block.settings.margin_top }}px auto {{ block.settings.margin_bottom }}px auto;
    padding: 0 {{ block.settings.margin_horizontal }}px;
  }

  .ai-split-banner-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    width: 100%;
    height: {{ block.settings.section_height }}px;
  }

  .ai-split-banner-container-{{ ai_gen_id }}.layout-left {
    flex-direction: row;
  }

  .ai-split-banner-container-{{ ai_gen_id }}.layout-right {
    flex-direction: row-reverse;
  }

  .ai-split-banner-left-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    height: 100%;
  }

  .ai-split-banner-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-split-banner-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-split-banner-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .ai-split-banner-slide-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-split-banner-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-split-banner-left-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-split-banner-left-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-split-banner-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba({{ block.settings.nav_bg_color | color_extract: 'red' }}, {{ block.settings.nav_bg_color | color_extract: 'green' }}, {{ block.settings.nav_bg_color | color_extract: 'blue' }}, {{ block.settings.nav_bg_opacity }});
    color: {{ block.settings.nav_color }};
    border: none;
    width: {{ block.settings.nav_circle_size }}px;
    height: {{ block.settings.nav_circle_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background-color 0.3s ease;
  }

  .ai-split-banner-nav-{{ ai_gen_id }}:hover {
    background-color: rgba({{ block.settings.nav_bg_hover_color | color_extract: 'red' }}, {{ block.settings.nav_bg_hover_color | color_extract: 'green' }}, {{ block.settings.nav_bg_hover_color | color_extract: 'blue' }}, {{ block.settings.nav_bg_hover_opacity }});
  }

  .ai-split-banner-nav-{{ ai_gen_id }} svg {
    width: {{ block.settings.nav_icon_size }}px;
    height: {{ block.settings.nav_icon_size }}px;
  }

  .ai-split-banner-nav-prev-{{ ai_gen_id }} {
    left: {{ block.settings.nav_offset }}px;
  }

  .ai-split-banner-nav-next-{{ ai_gen_id }} {
    right: {{ block.settings.nav_offset }}px;
  }

  .ai-split-banner-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.dots_offset }}px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .ai-split-banner-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-split-banner-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  .ai-split-banner-right-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.gap }}px;
    height: 100%;
  }

  .ai-split-banner-top-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-split-banner-top-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-split-banner-top-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-split-banner-top-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 150px;
    max-height: 150px;
  }

  .ai-split-banner-bottom-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {{ block.settings.text_align }};
    padding: {{ block.settings.text_padding }}px;
    background-color: {{ block.settings.text_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.text_align }};
  }

  .ai-split-banner-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    font-weight: {{ block.settings.heading_weight }};
  }

  .ai-split-banner-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.button_spacing }}px 0;
  }

  .ai-split-banner-button-{{ ai_gen_id }} {
  display: inline-block;
  padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
  background-color: {{ block.settings.button_bg_color }};
  color: {{ block.settings.button_text_color }};
  text-decoration: none;
  border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  border-radius: {{ block.settings.button_border_radius }}px;
  font-size: {{ block.settings.button_font_size }}px;
  font-weight: {{ block.settings.button_font_weight }};
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  cursor: pointer;
}

.ai-split-banner-button-{{ ai_gen_id }}:hover {
  background-color: {{ block.settings.button_bg_hover_color }};
  color: {{ block.settings.button_text_hover_color }};
  border-color: {{ block.settings.button_border_hover_color }};
}

  .ai-split-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {

  .ai-split-banner-container-{{ ai_gen_id }} {
    flex-direction: column !important;
    height: auto;
  }

  /* Large slider */
  .ai-split-banner-left-{{ ai_gen_id }} {
    width: 100%;
    height: 350px;
  }

  /* Right side becomes stacked */
  .ai-split-banner-right-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.gap }}px;
    height: auto;
  }

  /* Small image */
  .ai-split-banner-top-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    min-height: 200px;
  }

  .ai-split-banner-top-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Text section */
  .ai-split-banner-bottom-{{ ai_gen_id }} {
    width: 100%;
    min-height: auto;
    padding: 25px;
    align-items: center;
    text-align: center;
  }

  .ai-split-banner-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size | times: 0.8 }}px;
  }

  .ai-split-banner-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
  }

}
{% endstyle %}

<split-banner-slider-{{ ai_gen_id }} class="ai-split-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-banner-container-{{ ai_gen_id }} layout-{{ block.settings.layout }}">
    <div class="ai-split-banner-left-{{ ai_gen_id }}">
      {% assign has_images = false %}
      {% if block.settings.slider_image_1 or block.settings.slider_image_2 or block.settings.slider_image_3 %}
        {% assign has_images = true %}
      {% endif %}

      {% if has_images %}
        <div class="ai-split-banner-slider-{{ ai_gen_id }}">
          <div class="ai-split-banner-slides-{{ ai_gen_id }}">
            {% if block.settings.slider_image_1 %}
              <div class="ai-split-banner-slide-{{ ai_gen_id }} active">
                <img
                  src="{{ block.settings.slider_image_1 | image_url: width: 1200 }}"
                  alt="{{ block.settings.slider_image_1.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.slider_image_1.width }}"
                  height="{{ block.settings.slider_image_1.height }}"
                >
              </div>
            {% endif %}

            {% if block.settings.slider_image_2 %}
              <div class="ai-split-banner-slide-{{ ai_gen_id }}">
                <img
                  src="{{ block.settings.slider_image_2 | image_url: width: 1200 }}"
                  alt="{{ block.settings.slider_image_2.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.slider_image_2.width }}"
                  height="{{ block.settings.slider_image_2.height }}"
                >
              </div>
            {% endif %}

            {% if block.settings.slider_image_3 %}
              <div class="ai-split-banner-slide-{{ ai_gen_id }}">
                <img
                  src="{{ block.settings.slider_image_3 | image_url: width: 1200 }}"
                  alt="{{ block.settings.slider_image_3.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.slider_image_3.width }}"
                  height="{{ block.settings.slider_image_3.height }}"
                >
              </div>
            {% endif %}
          </div>

          {% if block.settings.show_arrows %}
            <button class="ai-split-banner-nav-{{ ai_gen_id }} ai-split-banner-nav-prev-{{ ai_gen_id }}" aria-label="Previous slide">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="ai-split-banner-nav-{{ ai_gen_id }} ai-split-banner-nav-next-{{ ai_gen_id }}" aria-label="Next slide">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          {% endif %}

          {% if block.settings.show_dots %}
            <div class="ai-split-banner-dots-{{ ai_gen_id }}">
              {% if block.settings.slider_image_1 %}
                <button class="ai-split-banner-dot-{{ ai_gen_id }} active" aria-label="Go to slide 1"></button>
              {% endif %}
              {% if block.settings.slider_image_2 %}
                <button class="ai-split-banner-dot-{{ ai_gen_id }}" aria-label="Go to slide 2"></button>
              {% endif %}
              {% if block.settings.slider_image_3 %}
                <button class="ai-split-banner-dot-{{ ai_gen_id }}" aria-label="Go to slide 3"></button>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% else %}
        <div class="ai-split-banner-left-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-split-banner-empty-state-{{ ai_gen_id }}">
            Add slider images
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-split-banner-right-{{ ai_gen_id }}">
      <div class="ai-split-banner-top-{{ ai_gen_id }}">
        {% if block.settings.top_right_image %}
          <img
            src="{{ block.settings.top_right_image | image_url: width: 800 }}"
            alt="{{ block.settings.top_right_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.top_right_image.width }}"
            height="{{ block.settings.top_right_image.height }}"
          >
        {% else %}
          <div class="ai-split-banner-top-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-split-banner-empty-state-{{ ai_gen_id }}">
              Add small image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-split-banner-bottom-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-split-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-split-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-split-banner-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</split-banner-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class SplitBannerSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.dots = [];
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-split-banner-slide-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-split-banner-dot-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-split-banner-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-split-banner-nav-next-{{ ai_gen_id }}');

        if (this.slides.length === 0) return;

        this.setupEventListeners();
        
        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }

        this.resetAutoplay();
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      resetAutoplay() {
        {% if block.settings.autoplay %}
          if (this.autoplayInterval) {
            clearInterval(this.autoplayInterval);
          }
          this.startAutoplay();
        {% endif %}
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('split-banner-slider-{{ ai_gen_id }}', SplitBannerSlider{{ ai_gen_id }});
  })();
</script>

