{% doc %}
  @prompt
    Image Carousel with text in the middle, make the dots smaller at the bottom, also have option to have different text for each image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
 
  .ai-carousel-container-{{ ai_gen_id }} {
  position: relative;
  width: min({{ block.settings.carousel_width }}px, 100%);
  max-width: 100%;
  overflow: hidden;
  display: block;
  margin: 0 auto;
}

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-carousel-slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
  min-width: 100%;
  position: relative;
  height: {{ block.settings.carousel_height }}px;
  }

  .ai-carousel-slide-{{ ai_gen_id }} img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-carousel-text-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    width: 90%;
    max-width: 600px;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
      display: inline-block;
  padding: 10px 18px;
  border-radius: 10px;

  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  }

  .ai-carousel-text-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-carousel-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
    font-weight: {{ block.settings.heading_weight }};
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
  }

  .ai-carousel-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: {{ block.settings.subheading_weight }};
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_bg_color }};
    color: {{ block.settings.nav_icon_color }};
    border: none;
    width: {{ block.settings.nav_size }}px;
    height: {{ block.settings.nav_size }}px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_hover_bg_color }};
  }

  .ai-carousel-nav-prev-{{ ai_gen_id }} {
    left: {{ block.settings.nav_offset }}px;
  }

  .ai-carousel-nav-next-{{ ai_gen_id }} {
    right: {{ block.settings.nav_offset }}px;
  }

  .ai-carousel-nav-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.nav_size }}px * 0.5);
    height: calc({{ block.settings.nav_size }}px * 0.5);
  }

  .ai-carousel-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.dots_offset }}px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: {{ block.settings.dots_spacing }}px;
    z-index: 3;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dots_size }}px;
    height: {{ block.settings.dots_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dots_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dots_active_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-carousel-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-carousel-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.7);
    }

    .ai-carousel-nav-{{ ai_gen_id }} {
      width: calc({{ block.settings.nav_size }}px * 0.8);
      height: calc({{ block.settings.nav_size }}px * 0.8);
    }

    .ai-carousel-nav-prev-{{ ai_gen_id }} {
      left: calc({{ block.settings.nav_offset }}px * 0.5);
    }

    .ai-carousel-slide-{{ ai_gen_id }} {
    height: calc({{ block.settings.carousel_height }}px * 0.7);
    }
  }
{% endstyle %}

<image-carousel-{{ ai_gen_id }} class="ai-carousel-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-carousel-slides-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        
        {% if image != blank %}
          <div class="ai-carousel-slide-{{ ai_gen_id }}" data-slide-index="{{ forloop.index0 }}">
            <img
              src="{{ image | image_url: width: 2000 }}"
              alt="{{ image.alt | escape }}"
            {% if forloop.index0 == 0 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endif %}
      {% endfor %}

      {% if block.settings.image_1 == blank and block.settings.image_2 == blank and block.settings.image_3 == blank and block.settings.image_4 == blank and block.settings.image_5 == blank %}
        <div class="ai-carousel-slide-{{ ai_gen_id }}" data-slide-index="0">
          <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}
    </div>

    {% for i in (1..5) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign heading_key = 'heading_' | append: i
        assign subheading_key = 'subheading_' | append: i
        assign image = block.settings[image_key]
        assign heading = block.settings[heading_key]
        assign subheading = block.settings[subheading_key]
      %}
      
      {% if image != blank %}
        {% if heading != blank or subheading != blank %}
          <div class="ai-carousel-text-overlay-{{ ai_gen_id }}" data-text-index="{{ forloop.index0 }}">
            {% if heading != blank %}
              <h2 class="ai-carousel-heading-{{ ai_gen_id }}">{{ heading }}</h2>
            {% endif %}
            {% if subheading != blank %}
              <p class="ai-carousel-subheading-{{ ai_gen_id }}">{{ subheading }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if block.settings.show_navigation %}
      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-next-{{ ai_gen_id }}"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-carousel-dots-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</image-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
        this.isTransitioning = false;
      }

      connectedCallback() {
        this.slidesContainer = this.querySelector('.ai-carousel-slides-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}'));
        this.textOverlays = this.querySelectorAll('.ai-carousel-text-overlay-{{ ai_gen_id }}');
        this.totalSlides = this.slides.length;
        this.prevButton = this.querySelector('.ai-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-carousel-nav-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-carousel-dots-{{ ai_gen_id }}');

        if (this.totalSlides <= 1) {
          if (this.prevButton) this.prevButton.style.display = 'none';
          if (this.nextButton) this.nextButton.style.display = 'none';
          if (this.dotsContainer) this.dotsContainer.style.display = 'none';
          this.updateTextOverlay();
          return;
        }

        // Clone first and last slides for infinite loop
        const firstClone = this.slides[0].cloneNode(true);
        const lastClone = this.slides[this.totalSlides - 1].cloneNode(true);
        firstClone.setAttribute('data-clone', 'true');
        lastClone.setAttribute('data-clone', 'true');
        this.slidesContainer.appendChild(firstClone);
        this.slidesContainer.insertBefore(lastClone, this.slides[0]);

        // Start at index 1 (the real first slide, after the last-clone prepended)
        this.currentSlide = 1;
        this.slidesContainer.style.transition = 'none';
        this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;

        // Listen for transition end to handle the snap
       this.slidesContainer.addEventListener('transitionend', () => {
        if (this.currentSlide === this.totalSlides + 1) {
          this.slidesContainer.style.transition = 'none';
          this.currentSlide = 1;
          this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;
          this.updateTextOverlay();
         this.updateDots();
  }

         if (this.currentSlide === 0) {
          this.slidesContainer.style.transition = 'none';
          this.currentSlide = this.totalSlides;
          this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;
          this.updateTextOverlay();
          this.updateDots();
  }

  // Reset AFTER any snap so the next autoplay tick isn't blocked
  this.isTransitioning = false;
});

        this.setupEventListeners();
        this.createDots();
        this.updateDots();
        this.updateTextOverlay();

        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prevSlide());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        {% if block.settings.autoplay %}
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        {% endif %}
      }

      createDots() {
        if (!this.dotsContainer) return;
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-carousel-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i + 1));
          this.dotsContainer.appendChild(dot);
        }
      }

      updateDots() {
        if (!this.dotsContainer) return;
        const dots = this.dotsContainer.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');
        // currentSlide is offset by 1 due to prepended clone
        const realIndex = this.currentSlide - 1;
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === realIndex);
        });
      }

      updateTextOverlay() {
        // textOverlays use 0-based data-text-index, currentSlide is offset by 1
        const realIndex = this.totalSlides > 1 ? this.currentSlide - 1 : 0;
        this.textOverlays.forEach((overlay) => {
          const textIndex = parseInt(overlay.getAttribute('data-text-index'));
          overlay.classList.toggle('active', textIndex === realIndex);
        });
      }

      goToSlide(index) {
        if (this.isTransitioning) return;
        this.isTransitioning = true;
        this.currentSlide = index;
        this.slidesContainer.style.transition = 'transform 0.5s ease-in-out';
        this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;
        this.updateDots();
        this.updateTextOverlay();
      }

      nextSlide() {
        this.goToSlide(this.currentSlide + 1);
      }

      prevSlide() {
        this.goToSlide(this.currentSlide - 1);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

