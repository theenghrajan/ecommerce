{% doc %}
  @prompt
    make a qty calculator using metafield sqft per box, if there is no metafield the section do not appear, change the width option to pxs. Add margin options, add divider at the bottom, increase the maximum width to 1200
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign sqft_per_box = product.metafields.custom.sqft_per_box %}

{% if sqft_per_box != blank %}
  {% style %}
    .ai-qty-calculator-wrapper-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      max-width: {{ block.settings.max_width }}px;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
      margin-left: auto;
      margin-right: auto;
    }

    .ai-qty-calculator-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      padding: {{ block.settings.padding }}px;
      background-color: {{ block.settings.background_color }};
      border-radius: {{ block.settings.border_radius }}px;
      border: 1px solid {{ block.settings.border_color }};
    }

    .ai-qty-calculator-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size }}px;
      font-weight: 600;
      color: {{ block.settings.text_color }};
      margin: 0 0 {{ block.settings.spacing }}px;
    }

    .ai-qty-calculator-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size }}px;
      color: {{ block.settings.text_color }};
      margin: 0 0 {{ block.settings.spacing }}px;
      opacity: 0.8;
    }

    .ai-qty-calculator-input-group-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.spacing }}px;
    }

    .ai-qty-calculator-label-{{ ai_gen_id }} {
      display: block;
      font-size: {{ block.settings.label_size }}px;
      color: {{ block.settings.text_color }};
      margin-bottom: 8px;
      font-weight: 500;
    }
    
    .ai-qty-calculator-input-{{ ai_gen_id }} {
      width: 100%;
      padding: 12px 16px;
      font-size: {{ block.settings.input_size }}px;
      border: 1px solid {{ block.settings.input_border_color }};
      border-radius: {{ block.settings.input_border_radius }}px;
      background-color: {{ block.settings.input_background }};
      color: {{ block.settings.text_color }};
    }

    .ai-qty-calculator-input-{{ ai_gen_id }}:focus {
      outline: none;
      border-color: {{ block.settings.accent_color }};
    }

    .ai-qty-calculator-button-{{ ai_gen_id }} {
      width: 100%;
      padding: 14px 24px;
      font-size: {{ block.settings.button_size }}px;
      font-weight: 600;
      background-color: {{ block.settings.button_color }};
      color: {{ block.settings.button_text_color }};
      border: none;
      border-radius: {{ block.settings.button_border_radius }}px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .ai-qty-calculator-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_hover_color }};
    }

    .ai-qty-calculator-result-{{ ai_gen_id }} {
      margin-top: {{ block.settings.spacing }}px;
      padding: {{ block.settings.spacing }}px;
      background-color: {{ block.settings.result_background }};
      border-radius: {{ block.settings.border_radius }}px;
      border: 1px solid {{ block.settings.accent_color }};
      display: none;
    }

    .ai-qty-calculator-result-{{ ai_gen_id }}.active {
      display: block;
    }

    .ai-qty-calculator-result-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.result_size }}px;
      color: {{ block.settings.text_color }};
      margin: 0;
      line-height: 1.6;
    }

    .ai-qty-calculator-result-highlight-{{ ai_gen_id }} {
      font-weight: 700;
      color: {{ block.settings.accent_color }};
      font-size: {{ block.settings.result_size | plus: 2 }}px;
    }

    .ai-qty-calculator-error-{{ ai_gen_id }} {
      color: {{ block.settings.error_color }};
      font-size: {{ block.settings.label_size }}px;
      margin-top: 8px;
      display: none;
    }

    .ai-qty-calculator-error-{{ ai_gen_id }}.active {
      display: block;
    }

    .ai-qty-calculator-metafield-info-{{ ai_gen_id }} {
      font-size: 12px;
      color: {{ block.settings.text_color }};
      opacity: 0.6;
      margin-top: 8px;
    }

    .ai-qty-calculator-divider-{{ ai_gen_id }} {
      height: {{ block.settings.divider_height }}px;
      background-color: {{ block.settings.divider_color }};
      margin-top: {{ block.settings.divider_spacing }}px;
      border: none;
    }
  {% endstyle %}

  <div class="ai-qty-calculator-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <qty-calculator-{{ ai_gen_id }}
      class="ai-qty-calculator-{{ ai_gen_id }}"
      data-sqft-per-box="{{ sqft_per_box }}"
    >
      {% if block.settings.title != blank %}
        <h3 class="ai-qty-calculator-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-qty-calculator-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <div class="ai-qty-calculator-input-group-{{ ai_gen_id }}">
        <label class="ai-qty-calculator-label-{{ ai_gen_id }}" for="ai-qty-calc-area-{{ ai_gen_id }}">
          {{ block.settings.area_label }}
        </label>
        <input
          type="number"
          id="ai-qty-calc-area-{{ ai_gen_id }}"
          class="ai-qty-calculator-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.area_placeholder }}"
          min="0"
          step="0.01"
        >
        <div class="ai-qty-calculator-error-{{ ai_gen_id }}" id="ai-qty-calc-error-{{ ai_gen_id }}">
          {{ block.settings.error_message }}
        </div>
      </div>

      <button
        type="button"
        class="ai-qty-calculator-button-{{ ai_gen_id }}"
        id="ai-qty-calc-btn-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </button>

      <div class="ai-qty-calculator-result-{{ ai_gen_id }}" id="ai-qty-calc-result-{{ ai_gen_id }}">
        <p class="ai-qty-calculator-result-text-{{ ai_gen_id }}">
          {{ block.settings.result_prefix }}
          <span class="ai-qty-calculator-result-highlight-{{ ai_gen_id }}" id="ai-qty-calc-boxes-{{ ai_gen_id }}">0</span>
          {{ block.settings.result_suffix }}
        </p>
        {% if block.settings.show_coverage_info %}
          <p class="ai-qty-calculator-result-text-{{ ai_gen_id }}" style="margin-top: 8px;">
            {{ block.settings.coverage_prefix }}
            <span class="ai-qty-calculator-result-highlight-{{ ai_gen_id }}" id="ai-qty-calc-coverage-{{ ai_gen_id }}">0</span>
            {{ block.settings.coverage_suffix }}
          </p>
        {% endif %}
      </div>

      {% if block.settings.show_metafield_info %}
        <div class="ai-qty-calculator-metafield-info-{{ ai_gen_id }}">
          Coverage: {{ sqft_per_box }} sq ft per box
        </div>
      {% endif %}
    </qty-calculator-{{ ai_gen_id }}>

    {% if block.settings.show_divider %}
      <hr class="ai-qty-calculator-divider-{{ ai_gen_id }}">
    {% endif %}
  </div>

  <script>
    (function() {
      class QtyCalculator{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
          this.sqftPerBox = parseFloat(this.dataset.sqftPerBox) || 0;
        }

        connectedCallback() {
          this.input = this.querySelector('#ai-qty-calc-area-{{ ai_gen_id }}');
  this.button = this.querySelector('#ai-qty-calc-btn-{{ ai_gen_id }}');
  this.result = this.querySelector('#ai-qty-calc-result-{{ ai_gen_id }}');
  this.boxesDisplay = this.querySelector('#ai-qty-calc-boxes-{{ ai_gen_id }}');
  this.coverageDisplay = this.querySelector('#ai-qty-calc-coverage-{{ ai_gen_id }}');
  this.error = this.querySelector('#ai-qty-calc-error-{{ ai_gen_id }}');

  this.input.addEventListener('input', () => {
    this.error.classList.remove('active');

    if (this.input.value && parseFloat(this.input.value) > 0) {
      this.calculate();
    } else {
      this.result.classList.remove('active');
    }
  });

  if (this.button) {
    this.button.style.display = 'none';
  }
}

        calculate() {
          const area = parseFloat(this.input.value);

          if (!area || area <= 0) {
            this.error.classList.add('active');
            this.result.classList.remove('active');
            return;
          }

          if (this.sqftPerBox <= 0) {
            this.error.textContent = 'Coverage per box not configured';
            this.error.classList.add('active');
            this.result.classList.remove('active');
            return;
          }

          this.error.classList.remove('active');

          const boxesNeeded = Math.ceil(area / this.sqftPerBox);
          const totalCoverage = (boxesNeeded * this.sqftPerBox).toFixed(2);

          this.boxesDisplay.textContent = boxesNeeded;
          
          if (this.coverageDisplay) {
            this.coverageDisplay.textContent = totalCoverage;
          }

          this.result.classList.add('active');
        }
      }

      customElements.define('qty-calculator-{{ ai_gen_id }}', QtyCalculator{{ ai_gen_id }});
    })();
  </script>
{% endif %}

