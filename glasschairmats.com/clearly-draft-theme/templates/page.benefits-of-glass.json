      "blocks": {
        "question_dhm36J": {
          "type": "question",
          "settings": {
            "title": "What is a beveled edge on a chair mat?",
            "text": "<p><br/>A beveled edge is an angled edge that creates a smooth transition <br/>between the mat and the floor, allowing easier movement and improved <br/>safety.<br/><br/></p>"
          }
        },
        "question_xPdzPQ": {
          "type": "question",
          "settings": {
            "title": "Is a beveled edge glass chair mat worth it?",
            "text": "<p>Yes. It improves comfort, reduces resistance, and eliminates the common frustrations associated with flat-edge mats.</p>"
          }
        },
        "question_7FhJin": {
          "type": "question",
          "settings": {
            "title": "Are glass chair mats safe?",
            "text": "<p>Yes. Our mats use tempered glass engineered for strength, durability, and everyday office use.</p>"
          }
        },
        "question_97wMVX": {
          "type": "question",
          "settings": {
            "title": "Do glass chair mats work on carpet and hard floors?",
            "text": "<p>Yes. They perform effectively on carpet, hardwood, tile, and other flooring types.</p>"
          }
        }
      },
