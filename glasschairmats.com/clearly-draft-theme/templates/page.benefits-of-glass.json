    "advanced_content_JrKexY": {
      "type": "advanced-content",
      "blocks": {
        "liquid_MUNrwp": {
          "type": "liquid",
          "settings": {
            "code": "<center><h2>Our “Edge” on the Competition</h2><p>We are proud to offer the only glass chair mat with a patented beveled edge, designed to deliver a superior experience in every way.</p>\n<p>Unlike standard mats that interrupt movement, our design ensures continuous, fluid motion throughout your workspace.</p>\n<p>Here&rsquo;s what sets our mats apart:</p></center>\n<ul>\n<li>\n<p>No jarring drop-off when rolling on or off the mat</p>\n</li>\n<li>\n<p>Effortless chair movement without resistance at the edges</p>\n</li>\n<li>\n<p>No toe stubbing or shoe impact, thanks to the smooth edge transition</p>\n</li>\n<li>\n<p>A sophisticated 1&rdquo; beveled finish that complements any d&eacute;cor</p>\n</li>\n<li>\n<p>Lies flat on the floor for stability and safety</p>\n</li>\n<li>\n<p>Lifetime warranty against cracks or chipping</p>\n</li>\n</ul>\n<center><p>This patented beveled edge is not just a design feature, it directly improves how your chair mat performs every single day.</p></center>",
            "width": "100%",
            "alignment": "center"
          }
        },
        "liquid_GYgQYT": {
          "type": "liquid",
          "settings": {
            "code": "<center><h2>Why Beveled Edges Matter More Than You Think</h2><p>Many office chair mats fail at the edges.</p>\n<p>Traditional flat-edge mats often create:</p></center>\n<ul>\n<li>\n<p>abrupt stops when rolling</p>\n</li>\n<li>\n<p>resistance that strains your movement</p>\n</li>\n<li>\n<p>raised edges that can catch your foot or chair</p>\n</li>\n</ul>\n<center><p>Over time, these issues affect comfort, productivity, and even posture.</p>\n<p>Our beveled edge design solves these problems at their source by allowing your chair to glide smoothly and naturally, without interruption.</p>\n<p>The result is consistent movement, reduced physical strain, and a noticeably better working experience.</p></center>",
            "width": "100%",
            "alignment": "center"
          }
        },
        "liquid_WzeYRY": {
