        "text_9rQyCE": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>Choosing the right glass chair mat often raises questions about durability, floor compatibility, and long-term performance. Below are answers to some of the most common questions customers ask when comparing glass chair mats for home offices and professional workspaces.</p>"
          }
        }
      },
      "block_order": [
        "text_9rQyCE"
      ],
