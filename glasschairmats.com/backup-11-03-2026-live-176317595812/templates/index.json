        "liquid_MWNhK3": {
          "type": "liquid",
          "settings": {
            "code": "<h2>Built for all Floor Types</h2><p>Clearly Innovative Glass Chair Mats are designed to perform perfectly on all types of flooring. Whether you have hardwood, carpet, laminate, tile, or any other surface, our glass mats stay securely in place. We provide specialized tabs for hardwood floors and Velcro attachments for carpet, ensuring stability and smooth rolling in any environment.</p>\n<p><a class=\"btn\" href=\"https://glasschairmats.com/collections/all\">Shop Now</a>",
            "width": "50%",
            "alignment": "center"
          }
        },
